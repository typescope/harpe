//[ Assert.jo
  !
  ! The assertions a test body records. They say only what was expected — the
  ! runner supplies which test was running and where it sits in the tree, so a
  ! label here names the property, not the scenario.
//]

namespace harpe.testing

import jo.compile.SourceLocation

//[ Record a failure for `label` unless `cond` holds.
  !
  ! The compiler supplies the call site's location, and the enclosing test
  ! continues so later checks in the same scenario still run.
//]
def check(label: String, cond: Bool)(auto source: SourceLocation): Unit receives testResult =
  if !cond then testResult.record(source, label)

//[ Fail the enclosing test unless `actual` equals `expected`, quoting both. //]
def checkEquals(label: String, actual: String, expected: String)(auto source: SourceLocation): Unit receives testResult =
  if actual != expected then
    testResult.record(source, "\{label}: expected [\{expected}] but got [\{actual}]")
