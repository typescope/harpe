//[ TelegramExample.jo
  !
  ! Wires the Telegram agent to the keyless `echo` model so the plumbing runs with
  ! no LLM API key — overriding `harpe.telegram.Config.model` via this agent's
  ! jo.toml. Remove the link to use the Anthropic default instead.
//]

namespace TelegramExample

import harpe.models.*

def model(): Model receives IO.stdout = echo()
