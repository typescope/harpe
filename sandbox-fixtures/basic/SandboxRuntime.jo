namespace sandbox.runtime

import jo.IO.stdout
import harpe.logging.*
import harpe.ffi.os
import harpe.ffi.json
import harpe.media.*
import harpe.caps.*
import harpe.*
import harpe.interact.BrokerApprovals
import sandbox.api

// Runtime for the runCode integration tests: install the audit channel (a JSONL
// file the host names via HARPE_AUDIT_LOG and reads back), emit one record, then
// run the guest.
def main(): Unit receives stdout =
  with approvals = BrokerApprovals.connect() in
    Logging.withLogger(auditLogger(), () => run())

private def run(): Unit receives stdout, logger, approvals =
  logger.info("harpe.sandbox.runtime", "runtime ready")

  // Emit output-file events before running the guest, so they are present even
  // when the guest crashes. Controlled by HARPE_TEST_OUTPUT_EVENTS:
  //   "1"     → one valid file event
  //   "mixed" → valid + malformed + unknown + a second valid event
  val outputMode = os.getenv("HARPE_TEST_OUTPUT_EVENTS", "")
  if outputMode != "" then emitTestOutputEvents(outputMode)

  // The integration suite enables this probe to exercise the real
  // sandbox → broker → Interact → broker → sandbox approval path.
  if os.getenv("HARPE_TEST_APPROVAL", "") == "1" then
    val decision = approvals.request(
      "Publish report",
      "Publish **quarterly-report.pdf** to the customer portal."
    )
    println "approval=\{Approvals.wire(decision)}"
    val second = approvals.request(
      "Notify customer",
      "Send the publication notice after the report is available."
    )
    println "approval2=\{Approvals.wire(second)}"

  // Grant the guest a FileSystem rooted at its own run dir (its working directory,
  // where the host runs it — so `.` is that isolated dir, holding out.py).
  val fs = FileSystemImpl.local(".")
  with sandbox.api.fs = fs in sandbox.api.runTask()

private def emitTestOutputEvents(mode: String): Unit =
  val outputFile = os.getenv("HARPE_OUTPUT_FILE", "")
  if outputFile == "" then return
  val f = py.module("builtins").open(outputFile, "a")
  f.write(json.dumps(py.dict("event" ~ "file", "name" ~ "report.csv", "mime" ~ "text/csv", "size" ~ 42)) + "\n")
  if mode == "mixed" then
    f.write("not valid json {{{\n")
    f.write(json.dumps(py.dict("event" ~ "unknown", "data" ~ "ignored")) + "\n")
    f.write(json.dumps(py.dict("event" ~ "file", "name" ~ "other.csv", "mime" ~ "text/csv", "size" ~ 10)) + "\n")
  f.close()

private def auditLogger(): Logger =
  val path = os.getenv("HARPE_AUDIT_LOG", "")
  if path == "" then Logging.discard else new JsonlLogger(path)
