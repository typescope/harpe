namespace sandbox.runtime

import sandbox.api

class LogisticsImpl(path: String)
  view api.Logistics

  private def connect(): py.Dynamic =
    val conn = py.module("sqlite3").connect(path, timeout = 10.0)
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA busy_timeout = 10000")
    conn

  def products(): List[api.Product] =
    val conn = connect()
    val rows = conn.execute("""
      SELECT p.id, p.sku, p.name, p.category, p.supplier_id, s.name,
             p.on_hand, p.reserved, p.incoming, p.capacity, p.case_size,
             p.minimum_order_quantity, p.lead_time_days, p.unit_price_cents,
             s.currency
      FROM products p JOIN suppliers s ON s.id = p.supplier_id
      WHERE p.enabled = 1 AND s.enabled = 1 ORDER BY p.sku
    """).fetchall()
    var result: List[api.Product] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.Product(
        r[0].asInt, r[1].asString, r[2].asString, r[3].asString,
        r[4].asInt, r[5].asString, r[6].asInt, r[7].asInt,
        r[8].asInt, r[9].asInt, r[10].asInt, r[11].asInt,
        r[12].asInt, r[13].asInt, r[14].asString)
    conn.close()
    result

  def rules(): List[api.Rule] =
    val conn = connect()
    val rows = conn.execute(
      "SELECT id, text FROM rules WHERE enabled = 1 ORDER BY id").fetchall()
    var result: List[api.Rule] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.Rule(r[0].asInt, r[1].asString)
    conn.close()
    result

  def demandHistory(productId: Int, days: Int): List[api.DemandDay] =
    val safeDays = if days < 1 then 1 else if days > 365 then 365 else days
    val conn = connect()
    val rows = conn.execute("""
      SELECT demand_date, quantity FROM demand_history
      WHERE product_id = ? AND demand_date >= date('now', ?)
      ORDER BY demand_date
    """, py.list(productId, "-" + safeDays.toString + " days")).fetchall()
    var result: List[api.DemandDay] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.DemandDay(r[0].asString, r[1].asInt)
    conn.close()
    result

  def openDraftOrders(): List[api.DraftOrder] =
    val conn = connect()
    val orders = conn.execute("""
      SELECT d.id, d.supplier_id, s.name, d.status, d.total_cents,
             d.currency, d.rationale
      FROM draft_orders d JOIN suppliers s ON s.id = d.supplier_id
      WHERE d.status = 'draft' ORDER BY d.id
    """).fetchall()
    var result: List[api.DraftOrder] = []
    for raw in py.iter(orders) do
      val r = py.dynamic(raw)
      val lineRows = conn.execute("""
        SELECT l.product_id, p.sku, p.name, l.quantity
        FROM draft_order_lines l JOIN products p ON p.id = l.product_id
        WHERE l.draft_order_id = ? ORDER BY p.sku
      """, py.list(r[0].asInt)).fetchall()
      var lines: List[api.DraftLine] = []
      for lineRaw in py.iter(lineRows) do
        val line = py.dynamic(lineRaw)
        lines = lines + new api.DraftLine(
          line[0].asInt, line[1].asString, line[2].asString, line[3].asInt)
      result = result + new api.DraftOrder(
        r[0].asInt, r[1].asInt, r[2].asString, r[3].asString,
        r[4].asInt, r[5].asString, r[6].asString, lines)
    conn.close()
    result

  def saveDraftOrder(
    supplierId: Int,
    lines: List[api.ProposedLine],
    rationale: String
  ): api.SaveResult =
    if lines.size == 0 then return failed("A draft needs at least one line")
    if rationale.trim == "" then return failed("A rationale is required")

    val conn = connect()
    conn.execute("BEGIN IMMEDIATE")
    val supplier = conn.execute(
      "SELECT currency FROM suppliers WHERE id = ? AND enabled = 1",
      py.list(supplierId)).fetchone()
    if supplier.isNone then return rollback(conn, "Unknown or disabled supplier")

    var seen: List[Int] = []
    var total = 0
    var validated = py.list()

    for proposed in lines do
      if seen.contains(proposed.productId) then
        return rollback(conn, "Duplicate product line: \{proposed.productId}")
      seen = seen + proposed.productId
      if proposed.quantity <= 0 then
        return rollback(conn, "Quantity must be positive for product \{proposed.productId}")

      val row = conn.execute("""
        SELECT sku, category, supplier_id, on_hand, incoming, capacity, case_size,
               minimum_order_quantity, unit_price_cents
        FROM products WHERE id = ? AND enabled = 1
      """, py.list(proposed.productId)).fetchone()
      if row.isNone then return rollback(conn, "Unknown or disabled product \{proposed.productId}")
      val p = py.dynamic(row)
      val sku = p[0].asString
      if p[2].asInt != supplierId then return rollback(conn, "\{sku} belongs to another supplier")
      if proposed.quantity < p[7].asInt then return rollback(conn, "\{sku} is below its minimum order quantity")
      if proposed.quantity % p[6].asInt != 0 then return rollback(conn, "\{sku} quantity must be a multiple of its case size")
      if p[3].asInt + p[4].asInt + proposed.quantity > p[5].asInt then
        return rollback(conn, "\{sku} would exceed storage capacity")

      val duplicate = conn.execute("""
        SELECT 1 FROM draft_order_lines l
        JOIN draft_orders d ON d.id = l.draft_order_id
        WHERE l.product_id = ? AND d.status = 'draft' LIMIT 1
      """, py.list(proposed.productId)).fetchone()
      if !duplicate.isNone then return rollback(conn, "\{sku} is already in an open draft")

      val lineTotal = proposed.quantity * p[8].asInt
      total = total + lineTotal
      validated.append(py.list(proposed.productId, proposed.quantity, p[8].asInt, lineTotal))

    val currency = supplier[0].asString
    val cursor = conn.execute("""
      INSERT INTO draft_orders
        (supplier_id, status, rationale, total_cents, currency, created_at, updated_at)
      VALUES (?, 'draft', ?, ?, ?, datetime('now'), datetime('now'))
    """, py.list(supplierId, rationale.trim, total, currency))
    val draftId = cursor.lastrowid.asInt
    for raw in py.iter(validated) do
      val line = py.dynamic(raw)
      conn.execute("""
        INSERT INTO draft_order_lines
          (draft_order_id, product_id, quantity, unit_price_cents, line_total_cents)
        VALUES (?, ?, ?, ?, ?)
      """, py.list(draftId, line[0], line[1], line[2], line[3]))
    conn.commit()
    conn.close()
    new api.SaveResult(true, draftId, "Draft \{draftId} saved for administrator review")

  private def failed(message: String): api.SaveResult =
    new api.SaveResult(false, 0, message)

  private def rollback(conn: py.Dynamic, message: String): api.SaveResult =
    conn.rollback()
    conn.close()
    failed(message)
end
