namespace sandbox.api

import jo.IO.stdout

class DraftLine(productId: Int, sku: String, name: String, quantity: Int)

class DraftOrder(
  id: Int,
  supplierId: Int,
  supplierName: String,
  totalCents: Int,
  currency: String,
  rationale: String,
  lines: List[DraftLine]
)

class ProposedLine(productId: Int, quantity: Int)

//[ The complete authority granted to the PLANNER.
  !
  ! The planner runs only when a person asks it to, and everything it creates is
  ! reviewed by a person before it means anything. So it gets one write, and that
  ! write produces a draft. There is deliberately no operation here to approve a
  ! draft, submit it to a supplier, change a check, or reach a database, file, or
  ! network.
//]
interface Plan
  def products(): List[Product]
  def demandHistory(productId: Int, days: Int): List[DemandDay]
  def checks(): List[Check]
  def openDraftOrders(): List[DraftOrder]
  def saveDraftOrder(
    supplierId: Int,
    lines: List[ProposedLine],
    rationale: String
  ): SaveResult
end

param plan: Plan

defer def runTask(): Unit receives stdout, plan

