namespace sandbox.runtime

import sandbox.api

//[ The read side, shared by both capabilities.
  !
  ! Trusted host-side code. It holds the only thing either sandbox runtime is
  ! given: an absolute path to the database. Generated code never sees it.
//]
class Depot(path: String)
  def connect(): py.Dynamic =
    val conn = py.module("sqlite3").connect(path, timeout = 10.0)
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA busy_timeout = 10000")
    conn

  def products(): List[api.Product] =
    val conn = connect()
    val result = productsOn(conn)
    conn.close()
    result

  def productsOn(conn: py.Dynamic): List[api.Product] =
    val rows = conn.execute("""
      SELECT p.id, p.sku, p.name, p.category, pos.on_hand, pos.on_order,
             pos.sells_per_day, pos.days_of_cover, pos.lead_time_days, p.capacity
      FROM products p
      JOIN product_position pos ON pos.product_id = p.id
      WHERE p.enabled = 1 ORDER BY p.sku
    """).fetchall()
    var result: List[api.Product] = []
    for raw in py.iter(rows) do
      val p = py.dynamic(raw)
      val id = p[0].asInt
      result = result + new api.Product(
        id, p[1].asString, p[2].asString, p[3].asString,
        p[4].asInt, p[5].asInt, p[6].asFloat, p[7].asInt, p[8].asInt, p[9].asInt,
        sourcesFor(conn, id))
    result

  private def sourcesFor(conn: py.Dynamic, productId: Int): List[api.Source] =
    val rows = conn.execute("""
      SELECT ps.supplier_id, s.name, s.currency, ps.unit_price_cents,
             ps.lead_time_days, ps.case_size, ps.preferred
      FROM product_suppliers ps JOIN suppliers s ON s.id = ps.supplier_id
      WHERE ps.product_id = ? AND s.enabled = 1
      ORDER BY ps.preferred DESC, ps.unit_price_cents
    """, py.list(productId)).fetchall()
    var result: List[api.Source] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.Source(
        r[0].asInt, r[1].asString, r[2].asString, r[3].asInt,
        r[4].asInt, r[5].asInt, r[6].asInt == 1)
    result

  def checks(): List[api.Check] =
    val conn = connect()
    val rows = conn.execute(
      "SELECT id, text FROM checks WHERE enabled = 1 ORDER BY id").fetchall()
    var result: List[api.Check] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.Check(r[0].asInt, r[1].asString)
    conn.close()
    result

  //[ Daily units shipped out, from the movement ledger rather than a typed number. //]
  def demandHistory(productId: Int, days: Int): List[api.DemandDay] =
    val safeDays = if days < 1 then 1 else if days > 365 then 365 else days
    val conn = connect()
    val rows = conn.execute("""
      SELECT date(occurred_at) AS demand_date, SUM(-quantity) AS quantity
      FROM stock_movements
      WHERE product_id = ? AND kind = 'issue' AND date(occurred_at) >= date('now', ?)
      GROUP BY date(occurred_at)
      ORDER BY demand_date
    """, py.list(productId, "-" + safeDays.toString + " days")).fetchall()
    var result: List[api.DemandDay] = []
    for raw in py.iter(rows) do
      val r = py.dynamic(raw)
      result = result + new api.DemandDay(r[0].asString, r[1].asInt)
    conn.close()
    result

  def failed(message: String): api.SaveResult = new api.SaveResult(false, 0, message)

  def rollback(conn: py.Dynamic, message: String): api.SaveResult =
    conn.rollback()
    conn.close()
    failed(message)
end
