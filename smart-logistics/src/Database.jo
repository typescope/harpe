namespace harpe.examples.smartlogistics

import harpe.ffi.os
import harpe.util.File

class Database(path: String, home: String)
  private def connect(): py.Dynamic =
    val sqlite = py.module("sqlite3")
    val conn = sqlite.connect(path, timeout = 10.0)
    conn.row_factory = sqlite.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA busy_timeout = 10000")
    conn

  //[ The shape this file expects. `initialize` builds it outright on an empty
    ! database and migrates an existing one up to it; anything older is upgraded
    ! in place, once, on the way past.
  //]
  private val schemaVersion = 1

  def initialize(): Unit =
    File.ensureDir(os.path.dirname(path))
    val conn = connect()
    // A database that predates a numbered schema has no draft_orders table only
    // when it is genuinely empty, so this distinguishes "build it" from
    // "upgrade it" before the script below makes them look alike.
    val fresh = conn.execute("""
      SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='draft_orders'
    """).fetchone()[0].asInt == 0
    conn.executescript("""
      CREATE TABLE IF NOT EXISTS suppliers (
        id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE,
        currency TEXT NOT NULL DEFAULT 'CHF', enabled INTEGER NOT NULL DEFAULT 1
      );
      CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY, sku TEXT NOT NULL UNIQUE, name TEXT NOT NULL,
        category TEXT NOT NULL,
        capacity INTEGER NOT NULL CHECK(capacity > 0),
        enabled INTEGER NOT NULL DEFAULT 1
      );
      -- Price, lead time and case size are terms of one product-supplier
      -- relationship, not properties of the product. The same item is often
      -- sourced from several suppliers; exactly one of them is preferred.
      CREATE TABLE IF NOT EXISTS product_suppliers (
        product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,
        supplier_id INTEGER NOT NULL REFERENCES suppliers(id),
        unit_price_cents INTEGER NOT NULL CHECK(unit_price_cents >= 0),
        lead_time_days INTEGER NOT NULL DEFAULT 1 CHECK(lead_time_days >= 0),
        case_size INTEGER NOT NULL DEFAULT 1 CHECK(case_size > 0),
        preferred INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY(product_id, supplier_id)
      );
      CREATE INDEX IF NOT EXISTS product_suppliers_supplier
        ON product_suppliers(supplier_id);
      -- Every unit that entered or left the depot. Stock on hand is the sum of
      -- this ledger, never a number somebody typed, and demand is the issue
      -- rows rolled up by day.
      CREATE TABLE IF NOT EXISTS stock_movements (
        id INTEGER PRIMARY KEY,
        product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,
        kind TEXT NOT NULL CHECK(kind IN ('receipt','issue','adjustment')),
        quantity INTEGER NOT NULL CHECK(quantity != 0),
        occurred_at TEXT NOT NULL,
        reference TEXT NOT NULL DEFAULT '',
        note TEXT NOT NULL DEFAULT '',
        CHECK((kind = 'receipt' AND quantity > 0)
           OR (kind = 'issue' AND quantity < 0)
           OR kind = 'adjustment')
      );
      CREATE INDEX IF NOT EXISTS stock_movements_product
        ON stock_movements(product_id, occurred_at);
      -- Views hold no data, so they are rebuilt from this file on every start.
      -- A view created by an older version of the app can then never survive
      -- into a newer one and quietly answer with the old arithmetic.
      DROP VIEW IF EXISTS product_position;
      DROP VIEW IF EXISTS product_stock;
      CREATE VIEW product_stock AS
        SELECT p.id AS product_id, COALESCE(SUM(m.quantity),0) AS on_hand
        FROM products p LEFT JOIN stock_movements m ON m.product_id = p.id
        GROUP BY p.id;
      -- One number decides whether a product is in trouble: how long what we
      -- have plus what is on order will last at the current rate of sale.
      -- Everything the app and both agents show is derived here, once, so the
      -- watcher and the planner can never disagree about it.
      CREATE VIEW product_position AS
        SELECT p.id AS product_id,
          st.on_hand AS on_hand,
          COALESCE(oo.on_order,0) AS on_order,
          ROUND(COALESCE(dm.per_day,0),1) AS sells_per_day,
          CASE WHEN COALESCE(dm.per_day,0) <= 0 THEN 999
               ELSE CAST((st.on_hand + COALESCE(oo.on_order,0)) / dm.per_day
                         AS INTEGER) END AS days_of_cover,
          COALESCE(src.lead_time_days,0) AS lead_time_days
        FROM products p
        JOIN product_stock st ON st.product_id = p.id
        -- What is on order is what was ordered and has NOT yet arrived. A
        -- received unit is in the ledger, in on_hand; counting it here as well
        -- would say the depot holds it twice, and cover would climb for ever.
        LEFT JOIN (SELECT l.product_id,
                          SUM(l.quantity - l.received_quantity) AS on_order
                   FROM draft_order_lines l
                   JOIN draft_orders d ON d.id = l.draft_order_id
                   WHERE d.status IN ('ordered','part_received')
                   GROUP BY l.product_id) oo
          ON oo.product_id = p.id
        LEFT JOIN (SELECT product_id, SUM(-quantity)/28.0 AS per_day
                   FROM stock_movements
                   WHERE kind = 'issue'
                     AND date(occurred_at) >= date('now','-28 days')
                   GROUP BY product_id) dm
          ON dm.product_id = p.id
        LEFT JOIN (SELECT product_id, lead_time_days FROM product_suppliers
                   WHERE preferred = 1) src
          ON src.product_id = p.id;
      -- Checks are what the administrator wrote, in their own words. The
      -- watcher applies them to today's stock; the planner proposes orders that
      -- pass them. Nothing here machine-checks them.
      CREATE TABLE IF NOT EXISTS checks (
        id INTEGER PRIMARY KEY, text TEXT NOT NULL,
        enabled INTEGER NOT NULL DEFAULT 1,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL
      );
      -- The watcher's output. Refreshed rather than duplicated while a
      -- condition persists, and resolved by the watcher when it stops holding.
      CREATE TABLE IF NOT EXISTS warnings (
        id INTEGER PRIMARY KEY,
        product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,
        check_id INTEGER NOT NULL DEFAULT 0,
        severity TEXT NOT NULL CHECK(severity IN ('critical','warning')),
        text TEXT NOT NULL,
        first_seen TEXT NOT NULL, last_seen TEXT NOT NULL,
        resolved_at TEXT NOT NULL DEFAULT '',
        last_run_id INTEGER NOT NULL DEFAULT 0
      );
      CREATE INDEX IF NOT EXISTS warnings_open ON warnings(resolved_at, product_id);
      \{ordersDdl("draft_orders")}
      \{orderLinesDdl("draft_order_lines")}
      CREATE INDEX IF NOT EXISTS draft_order_lines_product
        ON draft_order_lines(product_id);
      \{receiptsDdl("order_receipts")}
      CREATE INDEX IF NOT EXISTS order_receipts_order
        ON order_receipts(draft_order_id, line_id);
      CREATE TABLE IF NOT EXISTS skill_revisions (
        id INTEGER PRIMARY KEY, skill_name TEXT NOT NULL, content TEXT NOT NULL,
        revision INTEGER NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(skill_name, revision)
      );
      CREATE TABLE IF NOT EXISTS runs (
        id INTEGER PRIMARY KEY,
        kind TEXT NOT NULL CHECK(kind IN ('watch','plan')),
        trigger TEXT NOT NULL,
        note TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL CHECK(status IN ('running','success','failed')),
        summary TEXT NOT NULL DEFAULT '', started_at TEXT NOT NULL,
        finished_at TEXT NOT NULL DEFAULT ''
      );
    """)
    if fresh then conn.execute("PRAGMA user_version = \{schemaVersion}")
    else migrate(conn)
    seed(conn)
    // A run is executed by this process, so none can outlive it. Anything left
    // 'running' belongs to a process that is gone — without this the row stays
    // running for ever, and the page waits on a run nobody is performing.
    conn.execute("""
      UPDATE runs SET status='failed', finished_at=datetime('now'),
        summary='The server stopped while this run was in progress. Nothing was '
                || 'recorded from it, and no warnings were resolved.'
      WHERE status='running'
    """)
    conn.commit()
    conn.close()

  //[ An order, from proposal to closed.
    !
    ! `draft` is what the planner produces and all it can produce. A person
    ! moves it to `ordered` or `rejected`; from there only a delivery moves it
    ! on, to `part_received` and then `received`. `cancelled` is the way an
    ! order that will never arrive stops counting towards cover.
    !
    ! The table is named for the draft it starts as, and keeps that name because
    ! renaming it would break every draft that already exists.
    !
    ! Parameterised by table name so a migration can build an identical copy
    ! under another name — the schema is written once, here, and a migrated
    ! database and a fresh one cannot end up differing.
  //]
  private def ordersDdl(table: String): String = """
      CREATE TABLE IF NOT EXISTS \{table} (
        id INTEGER PRIMARY KEY, supplier_id INTEGER NOT NULL REFERENCES suppliers(id),
        status TEXT NOT NULL CHECK(status IN
          ('draft','rejected','ordered','part_received','received','cancelled')),
        rationale TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
        -- When the last line of it is due, worked out from the lead times in
        -- force at the moment it was ordered. Recomputing it later from current
        -- terms would let a supplier's new lead time rewrite what we were
        -- promised, and an order would stop being late by being re-read.
        expected_at TEXT NOT NULL DEFAULT '',
        ordered_at TEXT NOT NULL DEFAULT '',
        closed_at TEXT NOT NULL DEFAULT ''
      );
  """

  private def orderLinesDdl(table: String): String = """
      CREATE TABLE IF NOT EXISTS \{table} (
        id INTEGER PRIMARY KEY,
        draft_order_id INTEGER NOT NULL REFERENCES draft_orders(id) ON DELETE CASCADE,
        product_id INTEGER NOT NULL REFERENCES products(id),
        quantity INTEGER NOT NULL CHECK(quantity > 0),
        received_quantity INTEGER NOT NULL DEFAULT 0,
        unit_price_cents INTEGER NOT NULL, line_total_cents INTEGER NOT NULL,
        UNIQUE(draft_order_id, product_id),
        -- Everything the depot believes about cover rests on this subtraction,
        -- so the database itself refuses a receipt that would make it lie.
        CHECK(received_quantity >= 0 AND received_quantity <= quantity)
      );
  """

  //[ One delivery of one line, and the ledger row it produced.
    !
    ! Keeping `movement_id` means a figure on the page traces back through the
    ! receipt to the exact movement that changed the balance, rather than the
    ! two records agreeing only by convention.
  //]
  private def receiptsDdl(table: String): String = """
      CREATE TABLE IF NOT EXISTS \{table} (
        id INTEGER PRIMARY KEY,
        draft_order_id INTEGER NOT NULL REFERENCES draft_orders(id) ON DELETE CASCADE,
        line_id INTEGER NOT NULL REFERENCES draft_order_lines(id) ON DELETE CASCADE,
        product_id INTEGER NOT NULL REFERENCES products(id),
        quantity INTEGER NOT NULL CHECK(quantity > 0),
        movement_id INTEGER NOT NULL REFERENCES stock_movements(id),
        received_at TEXT NOT NULL, note TEXT NOT NULL DEFAULT ''
      );
  """

  //[ Bring an existing database up to `schemaVersion`.
    !
    ! Each step is written once and runs at most once, in order, inside one
    ! transaction, so a database either arrives at the new shape or stays
    ! exactly as it was.
  //]
  private def migrate(conn: py.Dynamic): Unit =
    val version = conn.execute("PRAGMA user_version").fetchone()[0].asInt
    if version >= schemaVersion then return
    // Rebuilding a table means dropping the one its children point at, which
    // foreign keys will not allow mid-flight, and the rename must not rewrite
    // the references that already name it. Both are pragmas, and neither takes
    // effect inside a transaction, so they are set before it opens.
    conn.execute("PRAGMA foreign_keys = OFF")
    conn.execute("PRAGMA legacy_alter_table = ON")
    conn.execute("BEGIN IMMEDIATE")
    val outcome = py.try: upgrade(conn, version)
    // Whatever happened, this connection goes back to enforcing keys normally,
    // and the next one opened is unaffected either way.
    match outcome
    case Ok(_) => conn.commit()
    case Err(error) =>
      conn.rollback()
      conn.execute("PRAGMA foreign_keys = ON")
      conn.execute("PRAGMA legacy_alter_table = OFF")
      abort "the database could not be upgraded: \{error.message}"
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA legacy_alter_table = OFF")

  //[ The steps themselves, and the proof they left the database sound.
    !
    ! Rebuilding a table drops the one its children point at, so the references
    ! are checked before any of it is committed — an upgrade that broke them
    ! must not be the version that survives.
  //]
  private def upgrade(conn: py.Dynamic, version: Int): Unit =
    applyMigrations(conn, version)
    val broken = conn.execute("PRAGMA foreign_key_check").fetchall()
    if py.dynamic(broken).__len__().asInt != 0 then
      abort "it would have left dangling references"
    conn.execute("PRAGMA user_version = \{schemaVersion}")

  private def applyMigrations(conn: py.Dynamic, version: Int): Unit =
    if version < 1 then addReceiving(conn)

  //[ Version 1 — orders gain a life after acceptance.
    !
    ! Before this, `accepted` was the end of an order and its quantity counted
    ! towards cover for ever. It becomes `ordered`, which is a state a delivery
    ! can move it out of. Nothing that was received before now exists to be
    ! recorded, so every line starts at nothing received — which is what the
    ! old rows meant.
  //]
  private def addReceiving(conn: py.Dynamic): Unit =
    val steps = [
      ordersDdl("orders_next"),
      """
        INSERT INTO orders_next
          (id,supplier_id,status,rationale,total_cents,currency,
           created_at,updated_at,expected_at,ordered_at,closed_at)
        SELECT id, supplier_id,
          CASE status WHEN 'accepted' THEN 'ordered' ELSE status END,
          rationale, total_cents, currency, created_at, updated_at, '',
          CASE status WHEN 'accepted' THEN updated_at ELSE '' END,
          CASE status WHEN 'rejected' THEN updated_at ELSE '' END
        FROM draft_orders
      """,
      "DROP TABLE draft_orders",
      "ALTER TABLE orders_next RENAME TO draft_orders",
      orderLinesDdl("order_lines_next"),
      """
        INSERT INTO order_lines_next
          (id,draft_order_id,product_id,quantity,received_quantity,
           unit_price_cents,line_total_cents)
        SELECT id, draft_order_id, product_id, quantity, 0,
               unit_price_cents, line_total_cents
        FROM draft_order_lines
      """,
      "DROP TABLE draft_order_lines",
      "ALTER TABLE order_lines_next RENAME TO draft_order_lines",
      "CREATE INDEX IF NOT EXISTS draft_order_lines_product ON draft_order_lines(product_id)",
      receiptsDdl("order_receipts"),
      "CREATE INDEX IF NOT EXISTS order_receipts_order ON order_receipts(draft_order_id, line_id)"
    ]
    for statement in steps do conn.execute(statement)

  //[ Twelve products, four suppliers, four weeks of ledger.
    !
    ! Sized so the first screen tells a story without setup: four products will
    ! run out before a delivery could arrive, one of them is already covered by
    ! an open draft, and hand soap — the one with a slow preferred supplier and a
    ! faster alternate — is the worst of them.
  //]
  private def seed(conn: py.Dynamic): Unit =
    val count = conn.execute("SELECT COUNT(*) FROM suppliers").fetchone()[0].asInt
    if count > 0 then return

    conn.executemany:
      "INSERT INTO suppliers(id,name,currency) VALUES(?,?,?)"
      py.list:
        py.list(1, "Alpine Foods", "CHF")
        py.list(2, "Rhine Packaging", "CHF")
        py.list(3, "Nordic Hygiene", "EUR")
        py.list(4, "Helvetia Wholesale", "CHF")
    conn.executemany:
      """
      INSERT INTO products (id,sku,name,category,capacity) VALUES(?,?,?,?,?)
      """
      py.list:
        py.list(1,"FOOD-101","Pasta 500 g","food",240)
        py.list(2,"FOOD-102","Tomato sauce","food",180)
        py.list(3,"FOOD-103","Rice 1 kg","food",260)
        py.list(4,"FOOD-104","Olive oil 1 L","food",96)
        py.list(5,"PACK-201","Small cartons","packaging",1000)
        py.list(6,"PACK-202","Large cartons","packaging",500)
        py.list(7,"PACK-203","Paper tape","packaging",160)
        py.list(8,"PACK-204","Pallet wrap","packaging",180)
        py.list(9,"HYGI-301","Hand soap","hygiene",120)
        py.list(10,"HYGI-302","Surface cleaner","hygiene",150)
        py.list(11,"HYGI-303","Paper towels","hygiene",90)
        py.list(12,"HYGI-304","Waste bags","hygiene",220)

    // Preferred source first, then any alternate. Alternates are dearer and
    // faster — which is what gives a written check something to decide.
    conn.executemany:
      """
      INSERT INTO product_suppliers
        (product_id,supplier_id,unit_price_cents,lead_time_days,case_size,preferred)
      VALUES(?,?,?,?,?,?)
      """
      py.list:
        py.list(1,1,225,5,12,1)
        py.list(1,4,239,2,12,0)
        py.list(2,1,315,4,6,1)
        py.list(3,1,410,6,12,1)
        py.list(4,1,1180,8,6,1)
        py.list(4,4,1245,3,6,0)
        py.list(5,2,58,3,50,1)
        py.list(5,4,61,2,50,0)
        py.list(6,2,112,5,25,1)
        py.list(6,4,118,3,25,0)
        py.list(7,2,275,4,10,1)
        py.list(8,2,890,7,6,1)
        py.list(9,3,540,9,8,1)
        py.list(9,4,565,4,8,0)
        py.list(10,3,720,10,6,1)
        py.list(11,3,460,6,10,1)
        py.list(11,4,470,3,10,0)
        py.list(12,3,195,6,20,1)

    seedMovements(conn)

    // Already on order and still in transit, so it counts towards cover and
    // must not be ordered again. And one draft somebody left open, so the
    // planner has a reason to skip a product that genuinely is short.
    order(conn, "ordered", 2, 6, 100, 112, "Carton stock below a week of cover.")
    order(conn, "ordered", 3, 12, 20, 195, "Routine top-up before the weekend.")
    order(conn, "draft", 3, 11, 40, 460, "Paper towels are down to three days.")

    conn.executemany:
      """
      INSERT INTO checks(text,enabled,created_at,updated_at)
      VALUES(?,1,datetime('now'),datetime('now'))
      """
      py.list:
        py.list("Cover at least 5 days of demand beyond the supplier's lead time.")
        py.list("Food keeps 7 days of cover instead of 5: the category moves fast and a stockout there costs more than the extra holding cost.")
        py.list("Never propose more than 300 units of one product in a single order — receiving can only take two pallets of one item at a time.")
        py.list("Don't warn about packaging unless it is under 3 days of cover. We can get cartons and tape same-day if we have to.")

  //[ A seeded order, placed two days ago. One that is already `ordered` is
    ! due on the supplier's lead time counted from then, so the depot opens with
    ! deliveries genuinely in transit rather than with dates left blank.
  //]
  private def order(
    conn: py.Dynamic, status: String, supplierId: Int,
    productId: Int, quantity: Int, price: Int, rationale: String
  ): Unit =
    val cursor = conn.execute:
      """
      INSERT INTO draft_orders
        (supplier_id,status,rationale,total_cents,currency,created_at,updated_at,
         expected_at,ordered_at)
      SELECT ?, ?, ?, ?, s.currency, datetime('now','-2 days'), datetime('now','-2 days'),
        CASE WHEN ? = 'ordered' THEN
          (SELECT date('now','-2 days','+' || ps.lead_time_days || ' days')
           FROM product_suppliers ps
           WHERE ps.product_id = ? AND ps.supplier_id = s.id)
        ELSE '' END,
        CASE WHEN ? = 'ordered' THEN datetime('now','-2 days') ELSE '' END
      FROM suppliers s WHERE s.id = ?
      """
      py.list:
        supplierId
        status
        rationale
        quantity * price
        status
        productId
        status
        supplierId
    conn.execute:
      """
      INSERT INTO draft_order_lines
        (draft_order_id,product_id,quantity,unit_price_cents,line_total_cents)
      VALUES(?,?,?,?,?)
      """
      py.list(cursor.lastrowid.asInt, productId, quantity, price, quantity * price)

  //[ Four weeks of ledger per product.
    !
    ! An opening balance a week ahead of demand, a weekly delivery, and daily
    ! issues that wobble either side of the product's rate. The arithmetic is
    ! chosen so the ledger lands exactly on the intended stock level today.
  //]
  private def seedMovements(conn: py.Dynamic): Unit =
    val datetime = py.module("datetime")
    val today = datetime.date.today()
    // product ~ (units sold per day, stock on hand today)
    val plan = py.list:
      py.list(1,6,96)
      py.list(2,4,12)
      py.list(3,8,120)
      py.list(4,3,9)
      py.list(5,25,420)
      py.list(6,12,60)
      py.list(7,5,22)
      py.list(8,4,88)
      py.list(9,5,14)
      py.list(10,3,55)
      py.list(11,6,18)
      py.list(12,7,72)
    var movements = py.list()
    for raw in py.iter(plan) do
      val row = py.dynamic(raw)
      val productId = row[0].asInt
      val perDay = row[1].asInt
      val target = row[2].asInt
      val weekly = perDay * 7

      val opening = today.__sub__(datetime.timedelta(days = 29))
      movements.append: py.list:
        productId
        "receipt"
        target + weekly
        "\{opening.isoformat().asString} 08:00:00"
        "OPENING"
        "opening balance"

      var week = 3
      while week >= 1 do
        val day = today.__sub__(datetime.timedelta(days = week * 7))
        movements.append: py.list:
          productId
          "receipt"
          weekly
          "\{day.isoformat().asString} 07:00:00"
          "GRN-\{productId}\{week}"
          "weekly delivery"
        week = week - 1

      var age = 28
      while age >= 1 do
        val day = today.__sub__(datetime.timedelta(days = age))
        val quantity = if age % 2 == 0 then perDay + 1 else perDay - 1
        movements.append: py.list:
          productId
          "issue"
          0 - quantity
          "\{day.isoformat().asString} 09:00:00"
          "SO-\{productId}\{age}"
          ""
        age = age - 1
    conn.executemany:
      """
      INSERT INTO stock_movements(product_id,kind,quantity,occurred_at,reference,note)
      VALUES(?,?,?,?,?,?)
      """
      movements

  private def rows(sql: String): py.List = rowsWith(sql, py.list())

  private def rowsWith(sql: String, params: py.List): py.List =
    val conn = connect()
    val outcome = py.try: fetch(conn, sql, params)
    conn.close()
    match outcome
    case Ok(result) => result
    case Err(error) => abort error.message

  private def fetch(conn: py.Dynamic, sql: String, params: py.List): py.List =
    val result = py.list()
    for row in py.iter(conn.execute(sql, params).fetchall()) do
      result.append(py.module("builtins").dict(row))
    result

  def snapshot(): py.Dict =
    py.dict:
      "products"  ~ products()
      "suppliers" ~ suppliers()
      "summary"   ~ rows("""
        SELECT
          (SELECT COUNT(*) FROM products WHERE enabled = 1) AS product_count,
          (SELECT COUNT(*) FROM products p
           JOIN product_position pos ON pos.product_id = p.id
           WHERE p.enabled = 1 AND pos.days_of_cover < pos.lead_time_days)
            AS at_risk_count,
          (SELECT COUNT(*) FROM warnings WHERE resolved_at = '') AS open_warnings,
          (SELECT COUNT(*) FROM draft_orders WHERE status = 'draft') AS open_drafts,
          (SELECT COUNT(*) FROM draft_orders
           WHERE status IN ('ordered','part_received')) AS outstanding_orders,
          (SELECT COUNT(*) FROM draft_orders
           WHERE status IN ('ordered','part_received')
             AND expected_at != '' AND date(expected_at) < date('now'))
            AS overdue_orders,
          (SELECT COALESCE(MAX(finished_at),'') FROM runs
           WHERE kind = 'watch' AND status = 'success') AS last_checked
      """)[0]

  //[ Trouble first: the shortest cover at the top of the table. //]
  def products(): py.List =
    val result = rows("""
      SELECT p.*, pos.on_hand, pos.on_order, pos.sells_per_day,
             pos.days_of_cover, pos.lead_time_days
      FROM products p JOIN product_position pos ON pos.product_id = p.id
      ORDER BY pos.days_of_cover, p.sku
    """)
    for item in result do
      val product = item.cast[py.Dict]
      product.set:
        "sources"
        rowsWith:
          """
          SELECT ps.*, s.name AS supplier_name, s.currency
          FROM product_suppliers ps JOIN suppliers s ON s.id = ps.supplier_id
          WHERE ps.product_id = ?
          ORDER BY ps.preferred DESC, ps.unit_price_cents
          """
          py.list(product.get("id"))
    result

  def suppliers(): py.List = rows("""
    SELECT s.*,
      (SELECT COUNT(*) FROM product_suppliers ps WHERE ps.supplier_id = s.id)
        AS product_count,
      (SELECT COUNT(*) FROM product_suppliers ps
       WHERE ps.supplier_id = s.id AND ps.preferred = 1) AS preferred_count,
      (SELECT COUNT(*) FROM draft_orders d WHERE d.supplier_id = s.id) AS draft_count
    FROM suppliers s ORDER BY s.name
  """)

  def demand(days: Int): py.List =
    val safe = if days < 1 then 1 else if days > 365 then 365 else days
    rowsWith:
      """
      SELECT product_id, date(occurred_at) AS demand_date, SUM(-quantity) AS quantity
      FROM stock_movements
      WHERE kind = 'issue' AND date(occurred_at) >= date('now', ?)
      GROUP BY product_id, date(occurred_at)
      ORDER BY product_id, demand_date
      """
      py.list("-\{safe} days")

  def movements(productId: Int, limit: Int): py.List =
    val safe = if limit < 1 then 1 else if limit > 500 then 500 else limit
    if productId == 0 then
      rowsWith:
        """
        SELECT m.*, p.sku, p.name FROM stock_movements m
        JOIN products p ON p.id = m.product_id
        ORDER BY m.occurred_at DESC, m.id DESC LIMIT ?
        """
        py.list(safe)
    else
      rowsWith:
        """
        SELECT m.*, p.sku, p.name FROM stock_movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.product_id = ?
        ORDER BY m.occurred_at DESC, m.id DESC LIMIT ?
        """
        py.list(productId, safe)

  //[ The one way stock changes. The ledger may never go negative or past
    ! storage capacity, whoever is asking.
  //]
  def recordMovement(body: py.Dict): Int =
    val productId = body.get("product_id", 0).asInt
    val kind = body.get("kind", "").asString
    val amount = body.get("quantity", 0).asInt
    if kind != "receipt" && kind != "issue" && kind != "adjustment" then
      abort "unknown movement kind"
    if amount == 0 then abort "a movement needs a quantity"
    val signed = signedQuantity(kind, amount)
    inTransaction(conn => writeMovement(conn, productId, kind, signed, body))

  //[ Issues and receipts are entered as positive amounts; only an adjustment
    ! carries its own sign, which is how a stock count correction is recorded.
  //]
  private def signedQuantity(kind: String, amount: Int): Int =
    if kind == "adjustment" then amount
    else if kind == "issue" then 0 - magnitude(amount)
    else magnitude(amount)

  private def magnitude(value: Int): Int = if value < 0 then 0 - value else value

  //[ Run `write` inside one immediate transaction, and never leave the write
    ! lock behind for the next request when it is refused.
  //]
  private def inTransaction(write: py.Dynamic => Int): Int =
    val conn = connect()
    conn.execute("BEGIN IMMEDIATE")
    val outcome = py.try: write(conn)
    match outcome
    case Ok(value) =>
      conn.commit()
      conn.close()
      value
    case Err(error) =>
      conn.rollback()
      conn.close()
      abort error.message

  private def writeMovement(
    conn: py.Dynamic, productId: Int, kind: String, signed: Int, body: py.Dict
  ): Int =
    val product = conn
      .execute:
         "SELECT capacity FROM products WHERE id = ? AND enabled = 1"
         py.list(productId)
      .fetchone()
    if product.isNone then abort "unknown or disabled product"
    val capacity = product[0].asInt
    val balance = conn
      .execute:
         "SELECT COALESCE(SUM(quantity),0) FROM stock_movements WHERE product_id = ?"
         py.list(productId)
      .fetchone()[0].asInt
    val after = balance + signed
    if after < 0 then
      abort "only \{balance} in stock, so that movement cannot be recorded"
    if after > capacity then
      abort "that movement would exceed the storage capacity of \{capacity}"
    val cursor = conn.execute:
      """
      INSERT INTO stock_movements(product_id,kind,quantity,occurred_at,reference,note)
      VALUES(?,?,?,COALESCE(NULLIF(?,''),datetime('now')),?,?)
      """
      py.list:
        productId
        kind
        signed
        body.get("occurred_at", "").asString.trim
        body.get("reference", "").asString.trim
        body.get("note", "").asString.trim
    cursor.lastrowid.asInt

  def saveProduct(body: py.Dict): Int =
    val sources = body.get("sources", py.list()).cast[py.List]
    if sources.size == 0 then abort "a product needs at least one supplier"
    inTransaction(conn => writeProduct(conn, body, sources))

  private def writeProduct(conn: py.Dynamic, body: py.Dict, sources: py.List): Int =
    val given = body.get("id", 0).asInt
    val params = py.list:
      body.get("sku", "").asString.trim
      body.get("name", "").asString.trim
      body.get("category", "").asString.trim
      body.get("capacity", 1).asInt
      if body.get("enabled", true).asBool then 1 else 0
    val id = if given == 0 then insertProduct(conn, params, body)
             else updateProduct(conn, params, given)
    replaceSources(conn, id, sources)
    id

  private def insertProduct(conn: py.Dynamic, params: py.List, body: py.Dict): Int =
    val created = insert:
      conn
      """
      INSERT INTO products (sku,name,category,capacity,enabled) VALUES(?,?,?,?,?)
      """
      params
    // Stock only ever arrives through the ledger, opening balances included.
    val opening = body.get("opening_stock", 0).asInt
    if opening > 0 then
      conn.execute:
        """
        INSERT INTO stock_movements(product_id,kind,quantity,occurred_at,reference,note)
        VALUES(?,'receipt',?,datetime('now'),'OPENING','opening balance')
        """
        py.list(created, opening)
    created

  private def updateProduct(conn: py.Dynamic, params: py.List, id: Int): Int =
    params.append(id)
    conn.execute:
      """
      UPDATE products SET sku=?,name=?,category=?,capacity=?,enabled=? WHERE id=?
      """
      params
    id

  //[ The submitted set is authoritative, and exactly one row stays preferred. //]
  private def replaceSources(conn: py.Dynamic, productId: Int, sources: py.List): Unit =
    conn.execute("DELETE FROM product_suppliers WHERE product_id=?", py.list(productId))
    var preferredSeen = false
    for raw in py.iter(sources) do
      val source = raw.cast[py.Dict]
      val caseSize = source.get("case_size", 1).asInt
      if caseSize < 1 then abort "case size must be at least 1"
      val wanted = source.get("preferred", false).asBool
      val preferred = if wanted && !preferredSeen then 1 else 0
      if preferred == 1 then preferredSeen = true
      conn.execute:
        """
        INSERT INTO product_suppliers
          (product_id,supplier_id,unit_price_cents,lead_time_days,case_size,preferred)
        VALUES(?,?,?,?,?,?)
        """
        py.list:
          productId
          source.get("supplier_id", 0).asInt
          source.get("unit_price_cents", 0).asInt
          source.get("lead_time_days", 1).asInt
          caseSize
          preferred
    if !preferredSeen then
      conn.execute:
        """
        UPDATE product_suppliers SET preferred=1
        WHERE rowid = (SELECT rowid FROM product_suppliers
                       WHERE product_id=? ORDER BY unit_price_cents LIMIT 1)
        """
        py.list(productId)

  def checks(): py.List = rows("SELECT * FROM checks ORDER BY id")

  def saveCheck(body: py.Dict): Int =
    val text = body.get("text", "").asString.trim
    if text == "" then abort "a check needs text"
    val enabled = if body.get("enabled", true).asBool then 1 else 0
    inTransaction(conn => writeCheck(conn, body.get("id", 0).asInt, text, enabled))

  private def writeCheck(conn: py.Dynamic, id: Int, text: String, enabled: Int): Int =
    if id == 0 then
      val cursor = conn.execute:
        """
        INSERT INTO checks(text,enabled,created_at,updated_at)
        VALUES(?,?,datetime('now'),datetime('now'))
        """
        py.list(text, enabled)
      cursor.lastrowid.asInt
    else
      conn.execute:
        """
        UPDATE checks SET text=?,enabled=?,updated_at=datetime('now') WHERE id=?
        """
        py.list(text, enabled, id)
      id

  def deleteCheck(id: Int): Unit =
    val _ = inTransaction(conn => execute(conn,
      "DELETE FROM checks WHERE id=?", py.list(id)))

  //[ Run one statement and report how many rows it touched. //]
  private def execute(conn: py.Dynamic, sql: String, params: py.List): Int =
    val cursor = conn.execute(sql, params)
    cursor.rowcount.asInt

  //[ What the watcher is currently saying, worst first. //]
  def warnings(): py.List = rows("""
    SELECT w.*, p.sku, p.name AS product_name, pos.days_of_cover, pos.lead_time_days,
           COALESCE(c.text,'') AS check_text
    FROM warnings w
    JOIN products p ON p.id = w.product_id
    JOIN product_position pos ON pos.product_id = w.product_id
    LEFT JOIN checks c ON c.id = w.check_id
    WHERE w.resolved_at = ''
    ORDER BY CASE w.severity WHEN 'critical' THEN 0 ELSE 1 END, pos.days_of_cover
  """)

  //[ Anything the watcher did not raise again this run no longer holds. //]
  def resolveWarningsNotRaisedBy(runId: Int): Int =
    inTransaction: conn =>
      execute:
        conn
        """
        UPDATE warnings SET resolved_at = datetime('now')
        WHERE resolved_at = '' AND last_run_id != ?
        """
        py.list(runId)

  //[ Every order, whatever state it reached, with what is still owed on each
    ! line and every delivery already booked against it.
  //]
  def drafts(): py.List =
    val result = rows("""
      SELECT d.*, s.name AS supplier_name,
        (d.status IN ('ordered','part_received')) AS outstanding,
        (d.status IN ('ordered','part_received') AND d.expected_at != ''
           AND date(d.expected_at) < date('now')) AS overdue
      FROM draft_orders d
      JOIN suppliers s ON s.id = d.supplier_id ORDER BY d.id DESC
    """)
    for item in result do
      val d = item.cast[py.Dict]
      d.set:
        "lines"
        rowsWith:
          """
          SELECT l.*, p.sku, p.name,
                 l.quantity - l.received_quantity AS outstanding_quantity
          FROM draft_order_lines l
          JOIN products p ON p.id = l.product_id
          WHERE l.draft_order_id = ? ORDER BY p.sku
          """
          py.list(d.get("id"))
      d.set:
        "receipts"
        rowsWith:
          """
          SELECT r.*, p.sku, p.name FROM order_receipts r
          JOIN products p ON p.id = r.product_id
          WHERE r.draft_order_id = ? ORDER BY r.received_at, r.id
          """
          py.list(d.get("id"))
    result

  //[ Move one order along its life, by hand.
    !
    ! Only the transitions a person makes are here. `part_received` and
    ! `received` are not among them: an order arrives because goods arrived, so
    ! those are reached by recording a delivery and by nothing else.
    !
    ! `accepted` is the word the page has always used for placing an order, and
    ! it still works; the state it now writes is `ordered`, because an order
    ! half-delivered is no longer meaningfully "accepted".
  //]
  def setDraftStatus(id: Int, status: String): Bool =
    val wanted = if status == "accepted" then "ordered" else status
    if wanted == "ordered" then place(id)
    else if wanted == "rejected" then close(id, "rejected", "'draft'")
    // Cancelling leaves what already arrived in the ledger and stops the rest
    // counting towards cover — which the outstanding sum does on its own, as
    // soon as the order is no longer in an outstanding state.
    else if wanted == "cancelled" then close(id, "cancelled", "'ordered','part_received'")
    else false

  //[ Placing an order fixes what we were promised: the longest lead time on it,
    ! read once, from the terms in force now.
  //]
  private def place(id: Int): Bool =
    inTransaction(conn => execute(conn, """
      UPDATE draft_orders SET status='ordered', updated_at=datetime('now'),
        ordered_at=datetime('now'),
        expected_at=COALESCE((
          SELECT date('now','+' || MAX(ps.lead_time_days) || ' days')
          FROM draft_order_lines l
          JOIN product_suppliers ps ON ps.product_id = l.product_id
                                   AND ps.supplier_id = draft_orders.supplier_id
          WHERE l.draft_order_id = draft_orders.id), date('now'))
      WHERE id=? AND status='draft'
    """, py.list(id))) == 1

  //[ `allowed` is the SQL list of states this transition may leave, written
    ! literally at the call site because it is fixed there, never user input.
  //]
  private def close(id: Int, status: String, allowed: String): Bool =
    inTransaction(conn => execute(conn, """
      UPDATE draft_orders SET status=?,updated_at=datetime('now'),
        closed_at=datetime('now')
      WHERE id=? AND status IN (\{allowed})
    """, py.list(status, id))) == 1

  //[ Booking a delivery in. This is the only thing that moves an order out of
    ! the outstanding set, and the only place ordered stock becomes real stock.
    !
    ! Every unit received is written to the ledger as an ordinary receipt, past
    ! the same guards as one keyed in by hand, and linked to the line it
    ! settles. Nothing sets a balance; the balance is still the sum of the
    ! ledger, and now the ledger holds the delivery too.
    !
    ! Returns how many units were booked.
  //]
  def receiveOrder(body: py.Dict): Int =
    val orderId = body.get("order_id", 0).asInt
    val lines = body.get("lines", py.list()).cast[py.List]
    if lines.size == 0 then abort "a delivery needs at least one line"
    inTransaction(conn => writeReceipt(conn, orderId, lines, body))

  private def writeReceipt(
    conn: py.Dynamic, orderId: Int, lines: py.List, body: py.Dict
  ): Int =
    val order = conn
      .execute:
         "SELECT status FROM draft_orders WHERE id = ?"
         py.list(orderId)
      .fetchone()
    if order.isNone then abort "unknown order"
    val status = order[0].asString
    if status != "ordered" && status != "part_received" then
      abort "order \{orderId} is \{status}, so nothing can be received against it"

    val occurredAt = body.get("occurred_at", "").asString.trim
    val note = body.get("note", "").asString.trim
    var seen: List[Int] = []
    var total = 0
    for raw in py.iter(lines) do
      val line = raw.cast[py.Dict]
      val lineId = line.get("line_id", 0).asInt
      val quantity = line.get("quantity", 0).asInt
      if quantity <= 0 then abort "a delivered line needs a positive quantity"
      // Two rows for one line would each be checked against the same
      // outstanding figure, and together could overshoot it.
      if seen.contains(lineId) then
        abort "line \{lineId} appears twice in one delivery"
      seen = seen + lineId
      total = total + receiveLine(conn, orderId, lineId, quantity, occurredAt, note)
    settle(conn, orderId)
    total

  private def receiveLine(
    conn: py.Dynamic, orderId: Int, lineId: Int, quantity: Int,
    occurredAt: String, note: String
  ): Int =
    val row = conn
      .execute:
         """
         SELECT product_id, quantity - received_quantity
         FROM draft_order_lines WHERE id = ? AND draft_order_id = ?
         """
         py.list(lineId, orderId)
      .fetchone()
    if row.isNone then abort "line \{lineId} is not on order \{orderId}"
    val productId = row[0].asInt
    val outstanding = row[1].asInt
    if outstanding <= 0 then abort "that line has already been delivered in full"
    // A supplier really can send more than was ordered, but this order cannot
    // absorb it: what is outstanding would go negative and cover would read
    // low for ever after. The excess is stock that arrived against no line, so
    // it belongs in the ledger as its own receipt.
    if quantity > outstanding then
      val excess = "only \{outstanding} of that line is still outstanding; "
        + "record anything over that as a separate receipt"
      abort excess

    val movementId = writeMovement:
      conn
      productId
      "receipt"
      quantity
      py.dict:
        "occurred_at" ~ occurredAt
        "reference"   ~ "PO-\{orderId}"
        "note"        ~ note
    conn.execute:
      """
      UPDATE draft_order_lines SET received_quantity = received_quantity + ?
      WHERE id = ?
      """
      py.list(quantity, lineId)
    conn.execute:
      """
      INSERT INTO order_receipts
        (draft_order_id,line_id,product_id,quantity,movement_id,received_at,note)
      VALUES(?,?,?,?,?,COALESCE(NULLIF(?,''),datetime('now')),?)
      """
      py.list(orderId, lineId, productId, quantity, movementId, occurredAt, note)
    quantity

  //[ An order is received once every line is, and part-received until then.
    ! What is still owed keeps counting towards cover, because it is still
    ! coming.
  //]
  private def settle(conn: py.Dynamic, orderId: Int): Unit =
    val remaining = conn
      .execute:
         """
         SELECT COALESCE(SUM(quantity - received_quantity),0)
         FROM draft_order_lines WHERE draft_order_id = ?
         """
         py.list(orderId)
      .fetchone()[0].asInt
    if remaining == 0 then
      conn.execute:
        """
        UPDATE draft_orders SET status='received', updated_at=datetime('now'),
          closed_at=datetime('now') WHERE id=?
        """
        py.list(orderId)
    else
      conn.execute:
        """
        UPDATE draft_orders SET status='part_received', updated_at=datetime('now')
        WHERE id=?
        """
        py.list(orderId)

  def runs(): py.List = rows("SELECT * FROM runs ORDER BY id DESC LIMIT 20")

  def beginRun(kind: String, trigger: String, note: String): Int =
    inTransaction: conn =>
      insert:
        conn
        """
        INSERT INTO runs(kind,trigger,note,status,started_at)
        VALUES(?,?,?,'running',datetime('now'))
        """
        py.list(kind, trigger, note)

  private def insert(conn: py.Dynamic, sql: String, params: py.List): Int =
    val cursor = conn.execute(sql, params)
    cursor.lastrowid.asInt

  def finishRun(id: Int, status: String, summary: String): Unit =
    val _ = inTransaction: conn =>
      execute:
        conn
        """
        UPDATE runs SET status=?,summary=?,finished_at=datetime('now') WHERE id=?
        """
        py.list(status, summary, id)

  //[ Skills are the planner's method, edited while the app runs. Every save
    ! records a revision, so the previous wording stays auditable.
  //]
  private def skillsDir(): String = os.path.join(home, "skills", "plan")

  def skillNames(): py.List =
    val result = py.list()
    for name in py.iter(py.module("os").listdir(skillsDir())) do
      val text = name.asString
      if text.endsWith(".md") then result.append(text.substring(0, text.size - 3))
    py.dynamic(result).sort()
    result

  def readSkill(name: String): String =
    File.read(os.path.join(skillsDir(), skillSlug(name) + ".md"))

  def saveSkill(name: String, content: String): String =
    val slug = skillSlug(name)
    if content.trim == "" then abort "skill content cannot be empty"
    val _ = inTransaction(conn => writeRevision(conn, slug, content))
    File.write(os.path.join(skillsDir(), slug + ".md"), content)
    slug

  private def writeRevision(conn: py.Dynamic, slug: String, content: String): Int =
    val next = conn
      .execute:
         "SELECT COALESCE(MAX(revision),0)+1 FROM skill_revisions WHERE skill_name=?"
         py.list(slug)
      .fetchone()[0].asInt
    conn.execute:
      """
      INSERT INTO skill_revisions(skill_name,content,revision,created_at)
      VALUES(?,?,?,datetime('now'))
      """
      py.list(slug, content, next)
    next

  def skillRevisions(name: String): py.List =
    rowsWith:
      """
      SELECT revision, created_at, LENGTH(content) AS size
      FROM skill_revisions WHERE skill_name=? ORDER BY revision DESC
      """
      py.list(skillSlug(name))

  def skillRevision(name: String, revision: Int): String =
    val found = rowsWith(
      "SELECT content FROM skill_revisions WHERE skill_name=? AND revision=?",
      py.list(skillSlug(name), revision))
    if found.size == 0 then abort "no such revision"
    found[0].cast[py.Dict].get("content").asString

  def deleteSkill(name: String): Bool =
    val slug = skillSlug(name)
    if slug == "planning" then return false
    val target = os.path.join(skillsDir(), slug + ".md")
    if !File.exists(target) then return false
    py.module("os").remove(target)
    true

  //[ A strict slug allowlist rather than trusting a path from the browser. //]
  private def skillSlug(name: String): String =
    val slug = py.dynamic(name.trim).lower().asString
    val valid = py.module("re").fullmatch("[a-z0-9]+(?:-[a-z0-9]+)*", slug)
    if valid.isNone || slug == "api" || slug == "types" then
      abort "invalid or reserved skill name"
    slug
end
