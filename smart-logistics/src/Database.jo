namespace harpe.examples.smartlogistics

import harpe.ffi.os
import harpe.util.File

class Database(path: String, home: String)
  private def connect(): py.Dynamic =
    val sqlite = py.module("sqlite3")
    val conn = sqlite.connect(path, timeout = 10.0)
    conn.row_factory = sqlite.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA busy_timeout = 10000")
    conn

  def initialize(): Unit =
    File.ensureDir(os.path.dirname(path))
    val conn = connect()
    conn.executescript("""
      CREATE TABLE IF NOT EXISTS suppliers (
        id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE,
        currency TEXT NOT NULL DEFAULT 'CHF', enabled INTEGER NOT NULL DEFAULT 1
      );
      CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY, sku TEXT NOT NULL UNIQUE, name TEXT NOT NULL,
        category TEXT NOT NULL,
        reserved INTEGER NOT NULL DEFAULT 0 CHECK(reserved >= 0),
        incoming INTEGER NOT NULL DEFAULT 0 CHECK(incoming >= 0),
        incoming_eta TEXT NOT NULL DEFAULT '',
        capacity INTEGER NOT NULL CHECK(capacity > 0),
        enabled INTEGER NOT NULL DEFAULT 1
      );
      -- Price, lead time and pack sizes are terms of one product-supplier
      -- relationship, not properties of the product. A product can be sourced
      -- from several suppliers; exactly one of them is the preferred source.
      CREATE TABLE IF NOT EXISTS product_suppliers (
        product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,
        supplier_id INTEGER NOT NULL REFERENCES suppliers(id),
        unit_price_cents INTEGER NOT NULL CHECK(unit_price_cents >= 0),
        lead_time_days INTEGER NOT NULL DEFAULT 1 CHECK(lead_time_days >= 0),
        case_size INTEGER NOT NULL DEFAULT 1 CHECK(case_size > 0),
        minimum_order_quantity INTEGER NOT NULL DEFAULT 1 CHECK(minimum_order_quantity > 0),
        preferred INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY(product_id, supplier_id),
        CHECK(minimum_order_quantity % case_size = 0)
      );
      CREATE INDEX IF NOT EXISTS product_suppliers_supplier
        ON product_suppliers(supplier_id);
      -- Every unit that entered or left the depot. Stock on hand is the sum of
      -- this ledger, never a number somebody typed, and demand history is the
      -- issue rows rolled up by day.
      CREATE TABLE IF NOT EXISTS stock_movements (
        id INTEGER PRIMARY KEY,
        product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE,
        kind TEXT NOT NULL CHECK(kind IN ('receipt','issue','adjustment')),
        quantity INTEGER NOT NULL CHECK(quantity != 0),
        occurred_at TEXT NOT NULL,
        reference TEXT NOT NULL DEFAULT '',
        note TEXT NOT NULL DEFAULT '',
        CHECK((kind = 'receipt' AND quantity > 0)
           OR (kind = 'issue' AND quantity < 0)
           OR kind = 'adjustment')
      );
      CREATE INDEX IF NOT EXISTS stock_movements_product
        ON stock_movements(product_id, occurred_at);
      CREATE VIEW IF NOT EXISTS product_stock AS
        SELECT p.id AS product_id, COALESCE(SUM(m.quantity),0) AS on_hand
        FROM products p LEFT JOIN stock_movements m ON m.product_id = p.id
        GROUP BY p.id;
      CREATE TABLE IF NOT EXISTS rules (
        id INTEGER PRIMARY KEY, text TEXT NOT NULL,
        enabled INTEGER NOT NULL DEFAULT 1,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL
      );
      CREATE TABLE IF NOT EXISTS draft_orders (
        id INTEGER PRIMARY KEY, supplier_id INTEGER NOT NULL REFERENCES suppliers(id),
        status TEXT NOT NULL CHECK(status IN ('draft','accepted','rejected')),
        rationale TEXT NOT NULL, total_cents INTEGER NOT NULL, currency TEXT NOT NULL,
        created_at TEXT NOT NULL, updated_at TEXT NOT NULL
      );
      CREATE TABLE IF NOT EXISTS draft_order_lines (
        id INTEGER PRIMARY KEY,
        draft_order_id INTEGER NOT NULL REFERENCES draft_orders(id) ON DELETE CASCADE,
        product_id INTEGER NOT NULL REFERENCES products(id),
        quantity INTEGER NOT NULL CHECK(quantity > 0),
        unit_price_cents INTEGER NOT NULL, line_total_cents INTEGER NOT NULL,
        UNIQUE(draft_order_id, product_id)
      );
      CREATE INDEX IF NOT EXISTS draft_order_lines_product
        ON draft_order_lines(product_id);
      CREATE TABLE IF NOT EXISTS skill_revisions (
        id INTEGER PRIMARY KEY, skill_name TEXT NOT NULL, content TEXT NOT NULL,
        revision INTEGER NOT NULL, created_at TEXT NOT NULL,
        UNIQUE(skill_name, revision)
      );
      CREATE TABLE IF NOT EXISTS analysis_runs (
        id INTEGER PRIMARY KEY, trigger TEXT NOT NULL,
        status TEXT NOT NULL CHECK(status IN ('running','success','failed','busy')),
        summary TEXT NOT NULL DEFAULT '', started_at TEXT NOT NULL,
        finished_at TEXT NOT NULL DEFAULT ''
      );
    """)
    seed(conn)
    conn.commit()
    conn.close()

  private def inDays(days: Int): String =
    val datetime = py.module("datetime")
    datetime.date.today().__add__(datetime.timedelta(days = days)).isoformat().asString

  private def seed(conn: py.Dynamic): Unit =
    val count = conn.execute("SELECT COUNT(*) FROM suppliers").fetchone()[0].asInt
    if count > 0 then return

    conn.executemany("INSERT INTO suppliers(id,name,currency) VALUES(?,?,?)", py.list(
      py.list(1, "Alpine Foods", "CHF"),
      py.list(2, "Rhine Packaging", "CHF"),
      py.list(3, "Nordic Hygiene", "EUR"),
      py.list(4, "Helvetia Wholesale", "CHF")
    ))
    conn.executemany("""
      INSERT INTO products
        (id,sku,name,category,reserved,incoming,incoming_eta,capacity)
      VALUES(?,?,?,?,?,?,?,?)
    """, py.list(
      py.list(1,"FOOD-101","Pasta 500 g","food",8,0,"",240),
      py.list(2,"FOOD-102","Tomato sauce","food",6,0,"",180),
      py.list(3,"FOOD-103","Rice 1 kg","food",10,24,inDays(3),260),
      py.list(4,"FOOD-104","Olive oil 1 L","food",2,0,"",96),
      py.list(5,"PACK-201","Small cartons","packaging",80,0,"",1000),
      py.list(6,"PACK-202","Large cartons","packaging",20,100,inDays(5),500),
      py.list(7,"PACK-203","Paper tape","packaging",7,0,"",160),
      py.list(8,"PACK-204","Pallet wrap","packaging",12,0,"",180),
      py.list(9,"HYGI-301","Hand soap","hygiene",4,0,"",120),
      py.list(10,"HYGI-302","Surface cleaner","hygiene",10,0,"",150),
      py.list(11,"HYGI-303","Paper towels","hygiene",3,0,"",90),
      py.list(12,"HYGI-304","Waste bags","hygiene",15,20,inDays(2),220)
    ))

    // Preferred source first, then any alternate. Alternates are dearer and
    // faster, which is what gives a written sourcing rule something to decide.
    conn.executemany("""
      INSERT INTO product_suppliers
        (product_id,supplier_id,unit_price_cents,lead_time_days,
         case_size,minimum_order_quantity,preferred)
      VALUES(?,?,?,?,?,?,?)
    """, py.list(
      py.list(1,1,225,5,12,24,1),   py.list(1,4,239,2,12,24,0),
      py.list(2,1,315,4,6,12,1),
      py.list(3,1,410,6,12,24,1),
      py.list(4,1,1180,8,6,12,1),   py.list(4,4,1245,3,6,12,0),
      py.list(5,2,58,3,50,100,1),   py.list(5,4,61,2,50,100,0),
      py.list(6,2,112,5,25,50,1),   py.list(6,4,118,3,25,50,0),
      py.list(7,2,275,4,10,20,1),
      py.list(8,2,890,7,6,12,1),
      py.list(9,3,540,9,8,16,1),    py.list(9,4,565,4,8,16,0),
      py.list(10,3,720,10,6,12,1),
      py.list(11,3,460,6,10,20,1),  py.list(11,4,470,3,10,20,0),
      py.list(12,3,195,6,20,40,1)
    ))

    seedMovements(conn)

    conn.executemany("""
      INSERT INTO rules(text,enabled,created_at,updated_at)
      VALUES(?,1,datetime('now'),datetime('now'))
    """, py.list(
      py.list("Cover at least 5 days of demand beyond supplier lead time for every product."),
      py.list("Food keeps 7 days of cover instead of 5: the category moves fast and a stockout there is more expensive than the extra holding cost."),
      py.list("Never propose more than 300 units of one product in a single draft, even when the arithmetic asks for more. Split it across two analyses instead."),
      py.list("Keep the total value of any single draft at or below 150000 cents. Say so in the report when this is what limited an order."),
      py.list("Keep at least 10 available units of every product after reserved commitments.")
    ))

  // Four weeks of issues per product, an opening receipt sized so that the
  // ledger settles on the intended stock level, and a mid-period restock for a
  // few products so the movement list shows more than one kind of row.
  private def seedMovements(conn: py.Dynamic): Unit =
    val datetime = py.module("datetime")
    val today = datetime.date.today()
    val targets = py.list(34,18,110,7,420,65,22,88,14,55,9,72)
    val restocks = py.dict(3 ~ 60, 6 ~ 40, 12 ~ 80)
    var movements = py.list()
    var productId = 1
    while productId <= 12 do
      var issued = 0
      var age = 28
      while age >= 1 do
        val day = today.__sub__(datetime.timedelta(days = age))
        val base = (productId * 3 + age * 5) % 9 + 1
        val quantity = if productId == 4 || productId == 11 then base + 3 else base
        issued = issued + quantity
        movements.append(py.list(productId, "issue", 0 - quantity,
          "\{day.isoformat().asString} 09:00:00", "SO-\{productId}\{age}", ""))
        age = age - 1
      val restock = restocks.get(productId, 0).asInt
      if restock > 0 then
        val day = today.__sub__(datetime.timedelta(days = 10))
        movements.append(py.list(productId, "receipt", restock,
          "\{day.isoformat().asString} 07:30:00", "GRN-\{productId}", "supplier delivery"))
      val opening = targets[productId - 1].asInt + issued - restock
      val start = today.__sub__(datetime.timedelta(days = 29))
      movements.append(py.list(productId, "receipt", opening,
        "\{start.isoformat().asString} 08:00:00", "OPENING", "opening balance"))
      productId = productId + 1
    conn.executemany("""
      INSERT INTO stock_movements(product_id,kind,quantity,occurred_at,reference,note)
      VALUES(?,?,?,?,?,?)
    """, movements)

  private def rows(sql: String): py.List = rowsWith(sql,py.list())

  private def rowsWith(sql: String, params: py.List): py.List =
    val conn = connect()
    val result = py.list()
    for row in py.iter(conn.execute(sql, params).fetchall()) do
      result.append(py.module("builtins").dict(row))
    conn.close()
    result

  def snapshot(): py.Dict =
    py.dict(
      "products" ~ products(),
      "suppliers" ~ suppliers(),
      "summary" ~ rows("""
        SELECT COUNT(*) AS product_count,
          SUM(CASE WHEN st.on_hand-p.reserved+p.incoming <
                (SELECT MIN(ps.minimum_order_quantity) FROM product_suppliers ps
                 WHERE ps.product_id = p.id)
              THEN 1 ELSE 0 END) AS low_stock_count,
          SUM(st.on_hand * COALESCE(\{preferredPrice},0)) AS inventory_value_cents,
          (SELECT COUNT(*) FROM draft_orders WHERE status='draft') AS draft_count
        FROM products p JOIN product_stock st ON st.product_id = p.id
        WHERE p.enabled=1
      """)[0]
    )

  // Inventory is valued at the preferred source's price. There are no receipts
  // to average, so this is a stated proxy rather than a costing method.
  private val preferredPrice = """
    (SELECT ps.unit_price_cents FROM product_suppliers ps
     WHERE ps.product_id = p.id
     ORDER BY ps.preferred DESC, ps.unit_price_cents LIMIT 1)
  """

  def suppliers(): py.List = rows("""
    SELECT s.*,
      (SELECT COUNT(*) FROM product_suppliers ps WHERE ps.supplier_id = s.id)
        AS product_count,
      (SELECT COUNT(*) FROM product_suppliers ps
       WHERE ps.supplier_id = s.id AND ps.preferred = 1) AS preferred_count,
      (SELECT COUNT(*) FROM draft_orders d WHERE d.supplier_id = s.id) AS draft_count
    FROM suppliers s ORDER BY s.name
  """)

  // Daily demand for every product: the issue rows, rolled up by day.
  def demand(days: Int): py.List =
    val safe = if days < 1 then 1 else if days > 365 then 365 else days
    rowsWith("""
      SELECT product_id, date(occurred_at) AS demand_date, SUM(-quantity) AS quantity
      FROM stock_movements
      WHERE kind = 'issue' AND date(occurred_at) >= date('now', ?)
      GROUP BY product_id, date(occurred_at)
      ORDER BY product_id, demand_date
    """, py.list("-\{safe} days"))

  def movements(productId: Int, limit: Int): py.List =
    val safe = if limit < 1 then 1 else if limit > 500 then 500 else limit
    if productId == 0 then
      rowsWith("""
        SELECT m.*, p.sku, p.name FROM stock_movements m
        JOIN products p ON p.id = m.product_id
        ORDER BY m.occurred_at DESC, m.id DESC LIMIT ?
      """, py.list(safe))
    else
      rowsWith("""
        SELECT m.*, p.sku, p.name FROM stock_movements m
        JOIN products p ON p.id = m.product_id
        WHERE m.product_id = ?
        ORDER BY m.occurred_at DESC, m.id DESC LIMIT ?
      """, py.list(productId, safe))

  // The one way stock changes. Receipts add, issues subtract, adjustments do
  // either, and the ledger may never go negative or past storage capacity.
  def recordMovement(body: py.Dict): Int =
    val productId = body.get("product_id", 0).asInt
    val kind = body.get("kind", "").asString
    val amount = body.get("quantity", 0).asInt
    if kind != "receipt" && kind != "issue" && kind != "adjustment" then
      abort "unknown movement kind"
    if amount == 0 then abort "a movement needs a quantity"
    val signed = if kind == "issue" then 0 - magnitude(amount)
      else if kind == "receipt" then magnitude(amount)
      else amount
    val conn = connect()
    conn.execute("BEGIN IMMEDIATE")
    val outcome = py.try: writeMovement(conn, productId, kind, signed, body)
    match outcome
    case Ok(id) =>
      conn.commit()
      conn.close()
      id
    case Err(error) =>
      conn.rollback()
      conn.close()
      abort error.message

  private def magnitude(value: Int): Int = if value < 0 then 0 - value else value

  private def writeMovement(
    conn: py.Dynamic,
    productId: Int,
    kind: String,
    signed: Int,
    body: py.Dict
  ): Int =
    val product = conn.execute(
      "SELECT capacity FROM products WHERE id = ? AND enabled = 1",
      py.list(productId)).fetchone()
    if product.isNone then abort "unknown or disabled product"
    val capacity = product[0].asInt
    val balance = conn.execute(
      "SELECT COALESCE(SUM(quantity),0) FROM stock_movements WHERE product_id = ?",
      py.list(productId)).fetchone()[0].asInt
    val after = balance + signed
    if after < 0 then
      abort "only \{balance} in stock, so that movement cannot be recorded"
    if after > capacity then
      abort "that movement would exceed the storage capacity of \{capacity}"
    val cursor = conn.execute("""
      INSERT INTO stock_movements(product_id,kind,quantity,occurred_at,reference,note)
      VALUES(?,?,?,COALESCE(NULLIF(?,''),datetime('now')),?,?)
    """, py.list(productId, kind, signed,
      body.get("occurred_at", "").asString.trim,
      body.get("reference", "").asString.trim,
      body.get("note", "").asString.trim))
    cursor.lastrowid.asInt

  def products(): py.List =
    val result = rows("""
      SELECT p.*, st.on_hand, (st.on_hand - p.reserved) AS available
      FROM products p JOIN product_stock st ON st.product_id = p.id
      ORDER BY p.sku
    """)
    for item in result do
      val product = item.cast[py.Dict]
      product.set("sources", rowsWith("""
        SELECT ps.*, s.name AS supplier_name, s.currency
        FROM product_suppliers ps JOIN suppliers s ON s.id = ps.supplier_id
        WHERE ps.product_id = ?
        ORDER BY ps.preferred DESC, ps.unit_price_cents
      """, py.list(product.get("id"))))
    result

  def rules(): py.List = rows("SELECT * FROM rules ORDER BY id")

  def drafts(): py.List =
    val result = rows("""
      SELECT d.*, s.name AS supplier_name FROM draft_orders d
      JOIN suppliers s ON s.id=d.supplier_id ORDER BY d.id DESC
    """)
    for item in result do
      val d = item.cast[py.Dict]
      d.set("lines", rowsWith("""
        SELECT l.*,p.sku,p.name FROM draft_order_lines l
        JOIN products p ON p.id=l.product_id WHERE l.draft_order_id=? ORDER BY p.sku
      """, py.list(d.get("id"))))
    result

  def analyses(): py.List =
    rows("SELECT * FROM analysis_runs ORDER BY id DESC LIMIT 20")

  def saveProduct(body: py.Dict): Int =
    val sources = body.get("sources", py.list()).cast[py.List]
    if sources.size == 0 then abort "a product needs at least one supplier"
    val conn = connect()
    conn.execute("BEGIN IMMEDIATE")
    // Master row and sourcing rows move together, and a rejected write must not
    // leave the write lock behind for the next request.
    val outcome = py.try: writeProduct(conn, body, sources)
    match outcome
    case Ok(id) =>
      conn.commit()
      conn.close()
      id
    case Err(error) =>
      conn.rollback()
      conn.close()
      abort error.message

  private def writeProduct(conn: py.Dynamic, body: py.Dict, sources: py.List): Int =
    val given = body.get("id", 0).asInt
    val id = if given == 0 then
      val cursor = conn.execute("""
        INSERT INTO products
          (sku,name,category,reserved,incoming,incoming_eta,capacity,enabled)
        VALUES(?,?,?,?,?,?,?,?)
      """, productParams(body))
      val created = cursor.lastrowid.asInt
      // Stock only ever arrives through the ledger, opening balances included.
      val opening = body.get("opening_stock", 0).asInt
      if opening > 0 then
        conn.execute("""
          INSERT INTO stock_movements
            (product_id,kind,quantity,occurred_at,reference,note)
          VALUES(?,'receipt',?,datetime('now'),'OPENING','opening balance')
        """, py.list(created, opening))
      created
    else
      val params = productParams(body)
      params.append(given)
      conn.execute("""
        UPDATE products SET sku=?,name=?,category=?,reserved=?,
          incoming=?,incoming_eta=?,capacity=?,enabled=? WHERE id=?
      """, params)
      given
    replaceSources(conn, id, sources)
    id

  // The submitted set is authoritative: sourcing rows the administrator removed
  // are gone, and exactly one row is left marked preferred.
  private def replaceSources(conn: py.Dynamic, productId: Int, sources: py.List): Unit =
    conn.execute("DELETE FROM product_suppliers WHERE product_id=?", py.list(productId))
    var preferredSeen = false
    for raw in py.iter(sources) do
      val source = raw.cast[py.Dict]
      val caseSize = source.get("case_size", 1).asInt
      val minimum = source.get("minimum_order_quantity", 1).asInt
      if caseSize < 1 then abort "case size must be at least 1"
      if minimum % caseSize != 0 then
        abort "minimum order quantity must be a whole number of cases"
      val wanted = source.get("preferred", false).asBool
      val preferred = if wanted && !preferredSeen then 1 else 0
      if preferred == 1 then preferredSeen = true
      conn.execute("""
        INSERT INTO product_suppliers
          (product_id,supplier_id,unit_price_cents,lead_time_days,
           case_size,minimum_order_quantity,preferred)
        VALUES(?,?,?,?,?,?,?)
      """, py.list(productId,
        source.get("supplier_id", 0).asInt,
        source.get("unit_price_cents", 0).asInt,
        source.get("lead_time_days", 1).asInt,
        caseSize,
        minimum,
        preferred))
    if !preferredSeen then
      conn.execute("""
        UPDATE product_suppliers SET preferred=1
        WHERE rowid = (SELECT rowid FROM product_suppliers
                       WHERE product_id=? ORDER BY unit_price_cents LIMIT 1)
      """, py.list(productId))

  private def productParams(body: py.Dict): py.List = py.list(
    body.get("sku", "").asString.trim,
    body.get("name", "").asString.trim,
    body.get("category", "").asString.trim,
    body.get("reserved", 0).asInt,
    body.get("incoming", 0).asInt,
    body.get("incoming_eta", "").asString.trim,
    body.get("capacity", 1).asInt,
    if body.get("enabled", true).asBool then 1 else 0)

  def saveRule(body: py.Dict): Int =
    val text = body.get("text", "").asString.trim
    if text == "" then abort "a rule needs text"
    val enabled = if body.get("enabled", true).asBool then 1 else 0
    val conn = connect()
    val id = body.get("id", 0).asInt
    if id == 0 then
      val cursor = conn.execute("""
        INSERT INTO rules(text,enabled,created_at,updated_at)
        VALUES(?,?,datetime('now'),datetime('now'))
      """, py.list(text, enabled))
      conn.commit()
      val result = cursor.lastrowid.asInt
      conn.close()
      result
    else
      conn.execute("""
        UPDATE rules SET text=?,enabled=?,updated_at=datetime('now') WHERE id=?
      """, py.list(text, enabled, id))
      conn.commit()
      conn.close()
      id

  def deleteRule(id: Int): Unit =
    val conn = connect()
    conn.execute("DELETE FROM rules WHERE id=?", py.list(id))
    conn.commit()
    conn.close()

  def setDraftStatus(id: Int, status: String): Bool =
    if status != "accepted" && status != "rejected" then return false
    val conn = connect()
    val cursor = conn.execute("""
      UPDATE draft_orders SET status=?,updated_at=datetime('now')
      WHERE id=? AND status='draft'
    """, py.list(status,id))
    conn.commit()
    val changed = cursor.rowcount.asInt == 1
    conn.close()
    changed

  def skillNames(): py.List =
    val result = py.list()
    for name in py.iter(py.module("os").listdir(os.path.join(home,"skills"))) do
      val text = name.asString
      if text.endsWith(".md") then result.append(text.substring(0,text.size - 3))
    py.dynamic(result).sort()
    result

  def readSkill(name: String): String =
    val slug = skillSlug(name)
    File.read(os.path.join(home,"skills",slug+".md"))

  def saveSkill(name: String, content: String): String =
    val slug = skillSlug(name)
    if content.trim == "" then abort "skill content cannot be empty"
    val conn = connect()
    val rev = conn.execute(
      "SELECT COALESCE(MAX(revision),0)+1 FROM skill_revisions WHERE skill_name=?",
      py.list(slug)).fetchone()[0].asInt
    conn.execute("""
      INSERT INTO skill_revisions(skill_name,content,revision,created_at)
      VALUES(?,?,?,datetime('now'))
    """, py.list(slug,content,rev))
    conn.commit()
    conn.close()
    File.write(os.path.join(home,"skills",slug+".md"),content)
    slug

  def skillRevisions(name: String): py.List =
    rowsWith("""
      SELECT revision, created_at, LENGTH(content) AS size
      FROM skill_revisions WHERE skill_name=? ORDER BY revision DESC
    """, py.list(skillSlug(name)))

  def skillRevision(name: String, revision: Int): String =
    val found = rowsWith(
      "SELECT content FROM skill_revisions WHERE skill_name=? AND revision=?",
      py.list(skillSlug(name), revision))
    if found.size == 0 then abort "no such revision"
    found[0].cast[py.Dict].get("content").asString

  def deleteSkill(name: String): Bool =
    val slug = skillSlug(name)
    if slug == "planning" then return false
    val target = os.path.join(home,"skills",slug+".md")
    if !File.exists(target) then return false
    py.module("os").remove(target)
    true

  private def skillSlug(name: String): String =
    val slug = py.dynamic(name.trim).lower().asString
    val valid = py.module("re").fullmatch("[a-z0-9]+(?:-[a-z0-9]+)*",slug)
    if valid.isNone || slug == "api" then abort "invalid or reserved skill name"
    slug

  def beginAnalysis(trigger: String): Int =
    val conn = connect()
    val cursor = conn.execute("""
      INSERT INTO analysis_runs(trigger,status,started_at) VALUES(?,'running',datetime('now'))
    """,py.list(trigger))
    conn.commit()
    val id = cursor.lastrowid.asInt
    conn.close()
    id

  def finishAnalysis(id: Int, status: String, summary: String): Unit =
    val conn = connect()
    conn.execute("""
      UPDATE analysis_runs SET status=?,summary=?,finished_at=datetime('now') WHERE id=?
    """,py.list(status,summary,id))
    conn.commit()
    conn.close()
end
