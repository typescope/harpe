namespace harpe.examples.smartlogistics

import harpe.ffi.os
import harpe.ffi.threading
import harpe.util.File
import harpe.Model
import harpe.Agent
import harpe.Interact
import harpe.Approvals
import harpe.context.FullContext
import harpe.tools.RunCodeTool
import harpe.tools.SkillTools
import harpe.turns.TurnResult
import harpe.turns.TurnEvent
import harpe.logging.*
import harpe.Toolset

//[ The watcher: continuous, unattended, and unable to order anything.
  !
  ! Its capability (sandbox/watch) has no operation that buys, approves, or
  ! changes a check. The only thing it can create is a note for a human.
//]
class Watcher(brain: Model, home: String, databasePath: String, database: Database)
  private val lock = threading.Lock()
  private val runCode = RunCodeTool(os.path.join(home, "sandbox", "watch"), approvalDeadline = 30)

  def run(trigger: String): py.Dict =
    if !lock.acquire(blocking = false).asBool then
      return busy("A check is already running.")
    // The lock is released whatever happens below, so one failed run cannot
    // wedge every run after it.
    val outcome = py.try: checkDepot(trigger)
    lock.release()
    match outcome
    case Ok(value) => value
    case Err(error) => py.dict("ok" ~ false, "busy" ~ false, "report" ~ error.message)

  private def checkDepot(trigger: String): py.Dict =
    val runId = database.beginRun("watch", trigger, "")
    val attempt = py.try: ask(runId)
    match attempt
    case Ok(report) =>
      // Whatever this run did not raise again no longer holds.
      val resolved = database.resolveWarningsNotRaisedBy(runId)
      database.finishRun(runId, "success", report)
      py.dict("ok" ~ true, "busy" ~ false, "run_id" ~ runId,
              "resolved" ~ resolved, "report" ~ report)
    case Err(error) =>
      database.finishRun(runId, "failed", error.message)
      py.dict("ok" ~ false, "busy" ~ false, "run_id" ~ runId,
              "report" ~ error.message)

  private def ask(runId: Int): String =
    val guestEnv = Map(
      "SMART_LOGISTICS_DB" ~ databasePath,
      "SMART_LOGISTICS_RUN" ~ runId.toString)
    Logging.withLogger: audit(home, "watch"), () =>
      turn:
        brain
        File.read(os.path.join(home, "WATCH.md"))
        "Check the depot now and record the warnings that hold."
        SkillTools.toolset(os.path.join(home, "skills", "watch"))
          ++ runCode.toolset(guestEnv)
        8
end

//[ The planner: on demand, started by a person, reviewed by a person.
  !
  ! Its capability (sandbox/plan) can save a draft and nothing else. Approving,
  ! submitting and paying are not operations it has.
//]
class Planner(brain: Model, home: String, databasePath: String, database: Database)
  private val lock = threading.Lock()
  private val runCode = RunCodeTool(os.path.join(home, "sandbox", "plan"), approvalDeadline = 30)

  def run(note: String): py.Dict =
    if !lock.acquire(blocking = false).asBool then
      return busy("A plan is already being prepared.")
    val outcome = py.try: planOrders(note.trim)
    lock.release()
    match outcome
    case Ok(value) => value
    case Err(error) => py.dict("ok" ~ false, "busy" ~ false, "report" ~ error.message)

  private def planOrders(note: String): py.Dict =
    val runId = database.beginRun("plan", "manual", note)
    val attempt = py.try: ask(note)
    match attempt
    case Ok(report) =>
      database.finishRun(runId, "success", report)
      py.dict("ok" ~ true, "busy" ~ false, "run_id" ~ runId, "report" ~ report)
    case Err(error) =>
      database.finishRun(runId, "failed", error.message)
      py.dict("ok" ~ false, "busy" ~ false, "run_id" ~ runId,
              "report" ~ error.message)

  //[ The note is this run's intent — what to focus on. It cannot overrule a
    ! check; changing policy means changing the check, which persists and is
    ! revisioned.
  //]
  private def request(note: String): String =
    if note == "" then "Plan replenishment orders for the depot now."
    else "Plan replenishment orders for the depot now. The administrator added, "
      + "for this run only: \{note}"

  private def ask(note: String): String =
    Logging.withLogger: audit(home, "plan"), () =>
      turn:
        brain
        File.read(os.path.join(home, "PLAN.md"))
        request(note)
        SkillTools.toolset(os.path.join(home, "skills", "plan"))
          ++ runCode.toolset(Map("SMART_LOGISTICS_DB" ~ databasePath))
        12
end

//[ One turn, and its final report. Shared by both agents because the only
  ! things that differ between them are the prompt, the skills, and the
  ! capability their generated code is compiled against.
//]
private def turn(
  brain: Model,
  system: String,
  request: String,
  tools: Toolset,
  maxToolRounds: Int
): String receives logger =
  val context = new FullContext:
    baseSystem = system
    initial = []
  val result = Agent.ask:
    request
    brain = brain
    tools = tools
    context = context
    interact = new QuietInteract
    maxToolRounds = maxToolRounds
    maxRetries = 2
  match result.result
  case TurnResult.Success => result.finalText
  case TurnResult.Interrupted => abort "the run was interrupted"
  case TurnResult.Failed(detail) => abort detail

//[ The sandbox writes its audit records here, so what generated code did is
  ! recoverable after the fact rather than discarded.
//]
private def audit(home: String, kind: String): Logger =
  val dir = os.path.join(home, "logs")
  File.ensureDir(dir)
  new JsonlLogger(os.path.join(dir, "\{kind}.jsonl"))

private def busy(message: String): py.Dict =
  py.dict("ok" ~ false, "busy" ~ true, "report" ~ message)

//[ Neither agent has an approval path: the watcher's output is advisory and the
  ! planner's output is a draft. So there is nothing here to prompt about.
//]
private class QuietInteract
  view Interact
  def cancelled: Bool = false
  def pause(seconds: Float): Bool =
    py.module("time").sleep(py.dynamic(seconds))
    false
  def approve(title: String, detail: String): Approvals.Decision = Approvals.Cancelled
  def emit(event: TurnEvent): Unit = pass
end
