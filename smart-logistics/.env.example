# Set one model provider key. The provider is chosen by which key is present,
# in this order: OpenAI, then OpenRouter, then Anthropic.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OpenRouter also requires MODEL — there is no sensible default model id for it.
# OPENROUTER_API_KEY=
# MODEL=anthropic/claude-sonnet-4.5

HOST=127.0.0.1
PORT=8766

# How often the watcher checks the depot. 0 turns the schedule off; the
# "Check now" button still works.
WATCH_INTERVAL_MINUTES=0

# This app has no authentication. Do not enable this casually.
ALLOW_UNSAFE_REMOTE=false
