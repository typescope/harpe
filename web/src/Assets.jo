//[ Assets.jo
  !
  ! The chat web page: a single self-contained HTML document (markup + styles +
  ! script) served at `/`. It is embedded as a string so it ships with the
  ! compiled agent — there are no static files to locate at runtime.
  !
  ! The script POSTs each message to `/api/message` and reads the streamed NDJSON
  ! response line by line, rendering live status, tool chips, and the final
  ! answer — the browser counterpart of the CLI spinner.
//]

namespace harpe.web

section Assets
  def indexHtml: String =
    """
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title id="doctitle">Harpe</title>
      <style>
        :root {
          --bg: #f6f7f9;
          --panel: #ffffff;
          --ink: #1c2024;
          --muted: #8a9099;
          --line: #e6e8eb;
          --user: #2f6df6;
          --agent: #f1f3f5;
          --accent: #2f6df6;
          --error: #c0392b;
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
          font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
          color: var(--ink); background: var(--bg);
          display: flex; flex-direction: row; height: 100vh;
        }
        #sidebar {
          width: 256px; flex: none; background: var(--panel);
          border-right: 1px solid var(--line);
          display: flex; flex-direction: column; gap: 14px; padding: 16px;
        }
        body.collapsed #sidebar { display: none; }
        .brand { display: flex; align-items: center; }
        .brand .mark {
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-weight: 700; color: var(--accent); letter-spacing: 1px;
        }
        .brand .icon-btn { margin-left: auto; }
        .agent-name { font-weight: 600; font-size: 16px; }
        .panel-section {
          margin-top: 2px; font-size: 12px; text-transform: uppercase;
          letter-spacing: .5px; color: var(--muted);
        }
        .icon-btn {
          width: 32px; height: 32px; display: grid; place-items: center; padding: 0;
          border: none; background: transparent; color: var(--muted);
          border-radius: 8px; cursor: pointer;
        }
        .icon-btn:hover { background: var(--agent); color: var(--ink); }
        .icon-btn svg { width: 18px; height: 18px; display: block; }
        .opener {
          position: fixed; top: 12px; left: 12px; z-index: 5; display: none;
          background: var(--panel); border: 1px solid var(--line);
        }
        body.collapsed .opener { display: grid; }
        .chat { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100vh; }
        main {
          flex: 1; overflow-y: auto; padding: 24px 0;
        }
        #messages { max-width: 760px; margin: 0 auto; padding: 0 20px; }
        .msg { display: flex; margin: 14px 0; }
        .msg.user { justify-content: flex-end; }
        .row { max-width: 80%; }
        .bubble {
          padding: 10px 14px; border-radius: 14px; word-wrap: break-word;
          overflow-wrap: anywhere;
        }
        .msg.user .bubble {
          background: var(--user); color: #fff; border-bottom-right-radius: 4px;
          white-space: pre-wrap;
        }
        .msg.agent .bubble { background: var(--agent); color: var(--ink); border-bottom-left-radius: 4px; }
        .bubble.error { background: #fdecea; color: var(--error); white-space: pre-wrap; }
        /* rendered markdown inside agent bubbles */
        .bubble > :first-child { margin-top: 0; }
        .bubble > :last-child { margin-bottom: 0; }
        .bubble p { margin: 0 0 8px; }
        .bubble h1, .bubble h2, .bubble h3, .bubble h4 { margin: 12px 0 6px; line-height: 1.3; }
        .bubble h1 { font-size: 1.3em; }
        .bubble h2 { font-size: 1.18em; }
        .bubble h3 { font-size: 1.05em; }
        .bubble ul, .bubble ol { margin: 6px 0; padding-left: 22px; }
        .bubble li { margin: 2px 0; }
        .bubble blockquote {
          margin: 8px 0; padding-left: 12px;
          border-left: 3px solid var(--line); color: var(--muted);
        }
        .bubble a { color: var(--accent); }
        .bubble code {
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px;
          background: rgba(20, 30, 50, .07); padding: 1px 5px; border-radius: 5px;
        }
        .bubble pre {
          background: #0d1117; color: #e6edf3; padding: 12px 14px;
          border-radius: 8px; overflow-x: auto; margin: 8px 0;
        }
        .bubble pre code {
          background: none; color: inherit; padding: 0; white-space: pre;
        }
        .bubble table { border-collapse: collapse; margin: 8px 0; font-size: 14px; }
        .bubble th, .bubble td { border: 1px solid var(--line); padding: 5px 10px; text-align: left; }
        .bubble th { background: rgba(20, 30, 50, .04); font-weight: 600; }
        .status {
          font-size: 12px; color: var(--muted); margin: 6px 2px 0;
          display: flex; align-items: center; gap: 6px;
        }
        .status .dot {
          width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
          animation: pulse 1s infinite ease-in-out;
        }
        @keyframes pulse { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }
        .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 2px 0; }
        .chip {
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 12px; color: #3a5; background: #eef7f0;
          border: 1px solid #d4ebda; border-radius: 8px; padding: 2px 8px;
        }
        .empty {
          max-width: 760px; margin: 16vh auto 0; padding: 0 20px;
          text-align: center; color: var(--muted);
        }
        footer { background: var(--bg); padding: 12px 20px 18px; }
        .composer {
          max-width: 760px; margin: 0 auto;
          display: flex; align-items: flex-end; gap: 8px;
          background: var(--panel); border: 1px solid var(--line);
          border-radius: 26px; padding: 7px 7px 7px 18px;
          box-shadow: 0 1px 3px rgba(20, 30, 50, .06);
          transition: border-color .15s, box-shadow .15s;
        }
        .composer:focus-within {
          border-color: var(--accent);
          box-shadow: 0 0 0 3px rgba(47, 109, 246, .14);
        }
        textarea {
          flex: 1; resize: none; border: none; outline: none; background: transparent;
          font: inherit; line-height: 1.5; padding: 8px 0; max-height: 180px;
          color: var(--ink);
        }
        #send {
          flex: none; width: 38px; height: 38px; padding: 0;
          display: grid; place-items: center;
          border: none; border-radius: 50%; background: var(--accent);
          color: #fff; cursor: pointer; transition: background .15s, opacity .15s;
        }
        #send:hover:not(:disabled) { background: #2256d6; }
        #send:disabled { opacity: .35; cursor: default; }
        #send svg { width: 19px; height: 19px; display: block; }
        .hint { max-width: 760px; margin: 8px auto 0; color: var(--muted); font-size: 12px; text-align: center; }
      </style>
      <script src="https://cdn.jsdelivr.net/npm/markdown-it@14/dist/markdown-it.min.js"></script>
    </head>
    <body>
      <aside id="sidebar">
        <div class="brand">
          <span class="mark">HARPE</span>
          <button id="collapse" class="icon-btn" aria-label="Collapse panel" title="Collapse panel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
        </div>
        <div class="agent-name" id="title">Agent</div>
        <div class="panel-section">Sessions</div>
      </aside>
      <button id="opener" class="icon-btn opener" aria-label="Open panel" title="Open panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <div class="chat">
        <main>
          <div id="empty" class="empty">Start the conversation &mdash; ask the agent anything.</div>
          <div id="messages"></div>
        </main>
        <footer>
          <div class="composer">
            <textarea id="input" rows="1" placeholder="Message the agent..."></textarea>
            <button id="send" aria-label="Send">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            </button>
          </div>
          <div class="hint">Enter to send, Shift+Enter for a new line.</div>
        </footer>
      </div>

      <script>
        var msgs = document.getElementById('messages');
        var input = document.getElementById('input');
        var sendBtn = document.getElementById('send');
        var NL = String.fromCharCode(10);
        var busy = false;

        function el(tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text !== undefined) e.textContent = text;
          return e;
        }

        // Markdown via markdown-it (loaded from CDN in <head>). Default options
        // keep html:false, so raw HTML in the model's reply is escaped, not run
        // (XSS-safe without a separate sanitizer). Returns null if the library
        // failed to load (e.g. offline), so the caller can fall back to plain text.
        var md = (typeof markdownit !== 'undefined')
          ? markdownit({ linkify: true, breaks: true })
          : null;

        function renderMarkdown(src) {
          return md ? md.render(src) : null;
        }

        function addMessage(role, text) {
          var empty = document.getElementById('empty');
          if (empty) empty.style.display = 'none';
          var wrap = el('div', 'msg ' + role);
          var row = el('div', 'row');
          var bubble = el('div', 'bubble', text);
          row.appendChild(bubble);
          wrap.appendChild(row);
          msgs.appendChild(wrap);
          scrollDown();
          return row;
        }

        function scrollDown() {
          var main = document.querySelector('main');
          main.scrollTop = main.scrollHeight;
        }

        function loadInfo() {
          fetch('/api/info').then(function (r) { return r.json(); }).then(function (d) {
            document.getElementById('title').textContent = d.name;
            document.getElementById('doctitle').textContent = d.name;
          }).catch(function () {});
        }

        function autoGrow() {
          input.style.height = 'auto';
          input.style.height = Math.min(input.scrollHeight, 160) + 'px';
        }

        function send() {
          if (busy) return;
          var text = input.value.trim();
          if (!text) return;
          input.value = '';
          autoGrow();
          addMessage('user', text);

          busy = true;
          sendBtn.disabled = true;

          var row = addMessage('agent', '');
          var bubble = row.querySelector('.bubble');
          var status = el('div', 'status');
          status.appendChild(el('span', 'dot'));
          var statusText = el('span', null, 'thinking');
          status.appendChild(statusText);
          row.appendChild(status);
          var chips = el('div', 'chips');
          row.appendChild(chips);
          scrollDown();

          fetch('/api/message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: text })
          }).then(function (resp) {
            var reader = resp.body.getReader();
            var decoder = new TextDecoder();
            var buf = '';
            function finish() {
              status.remove();
              busy = false;
              sendBtn.disabled = false;
              input.focus();
              scrollDown();
            }
            function pump() {
              return reader.read().then(function (res) {
                if (res.done) { finish(); return; }
                buf += decoder.decode(res.value, { stream: true });
                var idx;
                while ((idx = buf.indexOf(NL)) >= 0) {
                  var line = buf.slice(0, idx).trim();
                  buf = buf.slice(idx + 1);
                  if (line) handle(JSON.parse(line), bubble, statusText, chips);
                }
                return pump();
              });
            }
            return pump();
          }).catch(function () {
            statusText.textContent = 'connection error';
            busy = false;
            sendBtn.disabled = false;
          });
        }

        function handle(ev, bubble, statusText, chips) {
          if (ev.type === 'status') {
            statusText.textContent = ev.label;
          } else if (ev.type === 'tool') {
            chips.appendChild(el('span', 'chip', ev.summary));
          } else if (ev.type === 'answer') {
            var html = renderMarkdown(ev.text);
            if (html === null) bubble.textContent = ev.text;
            else bubble.innerHTML = html;
          } else if (ev.type === 'error') {
            bubble.classList.add('error');
            bubble.textContent = ev.detail;
          } else if (ev.type === 'interrupted') {
            statusText.textContent = 'stopped';
          } else if (ev.type === 'failed') {
            bubble.classList.add('error');
            bubble.textContent = 'request failed';
          }
          scrollDown();
        }

        sendBtn.addEventListener('click', send);
        input.addEventListener('input', autoGrow);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
        });
        document.getElementById('collapse').addEventListener('click', function () {
          document.body.classList.add('collapsed');
        });
        document.getElementById('opener').addEventListener('click', function () {
          document.body.classList.remove('collapsed');
        });
        loadInfo();
        input.focus();
      </script>
    </body>
    </html>
    """
end
