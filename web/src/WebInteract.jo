//[ WebInteract.jo
  !
  ! The web driver's `Interact` implementation — the seam between the shared turn
  ! engine and the browser. Where the CLI's `Console` drives a terminal
  ! spinner, this one turns every `TurnEvent` into a small JSON object and hands
  ! it to a `sink`, which the server writes as one line of the streamed HTTP
  ! response. The browser reads those lines as they arrive, so the page shows live
  ! progress (the web equivalent of the spinner).
  !
  ! Cancellation is the session's `stop` event, set by `POST /api/stop`: the
  ! engine polls `cancelled` between model calls and tool executions, and
  ! `pause` waits on the event so a backoff is abandoned promptly. The model
  ! call itself is not interrupted mid-flight — a stop takes effect when the
  ! current call returns.
//]

namespace harpe.web

import harpe.Interact
import harpe.Approvals
import harpe.turns.TurnEvent
import harpe.turns.ModelRequestStarted
import harpe.turns.ModelRequestEnded
import harpe.turns.TransientError
import harpe.turns.AssistantMessage
import harpe.turns.ToolBudgetReached
import harpe.turns.ToolCallStarted
import harpe.turns.ToolCallEnded
import harpe.turns.ContextCompacted
import harpe.Model
import harpe.Model.Rendered
import harpe.Model.ReplyResult
import harpe.Tool


//[ A sink for one turn's progress
  !
  ! Each call emits one JSON object, which the server serializes and writes as a
  ! line of the NDJSON response stream.
//]
type Sink = py.Dict => Unit
type ApprovalHandler = (String, Approvals.Request) => Approvals.Decision

private class WebInteract(sink: Sink, stop: py.Dynamic, approvalHandler: ApprovalHandler)
  view Interact

  def cancelled: Bool = stop.is_set().asBool

  def pause(seconds: Float): Bool = stop.wait(seconds).asBool

  def approve(id: String, request: Approvals.Request): Approvals.Decision =
    approvalHandler(id, request)

  //[ Translate one engine event into a UI event on the stream
    !
    ! `ModelRequestEnded` carries no UI meaning on its own — the next
    ! `status`/`answer` supersedes it.
  //]
  def emit(event: TurnEvent): Unit =
    match event
    case ModelRequestStarted(attempt, maxAttempts) =>
      val label = if attempt == 0 then "thinking" else "retrying \{attempt}/\{maxAttempts}"
      sink(py.dict("type" ~ "status", "label" ~ label))

    case ModelRequestEnded =>
      pass

    case TransientError(detail, delaySeconds) =>
      sink(py.dict("type" ~ "status", "label" ~ "transient error; retrying in \{delaySeconds}s"))

    case AssistantMessage(text) =>
      sink(py.dict("type" ~ "assistant-message", "text" ~ text))

    case ToolBudgetReached(budget) =>
      sink(py.dict("type" ~ "status", "label" ~ "tool budget reached (\{budget})"))

    case ToolCallStarted(name) =>
      sink(py.dict("type" ~ "status", "label" ~ name))

    case ToolCallEnded(name, summary) =>
      sink(py.dict("type" ~ "tool", "name" ~ name, "summary" ~ summary))

    case ContextCompacted(droppedMessages) =>
      sink(py.dict("type" ~ "status", "label" ~ "context compacted (\{droppedMessages} messages summarized)"))
  end
end
