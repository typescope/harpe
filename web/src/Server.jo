//[ Server.jo
  !
  ! The chat server: a WSGI application that routes browser requests and drives
  ! the shared turn engine. One `ChatServer` is built per process and holds a
  ! registry of sessions (keyed by id). It serves:
  !
  !   GET  /                the chat page (new chat)
  !   GET  /c/<id>          the chat page for an existing session (the JS loads it)
  !   GET  /api/info        the agent's name
  !   GET  /api/sessions    the persisted sessions, newest first (for the picker)
  !   DELETE /api/session   remove one idle session and its files
  !   GET  /api/history     one session's messages (to render on load)
  !   POST /api/message     run one turn, STREAMING progress then the answer (NDJSON)
  !   POST /api/stop        request cancellation of a session's running turn
  !
  ! Sessions are the conversation's unit: a `POST /api/message` with no `session`
  ! mints a new id (emitted as the first stream event), and the browser puts it in
  ! the URL (`/c/<id>`). A turn runs under that session's lock, and its history is
  ! persisted as structured session logs, so a session resumes by id across restarts,
  ! by loading from disk.
  !
//]

namespace harpe.web
import harpe.ffi.secrets
import harpe.ffi.time
import harpe.ffi.json
import harpe.ffi.os
import harpe.ffi.threading
import harpe.ffi.file
import harpe.ffi.mimetypes
import harpe.ffi.builtins

import harpe.Agent
import harpe.Interact
import harpe.interact
import harpe.Defaults
import harpe.Memory
import harpe.Workspace
import harpe.workspace
import harpe.logging.logger
import harpe.Model
import harpe.Model.Assistant
import harpe.Model.Message
import harpe.Model.UserInput
import harpe.Model.Attachment
import harpe.Model.ToolResults
import harpe.tools.*
import harpe.context.WindowedContext
import harpe.Tool
import harpe.Handler
import harpe.Routes
import harpe.Tool.ToolInput
import harpe.turns.Failed

//[ The `sendFile` tool — the agent's channel for delivering a file to the user.
  !
  ! A file the agent produced already lives in the session's data directory (it
  ! wrote it with `fs`) and is already served by `/api/file`. This tool moves no
  ! bytes: it validates the name and records the *intent* to show it. The tool CALL
  ! is the record — it sits in the model's own transcript (so the agent knows what
  ! it sent), and `handleHistory` recognizes the call and renders the file as an
  ! attachment on the reply. One event, two renderings: no fork between what the
  ! model reasons over and what the user sees. A clean error comes back if the name
  ! does not resolve, so the model can correct it (write the file first, or fix a
  ! typo) rather than silently failing.
//]
section SendFileTool
  //[ This tool's route, delivering files from `dataDir`. //]
  def routes(dataDir: String): Routes =
    Routes.of: spec.name, (i: ToolInput) => send(i["fileName"], dataDir)

  //[ The spec, for the agent's tool list. //]
  def spec: Tool =
    Tool:
      "sendFile"
      "Deliver a file to the user — it appears as an attachment in your reply. Write the file to the data directory first (e.g. with `fs`)."
      [Tool.strParam("fileName", "The name of the file in your data directory to send to the user")]

  //[ Record the intent to deliver `fileName` from the session directory `dir`. //]
  def send(fileName: String, dir: String): Tool.RunOutcome =
    val baseName = os.path.basename(fileName.replace("\\", "/"))

    if dir == "" then
      new Tool.RunOutcome:
        "No data directory is available to send from."
        "sendFile · no data dir"
        attachments = []

    else if baseName == "" || baseName == "." || baseName == ".." || !os.path.isfile(os.path.join(dir, baseName)) then
      new Tool.RunOutcome:
        "No such file: '\{fileName}'. Write it to your data directory first, then send it."
        "sendFile · no such file"
        attachments = []

    else
      new Tool.RunOutcome:
        "Sent '\{baseName}' to the user."
        "sendFile · \{baseName}"
        attachments = []

class ChatServer(brain: Model, name: String, wspace: Workspace)
  // Resident sessions, id -> Session. Persisted sessions not yet touched this
  // run are loaded from disk on first access. The server is threaded (each
  // request on its own thread), so registry access is guarded by registryLock.
  // Turns within one session are serialized by the session's own lock.
  private val registry = py.dict()
  private val registryLock = threading.lock()

  // The `runCode` tool the interactive editor (`/api/run`) executes against — the
  // same compile+sandbox machinery the agent uses, so an edited script runs exactly
  // as the agent's would, with the session's data dir as its `fs` root.
  // `runTool` holds the build semaphore, so one instance bounds concurrent
  // sandbox runs across the whole server. The other tools own nothing.
  private val runTool: RunCodeTool = runCodeTool(wspace.sandboxDir, 610.0)

  //[ Every spec the model is offered — identical for every session. //]
  private def specs: List[Tool] =
    [runTool,
     UploadMediaTool.spec,
     SendFileTool.spec,
     ..SkillTools.specs,
     ..MemoryTools.specs]

  //[ The WSGI application: establish the request context, then route
    !
    ! Each request runs on its own thread, which does not inherit the process's
    ! context, so `workspace` is re-provided here from the server's field.
  //]
  def handle(environ: py.Dynamic, startResp: py.Dynamic): py.List =
    with workspace = wspace in route(environ, startResp)

  private def route(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val method = environ.get("REQUEST_METHOD", "GET").asString
    val path = environ.get("PATH_INFO", "/").asString

    if method == "GET" && (path == "/" || path.startsWith("/c/")) then
      respond(startResp, "200 OK", "text/html; charset=utf-8", file.read(indexPath()))

    else if method == "GET" && (path == "/app.css" || path == "/app.js") then
      handleStatic(path, startResp)

    else if path == "/api/info" then
      respondJson(startResp, py.dict("name" ~ name))

    else if path == "/api/sessions" then
      handleSessions(startResp)

    else if path == "/api/session" && method == "DELETE" then
      handleDeleteSession(environ, startResp)

    else if path == "/api/history" then
      handleHistory(environ, startResp)

    else if path == "/api/message" && method == "POST" then
      handleMessage(environ, startResp)

    else if path == "/api/subscribe" then
      handleSubscribe(environ, startResp)

    else if path == "/api/upload" && method == "POST" then
      handleUpload(environ, startResp)

    else if path == "/api/files" then
      handleFiles(environ, startResp)

    else if path == "/api/file" then
      handleFile(environ, startResp)

    else if path == "/api/run" && method == "POST" then
      handleRun(environ, startResp)

    else if path == "/api/save" && method == "POST" then
      handleSave(environ, startResp)

    else if path == "/api/stop" && method == "POST" then
      handleStop(environ, startResp)

    else if path == "/api/approval" && method == "POST" then
      handleApproval(environ, startResp)

    else
      respond(startResp, "404 Not Found", "text/plain", "not found")

  //[ The chat page is the agent's own `assets/index.html` (its presence is checked at startup, see `Web.serve`)
    !
    ! Read from disk on every request, so editing the page needs no rebuild or
    ! restart.
  //]
  private def indexPath(): String receives workspace =
    workspace.relative("assets/index.html")

  //[ Serve the page's split stylesheet/script (`/app.css`, `/app.js`)
    !
    ! From the agent's `assets/` directory — read from disk per request, like
    ! the page, so editing them needs no rebuild. The name is reduced to a
    ! basename, so the path can never escape `assets/`. A missing file is a 404.
  //]
  private def handleStatic(path: String, startResp: py.Dynamic): py.List receives workspace =
    val name = sanitizeName(path)   // basename → strips the leading "/" and any traversal
    val p = workspace.relative("assets/" + name)

    if name == "" || !os.path.isfile(p) then
      respond(startResp, "404 Not Found", "text/plain", "not found")

    else
      val ctype = if name.endsWith(".css") then "text/css"
                  else if name.endsWith(".js") then "application/javascript"
                  else "text/plain"
      respond(startResp, "200 OK", ctype + "; charset=utf-8", file.read(p))

  //[ Run one turn, streaming its progress and final answer as NDJSON.
    !
    ! A request with no `session` starts a new one and emits its id first, so
    ! the browser can adopt the `/c/<id>` URL. A request that carries a
    ! `session` resumes it (from memory, or loaded from disk).
  //]
  private def handleMessage(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val text = body.get("text", "").asString
    val reqId = body.get("session", "").asString
    val attachmentItems = body.get("attachments", py.list()).cast[py.List]

    val headers = py.list(
      py.tuple("Content-Type", "application/x-ndjson"),
      py.tuple("Cache-Control", "no-cache"))
    val write = py.call(startResp, "200 OK", headers)

    val sink: Sink = (obj: py.Dict) =>
      py.call(write, py.dynamic(json.dumps(obj) + "\n").encode())

    // A turn needs either text or at least one attachment (an attachments-only
    // message — "here, look at this file" — is valid).
    if text.trim == "" && attachmentItems.size == 0 then
      sink(py.dict("type" ~ "error", "detail" ~ "empty message"))

    else
      evictIdle()
      val minted = reqId == ""
      val session = if minted then createSession() else openSession(reqId)

      if minted then sink(py.dict("type" ~ "session", "id" ~ session.id))

      // This request's sink is attached inside `runTurn` (once the turn owns
      // the session lock), and the turn fans its events out to it and to any
      // tab that subscribes mid-turn. Tag every log entry with the session it
      // belongs to. The
      // The files live in the session's own data directory, so their paths are
      // only knowable once the session is resolved.
      val input = UserInput(text, parseAttachments(attachmentItems, Session.dataDir(session.id)))
      session.runTurn(input, sink, maxToolRounds = 50, maxRetries = 4)

    py.list()

  //[ Request cancellation of a session's running turn
    !
    ! Set its stop event. The engine notices between model calls and tool
    ! executions and rolls the turn back. Unknown or idle sessions are a no-op —
    ! stopping is idempotent.
  //]
  private def handleStop(environ: py.Dynamic, startResp: py.Dynamic): py.List =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val id = body.get("session", "").asString

    registryLock.acquire()
    if registry.contains(id) then registry.get(id).cast[Session].requestStop()
    registryLock.release()

    respondJson(startResp, py.dict("ok" ~ true))

  //[ Resolve an instant approval for the session's active turn. //]
  private def handleApproval(environ: py.Dynamic, startResp: py.Dynamic): py.List =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val sessionId = sanitizeName(body.get("session", "").asString)
    val approvalId = body.get("id", "").asString
    val decision = body.get("decision", "").asString

    val accepted =
      match residentSession(sessionId)
      case Some(session) => session.decideApproval(approvalId, decision)
      case None          => false

    respondJson(startResp, py.dict("ok" ~ accepted))

  //[ Subscribe to a session's in-flight turn
    !
    ! Attach a sink and stream the turn's events until it finishes, then close.
    ! This is how a tab reconnects to a running turn after a page refresh (and
    ! how a second tab loaded mid-turn follows along): the client, seeing
    ! `state.active` on load, opens this and renders the events.
    !
    ! Only a *resident, active* session has a live turn to follow — an unknown,
    ! idle, or already-finished one gets an immediate empty stream, so the
    ! client falls back to the committed history for the final answer.
  //]
  private def handleSubscribe(environ: py.Dynamic, startResp: py.Dynamic): py.List =
    match residentSession(queryParam(environ, "session"))
    case Some(session) if session.state is Active(_) =>
      val headers = py.list(
        py.tuple("Content-Type", "application/x-ndjson"),
        py.tuple("Cache-Control", "no-cache"))
      val write = py.call(startResp, "200 OK", headers)

      val sink: Sink = (obj: py.Dict) =>
        py.call(write, py.dynamic(json.dumps(obj) + "\n").encode())

      val subId = session.addSink(sink)
      // Block for exactly the turn's remaining duration. `runTurn` sets `idle`
      // when it ends, releasing this subscriber.
      val _ = session.idle.wait()
      session.removeSink(subId)
      py.list()

    case _ =>
      respond(startResp, "200 OK", "application/x-ndjson", "")

  //[ The resident session for `id` (registry only — never loads from disk), or None
    !
    ! Used to read live turn state without materializing an idle session.
  //]
  private def residentSession(id: String): Option[Session] =
    registryLock.acquire()
    val found: Option[Session] = if registry.contains(id) then Some(registry.get(id).cast[Session]) else None
    registryLock.release()
    found

  //[ A session's live turn state — `Idle` if it is not resident (nothing running). //]
  private def residentState(id: String): SessionState =
    match residentSession(id)
    case Some(session) => session.state
    case None          => Idle

  //[ What runs for each tool name, for one session
    !
    ! Every session gets its own data directory — a multi-session server must
    ! not hand one shared directory to every session, so `fs` (and the document
    ! readers) are rooted per session. Uploads land there, agent output surfaces
    ! there, and these routes are where that directory reaches the tools.
  //]
  private def routes(memory: Memory, id: String): Routes =
    val dataDir = os.path.abspath(Session.dataDir(id))
    MemoryTools.routes(memory)
      ++ SkillTools.routes(wspace.skillsDir)
      ++ UploadMediaTool.routes(dataDir)
      ++ SendFileTool.routes(dataDir)
      ++ runTool.routes()

  //[ A fresh session under a newly-minted, time-sortable id. //]
  private def createSession(): Session receives workspace =
    val id = time.strftime("%Y%m%dT%H%M%S") + "-" + secrets.tokenHex(nbytes = 2)
    val memory = new Memory
    val context = new WindowedContext:
      baseSystem = workspace.read("AGENT.md").getOrElse("")
      memory = memory
      initial = []

    val session = new Session:
      id
      Session.forSession(id)
      brain
      specs
      context
      memory
      Session.memoryPath(id)
      routes(memory, id)

    registryLock.acquire()
    registry.set(id, session)
    registryLock.release()

    session

  //[ The session for `id`
    !
    ! Resident if seen this run, otherwise loaded from disk (an unknown id loads
    ! as an empty conversation keyed to that id). Two concurrent first touches
    ! of the same id both load. The second registration wins — harmless, since
    ! the loser is dropped before running a turn.
  //]
  private def openSession(id: String): Session receives workspace =
    registryLock.acquire()
    val resident: Option[Session] = if registry.contains(id) then Some(registry.get(id).cast[Session]) else None
    registryLock.release()

    match resident
    case Some(session) => session

    case None =>
      val log = Session.forSession(id)
      val memory = Memory.load(Session.memoryPath(id))
      // `Session.load` caps the replayed transcript (a RAM backstop). The full
      // transcript stays on disk.
      val context = new WindowedContext:
        baseSystem = workspace.read("AGENT.md").getOrElse("")
        memory = memory
        initial = Session.load(id)

      val session = new Session(id, log, brain, specs, context, memory, Session.memoryPath(id), routes(memory, id))

      registryLock.acquire()
      val winner =
        if registry.contains(id) then registry.get(id).cast[Session]
        else
          registry.set(id, session)
          session
      registryLock.release()

      winner

  //[ Drop sessions idle longer than 30 minutes from the resident registry. They reload from disk on next access
    !
    ! Bounds memory on a long-running server. A session evicted while its turn
    ! still runs is harmless: the running turn holds its own reference and
    ! commits to disk.
  //]
  private def evictIdle(): Unit =
    val cutoff = time.now() - 1800.0

    registryLock.acquire()
    val stale = py.list()

    for k in py.iter(registry.keys()) do
      if registry.get(k).cast[Session].lastActive < cutoff then stale.append(k)

    for k in py.iter(stale) do
      val _ = registry.pop(k)

    registryLock.release()

  private def handleSessions(startResp: py.Dynamic): py.List receives workspace =
    val arr = py.list()
    for m in Session.listSessions() do
      arr.append(py.dict("id" ~ m.id, "title" ~ m.title, "time" ~ m.time))
    respondJson(startResp, py.dict("sessions" ~ arr))

  //[ Permanently remove one idle session and all of its stored files. //]
  private def handleDeleteSession(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val requested = body.get("session", "").asString
    val id = sanitizeName(requested)

    if id == "" || id != requested then
      respondJsonStatus(startResp, "400 Bad Request", py.dict("ok" ~ false, "error" ~ "invalid session"))

    else
      registryLock.acquire()
      val resident: Option[Session] =
        if registry.contains(id) then Some(registry.get(id).cast[Session]) else None

      val active =
        match resident
        case Some(session) => session.state is Active(_)
        case None          => false

      if !active && registry.contains(id) then
        val _ = registry.pop(id)
      registryLock.release()

      if active then
        respondJsonStatus(
          startResp,
          "409 Conflict",
          py.dict("ok" ~ false, "error" ~ "stop the running turn before deleting this session"))
      else
        match resident
        case Some(session) => session.close()
        case None          => pass
        Session.removeStored(id)
        respondJson(startResp, py.dict("ok" ~ true))

  //[ One session's user/agent messages, for rendering on load.
    !
    ! Each user message and each turn's FINAL reply are shown as bubbles. The turn's
    ! intermediate traffic is not hidden but folded into that reply: the `runCode`
    ! programs the agent ran (as `steps`, code paired with output by call id) and the
    ! files it delivered via `sendFile` (as `sent`, resolved against the session
    ! dir). Both come from the transcript — the tool calls the model itself made — so
    ! they persist across reloads and never fork from what the model reasons over.
    !
    ! `received` and `sent` name file lists from the AGENT's side: `received` is what
    ! the user uploaded with a message, `sent` is what the agent delivered back. They
    ! render differently (an image the agent sent previews inline, a delivered file
    ! that has since vanished still shows as a muted card), so they stay separate
    ! fields rather than one merged list.
  //]
  private def handleHistory(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val id = queryParam(environ, "session")
    val dataDir = existingDataDir(id)

    val arr = py.list()
    for turn in Session.loadTurns(id) do
      for row in py.iter(TurnView.rows(turn, dataDir)) do arr.append(row)

    // The live turn state alongside persisted history lets a reconnect subscribe
    // to a turn that is still running.
    respondJson: startResp, py.dict("messages" ~ arr, "state" ~ stateToJson(residentState(id)))

  //[ The live turn state as JSON
    !
    ! `{active: false}` when idle, or `{active: true, text, attachments}`
    ! carrying the in-flight turn's pending user input.
  //]
  private def stateToJson(state: SessionState): py.Dict =
    match state
    case Idle          => py.dict("active" ~ false)
    case Active(input) => py.dict("active" ~ true, "text" ~ input.text, "received" ~ attachmentsToJson(input.attachments))

  private def queryParam(environ: py.Dynamic, key: String): String =
    val qs = environ.get("QUERY_STRING", "").asString
    val params = py.module("urllib.parse").parse_qs(qs).cast[py.Dict]
    if params.contains(key) then params.get(key).cast[py.List].get(0).asString else ""

  //[ Read and decode a request body using its CONTENT_LENGTH. //]
  private def readBody(environ: py.Dynamic): String =
    val raw = environ.get("CONTENT_LENGTH", "").asString
    val length = Int.parse(raw) rescue None => 0
    environ.get("wsgi.input").read(length).decode().asString

  private def respondJson(startResp: py.Dynamic, dict: py.Dict): py.List =
    respond(startResp, "200 OK", "application/json", json.dumps(dict))

  private def respondJsonStatus(startResp: py.Dynamic, status: String, dict: py.Dict): py.List =
    respond(startResp, status, "application/json", json.dumps(dict))

  //[ A complete, non-streamed response from a string body. //]
  private def respond(startResp: py.Dynamic, status: String, ctype: String, body: String): py.List =
    val _ = py.call(startResp, status, py.list(py.tuple("Content-Type", ctype)))
    py.list(py.dynamic(body).encode())

  //[ A complete binary response: the bytes plus a `Content-Disposition` naming the file
    !
    ! `inline` lets a browser preview images/PDFs. A download still works.
  //]
  private def respondBytes(startResp: py.Dynamic, ctype: String, filename: String, data: py.Dynamic): py.List =
    val headers = py.list(
      py.tuple("Content-Type", ctype),
      py.tuple("Content-Disposition", "inline; filename=\"\{filename}\""))
    val _ = py.call(startResp, "200 OK", headers)
    py.list(data)

  //[ ── Files ──────────────────────────────────────────────────────────────────
    !
    ! Inbound files live in the session's own data directory (`Session.dataDir`),
    ! which the sandbox grants as `HARPE_DATA_DIR`. Filenames on these endpoints are
    ! client-controlled, so every path is built from a sanitized bare basename and
    ! checked to stay within the session dir — the traversal guard that keeps one
    ! session from touching another's files, or the host's.
  //]

  //[ The largest single upload accepted (bytes)
    !
    ! A guard against a runaway body, not a tuned limit.
  //]
  private def maxUploadBytes: Int = 26214400   // 25 MiB

  //[ Reduce a client-supplied name to a safe bare basename
    !
    ! Drop any directory part (both separators) and reject the traversal names,
    ! so a stored or served file can never escape the session's data directory.
    ! "" if nothing safe remains.
  //]
  private def sanitizeName(raw: String): String =
    val base = os.path.basename(raw.replace("\\", "/"))
    if base == "" || base == "." || base == ".." then "" else base

  //[ Is `p` contained within `dir`?
    !
    ! Compared on realpaths, so a symlink inside the session dir cannot smuggle
    ! a read outside it either.
  //]
  private def within(dir: String, p: String): Bool =
    val realDir = os.path.realpath(dir)
    val realP = os.path.realpath(p)
    realP == realDir || realP.startsWith(realDir + "/")

  //[ The existing data directory for a client-supplied session id, or None
    !
    ! The id is reduced to a basename first (so it cannot point outside
    ! `data/`), and the directory must already exist — listing and serving never
    ! create one.
  //]
  private def existingDataDir(id: String): Option[String] receives workspace =
    val safe = sanitizeName(id)
    if safe == "" then None
    else
      val dir = workspace.relative("data/" + safe)
      if os.path.isdir(dir) then Some(dir) else None

  //[ A name not already taken in `dir`
    !
    ! `report.pdf` → `report-1.pdf` → … so an upload never clobbers an existing
    ! file.
  //]
  private def uniqueName(dir: String, name: String): String =
    if !os.path.exists(os.path.join(dir, name)) then name
    else
      val stem = os.path.basename(name.replace("\\", "/"))
      val ext = os.extname(stem)
      val root = if ext == "" then stem else stem.substring(0, stem.size - ext.size)
      var i = 1
      var candidate = root + "-" + i.toString + ext
      while os.path.exists(os.path.join(dir, candidate)) do
        i = i + 1
        candidate = root + "-" + i.toString + ext
      candidate

  //[ Build the turn's attachments from the message body's `attachments` array
    !
    ! Metadata for files already stored by `/api/upload`. Names are re-sanitized
    ! to a basename defensively (the transcript and the model manifest must
    ! never carry a path). The bytes are already on disk in the session dir.
  //]
  private def parseAttachments(items: py.List, dataDir: String): List[Attachment] =
    var atts: List[Attachment] = []
    for aDyn in items do
      val a = aDyn.cast[py.Dict]
      val name = sanitizeName(a.get("name", "").asString)
      if name != "" then
        val att = Attachment:
          name
          a.get("size", 0).asInt
          a.get("mime", "").asString
          inline = a.get("inline", false).asBool
          path = os.path.join(os.path.abspath(dataDir), name)
        atts = atts + att

    atts

  //[ Attachments as a JSON array for the browser (history rows). //]
  private def attachmentsToJson(atts: List[Attachment]): py.List = TurnView.receivedJson(atts)

  //[ Session files as a JSON array for the file list and drawer. //]
  private def filesToJson(files: List[SessionFile]): py.List =
    val arr = py.list()
    for f in files do
      arr.append: py.dict("name" ~ f.name, "size" ~ f.size, "mime" ~ f.mime, "modified" ~ f.modified)
    arr

  //[ Store one uploaded file into a session's data directory
    !
    ! (base64 in a JSON body) into a session's data directory, minting the
    ! session if the request carries none — so the message that follows resumes
    ! the same id and sees the file. Returns the session id and the stored
    ! file's metadata. The name is sanitized and de-duplicated, so an upload can
    ! neither escape the session dir nor clobber an existing file.
  //]
  private def handleUpload(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val reqId = body.get("session", "").asString
    val name = sanitizeName(body.get("name", "").asString)

    if name == "" then
      respondJson: startResp, py.dict("error" ~ "invalid filename")

    else
      val session = if reqId == "" then createSession() else openSession(reqId)
      val dir = Session.dataDir(session.id)
      val data = py.module("base64").b64decode(body.get("data", "").asString)
      val size = builtins.len(data)

      if size > maxUploadBytes then
        respondJson: startResp, py.dict("error" ~ "file too large", "session" ~ session.id)

      else
        val stored = uniqueName(dir, name)
        file.writeBytes(os.path.join(dir, stored), data)
        val given = body.get("mime", "").asString
        val mime = if given != "" then given
                   else mimetypes.guessType(stored).getOrElse("application/octet-stream")
        respondJson: startResp, py.dict("session" ~ session.id, "name" ~ stored, "size" ~ size, "mime" ~ mime)

  //[ List a session's data directory
    !
    ! The files currently in its workspace, whether uploaded by the user or
    ! written by the agent. Newest first.
  //]
  private def handleFiles(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val files = match existingDataDir(queryParam(environ, "session"))
                case None      => []
                case Some(dir) => Session.listFiles(dir)

    respondJson: startResp, py.dict("files" ~ filesToJson(files))

  //[ Serve one file from a session's data directory for preview or download
    !
    ! The session id and name are both sanitized, and the resolved path is
    ! verified to stay within the session dir — an unknown session, missing
    ! file, or any traversal attempt is a 404.
  //]
  private def handleFile(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val name = sanitizeName(queryParam(environ, "name"))

    match existingDataDir(queryParam(environ, "session"))
    case None => respond(startResp, "404 Not Found", "text/plain", "not found")
    case Some(dir) =>
      val p = os.path.join(dir, name)
      if name == "" || !os.path.isfile(p) || !within(dir, p) then
        respond(startResp, "404 Not Found", "text/plain", "not found")

      else
        val mime = mimetypes.guessType(name).getOrElse("application/octet-stream")
        respondBytes(startResp, mime, name, file.readBytes(p))

  //[ Run a Jo program in a session's sandbox — the interactive editor's execute.
    !
    ! Compiles and runs `code` through the same `runCode` machinery the agent uses,
    ! with the session's data dir as `HARPE_DATA_DIR`, so an edited script sees the
    ! session's files exactly as the agent's programs do. A request with no session
    ! mints one (so a script written in a fresh chat gets a home), and the client
    ! adopts the returned id.
  //]
  private def handleRun(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val code = body.get("code", "").asString
    val reqId = body.get("session", "").asString
    val requestedId = sanitizeName(reqId)

    if code.trim == "" || (reqId != "" && requestedId == "") then
      respondJson: startResp, py.dict("error" ~ "empty program or session")

    else
      val session = if reqId == "" then createSession() else openSession(requestedId)
      val sessionId = session.id
      val outcome =
        with logger = session.log, interact = Interact.unattended
        in runTool.run(code)
      respondJson: startResp, py.dict("session" ~ sessionId, "result" ~ outcome.result, "summary" ~ outcome.summary)

  //[ Save a script into a session's files (overwriting a same-named one), so it can be reopened, edited, and re-run
    !
    ! Mints a session if the request carries none.
  //]
  private def handleSave(environ: py.Dynamic, startResp: py.Dynamic): py.List receives workspace =
    val body = json.loads(readBody(environ)).cast[py.Dict]
    val reqId = body.get("session", "").asString
    val name = sanitizeName(body.get("name", "").asString)
    val content = body.get("content", "").asString
    val sessionId = if reqId == "" then createSession().id else sanitizeName(reqId)

    if name == "" || sessionId == "" then
      respondJson: startResp, py.dict("error" ~ "missing name or session")

    else
      file.write(os.path.join(Session.dataDir(sessionId), name), content)
      respondJson: startResp, py.dict("session" ~ sessionId, "name" ~ name)
end
