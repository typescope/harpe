//[ Web.jo
  !
  ! The web agent loop (the Harpe "conversational" trigger, served in a browser)
  ! and its entry point. `jo run` with `jo.main = harpe.web.main` starts a local
  ! HTTP server; the chat page talks to it over HTTP. Each user message is one
  ! turn of the shared engine, driven by `WebInteract` so the browser sees
  ! progress live.
  !
  ! The server is threaded (one request per thread), so the page and
  ! `/api/stop` stay responsive while a turn runs; a session's turns are
  ! serialized by its lock, and a running turn is cancellable via the session's
  ! stop event.
//]

namespace harpe.web
import harpe.ffi.sys
import harpe.ffi.signal
import harpe.ffi.builtins
import harpe.ffi.dotenv
import harpe.ffi.file

import jo.IO.stdout
import harpe.Workspace
import harpe.Defaults
import harpe.workspace
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.logger
import harpe.ffi.os

//[ The entry point //]
def main(): Unit receives stdout =
  if Defaults.checkAgentDir() then
    dotenv.load(".env")
    val wspace = new Workspace(os.path.abspath("."))
    with workspace = wspace in
      Logging.withLogger(new JsonlLogger(wspace.relative("logs/agent.jsonl")), () => serve())

private def serve(): Unit receives stdout, workspace, logger =
  // The chat page is the agent's own file, served from disk (see Server.route),
  // so the agent owns and customizes it. Fail fast with a pointer if it is missing.
  if !file.exists(workspace.relative("assets/index.html")) then
    println "Error: assets/index.html not found — the web driver serves the chat page from the agent's assets/ directory."
    println "  It ships with the web agent; restore it from the harpe repo (web/assets/index.html)."
    sys.exit(1)

  val brain = Defaults.model()

  val server = new ChatServer(brain, "Hello Agent", workspace, logger)

  val host = os.getenv("HOST", "127.0.0.1")
  val port = Int.parse(os.getenv("PORT", "8765")) rescue None => 8765

  // The WSGI app is a thin adapter onto the server; the runtime calls it with
  // (environ, start_response) per request.
  val app = (environ: py.Dynamic, startResp: py.Dynamic) =>
    server.handle(environ, startResp)

  // A THREADED WSGI server: each request runs on its own thread, so the page
  // and `/api/stop` stay responsive while a long turn runs. Turns within one
  // session are still serialized by the session lock, and the shared model
  // client is thread-safe. daemon_threads lets Ctrl-C exit without joining
  // in-flight workers.
  val wsgi = py.module("wsgiref.simple_server")
  val ThreadingMixIn = py.module("socketserver").ThreadingMixIn
  val threadedServer = builtins.newType:
    "ThreadingWSGIServer"
    py.tuple(ThreadingMixIn, wsgi.WSGIServer)
    py.dict("daemon_threads" ~ true)

  val httpd = wsgi.make_server(host, port, app, server_class = threadedServer)

  println "Harpe ▸ Hello Agent is live at http://\{host}:\{port}  (Ctrl-C to stop)"

  // Stop cleanly on Ctrl-C instead of dumping a traceback from serve_forever.
  signal.shutdownOnSigint("\nHarpe ▸ shutting down.")

  httpd.serve_forever()
