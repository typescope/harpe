//[ Session.jo
  !
  ! The web driver's live conversation object (`Session`) and its storage layout
  ! (the `Session` section): conversations live as `logs/sessions/<id>.jsonl` under
  ! the workspace, one file per session, keyed by the id that also appears in its
  ! `/c/<id>` URL.
  !
  ! This layout is a *driver* decision. The section maps an id to its structured
  ! per-session log (`forSession`, while `load` and `loadRecords` derive its views)
  ! and scans the directory to list past sessions for the picker. Ids are
  ! time-sortable, so newest-first is just a reverse id sort.
//]

namespace harpe.web
import harpe.ffi.os
import harpe.ffi.time
import harpe.ffi.json
import harpe.ffi.threading
import harpe.ffi.file
import harpe.ffi.mimetypes

import harpe.Agent
import harpe.ApprovalRequest
import harpe.ApprovalDecision
import harpe.ApprovalTimedOut
import harpe.ApprovalCancelled
import harpe.Memory
import harpe.Toolset
import harpe.Tool
import harpe.Tool.ToolInput
import harpe.Context
import harpe.interact
import harpe.Transcript
import harpe.transcript.Journal
import harpe.TurnData
import harpe.TurnRecord
import harpe.workspace
import harpe.logging.JsonlLogger
import harpe.logging.Logger
import harpe.logging.logger
import harpe.logging.Entry
import harpe.logging.entryFromDict
import harpe.logging.valueFromJson
import harpe.Model
import harpe.Model.Message
import harpe.Model.UserInput
import harpe.Model.Assistant
import harpe.Model.Attachment
import harpe.turns.Success
import harpe.turns.Interrupted
import harpe.turns.Failed
import harpe.logging.Value


//[ Whether a session has a turn in flight.
  !
  ! `Active` carries the turn's opening transcript payload — what the user
  ! actually sent — so a tab loading (or reloading) mid-turn renders the pending
  ! message from the same value `/api/history` will render it from afterwards,
  ! and then subscribes to the turn's events.
//]
union SessionState = Idle | Active(request: Value)

//[ One attached event sink
  !
  ! (an open streaming response), identified so its owner can detach it when its
  ! subscription ends.
//]
class Subscriber(id: Int, sink: Sink)

private class PendingApproval(id: String, request: ApprovalRequest)
  val ready = threading.event()
  var decision = ""
end

//[ One live conversation
  !
  ! Its id, its append log, and the pieces each of its turns is run with: the
  ! `brain`, the `tools` it is offered, the `routes` that run them, and the
  ! `context`, which owns the running transcript window and is therefore the one
  ! piece that must survive between turns. Plus its working memory. A lock
  ! serializes turns within the session so its state stays consistent under
  ! concurrent requests.
//]
class Session(
    id: String, log: Logger, brain: Model, tools: Toolset, context: Context,
    memory: Memory, memoryPath: String)
  //[ This session's conversation, recorded into its own log.
    !
    ! Typed as the concrete journal, not as `Transcript`, because `turn` — the
    ! driver's bracket — deliberately is not on the interface.
  //]
  val transcript = new Journal(log)

  val lock = threading.lock()

  //[ Set (via `POST /api/stop`) to request cancellation of the running turn
    !
    ! The engine notices between model calls and tool executions. Cleared when
    ! that turn becomes idle.
  //]
  val stop = threading.event()

  var lastActive: Float = time.now()

  //[ The live turn state (`Idle`/`Active`), reported to a tab on load so it can reconnect to a turn in flight
    !
    ! `idle` is *set* exactly when `state` is `Idle`, so a subscriber blocks on
    ! it for precisely the turn's remaining duration.
  //]
  var state: SessionState = Idle
  val idle = threading.event()

  //[ The event sinks attached to the running turn
    !
    ! The initiating request plus any tabs that subscribed after loading
    ! mid-turn — so one turn fans out to every connected view. Guarded by
    ! `sinksLock`. `nextSubId` hands out ids.
  //]
  private val sinksLock = threading.lock()
  private var subs: List[Subscriber] = []
  private var nextSubId: Int = 0
  private val approvalLock = threading.lock()
  private var pendingApproval: Option[PendingApproval] = None

  //[ Attach `sink` to the running turn, returning its id for later detach. //]
  def addSink(sink: Sink): Int =
    sinksLock.acquire()
    val id = nextSubId
    nextSubId = nextSubId + 1
    subs = subs + new Subscriber(id, sink)
    sinksLock.release()

    approvalLock.acquire()
    val pending = pendingApproval
    approvalLock.release()
    match pending
    case Some(item) => sink(approvalEvent(item))
    case None       => pass
    id

  //[ Detach the sink with this id (idempotent). //]
  def removeSink(id: Int): Unit =
    sinksLock.acquire()
    subs = subs.select(s => s.id != id)
    sinksLock.release()

  //[ Emit one event to every attached sink
    !
    ! The snapshot is taken under the lock but the writes happen off it, so a
    ! slow client cannot stall the turn. A write that fails — a tab that closed
    ! — is ignored: the sink is released by its owner (the turn, or the
    ! subscriber handler) when the turn ends, not here.
  //]
  def broadcast(obj: py.Dict): Unit =
    sinksLock.acquire()
    val current = subs
    sinksLock.release()

    for s in current do
      val _ = py.try(s.sink(obj))

  private def approvalEvent(item: PendingApproval): py.Dict =
    py.dict(
      "type" ~ "approval",
      "id" ~ item.id,
      "title" ~ item.request.title,
      "detail" ~ item.request.detail
    )

  //[ Ask the connected session user and wait for an approval decision. //]
  private def requestApproval(id: String, request: ApprovalRequest): ApprovalDecision =
    val item = new PendingApproval(id, request)

    approvalLock.acquire()
    pendingApproval = Some(item)
    approvalLock.release()
    broadcast(approvalEvent(item))

    val deadline = time.now() + 600.0
    var decision: ApprovalDecision = ApprovalTimedOut
    var waiting = true

    while waiting do
      if stop.is_set().asBool then
        decision = ApprovalCancelled
        waiting = false
      else if time.now() >= deadline then
        decision = ApprovalTimedOut
        waiting = false
      else if item.ready.wait(0.1).asBool then
        decision = ApprovalDecision.fromWire(item.decision)
        waiting = false

    approvalLock.acquire()
    if pendingApproval is Some(current) && current.id == id then pendingApproval = None
    approvalLock.release()
    broadcast(py.dict("type" ~ "approval-ended", "id" ~ id, "decision" ~ ApprovalDecision.wire(decision)))
    decision

  //[ Resolve the current request. Stale or duplicate decisions are ignored. //]
  def decideApproval(id: String, decision: String): Bool =
    approvalLock.acquire()
    val accepted =
      match pendingApproval
      case Some(item) =>
        if item.id == id && (decision == "approved" || decision == "rejected") then
          item.decision = decision
          item.ready.set()
          true
        else false
      case None => false
    approvalLock.release()
    accepted

  //[ Run one user turn, fanning its events out to every attached sink.
    !
    ! `initiatorSink` is the sink of the request that started the turn. It is
    ! attached once the turn owns the session lock (so it never receives a prior
    ! turn's events) and detached when the turn ends. While `state` is `Active`,
    ! other tabs may attach via `addSink`. All of them see the same stream. When
    ! the turn finishes, `idle` is set, which releases every subscriber.
  //]
  def runTurn(transcriptId: String, request: Value, prompt: String, initiatorSink: Sink): Unit =
    // Opening the bracket HERE, outside the lock the body takes, is what makes
    // the gap to `harpe.turn.started` the real queue wait. `turn` writes the
    // closing record from what the body returns, so the two cannot drift.
    transcript.turn: transcriptId, request, () =>
      lastActive = time.now()

      this.lock.acquire()
      state = Active(request)
      idle.clear()
      val subId = addSink(initiatorSink)

      val emit: Sink = obj => this.broadcast(obj)
      val channel = new WebInteract(emit, this.stop, (id, request) => requestApproval(id, request))

      val turn = with logger = log, interact = channel in
        Agent.ask(prompt, brain = brain, tools = tools, context = context, transcript = transcript)

      // The driver's reading of the finished turn: how it ended, and which files
      // the agent delivered. `sendFile` is the agent's channel for putting a file
      // in front of the user, so its deliveries are a high-level OUTPUT of the
      // turn — recorded here as fact, rather than inferred later by matching tool
      // names against the journal.
      val response = Journal.payload("sent" ~ Session.delivered(turn))

      // The same value `/api/history` will rebuild from disk, so the live view and
      // the reloaded one are rendered from identical inputs.
      val record = TurnRecord(transcriptId, request, response, turn)

      match turn.result
      case Success =>
        this.commit()
        // The finished turn, rendered exactly as `/api/history` would render it once
        // reloaded — so the page folds the live reply into its committed form (code
        // trace, delivered files) from this event alone, with nothing to re-fetch.
        broadcast: py.dict:
          "type" ~ "turnFinish"
          "rows" ~ TurnView.rows(record, Session.existingDataDir(this.id))

      case Interrupted =>
        this.rollback()
        broadcast(py.dict("type" ~ "interrupted"))

      case Failed(detail) =>
        this.rollback()
        broadcast(py.dict("type" ~ "failed", "detail" ~ detail))

      case _ => pass

      removeSink(subId)
      state = Idle
      stop.clear()
      idle.set()
      this.lock.release()
      response

  //[ Request cancellation only when this session has a turn in flight. //]
  def requestStop(): Unit =
    match state
    case Active(_) => stop.set()
    case Idle      => pass

  //[ Commit a completed turn's working memory
    !
    ! Transcript entries have already flowed through the structured logger
    ! channel.
  //]
  private def commit(): Unit =
    saveMemory()

  //[ Finish a cancelled or failed turn
    !
    ! Memory is still persisted — it is deliberate and not rolled back with the
    ! provisional assistant transcript. The engine retains the user message.
  //]
  private def rollback(): Unit =
    saveMemory()

  //[ Persist the working memory beside the transcript archive. //]
  private def saveMemory(): Unit =
    if !memory.isEmpty then Memory.save(memoryPath, memory)

  //[ Release the session's open journal before its stored files are removed. //]
  def close(): Unit = log.close()
end

//[ Lightweight metadata for one persisted session
  !
  ! Used to populate the session picker without loading the whole conversation:
  ! the id (also its URL), a human title (the first user message), and the start
  ! time.
//]
class SessionMeta(id: String, title: String, time: Float)

//[ One file in a session's data directory
  !
  ! (an upload or agent output), as the file list and drawer show it: its
  ! basename, byte size, guessed MIME type, and last-modified time.
//]
class SessionFile(name: String, size: Int, mime: String, modified: Float)

section Session
  //[ The file backing the session with this id. //]
  def sessionPath(id: String): String receives workspace =
    workspace.relative("logs/sessions/" + id + ".jsonl")

  //[ The per-session data directory
    !
    ! The private root the sandbox grants this session as `HARPE_DATA_DIR`, so
    ! `fs` (and the document readers) see only this session's files. Uploaded
    ! attachments land here, and files the agent writes surface here too.
    ! Created on demand. Scoped by id so sessions never share a tree (the
    ! multi-tenant reason a single shared `data/` will not do).
  //]
  def dataDir(id: String): String receives workspace =
    val dir = workspace.relative("data/" + id)
    if !os.path.isdir(dir) then os.makedirs(dir)
    dir

  //[ The session's data directory, only if it already exists
    !
    ! For rendering, which must resolve delivered files without creating a
    ! directory as a side effect.
  //]
  def existingDataDir(id: String): Option[String] receives workspace =
    val base = os.path.basename(id.replace("\\", "/"))
    if base == "" || base == "." || base == ".." then None
    else
      val dir = workspace.relative("data/" + base)
      if os.path.isdir(dir) then Some(dir) else None

  //[ The files in the data directory `dir`, newest first — uploads and agent output alike
    !
    ! The caller passes an already-resolved, contained directory (see
    ! `ChatServer.existingDataDir`). `[]` if it is missing or empty.
  //]
  def listFiles(dir: String): List[SessionFile] =
    if !os.path.isdir(dir) then []
    else
      var files: List[SessionFile] = []
      for nameDyn in os.listdir(dir) do
        val name = nameDyn.asString
        val p = os.path.join(dir, name)
        if os.path.isfile(p) then
          val info = SessionFile:
            name
            os.path.getsize(p)
            mimetypes.guessType(name).getOrElse("application/octet-stream")
            os.path.getmtime(p)
          files = files + info

      files.sortBy(f => f.modified).reverse

  //[ An append log for this id's session (its file is created lazily). //]
  def forSession(id: String): Logger receives workspace =
    new JsonlLogger(sessionPath(id))

  def memoryPath(id: String): String receives workspace =
    val path = sessionPath(id)
    path.substring(0, path.size - 6) + ".memory.json"

  //[ Permanently remove a session's transcript, memory, and data directory. //]
  def removeStored(id: String): Unit receives workspace =
    val transcript = sessionPath(id)
    val memory = memoryPath(id)
    val data = workspace.relative("data/" + id)

    if os.path.isfile(transcript) then os.unlink(transcript)
    if os.path.isfile(memory) then os.unlink(memory)
    if os.path.isdir(data) then py.module("shutil").rmtree(data)

  //[ Reconstruct this id's conversation from disk
    !
    ! `[]` if it has no file yet, so a freshly-minted (or unknown) id loads as
    ! an empty conversation.
  //]
  def load(id: String): List[Message] receives workspace =
    Journal.fromEntries(loadEntries(id))

  //[ Reconstruct this driver's transcript for application history.
    !
    ! Only turns this driver bracketed. A turn some other part of the system ran
    ! against the same session — a subagent, a maintenance job — is in the log
    ! for auditing and is not part of the conversation the user sees.
  //]
  def loadRecords(id: String): List[TurnRecord] receives workspace =
    Journal.records(loadEntries(id))

  //[ The files this turn delivered, in the order the agent sent them
    !
    ! The turn's only high-level OUTPUT, and the whole of its closing payload.
    ! How the turn ended is not repeated here — that is `TurnRecord.data.result`.
    !
    ! Names only: whether each file still exists, and its size and type, are
    ! resolved when the page renders, so one deleted since the delivery shows as
    ! a muted card rather than disappearing from the dialog.
  //]
  def delivered(turn: TurnData): Value =
    var names: List[Value] = []
    for m in turn.messages do
      if m is Assistant(_, calls) then
        for c in calls if c.name == "sendFile" do names = names + c.input.string("fileName")
    names

  //[ Decode this driver's per-session JSONL file. //]
  private def loadEntries(id: String): List[Entry] receives workspace =
    val path = sessionPath(id)
    if !file.exists(path) then []
    else
      var entries: List[Entry] = []
      for line in file.read(path).lines if line.trim != "" do
        entries = entries + entryFromDict(json.loads(line).cast[py.Dict])
      entries

  //[ The persisted sessions, newest first — id, title, and start time.
    !
    ! Scans the sessions directory and reads each file's head for a title (its
    ! first user message) and start time, without loading whole conversations.
  //]
  def listSessions(): List[SessionMeta] receives workspace =
    val dir = workspace.relative("logs/sessions")
    var metas: List[SessionMeta] = []

    if os.path.isdir(dir) then
      for nameDyn in os.listdir(dir) do
        val name = nameDyn.asString
        if name.endsWith(".jsonl") then
          metas = metas + readMeta(os.path.join(dir, name), name.substring(0, name.size - 6))

    metas.sortBy(m => m.id).reverse

  //[ One session's metadata, read from the head of its file. //]
  private def readMeta(path: String, id: String): SessionMeta =
    var title = ""
    var startTime = 0.0
    var sawFirst = false

    for line in file.read(path).lines do
      val s = line.trim
      if s != "" then
        val d = json.loads(s).cast[py.Dict]
        if !sawFirst then
          startTime = time.fromRfc3339(d.get("time", "").asString)
          sawFirst = true

        // The turn's OPENING record, which holds what the user typed. The
        // engine's own `harpe.turn.started` carries the model-facing text, with
        // any file manifest appended — not a title.
        if title == "" && d.get("category", "").asString == Journal.requestCategory then
          title = TurnView.requestText(valueFromJson(d.get("data", py.dict())))

    new SessionMeta(id, if title == "" then "New chat" else title, startTime)
end
