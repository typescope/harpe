//[ Session.jo
  !
  ! The web driver's live conversation object (`Session`) and its storage layout
  ! (the `Session` section): conversations live as `logs/sessions/<id>.jsonl` under
  ! the workspace, one file per session, keyed by the id that also appears in its
  ! `/c/<id>` URL.
  !
  ! This layout is a *driver* decision, kept out of the shared `harpe.SessionLog`
  ! (which only owns the per-message record schema). The section maps an id to its
  ! file (`forSession` to append, `load` to read back via `SessionLog.loadFile`) and
  ! scans the directory to list past sessions for the picker. Ids are time-sortable,
  ! so newest-first is just a reverse id sort.
//]

namespace harpe.web

import harpe.ffi.jsonMod
import harpe.ffi.readFile
import harpe.ffi.threadingMod
import harpe.models.*
import harpe.Memory
import harpe.SessionLog
import harpe.workspace

//[ One live conversation: its id, its append log, the running history, and how much
  ! of that history is already persisted. A lock serializes turns within the session
  ! so its history stays consistent under concurrent requests.
//]
class Session(id: String, log: SessionLog, initial: List[Message], memory: Memory)
  val lock = threadingMod.Lock()
  var history: List[Message] = initial
  var saved: Int = initial.size
  var lastActive: Float = time.now()
  private var priorHistory: List[Message] = initial

  //[ Begin a user turn: append the user's message and return the history to run.
    ! The pre-turn point is remembered so a cancelled/failed turn can roll back.
  //]
  def beginTurn(text: String): List[Message] =
    lastActive = time.now()
    priorHistory = history
    history = history + UserText(text)
    history

  //[ Commit a completed turn: adopt its history, append the newly-added messages to
    ! the transcript archive, and persist memory.
  //]
  def commit(updated: List[Message]): Unit =
    history = updated
    log.append(time.now(), history.drop(saved))
    saved = history.size
    saveMemory()

  //[ Abandon a cancelled/failed turn: restore the pre-turn history. Memory is still
    ! persisted — it is deliberate and not rolled back with the transcript.
  //]
  def rollback(): Unit =
    history = priorHistory
    saveMemory()

  //[ Persist the working memory beside the transcript archive. //]
  def saveMemory(): Unit =
    if !memory.isEmpty then Memory.save(log.memoryPath, memory)
end

//[ Lightweight metadata for one persisted session, used to populate the session
  ! picker without loading the whole conversation: the id (also its URL), a human
  ! title (the first user message), and the start time.
//]
class SessionMeta(id: String, title: String, time: Float)

section Session
  //[ The file backing the session with this id. //]
  def sessionPath(id: String): String receives workspace =
    workspace.relative("logs/sessions/" + id + ".jsonl")

  //[ An append log for this id's session (its file is created lazily). //]
  def forSession(id: String): SessionLog receives workspace =
    new SessionLog(sessionPath(id))

  //[ Reconstruct this id's conversation from disk; `[]` if it has no file yet,
    ! so a freshly-minted (or unknown) id loads as an empty conversation.
  //]
  def load(id: String): List[Message] receives workspace =
    SessionLog.loadFile(sessionPath(id))

  //[ The persisted sessions, newest first — id, title, and start time.
    !
    ! Scans the sessions directory and reads each file's head for a title (its
    ! first user message) and start time, without loading whole conversations.
  //]
  def listSessions(): List[SessionMeta] receives workspace =
    val dir = workspace.relative("logs/sessions")
    var metas: List[SessionMeta] = []

    if os.path.isdir(dir) then
      for nameDyn in os.listdir(dir) do
        val name = nameDyn.asString
        if name.endsWith(".jsonl") then
          metas = metas + readMeta(os.path.join(dir, name), name.substring(0, name.size - 6))

    metas.sortBy(m => m.id).reverse

  //[ One session's metadata, read from the head of its file. //]
  private def readMeta(path: String, id: String): SessionMeta =
    var title = ""
    var startTime = 0.0
    var sawFirst = false

    for line in readFile(path).lines do
      val s = line.trim
      if s != "" then
        val d = jsonMod.loads(s).cast[py.Dict]
        if !sawFirst then
          startTime = d.get("time", 0.0).asFloat
          sawFirst = true

        if title == "" && d.get("role", "").asString == "user" then
          title = d.get("text", "").asString

    new SessionMeta(id, if title == "" then "New chat" else title, startTime)
end
