# Copy to .env and fill in. The loop loads .env on startup.

# This example uses the keyless `echo` model by default (see the
# harpe.web.Config.model link in jo.toml), so no API key is needed to try it.
# To use a real model, drop that link and set one of the sections below (the
# provider is chosen by which API key you set; OpenAI wins if both).

# --- Anthropic (default when the echo link is removed) ---
# MODEL=claude-opus-4-6
# ANTHROPIC_API_KEY=

# --- OpenAI (Responses API) ---
# MODEL=gpt-5.6
# OPENAI_API_KEY=
# REASONING_EFFORT=medium   # reasoning effort: low | medium | high | none
# OPENAI_BASE_URL=          # optional: Azure OpenAI or another Responses-API endpoint

# Where the chat server listens (optional; these are the defaults).
HOST=127.0.0.1
PORT=8765
