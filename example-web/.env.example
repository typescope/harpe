# Copy to .env and fill in. The loop loads .env on startup.

# This example uses the keyless `echo` model by default (see the
# harpe.web.Config.model link in jo.toml), so no API key is needed to try it.
# To use a real model, drop that link and set one of the sections below.

# --- Anthropic (default when the echo link is removed) ---
# PROVIDER=anthropic
# MODEL=claude-opus-4-6
# ANTHROPIC_API_KEY=

# --- OpenAI / OpenAI-compatible ---
# PROVIDER=openai
# MODEL=gpt-4o
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional: Groq, Together AI, local llama.cpp, etc.

# Where the chat server listens (optional; these are the defaults).
HOST=127.0.0.1
PORT=8765
