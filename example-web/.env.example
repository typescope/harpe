# Copy to .env and fill in. The loop loads .env on startup.

# This example uses the keyless `echo` model by default (see the
# harpe.web.Config.model link in jo.toml), so no API key is needed to try it.
# To use a real model, drop that link and set these:
MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# Where the chat server listens (optional; these are the defaults).
HOST=127.0.0.1
PORT=8765
