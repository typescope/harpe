namespace UserTask

import SandboxAPI.*

def runTask(): Unit receives IO.stdout =
  var sum = 0
  var n = 2
  while n < 80 do
    var isPrime = true
    var d = 2
    while d * d <= n do
      if n % d == 0 then
        isPrime = false
      end
      d = d + 1
    end
    if isPrime then
      sum = sum + n
    end
    n = n + 1
  end
  println sum
