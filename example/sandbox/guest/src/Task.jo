namespace UserTask

import SandboxAPI.*

def runTask(): Unit =
  var n = 999
  while n > 1 do
    if isPrime(n) then
      println("The biggest prime less than 1000 is " + n.toString)
      return
    end
    n = n - 1
  end

def isPrime(n: Int): Bool =
  if n < 2 then return false
  var i = 2
  while i * i <= n do
    if n % i == 0 then return false
    i = i + 1
  end
  true
