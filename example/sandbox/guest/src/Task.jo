namespace UserTask

import SandboxAPI.runTask
import jo.IO.stdout
import HarpeCaps.*

def isPrime(n: Int): Bool =
  if n < 2 then false
  else
    var i = 2
    var result = true
    while i * i <= n && result do
      if n % i == 0 then result = false
      i = i + 1
    result

def runTask(): Unit receives stdout, skills, logger =
  // Check if 49999 is really prime
  println("Is 49999 prime? " + isPrime(49999))
  // Also check a few below just in case
  println("Is 49993 prime? " + isPrime(49993))
  println("Is 49991 prime? " + isPrime(49991))
