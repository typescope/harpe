namespace SandboxRuntime

import jo.IO.stdout
import HarpeCaps.*
import HarpeCapsRuntime.*
import SandboxAPI

// The agent's per-turn entry. The guest links jo.main = SandboxRuntime.main. It builds
// the granted capabilities (reusing Harpe's impls) and runs the LLM's program.
def main(): Unit receives stdout =
  val loggerImpl = new LoggerImpl(stdout)

  with HarpeCaps.logger = loggerImpl in
    SandboxAPI.runTask()
