namespace SandboxRuntime

import jo.IO.stdout
import harpe.sandbox.*
import SandboxAPI

// The agent's per-turn entry. The guest links jo.main = SandboxRuntime.main. It
// builds the host-side `Sandbox` and runs the LLM's program. Capability impls
// would be constructed here too — `new FooImpl(sandbox)` — and granted to the
// guest via `with Foo.foo = fooImpl in ...`. The `Sandbox` itself is never
// passed to `runTask`, so the LLM cannot name it.
def main(): Unit receives stdout =
  val sandbox: Sandbox = Sandbox.create()

  // Cap the guest's resources before running its code. These are set on this
  // process and cannot be raised, so the LLM's `runTask` can neither exceed nor
  // undo them. Tune per agent; the host's wall-clock timeout is the outer bound.
  sandbox.limitMemoryMb(512)    // 512 MB address space
  sandbox.limitCpuSeconds(10)   // 10s of CPU time

  sandbox.log("info", "sandbox runtime ready")

  SandboxAPI.runTask()
