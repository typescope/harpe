//[ Workbook.jo
  !
  ! An open spreadsheet workbook, read sheet-wise: list the sheets, size one up,
  ! then read a row window. Windowed access keeps a huge sheet's cost proportional
  ! to what the program actually needs; close the workbook when done.
//]

namespace harpe.caps

//[ A sheet's extent: rows and columns. //]
class SheetSize(rows: Int, columns: Int)

//[ An open workbook. Rows are 1-based; an unknown sheet name answers `None`. //]
interface Workbook
  //[ The sheet names, in workbook order. //]
  def sheets: List[String]

  //[ The extent of `sheet` — plan a window before reading. //]
  def dimensions(sheet: String): Option[SheetSize]

  //[ The cells of rows [`start`, `start + count`) of `sheet`, rendered as text
    ! (an empty cell is `""`). A window past the end reads short. `start` is
    ! 1-based; a `start` below 1 is a bug in the program and aborts the run.
  //]
  def rows(sheet: String, start: Int, count: Int): Option[List[List[String]]]

  //[ Release the parsed workbook. Safe to call more than once. //]
  def close(): Unit
end
