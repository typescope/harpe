//[ BinaryFile.jo
  !
  ! An open binary file: whole-content and random-access byte reads. It holds an
  ! open handle, so close it when done. Reading after `close` is an error.
//]

namespace harpe.caps

//[ An open, readable and writable binary file. //]
interface BinaryFile
  //[ All the bytes. Loads the file — for a large one, use `read`. //]
  def bytes: Bytes

  //[ The bytes in the window [`offset`, `offset + length`).
    !
    ! A window past the end reads short.
  //]
  def read(offset: Int, length: Int): Bytes

  //[ The file's size in bytes. //]
  def size: Int

  //[ Write `data` at byte `offset`, overwriting exactly `data.size` bytes in place.
    !
    ! Does not truncate — the file length is unchanged unless the write extends
    ! past the current end.
  //]
  def write(offset: Int, data: Bytes): Unit

  //[ Release the underlying file handle. Safe to call more than once. //]
  def close(): Unit
end
