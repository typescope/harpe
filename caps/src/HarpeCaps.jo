//[ HarpeCaps.jo
  ! Reusable capability building blocks for Harpe agents: typed interfaces an
  ! agent grants to the LLM, plus shared result types. An agent's own
  ! `sandbox/api` imports these and declares its own `runTask` contract; the
  ! framework does NOT own the entry point.
//]

namespace HarpeCaps

import jo.IO.stdout

// ============================================
// Shared result types
// ============================================

union ReadResult = FileContent(content: String) | NotFound | AccessDenied(message: String)

class SearchHit(file: String, line: Int, lineContent: String, context: String)

union Result = Success | Error(message: String)

// ============================================
// Skills — the agent's knowledge (read-only Markdown)
// ============================================

interface Skills
  def list(): List[String]
  def read(name: String): ReadResult
  def grep(query: String, contextLines: Int = 0, maxHits: Int = 20): List[SearchHit]
end

// ============================================
// Logger — structured notes into the audit log
// ============================================

interface Logger
  def info(message: String): Unit
  def warn(message: String): Unit
end

// ============================================
// Capability parameter declarations (an agent's runTask `receives` these)
// ============================================

param skills: Skills
param logger: Logger
