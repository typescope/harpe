//[ FileSystem.jo
  !
  ! The sandbox filesystem the guest reads and writes: a confined tree addressed
  ! by relative string paths. Pure interface — trusted implementations validate a
  ! path with `FileSystem.validate` before resolving it against their real root.
//]

namespace harpe.caps

//[ Metadata for one file or directory — the single stat record.
  !
  ! Kind, size in bytes, and modification time (seconds since the Unix epoch). One
  ! cheap call (a stat, no read), so a program can rank by recency or plan a window
  ! before opening. `sizeBytes` is meaningful for files.
//]
class FileInfo(isFile: Bool, sizeBytes: Int, modifiedAt: Int)

//[ One directory entry: the child path and whether it is a directory.
  !
  ! The type information a listing carries for free, so a tree walk needs no stat
  ! per entry.
//]
class DirEntry(path: String, isDirectory: Bool)

//[ A confined filesystem the guest reads and writes via relative string paths.
  !
  ! Error convention: a failure the program can plan around comes back in the
  ! type — `Result[T, String]` when there is a reason to give, `Option` when
  ! absence says it all.
  !
  ! In opening a file the programmer usually expects error and handles them.
  ! In contrast, reading an already-open file is total — what remains there is
  ! either a contract violation (reading a closed file, a negative offset) or
  ! an unrecoverable I/O fault, and both abort the run.
//]
interface FileSystem
  //[ Whether `path` names an existing file or directory
    !
    ! Returns `false` when the path is invalid.
  //]
  def exists(path: String): Bool

  //[ Whether `path` names an existing file
    !
    ! Returns `false` when the path is invalid.
  //]
  def isFile(path: String): Bool

  //[ The metadata record for `path`. `Ok(None)` when nothing exists there. //]
  def stat(path: String): Result[Option[FileInfo], String]

  //[ The entries directly under `dir`, sorted by name. Pass `""` for the root.
    !
    ! `Err` when `dir` is not a directory.
  //]
  def list(dir: String): Result[List[DirEntry], String]

  //[ Open the file at `path` for text reads. Close it when done.
    !
    ! Text decodes as `encoding` — `"utf-8"` (the default) or `"windows-1252"`
    ! (the common legacy encoding. It also decodes latin-1 text): a fixed set
    ! every runtime supports with identical semantics. Any other name is an
    ! `Err`. Undecodable bytes decode to the replacement character U+FFFD —
    ! mojibake or U+FFFD in the output is the signal to reopen with the other
    ! encoding.
  //]
  def openTextFile(path: String, encoding: String = "utf-8"): Result[TextFile, String]

  //[ Open the file at `path` for binary reads. Close it when done. //]
  def openBinaryFile(path: String): Result[BinaryFile, String]

  //[ Open the PDF document at `path` — parse and validate once. The `PDF` is the handle for page-wise reading
    !
    ! Close it when done.
    !
    ! A shortcut through the ambient `pdfReader` backend. Rebind the param to
    ! swap the backend.
  //]
  def openPDF(path: String): Result[PDF, String] receives pdfReader =
    pdfReader.open(path)

  //[ Open the spreadsheet workbook (`.xlsx`) at `path`
    !
    ! Parse and validate once. The `Workbook` is the handle for sheet-wise
    ! reading. Close it when done.
    !
    ! A shortcut through the ambient `excelReader` backend.
  //]
  def openWorkbook(path: String): Result[Workbook, String] receives excelReader =
    excelReader.open(path)

  //[ Open the Word document (`.docx`) at `path` — parse once. The `Word` is the handle for paragraph-wise reading
    !
    ! Close it when done.
    !
    ! A shortcut through the ambient `wordReader` backend.
  //]
  def openWord(path: String): Result[Word, String] receives wordReader =
    wordReader.open(path)

  //[ The whole file as text — the one-shot for a small file (opens, reads, closes).
    !
    ! For a large file, open it and use `lines`, `head`, or `tail` instead.
  //]
  def readText(path: String, encoding: String = "utf-8"): Result[String, String] =
    openTextFile(path, encoding).map: file =>
      val content = file.text
      file.close()
      content

  //[ The whole file's bytes — the one-shot counterpart of `readText`. //]
  def readBytes(path: String): Result[Bytes, String] =
    openBinaryFile(path).map: file =>
      val content = file.bytes
      file.close()
      content

  //[ Write `content` to `file` as UTF-8, replacing what is there
    !
    ! Creating the file (and any missing parent directories) if needed. The
    ! write counterpart of `readText`: a one-shot for producing a text artifact.
  //]
  def writeText(path: String, content: String): Result[Unit, String]

  //[ Create (or truncate) the file at `path`, open for binary writing
    !
    ! `Err` when the path or I/O operation fails. Any missing parent directories
    ! are created. Build the bytes with `BinaryFile.write`, then `close`. For
    ! text output, prefer `writeText`.
  //]
  def createBinaryFile(path: String): Result[BinaryFile, String]
end

section FileSystem
  //[ Validate a portable path inside a confined filesystem.
    !
    ! `""` names the root. Every other accepted path is relative, uses `/`, and
    ! contains only non-empty segments other than `.` and `..`. Backslashes,
    ! absolute paths, Windows drive paths, and NUL are rejected.
    !
    ! Returns `None` when valid or `Some(message)` describing why the path is
    ! invalid.
  //]
  def validate(path: String): Option[String] =
    if path == "" then None
    else if path.startsWith("/") then Some("path must be relative")
    else if path.contains("\\") then Some("path must use '/' as its separator")
    else if path.contains("\u{0}") then Some("path must not contain NUL")
    else if path.size >= 2 && path.get(1) == ':' then Some("path must not contain a drive prefix")
    else
      for segment in path.split("/") do
        if segment == "" then return Some("path must not contain empty segments")
        if segment == "." then return Some("path must not contain '.' segments")
        if segment == ".." then return Some("path must not contain '..' segments")
      None
end

//[ The ambient confined filesystem. //]
param fs: FileSystem
