//[ Containers.jo
  !
  ! The elements with children.
  !
  ! `Row` and `Column` share one width/height distribution helper, so the two
  ! passes — `measure` asking how big, `layout` deciding where — cannot drift
  ! apart. Elasticity is read off `Element.flexWeight` rather than by
  ! pattern-matching on element types, which is what keeps a user-defined
  ! element a first-class citizen.
  !
  ! `Clip` and `Panel` are ordinary elements. Neither needs engine support,
  ! because `draw` recurses into children itself: they simply establish state
  ! around the call that paints the child.
//]

namespace harpe.caps.layout

import harpe.caps.drawing.*

//[ Where a child sits across its container's main axis.
  !
  ! `finish` is the far edge — it would be `end`, but that is a Jo keyword.
  ! `baseline` is row-only, and is what lines up mixed font sizes.
//]
type Cross = Cross.start | Cross.center | Cross.finish | Cross.stretch | Cross.baseline

section Cross
  object start
  object center
  object finish
  object stretch
  object baseline
end

// --- shared distribution -------------------------------------------------

//[ The main-axis size for each child: rigid children get what they measure,
  ! elastic ones split what is left in proportion to their weight.
//]
private def distribute(children: List[Element], gap: Float, room: Float,
                       cross: Float, horizontal: Bool): List[Float] receives graphics =
  val n = children.size
  val gaps = if n > 1 then gap * (n - 1).toFloat else 0.0
  val loose =
    if horizontal then Constraints.upTo(room, cross)
    else Constraints.upTo(cross, room)

  var sizes = List.empty[Float]
  var fixed = 0.0
  var weight = 0.0
  var i = 0

  while i < n do
    val child = children.get(i)

    if child.flexWeight > 0.0 then
      weight = weight + child.flexWeight
      sizes = sizes ++ [0.0 - 1.0]        // marker, resolved below
    else
      val m = child.measure(loose)
      val size = if horizontal then m.width else m.height
      fixed = fixed + size
      sizes = sizes ++ [size]

    i = i + 1

  val slack = room - fixed - gaps
  val spare = if slack < 0.0 then 0.0 else slack

  var out = List.empty[Float]
  i = 0

  while i < n do
    val child = children.get(i)

    if child.flexWeight > 0.0 && weight > 0.0 then
      out = out ++ [spare * child.flexWeight / weight]
    else if child.flexWeight > 0.0 then
      out = out ++ [0.0]
    else
      out = out ++ [sizes.get(i)]

    i = i + 1

  out

private def totalOf(sizes: List[Float], gap: Float): Float =
  var t = 0.0

  for s in sizes do
    t = t + s

  if sizes.size > 1 then t + gap * (sizes.size - 1).toFloat else t

// --- row -----------------------------------------------------------------

//[ Children laid left to right. //]
class Row(children: List[Element], gap: Float, cross: Cross)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val widths = distribute(children, gap, c.maxW, c.maxH, true)
    var above = 0.0
    var below = 0.0
    var i = 0

    while i < children.size do
      val m = children.get(i).measure(
        new Constraints(widths.get(i), widths.get(i), 0.0, c.maxH))

      if m.baseline > above then
        above = m.baseline

      val tail = m.height - m.baseline

      if tail > below then
        below = tail

      i = i + 1

    new Measured(c.clampW(totalOf(widths, gap)), c.clampH(above + below), above)

  def layout(bounds: Rect): Laid receives graphics =
    val widths = distribute(children, gap, bounds.width, bounds.height, true)
    val self = measure(Constraints.of(bounds))
    var kids = List.empty[Laid]
    var x = bounds.x
    var i = 0

    while i < children.size do
      val child = children.get(i)
      val w = widths.get(i)
      val m = child.measure(new Constraints(w, w, 0.0, bounds.height))

      val h =
        match cross
        case _: Cross.stretch => bounds.height
        case _                => m.height

      val y =
        match cross
        case _: Cross.center   => bounds.y + (bounds.height - h) / 2.0
        case _: Cross.finish   => bounds.y + bounds.height - h
        case _: Cross.baseline => bounds.y + self.baseline - m.baseline
        case _                 => bounds.y

      kids = kids ++ [child.layout(new Rect(x, y, w, h))]
      x = x + w + gap
      i = i + 1

    new Laid(this, bounds, self.baseline, kids)

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

// --- column --------------------------------------------------------------

//[ Children stacked top to bottom. //]
class Column(children: List[Element], gap: Float, cross: Cross)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val heights = distribute(children, gap, c.maxH, c.maxW, false)
    var widest = 0.0
    var first = 0.0
    var i = 0

    while i < children.size do
      val h = heights.get(i)
      val m = children.get(i).measure(new Constraints(0.0, c.maxW, h, h))

      if m.width > widest then
        widest = m.width

      if i == 0 then
        first = m.baseline

      i = i + 1

    new Measured(c.clampW(widest), c.clampH(totalOf(heights, gap)), first)

  def layout(bounds: Rect): Laid receives graphics =
    val heights = distribute(children, gap, bounds.height, bounds.width, false)
    var kids = List.empty[Laid]
    var y = bounds.y
    var baseline = 0.0
    var i = 0

    while i < children.size do
      val child = children.get(i)
      val h = heights.get(i)
      val m = child.measure(new Constraints(0.0, bounds.width, h, h))

      val w =
        match cross
        case _: Cross.stretch => bounds.width
        case _                => m.width

      val x =
        match cross
        case _: Cross.center => bounds.x + (bounds.width - w) / 2.0
        case _: Cross.finish => bounds.x + bounds.width - w
        case _               => bounds.x

      if i == 0 then
        baseline = m.baseline

      kids = kids ++ [child.layout(new Rect(x, y, w, h))]
      y = y + h + gap
      i = i + 1

    new Laid(this, bounds, baseline, kids)

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

// --- stack ---------------------------------------------------------------

//[ Children layered in z-order, all filling the same bounds. Later children
  ! paint over earlier ones.
//]
class Stack(children: List[Element])
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    var widest = 0.0
    var tallest = 0.0
    var first = 0.0
    var i = 0

    while i < children.size do
      val m = children.get(i).measure(c.loosened)

      if m.width > widest then
        widest = m.width

      if m.height > tallest then
        tallest = m.height

      if i == 0 then
        first = m.baseline

      i = i + 1

    new Measured(c.clampW(widest), c.clampH(tallest), first)

  def layout(bounds: Rect): Laid receives graphics =
    var kids = List.empty[Laid]
    var baseline = 0.0
    var i = 0

    while i < children.size do
      val child = children.get(i)

      if i == 0 then
        baseline = child.measure(Constraints.of(bounds)).baseline

      kids = kids ++ [child.layout(bounds)]
      i = i + 1

    new Laid(this, bounds, baseline, kids)

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

// --- single-child wrappers -----------------------------------------------

//[ A child inset on four sides. //]
class Pad(child: Element, insets: Insets)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val m = child.measure(c.deflate(insets))
    new Measured(
      c.clampW(m.width + insets.horizontal),
      c.clampH(m.height + insets.vertical),
      m.baseline + insets.top)

  def layout(bounds: Rect): Laid receives graphics =
    val inner = new Rect(
      bounds.x + insets.left,
      bounds.y + insets.top,
      atLeastZero(bounds.width - insets.horizontal),
      atLeastZero(bounds.height - insets.vertical))

    val kid = child.layout(inner)
    new Laid(this, bounds, kid.baseline + insets.top, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

//[ A child at its natural size, positioned inside the room it is given.
  ! `ax` and `ay` are fractions: 0 is the near edge, 0.5 centred, 1 the far edge.
//]
class Aligned(child: Element, ax: Float, ay: Float)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val m = child.measure(c.loosened)
    new Measured(c.clampW(c.maxW), c.clampH(m.height), m.baseline)

  def layout(bounds: Rect): Laid receives graphics =
    val m = child.measure(Constraints.upTo(bounds.width, bounds.height))
    val x = bounds.x + (bounds.width - m.width) * ax
    val y = bounds.y + (bounds.height - m.height) * ay
    val kid = child.layout(new Rect(x, y, m.width, m.height))
    new Laid(this, bounds, (y - bounds.y) + kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

//[ A child forced to an exact size. //]
class Sized(child: Element, w: Float, h: Float)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val m = child.measure(Constraints.tight(w, h))
    new Measured(c.clampW(w), c.clampH(h), m.baseline)

  def layout(bounds: Rect): Laid receives graphics =
    val kid = child.layout(new Rect(bounds.x, bounds.y, w, h))
    new Laid(this, new Rect(bounds.x, bounds.y, w, h), kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

//[ Marks a child elastic along its container's main axis. Everything else
  ! delegates, so a flexed child behaves exactly like the child.
//]
class Flex(weight: Float, child: Element)
  view Element

  def flexWeight: Float = weight

  def measure(c: Constraints): Measured receives graphics = child.measure(c)

  def layout(bounds: Rect): Laid receives graphics =
    val kid = child.layout(bounds)
    new Laid(this, bounds, kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end

//[ Confines a child's painting to its own bounds, optionally rounded. //]
class Clip(child: Element, radius: Float)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics = child.measure(c)

  def layout(bounds: Rect): Laid receives graphics =
    val kid = child.layout(bounds)
    new Laid(this, bounds, kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    val b = node.bounds
    val region = Region.roundRect(b.x, b.y, b.width, b.height, radius)

    // append rather than replace: clips intersect, so nesting narrows
    with Style.clip = Style.clip ++ [region] in
      Element.paintChildren(cv, node)
end

//[ A filled and/or outlined rounded rectangle behind a child. //]
class Panel(child: Element, fill: Option[Paint], border: Option[Paint],
            stroke: Stroke, radius: Float)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics = child.measure(c)

  def layout(bounds: Rect): Laid receives graphics =
    val kid = child.layout(bounds)
    new Laid(this, bounds, kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    val b = node.bounds
    val region = Region.roundRect(b.x, b.y, b.width, b.height, radius)

    match fill
    case Some(paint) =>
      with Style.fillPaint = paint in cv.fill(region)

    case None => pass

    match border
    case Some(paint) =>
      with Style.strokePaint = paint, Style.stroke = stroke in cv.stroke(region)

    case None => pass

    Element.paintChildren(cv, node)
end
