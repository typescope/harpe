//[ Graphic.jo
  !
  ! Arbitrary drawing of a fixed size — the escape hatch down to the imaging
  ! model, and the reason the layout engine needs no plugin API: anything you can
  ! draw on a `Canvas` measures, composes and lands like any other element.
  !
  ! The painter draws in **local coordinates** — (0, 0) is the element's own
  ! top-left, wherever layout puts it.
//]

namespace harpe.caps.layout.elements

import harpe.caps.layout.*
import harpe.caps.drawing.*

//[ Arbitrary drawing of a fixed size, in local coordinates. //]
class Graphic(w: Float, h: Float, paint: Painter)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    new Measured(c.clampW(w), c.clampH(h), c.clampH(h))

  def layout(bounds: Rect): Laid receives graphics =
    new Laid(this, bounds, bounds.height, List.empty[Laid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics,
      Style.alpha,
      Style.transform,
      Style.clip
  =
    // shift the local origin to wherever the element landed
    val local = Matrix.translate(node.bounds.x, node.bounds.y)

    with Style.transform = local.andThen(Style.transform) in
      paint(cv)
end
