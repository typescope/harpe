//[ Distribution.jo
  !
  ! How `Row` and `Column` divide their main axis. Not an element — the one piece
  ! of shared arithmetic between the two flow containers.
  !
  ! **The geometry is stated once.** `resolve` answers both questions a flow has
  ! — how much room does each child get, and what did it measure at that size —
  ! and `measure` and `layout` both consume the same `Track`. Before, each stated
  ! the division itself, so the pass that asks how big and the pass that decides
  ! where could drift apart, and one `layout` measured every child three times.
  !
  ! `horizontal` picks the axis, so one function serves both containers.
  !
  ! Elasticity is read off `Element.flexWeight` rather than by pattern-matching
  ! on element types — that is what keeps a user-defined element a first-class
  ! citizen.
//]

namespace harpe.caps.layout.elements

import harpe.caps.layout.*
import harpe.caps.drawing.*

//[ A resolved main axis: how much room each child gets, and what it measured at
  ! that size. Everything a flow needs to size itself and place its children.
//]
class Track(sizes: List[Float], metrics: List[Measured])
  //[ The extent along the main axis, including the gaps between children. //]
  def total(gap: Float): Float =
    var t = 0.0

    for s in sizes do
      t = t + s

    if sizes.size > 1 then t + gap * (sizes.size - 1).toFloat else t

  //[ The largest baseline among the children — a row's own baseline. //]
  def above: Float =
    var a = 0.0

    for m in metrics do
      if m.baseline > a then
        a = m.baseline

    a

  //[ The largest drop below a baseline. A row's height is `above + below`, not
    ! `max(height)`: maximising the two halves independently is what stops a deep
    ! descender in one child from shoving the shared baseline up.
  //]
  def below: Float =
    var b = 0.0

    for m in metrics do
      val tail = m.height - m.baseline

      if tail > b then
        b = tail

    b

  //[ The largest cross-axis extent — a column's width. //]
  def widest: Float =
    var w = 0.0

    for m in metrics do
      if m.width > w then
        w = m.width

    w

  //[ The first child's baseline — a column's own baseline. //]
  def firstBaseline: Float =
    if metrics.isEmpty then 0.0 else metrics.get(0).baseline
end

//[ Divide `room` along the main axis and measure every child at the size it
  ! ends up with. Rigid children get what they ask for; elastic ones split what
  ! is left in proportion to their weight.
//]
private def resolve(children: List[Element], gap: Float, room: Float,
                    cross: Float, horizontal: Bool): Track receives graphics =
  val n = children.size
  val gaps = if n > 1 then gap * (n - 1).toFloat else 0.0
  val loose =
    if horizontal then Constraints.upTo(room, cross)
    else Constraints.upTo(cross, room)

  // what the rigid children want, and how much weight is competing for the rest
  var wanted = List.empty[Float]
  var fixed = 0.0
  var weight = 0.0
  var i = 0

  while i < n do
    val child = children.get(i)

    if child.flexWeight > 0.0 then
      weight = weight + child.flexWeight
      wanted = wanted ++ [0.0]
    else
      val m = child.measure(loose)
      val size = if horizontal then m.width else m.height
      fixed = fixed + size
      wanted = wanted ++ [size]

    i = i + 1

  val slack = room - fixed - gaps
  val spare = if slack < 0.0 then 0.0 else slack

  // final sizes, then one measurement of each child at the size it will get
  var sizes = List.empty[Float]
  var metrics = List.empty[Measured]
  i = 0

  while i < n do
    val child = children.get(i)

    val size =
      if child.flexWeight > 0.0 && weight > 0.0 then spare * child.flexWeight / weight
      else if child.flexWeight > 0.0 then 0.0
      else wanted.get(i)

    val c =
      if horizontal then new Constraints(size, size, 0.0, cross)
      else new Constraints(0.0, cross, size, size)

    sizes = sizes ++ [size]
    metrics = metrics ++ [child.measure(c)]
    i = i + 1

  new Track(sizes, metrics)
