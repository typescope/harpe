//[ Cross.jo
  !
  ! Where a child sits across its container's main axis.
  !
  ! `finish` is the far edge — it would be `end`, but that is a Jo keyword.
  ! `baseline` is row-only, and is what lines up mixed font sizes.
  !
  ! There is deliberately no main-axis counterpart. `space` and `flex` express
  ! every distribution a `justify-content` enum would, without a second concept.
//]

namespace harpe.caps.layout

type Cross = Cross.start | Cross.center | Cross.finish | Cross.stretch | Cross.baseline

section Cross
  object start
  object center
  object finish
  object stretch
  object baseline
end
