//[ PDF.jo
  !
  ! An open PDF document: page-wise text, the outline and information dictionary,
  ! content profiles, and page rendering. It holds the parsed document, so a loop
  ! over pages parses the file once, not per call; close it when done.
  !
  ! Deliberately no whole-document read: page-wise access keeps a large document's
  ! cost proportional to what the program actually needs. Naming a page outside
  ! `1..pageCount` is a bug in the program and aborts the run.
//]

namespace harpe.caps

//[ One outline (table-of-contents) entry.
  !
  ! A heading title, the 1-based page it points to (0 when the entry has no page
  ! destination), and its nesting depth (0 for a top-level entry).
//]
class Heading(title: String, page: Int, level: Int)

//[ A PDF page's content profile.
  !
  ! How many text runs, embedded images, and vector paths (lines, rectangles,
  ! curves) the page's content stream holds.
//]
class PageContent(texts: Int, images: Int, paths: Int)

//[ An open PDF document. Pages are 1-based. //]
interface PDF
  //[ The number of pages. //]
  def pageCount: Int

  //[ The document outline (table of contents), in document order.
    !
    ! Empty when the document carries none. The map of a large document: find the
    ! section by title, then read just its pages with `pageText` instead of
    ! scanning linearly.
  //]
  def outline: List[Heading]

  //[ The document information dictionary.
    !
    ! Standard keys (`Title`, `Author`, `Subject`, `Keywords`, `CreationDate`, …),
    ! empty values omitted.
  //]
  def metadata: Map[String, String]

  //[ One page's text; `Err` when the page's content cannot be extracted. //]
  def pageText(page: Int): Result[String, String]

  //[ The page's content profile.
    !
    ! The cheap "what kind of page is this" probe. No text but an image → a scanned
    ! page: render it with `pageImage` and OCR. Images alongside text → figures worth
    ! rendering. Many paths → ruling lines, usually a table or a diagram. PDF has no
    ! table structure — a table is text runs plus ruling paths — so these counts are
    ! the honest signal, not a detector.
  //]
  def pageContent(page: Int): PageContent

  //[ Render one page to a PNG image at `target`, returning its pixel size.
    !
    ! The bridge to OCR: when `pageText` comes back empty (a scanned page), render
    ! the page and hand `target` to `OCR.text`. `scale` multiplies the page's
    ! natural 72-dpi size — the default 2 (≈ 144 dpi) is enough for OCR.
  //]
  def pageImage(page: Int, target: String, scale: Int = 2): Result[ImageSize, String]

  //[ Release the parsed document. Safe to call more than once. //]
  def close(): Unit
end
