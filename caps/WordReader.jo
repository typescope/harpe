//[ WordReader.jo
  !
  ! The Word-document parsing backend: opens a `.docx` into a `Word` handle. The
  ! `FileSystem.openWord` shortcut reads through the `wordReader` param, so an
  ! agent swaps backends by rebinding the param without touching `FileSystem`.
//]

namespace harpe.caps

//[ Open Word (`.docx`) documents. //]
interface WordReader
  //[ Open the document at `src` — parse and validate once. Close it when done. //]
  def open(src: Path): Result[Word, String]
end

//[ The ambient Word backend. //]
param wordReader: WordReader
