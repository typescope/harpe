//[ WordBuilder.jo
  !
  ! A Word document under construction: append headings and paragraphs, then
  ! `save` to a target `Path` chosen at the end.
//]

namespace harpe.caps

//[ A document being built. //]
interface WordBuilder
  //[ Append a heading (`level` 1-9). //]
  def addHeading(text: String, level: Int): Unit

  //[ Append a body paragraph. //]
  def addParagraph(text: String): Unit

  //[ Write the document to `target`. //]
  def save(target: Path): Result[Unit, String]
end
