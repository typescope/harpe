//[ WorkbookBuilder.jo
  !
  ! A workbook under construction. Build sheet by sheet, then `save` to a target
  ! `Path` — chosen at the end, so one builder serves create, edit, and transform.
//]

namespace harpe.caps

//[ A whole-number cell value. //]
class IntCell(value: Int)

//[ A boolean cell value. //]
class BoolCell(value: Bool)

//[ A cell value: text, a float, a wrapped whole number, or a wrapped boolean
  ! (raw numeric types cannot share a union, so the rarer ones are wrapped). A
  ! string starting with `=` is stored as a formula (`"=SUM(A1:A9)"`).
//]
type Cell = String | Float | IntCell | BoolCell

//[ A workbook being built. //]
interface WorkbookBuilder
  //[ Add an empty sheet named `name`. //]
  def addSheet(name: String): Unit

  //[ Append one row of cells to `sheet`; `false` when no such sheet exists. //]
  def appendRow(sheet: String, cells: List[Cell]): Bool

  //[ Set one cell of `sheet` (`row`/`column` are 1-based); `false` when no such
    ! sheet exists.
  //]
  def setCell(sheet: String, row: Int, column: Int, value: Cell): Bool

  //[ Write the workbook to `target`. //]
  def save(target: Path): Result[Unit, String]
end
