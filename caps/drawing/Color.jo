//[ Color.jo
  !
  ! An RGB color, part of the shared imaging vocabulary (`harpe.caps.drawing`).
//]

namespace harpe.caps.drawing

//[ An RGB color, 0–255 per channel. //]
class Color(r: Int, g: Int, b: Int)

section Color
  def black: Color = new Color(0, 0, 0)
  def white: Color = new Color(255, 255, 255)
end
