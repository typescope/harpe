//[ Canvas.jo
  !
  ! The `Canvas` capability: a single surface an agent paints shapes and text
  ! onto, then saves. No layout and no pages — this is the imaging model in
  ! isolation (diagrams, charts, thumbnails, annotations).
  !
  ! The painting methods — `glyphs`, `fill`, `stroke`, `fillStroke`, `imageAt`
  ! — are the imaging model. Each reads its state from the ambient
  ! `DrawingContext` and declares exactly which parts it consumes.
  !
  ! Coordinates are in **logical units**, top-left origin — not pixels. A
  ! surface has a `scale` (device pixels per logical unit), so the same drawing
  ! renders at `scale = 1` for screen and `scale = 4` for print without any
  ! geometry changing. Nothing above this interface mentions pixels.
  !
  ! Environment errors (a missing image, an unwritable target) come back as
  ! `Result`.
//]

namespace harpe.caps.drawing

import harpe.caps.Path

//[ How a group's pixels combine with what is beneath it. //]
type Blend = Blend.normal | Blend.multiply | Blend.screen | Blend.overlay

section Blend
  object normal
  object multiply
  object screen
  object overlay
end

//[ A surface under construction. //]
interface Canvas
  //[ The surface size in logical units. //]
  def width: Float
  def height: Float

  //[ Device pixels per logical unit. //]
  def scale: Float

  //[ Fill a closed `region` with the ambient fill paint. //]
  def fill(region: Region): Unit receives
      DrawingContext.fillPaint,
      DrawingContext.fillRule,
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip

  //[ Stroke an `outline` — an open `Trace` or a closed `Region` — with the
    ! ambient stroke paint and stroke geometry.
  //]
  def stroke(outline: Trace | Region): Unit receives
      DrawingContext.strokePaint,
      DrawingContext.stroke,
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip

  //[ Fill then stroke a closed `region`. //]
  def fillStroke(region: Region): Unit receives
      DrawingContext.fillPaint,
      DrawingContext.fillRule,
      DrawingContext.strokePaint,
      DrawingContext.stroke,
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip

  //[ Draw an already-shaped `run` with its origin at `x` and its baseline at
    ! `baseline`, in the ambient text paint. The run carries its own font, so
    ! this does not read `DrawingContext.font` — shaping already resolved it.
  //]
  def glyphs(run: GlyphRun, x: Float, baseline: Float): Unit receives
      DrawingContext.textPaint,
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip

  //[ Shape `text` in the ambient font and draw it at `x` / `baseline`. A
    ! convenience over `graphics.shape` plus `glyphs`; it does not wrap.
  //]
  def textAt(x: Float, baseline: Float, text: String): Unit receives
      graphics,
      DrawingContext.font,
      DrawingContext.textPaint,
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip
  =
    glyphs(graphics.shape(text), x, baseline)

  //[ Render `body` to an offscreen surface, then composite that surface once at
    ! `opacity` with `blend`.
    !
    ! This is not the same as `DrawingContext.alpha`, and the difference is the
    ! reason it exists. `alpha` applies per operation, so two overlapping shapes
    ! at `alpha = 0.5` blend against each other and the overlap darkens. Inside
    ! a group they are drawn opaque and the *result* is composited once, so the
    ! group behaves as a single object with no internal seams.
    !
    ! It takes a body rather than being a context param because the backend
    ! needs the scope *exit* to pop and composite, and it never observes a
    ! `with` binding going out of scope.
  //]
  def group(opacity: Float, blend: Blend, body: () => Unit): Unit

  //[ Draw the image at `src`, its top-left at (`x`, `y`), scaled to `width`
    ! logical units wide (aspect preserved).
  //]
  def imageAt(src: Path, x: Float, y: Float, width: Float): Result[Unit, String] receives
      DrawingContext.alpha,
      DrawingContext.transform,
      DrawingContext.clip

  //[ Write the surface to `target` as a PNG, at this surface's `scale`.
    !
    ! Vector output is not reachable from here: cairo fixes the surface kind at
    ! creation, and this one is raster. It arrives with the layout engine, whose
    ! positioned tree can be replayed onto an SVG surface — the same property
    ! that makes structural golden tests possible.
  //]
  def save(target: Path): Result[Unit, String]
end
