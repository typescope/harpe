//[ Region.jo
  !
  ! A closed outline — a fillable (and strokeable) region. Build one by closing
  ! a `Trace`, or use the `rect`/`roundRect`/`circle` conveniences.
//]

namespace harpe.caps.drawing

//[ A closed outline. //]
class Region(ops: List[PathOp])

section Region
  //[ The Bézier off-curve factor for a quarter arc of radius 1. //]
  private def kappa: Float = 0.5522847498

  //[ An axis-aligned rectangle. //]
  def rect(x: Float, y: Float, w: Float, h: Float): Region =
    Trace.from(x, y).lineTo(x + w, y).lineTo(x + w, y + h).lineTo(x, y + h).close()

  //[ A rectangle with corner radius `r`. //]
  def roundRect(x: Float, y: Float, w: Float, h: Float, r: Float): Region =
    val k = kappa * r
    Trace.from(x + r, y)
      .lineTo(x + w - r, y)
      .curveTo(x + w - r + k, y, x + w, y + r - k, x + w, y + r)
      .lineTo(x + w, y + h - r)
      .curveTo(x + w, y + h - r + k, x + w - r + k, y + h, x + w - r, y + h)
      .lineTo(x + r, y + h)
      .curveTo(x + r - k, y + h, x, y + h - r + k, x, y + h - r)
      .lineTo(x, y + r)
      .curveTo(x, y + r - k, x + r - k, y, x + r, y)
      .close()

  //[ A circle of radius `r` centered at (`cx`, `cy`), as four Béziers. //]
  def circle(cx: Float, cy: Float, r: Float): Region =
    val k = kappa * r
    Trace.from(cx + r, cy)
      .curveTo(cx + r, cy + k, cx + k, cy + r, cx, cy + r)
      .curveTo(cx - k, cy + r, cx - r, cy + k, cx - r, cy)
      .curveTo(cx - r, cy - k, cx - k, cy - r, cx, cy - r)
      .curveTo(cx + k, cy - r, cx + r, cy - k, cx + r, cy)
      .close()
end
