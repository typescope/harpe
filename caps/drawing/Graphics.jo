//[ Graphics.jo
  !
  ! The ambient graphics backend: it mints `Canvas` surfaces and answers the
  ! font and image facts drawing needs.
  !
  ! Facts live here, not on `Canvas`: glyph metrics and image sizes are facts
  ! about fonts and files, independent of any one surface. Text is measured by
  ! shaping it — `shape` is the only way to learn a string's width, because the
  ! width depends on kerning and ligatures that only the shaper knows.
  !
  ! This interface is the entire FFI floor of the drawing engine. It carries
  ! exactly two kinds of thing: facts (`shape`, metrics, `imageSize`) and
  ! emission (`create`, and the `Canvas` it returns). Everything else is pure
  ! Jo.
//]

namespace harpe.caps.drawing

import harpe.caps.Path
import harpe.caps.ImageSize

//[ Create surfaces, and answer font/image facts. //]
interface Graphics
  //[ A new surface `width` × `height` logical units, at `scale` device pixels
    ! per unit, filled with `background` — or transparent when `background` is
    ! `None`.
  //]
  def create(width: Float, height: Float, scale: Float,
             background: Option[Color]): Canvas

  //[ Register the font file at `src` under `family`, so text in that `family`
    ! renders with it — for a custom font that is not installed on the machine.
    !
    ! `src` is a TrueType or OpenType file: a single-face `.ttf`/`.otf`, or a
    ! `.ttc` collection (its first face is used). `Err` if the file is missing
    ! or not a readable font.
  //]
  def registerFont(family: String, src: Path): Result[Unit, String]

  //[ Shape `text` in the ambient font: the positioned glyphs a renderer draws,
    ! with kerning and ligatures applied. This is both how text is measured
    ! (`run.width`) and how it is drawn (`canvas.glyphs`).
  //]
  def shape(text: String): GlyphRun receives DrawingContext.font

  //[ The advance width of `text` in the ambient font. //]
  def stringWidth(text: String): Float receives DrawingContext.font =
    shape(text).width

  //[ The ambient font's ascent / descent (both positive, in logical units). //]
  def fontAscent: Float receives DrawingContext.font
  def fontDescent: Float receives DrawingContext.font

  //[ The pixel dimensions of the image at `src`. //]
  def imageSize(src: Path): Result[ImageSize, String]
end

//[ The ambient graphics backend. //]
param graphics: Graphics
