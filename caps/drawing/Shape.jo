//[ Shape.jo
  !
  ! An immutable path value, built fluently and handed to a surface to fill or
  ! stroke. Curves are cubic Béziers; the backend flattens them. Geometry is in
  ! the surface's own units, top-left origin.
//]

namespace harpe.caps.drawing

//[ One path-building operation. //]
class MoveTo(x: Float, y: Float)
class LineTo(x: Float, y: Float)
class CurveTo(x1: Float, y1: Float, x2: Float, y2: Float, x3: Float, y3: Float)
object ClosePath

type PathOp = MoveTo | LineTo | CurveTo | ClosePath

//[ A path value; build with `moveTo`/`lineTo`/`curveTo`/`close`, or the
  ! `Shape.rect`/`roundRect`/`circle` conveniences.
//]
class Shape(ops: List[PathOp])
  def moveTo(x: Float, y: Float): Shape = new Shape(ops ++ [new MoveTo(x, y)])
  def lineTo(x: Float, y: Float): Shape = new Shape(ops ++ [new LineTo(x, y)])

  def curveTo(x1: Float, y1: Float, x2: Float, y2: Float, x3: Float, y3: Float): Shape =
    new Shape(ops ++ [new CurveTo(x1, y1, x2, y2, x3, y3)])

  def close(): Shape = new Shape(ops ++ [ClosePath])
end

section Shape
  //[ The Bézier off-curve factor for a quarter arc of radius 1. //]
  private def kappa: Float = 0.5522847498

  def empty: Shape = new Shape(List.empty[PathOp])

  //[ An axis-aligned rectangle. //]
  def rect(x: Float, y: Float, w: Float, h: Float): Shape =
    Shape.empty.moveTo(x, y).lineTo(x + w, y).lineTo(x + w, y + h).lineTo(x, y + h).close()

  //[ A rectangle with corner radius `r`. //]
  def roundRect(x: Float, y: Float, w: Float, h: Float, r: Float): Shape =
    val k = kappa * r
    Shape.empty
      .moveTo(x + r, y)
      .lineTo(x + w - r, y)
      .curveTo(x + w - r + k, y, x + w, y + r - k, x + w, y + r)
      .lineTo(x + w, y + h - r)
      .curveTo(x + w, y + h - r + k, x + w - r + k, y + h, x + w - r, y + h)
      .lineTo(x + r, y + h)
      .curveTo(x + r - k, y + h, x, y + h - r + k, x, y + h - r)
      .lineTo(x, y + r)
      .curveTo(x, y + r - k, x + r - k, y, x + r, y)
      .close()

  //[ A circle of radius `r` centered at (`cx`, `cy`), as four Béziers. //]
  def circle(cx: Float, cy: Float, r: Float): Shape =
    val k = kappa * r
    Shape.empty
      .moveTo(cx + r, cy)
      .curveTo(cx + r, cy + k, cx + k, cy + r, cx, cy + r)
      .curveTo(cx - k, cy + r, cx - r, cy + k, cx - r, cy)
      .curveTo(cx - r, cy - k, cx - k, cy - r, cx, cy - r)
      .curveTo(cx + k, cy - r, cx + r, cy - k, cx + r, cy)
      .close()
end
