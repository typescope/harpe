//[ Typesetting.jo
  !
  ! Text-layout state, read by the flow layer: horizontal `align` and line
  ! `leading`. Like `DrawingContext`, these are context parameters changed by
  ! rebinding over a block:
  !
  !   with Typesetting.align = Align.center in flow.paragraph(title)
//]

namespace harpe.caps.drawing

//[ Horizontal text alignment. //]
type Align = Align.left | Align.right | Align.center | Align.justify

section Align
  object left
  object right
  object center
  object justify
end

section Typesetting
  param align: Align = Align.left
  param leading: Float = 1.3     // line spacing, as a multiple of the font size

  //[ Families tried, in order, for a code point the ambient font lacks a glyph
    ! for — automatic font fallback. "cjk" resolves to an installed CJK font.
  //]
  param fontFallback: List[String] = ["cjk"]
end
