//[ MediaProvider.jo
  !
  ! The guest capability for granted media: inspect an id, then load it into the
  ! filesystem. Kept separate from `FileSystem` because media may live on a server or
  ! in a database rather than the local tree — though one class (`FileSystemImpl`, in
  ! the harpe module) can implement both views.
  !
  ! `load` puts the resource at a `Path`, then the guest reads it through `FileSystem`
  ! or hands the `Path` to a processor.
//]

namespace harpe.media

//[ Access to granted media, keyed by id. //]
interface MediaProvider
  //[ The descriptor for a granted `id` — type, name, size — without materializing it.
    !
    ! `None` when `id` is not granted. Cheap, so the model can decide whether to load.
  //]
  def resolve(id: String): Option[Media]

  //[ Load `id` into the filesystem at `target`; `false` if `id` is not granted. //]
  def load(id: String, target: Path): Bool
end
