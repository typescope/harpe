//[ WordWriter.jo
  !
  ! The Word-document writing backend: build a `.docx` from zero or load an
  ! existing one, then save to a target — edit-in-place and transform are the
  ! same workflow.
//]

namespace harpe.caps

//[ Create or edit Word (`.docx`) documents. //]
interface WordWriter
  //[ A builder over a new, empty document. //]
  def create(): WordBuilder

  //[ A builder loaded from the document at `src`. //]
  def edit(src: Path): Result[WordBuilder, String]
end

//[ The ambient Word writing backend. //]
param wordWriter: WordWriter
