//[ OCR.jo
  !
  ! The text-recognition capability: read the text content of an image (a scan, a
  ! screenshot, a rendered PDF page). FFI-backed, so granted on its own.
  !
  ! Its own capability, apart from `Image`: recognizing text is content extraction,
  ! granted separately from pixel work — and its backends (a local engine, a cloud
  ! service) swap independently of the image library.
//]

namespace harpe.media

//[ Read the text content of an image. //]
interface OCR
  //[ Text recognized in the image; empty if none. //]
  def text(src: Path): String
end
