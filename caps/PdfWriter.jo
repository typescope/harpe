//[ PdfWriter.jo
  !
  ! The PDF writing backend. PDFs are write-once — no `edit` (in-place PDF editing
  ! is unreliable in every library); create and save.
//]

namespace harpe.caps

//[ Create PDF documents. //]
interface PdfWriter
  //[ A builder over a new, empty document (one page, growing automatically). //]
  def create(): PdfBuilder
end

//[ The ambient PDF writing backend. //]
param pdfWriter: PdfWriter
