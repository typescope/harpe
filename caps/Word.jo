//[ Word.jo
  !
  ! The Word-document format capability: turn a `.docx` (named by a `Path`) into
  ! text. FFI-backed, so granted on its own.
//]

namespace harpe.media

//[ Read a Word (`.docx`) document's text. //]
interface Word
  //[ The document's text. //]
  def text(src: Path): Result[String, String]
end
