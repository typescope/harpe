//[ API.jo — Duffel Flight Booking API
  !
  ! The LLM writes Jo programs using these types to:
  ! 1. Search for flights (origin, destination, date, passenger count)
  ! 2. Inspect individual offers (price, itinerary, duration)
  ! 3. Book a selected offer (passenger details, mock balance payment)
  ! 4. Retrieve an order confirmation
  !
  ! All monetary amounts are strings as returned by Duffel (e.g. "123.45").
  ! All dates use ISO 8601 (YYYY-MM-DD for dates, full datetime for timestamps).
//]

namespace sandbox.api

import jo.IO.stdout

//[ One flight segment (a single take-off / landing pair) //]
class FlightSegment(
  origin: String,        // IATA code, e.g. "LHR"
  destination: String,   // IATA code, e.g. "JFK"
  departingAt: String,   // ISO datetime, e.g. "2025-09-01T10:00:00"
  arrivingAt: String,
  carrierName: String,   // e.g. "British Airways"
  flightNumber: String,  // e.g. "BA117"
  duration: String       // ISO 8601 duration, e.g. "PT7H30M"
)

//[ One slice — a directional journey made up of one or more segments //]
class FlightSlice(
  origin: String,        // IATA code of the first departure airport
  destination: String,   // IATA code of the final arrival airport
  departingAt: String,
  arrivingAt: String,
  duration: String,
  segments: List[FlightSegment]
)

//[ One flight offer returned by a search //]
class FlightOffer(
  id: String,
  totalAmount: String,
  currency: String,
  slices: List[FlightSlice],
  passengerIds: List[String]  // IDs to use when creating an order
)

//[ The result of a flight search //]
class SearchResult(
  offerRequestId: String,
  offers: List[FlightOffer]
)

//[ Full details of a single offer (same shape as FlightOffer) //]
class OfferDetail(
  id: String,
  totalAmount: String,
  currency: String,
  slices: List[FlightSlice],
  passengerIds: List[String]
)

//[ Passenger details required when placing an order
  !
  ! `id`          — copy from `offer.passengerIds` (one entry per passenger)
  ! `title`       — "mr" | "ms" | "mrs" | "miss" | "dr"
  ! `gender`      — "m" | "f"
  ! `bornOn`      — "YYYY-MM-DD"
  ! `phoneNumber` — E.164 format, e.g. "+14155552671"
//]
class PassengerInfo(
  id: String,
  title: String,
  givenName: String,
  familyName: String,
  bornOn: String,
  email: String,
  phoneNumber: String,
  gender: String
)

//[ The result of placing an order
  !
  ! Check `error` first — "" means success. On success `bookingReference` is
  ! the airline PNR code (e.g. "ABC123") to give the passenger.
//]
class OrderConfirmation(
  id: String,
  bookingReference: String,
  totalAmount: String,
  currency: String,
  error: String
)

//[ Duffel flight API — provided by the runtime, do not construct directly //]
interface Duffel
  //[ Search for one-way flights
    !
    ! Returns the top offers sorted by price. `cabinClass` is one of:
    ! "economy" | "premium_economy" | "business" | "first".
    ! Returns an empty `offers` list if no results or the search fails.
  //]
  def searchFlights(
    origin: String,
    destination: String,
    departureDate: String,
    passengerCount: Int,
    cabinClass: String
  ): SearchResult

  //[ Fetch the full details of one offer by ID //]
  def getOffer(offerId: String): OfferDetail

  //[ Book a flight — uses test-mode balance payment
    !
    ! `passengers` must contain one entry per `offer.passengerIds` entry, with
    ! the corresponding `id` filled in. `paymentAmount` and `paymentCurrency`
    ! must match the offer's `totalAmount` / `currency` exactly.
    !
    ! In test mode this always uses `type: "balance"` and succeeds without a
    ! real card.
  //]
  def createOrder(
    offerId: String,
    passengers: List[PassengerInfo],
    paymentAmount: String,
    paymentCurrency: String
  ): OrderConfirmation
end

//[ Duffel capability provided by the runtime — do not construct directly //]
param duffel: Duffel

//[ LLM-generated entry point: search, confirm, or book a flight //]
defer def runTask(): Unit receives stdout, duffel
