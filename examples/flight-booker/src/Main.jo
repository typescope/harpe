//[ WebMain.jo
  !
  ! The flight-booker web entry point. `jo run web` starts a local HTTP server.
  !
  ! Env: DUFFEL_API_KEY (required), ANTHROPIC_API_KEY (or OPENAI_API_KEY),
  !       HOST (default 127.0.0.1), PORT (default 8765).
//]

namespace harpe.examples.flightbooker

import harpe.ffi.os
import harpe.util.Process
import harpe.util.File
import harpe.ffi.sys

import jo.IO.stdout
import harpe.Model
import harpe.Http
import harpe.Toolset
import harpe.Tool

param appHome: String

//[ The entry point //]
def main(): Unit receives stdout =
  Process.loadDotenv(".env")
  with appHome = os.path.abspath(".") in webServe()

private def webServe(): Unit receives stdout, appHome =
  val duffelKey = os.getenv("DUFFEL_API_KEY", "")
  if duffelKey == "" then
    println "Error: DUFFEL_API_KEY is not set (get a test key from duffel.com, put it in .env)."
    sys.exit(1)

  if !File.exists(os.path.join(appHome, "assets/index.html")) then
    println "Error: assets/index.html not found in \{appHome}/assets/"
    sys.exit(1)

  val brain = Model.default()
  val sandboxEnv = Map("DUFFEL_API_KEY" ~ duffelKey)
  val bonus = getTodayToolset()

  val server = new FlightServer(brain, appHome, sandboxEnv, bonus)

  val host = os.getenv("HOST", "127.0.0.1")
  val port = Int.parse(os.getenv("PORT", "8765")) rescue None => 8765

  val httpd = Http.server: host, port, () => server.route()

  println """

            ✈           ✈
      ──────●───────────
      ───────────●──────
          S K Y

      Harpe · Flight Booker · Web

  """

  println "  Live at http://\{host}:\{port}"
  println "  Ctrl-C to stop"

  Process.shutdownOnSigint("\n  ✈ Sky stopped.")

  httpd.serve_forever()

def getTodayToolset(): Toolset =
  val spec = Tool:
    "getToday"
    "Get today's date and day of the week. Call this whenever the user mentions a relative date such as \"this Friday\", \"next Monday\", or \"tomorrow\", then compute the target date from the result."
    []
  Toolset.of: spec, (input, channel) =>
    val dt = py.module("datetime")
    val today = dt.date.today()
    val iso = today.isoformat().asString
    val weekday = today.strftime("%A").asString
    new Tool.ToolOutcome("Today is " + weekday + ", " + iso + ".", "getToday · " + iso)
