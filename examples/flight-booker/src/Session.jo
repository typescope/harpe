//[ WebSession.jo
  !
  ! One live browser conversation. Text-only — no file uploads or deliveries,
  ! no interactive code editor. The approval flow is fully supported: when the
  ! agent calls `createOrder`, the sandbox emits an approval request that blocks
  ! until the user confirms or rejects the booking via the browser card.
  !
  ! Turns are serialized by a lock. Cancellation (POST /api/stop) is signalled
  ! by a threading event the engine polls between calls. Approval (POST
  ! /api/approval) resolves a pending decision via a per-request event.
//]

namespace harpe.examples.flightbooker

import harpe.ffi.threading
import harpe.util.Clock
import harpe.ffi.json
import harpe.ffi.os

import harpe.Agent
import harpe.Approvals
import harpe.Context
import harpe.Toolset
import harpe.Model
import harpe.Model.Message
import harpe.TurnData
import harpe.Transcript
import harpe.transcript.Journal
import harpe.logging.Logger
import harpe.logging.logger
import harpe.util.File
import harpe.logging.Value
import harpe.turns.TurnResult


private class PendingApproval(id: String, request: Approvals.Request)
  val ready = threading.Event()
  var decision = ""
end


//[ One live conversation
  !
  ! The session holds the pieces each turn is run with. A lock serializes turns
  ! so concurrent requests from the same tab cannot interleave. `idle` is set
  ! when no turn is running, so `POST /api/stop` has a sensible no-op path.
//]
class Session(id: String, log: Logger, brain: Model, tools: Toolset, context: Context)
  val transcript = new Journal(log)
  val lock = threading.Lock()
  val stop = threading.Event()
  val idle = threading.Event()
  var lastActive: Float = Clock.now()

  private val approvalLock = threading.Lock()
  private var pendingApproval: Option[PendingApproval] = None

  //[ Run one user turn, streaming its events to `sink`.
    !
    ! Opens the transcript bracket, acquires the session lock, runs the engine,
    ! then closes the bracket and releases the lock. The sink receives:
    !
    !   • `status` — thinking indicator, tool names while they run
    !   • `assistant-message` — intermediate text (before tool calls) and the
    !     closing reply sent explicitly after `Agent.ask` returns, because
    !     `AssistantMessage` events only fire for text paired with tool calls
    !   • `approval` / `approval-ended` — booking confirmation flow
    !   • `done` — turn complete (result: success | interrupted | failed)
  //]
  def runTurn(request: Value, text: String, sink: Sink): Unit =
    transcript.request(request)
    lastActive = Clock.now()

    lock.acquire()
    idle.clear()
    stop.clear()

    val channel = new WebInteract(sink, stop, (aid, req) => requestApproval(aid, req, sink))

    val turn = with logger = log in
      Agent.ask:
        text
        brain = brain
        tools = tools
        interact = channel
        context = context
        transcript = transcript

    // `AssistantMessage` events only fire for text paired with tool calls.
    // The turn's closing reply (after the last tool call, or when there were
    // no tool calls at all) is never emitted as an event — send it explicitly.
    val final = turn.finalText
    if final.trim != "" then
      sink(py.dict("type" ~ "assistant-message", "text" ~ final))

    match turn.result
    case TurnResult.Success =>
      sink(py.dict("type" ~ "done", "result" ~ "success"))

    case TurnResult.Interrupted =>
      sink(py.dict("type" ~ "done", "result" ~ "interrupted"))

    case TurnResult.Failed(detail) =>
      sink(py.dict("type" ~ "done", "result" ~ "failed", "detail" ~ detail))

    idle.set()
    lock.release()

    val resultLabel = match turn.result
      case TurnResult.Success     => "success"
      case TurnResult.Interrupted => "interrupted"
      case TurnResult.Failed(_)   => "failed"
    transcript.response(Journal.payload("result" ~ resultLabel))

  //[ Request cancellation of the running turn (idempotent). //]
  def requestStop(): Unit = stop.set()

  //[ Resolve the pending approval. Returns false if the id is stale or no approval is pending. //]
  def decideApproval(id: String, decision: String): Bool =
    approvalLock.acquire()
    val accepted =
      match pendingApproval
      case Some(item) =>
        if item.id == id && (decision == "approved" || decision == "rejected") then
          item.decision = decision
          item.ready.set()
          true
        else false
      case None => false
    approvalLock.release()
    accepted

  //[ Block the engine until the user approves or rejects (10-minute timeout). //]
  private def requestApproval(id: String, request: Approvals.Request, sink: Sink): Approvals.Decision =
    val item = new PendingApproval(id, request)

    approvalLock.acquire()
    pendingApproval = Some(item)
    approvalLock.release()

    sink(py.dict("type" ~ "approval", "id" ~ id, "title" ~ request.title, "detail" ~ request.detail))

    val deadline = Clock.now() + 600.0
    var decision: Approvals.Decision = Approvals.TimedOut
    var waiting = true

    while waiting do
      if stop.is_set().asBool then
        decision = Approvals.Cancelled
        waiting = false
      else if Clock.now() >= deadline then
        waiting = false
      else if item.ready.wait(0.1).asBool then
        decision = Approvals.fromWire(item.decision)
        waiting = false

    approvalLock.acquire()
    if pendingApproval is Some(current) && current.id == id then pendingApproval = None
    approvalLock.release()

    sink(py.dict("type" ~ "approval-ended", "id" ~ id, "decision" ~ Approvals.wire(decision)))
    decision
end


section Session
  //[ The JSONL file for this session's audit log. //]
  def sessionPath(id: String): String receives appHome =
    os.path.join(appHome, "logs/sessions", id + ".jsonl")

  //[ An append log for this chat's session (file created lazily). //]
  def forSession(id: String): Logger receives appHome =
    new harpe.logging.JsonlLogger(sessionPath(id))
end
