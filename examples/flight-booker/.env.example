# Copy to .env and fill in. The loop loads .env on startup.

# --- Telegram (required) ---
# A bot token from @BotFather (talk to it in Telegram, /newbot).
TELEGRAM_BOT_TOKEN=

# Comma-separated SENDER (user) ids allowed to use the bot. DM the bot once
# without adding your id — it will reply with your user id — then add it here.
# Leave empty and every message is rejected.
TELEGRAM_ALLOWED_SENDERS=

# --- Duffel (required) ---
# A test API key from https://app.duffel.com — starts with duffel_test_
# Test keys hit sandbox data; no real flights are booked, no real money is charged.
DUFFEL_API_KEY=

# --- LLM provider (set one) ---

# Anthropic
MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# OpenAI (Responses API)
# MODEL=gpt-5.6
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
