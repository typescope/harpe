namespace GithubRuntime

import jo.IO.stdout
import jo.IO.args
import SandboxAPI
import harpe.sandbox.*
import harpe.ffi.*

//[ JSON-encode a string value — adds surrounding quotes and escapes special chars //]
private def jsonStr(s: String): String = jsonMod.dumps(s).asString

//[ Build a JSON array of LineComment objects for the review payload //]
private def buildCommentsJson(comments: List[GithubAPI.LineComment]): String =
  val comment = (c: GithubAPI.LineComment) =>
    """
    {"path":\{jsonStr(c.path)}, "line":\{c.line.toString}, "body":\{jsonStr(c.body)}}
    """
  "[" + comments.map(comment).join(",") + "]"

private class PR(owner: String, repo: String, num: Int)

def parsePrURL(url: String) => Opt[PR]:
  if url.trim is `^(https://)?github\.com/(?owner[^/]+)/(?repo[^/]+)/pull/(num\d+)$` then:
    new PR(owner, repo, num.toInt)
  else
    None

//[ GitHub interface backed by local snapshot files + live GitHub API //]
class GithubImpl(sd Sandbox, prUrl: String, dryRun: Bool, token: String)
  view GithubAPI.GitHub

  val pr = parsePrURL(prUrl)
  if pr is None then:
    abort "invalid PR url:" + prUrl

  val client = new GithubClient(token)
  val prInfo = getPR()

  private def getPR(): GithubAPI.PRInfo =
    val pr = client.getPR(pr.owner, pr.repo, pr.num)

    var diffs: List[GithubAPI.FileDiff] = []
    for d in pr["diffs"].cast[py.List] do
      diffs = diffs + new GithubAPI.FileDiff(
        d.path.asString,
        d.status.asString,
        d.additions.asInt,
        d.deletions.asInt,
        d.patch.asString
      )

    new GithubAPI.PRInfo(
      pr.number.asInt,
      pr.title.asString,
      pr.body.asString,
      pr.base_br.asString,
      pr.head_br.asString,
      pr.head_sha.asString,
      pr.state.asString,
      diffs
    )

  def getPRInfo(): GithubAPI.PRInfo = prInfo

  //[ Read repo file //]
  def readFile(path: String): String =
    if sd.fileExists(path) then
      sd.readFile(path)
    else
      val files = client.getRepoFiles(pr.owner, pr.repo, List(path))
      val content = files[path]
      if content != "" then sd.writeFile(path, content)
      content

  //[ Write operations — call the real GitHub API (or print in dry-run mode) //]
  def submitReview(verdict: GithubAPI.ReviewVerdict, body: String, comments: List[GithubAPI.LineComment]): Unit receives stdout =
    val PR(owner, repo, num) = pr
    val verdictStr = match verdict
      case GithubAPI.Approve        => "APPROVE"
      case GithubAPI.RequestChanges => "REQUEST_CHANGES"
      case GithubAPI.CommentOnly    => "COMMENT"
    end
    val commentsJson = buildCommentsJson(comments)
    if dryRun then
      println ("[DRY RUN] submitReview: " + verdictStr)
      println ("  body: " + body)
      println ("  comments: " + commentsJson)
      println "ACTION_COMPLETED"
    else
      client.submitReview(owner, repo, num, prInfo.headSha, verdictStr, body, commentsJson)
      println "✓ Review submitted"
      println "ACTION_COMPLETED"

  def addComment(body: String): Unit receives stdout =
    val PR(owner, repo, num) = pr
    if dryRun then
      println "[DRY RUN] addComment:"
      println ("  " + body)
      println "ACTION_COMPLETED"
    else
      client.addComment(owner, repo, num, body)
      println "✓ Comment posted"
      println "ACTION_COMPLETED"

  def merge(commitMessage: String): Unit receives stdout =
    val PR(owner, repo, num) = pr
    if dryRun then
      println "[DRY RUN] merge PR"
      println "ACTION_COMPLETED"
    else
      client.mergePR(owner, repo, num, prInfo.headSha, commitMessage)
      println "✓ PR merged"
      println "ACTION_COMPLETED"

end

//[ Main entry point //]
def main(): Unit receives args, stdout =
  if args.size < 4 then
    println args
    println "Error: missing arguments"
    println "Usage: python3 task.py <prUrl> <dryRun>"
    abort "Missing arguments"

  println args
  val prUrl  = args[1]
  val dryRun = args[2] == "true"
  val tmp = py.module("tempfile").mkdtemp().asString
  val sandbox: Sandbox = Sandbox.create(tmp)

  match sandbox.env("GITHUB_TOKEN"):
    case Some(token) =>
      val ghImpl = new GithubImpl(sandbox, prUrl, dryRun, token)
      with SandboxAPI.github = ghImpl in
        SandboxAPI.runTask()
    case _ => abort "missing github token from process environment"
end
