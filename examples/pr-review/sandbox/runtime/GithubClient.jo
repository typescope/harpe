//[ GithubClient.jo
  !
  ! Typed Jo wrappers around PyGithub for PR operations.
//]

namespace SandboxRuntime

import harpe.ffi.jsonMod

//[ Typed interface for the `github` module — lets us call Github(...) with keyword args //]
private interface GitHub
  def Github(token: String, user_agent: String @py.keyword): py.Dynamic
end

//[ Typed interface for PyGithub's Github client //]
private interface GetRepo
  def get_repo(name: String): py.Dynamic
end

//[ Typed interface for PyGithub's Repository //]
private interface PrApi
  def get_pull(number: Int): py.Dynamic
  def get_commit(sha: String): py.Dynamic
end

//[ Typed interface for PyGithub's PR actions //]
private interface Review
  def create_review(
    commit: py.Dynamic @py.keyword,
    body: String @py.keyword,
    event: String @py.keyword,
    comments: py.Dynamic @py.keyword
  ): py.Dynamic
  def create_issue_comment(body: String): py.Dynamic
  def merge(sha: String @py.keyword, commit_message: String @py.keyword): py.Dynamic
end

private def module: GitHub = py.module("github").cast[GitHub]

private class GithubClient(token: String):
  val client = module.Github(token, user_agent = "harpe-pr-review/1.0").cast[GetRepo]

  private def getRepo(owner: String, repo: String): PrApi =
    client.get_repo(owner + "/" + repo).cast[PrApi]

  //[ Submit a PR review via PyGithub.
    !
    ! event:        "APPROVE", "REQUEST_CHANGES", or "COMMENT"
    ! commentsJson: JSON array of {path, line, body} objects (pass "[]" for none)
  //]
  def submitReview(
    owner: String,
    repo: String,
    prNumber: Int,
    headSha: String,
    event: String,
    body: String,
    commentsJson: String
  ): Unit =
    val r        = getRepo(owner, repo)
    val pr       = r.get_pull(prNumber).cast[Review]
    val commit   = r.get_commit(headSha)
    val comments = jsonMod.loads(commentsJson)
    pr.create_review(commit = commit, body = body, event = event, comments = comments)

  //[ Post an issue-level comment on the PR. //]
  def addComment(owner: String, repo: String, prNumber: Int, body: String): Unit =
    getRepo(owner, repo).get_pull(prNumber).cast[Review].create_issue_comment(body)

  //[ Merge the PR using the head SHA as a guard against concurrent updates.
    !
    ! commitMessage: merge commit message; pass "" to use GitHub's default.
  //]
  def mergePR(
    owner: String,
    repo: String,
    prNumber: Int,
    headSha: String,
    commitMessage: String
  ): Unit =
    getRepo(owner, repo).get_pull(prNumber).cast[Review].merge(
      sha = headSha,
      commit_message = commitMessage
    )
