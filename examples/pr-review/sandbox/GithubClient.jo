//[ GithubClient.jo
  !
  ! Typed Jo wrappers around PyGithub for PR operations.
//]

namespace sandbox.runtime

def jsonMod: py.Dynamic = py.module("json")

//[ Typed interface for the `github` module — lets us call Github(...) with keyword args //]
private interface GitHub
  def Github(token: String, user_agent: String @py.keyword): py.Dynamic
end

//[ Typed interface for PyGithub's PR actions //]
private interface Review
  def create_review(
    commit: py.Dynamic @py.keyword,
    body: String @py.keyword,
    event: String @py.keyword,
    comments: py.Dynamic @py.keyword
  ): py.Dynamic
  def create_issue_comment(body: String): py.Dynamic
  def merge(sha: String @py.keyword, commit_message: String @py.keyword): py.Dynamic
end

private def module: GitHub = py.module("github").cast[GitHub]

private class GithubClient
  val client: py.Dynamic

  def GithubClient(token: String): GithubClient =
    this.client = module.Github(token, user_agent = "harpe-pr-review/1.0")

  private def getPull(owner: String, repo: String, num: Int): py.Dynamic =
    client.get_repo(owner + "/" + repo).get_pull(num)

  def getPR(owner: String, repo: String, number: Int): py.Dict =
    val pr = getPull(owner, repo, number)
    val diffs: py.List = py.list()

    for f in pr.get_files().cast[py.List] do
      diffs.append(py.dict(
          "path"      ~   f.filename,
          "status"    ~   f.status,
          "additions" ~   f.additions,
          "deletions" ~   f.deletions,
          "patch"     ~   f.patch
      ))
    end


    py.dict(
        "owner"    ~      owner,
        "repo"     ~      repo,
        "number"   ~      pr.number,
        "title"    ~      pr.title,
        "body"     ~      pr.body,
        "author"   ~      pr.user.login,
        "base_br"  ~      pr.base.ref,
        "head_br"  ~      pr.head.ref,
        "head_sha" ~      pr.head.sha,
        "state"    ~      pr.state,
        "diffs"    ~      diffs
    )


  //[ Submit a PR review via PyGithub.
    !
    ! event:        "APPROVE", "REQUEST_CHANGES", or "COMMENT"
    ! commentsJson: JSON array of {path, line, body} objects (pass "[]" for none)
  //]
  def submitReview(
    owner: String,
    repo: String,
    number: Int,
    headSha: String,
    event: String,
    body: String,
    commentsJson: String
  ): Unit =
    val pr       = getPull(owner, repo, number).cast[Review]
    val commit   = client.get_repo(owner + "/" + repo).get_commit(headSha)
    val comments = jsonMod.loads(commentsJson)
    pr.create_review(commit, body, event, comments)

  //[ Post an issue-level comment on the PR. //]
  def addComment(owner: String, repo: String, number: Int, body: String): Unit =
    getPull(owner, repo, number).cast[Review].create_issue_comment(body)

  //[ Merge the PR using the head SHA as a guard against concurrent updates.
    !
    ! commitMessage: merge commit message; pass "" to use GitHub's default.
  //]
  def mergePR(
    owner: String,
    repo: String,
    num: Int,
    headSha: String,
    commitMessage: String
  ): Unit =
    getPull(owner, repo, num).cast[Review].merge(
      sha = headSha,
      commit_message = commitMessage)

  def getRepoFiles(
    owner: String,
    repo: String,
    paths: List[String],
    ref: String = "HEAD"
  ): Map[String, String] =
    val r = client.get_repo(owner + "/" + repo)
    var files = Map[String, String]()
    for path in paths do
        match py.try(r.get_contents(path, ref=ref))
        case Ok(content) =>
          val file = content.decoded_content.decode("utf-8", errors="replace").asString
          files = files.add(path, file)
        case Err(msg) => pass // TODO
    end
    files
