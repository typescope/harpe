namespace harpe.examples.prreview

import jo.IO.stdout
import jo.IO.args
import harpe.*
import harpe.ffi.os
import harpe.ffi.time
import harpe.ffi.dotenv
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.logger
import harpe.Model.UserText
import harpe.turns.Answered
import harpe.tools.runCodeTool
import harpe.tools.skillTools
import harpe.context.FullContext

//[ agent entry point  //]
def main(): Unit receives args, stdout =
  if args.size < 1 then
    abort "Missing PR source argument"

  val pr = args[0]

  if Defaults.checkAgentDir() then
    dotenv.load(".env")
    val wspace = new Workspace(os.path.abspath("."))
    with workspace = wspace in
      Logging.withLogger(new JsonlLogger(wspace.relative("logs/agent.jsonl")), () => review(pr))

private def review(pr: String): Unit receives stdout, workspace, logger =
  val memory = new Memory
  val basePrompt = workspace.read("AGENT.md") rescue None => ""
  val tools = [runCodeTool(workspace.sandboxDir)] ++ skillTools(workspace.skillsDir)

  val context = new FullContext(basePrompt, memory, [])
  val agent = new Agent(Defaults.model(), tools, context)
  val interact = new PrintInteract(stdout)
  val callCtx = Map(
    "PR_URL" ~ pr,
    "GITHUB_TOKEN" ~ os.getenv("GITHUB_TOKEN", "")
  )

  match with callContext = callCtx in agent.runTurn(UserText("please start review the pr", []), interact, 30, 4)
  case Answered(_, text) =>
    println ("  · review completed: " + text)
  case _ =>
    println "  · review failed"

end
