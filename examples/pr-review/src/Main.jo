namespace harpe.examples.prreview

import jo.IO.stdout
import jo.IO.args
import harpe.*
import harpe.ffi.os
import harpe.ffi.time
import harpe.ffi.dotenv
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.logger
import harpe.Model.UserInput
import harpe.turns.TurnResult
import harpe.tools.RunCodeTool
import harpe.tools.SkillTools
import harpe.context.FullContext

//[ agent entry point  //]
def main(): Unit receives args, stdout =
  if args.size < 1 then
    abort "Missing PR source argument"

  val pr = args[0]

  dotenv.load(".env")
  val wspace = new Workspace(os.path.abspath("."))
  with workspace = wspace in
    Logging.withLogger:
      new JsonlLogger: wspace.relative("logs/agent.jsonl")
      () => review(pr)

private def review(pr: String): Unit receives stdout, workspace, logger =
  val basePrompt = workspace.read("AGENT.md") rescue None => ""
  val runCode = RunCodeTool(workspace.sandboxDir, 610.0)
  val skillsDir = workspace.skillsDir

  val context = new FullContext(basePrompt, [])
  val channel = new PrintInteract(stdout)

  // This agent's own context reaches its tools as ordinary arguments: the guest
  // environment `runCode` grants the reviewed program is written right here.
  val guestEnv = Map:
    "PR_URL" ~ pr
    "GITHUB_TOKEN" ~ os.getenv("GITHUB_TOKEN", "")

  val tools =
    SkillTools.toolset(skillsDir)
      ++ runCode.toolset(guestEnv)

  val turn =
    with interact = channel in
      Agent.ask:
        "please start review the pr"
        brain = Model.default()
        tools = tools
        context = context
        maxToolRounds = 30

  match turn.result
  case TurnResult.Success =>
    println ("  · review completed: " + turn.text)

  case _ =>
    println "  · review failed"

end
