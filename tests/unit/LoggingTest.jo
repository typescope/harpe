//[ LoggingTest.jo
  !
  ! Tests for the logging layer (`harpe.logging`): that `Logger.log` accepts bare
  ! typed pairs and assembles an `Entry` (via the `Value` adapters), that
  ! `JsonlLogger` appends every event to one file as well-formed JSON — with
  ! `event` a field and values kept typed — that `Logging.withLogger`
  ! installs a `logger` that reaches producers, and that `TeeLogger` fans one
  ! entry out to several backends.
//]

namespace harpe.test.unit.LoggingTest

import harpe.ffi.os
import harpe.ffi.builtins
import harpe.ffi.json
import harpe.ffi.tempfile
import harpe.util.File
import harpe.util.Process
import harpe.*
import harpe.logging.*
import harpe.models.logReplied
import harpe.testing.thisSuite
import harpe.testing.suite
import harpe.testing.test
import harpe.testing.check

// Read a JSONL file back as one parsed dict per non-empty line.
private def readRecords(path: String): List[py.Dict] =
  var records: List[py.Dict] = []
  for line in File.read(path).lines do
    if line.trim != "" then records = records + json.loads(line).cast[py.Dict]

  records

// The exact Python type of a decoded JSON value ("list", "dict", ...).
private def typeNameOf(obj: py.Dynamic): String =
  builtins.getattr(builtins.typeOf(obj), "__name__").asString

// The producer fields of a record, which live under the envelope's `fields` key.
private def fieldsOf(record: py.Dict): py.Dict =
  record.get("fields", py.dict()).cast[py.Dict]

// An in-memory Logger that keeps the entries it is handed.
private class Capture
  view Logger

  var entries: List[Entry] = []
  var closed: Bool = false

  def logEntry(entry: Entry): Unit = entries = entries + entry

  def close(): Unit = closed = true
end

// One producer thread's share of a concurrent run.
private def hammer(jsonl: JsonlLogger, worker: Int, rounds: Int): Unit =
  var i = 0
  while i < rounds do
    jsonl.log("harpe.test.concurrent", "worker" ~ worker, "i" ~ i)
    i = i + 1

// A producer: emits through the ambient `logger` channel.
private def emitOne(): Unit receives logger =
  logger.log("runs", "code" ~ "hello")

//[ Write one record of every shape this suite asserts on, and read them back
  !
  ! One file for all five, because that a single JSONL file carries every
  ! event name is itself part of the contract.
//]
private def withRecords(body: List[py.Dict] => Unit): Unit =
  val path = os.path.join(tempfile.mkdtemp(), "log.jsonl")
  val jsonl = new JsonlLogger(path)
  jsonl.log("runs", "code" ~ "x", "exitCode" ~ 0, "ok" ~ true, "secs" ~ 1.5)
  jsonl.log("runs", "code" ~ "y", "exitCode" ~ 1)
  jsonl.log("tools", "name" ~ "read")
  jsonl.warn("harpe.test", "rate limited", "attempt" ~ 3)
  with logger = jsonl in logReplied("anthropic", "claude-x", 100, 20, 0, 0)
  jsonl.close()
  body(readRecords(path))

// A record written by a `JsonlLogger` in the sandbox, read as a dict and rebuilt
// into an `Entry` by `runCode` on the host.
private def withAuditEntry(body: Entry => Unit): Unit =
  val path = os.path.join(tempfile.mkdtemp(), "audit.jsonl")
  val alog = new JsonlLogger(path)
  var items: List[Value] = []
  items = items + "a"
  items = items + Value.IntVal(1)
  alog.log("harpe.sandbox.runtime", "info" ~ "ready", "count" ~ 3, "secs" ~ 1.5,
           "ok" ~ true, "items" ~ items)
  alog.close()
  body(Entry.fromDict(readRecords(path).get(0)))

def loggingSuite(): Unit receives thisSuite = suite: "logging", () =>
  test: "log builds one entry from bare typed pairs", () =>
    val cap = new Capture
    cap.log("runs", "code" ~ "x", "exitCode" ~ 0, "ok" ~ true, "secs" ~ 1.5)
    check("one entry", cap.entries.size == 1)
    val rec = cap.entries.get(0)
    check("event", rec.event == "runs")
    check("field count", rec.fields.size == 4)
    check("time stamped", rec.time > 0.0)

  suite: "JsonlLogger", () =>
    test: "writes every event to one file", () =>
      withRecords: all =>
        check("all five", all.size == 5)
        check("event is a field", all.get(0).get("event", "").asString == "runs")
        // Categories coexist, distinguished by the field (jq's job downstream).
        check("another event", all.get(2).get("event", "").asString == "tools")
        check("its fields", fieldsOf(all.get(2)).get("name", "").asString == "read")

    test: "keeps each field at its own type", () =>
      withRecords: all =>
        val first = fieldsOf(all.get(0))
        check("string", first.get("code", "").asString == "x")
        check("int", first.get("exitCode", -1).asInt == 0)
        check("bool", first.get("ok", false).asBool)
        check("float", first.get("secs", 0.0).asFloat == 1.5)

    test: "serializes the entry time as RFC 3339", () =>
      withRecords: all =>
        val timestamp = all.get(0).get("time", "").asString
        check("shape", timestamp.contains("T") && timestamp.endsWith("Z"))

    test: "writes a severity message under its reserved key", () =>
      withRecords: all =>
        val warnRec = all.get(3)
        check("event", warnRec.get("event", "").asString == "harpe.test")
        check("message", fieldsOf(warnRec).get("warning", "").asString == "rate limited")
        check("extras kept", fieldsOf(warnRec).get("attempt", -1).asInt == 3)

    // A backend is thread safe by contract, and this is the one that writes a
    // file. It does NOT prove the lock is load-bearing — CPython serializes
    // `write` on its own, so this passes without it — but it holds the backend
    // to the contract: concurrent producers, every record present and parseable.
    test: "keeps every line whole under concurrent producers", () =>
      val path = os.path.join(tempfile.mkdtemp(), "concurrent.jsonl")
      val jsonl = new JsonlLogger(path)
      val workers = [0, 1, 2, 3, 4, 5, 6, 7]
      val rounds = 50

      var threads: List[py.Dynamic] = []
      for n in workers do
        val thread = Process.daemon(() => hammer(jsonl, n, rounds))
        thread.start()
        threads = threads + thread

      for thread in threads do thread.join()
      jsonl.close()

      val all = readRecords(path)
      check("every record arrived, none torn", all.size == workers.size * rounds)

    test: "records model usage with its billing fields", () =>
      withRecords: all =>
        val usageRec = all.get(4)
        check("event", usageRec.get("event", "").asString == "harpe.model.replied")
        check("provider", fieldsOf(usageRec).get("provider", "").asString == "anthropic")
        check("input tokens", fieldsOf(usageRec).get("inputTokens", -1).asInt == 100)
        check("output tokens", fieldsOf(usageRec).get("outputTokens", -1).asInt == 20)

  suite: "the logger channel", () =>
    test: "withLogger installs it for the wrapped work", () =>
      val cap = new Capture
      Logging.withLogger(cap, () => emitOne())
      check("producer reached it", cap.entries.size == 1)

    test: "discard is a no-op that never throws", () =>
      Logging.discard.log("runs", "code" ~ "z")
      check("silent", true)

    test: "withContext keeps the scope out of the record's own fields", () =>
      val path = os.path.join(tempfile.mkdtemp(), "ctx.jsonl")
      val emit: () => Unit receives logger = () => logger.log("harpe.web", "note" ~ "hi")
      val tagged: () => Unit receives logger =
        () => Logging.withContext("myapp.session=s1", emit)
      Logging.withLogger(new JsonlLogger(path), tagged)

      val ctxRec = readRecords(path).get(0)
      val scope = ctxRec.get("context").cast[py.List].get(0).asString
      check("scoped", scope == "myapp.session=s1")
      check("producer field untouched", fieldsOf(ctxRec).get("note", "").asString == "hi")
      check("not flattened into fields", !fieldsOf(ctxRec).contains("myapp.session"))

    // Nesting must not cost the record either scope. Records flow through the
    // INNER decorator first and the outer one last, so a mechanism that replaced
    // rather than accumulated would drop the scope that actually produced the
    // record, leaving nothing in the output to say it existed.
    test: "nesting keeps every scope, innermost first", () =>
      val path = os.path.join(tempfile.mkdtemp(), "nested-ctx.jsonl")
      val emit: () => Unit receives logger = () => logger.log("harpe.web", "note" ~ "hi")
      val inner: () => Unit receives logger =
        () => Logging.withContext("myapp.scope=inner", emit)
      val outer: () => Unit receives logger =
        () => Logging.withContext("myapp.scope=outer", inner)
      Logging.withLogger(new JsonlLogger(path), outer)

      // The plainest statement of the loss, whatever shape the fix chooses: the
      // scope that produced the record does not appear in the record at all.
      check("innermost scope survives", File.read(path).contains("inner"))

      val scopes = readRecords(path).get(0).get("context")
      check("context is a list of scopes", typeNameOf(scopes) == "list")
      if typeNameOf(scopes) == "list" then
        val list = scopes.cast[py.List]
        check("both scopes kept", list.size == 2)
        if list.size == 2 then
          check("innermost first", list.get(0).asString == "myapp.scope=inner")
          check("outermost last", list.get(1).asString == "myapp.scope=outer")

  suite: "TeeLogger", () =>
    test: "hands every entry to each of its loggers", () =>
      val first = new Capture
      val second = new Capture
      val tee = new TeeLogger([first, second])

      tee.log("runs", "code" ~ "x")
      tee.log("tools", "name" ~ "read")

      check("first got both", first.entries.size == 2)
      check("second got both", second.entries.size == 2)
      check("same entry", second.entries.get(1).event == "tools")

    test: "closes all of them", () =>
      val first = new Capture
      val second = new Capture
      new TeeLogger([first, second]).close()
      check("first closed", first.closed)
      check("second closed", second.closed)

    test: "with no loggers it is a no-op", () =>
      val tee = new TeeLogger([])
      tee.log("runs", "code" ~ "x")
      check("silent", true)

  suite: "audit codec", () =>
    test: "preserves the event, time, and field count", () =>
      withAuditEntry: back =>
        check("event", back.event == "harpe.sandbox.runtime")
        check("parses RFC 3339 time", back.time > 0.0)
        check("field count", back.fields.size == 5)

    test: "keeps each field typed on the way back", () =>
      withAuditEntry: back =>
        match back.fields.getOpt("count")
        case Some(Value.IntVal(n)) => check("int", n == 3)
        case _ => check("int present", false)

        match back.fields.getOpt("ok")
        case Some(Value.BoolVal(b)) => check("bool", b)
        case _ => check("bool present", false)

        match back.fields.getOpt("items")
        case Some(xs: List[Value]) => check("array", xs.size == 2)
        case _ => check("array present", false)
