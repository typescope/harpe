//[ TurnTest.jo
  !
  ! Unit tests for the turn engine (`Agent.ask`). The engine is pure — its
  ! model call is an injected `Responder`, its output an injected `emit`, and its
  ! cancellation a plain event — so each scenario scripts a `Responder`, records
  ! the emitted `TurnEvent`s, and asserts the resulting `TurnResult` + event
  ! sequence. No network, no tty.
  !
  ! Each scenario is summarized as "<result> | <event,tags>" so the expectation
  ! is a single deterministic string (no timings).
//]

namespace harpe.test.unit.TurnTest

import harpe.*
import harpe.turns.*
import harpe.context.WindowedContext
import harpe.context.SummarizingContext
import harpe.transcript.Journal
import harpe.models.echo
import harpe.Model.*
import harpe.metering.Usage
import harpe.Tool.*
import harpe.logging.logger
import harpe.logging.Logger
import harpe.logging.Entry
import harpe.testing.thisSuite
import harpe.testing.suite
import harpe.testing.test
import harpe.testing.checkEquals


// A reported usage. These tests read `inputTokens` and nothing else.
private def used(inputTokens: Int): Usage =
  new Usage:
    "test"
    "test-model"
    inputTokens
    outputTokens = 0
    cacheReadTokens = 0
    cacheWriteTokens = 0

// A reply carrying only text (no tool calls).
private def textReply(s: String): ReplyResult =
  Reply(Assistant(s, []), used(0))

// A reply asking to call the named tool once.
private def toolReply(name: String): ReplyResult =
  val call = ToolCall: "id", name, ToolInput(py.dict())
  Reply(Assistant("", [call]), used(0))

private def toolReplyWithUsage(name: String, inputTokens: Int): ReplyResult =
  val call = ToolCall: "id", name, ToolInput(py.dict())
  Reply(Assistant("", [call]), used(inputTokens))

private def eventTag(e: TurnEvent): String =
  match e
  case TurnEvent.ModelRequestStarted(_, _) => "start"
  case TurnEvent.ModelRequestEnded         => "end"
  case TurnEvent.TransientError(_, _)      => "transient"
  case TurnEvent.AssistantChunk(text)      => "chunk:\{text}"
  case TurnEvent.AssistantStreamReset      => "reset"
  case TurnEvent.AssistantMessage(text)    => "assistant:\{text}"
  case TurnEvent.ToolBudgetReached(_)      => "budget"
  case TurnEvent.ToolCallStarted(n)        => "tool+\{n}"
  case TurnEvent.ToolCallEnded(n, _)       => "tool-\{n}"
  case TurnEvent.ContextCompacted(_)       => "compact"

// The turn's outcome and its visible text, as one tag. `Answered(x)` is kept as
// the wording so the expectations still read as "what did the turn say".
private def resultTag(t: TurnData): String =
  match t.result
  case TurnResult.Success        => "Answered(\{t.finalText})"
  case TurnResult.Interrupted    => "Interrupted"
  case TurnResult.Failed(detail) => "Failed(\{detail})"

private def joinPy(xs: py.List): String =
  var s = ""
  var i = 0
  while i < xs.size do
    if i > 0 then s = s + ","
    s = s + xs.get(i).asString
    i = i + 1
  s

// A test tool: the spec the model is offered, plus what its route runs.
private class TestTool(toolName: String, act: () => ToolOutcome receives logger)
  view Tool

  def name: String = toolName
  def description: String = "test tool"
  def params: List[ToolParam] = []
  def run(): ToolOutcome receives logger = act()
end

// A set of test tools, wired as the engine wants them.
private def toolsetOf(tools: List[TestTool]): Toolset =
  var out = Toolset.empty
  for t in tools do out = out.add: t, (i: ToolInput, channel: Interact) => t.run()
  out

// A trivial tool that always succeeds, for exercising the tool-call path.
private def echoTool(): TestTool =
  new TestTool("echo", () => new ToolOutcome("echoed", "echo · ran", []))

// A tool that raises instead of returning — the engine must contain it via
// `runSafely` and keep the turn going.
private def boomTool(): TestTool =
  new TestTool("boom", () => abort "kaboom")

private class CaptureLogger
  view Logger

  var events: List[String] = []
  var entries: List[Entry] = []

  def logEntry(entry: Entry): Unit =
    entries = entries + entry
    if entry.event == "harpe.turn.message" then
      val d = Entry.toDict(entry).get("fields", py.dict()).cast[py.Dict]
      val role = d.get("role", "").asString
      if role == "assistant" && d.get("calls", py.list()).cast[py.List].size > 0 then
        events = events + "assistant-calls"
      else if role == "assistant" then
        events = events + "assistant-text"
      else
        events = events + role
    else
      events = events + entry.event

  def close(): Unit = pass
end

private def loggingTool(): TestTool =
  new TestTool:
    "logged"
    () =>
      logger.log("tool-invoked")
      new ToolOutcome("done", "logged · ran", attachments = [])

private def failingLoggingTool(): TestTool =
  new TestTool:
    "logged"
    () =>
      logger.log("tool-failed")
      abort "tool failure"

// Interrupt fakes — no threads, no real sleeping, so the engine's cancellation
// paths are testable deterministically.
private class TestInteract(state: State)
  view Interact

  val log = py.list()

  def emit(event: TurnEvent): Unit = log.append: eventTag(event)

  def cancelled: Bool = state.cancelledNow

  def pause(seconds: Float): Bool =
    state.pausedFor = seconds
    state.pauseNow

  def approve(title: String, detail: String): Approvals.Decision = Approvals.Cancelled
end

private class State(cancelled: Bool, pause: Bool)
  var cancelledNow: Bool = cancelled
  var pauseNow: Bool = pause
  var pausedFor: Float = -1.0
end

// Drive one turn and summarize it as "<result> | <events>". The agent's brain is
// the no-network echo model — the scripted TestInteract.ask never touches it.
private def scenario(tools: List[TestTool], maxToolRounds: Int, maxRetries: Int, model: Model, state: State): String receives logger =
  val channel = new TestInteract(state)
  val context = new WindowedContext("", [])
  val res =
    Agent.ask:
        "dummy message"
        brain = model
        tools = toolsetOf(tools)
        context = context
        maxToolRounds = maxToolRounds
        maxRetries = maxRetries
        interact = channel
  "\{resultTag(res)} | \{joinPy(channel.log)}"

private def msgTag(m: Message): String =
  match m
  case UserInput(_, _) => "user"
  case Assistant(_, calls) => if calls.isEmpty then "text" else "calls"
  case ToolResults(_) => "results"

private def tools(): List[TestTool] = [echoTool()]

private def live(): State = State(cancelled = false, pause = false)

private class TestModel(
    start: (Rendered, Int) => (List[ToolResult], List[Tool], Interact) => ReplyResult)
  view Model

  def name: String = "test-model"
  def provider: String = "test"
  def startTurn(base: Rendered, maxOutputTokens: Int): Session =
    new TestSession(this, start(base, maxOutputTokens))
end

private class TestSession(
    owner: Model,
    respond: (List[ToolResult], List[Tool], Interact) => ReplyResult)
  view Session

  def model: Model = owner
  def reply(results: List[ToolResult], tools: List[Tool], interact: Interact): ReplyResult =
    respond(results, tools, interact)
end

private def testModel(
    start: (Rendered, Int) => (List[ToolResult], List[Tool], Interact) => ReplyResult)
: Model =
  new TestModel(start)

def turnSuite(): Unit receives thisSuite, logger = suite: "turn engine", () =>
  suite: "ending a turn", () =>
    test: "a plain text reply ends it immediately", () =>
      checkEquals:
        "text answer"
        scenario:
          tools()
          maxToolRounds = 50
          maxRetries = 4
          model = testModel((base, maxOut) => (results, tools, interact) => textReply("hi"))
          state = live()
        expected = "Answered(hi) | start,end"

    // The per-turn counter lives in `startTurn`, so it is fresh for each turn.
    test: "runs one tool, then the next text reply ends it", () =>
      val askB: Model = testModel: (base, maxOut) =>
        val stepB = py.list(0)
        (results, tools, interact) =>
          val n = stepB.get(0).asInt
          stepB.set(0, n + 1)
          if n == 0 then toolReply("echo") else textReply("done")

      checkEquals:
        "tool then text"
        scenario: tools(), 50, 4, askB, live()
        expected = "Answered(done) | start,end,tool+echo,tool-echo,start,end"

    // Once the budget is spent the model is re-asked with no tools and must
    // answer with text. The scripted model returns text only when offered none.
    test: "spends its tool budget, then must answer with text", () =>
      val askC: Model = testModel: (base, maxOut) => (results, tools, interact) =>
        if tools.isEmpty then textReply("final") else toolReply("echo")

      checkEquals:
        "tool budget"
        scenario: tools(), 1, 4, askC, live()
        expected = "Answered(final) | start,end,tool+echo,tool-echo,budget,start,end"

    // Everything but the brain defaulted. The model still sees the user's input
    // (a defaulted context holds the turn it is given), and two defaulted turns
    // do not share a transcript (the default is evaluated per call). A shared
    // context would report "1,2".
    test: "a defaulted turn is self-contained", () =>
      val sizes = py.list("")
      val askN: Model = testModel: (base, maxOut) =>
        val prev = sizes.get(0).asString
        sizes.set(0, if prev == "" then "\{base.messages.size}" else prev + ",\{base.messages.size}")
        (results, tools, interact) => textReply("ok")

      val n1 = Agent.ask("first", brain = askN)
      val n2 = Agent.ask("second", brain = askN)
      checkEquals:
        "two defaulted turns"
        "\{resultTag(n1)} | \{resultTag(n2)} | \{sizes.get(0).asString}"
        expected = "Answered(ok) | Answered(ok) | 1,1"

  suite: "errors", () =>
    test: "a fatal error loses the turn", () =>
      checkEquals:
        "fatal"
        scenario:
          tools()
          maxToolRounds = 50
          maxRetries = 4
          model = testModel((base, maxOut) => (results, tools, interact) => Fatal("bad key"))
          state = live()
        expected = "Failed(bad key) | start,end"

    test: "logs a classified failure from the session's model", () =>
      val capture = new CaptureLogger
      with logger = capture in
        val _ = Agent.ask:
          "fail"
          brain = testModel((base, maxOut) => (results, tools, interact) => Fatal("HTTP 401 · bad key"))

      checkEquals:
        "failure order"
        capture.events.join(",")
        "user,harpe.model.send,harpe.model.failed,harpe.model.gaveUp,harpe.turn.failed"

      val fields = Entry.toDict(capture.entries.get(2)).get("fields").cast[py.Dict]
      checkEquals("provider from session model", fields.get("provider", "").asString, "test")
      checkEquals("name from session model", fields.get("model", "").asString, "test-model")

    // Only the provisional assistant/tool tail is rolled back.
    test: "a failed turn keeps its user message in the live context", () =>
      val failedContext = new WindowedContext("", [])
      val failedBrain: Model = testModel((base, maxOut) => (results, tools, interact) => Fatal("bad key"))
      val failedChannel = new TestInteract(live())
      val failedResult =
        Agent.ask:
          "keep me"
          brain = failedBrain
          tools = toolsetOf(tools())
          interact = failedChannel
          context = failedContext
      val messages = failedContext.compact(failedChannel).rendered.messages
      checkEquals:
        "retained"
        "\{resultTag(failedResult)} | \{messages.size} | \{msgTag(messages.get(0))}"
        expected = "Failed(bad key) | 1 | user"

    // A name nobody wired is answered rather than refused: the engine sends the
    // model an error result for it, and the turn goes on. What the model is
    // told has to name the tool, or it cannot correct itself.
    test: "answers a call to a tool nobody wired", () =>
      val toldU = py.list("")
      val refusedU = py.list(true)
      val askU: Model = testModel: (base, maxOut) =>
        val stepU = py.list(0)
        (results, tools, interact) =>
          val n = stepU.get(0).asInt
          stepU.set(0, n + 1)
          if n == 0 then toolReply("nosuch")
          else
            toldU.set(0, results.get(0).content)
            refusedU.set(0, results.get(0).success)
            textReply("recovered")

      checkEquals:
        "unknown tool continues"
        scenario: tools(), 50, 4, askU, live()
        expected = "Answered(recovered) | start,end,tool+nosuch,tool-nosuch,start,end"

      // The prose and the flag have to agree, or a driver reading its own output
      // back off the turn counts an invented name as work done.
      val refused = if refusedU.get(0).asBool then "no" else "yes"
      checkEquals:
        "what the model was told"
        "\{toldU.get(0).asString} | refused=\{refused}"
        expected = "Unknown tool: nosuch | refused=yes"

    // `runSafely` turns the exception into an error result the model sees, and
    // the next (text) reply ends the turn.
    test: "a tool that raises does not crash the turn", () =>
      val askJ: Model = testModel: (base, maxOut) =>
        val stepJ = py.list(0)
        (results, tools, interact) =>
          val n = stepJ.get(0).asInt
          stepJ.set(0, n + 1)
          if n == 0 then toolReply("boom") else textReply("recovered")

      checkEquals:
        "tool error continues"
        scenario: [boomTool()], 50, 4, askJ, live()
        expected = "Answered(recovered) | start,end,tool+boom,tool-boom,start,end"

  suite: "retries", () =>
    // No retry budget: give up immediately, with no backoff wait.
    test: "gives up at once when the budget is zero", () =>
      checkEquals:
        "retries exhausted"
        scenario:
          tools()
          maxToolRounds = 50
          maxRetries = 0
          model = testModel((base, maxOut) => (results, tools, interact) => Transient("rate limited"))
          state = live()
        expected = "Failed(rate limited) | start,end,reset"

    // With a fake Interrupt, `pause` returns instantly — no real 1s wait.
    test: "recovers after one transient failure", () =>
      val askG: Model = testModel: (base, maxOut) =>
        val stepG = py.list(0)
        (results, tools, interact) =>
          val n = stepG.get(0).asInt
          stepG.set(0, n + 1)
          if n == 0 then new Transient("blip") else textReply("recovered")

      checkEquals:
        "transient then success"
        scenario: tools(), 50, 2, askG, live()
        "Answered(recovered) | start,end,reset,transient,start,end"

    // A provider Retry-After hint overrides exponential backoff and is not
    // capped at the ordinary 30-second ceiling.
    test: "honours a provider Retry-After hint over its own backoff", () =>
      val retryAfterState = State(cancelled = false, pause = true)
      val retryAfterModel: Model = testModel:
        (base, maxOut) => (results, offered, interact) => RetryAfter("rate limited", 75.0)
      val _ = scenario: tools(), 50, 2, retryAfterModel, retryAfterState
      checkEquals("Retry-After delay", retryAfterState.pausedFor, 75.0)

  suite: "cancellation", () =>
    test: "bails before asking the model when already requested", () =>
      checkEquals:
        "cancelled before request"
        scenario:
          tools()
          50
          4
          testModel((base, maxOut) => (results, tools, interact) => toolReply("echo"))
          State(cancelled = true, pause = true)
        "Interrupted | "

    test: "discards a reply that arrives after cancelling", () =>
      val stateH2 = State(cancelled = false, pause = false)
      val askH2: Model = testModel: (base, maxOut) => (results, tools, interact) =>
        stateH2.cancelledNow = true
        textReply("too late")

      checkEquals:
        "cancelled after model"
        scenario: tools(), 50, 4, askH2, stateH2
        "Interrupted | start,end"

    test: "abandons the retry when cancelled during backoff", () =>
      checkEquals:
        "cancelled during backoff"
        scenario:
          tools()
          50
          4
          testModel((base, maxOut) => (results, tools, interact) => new Transient("blip"))
          State(cancelled = false, pause = true)
        "Interrupted | start,end,reset,transient"

  suite: "what the interaction sees", () =>
    test: "streams assistant chunks as they arrive", () =>
      val streamingModel: Model = testModel: (base, maxOut) =>
        (results, offered, interact) =>
          interact.emit: TurnEvent.AssistantChunk("rec")
          interact.emit: TurnEvent.AssistantChunk("overed")
          textReply("recovered")

      checkEquals:
        "streamed chunks"
        scenario: tools(), 50, 2, streamingModel, live()
        "Answered(recovered) | start,chunk:rec,chunk:overed,end"

    test: "delivers assistant text before the tool it accompanies starts", () =>
      val askM: Model = testModel: (base, maxOut) =>
        val step = py.list(0)
        (results, tools, interact) =>
          val n = step.get(0).asInt
          step.set(0, n + 1)
          if n == 0 then
            val call = ToolCall("id", "echo", ToolInput(py.dict()))
            Reply(Assistant("I will check.", [call]), used(0))
          else textReply("Done.")

      checkEquals:
        "assistant text before tool"
        scenario: tools(), 50, 4, askM, live()
        expected = "Answered(Done.) | start,end,assistant:I will check.,tool+echo,tool-echo,start,end"

  suite: "durability of the assistant message", () =>
    // The message containing a tool call must be durable before the tool begins.
    // The tool marker and the transcript records share one logger, making their
    // order observable without relying on wall-clock time.
    test: "is written before the tool it requested runs", () =>
      val capture = new CaptureLogger
      with logger = capture in
        val _ = Agent.ask:
          "dummy text"
          brain = toolThenText()
          tools = toolsetOf([loggingTool()])
          context = new WindowedContext("", [])
          interact = new TestInteract(live())

      checkEquals:
        "order"
        capture.events.join(",")
        expected = "user,harpe.model.send,harpe.model.replied,harpe.metering.usage,assistant-calls,tool-invoked,tool_results,harpe.model.send,harpe.model.replied,harpe.metering.usage,assistant-text,harpe.turn.answered"

    // A tool exception must not erase the assistant message that requested it.
    test: "survives the tool raising", () =>
      val capture = new CaptureLogger
      with logger = capture in
        val _ = Agent.ask:
          "dummy text"
          brain = toolThenText()
          tools = toolsetOf([failingLoggingTool()])
          context = new WindowedContext("", [])
          interact = new TestInteract(live())

      checkEquals:
        "order"
        capture.events.join(",")
        expected = "user,harpe.model.send,harpe.model.replied,harpe.metering.usage,assistant-calls,tool-failed,tool_results,harpe.model.send,harpe.model.replied,harpe.metering.usage,assistant-text,harpe.turn.answered"

  // Crossing the threshold after a completed tool round replaces the provider
  // session while preserving the tool effect and the logical turn.
  test: "compaction restarts the provider session mid-turn", () =>
    val calls = py.list(0)
    val starts = py.list(0)
    val counter = new TestTool:
      "count"
      () =>
        calls.set(0, calls.get(0).asInt + 1)
        new ToolOutcome("counted", "count · ran", [])
    val context = new SummarizingContext:
      "BASE"
      [UserInput("old", []), Assistant("old answer", [])]
      30
      1
      rendered => Some("COMPACTED")
    val brain: Model = testModel: (base, maxOut) =>
      starts.set(0, starts.get(0).asInt + 1)
      if base.system.contains("COMPACTED") then
        (results, offered, interact) => textReply("continued")
      else
        (results, offered, interact) => toolReplyWithUsage("count", 40)
    val channel = new TestInteract(live())
    val result =
      Agent.ask:
        "work"
        brain = brain
        tools = toolsetOf([counter])
        context = context
        interact = channel
    checkEquals:
      "compact restarts session"
      "\{resultTag(result)} | starts=\{starts.get(0).asInt} | calls=\{calls.get(0).asInt} | \{joinPy(channel.log)}"
      "Answered(continued) | starts=2 | calls=1 | start,end,tool+count,tool-count,compact,start,end"

// A model that asks for a tool once, then answers with text.
private def toolThenText(): Model = testModel: (base, maxOut) =>
  val step = py.list(0)
  (results, tools, interact) =>
    val n = step.get(0).asInt
    step.set(0, n + 1)
    if n == 0 then toolReply("logged") else textReply("done")
