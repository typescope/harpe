//[ SocketTest.jo
  !
  ! Unit test for `harpe.ffi.socket`: a Unix-domain socket round-trip (bind,
  ! listen, accept on a thread. Connect, send, recv on the main thread). This is
  ! the transport the broker is built on.
//]

namespace harpe.test.unit.SocketTest

import harpe.util.UnixSocket
import harpe.util.Process
import harpe.ffi.threading
import harpe.ffi.tempfile
import harpe.ffi.os
import harpe.test.framework.thisSuite
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check

def socketSuite(): Unit receives thisSuite = suite: "unix socket", () =>
  test: "round-trips a message", () =>
    val dir = tempfile.mkdtemp()
    val path = os.path.join(dir, "s.sock")

    val server = UnixSocket.open()
    server.bind(path)
    server.listen(1)

    // Server thread: accept one connection and echo its first message back.
    val serve = () =>
      val conn = UnixSocket.accept(server)
      conn.sendall(conn.recv(1024))
      conn.close()

    Process.daemon(serve).start()

    val client = UnixSocket.open()
    client.connect(path)
    client.sendall(py.dynamic("ping").callDynamic("encode", "utf-8"))

    val reply = client.recv(1024).callDynamic("decode", "utf-8").asString
    check("reply matches what was sent", reply == "ping")

    client.close()
    server.close()
