//[ FileSystemValidationTest.jo
  !
  ! Unit tests for portable relative paths accepted by `FileSystem.validate`.
//]

namespace harpe.test.unit.FileSystemValidationTest

import harpe.caps.*
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check

private def accepted(path: String): Bool = FileSystem.validate(path) is None

def validationSuite(): Unit receives testing = suite: "path validation", () =>
  test: "accepts portable relative paths", () =>
    check("root", accepted(""))
    check("file", accepted("file.txt"))
    check("nested path", accepted("docs/report.pdf"))

  test: "rejects paths that leave the root", () =>
    check("absolute", !accepted("/etc/passwd"))
    check("parent", !accepted(".."))
    check("nested parent", !accepted("docs/../secret"))
    check("current segment", !accepted("docs/./report"))

  test: "rejects unportable spellings", () =>
    check("empty segment", !accepted("docs//report"))
    check("trailing separator", !accepted("docs/"))
    check("backslash", !accepted("docs\\report"))
    check("Windows drive", !accepted("C:/secret"))

  test: "explains why a path is invalid", () =>
    check:
      "names the offending segment"
      FileSystem.validate("docs/../secret") is Some("path must not contain '..' segments")
