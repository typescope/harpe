//[ SkillsTest.jo
  !
  ! Tests for the read-only skill tools (`harpe.tools` skillsList / skillsRead /
  ! skillsSearch), with a focus on SECURITY: reads must stay confined to the
  ! skills directory, even when it has nested sub-directories and the caller uses
  ! `..` traversal, absolute paths, or a sibling directory whose name shares the
  ! skills dir as a prefix.
  !
  ! The fixture skills tree is built at runtime in a temp dir (with a secret file
  ! *outside* it), so the test is self-contained — no committed fixture files.
//]

namespace harpe.test.unit.SkillsTest

import harpe.ffi.os
import harpe.util.File
import harpe.ffi.tempfile
import harpe.*
import harpe.tools.*
import harpe.Tool.*
import harpe.logging.Logging
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check

// A no-op logger for the tool run. These tests assert on results, not logs.
private def listSkills(dir: String): String =
  with logger = Logging.discard in SkillTools.list(dir).result

private def readSkill(dir: String, name: String): String =
  with logger = Logging.discard in SkillTools.read(dir, name).result

private def searchSkills(dir: String, query: String): String =
  with logger = Logging.discard in SkillTools.search(dir, query).result

//[ Build the fixture tree and hand `body` its skills dir and the temp root
  !
  ! The secrets live OUTSIDE the skills dir, which is what the traversal tests
  ! try to reach. A directory SYMLINKED into the skills tree is deliberate
  ! sharing (that is how an agent surfaces reference material, e.g.
  ! skills/caps -> ../../caps), so the walk follows it and its files are ordinary
  ! nested skills.
//]
private def withSkills(body: (String, String) => Unit): Unit =
  val tmp = tempfile.mkdtemp()
  val skillsDir = os.path.join(tmp, "skills")
  File.ensureDir(os.path.join(skillsDir, "sub/deep"))
  File.write(os.path.join(skillsDir, "top.md"), "top content")
  File.write(os.path.join(skillsDir, "sub/nested.md"), "nested content")
  File.write(os.path.join(skillsDir, "sub/deep/leaf.jo"), "leaf content")

  File.write(os.path.join(tmp, "secret.txt"), "SECRET")
  // a sibling dir whose name has the skills dir as a prefix (boundary attack)
  File.ensureDir(os.path.join(tmp, "skills-evil"))
  File.write(os.path.join(tmp, "skills-evil/secret.md"), "EVIL")

  File.ensureDir(os.path.join(tmp, "shared"))
  File.write(os.path.join(tmp, "shared/ref.md"), "linked reference")
  os.symlink(os.path.join(tmp, "shared"), os.path.join(skillsDir, "linked"))

  body(skillsDir, tmp)

def skillsSuite(): Unit receives testing = suite: "skill tools", () =>
  test: "lists nested files, names carrying their sub-directory path", () =>
    withSkills: (skills, tmp) =>
      check:
        "listing"
        listSkills(skills) == "linked/ref.md\nsub/deep/leaf.jo\nsub/nested.md\ntop.md"

  test: "reads a deeply nested file", () =>
    withSkills: (skills, tmp) =>
      check("nested read", readSkill(skills, "sub/deep/leaf.jo") == "leaf content")

  test: "reads and searches through a symlinked directory", () =>
    withSkills: (skills, tmp) =>
      check("read", readSkill(skills, "linked/ref.md") == "linked reference")
      check("search", searchSkills(skills, "linked reference").contains("linked/ref.md:1:"))

  suite: "confinement", () =>
    test: "denies climbing out with ..", () =>
      withSkills: (skills, tmp) =>
        check("from the root", readSkill(skills, "../secret.txt").contains("Access denied"))
        check:
          "from a nested directory"
          readSkill(skills, "sub/deep/../../../secret.txt").contains("Access denied")

    test: "denies an absolute path outside the skills directory", () =>
      withSkills: (skills, tmp) =>
        check:
          "absolute"
          readSkill(skills, os.path.join(tmp, "secret.txt")).contains("Access denied")

    // Guards the path-boundary `/` check, not just a prefix match.
    test: "denies a sibling directory sharing the name prefix", () =>
      withSkills: (skills, tmp) =>
        check:
          "skills-evil"
          readSkill(skills, "../skills-evil/secret.md").contains("Access denied")

    test: "leaks no out-of-tree content through a denied read", () =>
      withSkills: (skills, tmp) =>
        check("no secret", !readSkill(skills, "../secret.txt").contains("SECRET"))

    test: "confines search to the skills directory", () =>
      withSkills: (skills, tmp) =>
        val hits = searchSkills(skills, "content")
        check("finds nested matches", hits.contains("sub/deep/leaf.jo:1: leaf content"))
        check("finds nothing outside", !hits.contains("SECRET") && !hits.contains("EVIL"))
