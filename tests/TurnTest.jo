//[ TurnTest.jo
  !
  ! Unit tests for the turn engine (`Agent.runTurn`). The engine is pure — its
  ! model call is an injected `Responder`, its output an injected `emit`, and its
  ! cancellation a plain event — so each scenario scripts a `Responder`, records
  ! the emitted `TurnEvent`s, and asserts the resulting `TurnResult` + event
  ! sequence. No network, no tty.
  !
  ! Each scenario is summarized as "<result> | <event,tags>" so the expectation
  ! is a single deterministic string (no timings).
//]

namespace harpe.test.TurnTest

import jo.IO.stdout
import harpe.*
import harpe.turns.*
import harpe.context.WindowedContext
import harpe.models.echo
import harpe.Model.*
import harpe.Tool.*
import harpe.logging.logger
import harpe.logging.Logger
import harpe.logging.Entry
import harpe.logging.entryDict


// A reply carrying only text (no tool calls).
private def textReply(s: String): ReplyResult =
  Reply(Assistant(s, []), new Usage(0, 0))

// A reply asking to call the named tool once.
private def toolReply(name: String): ReplyResult =
  val call = ToolCall: "id", name, ToolInput(py.dict())
  Reply(Assistant("", [call]), new Usage(0, 0))

private def eventTag(e: TurnEvent): String =
  match e
  case ModelRequestStarted(_, _) => "start"
  case ModelRequestEnded         => "end"
  case TransientError(_, _)      => "transient"
  case AssistantMessage(text)    => "assistant:\{text}"
  case ToolBudgetReached(_)      => "budget"
  case ToolCallStarted(n)        => "tool+\{n}"
  case ToolCallEnded(n, _)       => "tool-\{n}"
  case ContextCompacted(_)       => "compact"

// The turn's outcome and its visible text, as one tag. `Answered(x)` is kept as
// the wording so the expectations still read as "what did the turn say".
private def resultTag(t: TurnData): String =
  match t.result
  case Success        => "Answered(\{t.finalText})"
  case Interrupted    => "Interrupted"
  case Failed(detail) => "Failed(\{detail})"
  case _              => "None"

private def joinPy(xs: py.List): String =
  var s = ""
  var i = 0
  while i < xs.size do
    if i > 0 then s = s + ","
    s = s + xs.get(i).asString
    i = i + 1
  s

// A test tool: the spec the model is offered, plus what its route runs.
private class TestTool(toolName: String, act: () => RunOutcome receives logger)
  view Tool

  def name: String = toolName
  def description: String = "test tool"
  def params: List[ToolParam] = []
  def run(): RunOutcome receives logger = act()
end

// The specs and the routes for a set of test tools, as the engine wants them.
private def specsOf(tools: List[TestTool]): List[Tool] =
  var out: List[Tool] = List.empty[Tool]
  for t in tools do out = out + t
  out

private def routesOf(tools: List[TestTool]): Map[String, Handler] =
  var out: Map[String, Handler] = Map.empty[String, Handler]
  for t in tools do out = out ++ Map(t.name ~ ((i: ToolInput) => t.run()))
  out

// A trivial tool that always succeeds, for exercising the tool-call path.
private def echoTool(): TestTool =
  new TestTool("echo", () => new RunOutcome("echoed", "echo · ran", []))

// A tool that raises instead of returning — the engine must contain it via
// `runSafely` and keep the turn going.
private def boomTool(): TestTool =
  new TestTool("boom", () => abort "kaboom")

private class CaptureLogger
  view Logger

  var events: List[String] = []

  def logEntry(entry: Entry): Unit =
    if entry.category == "harpe.turn.message" then
      val d = entryDict(entry)
      val role = d.get("role", "").asString
      if role == "assistant" && d.get("calls", py.list()).cast[py.List].size > 0 then
        events = events + "assistant-calls"
      else if role == "assistant" then
        events = events + "assistant-text"
      else
        events = events + role
    else
      events = events + entry.category

  def close(): Unit = pass
end

private def loggingTool(): TestTool =
  new TestTool:
    "logged"
    () =>
      logger.log("tool-invoked")
      new RunOutcome("done", "logged · ran", [])

private def failingLoggingTool(): TestTool =
  new TestTool:
    "logged"
    () =>
      logger.log("tool-failed")
      abort "tool failure"

// Interrupt fakes — no threads, no real sleeping, so the engine's cancellation
// paths are testable deterministically.
private class TestInteract(state: State)
  view Interact

  val log = py.list()

  def emit(event: TurnEvent): Unit = log.append: eventTag(event)

  def cancelled: Bool = state.cancelledNow

  def pause(seconds: Float): Bool = state.pauseNow

  def approve(id: String, request: ApprovalRequest): ApprovalDecision = ApprovalCancelled
end

private class State(cancelled: Bool, pause: Bool)
  var cancelledNow: Bool = cancelled
  var pauseNow: Bool = pause
end

// Drive one turn and summarize it as "<result> | <events>". The agent's brain is
// the no-network echo model — the scripted TestInteract.ask never touches it.
private def scenario(tools: List[TestTool], maxToolRounds: Int, maxRetries: Int, model: Model, state: State): String receives logger =
  val channel = new TestInteract(state)
  val context = new WindowedContext("", new Memory, [])
  val agent = new Agent(model, specsOf(tools), context)
  val res =
    with interact = channel in
      agent.runTurn:
        UserText("dummy message", [])
        routesOf(tools)
        dataDir = ""
        maxToolRounds = maxToolRounds
        maxRetries = maxRetries
  "\{resultTag(res)} | \{joinPy(channel.log)}"

private def msgTag(m: Message): String =
  match m
  case UserText(_, _) => "user"
  case Assistant(_, calls) => if calls.isEmpty then "text" else "calls"
  case ToolResults(_) => "results"

private def check(label: String, actual: String, expected: String): Unit receives stdout =
  assert: actual == expected, "\{label}: expected [\{expected}] but got [\{actual}]"
  println "  ok \{label}"

def run(): Unit receives stdout, logger =
  val tools = [echoTool()]

  val live: State = State(cancelled = false, pause = false)

  // A plain text reply ends the turn immediately.
  check:
    "A text-answer"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 4
      model = (base, dir) => (results, tools) => textReply("hi")
      state = live
    expected = "Answered(hi) | start,end"

  // One tool call is run, then the next reply (text) ends the turn. The per-turn
  // counter lives in `startTurn`, so it is fresh for each turn.
  val askB: Model = (base, dir) =>
    val stepB = py.list(0)
    (results, tools) =>
      val n = stepB.get(0).asInt
      stepB.set(0, n + 1)
      if n == 0 then toolReply("echo") else textReply("done")

  check:
    "B tool-then-text"
    scenario: tools, 50, 4, askB, live
    expected = "Answered(done) | start,end,tool+echo,tool-echo,start,end"

  // Tool budget: once spent (maxToolRounds=1) the model is re-asked with no
  // tools and must answer with text. The scripted model returns text only when
  // offered no tools.
  val askC: Model = (base, dir) => (results, tools) =>
    if tools.isEmpty then textReply("final") else toolReply("echo")

  check:
    "C tool-budget"
    scenario: tools, 1, 4, askC, live
    expected = "Answered(final) | start,end,tool+echo,tool-echo,budget,start,end"

  // A fatal error loses the turn.
  check:
    "D fatal"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 4
      model = (base, dir) => (results, tools) => Fatal("bad key")
      state = live
    expected = "Failed(bad key) | start,end"

  // A failed turn retains its user message in the live context. Only the
  // provisional assistant/tool tail is rolled back.
  val failedContext = new WindowedContext("", new Memory, [])
  val failedAgent = new Agent((base, dir) => (results, tools) => Fatal("bad key"), specsOf(tools), failedContext)
  val failedChannel = new TestInteract(live)
  val failedResult =
    with interact = failedChannel in
      failedAgent.runTurn(UserText("keep me", []), routesOf(tools), "", 50, 4)
  val failedMessages = failedContext.render(failedChannel).messages
  check:
    "D failed user retained"
    "\{resultTag(failedResult)} | \{failedMessages.size} | \{msgTag(failedMessages.get(0))}"
    "Failed(bad key) | 1 | user"

  // Transient with no retry budget (maxRetries=0) gives up immediately — no
  // backoff wait.
  check:
    "F retries-exhausted"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 0
      model = (base, dir) => (results, tools) => Transient("rate limited")
      state = live
    expected = "Failed(rate limited) | start,end"

  // Transient once, then success: exercises the backoff + retry path. With a
  // fake Interrupt, `pause` returns instantly — no real 1s wait.
  val askG: Model = (base, dir) =>
    val stepG = py.list(0)
    (results, tools) =>
      val n = stepG.get(0).asInt
      stepG.set(0, n + 1)
      if n == 0 then new Transient("blip") else textReply("recovered")

  check:
    "G transient-then-success"
    scenario: tools, 50, 2, askG, live
    "Answered(recovered) | start,end,transient,start,end"

  // Cancellation already requested → the turn bails before asking the model.
  check:
    "H cancelled-before-request"
    scenario: tools, 50, 4, (base, dir) => (results, tools) => toolReply("echo"), State(cancelled = true, pause = true)
    "Interrupted | "

  // Cancellation while a blocking model call is in flight discards the reply,
  // even if it is a complete text answer.
  val stateH2 = State(cancelled = false, pause = false)
  val askH2: Model = (base, dir) => (results, tools) =>
    stateH2.cancelledNow = true
    textReply("too late")

  check:
    "H2 cancelled-after-model"
    scenario: tools, 50, 4, askH2, stateH2
    "Interrupted | start,end"

  // Cancellation fires during the backoff pause → the retry is abandoned.
  check:
    "I cancelled-during-backoff"
    scenario: tools, 50, 4, (base, dir) => (results, tools) => new Transient("blip"), State(cancelled = false, pause = true)
    "Interrupted | start,end,transient"

  // A tool that raises does NOT crash the turn: `runSafely` turns the exception
  // into an error result the model sees, and the next (text) reply ends the turn.
  val askJ: Model = (base, dir) =>
    val stepJ = py.list(0)
    (results, tools) =>
      val n = stepJ.get(0).asInt
      stepJ.set(0, n + 1)
      if n == 0 then toolReply("boom") else textReply("recovered")

  check:
    "J tool-error-continues"
    scenario: [boomTool()], 50, 4, askJ, live
    expected = "Answered(recovered) | start,end,tool+boom,tool-boom,start,end"

  // The assistant message containing a tool call must be durable before the tool
  // begins. The tool marker and transcript records share one logger, making their
  // order observable without relying on wall-clock time.
  val askK: Model = (base, dir) =>
    val step = py.list(0)
    (results, tools) =>
      val n = step.get(0).asInt
      step.set(0, n + 1)
      if n == 0 then toolReply("logged") else textReply("done")

  val capture = new CaptureLogger
  val toolsK = [loggingTool()]
  val agentK = new Agent(askK, specsOf(toolsK), new WindowedContext("", new Memory, []))
  with logger = capture, interact = new TestInteract(live) in
    val _ = agentK.runTurn(UserText("dummy text", []), routesOf(toolsK), "", 50, 4)

  check:
    "K message-logged-before-tool"
    capture.events.join(",")
    expected = "harpe.turn.started,assistant-calls,tool-invoked,tool_results,assistant-text,harpe.turn.answered"

  // A tool exception must not erase the assistant message that requested it.
  // `runSafely` converts the exception into tool results and the turn continues.
  val captureFailure = new CaptureLogger
  val toolsL = [failingLoggingTool()]
  val agentL = new Agent(askK, specsOf(toolsL), new WindowedContext("", new Memory, []))
  with logger = captureFailure, interact = new TestInteract(live) in
    val _ = agentL.runTurn(UserText("dummy text", []), routesOf(toolsL), "", 50, 4)

  check:
    "L message-kept-when-tool-fails"
    captureFailure.events.join(",")
    expected = "harpe.turn.started,assistant-calls,tool-failed,tool_results,assistant-text,harpe.turn.answered"

  // Visible assistant text accompanying a tool request reaches the interaction
  // before the tool starts.
  val askM: Model = (base, dir) =>
    val step = py.list(0)
    (results, tools) =>
      val n = step.get(0).asInt
      step.set(0, n + 1)
      if n == 0 then
        val call = ToolCall("id", "echo", ToolInput(py.dict()))
        Reply(Assistant("I will check.", [call]), new Usage(0, 0))
      else textReply("Done.")

  check:
    "M assistant-text-before-tool"
    scenario: tools, 50, 4, askM, live
    expected = "Answered(Done.) | start,end,assistant:I will check.,tool+echo,tool-echo,start,end"
