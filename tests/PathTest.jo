//[ PathTest.jo
  !
  ! Unit test for `harpe.media.Path`: building paths with `/`, symbolic rendering, and
  ! the construction-time segment validation that makes an invalid path impossible.
//]

namespace harpe.test.PathTest

import harpe.media.*

import jo.IO.stdout

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

// True if building the path raises (an invalid segment).
private def rejected(build: () => Path): Bool =
  match py.try(build())
  case Ok(_)  => false
  case Err(_) => true

def run(): Unit receives stdout =
  val root: Path = Path.root

  check("build + render", (root / "docs" / "report.pdf").toString == "/docs/report.pdf")
  check("root renders empty", root.toString == "")

  check("accepts a normal name", !rejected(() => root / "file.txt"))
  check("rejects ..",            rejected(() => root / ".."))
  check("rejects .",             rejected(() => root / "."))
  check("rejects separator",     rejected(() => root / "a/b"))
  check("rejects empty",         rejected(() => root / ""))
  check("rejects deep escape",   rejected(() => root / "ok" / ".."))
