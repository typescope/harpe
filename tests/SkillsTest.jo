//[ SkillsTest.jo
  !
  ! Tests for the read-only skill tools (`harpe.tools` skillsList / skillsRead /
  ! skillsSearch), with a focus on SECURITY: reads must stay confined to the
  ! skills directory, even when it has nested sub-directories and the caller uses
  ! `..` traversal, absolute paths, or a sibling directory whose name shares the
  ! skills dir as a prefix.
  !
  ! The fixture skills tree is built at runtime in a temp dir (with a secret file
  ! *outside* it), so the test is self-contained — no committed fixture files.
//]

namespace harpe.test.SkillsTest
import harpe.ffi.os
import harpe.ffi.tempfile
import harpe.ffi.file

import jo.IO.stdout
import harpe.*
import harpe.tools.*
import harpe.Tool.*
import harpe.logging.Logging
import harpe.logging.logger


// A no-op logger for the tool run. These tests assert on results, not logs.
private def listSkills(skills: SkillTools): String =
  with logger = Logging.discard in skills.list().result

private def readSkill(skills: SkillTools, name: String): String =
  with logger = Logging.discard in skills.read(name).result

private def searchSkills(skills: SkillTools, query: String): String =
  with logger = Logging.discard in skills.search(query).result

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "skills: \{label} failed"
  println "  ok \{label}"

def run(): Unit receives stdout =
  // Build a nested skills tree, plus secrets that live OUTSIDE it.
  val tmp = tempfile.mkdtemp()
  val skillsDir = os.path.join(tmp, "skills")
  os.makedirs(os.path.join(skillsDir, "sub/deep"))
  file.write(os.path.join(skillsDir, "top.md"), "top content")
  file.write(os.path.join(skillsDir, "sub/nested.md"), "nested content")
  file.write(os.path.join(skillsDir, "sub/deep/leaf.jo"), "leaf content")
  // outside the skills dir
  file.write(os.path.join(tmp, "secret.txt"), "SECRET")
  // a sibling dir whose name has the skills dir as a prefix (boundary attack)
  os.makedirs(os.path.join(tmp, "skills-evil"))
  file.write(os.path.join(tmp, "skills-evil/secret.md"), "EVIL")

  // A directory SYMLINKED into the skills tree is deliberate sharing (that is how
  // an agent surfaces reference material, e.g. skills/caps -> ../../caps), so the
  // walk follows it and its files are ordinary nested skills.
  os.makedirs(os.path.join(tmp, "shared"))
  file.write(os.path.join(tmp, "shared/ref.md"), "linked reference")
  os.symlink(os.path.join(tmp, "shared"), os.path.join(skillsDir, "linked"))

  val tools = new SkillTools(skillsDir)

  // Listing surfaces nested files, names carrying their sub-directory path —
  // including files inside a symlinked directory.
  check("list-nested", listSkills(tools) == "linked/ref.md\nsub/deep/leaf.jo\nsub/nested.md\ntop.md")

  // A legitimate read of a deeply nested file works.
  check("read-nested", readSkill(tools, "sub/deep/leaf.jo") == "leaf content")

  // Files behind the symlink read and search like any other skill.
  check("read-symlinked", readSkill(tools, "linked/ref.md") == "linked reference")
  check("search-symlinked", searchSkills(tools, "linked reference").contains("linked/ref.md:1:"))

  // --- security: no read outside the skills directory ---

  // `..` climbing out of the skills dir is denied.
  check("deny-parent", readSkill(tools, "../secret.txt").contains("Access denied"))

  // `..` from within nested sub-directories, climbing past the root, is denied.
  check("deny-nested-parent", readSkill(tools, "sub/deep/../../../secret.txt").contains("Access denied"))

  // An absolute path outside the skills dir is denied.
  check("deny-absolute", readSkill(tools, os.path.join(tmp, "secret.txt")).contains("Access denied"))

  // A sibling dir whose name starts with the skills dir name must NOT be
  // reachable (guards the path-boundary `/` check, not just a prefix match).
  check("deny-sibling-prefix", readSkill(tools, "../skills-evil/secret.md").contains("Access denied"))

  // The out-of-tree content never leaks through a denied read.
  check("no-secret-leak", !readSkill(tools, "../secret.txt").contains("SECRET"))

  // Search is likewise confined to the skills dir: it finds nested matches and
  // never the secrets outside it.
  val hits = searchSkills(tools, "content")
  check("search-nested", hits.contains("sub/deep/leaf.jo:1: leaf content"))
  check("search-confined", !hits.contains("SECRET") && !hits.contains("EVIL"))
