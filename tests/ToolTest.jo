//[ ToolTest.jo
  !
  ! Unit tests for the tool layer (`harpe.tools`): the typed `ToolInput`
  ! accessors and their fallbacks, the parameter constructors, and `runSafely` —
  ! the backstop that turns a throwing tool into an error `RunOutcome` instead of
  ! letting it crash a turn.
//]

namespace harpe.test.ToolTest
import harpe.ffi.os
import harpe.ffi.tempfile

import jo.IO.stdout
import harpe.tools.*
import harpe.Tool.*
import harpe.*
import harpe.logging.logger

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

private def rep(c: String, n: Int): String =
  var s = ""
  var i = 0
  while i < n do
    s = s + c
    i = i + 1
  s

private def toolNamed(ts: List[Tool], name: String): Tool =
  ts.find(t => t.name == name) rescue None => abort "no tool named \{name}"

def run(): Unit receives stdout, logger, interact =
  // --- typed ToolInput accessors read values of each schema type ---
  val full = ToolInput(py.dict("s" ~ "hi", "n" ~ 42, "b" ~ true, "f" ~ 3.5))
  check("string reads a string", full.string("s") == "hi")
  check("int reads an integer", full.int("n") == 42)
  check("bool reads a boolean", full.bool("b") == true)
  check("num reads a number", full.num("f") == 3.5)
  check("indexing reads a string", full["s"] == "hi")

  // --- missing keys fall back: explicit fallback, then bare defaults ---
  val empty = ToolInput(py.dict())
  check("stringOr fallback", empty.stringOr("x", "d") == "d")
  check("intOr fallback", empty.intOr("x", 7) == 7)
  check("boolOr fallback", empty.boolOr("x", true) == true)
  check("numOr fallback", empty.numOr("x", 1.5) == 1.5)
  check("string default is empty", empty.string("x") == "")
  check("int default is zero", empty.int("x") == 0)
  check("bool default is false", empty.bool("x") == false)
  check("num default is zero", empty.num("x") == 0.0)
  check("indexing default is empty", empty["x"] == "")

  // --- parameter constructors carry the right type, all required ---
  val sp = strParam("a", "d")
  val ip = intParam("a", "d")
  val bp = boolParam("a", "d")
  val np = numParam("a", "d")
  check("strParam type", sp.paramType is StrParam)
  check("intParam type", ip.paramType is IntParam)
  check("boolParam type", bp.paramType is BoolParam)
  check("numParam type", np.paramType is NumParam)
  check("constructed params are required", sp.required && ip.required && bp.required && np.required)

  // --- runSafely: a normal handler's outcome passes through unchanged ---
  val okOut = runSafely("ok", input => new RunOutcome("done", "ran", attachments = []), empty)
  check("runSafely passes success through", okOut.result == "done" && okOut.summary == "ran")

  // --- runSafely: a throwing handler becomes an error RunOutcome, not a crash ---
  val badOut = runSafely("boom", input => abort "kaboom", empty)
  check("runSafely summary names the tool", badOut.summary == "error · boom")
  check("runSafely result carries the message", badOut.result.contains("kaboom"))

  // --- Toolset: tools accumulate, and wiring one name twice is caught as it is built ---
  val noop: Handler = (i: ToolInput) => new RunOutcome("x", "x", attachments = [])
  val spec = (n: String) => Tool(n, "a test tool", [])
  val two = Toolset.of(spec("alpha"), noop).add(spec("beta"), noop)
  check("tools accumulate", two.contains("alpha") && two.contains("beta"))
  check("tools report their names", two.names.size == 2)

  // The specs the model is offered come from the same entries as the handlers,
  // so a wired tool is offered and an offered tool is answered, by construction.
  check("specs match the wiring", two.specs.size == 2)
  check("specs keep wiring order", two.specs.get(0).name == "alpha")

  val merged = two ++ Toolset.of(spec("gamma"), noop)
  check("++ merges a group", merged.names.size == 3 && merged.contains("gamma"))

  match py.try(two.add(spec("alpha"), noop))
  case Ok(_)  => check("a name wired twice is rejected", false)
  case Err(e) => check("a name wired twice is rejected", e.message.contains("alpha"))

  match py.try(two ++ Toolset.of(spec("beta"), noop))
  case Ok(_)  => check("++ rejects a clash too", false)
  case Err(e) => check("++ rejects a clash too", e.message.contains("beta"))

  // --- elide: bound a large tool result, keeping head + tail ---
  check("elide leaves short text unchanged", elide("hello", 100) == "hello")
  check("elide leaves at-limit text unchanged", elide("abcde", 5) == "abcde")

  val big = rep("a", 100) + rep("b", 100)
  val small = elide(big, 100)
  check("elide shrinks oversized text", small.size < big.size)
  check("elide keeps the head", small.startsWith("a"))
  check("elide keeps the tail", small.endsWith("b"))
  check("elide marks the omission", small.contains("100 characters elided"))
