//[ RunCodeTest.jo
  !
  ! Integration tests for the `runCode` tool (`harpe.tools`). Unlike the pure
  ! `runTurn` tests, `runCode` actually compiles and runs a guest program, so
  ! these drive `runCodeTool` against an on-disk sandbox fixture
  ! (`sandbox-fixtures/basic/`, kept outside the `tests/` source glob) and
  ! assert a normalized outcome tag — covering the host wall-clock timeout, the
  ! `sandbox/run.sh` seam, and provider-key env scrub end to end. They shell out
  ! to `jo build` + `python3`, so they are slower than the unit tests.
  !
  ! The fixture ships an executable `sandbox/run.sh`, so every run here goes
  ! through it. It is silent by default; with `HARPE_TEST_PROBE` set it echoes
  ! whether `ANTHROPIC_API_KEY` leaked into the child (it must not).
//]

namespace harpe.test.RunCodeTest
import harpe.ffi.os
import harpe.ffi.threading
import harpe.ffi.subprocess
import harpe.ffi.tempfile

import jo.IO.stdout
import harpe.*
import harpe.tools.runCodeTool
import harpe.logging.Logging
import harpe.logging.logger
import harpe.Tool.*

// Locate the sandbox fixture regardless of where `jo run test` is invoked from
// (the repo root or a subdirectory).
private def fixtureSandboxDir(): String =
  var found = ""
  for c in ["sandbox-fixtures/basic", "../sandbox-fixtures/basic"] do
    if found == "" && os.path.isdir(c) then found = c

  assert: found != "", "runCode tests: sandbox fixture not found under sandbox-fixtures/basic/"
  os.path.abspath(found)

// Map an outcome to a stable tag (raw summaries carry nondeterministic timings).
private def tag(o: RunOutcome): String =
  if o.summary.contains("timed out") then "timeout"
  else if o.summary.contains("did not compile") then "compile-error"
  else if o.summary.contains("crashed") then "crash"
  else if o.summary.contains("ran") then "ran"
  else "other"

// Self-provides a no-op logger, so it works on the spawned worker threads too
// (context params don't cross threads). These tests assert on outcomes, not logs.
private def exec(tool: Tool, code: String): RunOutcome =
  with logger = Logging.discard, callContext = CallContext.empty in tool.run(ToolInput(py.dict("code" ~ code)))

// Wrap a runTask body in a minimal guest program.
private def guest(body: String): String =
  "namespace sandbox.guest\nimport sandbox.api.*\n\ndef runTask(): Unit receives IO.stdout =\n" + body

// A guest program that also receives the `fs` (FileSystem) capability.
private def guestFs(body: String): String =
  "namespace sandbox.guest\nimport sandbox.api.*\n\ndef runTask(): Unit receives IO.stdout, fs =\n" + body

private def check(label: String, actual: String, expected: String): Unit receives stdout =
  assert: actual == expected, "\{label}: expected [\{expected}] but got [\{actual}]"
  println "  ok \{label}"

// Fire `n` runCode calls in parallel, each printing a distinct number, and assert
// every call gets back its OWN output. If concurrent runs shared one guest source
// or build dir, outputs would clobber and this would fail.
private def concurrentCheck(tool: Tool, n: Int): Unit receives stdout =
  val results = py.list()
  var i = 0
  while i < n do
    results.append(py.dynamic(""))
    i = i + 1

  val threads = py.list()
  var k = 0
  while k < n do
    val idx = k
    val worker = () => results.set(idx, py.dynamic(exec(tool, guest("  println \{idx}\n")).result))
    val t = threading.thread(worker)
    threads.append(t)
    t.start()
    k = k + 1

  for t in threads do t.join()

  // The fixture's run.sh prepends a marker line, so each result ends with — but
  // is not exactly — its own number; clobbering would leave the wrong number last.
  var j = 0
  var allOk = true
  while j < n do
    if !results.get(j).asString.endsWith("\n\{j}") then allOk = false
    j = j + 1

  assert: allOk, "concurrent-isolation: parallel runs clobbered each other's output"
  println "  ok concurrent-isolation"

def run(): Unit receives stdout =
  val sandboxDir = fixtureSandboxDir()

  // The tool replays the invocation recorded by `jo build`, so the fixture must be
  // built once up front (the user's normal one-time prep).
  val prep = subprocess.runCapped(py.list("jo", "build", "--spec", os.path.join(sandboxDir, "jo.toml"), "guest"), 180.0)
  assert: !prep.timedOut && prep.returnCode == 0, "runCode tests: failed to pre-build the sandbox fixture:\n\{prep.err}"

  // An unbuilt sandbox reports clearly instead of building or running anything.
  val unbuilt = tempfile.mkdtemp()
  check("not-built", exec(runCodeTool(unbuilt), guest("  println 1\n")).summary, "sandbox not built")

  val fast  = runCodeTool(sandboxDir, 120.0, 5.0)   // 5s run backstop
  val quick = runCodeTool(sandboxDir, 120.0, 2.0)   // 2s run backstop

  // A well-formed program runs and produces output.
  check("normal", tag(exec(fast, guest("  println 42\n"))), "ran")

  // The FileSystem capability reaches the guest: it reads its own run dir (which holds
  // the compiled out.py) through the granted `fs`.
  val fsOut = exec(fast, guestFs("  println fs.exists(fs.root / \"out.py\")\n")).result
  assert: fsOut.contains("true"), "filesystem capability: guest could not read its run dir — got [\{fsOut}]"
  println "  ok filesystem-capability"

  // Concurrent runs are isolated: 4 parallel programs, 2 building at a time,
  // each must get back its own output (no shared Task.jo / .build clobbering).
  concurrentCheck(runCodeTool(sandboxDir, 120.0, 5.0, 2), 4)

  // A program that does not type-check is caught at the compile checkpoint.
  check("compile-error", tag(exec(fast, guest("  println undefinedThing\n"))), "compile-error")

  // An infinite loop is killed by the host wall-clock timeout.
  check("host-timeout", tag(exec(quick, guest("  var i = 0\n  while i >= 0 do i = i + 1\n"))), "timeout")

  // The run.sh seam is honored and the child env is scrubbed: the guest runs with
  // a minimal PATH-only environment, so a planted host secret comes back empty in
  // the wrapper's marker line, and the program still runs through the wrapper.
  os.environ.set("ANTHROPIC_API_KEY", "SECRET-should-not-leak")
  val probed = exec(fast, guest("  println 42\n")).result
  assert: probed.contains("harpe-run-sh key=[]"), "env-scrub: host secret leaked into the guest — got [\{probed}]"
  assert: probed.contains("42"), "run.sh seam: program output missing — got [\{probed}]"
  println "  ok run-sh-scrub"
