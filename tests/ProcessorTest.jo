//[ ProcessorTest.jo
  !
  ! Unit test for the format readers behind `FileSystem` — `openWord` (python-docx
  ! handle: paragraphs, outline), `openPDF` (pypdfium2 handle: pages, outline,
  ! metadata, page → image), `openWorkbook` (openpyxl handle: rows, dimensions) —
  ! wired through the ambient backend params, plus the separately granted
  ! `PillowImage` and OCR readers (`TesseractOcr`, `RapidOcr`).
//]

namespace harpe.test.ProcessorTest

import harpe.media.*
import harpe.caps.*
import harpe.ffi.tempfile
import harpe.ffi.file
import harpe.ffi.os

import jo.IO.stdout

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

private def isSize(s: ImageSize, w: Int, h: Int): Bool = s.width == w && s.height == h

// Build a `w`x`h` image at `path` with Pillow.
private def makeImage(path: String, w: Int, h: Int): Unit =
  val size = py.module("builtins").callDynamic("tuple", py.list(w, h))
  py.module("PIL.Image").callDynamic("new", "RGB", size).save(path)

// Build an image at `path` holding the text "HELLO HARPE 42", for OCR.
private def makeTextImage(path: String): Unit =
  val size = py.module("builtins").callDynamic("tuple", py.list(400, 80))
  val img = py.module("PIL.Image").callDynamic("new", "RGB", size, "white")
  val font = py.module("PIL.ImageFont").load_default(40)
  py.module("PIL.ImageDraw").Draw(img).text(py.tuple(20, 20), "HELLO HARPE 42", "black", font)
  img.save(path)

// Whether the Python module `name` is importable.
private def hasModule(name: String): Bool =
  match py.try(py.module(name))
  case Ok(_)  => true
  case Err(_) => false

// Build a blank `pages`-page PDF (100x100 points per page) at `path` with pypdfium2.
private def makeBlankPdf(path: String, pages: Int): Unit =
  val doc = py.module("pypdfium2").PdfDocument.callDynamic("new")
  var i = 0

  while i < pages do
    val _ = doc.new_page(100, 100)
    i = i + 1

  doc.save(path)

// Build a 2-page PDF at `path`: a 50x30 image on page 1, page 2 empty.
private def makeImagePdf(path: String): Unit =
  val pdfium = py.module("pypdfium2")
  val doc = pdfium.PdfDocument.callDynamic("new")
  val page = doc.new_page(200, 200)
  val _ = doc.new_page(200, 200)

  val size = py.module("builtins").callDynamic("tuple", py.list(50, 30))
  val pil = py.module("PIL.Image").callDynamic("new", "RGB", size)
  val img = pdfium.PdfImage.callDynamic("new", doc)
  img.set_bitmap(pdfium.PdfBitmap.from_pil(pil))
  img.set_matrix(pdfium.PdfMatrix().scale(50, 30))

  page.insert_obj(img)
  page.gen_content()
  doc.save(path)

// Build a 4-paragraph docx at `path`: two headings, two body paragraphs.
private def makeDocx(path: String): Unit =
  val doc = py.module("docx").Document()
  val _ = doc.add_heading("Intro", level = 1)
  val _ = doc.add_paragraph("Body one.")
  val _ = doc.add_heading("Details", level = 2)
  val _ = doc.add_paragraph("Body two.")
  doc.save(path)

// Build a 2-sheet workbook at `path`: "Data" (header + 2 rows), "Notes" (1 cell).
private def makeXlsx(path: String): Unit =
  val wb = py.module("openpyxl").Workbook()
  val ws = wb.active
  ws.title = "Data"
  ws.append(py.list("name", "qty", "price"))
  ws.append(py.list("apple", 3, 1.5))
  ws.append(py.list("pear", 5, 2.25))

  val notes = wb.create_sheet("Notes")
  notes.append(py.list("hello"))
  wb.save(path)

// A handwritten 2-page PDF with an information dictionary and a 2-entry outline —
// pypdfium2 cannot author those, but PDFium parses this fixture fine.
private def outlinedPdf: String = """
  %PDF-1.4
  1 0 obj << /Type /Catalog /Pages 2 0 R /Outlines 6 0 R >> endobj
  2 0 obj << /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 >> endobj
  3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] >> endobj
  4 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] >> endobj
  5 0 obj << /Title (Test Doc) /Author (Harpe) >> endobj
  6 0 obj << /Type /Outlines /First 7 0 R /Last 8 0 R /Count 2 >> endobj
  7 0 obj << /Title (Intro) /Parent 6 0 R /Next 8 0 R /Dest [3 0 R /Fit] >> endobj
  8 0 obj << /Title (Details) /Parent 6 0 R /Prev 7 0 R /Dest [4 0 R /Fit] >> endobj
  trailer << /Root 1 0 R /Info 5 0 R /Size 9 >>
  %%EOF
  """

def run(): Unit receives stdout =
  val dir = tempfile.mkdtemp()

  // Bind the format backends the `FileSystem` shortcuts read through.
  with
    pdfReader = new PdfiumReader(dir),
    excelReader = new OpenpyxlExcel(dir),
    excelWriter = new OpenpyxlWriter(dir),
    wordReader = new DocxReader(dir)
  in suite(dir)

private def suite(dir: String): Unit receives stdout, pdfReader, excelReader, excelWriter, wordReader =
  val root: Path = Path.root

  val fs: FileSystem = FileSystemImpl.local(dir)

  file.write(os.path.join(dir, "note.txt"), "not a real document")

  // Word via python-docx — paragraph windows and the heading outline.
  makeDocx(os.path.join(dir, "memo.docx"))
  check("openWord garbage is Err", fs.openWord(root / "note.txt").isErr)

  val memo = fs.openWord(root / "memo.docx").success
  check("Word.paragraphCount", memo.paragraphCount == 4)

  val toc = memo.outline
  check("Word.outline", toc.size == 2 && toc.get(0).title == "Intro" && toc.get(0).paragraph == 1)
  check("Word.outline levels", toc.get(0).level == 1 && toc.get(1).level == 2)

  val body = memo.paragraphs(2, 1)
  check("Word.paragraphs window", body.size == 1 && body.get(0) == "Body one.")
  check("Word.paragraphs past end reads short", memo.paragraphs(4, 10).size == 1)
  memo.close()

  // PDF via pypdfium2 — open once, traverse the handle.
  makeBlankPdf(os.path.join(dir, "doc.pdf"), 2)
  check("openPDF garbage is Err", fs.openPDF(root / "note.txt").isErr)
  check("openPDF missing is Err", fs.openPDF(root / "nope.pdf").isErr)

  val doc = fs.openPDF(root / "doc.pdf").success
  check("PDF.pageCount", doc.pageCount == 2)
  check("PDF.pageText runs", doc.pageText(1).isOk)   // blank → empty
  check("PDF.outline empty", doc.outline.size == 0)

  // Render a page to an image: 100x100 points at the default scale 2 → 200x200 px.
  check("PDF.pageImage", isSize(doc.pageImage(1, root / "p1.png").success, 200, 200))
  check("PDF.pageImage writes target", os.path.isfile(os.path.join(dir, "p1.png")))
  doc.close()
  doc.close()                        // idempotent
  check("PDF.close is safe", true)

  // Outline and metadata from the handwritten fixture.
  file.write(os.path.join(dir, "outlined.pdf"), outlinedPdf)
  val outlined = fs.openPDF(root / "outlined.pdf").success
  val headings = outlined.outline
  check("PDF.outline entries", headings.size == 2)

  val first = headings.get(0)
  check("PDF.outline title", first.title == "Intro" && first.page == 1 && first.level == 0)
  check("PDF.outline second", headings.get(1).page == 2)

  val info = outlined.metadata
  check("PDF.metadata Title", info.getOrElse("Title", "") == "Test Doc")
  check("PDF.metadata Author", info.getOrElse("Author", "") == "Harpe")
  check("PDF.metadata skips empty", info.getOrElse("Subject", "-") == "-")
  outlined.close()

  // Content profile: an image on page 1, an empty page 2.
  makeImagePdf(os.path.join(dir, "img.pdf"))
  val imgDoc = fs.openPDF(root / "img.pdf").success
  val withImage = imgDoc.pageContent(1)
  check("PDF.pageContent image", withImage.images == 1 && withImage.texts == 0)

  val empty = imgDoc.pageContent(2)
  check("PDF.pageContent empty", empty.images == 0 && empty.texts == 0 && empty.paths == 0)
  imgDoc.close()

  // Excel via openpyxl — open once, read sheet-wise.
  makeXlsx(os.path.join(dir, "table.xlsx"))
  check("openWorkbook garbage is Err", fs.openWorkbook(root / "note.txt").isErr)

  val book = fs.openWorkbook(root / "table.xlsx").success
  check("Workbook.sheets", book.sheets.size == 2 && book.sheets.get(0) == "Data" && book.sheets.get(1) == "Notes")

  val dims = book.dimensions("Data").getOrElse(() => new SheetSize(0, 0))
  check("Workbook.dimensions", dims.rows == 3 && dims.columns == 3)
  check("Workbook.dimensions unknown is None", book.dimensions("NoSuch") is None)

  val window = book.rows("Data", 2, 2).getOrElse(() => List.empty[List[String]])
  check("Workbook.rows window", window.size == 2 && window.get(0).get(0) == "apple" && window.get(0).get(1) == "3")
  check("Workbook.rows renders floats", window.get(1).get(2) == "2.25")
  check("Workbook.rows past end reads short", book.rows("Data", 3, 10).getOrElse(() => []).size == 1)
  check("Workbook.rows unknown is None", book.rows("NoSuch", 1, 1) is None)
  book.close()
  book.close()                       // idempotent
  check("Workbook.close is safe", true)

  // Writers: create from zero, then edit → save-as (transform).
  val built = excelWriter.create()
  built.addSheet("Out")
  check("builder appendRow", built.appendRow("Out", ["a", new IntCell(3), 2.25]))
  check("builder setCell", built.setCell("Out", 1, 2, new IntCell(7)))
  check("builder setCell unknown sheet", !built.setCell("NoSuch", 1, 1, 0.0))
  check("builder unknown sheet", !built.appendRow("NoSuch", ["x"]))
  check("builder save", built.save(root / "out.xlsx").isOk)
  val readBack = fs.openWorkbook(root / "out.xlsx").success
  check("built workbook reads back", readBack.dimensions("Out").getOrElse(() => new SheetSize(0, 0)).rows == 1)
  check("typed cells survive", readBack.rows("Out", 1, 1).getOrElse(() => []).get(0).get(2) == "2.25")
  check("setCell survives", readBack.rows("Out", 1, 1).getOrElse(() => []).get(0).get(1) == "7")

  val editor = excelWriter.edit(root / "out.xlsx").success
  val _ = editor.appendRow("Out", ["c", "d"])
  check("editor save-as", editor.save(root / "out2.xlsx").isOk)
  check("transform kept source", fs.openWorkbook(root / "out.xlsx").success.dimensions("Out").getOrElse(() => new SheetSize(0, 0)).rows == 1)
  check("transform grew target", fs.openWorkbook(root / "out2.xlsx").success.dimensions("Out").getOrElse(() => new SheetSize(0, 0)).rows == 2)

  makeImage(os.path.join(dir, "pic.png"), 30, 20)

  // Image pixel work via Pillow.
  val image: Image = new PillowImage(dir)
  check("Image.dimensions", isSize(image.dimensions(root / "pic.png").success, 30, 20))

  val meta = image.metadata(root / "pic.png").success
  check("Image.metadata format", meta.getOrElse("format", "") == "PNG")
  check("Image.metadata mode", meta.getOrElse("mode", "") == "RGB")

  // Fit 30x20 within a 15x15 box, aspect preserved → 15x10.
  check("Image.resize", isSize(image.resize(root / "pic.png", 15, 15, root / "small.png").success, 15, 10))
  check("Image.crop", isSize(image.crop(root / "pic.png", 5, 5, 10, 8, root / "part.png").success, 10, 8))

  check("Image.convert", isSize(image.convert(root / "pic.png", root / "pic.jpg").success, 30, 20))
  check("Image on missing is Err", image.dimensions(root / "nope.png").isErr)

  // OCR: Tesseract degrades gracefully when the system binary is absent; RapidOCR
  // reads real text when its package is installed.
  val tesseract: OCR = new TesseractOcr(dir)
  val tessResult = tesseract.text(root / "pic.png")
  check("OCR tesseract answers", tessResult.isOk || tessResult.isErr)

  if hasModule("rapidocr_onnxruntime") then
    makeTextImage(os.path.join(dir, "text.png"))
    val rapid: OCR = new RapidOcr(dir)
    check("OCR rapidocr reads text", rapid.text(root / "text.png").success.contains("HELLO"))
    check("OCR rapidocr blank", rapid.text(root / "pic.png").success == "")
