//[ CanvasTest.jo
  !
  ! Drives the `Canvas` capability end to end through the `PillowCanvas`
  ! backend: panel, title text, a stroked circle, the transform probe (one
  ! unit rect scaled into a bar), and three alpha-blended disks. Writes a PNG
  ! to a temp dir and checks it exists and is non-empty.
//]

namespace harpe.test

import jo.IO.stdout
import harpe.caps.*
import harpe.caps.drawing.*
import harpe.media.*
import harpe.ffi.os
import harpe.ffi.tempfile

section CanvasTest
  def run(): Unit receives stdout =
    val dir = tempfile.mkdtemp()

    with graphics = new PillowGraphics(dir) in
      draw()
      poster()

    wrote("\{dir}/canvas.png")
    wrote("\{dir}/poster.png")

  private def wrote(path: String): Unit receives stdout =
    if os.path.exists(path) && os.path.getsize(path) > 0 then
      println "  canvas: wrote a \{os.path.getsize(path)}-byte PNG"
    else
      abort "canvas: no output at \{path}"

  private def draw(): Unit receives graphics =
    val cv = graphics.create(460, 260, Some(Color.white))

    with DrawingContext.fillColor = new Color(233, 238, 250) in
      cv.fill(Region.roundRect(20.0, 20.0, 420.0, 220.0, 14.0))

    with
      DrawingContext.font = Font.bold(26.0),
      DrawingContext.textColor = new Color(25, 35, 80)
    in
      cv.textAt(38.0, 62.0, "Canvas capability ✓")

    // an open Trace, stroked (no close)
    with
      DrawingContext.strokeColor = new Color(150, 160, 190),
      DrawingContext.lineWidth = 1.5
    in
      cv.stroke(Trace.from(38.0, 74.0).lineTo(300.0, 74.0))

    with
      DrawingContext.strokeColor = new Color(70, 90, 180),
      DrawingContext.lineWidth = 3.0
    in
      cv.stroke(Region.circle(92.0, 168.0, 46.0))

    // transform probe: a 1×1 unit rect scaled into a bar, then translated
    with
      DrawingContext.fillColor = new Color(70, 90, 180),
      DrawingContext.transform =
        Matrix.scale(230.0, 12.0).andThen(Matrix.translate(180.0, 108.0))
    in
      cv.fill(Region.rect(0.0, 0.0, 1.0, 1.0))

    disk(cv, 210.0, new Color(220, 60, 60))
    disk(cv, 250.0, new Color(60, 180, 90))
    disk(cv, 290.0, new Color(60, 90, 220))

    val root: Path = Path.root
    val _ = cv.save(root / "canvas.png")

  private def disk(cv: Canvas, cx: Float, color: Color): Unit =
    with
      DrawingContext.fillColor = color,
      DrawingContext.alpha = 0.45
    in
      cv.fill(Region.circle(cx, 196.0, 34.0))

  // --- flow: a centered title over two justified columns ---
  private def poster(): Unit receives graphics =
    val cv = graphics.create(520, 340, Some(Color.white))
    val title = new Rect(30.0, 24.0, 460.0, 44.0)
    val colL = new Rect(30.0, 92.0, 220.0, 228.0)
    val colR = new Rect(270.0, 92.0, 220.0, 228.0)

    // the title band is its own flow; the two columns are another
    with
      DrawingContext.font = Font.bold(26.0),
      DrawingContext.textColor = new Color(25, 35, 80),
      Typesetting.align = Align.center
    in
      with flow = Flow(cv, [title]) in flow.paragraph("The Box Calculus")

    with
      DrawingContext.font = Font.sans(11.0),
      DrawingContext.textColor = new Color(45, 45, 55),
      Typesetting.align = Align.justify
    in
      with flow = Flow(cv, [colL, colR]) in
        flow.paragraph(body())
        flow.space(6.0)
        flow.paragraph(body())

    val root: Path = Path.root
    val _ = cv.save(root / "poster.png")

  private def body(): String =
    "Everything already laid out is a box, rigid and measured, drawable "
      + "anywhere. A line is a row of boxes; a paragraph a stack of lines; a "
      + "page a stack of paragraphs. Layout is box algebra, and flexibility is "
      + "quarantined in the functions that turn flexible material into boxes."
end
