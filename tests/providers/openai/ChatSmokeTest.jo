//[ ChatSmokeTest.jo — OpenAI-compatible Chat Completions text streaming. //]

namespace harpe.test.providers.openai.ChatSmokeTest

import harpe.models.openai
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.providers.ProviderFixture
import harpe.test.providers.TurnAssertions

def smokeSuite(): Unit receives testing, logger = suite: "smoke", () =>
  test: "streams a text reply", () =>
    val response = """
      data: {
        "id": "chatcmpl_test", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
        "choices": [{"index":0,"delta":{"role":"assistant","content":"hel"},"finish_reason":null}],
        "usage": null
      }

      data: {
        "id": "chatcmpl_test", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
        "choices": [{"index":0,"delta":{"content":"lo"},"finish_reason":null}],
        "usage": null
      }

      data: {"id":"chatcmpl_test","object":"chat.completion.chunk","created":0,"model":"test-model","choices":[{"index":0,"delta":{},"finish_reason":"stop"}],"usage":null}

      data: {
        "id": "chatcmpl_test", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
        "choices": [],
        "usage": {
          "prompt_tokens": 4, "completion_tokens": 2, "total_tokens": 6,
          "prompt_tokens_details": {"cached_tokens":0}
        }
      }

      data: [DONE]
      """

    ProviderFixture.withSSE: response, server =>
      val model = openai.compatible("test-key", "test-model", server.baseUrl, timeoutSeconds = 2)
      TurnAssertions.checkTextReply(model = model, expectedInput = 4, expectedOutput = 2)
      TurnAssertions.check("path", server.path == "/v1/chat/completions")
      TurnAssertions.check("requests streaming", server.requestJson.get("stream").asBool)
