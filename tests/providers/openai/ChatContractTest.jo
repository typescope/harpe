//[ ChatContractTest.jo — stateful OpenAI-compatible Chat contracts. //]

namespace harpe.test.providers.openai.ChatContractTest

import harpe.models.openai
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.providers.ProviderFixture
import harpe.test.providers.TurnAssertions

private def model(server: ProviderFixture.Server) =
  openai.compatible("test-key", "test-model", server.baseUrl, timeoutSeconds = 2)

private def toolResponse(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0,
      "delta": {
        "role": "assistant",
        "tool_calls": [{
          "index": 0, "id": "call_1", "type": "function",
          "function": {"name":"lookup","arguments":"{\"city\":"}
        }]
      },
      "finish_reason": null
    }]
  }

  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0,
      "delta": {"tool_calls":[{"index":0,"function":{"arguments":"\"Zurich\"}"}}]},
      "finish_reason": null
    }]
  }

  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"tool_calls"}],
    "usage": {"prompt_tokens":6,"completion_tokens":3,"total_tokens":9}
  }

  data: [DONE]
  """

private def textResponse(text: String): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_text", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0, "delta": {"role":"assistant","content":"\{text}"}, "finish_reason": null
    }]
  }

  data: {
    "id": "chat_text", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"stop"}],
    "usage": {"prompt_tokens":8,"completion_tokens":1,"total_tokens":9}
  }

  data: [DONE]
  """

private def unavailable(): ProviderFixture.Response = ProviderFixture.response:
  "503 Service Unavailable"
  "application/json"
  """
    {"error":{"message":"unavailable","type":"server_error","code":"server_error"}}
    """

def contractSuite(): Unit receives testing, logger = suite: "contract", () =>
  test: "replays the assistant call and its result in messages", () =>
    ProviderFixture.withResponses: [toolResponse(), textResponse("done")], server =>
      TurnAssertions.checkToolRoundTrip(model = model(server))
      TurnAssertions.check("two requests", server.requestCount == 2)
      val first = server.recorded(0).jsonBody
      val second = server.recorded(1).jsonBody
      TurnAssertions.check("sends tool schema", first.get("tools").cast[py.List].size == 1)
      val messages = second.get("messages").cast[py.List]
      TurnAssertions.check:
        "retains assistant call"
        messages.size == 4 && messages.get(2).cast[py.Dict].contains("tool_calls")
      TurnAssertions.check:
        "sends tool result once"
        messages.get(3).cast[py.Dict].get("tool_call_id").asString == "call_1"

  test: "retry after 503 re-sends the same messages", () =>
    ProviderFixture.withResponses: [unavailable(), textResponse("hello")], server =>
      TurnAssertions.checkRetryThenText(model = model(server))
      val firstMessages = server.recorded(0).jsonBody.get("messages")
      val retryMessages = server.recorded(1).jsonBody.get("messages")
      TurnAssertions.check:
        "retry keeps semantic request"
        py.module("json").dumps(firstMessages, sort_keys = true).asString ==
          py.module("json").dumps(retryMessages, sort_keys = true).asString
