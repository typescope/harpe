//[ TurnAssertions.jo
  !
  ! Assertions and interaction recording shared by provider scenarios. Wire
  ! transcripts remain in their individual scenario files.
//]

namespace harpe.test.providers

import jo.IO.stdout
import harpe.Interact
import harpe.Approvals
import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.turns.TurnEvent
import harpe.logging.logger

section TurnAssertions
  def check(label: String, cond: Bool): Unit receives stdout =
    assert: cond, "\{label} failed"
    println "  ok \{label}"

  private class RecordingInteract
    view Interact

    var chunks: List[String] = []

    def cancelled: Bool = false
    def pause(seconds: Float): Bool = false
    def approve(request: Approvals.Request): Approvals.Decision = Approvals.Cancelled

    def emit(event: TurnEvent): Unit =
      if event is TurnEvent.AssistantChunk(text) then chunks = chunks + text
  end

  private def runModel(model: Model, interact: RecordingInteract): ReplyResult receives logger =
    val base = new Rendered("You are concise.", [UserInput("Say hello.", [])])
    model.startTurn(base, 32).reply([], [], interact)

  private def base(): Rendered =
    new Rendered("You are concise.", [UserInput("Say hello.", [])])

  def checkTextReply(
      label: String, model: Model,
      expectedInput: Int, expectedOutput: Int)
  : Unit receives stdout, logger =
    val interact = new RecordingInteract
    val result = runModel(model, interact)
    match result
    case Reply(message, usage) =>
      check("\{label} chunks", interact.chunks.size == 2 && interact.chunks.join("") == "hello")
      check("\{label} answer", message.text == "hello")
      check("\{label} no tool calls", message.calls.isEmpty)
      check("\{label} input usage", usage.inputTokens == expectedInput)
      check("\{label} output usage", usage.outputTokens == expectedOutput)
    case Transient(detail) => abort "\{label} unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "\{label} unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "\{label} unexpectedly fatal: \{detail}"

  def checkRetryAfter(label: String, model: Model, seconds: Float): Unit receives stdout, logger =
    val result = runModel(model, new RecordingInteract)
    match result
    case RetryAfter(detail, actual) =>
      check("\{label} classified rate limited", detail != "")
      check("\{label} retry-after", actual == seconds)
    case Transient(detail) => abort "\{label} omitted retry-after: \{detail}"
    case Fatal(detail) => abort "\{label} unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "\{label} unexpectedly succeeded"

  def checkTransient(label: String, model: Model): Unit receives stdout, logger =
    val result = runModel(model, new RecordingInteract)
    match result
    case Transient(detail) => check("\{label} classified transient", detail != "")
    case RetryAfter(detail, _) => abort "\{label} unexpectedly supplied retry-after: \{detail}"
    case Fatal(detail) => abort "\{label} unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "\{label} unexpectedly succeeded"

  def checkFatal(label: String, model: Model): Unit receives stdout, logger =
    val result = runModel(model, new RecordingInteract)
    match result
    case Fatal(detail) => check("\{label} classified fatal", detail != "")
    case Transient(detail) => abort "\{label} unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "\{label} unexpectedly rate limited: \{detail}"
    case Reply(_, _) => abort "\{label} unexpectedly succeeded"

  def checkToolRoundTrip(label: String, model: Model): Unit receives stdout, logger =
    val session = model.startTurn(base(), 32)
    val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])

    match session.reply([], [tool], new RecordingInteract)
    case Reply(message, _) =>
      check("\{label} one tool call", message.calls.size == 1)
      val call = message.calls.get(0)
      check("\{label} tool id", call.id == "call_1")
      check("\{label} tool name", call.name == "lookup")
      check("\{label} tool arguments", call.input.string("city") == "Zurich")
    case Transient(detail) => abort "\{label} tool call unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "\{label} tool call unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "\{label} tool call unexpectedly fatal: \{detail}"

    val result = ToolResult("call_1", "sunny", [])
    val interact = new RecordingInteract
    match session.reply([result], [tool], interact)
    case Reply(message, _) =>
      check("\{label} follow-up chunks", interact.chunks.join("") == "done")
      check("\{label} follow-up answer", message.text == "done")
      check("\{label} follow-up has no calls", message.calls.isEmpty)
    case Transient(detail) => abort "\{label} follow-up unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "\{label} follow-up unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "\{label} follow-up unexpectedly fatal: \{detail}"

  def checkRetryThenText(label: String, model: Model): Unit receives stdout, logger =
    val session = model.startTurn(base(), 32)
    match session.reply([], [], new RecordingInteract)
    case Transient(detail) => check("\{label} first attempt transient", detail != "")
    case RetryAfter(detail, _) => abort "\{label} first attempt unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "\{label} first attempt unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "\{label} first attempt unexpectedly succeeded"

    val interact = new RecordingInteract
    match session.reply([], [], interact)
    case Reply(message, _) =>
      check("\{label} retry chunks", interact.chunks.join("") == "hello")
      check("\{label} retry answer", message.text == "hello")
    case Transient(detail) => abort "\{label} retry unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "\{label} retry unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "\{label} retry unexpectedly fatal: \{detail}"
end
