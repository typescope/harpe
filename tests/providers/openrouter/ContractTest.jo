//[ ContractTest.jo — stateful OpenRouter Responses contracts. //]

namespace harpe.test.providers.openrouter.ContractTest

import harpe.models.openrouter
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.providers.ProviderFixture
import harpe.test.providers.TurnAssertions

private def model(server: ProviderFixture.Server) =
  openrouter("test-key", "test-model", baseUrl = server.baseUrl, timeoutSeconds = 2)

private def toolResponse(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "type": "response.completed", "sequence_number": 1,
    "response": {
      "id": "resp_tool", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "fc_1", "type": "function_call", "status": "completed",
        "arguments": "{\"city\":\"Zurich\"}", "call_id": "call_1", "name": "lookup"
      }],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":null,"summary":null}, "store": false,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 6, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 3, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 9
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def textResponse(text: String): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {"type":"response.output_text.delta","sequence_number":1,"item_id":"msg_done","output_index":0,"content_index":0,"delta":"\{text}","logprobs":[]}

  data: {
    "type": "response.completed", "sequence_number": 2,
    "response": {
      "id": "resp_done", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "msg_done", "type": "message", "status": "completed", "role": "assistant",
        "content": [{"type":"output_text","text":"\{text}","annotations":[],"logprobs":[]}]
      }],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":null,"summary":null}, "store": false,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 8, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 1, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 9
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def unavailable(): ProviderFixture.Response = ProviderFixture.response:
  "503 Service Unavailable"
  "application/json"
  """
    {"error":{"message":"unavailable","type":"server_error","code":"server_error"}}
    """

def contractSuite(): Unit receives testing, logger = suite: "contract", () =>
  test: "replays the call and result instead of chaining state", () =>
    ProviderFixture.withResponses: [toolResponse(), textResponse("done")], server =>
      TurnAssertions.checkToolRoundTrip(model = model(server))
      TurnAssertions.check("two requests", server.requestCount == 2)
      val first = server.recorded(0).jsonBody
      val second = server.recorded(1).jsonBody
      TurnAssertions.check("forces stateless mode", !first.get("store").asBool)
      TurnAssertions.check("sends tool schema", first.get("tools").cast[py.List].size == 1)
      val input = second.get("input").cast[py.List]
      TurnAssertions.check:
        "replays call and result"
        input.size == 3 && input.get(1).cast[py.Dict].get("type").asString == "function_call" &&
          input.get(2).cast[py.Dict].get("type").asString == "function_call_output"
      TurnAssertions.check("has no stored continuation", !second.contains("previous_response_id"))

  test: "retry after 503 re-sends the same input", () =>
    ProviderFixture.withResponses: [unavailable(), textResponse("hello")], server =>
      TurnAssertions.checkRetryThenText(model = model(server))
      val firstInput = server.recorded(0).jsonBody.get("input")
      val retryInput = server.recorded(1).jsonBody.get("input")
      TurnAssertions.check:
        "retry keeps semantic input"
        py.module("json").dumps(firstInput, sort_keys = true).asString ==
          py.module("json").dumps(retryInput, sort_keys = true).asString
