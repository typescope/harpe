//[ ProviderFixtureTest.jo — exercise the provider HTTP fixture itself. //]

namespace harpe.test.providers.ProviderFixtureTest

import jo.IO.stdout
import harpe.test.providers.ProviderFixture
import harpe.test.providers.TurnAssertions

def run(): Unit receives stdout =
  val first = new ProviderFixture.Response:
    "429 Too Many Requests"
    py.list:
      py.tuple("Content-Type", "application/json")
      py.tuple("Retry-After", "3")
    [
      """
      {"error":
      """,
      """
      "slow down"}
      """
    ]
  val second = ProviderFixture.response("201 Created", "text/plain", "accepted")

  ProviderFixture.withResponses: [first, second], server =>
    val http = py.module("http.client").HTTPConnection("127.0.0.1", server.port, timeout = 2)

    http.request:
      "POST"
      "/first?mode=test"
      """
        {"value":7}
        """
      py.dict("X-Test" ~ "fixture")
    val one = http.getresponse()
    TurnAssertions.check("fixture first status", one.status.asInt == 429)
    TurnAssertions.check("fixture response header", one.getheader("Retry-After").asString == "3")
    TurnAssertions.check:
      "fixture chunked body"
      one.read().decode().asString == """
        {"error":"slow down"}
        """

    http.request("GET", "/second")
    val two = http.getresponse()
    TurnAssertions.check("fixture second status", two.status.asInt == 201)
    TurnAssertions.check("fixture second body", two.read().decode().asString == "accepted")
    http.close()

    TurnAssertions.check("fixture records both requests", server.requestCount == 2)
    val asked = server.recorded(0)
    TurnAssertions.check("fixture records method", asked.method == "POST")
    TurnAssertions.check("fixture records path", asked.path == "/first")
    TurnAssertions.check("fixture records query", asked.query == "mode=test")
    TurnAssertions.check("fixture records header", asked.header("X-Test") == "fixture")
    TurnAssertions.check("fixture records JSON body", asked.jsonBody.get("value").asInt == 7)
