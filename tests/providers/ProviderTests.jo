//[ ProviderTests.jo — the provider test tree. //]

namespace harpe.test.providers.ProviderTests

import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.providers.ProviderFixtureTest
import harpe.test.providers.anthropic
import harpe.test.providers.openai
import harpe.test.providers.openrouter

//[ Compose the provider suites
  !
  ! Each suite names itself, so this file only decides what belongs under
  ! `providers` and in what order. A path here is what a filter matches:
  ! `jo run test -- providers/openai/chat` runs one protocol.
//]
def providerSuite(): Unit receives testing, logger = suite: "providers", () =>
  ProviderFixtureTest.fixtureSuite()
  anthropic.Tests.anthropicSuite()
  openai.Tests.openaiSuite()
  openrouter.Tests.openrouterSuite()
