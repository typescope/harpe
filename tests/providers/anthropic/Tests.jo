namespace harpe.test.providers.anthropic.Tests

import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.providers.anthropic.SmokeTest
import harpe.test.providers.anthropic.ContractTest
import harpe.test.providers.anthropic.FailureTest

def anthropicSuite(): Unit receives testing, logger = suite: "anthropic", () =>
