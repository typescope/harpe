//[ MediaTest.jo
  !
  ! Unit test for granted media under the host-staging model: `FileSystemProvider` is
  ! the host source (confined `resolve`/`copyTo`), the host stages a granted file into
  ! the shared dir, and the guest reads it back through `FileSystem` — no broker, no
  ! bytes over a socket. The guest-side `MediaProvider` view is inert (`None`/`false`).
//]

namespace harpe.test.MediaTest

import harpe.media.*
import harpe.caps.*
import harpe.ffi.tempfile
import harpe.ffi.file
import harpe.ffi.os

import jo.IO.stdout

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

private def isSome(o: Option[Media]): Bool =
  match o
  case Some(_) => true
  case None    => false

// Drain a file's lines into "a|b|c", closing it.
private def joinLines(f: TextFile): String =
  var s = ""
  for line in f.lines do
    s = if s == "" then line else s + "|" + line

  f.close()
  s

def run(): Unit receives stdout =
  // A source directory holding one "granted" file.
  val srcDir = tempfile.mkdtemp()
  file.write(os.path.join(srcDir, "granted.txt"), "BODY")
  val source = FileSystemProvider.byPath(srcDir)

  check("source resolves a confined file", isSome(source.resolve("granted.txt")))
  check("source rejects an escape",        !isSome(source.resolve("../etc/passwd")))
  check("source rejects a miss",           !isSome(source.resolve("nope.txt")))

  // resolve: a cheap descriptor without materializing, host path never exposed.
  match source.resolve("granted.txt")
  case None    => check("source describes a granted id", false)
  case Some(m) =>
    check("source describes a granted id", true)
    check("source reports name", m.fileName == "granted.txt")
    val sizeOk =
      match m.metaInt("sizeBytes")
      case Some(n) => n == 4
      case None    => false
    check("source reports size (from meta)", sizeOk)

  // Host-staging model: the host copies the granted file into the shared dir, then the
  // guest reads it back through a plain FileSystem — no broker.
  val scratch = tempfile.mkdtemp()
  val dest = os.path.join(scratch, "report.txt")
  check("host stages a granted id",   source.copyTo("granted.txt", dest))
  check("host refuses an ungranted",  !source.copyTo("nope.txt", os.path.join(scratch, "x.txt")))

  val fs = FileSystemImpl.local(scratch)
  check("guest sees the staged file", fs.exists(fs.root / "report.txt"))
  check("guest reads the content",    joinLines(fs.openTextFile(fs.root / "report.txt").success) == "BODY")
