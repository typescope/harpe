//[ Tests.jo
  !
  ! The `jo test` entry point for the `harpe` package. The [test] module is a
  ! single app, so every suite is declared into one tree here and walked by
  ! `Runner`, which reports each test and keeps going when one fails.
  !
  ! `unit` holds the tests of components this project owns. `integration` holds
  ! the ones that cross an ownership boundary: the provider suites encode a
  ! contract with a third party whose wire format can change without a line here
  ! changing, and `runCode` drives the real Jo toolchain and a real sandbox.
  ! `e2e` holds the ones that cross a PROCESS boundary: they build a shipped
  ! driver, run it, and drive it over its own HTTP API.
  !
  ! Order still matters — the fast unit suites first, then the slower boundary
  ! ones, with `runCode` last of those because it shells out to a sandbox build,
  ! and `e2e` after all of them, since it builds and starts a whole agent.
  !
  ! A path filter selects a subtree — `jo run test -- unit/context`, or
  ! `jo run test -- integration/openai/chat`.
//]

namespace harpe.test

import jo.IO.stdout
import harpe.logging.Logging
import harpe.logging.logger
import harpe.Interact
import harpe.test.framework.Testing
import harpe.test.framework.Runner
import harpe.test.framework.suite
import harpe.test.framework.thisSuite
import harpe.test.unit.SocketTest
import harpe.test.unit.BrokerTest
import harpe.test.unit.FileSystemValidationTest
import harpe.test.unit.FileSystemTest
import harpe.test.unit.InlineMediaTest
import harpe.test.unit.ProcessorTest
import harpe.test.unit.TurnTest
import harpe.test.unit.ToolTest
import harpe.test.unit.ContextTest
import harpe.test.unit.SkillsTest
import harpe.test.unit.TranscriptTest
import harpe.test.unit.LoggingTest
import harpe.test.integration.ProviderFixtureTest
import harpe.test.integration.anthropic
import harpe.test.integration.openai
import harpe.test.integration.openaiResponses
import harpe.test.integration.openrouter
import harpe.test.integration.RunCodeTest
import harpe.test.e2e.Driver
import harpe.test.e2e.WebTest
import harpe.test.e2e.CliTest

// Suites that drive tools/turns need `logger` in scope. Install a no-op one for
// the whole harness. It reaches a test wherever the runner runs it, parallel
// suites included: `define` below declares every body inside this scope, and a
// body carries what it captured. (RunCodeTest still self-provides, because the
// threads IT spawns are built inside a call that never discharged the effect.)
def main(): Unit receives stdout =
  with logger = Logging.discard in run()

private def run(): Unit receives stdout, logger =
  // `define` runs the declaration bodies, and each test body captures the scope
  // it is declared in — so this call has to sit inside `with logger`, not around
  // the `Runner.run` below it.
  val declared = Testing.define: "harpe", () => suites()
  val filter = Runner.filterFromArgs()

  // The runner has already printed what failed and where, so exit on that rather
  // than aborting and burying the report under a host traceback.
  val ok = Runner.run(declared, filter, Runner.lanesFromEnv())
  if !ok then py.module("sys").exit(1)
  println ""
  println "all harpe tests passed"

private def suites(): Unit receives framework.thisSuite, logger =
  suite: "unit", () =>
    SocketTest.socketSuite()
    BrokerTest.brokerSuite()
    FileSystemValidationTest.validationSuite()
    FileSystemTest.fileSystemSuite()
    InlineMediaTest.inlineMediaSuite()
    ProcessorTest.processorSuite()
    TurnTest.turnSuite()
    ToolTest.toolSuite()
    ContextTest.contextSuite()
    SkillsTest.skillsSuite()
    TranscriptTest.transcriptSuite()
    LoggingTest.loggingSuite()

  suite: "integration", () =>
    ProviderFixtureTest.fixtureSuite()
    anthropic.Tests.anthropicSuite()
    openai.Tests.openaiSuite()
    openaiResponses.Tests.openaiResponsesSuite()
    openrouter.Tests.openrouterSuite()
    RunCodeTest.runCodeSuite()

  // Parallel because these scenarios share nothing: each builds its own agent
  // home, binds its own port, and scripts its own model. What they DO share is
  // the driver underneath them, which `jo build` cannot produce twice at once —
  // so it is built here, before any of them runs.
  suite: "e2e", () =>
    thisSuite.parallel = true
    with e2e.published = false in suite: "source", () =>
      thisSuite.beforeSuite = () =>
          Driver.application("web").build()
          Driver.application("cli").build()

      thisSuite.parallel = true
      WebTest.webSuite()
      CliTest.cliSuite()

    with e2e.published = true in suite: "published", () =>
      thisSuite.beforeSuite = () =>
          Driver.application("web").build()
          Driver.application("cli").build()

      thisSuite.parallel = true
      WebTest.webSuite()
      CliTest.cliSuite()
