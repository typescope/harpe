//[ Tests.jo
  !
  ! The `jo test` entry point for the `harpe` package. The [test] module is a
  ! single app, so all suites are aggregated here: fast unit tests first
  ! (`TurnTest`), then the slower integration tests that shell out
  ! (`RunCodeTest`).
//]

namespace harpe.test

import jo.IO.stdout
import harpe.logging.Logging
import harpe.logging.logger
import harpe.CallContext
import harpe.callContext

// Suites that drive tools/turns need `logger` and `callContext` in scope; install
// no-op/empty ones for the whole harness (RunCodeTest self-provides on its worker
// threads, since context params do not cross thread boundaries).
def main(): Unit receives stdout =
  with logger = Logging.discard, callContext = CallContext.empty in suites()

private def suites(): Unit receives stdout, logger, callContext =
  println "unix socket (unit):"
  SocketTest.run()

  println "broker (unit):"
  BrokerTest.run()

  println "media path (unit):"
  PathTest.run()

  println "media filesystem (unit):"
  FileSystemTest.run()

  println "media processors (unit):"
  ProcessorTest.run()




  println "turn engine (unit):"
  TurnTest.run()

  println "tool layer (unit):"
  ToolTest.run()

  println "memory store (unit):"
  MemoryTest.run()

  println "media layer (unit):"
  MediaTest.run()

  println "context / truncate (unit):"
  ContextTest.run()

  println "skill tools (unit, security):"
  SkillsTest.run()

  println "session log (unit):"
  SessionLogTest.run()

  println "inline media (unit):"
  InlineMediaTest.run()

  println "logging (unit):"
  LoggingTest.run()

  println "runCode tool (integration):"
  RunCodeTest.run()

  println "all harpe tests passed"
