//[ CliTest.jo
  !
  ! The CLI agent's workflows, end to end: a real build of `cli/` on a real
  ! terminal, answering to a scripted model.
  !
  ! WHAT THESE COVER that the web suite cannot. The two drivers share the turn
  ! engine and the tools, and diverge in everything around them — this one has no
  ! sessions to resume by id, no streaming protocol, no request that carries a
  ! turn. It has a console: a prompt, a spinner, a rendered reply, and a session
  ! journal on disk. And it wires its own toolset, which is where the grant that
  ! makes `runCode` able to read the agent's files lives — a driver-local
  ! decision, made twice in this repository, and once already wrong.
  !
  ! WHAT THEY DELIBERATELY DO NOT COVER. Resuming a past session (`--resume`
  ! walks an interactive menu), ESC-to-interrupt, and approvals. Each needs the
  ! console driven mid-turn rather than between turns, which the harness can do
  ! but no scenario here needs yet.
  !
  ! Each scenario declares the model's answers up front, in the order the turn
  ! will ask for them.
//]

namespace harpe.test.e2e.CliTest

import harpe.ffi.json
import harpe.ffi.os
import harpe.util.File

import harpe.test.framework.thisSuite
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check
import harpe.test.framework.checkEquals
import harpe.test.integration.ProviderFixture
import harpe.test.e2e.CliAgent
import harpe.test.e2e.ModelScript
import harpe.test.e2e.published
import harpe.test.e2e.Driver

//[ Everything one request carried, as text — for asking whether a value reached the model. //]
private def requestText(server: ProviderFixture.Server, index: Int): String =
  json.dumps(server.recorded(index).jsonBody)

def cliSuite(): Unit receives thisSuite, published = suite: "cli", () =>
  thisSuite.parallel = true
  thisSuite.beforeSuite = () => Driver.application("cli").build()

  test: "answers a question, and journals the exchange", () =>
    ProviderFixture.withResponses: [ModelScript.says("I write Jo programs.")], server =>
      CliAgent.withAgent: server.baseUrl, agent =>
        agent.ask("What do you do?")
        agent.expect("I write Jo programs.")

        // What the agent asked the model on the way through.
        check("makes one model request", server.requestCount == 1)
        checkEquals("posts to the Responses API", server.recorded(0).path, "/v1/responses")
        check:
          "sends the agent's own system prompt"
          server.recorded(0).jsonBody.get("instructions", "").asString != ""
        check("sends what was typed", requestText(server, 0).contains("What do you do?"))
        check("offers its tools", server.recorded(0).jsonBody.get("tools").cast[py.List].size > 0)

        checkEquals("exits cleanly on quit", agent.quit().toString, "0")

        // The conversation is on disk, which is what makes a CLI run resumable.
        val journal = File.read(agent.journal)
        check("journals the question", journal.contains("What do you do?"))
        check("journals the answer", journal.contains("I write Jo programs."))

  test: "runs a program that reads its data directory", () =>
    // The regression this suite exists for. `runCode` gives the guest nothing
    // but the environment its driver grants, and the sandbox runtime roots `fs`
    // at HARPE_DATA_DIR — so a driver that forgets the grant still compiles,
    // still calls the tool, and fails only here, inside the guest.
    val reader = """
      namespace sandbox.guest
      import sandbox.api.*
      import harpe.caps.*

      def runTask(): Unit receives IO.stdout, fs =
        match fs.readText("note.txt")
        case Ok(text) => println text
        case Err(err) => println("cannot read: " + err)
      """

    val script = [
      ModelScript.calls("runCode", py.dict("code" ~ reader)),
      ModelScript.says("Your note is about a fox.")
    ]

    ProviderFixture.withResponses: script, server =>
      CliAgent.withAgent: server.baseUrl, agent =>
        File.write(os.path.join(agent.dataDir, "note.txt"), "the quick brown fox")

        agent.ask("What does my note say?")
        agent.expect("Your note is about a fox.")

        // The console reports how the program ended, and the two failures this
        // has actually had look nothing like a clean run.
        val screen = agent.transcript
        check("reports a clean run", screen.contains("· ran ·"))
        check("the guest was granted its data directory", !screen.contains("not granted"))
        check("the program did not crash", !screen.contains("crashed"))

        // The program read the file, and what it printed reached the model.
        check("feeds the program's output back", requestText(server, 1).contains("the quick brown fox"))

        checkEquals("exits cleanly", agent.quit().toString, "0")
        check("journals the run", File.read(agent.journal).contains("harpe.tools.runCode"))

  test: "carries the conversation into the next turn", () =>
    val script = [ModelScript.says("Zurich."), ModelScript.says("Nine degrees.")]
    ProviderFixture.withResponses: script, server =>
      CliAgent.withAgent: server.baseUrl, agent =>
        agent.ask("Where am I?")
        agent.expect("Zurich.")

        agent.ask("And the weather?")
        agent.expect("Nine degrees.")

        // One conversation, not two: the second turn is a fresh provider session
        // built from the running context, so the whole exchange has to be in it.
        val asked = requestText(server, 1)
        check("re-sends the earlier question", asked.contains("Where am I?"))
        check("re-sends the earlier answer", asked.contains("Zurich."))
        check("sends the new question", asked.contains("And the weather?"))

        // Both turns land in one journal, which is the file a resume replays.
        checkEquals("exits cleanly", agent.quit().toString, "0")
        val journal = File.read(agent.journal)
        check("journals the first turn", journal.contains("Where am I?"))
        check("journals the second", journal.contains("And the weather?"))
