//[ Driver.jo
  !
  ! What every end-to-end suite needs before it can drive anything: the built
  ! application, a home for it to run in, an environment pointing it at a
  ! scripted model, and a way to kill it afterwards.
  !
  ! One shipped application per suite — `WebAgent` runs the web driver over HTTP,
  ! `CliAgent` runs the terminal driver over a pty — but what they run is
  ! assembled the same way, from the same `ci/*.toml` spec CI builds. This is
  ! that assembly, and nothing about either transport.
//]

namespace harpe.test.e2e

import harpe.ffi.os
import harpe.ffi.glob
import harpe.ffi.signal
import harpe.util.File
import harpe.util.Process

section Driver
  //[ The repository root, wherever `jo run test` was invoked from. //]
  def repoRoot(): String =
    var found = ""
    for candidate in [".", ".."] do
      if found == "" && os.path.isfile(os.path.join(candidate, "ci/web.toml")) then found = candidate

    assert: found != "", "e2e: ci/ not found — run the tests from the repository root"
    os.path.abspath(found)

  //[ Build every driver these suites run, before any scenario starts
    !
    ! Two builds cannot overlap. Each `ci/` spec compiles its guest to the SAME
    ! `ci/.build/sandbox-guest/`, so concurrent scenarios would drive `jo build`
    ! at one output directory — across suites as much as within one, since
    ! `web.toml` and `cli.toml` both target it.
    !
    ! Only `jo build` ever writes there. A scenario that RUNS a program does not:
    ! `runCode` reads the `.done` record and replays it in a temporary directory
    ! of its own. So getting every build done here, before the pool starts, is
    ! the whole of what parallel scenarios need. The e2e suite hangs this on its
    ! `thisSuite.beforeSuite`, which the runner runs once and on its own thread.
  //]
  def prepare(): Unit =
    val root = repoRoot()
    build(root, "web.toml", "web")
    build(root, "cli.toml", "cli")

  //[ Build an application and its sandbox guest from one `ci/` spec, once per process
    !
    ! Those specs are what CI builds: this branch's driver sources against this
    ! branch's `agent/` and `caps/`, rather than the last published release. Both
    ! halves come from the one spec, so the agent and the programs it compiles
    ! are from the same commit.
    !
    ! Every spec builds its guest to the SAME `ci/.build/sandbox-guest/`, so
    ! whichever driver was built last owns that directory — CI builds all of them
    ! before running the tests. Hence the build here rather than a check that
    ! something is already built: `jo build` sees the different source and
    ! re-targets it.
    !
    ! The builds are incremental, and the environment carries the memo, the same
    ! way the `runCode` suite remembers its sandbox.
    !
    ! `prepare` above has normally set both memos already, so the call each
    ! scenario makes is a lookup. That is what makes it safe to reach here from
    ! a pool thread: the write happened before any lane started.
  //]
  def build(root: String, spec: String, application: String): Unit =
    val memo = "HARPE_TEST_E2E_BUILT_" + application
    if os.getenv(memo, "") != root then
      for module in [application, "sandbox-guest"] do
        val built = Process.runCapped:
          py.list("jo", "build", module, "--spec", "ci/" + spec)
          300.0
          cwd = root

        assert: !built.timedOut && built.returnCode == 0,
          "e2e: failed to build \{module} from ci/\{spec}:\n\{built.err}"

      os.environ.set(memo, root)

  //[ The one file matching `paths`, or the newest when a stale build lingers
    !
    ! Build outputs are keyed by compiler version, so the path is discovered
    ! rather than spelled out — and an older version's leftovers are ignored
    ! rather than picked at random.
  //]
  def newestMatch(paths: String, what: String): String =
    var newest = ""
    var newestTime = 0.0
    for candidate in glob.glob(paths, recursive = true) do
      val path = candidate.asString
      val modified = os.path.getmtime(path)
      if modified > newestTime then
        newest = path
        newestTime = modified

    assert: newest != "", "e2e: no \{what} found at \{paths}"
    newest

  //[ The built application to run. //]
  def application(root: String, module: String): String =
    newestMatch(os.path.join(root, "ci/.build", module, "*/target/*.py"), "built " + module)

  //[ Give `home` the sandbox that `runCode` compiles into
    !
    ! Not a copy of the driver's `sandbox/`: `runCode` reads exactly one thing
    ! there, the `.done` record of how `jo build` compiled the guest, and replays
    ! it with each run's paths swapped in. So the home links to the guest just
    ! built, and a program a scenario runs is compiled against the same libraries
    ! the agent was. Every run compiles and executes in its own temporary
    ! directory, so nothing is written back through the link.
  //]
  def linkGuest(root: String, home: String): Unit =
    val record = newestMatch:
      os.path.join(root, "ci/.build/sandbox-guest/*/target/*.py.done")
      "built sandbox guest"

    val target = os.path.dirname(record)
    val version = os.path.basename(os.path.dirname(target))
    val guestDir = os.path.join(home, "sandbox/.build/guest", version)
    File.ensureDir(guestDir)
    os.symlink(target, os.path.join(guestDir, "target"))

  //[ The child's environment: this process's, plus the scripted model
    !
    ! `OPENAI_API_KEY` selects the OpenAI branch of `Model.default` and
    ! `OPENAI_BASE_URL` points it at the fixture, so the agent's own model
    ! selection runs — no suite constructs a `Model` for it. Both are set rather
    ! than merely inherited, so a developer's real keys in the ambient
    ! environment cannot reach the network from a test run.
  //]
  def modelEnv(modelBaseUrl: String): py.Dict =
    val env = py.module("os").environ.copy().cast[py.Dict]
    env.set("OPENAI_API_KEY", "e2e-fixture-key")
    env.set("OPENAI_BASE_URL", modelBaseUrl)
    env.set("MODEL", "test-model")
    // So a failure report shows everything the agent had printed by then.
    env.set("PYTHONUNBUFFERED", "1")
    env

  //[ Kill the process group, so nothing the agent spawned outlives the test
    !
    ! An agent mid-turn owns a compiler or a guest process, and those are its
    ! children — killing the leader alone would leave them running.
  //]
  def terminate(proc: py.Dynamic): Unit =
    val _ = py.try: os.killpg(os.getpgid(proc.pid.asInt), signal.SIGKILL)
    val _ = py.try: proc.wait(timeout = 5.0)

  //[ Discard a scenario's home, once it has nothing left to say. //]
  def discardHome(home: String): Unit =
    val _ = py.try: py.module("shutil").rmtree(home)
    pass
end
