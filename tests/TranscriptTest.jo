//[ TranscriptTest.jo
  !
  ! Tests for the per-session structured logger and its transcript projection.
//]

namespace harpe.test.TranscriptTest
import harpe.ffi.os
import harpe.ffi.time
import harpe.ffi.json
import harpe.util.File

import jo.IO.stdout
import harpe.*
import harpe.Model.*
import harpe.Tool.*
import harpe.turns.TurnResult
import harpe.logging.logger
import harpe.logging.JsonlLogger
import harpe.transcript.Journal
import harpe.logging.Entry
import harpe.logging.Value

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

// Read a session file back as one parsed dict per non-empty line.
private def readRecords(path: String): List[py.Dict] =
  var records: List[py.Dict] = []
  for line in File.read(path).lines do
    if line.trim != "" then records = records + json.loads(line).cast[py.Dict]

  records

// A string out of an opaque bracket payload.
// Does any tool result in this turn report a refusal?
private def turnRefused(d: TurnData): Bool =
  var refused = false
  for m in d.messages do
    if m is ToolResults(results) then
      for r in results if !r.success do refused = true
  refused

private def payloadField(v: Value, key: String): String =
  match v
  case m: Map[String, Value] =>
    match m.getOrElse(key, "")
    case s: String => s
    case _         => "(not a string)"
  case _ => "(no payload)"

private def turnSize(d: TurnData): Int =
  d.messages.size

private def turnText(d: TurnData): String =
  d.text

private def turnResult(d: TurnData): String =
  match d.result
  case TurnResult.Success        => "Success"
  case TurnResult.Failed(detail) => "Failed(\{detail})"
  case None                      => "None"
  case _                         => "Interrupted"

def run(): Unit receives stdout =
  val call = ToolCall("c1", "runCode", ToolInput(py.dict("code" ~ "println 1")))

  // Write into a fresh nested path to also exercise on-demand dir creation.
  val path = os.path.abspath(".build/session-log-test/sub/session.jsonl")
  if os.path.exists(path) then os.unlink(path)

  val sessionLog = new JsonlLogger(path)
  val journal = new Journal(sessionLog)

  // One answered turn, including an unrelated diagnostic entry.
  with logger = sessionLog in
    journal.start(UserInput("hi", []))
    journal.append(Assistant("on it", [call]))
    logger.log("myagent.debug", "note" ~ "between messages")
    journal.append(ToolResults([ToolResult("c1", "42", [], success = false)]))
    journal.commit()

  val first = readRecords(path)
  check("turn and diagnostic records share one log", first.size == 5)

  val user = first.get(0)
  check("started category", user.get("category", "").asString == "harpe.turn.started")
  check("user role", user.get("role", "").asString == "user")
  check("user text", user.get("text", "").asString == "hi")
  val timestamp = user.get("time", "").asString
  check("user has RFC 3339 timestamp", timestamp.contains("T") && timestamp.endsWith("Z"))

  val asst = first.get(1)
  check("assistant role", asst.get("role", "").asString == "assistant")
  check("assistant text", asst.get("text", "").asString == "on it")
  val calls = asst.get("calls", py.list()).cast[py.List]
  check("one call", calls.size == 1)
  val c0 = calls.get(0).cast[py.Dict]
  check("call name", c0.get("name", "").asString == "runCode")
  check("call id", c0.get("id", "").asString == "c1")
  check("call input", c0.get("input").cast[py.Dict].get("code", "").asString == "println 1")

  check("diagnostic category retained", first.get(2).get("category", "").asString == "myagent.debug")

  val tr = first.get(3)
  check("tool_results role", tr.get("role", "").asString == "tool_results")
  val results = tr.get("results", py.list()).cast[py.List]
  check("one result", results.size == 1)
  val r0 = results.get(0).cast[py.Dict]
  check("result id", r0.get("id", "").asString == "c1")
  check("result content", r0.get("content", "").asString == "42")

  // A refused call says so in the journal, so a driver reading its own output
  // back off a turn cannot mistake a refusal for work done.
  check("result records the refusal", !r0.get("success", default = true).asBool)

  // A user message is durable even when its turn fails, because a driver closes
  // the bracket on every outcome. Assistant messages stay provisional. A turn
  // whose bracket never closed is a fragment, and falls out of the model's
  // context exactly as it falls out of the transcript.
  with logger = sessionLog in
    journal.request(Journal.payload("text" ~ "will fail"))
    journal.start(UserInput("will fail", []))
    journal.append(Assistant("partial", []))
    journal.failed("bad model")
    journal.response("turnEnd")

    journal.request(Journal.payload("text" ~ "again"))
    journal.start(UserInput("again", []))
    journal.append(Assistant("done", [call]))
    journal.append(ToolResults([ToolResult("c1", "no such file", [], success = false)]))
    journal.commit()
    journal.response("turnEnd")

    journal.request(Journal.payload("text" ~ "crashed"))
    journal.start(UserInput("crashed", []))

  var entries: List[harpe.logging.Entry] = []
  val lines = readRecords(path)
  for line in lines do entries = entries + Entry.fromDict(line)

  check("failed turn contains diagnostic", lines.get(8).get("error", "").asString == "bad model")

  // The turn at the head of this file was written WITHOUT a bracket, so it is
  // machinery: in the log, in neither the transcript nor the context.
  val projected = Journal.records(entries)
  check("unbracketed turn is outside the transcript", projected.size == 2)
  check("failed turn is still a record", turnResult(projected.get(0).data) == "Failed(bad model)")
  check("failed turn drops provisional messages", turnSize(projected.get(0).data) == 0)
  check("answered turn keeps its messages", turnResult(projected.get(1).data) == "Success")
  check("a refused call is still refused after reload", turnRefused(projected.get(1).data))

  val loaded = Journal.fromEntries(entries)
  check("context comes from the transcript alone", loaded.size == 4)
  check("context keeps a failed turn's user message", loaded.get(0) is UserInput("will fail", _))
  check("context drops its provisional reply", loaded.get(1) is UserInput("again", _))
  check("context keeps an answered turn's reply", loaded.get(2) is Assistant("done", _))
  check("context keeps its tool results", loaded.get(3) is ToolResults(_))

  val loadedFromFile = Journal.load(path)
  check("load existing journal", loadedFromFile.size == loaded.size)

  sessionLog.close()
  os.unlink(path)

  // --- records: the user-facing projection ---

  val recPath = os.path.abspath(".build/session-log-test/sub/records.jsonl")
  if os.path.exists(recPath) then os.unlink(recPath)
  val recLog = new JsonlLogger(recPath)
  val recJournal = new Journal(recLog)

  with logger = recLog in
    // A bracketed turn that delegates to a nested (subagent) turn partway through.
    recJournal.request(Journal.payload("kind" ~ "upload", "file" ~ "a.png"))
    recJournal.start(UserInput("look", []))
    recJournal.append(Assistant("delegating", [call]))
    recJournal.start(UserInput("subagent work", []))
    recJournal.append(Assistant("sub answer", []))
    recJournal.commit()
    recJournal.append(ToolResults([ToolResult("c1", "42", [])]))
    recJournal.append(Assistant("done", []))
    recJournal.commit()
    recJournal.response(Journal.payload("text" ~ "done"))

    // Machinery: a turn nobody bracketed.
    recJournal.start(UserInput("cron job", []))
    recJournal.append(Assistant("tick", []))
    recJournal.commit()

    // Bracketed, but the process died mid-turn.
    recJournal.request(Journal.payload("kind" ~ "chat"))
    recJournal.start(UserInput("and this?", []))

  var recEntries: List[harpe.logging.Entry] = []
  for record in readRecords(recPath) do recEntries = recEntries + Entry.fromDict(record)

  val recs = Journal.records(recEntries)
  check("only complete bracketed turns become records", recs.size == 1)
  check("record keeps every request field", payloadField(recs.get(0).request, "file") == "a.png")

  val r1 = recs.get(0)
  check("request payload round-trips", payloadField(r1.request, "kind") == "upload")
  check("response payload round-trips", payloadField(r1.response, "text") == "done")
  check("bracketed turn keeps its own messages", turnSize(r1.data) == 3)
  check("nested turn does not leak into the outer one", turnText(r1.data) == "delegating\n\ndone")
  check("bracketed turn answered", turnResult(r1.data) == "Success")

  // An unclosed bracket is a fragment, not a turn the user had. It stays in the
  // journal (the raw entries are all still there) and out of the transcript.
  check("crash mid-turn yields no record", recs.size == 1)

  recLog.close()
  os.unlink(recPath)
