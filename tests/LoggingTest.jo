//[ LoggingTest.jo
  !
  ! Tests for the logging layer (`harpe.logging`): that `Logger.log` accepts bare
  ! typed pairs and assembles an `Entry` (via the `Value` adapters), that
  ! `JsonlLogger` appends every category to one file as well-formed JSON — with
  ! `category` a field and values kept typed — and that `Logging.withLogger`
  ! installs a `logger` that reaches producers.
//]

namespace harpe.test.LoggingTest
import harpe.ffi.os
import harpe.ffi.json
import harpe.ffi.file

import jo.IO.stdout
import harpe.*
import harpe.logging.*
import harpe.models.logUsage

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

// Read a JSONL file back as one parsed dict per non-empty line.
private def readRecords(path: String): List[py.Dict] =
  var records: List[py.Dict] = []
  for line in file.read(path).lines do
    if line.trim != "" then records = records + json.loads(line).cast[py.Dict]

  records

// An in-memory Logger that keeps the entries it is handed.
private class Capture
  view Logger

  var entries: List[Entry] = []

  def logEntry(entry: Entry): Unit = entries = entries + entry

  def close(): Unit = pass
end

def run(): Unit receives stdout =
  // --- log: bare typed pairs assemble an Entry ---
  val cap0 = new Capture
  cap0.log("runs", "code" ~ "x", "exitCode" ~ 0, "ok" ~ true, "secs" ~ 1.5)
  check("log builds one entry", cap0.entries.size == 1)
  val rec = cap0.entries.get(0)
  check("entry category", rec.category == "runs")
  check("entry field count", rec.fields.size == 4)
  check("entry time stamped", rec.time > 0.0)

  // --- JsonlLogger: all categories in one file, category a field, values typed ---
  val dir = os.path.abspath(".build/logging-test")
  py.module("shutil").rmtree(dir, ignore_errors = true)
  val path = os.path.join(dir, "log.jsonl")

  val jsonl = new JsonlLogger(path)
  jsonl.log("runs", "code" ~ "x", "exitCode" ~ 0, "ok" ~ true, "secs" ~ 1.5)
  jsonl.log("runs", "code" ~ "y", "exitCode" ~ 1)
  jsonl.log("tools", "name" ~ "read")
  jsonl.warn("harpe.test", "rate limited", "attempt" ~ 3)
  with logger = jsonl in logUsage("anthropic", "claude-x", 100, 20)
  jsonl.close()

  val all = readRecords(path)
  check("all entries in one file", all.size == 5)

  val first = all.get(0)
  check("category is a field", first.get("category", "").asString == "runs")
  check("string field", first.get("code", "").asString == "x")
  check("int field stays an int", first.get("exitCode", -1).asInt == 0)
  check("bool field stays a bool", first.get("ok", false).asBool)
  check("float field stays a float", first.get("secs", 0.0).asFloat == 1.5)
  val timestamp = first.get("time", "").asString
  check("entry time serialized as RFC 3339", timestamp.contains("T") && timestamp.endsWith("Z"))

  // Categories coexist in the log, distinguished by the field (jq's job downstream).
  val toolsRec = all.get(2)
  check("other category same file", toolsRec.get("category", "").asString == "tools")
  check("tools field", toolsRec.get("name", "").asString == "read")

  // A severity helper writes its message under the reserved key, keeping extras.
  val warnRec = all.get(3)
  check("warn category", warnRec.get("category", "").asString == "harpe.test")
  check("warn message under reserved key", warnRec.get("warning", "").asString == "rate limited")
  check("warn keeps extra fields", warnRec.get("attempt", -1).asInt == 3)

  // A model usage event carries the billing fields under `harpe.model`.
  val usageRec = all.get(4)
  check("usage category", usageRec.get("category", "").asString == "harpe.model")
  check("usage provider", usageRec.get("provider", "").asString == "anthropic")
  check("usage input tokens", usageRec.get("inputTokens", -1).asInt == 100)
  check("usage output tokens", usageRec.get("outputTokens", -1).asInt == 20)

  // --- withLogger: installs the `logger` channel for the wrapped work ---
  val cap = new Capture
  Logging.withLogger(cap, () => emitOne())
  check("withLogger installs logger", cap.entries.size == 1)

  // discard is a no-op that never throws.
  Logging.discard.log("runs", "code" ~ "z")
  check("discard is silent", true)

  // --- withContext nests the context under its key, never flattening it ---
  val cpath = os.path.join(dir, "ctx.jsonl")
  val emit: () => Unit receives logger = () => logger.log("harpe.web", "note" ~ "hi")
  val tagged: () => Unit receives logger =
    () => Logging.withContext("context", Map("session" ~ "s1"), emit)
  Logging.withLogger(new JsonlLogger(cpath), tagged)

  val ctxRec = readRecords(cpath).get(0)
  check("context nested under its key", ctxRec.get("context").cast[py.Dict].get("session", "").asString == "s1")
  check("producer field untouched", ctxRec.get("note", "").asString == "hi")
  check("context not flattened into fields", !ctxRec.contains("session"))

  // --- audit codec: how the sandbox's JSONL records are read back on the host ---
  // A record written by a `JsonlLogger` (in the sandbox) is read as a dict and
  // rebuilt into an `Entry` (by `runCode`) with its typed fields intact.
  val apath = os.path.join(dir, "audit.jsonl")
  val alog = new JsonlLogger(apath)
  var items: List[Value] = []
  items = items + "a"
  items = items + Value.IntVal(1)
  alog.log("harpe.sandbox.runtime", "info" ~ "ready", "count" ~ 3, "secs" ~ 1.5,
           "ok" ~ true, "items" ~ items)
  alog.close()

  val back = Entry.fromDict(readRecords(apath).get(0))
  check("codec preserves category", back.category == "harpe.sandbox.runtime")
  check("codec parses RFC 3339 time", back.time > 0.0)
  check("codec preserves field count", back.fields.size == 5)

  match back.fields.getOpt("count")
  case Some(Value.IntVal(n)) => check("codec keeps int typed", n == 3)
  case _                     => check("codec int present", false)

  match back.fields.getOpt("ok")
  case Some(Value.BoolVal(b)) => check("codec keeps bool typed", b)
  case _                      => check("codec bool present", false)

  match back.fields.getOpt("items")
  case Some(xs: List[Value]) => check("codec keeps arrays typed", xs.size == 2)
  case _                 => check("codec array present", false)

  py.module("shutil").rmtree(dir, ignore_errors = true)

// A producer: emits through the ambient `logger` channel.
private def emitOne(): Unit receives logger =
  logger.log("runs", "code" ~ "hello")
