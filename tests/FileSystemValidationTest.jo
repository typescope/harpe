//[ FileSystemValidationTest.jo
  !
  ! Unit tests for portable relative paths accepted by `FileSystem.validate`.
//]

namespace harpe.test.FileSystemValidationTest

import harpe.caps.*
import jo.IO.stdout

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

private def accepted(path: String): Bool = FileSystem.validate(path) is None

def run(): Unit receives stdout =
  check("accepts root", accepted(""))
  check("accepts file", accepted("file.txt"))
  check("accepts nested path", accepted("docs/report.pdf"))
  check("rejects absolute", !accepted("/etc/passwd"))
  check("rejects parent", !accepted(".."))
  check("rejects nested parent", !accepted("docs/../secret"))
  check("rejects current segment", !accepted("docs/./report"))
  check("rejects empty segment", !accepted("docs//report"))
  check("rejects trailing separator", !accepted("docs/"))
  check("rejects backslash", !accepted("docs\\report"))
  check("rejects Windows drive", !accepted("C:/secret"))
  check(
    "explains invalid path",
    FileSystem.validate("docs/../secret") is Some("path must not contain '..' segments")
  )
