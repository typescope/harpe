//[ EngineTest.jo
  !
  ! The turn engine (`Agent.ask`) over the OpenAI-compatible Chat Completions wire.
  !
  ! `unit/TurnTest.jo` drives the engine against a scripted `Responder`: every
  ! reply it reacts to was handed to it as a Jo value. This runs the same engine
  ! over a provider SDK and a real socket, where its decisions have to survive
  ! the round trip — a `ToolResult` it built has to come back as something this
  ! protocol accepts, a `Retry-After` header has to reach its backoff, and the
  ! chunks the SDK emits have to interleave with its own events in order.
  !
  ! The expectations are deliberately identical to the other three protocols'.
  ! That the engine reads the same over every wire is the claim being made, and
  ! it only reads that way if the assertions are written the same way.
//]

namespace harpe.test.integration.openai.EngineTest

import harpe.*
import harpe.turns.*
import harpe.Model.*
import harpe.Tool.*
import harpe.models.openai
import harpe.logging.logger
import harpe.test.framework.thisSuite
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check
import harpe.test.framework.checkEquals
import harpe.test.integration.ProviderFixture
import harpe.test.integration.EngineDriver

private def model(server: ProviderFixture.Server): Model =
  openai.compatible("test-key", "test-model", server.baseUrl, timeoutSeconds = 2)

//[ Text, then a call to `lookup` — the shape that makes the engine speak
  ! before it dispatches a tool.
//]
private def speaksThenCalls(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0, "delta": {"role":"assistant","content":"Let me look."}, "finish_reason": null
    }]
  }

  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0,
      "delta": {
        "tool_calls": [{
          "index": 0, "id": "call_1", "type": "function",
          "function": {"name":"lookup","arguments":"{\"city\":\"Zurich\"}"}
        }]
      },
      "finish_reason": null
    }]
  }

  data: {
    "id": "chat_tool", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"tool_calls"}],
    "usage": {"prompt_tokens":6,"completion_tokens":3,"total_tokens":9}
  }

  data: [DONE]
  """

private def says(text: String): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_text", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0, "delta": {"role":"assistant","content":"\{text}"}, "finish_reason": null
    }]
  }

  data: {
    "id": "chat_text", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"stop"}],
    "usage": {"prompt_tokens":8,"completion_tokens":1,"total_tokens":9}
  }

  data: [DONE]
  """

private def unavailable(): ProviderFixture.Response = ProviderFixture.response:
  "503 Service Unavailable"
  "application/json"
  """
    {"error":{"message":"unavailable","type":"server_error","code":"server_error"}}
    """

private def unauthorized(): ProviderFixture.Response = ProviderFixture.response:
  "401 Unauthorized"
  "application/json"
  """
    {"error":{"message":"bad key","type":"invalid_request_error","code":"invalid_api_key"}}
    """

private def rateLimited(): ProviderFixture.Response = new ProviderFixture.Response:
  "429 Too Many Requests"
  py.list:
    py.tuple("Content-Type", "application/json")
    py.tuple("Retry-After", "7")
  [
    """
    {"error":{"message":"slow down","type":"rate_limit_error","code":"rate_limit"}}
    """
  ]


//[ Two calls in one reply — what a provider does by default when the model
  ! asks for several things at once.
//]
private def callsTwoTools(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_two", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0,
      "delta": {
        "role": "assistant",
        "tool_calls": [
          {
            "index": 0, "id": "call_1", "type": "function",
            "function": {"name":"lookup","arguments":"{\"city\":\"Zurich\"}"}
          },
          {
            "index": 1, "id": "call_2", "type": "function",
            "function": {"name":"clock","arguments":"{\"zone\":\"CET\"}"}
          }
        ]
      },
      "finish_reason": null
    }]
  }

  data: {
    "id": "chat_two", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"tool_calls"}],
    "usage": {"prompt_tokens":6,"completion_tokens":4,"total_tokens":10}
  }

  data: [DONE]
  """

private def callsOneTool(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_one", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{
      "index": 0,
      "delta": {
        "role": "assistant",
        "tool_calls": [{
          "index": 0, "id": "call_3", "type": "function",
          "function": {"name":"lookup","arguments":"{\"city\":\"Geneva\"}"}
        }]
      },
      "finish_reason": null
    }]
  }

  data: {
    "id": "chat_one", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"tool_calls"}],
    "usage": {"prompt_tokens":9,"completion_tokens":2,"total_tokens":11}
  }

  data: [DONE]
  """

//[ The tool-result ids a request carries. Chat Completions sends each result
  ! as its own `tool` message, so they are collected across the whole replay.
//]
private def toolResultIds(request: ProviderFixture.RecordedRequest): String =
  var ids: List[String] = []
  for message in request.jsonBody.get("messages").cast[py.List] do
    val entry = message.cast[py.Dict]
    if entry.get("role", "").asString == "tool" then
      ids = ids + entry.get("tool_call_id").asString
  ids.join(",")

//[ A reply that arrives in three pieces, so a scenario can stop after one. //]
private def saysInPieces(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "id": "chat_slow", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{"role":"assistant","content":"one"},"finish_reason":null}]
  }

  data: {
    "id": "chat_slow", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{"content":"two"},"finish_reason":null}]
  }

  data: {
    "id": "chat_slow", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{"content":"three"},"finish_reason":null}]
  }

  data: {
    "id": "chat_slow", "object": "chat.completion.chunk", "created": 0, "model": "test-model",
    "choices": [{"index":0,"delta":{},"finish_reason":"stop"}],
    "usage": {"prompt_tokens":4,"completion_tokens":3,"total_tokens":7}
  }

  data: [DONE]
  """

def engineSuite(): Unit receives thisSuite, logger = suite: "engine", () =>
  test: "dispatches a streamed tool call and sends its result back", () =>
    ProviderFixture.withResponses: [speaksThenCalls(), says("Sunny in Zurich.")], server =>
      val asked = py.list()
      val weather = Toolset.of:
        Tool("lookup", "Look up the weather", [Tool.strParam("city", "City to look up")])
        (input: ToolInput, channel: Interact) =>
          asked.append(input.string("city"))
          new ToolOutcome("sunny", "lookup · sunny", attachments = [])

      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "What is the weather in Zurich?"
        brain = model(server)
        tools = weather
        interact = recorder

      // The arguments arrive as stream fragments. Reassembling them is the
      // SDK's job, so what the handler was called with is what proves it done.
      check("called the tool once", asked.size == 1)
      checkEquals("tool argument", asked.get(0).asString, "Zurich")

      checkEquals:
        "turn events"
        recorder.trace
        expected = "start,chunk:Let me look.,end,said:Let me look.,tool+lookup,tool-lookup,start,chunk:Sunny in Zurich.,end"

      checkEquals("result", EngineDriver.resultTag(turn), "Success")
      checkEquals("everything the turn said", turn.text, "Let me look.\n\nSunny in Zurich.")
      checkEquals("closing reply", turn.finalText, "Sunny in Zurich.")
      checkEquals("turn messages", EngineDriver.messageTags(turn), "calls,results,text")

      // Where the result the engine built has to land is this protocol's own
      // business, so this is the one assertion the four files disagree on.
      check("two requests", server.requestCount == 2)
      val messages = server.recorded(1).jsonBody.get("messages").cast[py.List]
      val result = messages.get(messages.size - 1).cast[py.Dict]
      checkEquals("tool result role", result.get("role").asString, "tool")
      checkEquals("tool result id", result.get("tool_call_id").asString, "call_1")
      checkEquals("tool result content", result.get("content").asString, "sunny")


  test: "retries a transient failure and answers on the second attempt", () =>
    ProviderFixture.withResponses: [unavailable(), says("hello")], server =>
      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "Say hello."
        brain = model(server)
        interact = recorder
        maxRetries = 1

      checkEquals:
        "turn events"
        recorder.trace
        expected = "start,end,reset,transient,start,chunk:hello,end"

      checkEquals("result", EngineDriver.resultTag(turn), "Success")
      checkEquals("answer", turn.finalText, "hello")
      check("backed off once", recorder.waits.size == 1)
      checkEquals("first backoff", recorder.waits.get(0).toString, "1.0")

  test: "waits as long as a 429 asked it to, not as long as its own backoff", () =>
    ProviderFixture.withResponses: [rateLimited(), says("hello")], server =>
      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "Say hello."
        brain = model(server)
        interact = recorder
        maxRetries = 1

      // 7 is the header the fixture sent, and 1.0 is what the engine's own
      // backoff would have chosen — so this pins the whole path from the
      // response header, through the SDK and its classifier, to the wait.
      checkEquals("result", EngineDriver.resultTag(turn), "Success")
      check("waited once", recorder.waits.size == 1)
      checkEquals("honoured Retry-After", recorder.waits.get(0).toString, "7.0")

  test: "loses the turn on a fatal provider error, retrying nothing", () =>
    ProviderFixture.withResponses: [unauthorized()], server =>
      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "Say hello."
        brain = model(server)
        interact = recorder
        maxRetries = 4

      checkEquals("turn events", recorder.trace, "start,end")
      checkEquals("result", EngineDriver.resultTag(turn), "Failed")
      check("no retries", server.requestCount == 1)
      check("waited for nothing", recorder.waits.isEmpty)

      // A lost turn contributes no messages, so a live turn and one replayed
      // from a journal agree on what happened.
      check("produced nothing", turn.messages.isEmpty)
      checkEquals("said nothing", turn.text, "")

  test: "keeps its place when a retry lands between two tool rounds", () =>
    ProviderFixture.withResponses: [callsTwoTools(), unavailable(), callsOneTool(), says("Both sunny.")], server =>
      val lookup = Tool("lookup", "Look up the weather", [Tool.strParam("city", "City to look up")])
      val clock = Tool("clock", "Read the clock", [Tool.strParam("zone", "Time zone to read")])
      val asked = py.list()

      val onLookup: Handler = (input: ToolInput, channel: Interact) =>
        asked.append("lookup:" + input.string("city"))
        new ToolOutcome("sunny", "lookup · sunny", attachments = [])

      val onClock: Handler = (input: ToolInput, channel: Interact) =>
        asked.append("clock:" + input.string("zone"))
        new ToolOutcome("14:00", "clock · 14:00", attachments = [])

      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "What is the weather in Zurich and Geneva?"
        brain = model(server)
        tools = Toolset.of(lookup, onLookup).add(clock, onClock)
        interact = recorder
        maxRetries = 1

      // Both calls of the first reply are dispatched, in the order the model
      // made them, before either result goes back.
      checkEquals:
        "what the tools were asked"
        py.dynamic(",").join(asked).asString
        expected = "lookup:Zurich,clock:CET,lookup:Geneva"

      checkEquals:
        "turn events"
        recorder.trace
        expected = "start,end,tool+lookup,tool-lookup,tool+clock,tool-clock,start,end,reset,transient,start,end,tool+lookup,tool-lookup,start,chunk:Both sunny.,end"

      checkEquals("result", EngineDriver.resultTag(turn), "Success")
      checkEquals("answer", turn.finalText, "Both sunny.")
      checkEquals("turn messages", EngineDriver.messageTags(turn), "calls,results,calls,results,text")
      check("four requests", server.requestCount == 4)

      // The idempotency `Model.Session` promises: the failed request committed
      // nothing, so the retry is the same request again — same results, and no
      // continuation state advanced past a response that never arrived.
      checkEquals:
        "the retry re-sent the failed request unchanged"
        py.module("json").dumps(server.recorded(1).jsonBody, sort_keys = true).asString
        expected = py.module("json").dumps(server.recorded(2).jsonBody, sort_keys = true).asString

      // Both results travel together in the round that follows the two calls,
      // each keyed by the id the model chose for it.
      checkEquals("both results, one round", toolResultIds(server.recorded(2)), "call_1,call_2")

  test: "gives up once the retry budget is spent, walking its backoff ladder", () =>
    ProviderFixture.withResponses: [unavailable(), unavailable(), unavailable()], server =>
      val recorder = new EngineDriver.Recorder
      val turn = Agent.ask:
        "Say hello."
        brain = model(server)
        interact = recorder
        maxRetries = 2

      checkEquals:
        "turn events"
        recorder.trace
        expected = "start,end,reset,transient,start,end,reset,transient,start,end,reset"

      checkEquals("result", EngineDriver.resultTag(turn), "Failed")
      check("spent every attempt", server.requestCount == 3)
      checkEquals:
        "backoff ladder"
        recorder.waits.map(w => w.toString).join(",")
        expected = "1.0,2.0"

  test: "abandons the stream the moment cancellation is asked for", () =>
    ProviderFixture.withResponses: [saysInPieces()], server =>
      val recorder = new EngineDriver.Recorder
      // Stop as soon as the first piece of the reply has been seen.
      recorder.cancelAfterChunks = 1

      val turn = Agent.ask:
        "Say hello."
        brain = model(server)
        interact = recorder

      // The adapter checks between stream events, so the two remaining pieces
      // never arrive even though the fixture is still willing to send them.
      checkEquals("turn events", recorder.trace, "start,chunk:one,end")
      check("stopped inside the stream", recorder.streamed == 1)
      checkEquals("result", EngineDriver.resultTag(turn), "Interrupted")

      // An interrupted turn is rolled back whole, so it contributes nothing.
      check("produced nothing", turn.messages.isEmpty)
      checkEquals("said nothing", turn.text, "")
