//[ FailureTest.jo
  !
  ! OpenAI HTTP and stream failures. The same wire failures are classified twice
  ! — once through the Responses API, once through the Chat Completions path —
  ! so the two halves register into their own suites rather than one flat list.
//]

namespace harpe.test.integration.openai.FailureTest

import harpe.models.openai
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check
import harpe.test.integration.ProviderFixture
import harpe.test.integration.ModelDriver

private def error(status: String, message: String): ProviderFixture.Response =
  ProviderFixture.response:
    status
    "application/json"
    """
      {"error":{"message":"\{message}","type":"test_error","code":"test"}}
      """

private def rateLimited(): ProviderFixture.Response = new ProviderFixture.Response:
  "429 Too Many Requests"
  py.list:
    py.tuple("Content-Type", "application/json")
    py.tuple("Retry-After", "7")
  [
    """
    {"error":{"message":"slow down","type":"rate_limit_error","code":"rate_limit"}}
    """
  ]

private def responses(server: ProviderFixture.Server) =
  openai("test-key", "test-model", baseUrl = server.baseUrl, timeoutSeconds = 2)

private def chat(server: ProviderFixture.Server) =
  openai.compatible("test-key", "test-model", server.baseUrl, timeoutSeconds = 2)

def responsesFailureSuite(): Unit receives testing, logger = suite: "failure", () =>
  test: "429 reports the Retry-After delay", () =>
    ProviderFixture.withResponses: [rateLimited()], server =>
      val turn = ModelDriver.start(responses(server), prompt = "Say hello.")
      val detail = turn.expectRetryAfter()
      check("classified rate limited", detail != "")
      check("retry-after", turn.retryAfterSeconds == 7.0)
      check("one request", server.requestCount == 1)

  test: "503 is transient", () =>
    ProviderFixture.withResponses: [error("503 Service Unavailable", "unavailable")], server =>
      val detail = ModelDriver.start(responses(server), prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")

  test: "401 is fatal", () =>
    ProviderFixture.withResponses: [error("401 Unauthorized", "bad key")], server =>
      val detail = ModelDriver.start(responses(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  test: "a malformed stream is fatal", () =>
    ProviderFixture.withResponses: [ProviderFixture.sse("data: {not-json}")], server =>
      val detail = ModelDriver.start(responses(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

def chatFailureSuite(): Unit receives testing, logger = suite: "failure", () =>
  test: "429 reports the Retry-After delay", () =>
    ProviderFixture.withResponses: [rateLimited()], server =>
      val turn = ModelDriver.start(chat(server), prompt = "Say hello.")
      val detail = turn.expectRetryAfter()
      check("classified rate limited", detail != "")
      check("retry-after", turn.retryAfterSeconds == 7.0)

  test: "503 is transient", () =>
    ProviderFixture.withResponses: [error("503 Service Unavailable", "unavailable")], server =>
      val detail = ModelDriver.start(chat(server), prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")

  test: "400 is fatal", () =>
    ProviderFixture.withResponses: [error("400 Bad Request", "invalid request")], server =>
      val detail = ModelDriver.start(chat(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  test: "a malformed stream is fatal", () =>
    ProviderFixture.withResponses: [ProviderFixture.sse("data: {not-json}")], server =>
      val detail = ModelDriver.start(chat(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")
