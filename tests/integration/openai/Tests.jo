namespace harpe.test.integration.openai.Tests

import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.integration.openai.SmokeTest
import harpe.test.integration.openai.ContractTest
import harpe.test.integration.openai.FailureTest
import harpe.test.integration.openai.EngineTest

def openaiSuite(): Unit receives testing, logger = suite: "openai", () =>
  SmokeTest.smokeSuite()
  ContractTest.contractSuite()
  FailureTest.failureSuite()
  EngineTest.engineSuite()
