namespace harpe.test.integration.openrouter.Tests

import harpe.logging.logger
import harpe.testing.thisSuite
import harpe.testing.suite
import harpe.test.integration.openrouter.SmokeTest
import harpe.test.integration.openrouter.ContractTest
import harpe.test.integration.openrouter.FailureTest
import harpe.test.integration.openrouter.EngineTest

def openrouterSuite(): Unit receives thisSuite, logger = suite: "openrouter", () =>
  SmokeTest.smokeSuite()
  ContractTest.contractSuite()
  FailureTest.failureSuite()
  EngineTest.engineSuite()
