//[ FailureTest.jo — OpenRouter HTTP failure classification. //]

namespace harpe.test.integration.openrouter.FailureTest

import harpe.models.openrouter
import harpe.logging.logger
import harpe.testing.thisSuite
import harpe.testing.suite
import harpe.testing.test
import harpe.testing.check
import harpe.test.integration.ProviderFixture
import harpe.test.integration.ModelDriver

private def model(server: ProviderFixture.Server) =
  openrouter("test-key", "test-model", baseUrl = server.baseUrl, timeoutSeconds = 2)

private def error(status: String, message: String): ProviderFixture.Response =
  ProviderFixture.response:
    status
    "application/json"
    """
      {"error":{"message":"\{message}","type":"test_error","code":"test"}}
      """

def failureSuite(): Unit receives thisSuite, logger = suite: "failure", () =>
  test: "429 reports the Retry-After delay", () =>
    val limited = new ProviderFixture.Response:
      "429 Too Many Requests"
      py.list:
        py.tuple("Content-Type", "application/json")
        py.tuple("Retry-After", "4")
      [
        """
        {"error":{"message":"rate limited","type":"rate_limit_error","code":"rate_limit"}}
        """
      ]
    ProviderFixture.withResponses: [limited], server =>
      val turn = ModelDriver.start(model(server), prompt = "Say hello.")
      val detail = turn.expectRetryAfter()
      check("classified rate limited", detail != "")
      check("retry-after", turn.retryAfterSeconds == 4.0)
      check("one request", server.requestCount == 1)

  test: "503 is transient", () =>
    ProviderFixture.withResponses: [error("503 Service Unavailable", "unavailable")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")

  test: "401 is fatal", () =>
    ProviderFixture.withResponses: [error("401 Unauthorized", "bad key")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  test: "a malformed stream is fatal", () =>
    ProviderFixture.withResponses: [ProviderFixture.sse("data: {not-json}")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  // Every other failure here arrives as an HTTP status. This one never becomes
  // one: the server holds the request open past the client's own deadline, so
  // the SDK gives up locally and `Classify` has only the exception type to go
  // on. Retrying is right — nothing reached the model.
  test: "a client-side timeout is transient", () =>
    ProviderFixture.withResponses: [ProviderFixture.stalled(3.0)], server =>
      val impatient = openrouter("test-key", "test-model", baseUrl = server.baseUrl, timeoutSeconds = 1)
      val detail = ModelDriver.start(impatient, prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")
