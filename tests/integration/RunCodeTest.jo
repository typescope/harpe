//[ RunCodeTest.jo
  !
  ! Integration tests for the `runCode` tool (`harpe.tools`). Unlike the pure
  ! `Agent.ask` tests, `runCode` actually compiles and runs a guest program, so
  ! these drive `RunCodeTool` against an on-disk sandbox fixture
  ! (`sandbox-fixtures/basic/`, kept outside the `tests/` source glob) and
  ! assert a normalized outcome tag — covering the host wall-clock timeout, the
  ! `sandbox/run.sh` seam, and provider-key env scrub end to end. They shell out
  ! to `jo build` + `python3`, so they are slower than the unit tests.
  !
  ! The fixture ships an executable `sandbox/run.sh`, so every run here goes
  ! through it. It is silent by default. With `HARPE_TEST_PROBE` set it echoes
  ! whether `ANTHROPIC_API_KEY` leaked into the child (it must not).
//]

namespace harpe.test.integration.RunCodeTest
import harpe.ffi.os
import harpe.util.Process
import harpe.ffi.threading
import harpe.util.Capped
import harpe.util.File
import harpe.ffi.tempfile

import harpe.*
import harpe.tools.*
import harpe.logging.Logging
import harpe.logging.logger
import harpe.logging.Logger
import harpe.logging.Entry
import harpe.logging.JsonlLogger
import harpe.Tool.*
import jtest.thisSuite
import jtest.suite
import jtest.test
import jtest.check
import jtest.checkEquals

// Locate the sandbox fixture regardless of where `jo run test` is invoked from
// (the repo root or a subdirectory).
private def fixtureSandboxDir(): String =
  var found = ""
  for c in ["sandbox-fixtures/basic", "../sandbox-fixtures/basic"] do
    if found == "" && os.path.isdir(c) then found = c

  assert: found != "", "runCode tests: sandbox fixture not found under sandbox-fixtures/basic/"
  os.path.abspath(found)

// Map an outcome to a stable tag (raw summaries carry nondeterministic timings).
private def tag(o: ToolOutcome): String =
  if o.summary.contains("timed out") then "timeout"
  else if o.summary.contains("did not compile") then "compile-error"
  else if o.summary.contains("crashed") then "crash"
  else if o.summary.contains("ran") then "ran"
  else "other"

// Self-provides a no-op logger, so it works on the spawned worker threads too
// (context params don't cross threads). These tests assert on outcomes, not logs.
private def execWith(
    tool: RunCodeTool, code: String, guestEnv: Map[String, String], channel: Interact)
: ToolOutcome =
  with logger = Logging.discard in
    tool.run(code, guestEnv, channel)

private def exec(tool: RunCodeTool, code: String): ToolOutcome =
  execWith(tool, code, Map.empty[String, String], Interact.unattended)

private class Capture
  view Logger

  private val lock = threading.Lock()
  var entries: List[Entry] = []

  def logEntry(entry: Entry): Unit =
    lock.acquire()
    entries = entries + entry
    lock.release()

  def close(): Unit = pass
end

private class AuditedRun(outcome: ToolOutcome, entries: List[Entry])

private def execAudited(
    tool: RunCodeTool, code: String, guestEnv: Map[String, String], channel: Interact)
: AuditedRun =
  val capture = new Capture
  val outcome = with logger = capture in
    Logging.withContext("harpe.test.audit=run", () => tool.run(code, guestEnv, channel))
  new AuditedRun(outcome, capture.entries)

private def checkAudit(run: AuditedRun, outcomeEvent: String): Unit =
  checkEquals:
    "runtime audit is replayed once before the outcome"
    run.entries.map(entry => entry.event).join(",")
    "harpe.sandbox.runtime," + outcomeEvent
  for entry in run.entries do
    check("turn context", entry.context.contains("harpe.test.audit=run"))

private def checkScrubbedEnvironment(): Unit =
  val probed = exec(fastTool(), guest("  println 42\n")).result
  check("host secret did not leak", probed.contains("harpe-run-sh key=[]"))
  check("program output present", probed.contains("42"))

private class ApprovalInteract(decision: Approvals.Decision)
  view Interact

  var seenTitle = ""
  var seenDetail = ""
  var approvalCount = 0
  var sawMarkdown = false

  def cancelled: Bool = false
  def pause(seconds: Float): Bool = false
  def emit(event: turns.TurnEvent): Unit = pass

  def approve(title: String, detail: String): Approvals.Decision =
    seenTitle = title
    seenDetail = detail
    approvalCount = approvalCount + 1
    if detail.contains("**quarterly-report.pdf**") then sawMarkdown = true
    decision
end

private class StuckApprovalInteract
  view Interact

  private val released = py.module("threading").Event()

  def cancelled: Bool = false
  def pause(seconds: Float): Bool = false
  def emit(event: turns.TurnEvent): Unit = pass

  def approve(title: String, detail: String): Approvals.Decision =
    val _ = released.wait()
    Approvals.Approved

  def release(): Unit =
    val _ = released.set()
    pass
end

// Wrap a runTask body in a minimal guest program.
private def guest(body: String): String =
  """
  namespace sandbox.guest
  import sandbox.api.*

  def runTask(): Unit receives IO.stdout =

  """ + body

// A guest program that also receives the `fs` (FileSystem) capability.
private def guestFs(body: String): String =
  """
  namespace sandbox.guest
  import sandbox.api.*

  def runTask(): Unit receives IO.stdout, fs =

  """ + body

//[ Build the fixture sandbox once per process
  !
  ! The tool replays the invocation recorded by `jo build`, so the fixture must
  ! be built before any test runs it. Every test needs it and an incremental
  ! build still costs about a second, so the environment carries the memo — it
  ! is the one store that outlives a call without a top-level value.
//]
private def prepareSandbox(): Unit =
  val dir = fixtureSandboxDir()
  if os.getenv("HARPE_TEST_SANDBOX_BUILT", "") != dir then
    val prep = Process.runCapped:
      py.list("jo", "build", "--spec", os.path.join(dir, "jo.toml"), "guest")
      180.0
    assert: !prep.timedOut && prep.returnCode == 0,
      "failed to pre-build the sandbox fixture:\n\{prep.err}"
    os.environ.set("HARPE_TEST_SANDBOX_BUILT", dir)

private def fastTool(): RunCodeTool = RunCodeTool:
  fixtureSandboxDir()
  "guest"
  approvalDeadline = 5
  buildTimeout = 120
  runTimeout = 5

// Install a real invocation record under a chosen module, alongside unusable
// records for another module and an older compatibility line. Only the record
// matching both the selected module and jo.toml can compile the program.
private def withBuildRecords(module: String, body: String => Unit): Unit =
  val dir = tempfile.mkdtemp()
  File.write:
    os.path.join(dir, "jo.toml")
    "# jo = '0.13'\n\tjo\t=\t'0.14' # compatibility line\r\n[module.\{module}]\nkind = 'app'\n"

  val other = os.path.join(dir, ".build/other/jo-0.14/target")
  File.ensureDir(other)
  File.write(os.path.join(other, "other.py.done"), "unusable record")
  val old = os.path.join(dir, ".build/\{module}/jo-0.13/target")
  File.ensureDir(old)
  File.write(os.path.join(old, "\{module}.py.done"), "unusable record")

  val target = os.path.join(dir, ".build/\{module}/jo-0.14/target")
  File.ensureDir(target)
  py.module("shutil").copy2:
    os.path.join(fixtureSandboxDir(), ".build/guest/jo-0.14/target/guest.py.done")
    os.path.join(target, "\{module}.py.done")

  val attempted = py.try(body(dir))
  py.module("shutil").rmtree(dir)
  match attempted
  case Ok(_) => pass
  case Err(error) => abort error.message

// Fire `n` runCode calls in parallel, each printing a distinct number, and check
// every call gets back its OWN output. If concurrent runs shared one guest source
// or build dir, outputs would clobber and this would fail.
private def runConcurrently(tool: RunCodeTool, n: Int): Bool =
  val results = py.list()
  var i = 0
  while i < n do
    results.append(py.dynamic(""))
    i = i + 1

  val threads = py.list()
  var k = 0
  while k < n do
    val idx = k
    val worker = () => results.set(idx, py.dynamic(exec(tool, guest("  println \{idx}\n")).result))
    val t = Process.daemon(worker)
    threads.append(t)
    t.start()
    k = k + 1

  for t in threads do t.join()

  // The fixture's run.sh prepends a marker line, so each result ends with — but
  // is not exactly — its own number. Clobbering would leave the wrong number
  // last.
  var j = 0
  var allOk = true
  while j < n do
    if !results.get(j).asString.endsWith("\n\{j}") then allOk = false
    j = j + 1
  allOk

//[ Every case that neither reads nor mutates process-global state. //]
private def parallelCases(): Unit receives thisSuite =
  test: "reports an unbuilt sandbox instead of building or running anything", () =>
    val unbuilt = tempfile.mkdtemp()
    checkEquals:
      "summary"
      exec(RunCodeTool(unbuilt, "guest", approvalDeadline = 5), guest("  println 1\n")).summary
      "sandbox not built"

  suite: "build record selection", () =>
    thisSuite.parallel = true

    test: "selects guest and the jo.toml version among other build records", () =>
      withBuildRecords: "guest", dir =>
        val tool = RunCodeTool(dir, "guest", approvalDeadline = 5)
        checkEquals("output", exec(tool, guest("  println 42\n")).result, "42")

    test: "selects a custom module", () =>
      withBuildRecords: "worker", dir =>
        val tool = RunCodeTool(dir, "worker", approvalDeadline = 5)
        checkEquals("output", exec(tool, guest("  println 43\n")).result, "43")

    test: "uses the declared compatibility line rather than the active compiler", () =>
      withBuildRecords: "guest", dir =>
        File.write(os.path.join(dir, "jo.toml"), "jo = \"0.13\"\n")
        py.module("shutil").copy2:
          os.path.join(dir, ".build/guest/jo-0.14/target/guest.py.done")
          os.path.join(dir, ".build/guest/jo-0.13/target/guest.py.done")
        File.write(os.path.join(dir, ".build/guest/jo-0.14/target/guest.py.done"), "unusable record")
        val tool = RunCodeTool(dir, "guest", approvalDeadline = 5)
        checkEquals("output", exec(tool, guest("  println 44\n")).result, "44")

    test: "does not fall back to another module or compiler version", () =>
      withBuildRecords: "guest", dir =>
        os.unlink(os.path.join(dir, ".build/guest/jo-0.14/target/guest.py.done"))
        val tool = RunCodeTool(dir, "guest", approvalDeadline = 5)
        checkEquals("summary", exec(tool, guest("  println 42\n")).summary, "sandbox not built")

    test: "reports malformed sandbox configuration", () =>
      withBuildRecords: "guest", dir =>
        File.write(os.path.join(dir, "jo.toml"), "jo = [")
        val outcome = exec(RunCodeTool(dir, "guest", approvalDeadline = 5), guest("  println 42\n"))
        checkEquals("summary", outcome.summary, "invalid sandbox configuration")
        check("diagnostic", outcome.result.contains("Could not read sandbox configuration"))

    test: "requires a Jo compatibility line", () =>
      withBuildRecords: "guest", dir =>
        File.write(os.path.join(dir, "jo.toml"), "jo = '0.14.11'\n")
        val outcome = exec(RunCodeTool(dir, "guest", approvalDeadline = 5), guest("  println 42\n"))
        checkEquals("summary", outcome.summary, "invalid sandbox configuration")
        check("diagnostic", outcome.result.contains("MAJOR.MINOR"))

    test: "does not use commented or table-scoped jo declarations", () =>
      withBuildRecords: "guest", dir =>
        File.write(os.path.join(dir, "jo.toml"), "# jo = '0.14'\n[module.guest]\njo = '0.14'\n")
        val outcome = exec(RunCodeTool(dir, "guest", approvalDeadline = 5), guest("  println 42\n"))
        checkEquals("summary", outcome.summary, "invalid sandbox configuration")

    test: "requires matching quotes around the compatibility line", () =>
      withBuildRecords: "guest", dir =>
        File.write(os.path.join(dir, "jo.toml"), "jo = \"0.14'\n")
        val outcome = exec(RunCodeTool(dir, "guest", approvalDeadline = 5), guest("  println 42\n"))
        checkEquals("summary", outcome.summary, "invalid sandbox configuration")

  suite: "running a program", () =>
    thisSuite.parallel = true

    test: "runs a well-formed one and produces its output", () =>
      val run = execAudited:
        fastTool()
        guest("  println 42\n")
        Map.empty[String, String]
        Interact.unattended
      checkEquals("tag", tag(run.outcome), "ran")
      checkAudit(run, "harpe.tools.runCode.ran")

    // The guest reads its own run dir — which holds the compiled out.py —
    // through the granted `fs`.
    test: "grants the FileSystem capability to the guest", () =>
      val out = exec(fastTool(), guestFs("  println fs.exists(\"out.py\")\n")).result
      check("guest read its run dir", out.contains("true"))

    // 4 parallel programs, 2 building at a time, each getting back its own
    // output — no shared Task.jo or .build clobbering.
    test: "isolates concurrent runs from each other", () =>
      val concurrent = RunCodeTool:
        fixtureSandboxDir()
        "guest"
        approvalDeadline = 5
        buildTimeout = 120
        runTimeout = 5
        maxConcurrent = 2
      check("no clobbering", runConcurrently(concurrent, 4))

  suite: "approval over the per-run broker", () =>
    thisSuite.parallel = true

    // A trusted sandbox capability can request approval. The request stays out
    // of the transcript and the decision returns to the waiting process.
    test: "returns the decision to the waiting sandbox", () =>
      val channel = new ApprovalInteract(Approvals.Approved)
      val out = execWith:
        fastTool()
        guest("  println 7\n")
        Map("HARPE_TEST_APPROVAL" ~ "1")
        channel
      checkEquals("tag", tag(out), "ran")
      check:
        "both requests approved"
        out.result.contains("approval=approved") && out.result.contains("approval2=approved")
      checkEquals("one connection reused", "\{channel.approvalCount}", "2")

    test: "carries the request title and its markdown", () =>
      val channel = new ApprovalInteract(Approvals.Approved)
      val _ = execWith:
        fastTool()
        guest("  println 7\n")
        Map("HARPE_TEST_APPROVAL" ~ "1")
        channel
      checkEquals("title", channel.seenTitle, "Notify customer")
      check("markdown", channel.sawMarkdown)

    // An application-supplied deadline stops a run even if its trusted
    // interaction handler never returns.
    test: "stops a run whose handler never returns", () =>
      val watchdog = RunCodeTool:
        fixtureSandboxDir()
        "guest"
        approvalDeadline = 1
        buildTimeout = 120
        runTimeout = 5
      val channel = new StuckApprovalInteract
      val attempted = py.try:
        execAudited:
          watchdog
          guest("  println 7\n")
          Map("HARPE_TEST_APPROVAL" ~ "1")
          channel
      // Release the daemon handler only after the watchdog has stopped the
      // guest, including if the run raises, so it cannot race the deadline.
      channel.release()
      val stuck = attempted rescue Err(error) => abort error.message
      checkEquals("summary", stuck.outcome.summary.split(" · ").get(0), "approval timed out")
      checkAudit(stuck, "harpe.tools.runCode.approvalTimedOut")

  suite: "failing programs", () =>
    thisSuite.parallel = true

    test: "keeps stdout before a crash in the result and run log", () =>
      val path = os.path.join(tempfile.mkdtemp(), "run.jsonl")
      val failed = Logging.withLogger: new JsonlLogger(path), () =>
        fastTool().run:
          guest:
            """
              println "step 1: read 2500 rows"
              println "step 2: total 1250"
              abort "step 3 failed"

            """
      checkEquals("tag", tag(failed), "crash")
      check:
        "stdout precedes the diagnostic"
        failed.result.contains("step 1: read 2500 rows\nstep 2: total 1250\n\nThe program crashed:\n")
      check("failure message", failed.result.contains("step 3 failed"))

      var logged = 0
      for entry in Entry.readJsonl(path) if entry.event == "harpe.tools.runCode.ran" do
        logged = logged + 1
        match entry.fields["output"]
        case output: String => checkEquals("logged output", output, failed.result)
        case _ => check("output is a string", false)
      checkEquals("one run entry", logged, 1)

    test: "catches one that does not type-check, with the compiler diagnostic", () =>
      val bad = exec(fastTool(), guest("  println undefinedThing\n"))
      checkEquals("tag", tag(bad), "compile-error")
      check("diagnostic", bad.result.contains("Undefined term name undefinedThing"))

    test: "kills an infinite loop on the host wall-clock timeout", () =>
      val quick = RunCodeTool:
        fixtureSandboxDir()
        "guest"
        approvalDeadline = 5
        buildTimeout = 120
        runTimeout = 2
      val spinning = execAudited:
        quick
        guest:
          """
            var i = 0
            while i >= 0 do i = i + 1

          """
        Map("HARPE_TEST_PARTIAL_AUDIT" ~ "1")
        Interact.unattended
      checkEquals("tag", tag(spinning.outcome), "timeout")
      checkAudit(spinning, "harpe.tools.runCode.timedOut")

def runCodeSuite(): Unit receives thisSuite = suite: "runCode tool", () =>
  // `jo build` writes shared output, so finish it once before the pool can
  // construct a tool from the fixture.
  thisSuite.beforeSuite = () => prepareSandbox()

  suite: "parallel cases", () =>
    thisSuite.parallel = true
    parallelCases()

  // Process environment is shared by every test thread, so this case runs only
  // after the parallel group joins. Restore the developer's value even when an
  // assertion or the tool itself fails.
  test: "honours the run.sh seam and scrubs the child environment", () =>
    val key = "ANTHROPIC_API_KEY"
    val hadKey = os.environ.contains(key)
    val previous = os.getenv(key, "")
    os.environ.set(key, "SECRET-should-not-leak")

    val attempted = py.try: checkScrubbedEnvironment()

    if hadKey then os.environ.set(key, previous)
    else
      val _ = os.environ.pop(key)
      pass

    match attempted
    case Ok(_) => pass
    case Err(error) => abort error.message
