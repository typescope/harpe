//[ ContractTest.jo — stateful OpenAI Responses contracts. //]

namespace harpe.test.integration.openaiResponses.ContractTest

import harpe.models.openai
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger
import harpe.test.framework.testing
import harpe.test.framework.suite
import harpe.test.framework.test
import harpe.test.framework.check
import harpe.test.integration.ProviderFixture
import harpe.test.integration.ModelDriver

private def model(server: ProviderFixture.Server) =
  openai("test-key", "test-model", baseUrl = server.baseUrl, timeoutSeconds = 2)

private def toolResponse(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "type": "response.completed",
    "sequence_number": 1,
    "response": {
      "id": "resp_tool", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "fc_1", "type": "function_call", "status": "completed",
        "arguments": "{\"city\":\"Zurich\"}", "call_id": "call_1", "name": "lookup"
      }],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 6, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 3, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 9
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def textResponse(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {"type":"response.output_text.delta","sequence_number":1,"item_id":"msg_done","output_index":0,"content_index":0,"delta":"do","logprobs":[]}

  data: {"type":"response.output_text.delta","sequence_number":2,"item_id":"msg_done","output_index":0,"content_index":0,"delta":"ne","logprobs":[]}

  data: {
    "type": "response.completed", "sequence_number": 3,
    "response": {
      "id": "resp_done", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "msg_done", "type": "message", "status": "completed", "role": "assistant",
        "content": [{"type":"output_text","text":"done","annotations":[],"logprobs":[]}]
      }],
      "parallel_tool_calls": true, "previous_response_id": "resp_tool",
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 8, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 2, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 10
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def helloResponse(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {"type":"response.output_text.delta","sequence_number":1,"item_id":"msg_test","output_index":0,"content_index":0,"delta":"hello","logprobs":[]}

  data: {
    "type": "response.completed", "sequence_number": 2,
    "response": {
      "id": "resp_test", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "msg_test", "type": "message", "status": "completed", "role": "assistant",
        "content": [{"type":"output_text","text":"hello","annotations":[],"logprobs":[]}]
      }],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 3, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 1, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 4
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def unavailable(): ProviderFixture.Response = ProviderFixture.response:
  "503 Service Unavailable"
  "application/json"
  """
    {"error":{"message":"unavailable","type":"server_error","code":"server_error"}}
    """

def contractSuite(): Unit receives testing, logger = suite: "contract", () =>
  test: "chains a tool call onto the stored response", () =>
    ProviderFixture.withResponses: [toolResponse(), textResponse()], server =>
      val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])
      val turn = ModelDriver.start(model(server), prompt = "What is the weather in Zurich?")

      val requested = turn.expectReply(tools = [tool])
      check("one tool call", requested.calls.size == 1)
      val call = requested.calls.get(0)
      check("tool id", call.id == "call_1")
      check("tool name", call.name == "lookup")
      check("tool arguments", call.input.string("city") == "Zurich")

      val answered = turn.expectReply(results = [ToolResult(call.id, "sunny", [])], tools = [tool])
      check("follow-up streams the answer", turn.streamed == "done")
      check("follow-up answer", answered.text == "done")
      check("follow-up has no calls", answered.calls.isEmpty)

      check("two requests", server.requestCount == 2)
      val first = server.recorded(0).jsonBody
      val second = server.recorded(1).jsonBody
      check("sends tool schema", first.get("tools").cast[py.List].size == 1)
      check:
        "chains successful response"
        second.get("previous_response_id").asString == "resp_tool"
      val input = second.get("input").cast[py.List]
      check:
        "sends tool result once"
        input.size == 1 && input.get(0).cast[py.Dict].get("call_id").asString == "call_1"

  test: "retry after 503 does not chain the failed response", () =>
    ProviderFixture.withResponses: [unavailable(), helloResponse()], server =>
      val turn = ModelDriver.start(model(server), prompt = "Say hello.")
      check("first attempt transient", turn.expectTransient() != "")

      val retried = turn.expectReply()
      check("retry streams the answer", turn.streamed == "hello")
      check("retry answer", retried.text == "hello")

      check("made two requests", server.requestCount == 2)
      check:
        "did not chain failure"
        !server.recorded(1).jsonBody.contains("previous_response_id")
