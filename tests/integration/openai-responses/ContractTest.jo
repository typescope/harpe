  """
  data: {"type":"response.output_text.delta","sequence_number":1,"item_id":"msg_test","output_index":0,"content_index":0,"delta":"hello","logprobs":[]}

  data: {
    "type": "response.completed", "sequence_number": 2,
    "response": {
      "id": "resp_test", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": "You are concise.", "max_output_tokens": 32, "model": "test-model",
      "output": [{
        "id": "msg_test", "type": "message", "status": "completed", "role": "assistant",
        "content": [{"type":"output_text","text":"hello","annotations":[],"logprobs":[]}]
      }],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 3, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 1, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 4
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

private def unavailable(): ProviderFixture.Response = ProviderFixture.response:
  "503 Service Unavailable"
  "application/json"
  """
    {"error":{"message":"unavailable","type":"server_error","code":"server_error"}}
    """

//[ A reply cut off by the token limit, mid tool call. //]
private def truncated(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {"type":"response.output_text.delta","sequence_number":1,"item_id":"msg_cut","output_index":0,"content_index":0,"delta":"Let me loo","logprobs":[]}

  data: {
    "type": "response.completed", "sequence_number": 2,
    "response": {
      "id": "resp_cut", "object": "response", "created_at": 0,
      "status": "incomplete", "error": null,
      "incomplete_details": {"reason":"max_output_tokens"},
      "instructions": null, "max_output_tokens": 32, "model": "test-model",
      "output": [
        {
          "id": "msg_cut", "type": "message", "status": "incomplete", "role": "assistant",
          "content": [{"type":"output_text","text":"Let me loo","annotations":[],"logprobs":[]}]
        },
        {
          "id": "fc_1", "type": "function_call", "status": "incomplete",
          "arguments": "{\"city\":\"Zur", "call_id": "call_1", "name": "lookup"
        }
      ],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 6, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 32, "output_tokens_details": {"reasoning_tokens":0}, "total_tokens": 38
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

//[ A second tool call, from its own stored response
  !
  ! Its `output` carries a reasoning item that stored mode must NOT replay: the
  ! server already holds it, and `previous_response_id` is what points at it.
//]
private def callsAgain(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "type": "response.completed", "sequence_number": 1,
    "response": {
      "id": "resp_second", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": null, "max_output_tokens": 32, "model": "test-model",
      "output": [
        {
          "id": "rs_1", "type": "reasoning",
          "summary": [{"type":"summary_text","text":"Now Geneva."}],
          "encrypted_content": "enc-abc"
        },
        {
          "id": "fc_2", "type": "function_call", "status": "completed",
          "arguments": "{\"city\":\"Geneva\"}", "call_id": "call_2", "name": "lookup"
        }
      ],
      "parallel_tool_calls": true, "previous_response_id": "resp_tool",
      "reasoning": {"effort":"medium","summary":null}, "store": true,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 9, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 3, "output_tokens_details": {"reasoning_tokens":2}, "total_tokens": 12
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

//[ A reply whose `output` carries a reasoning item before the call
  !
  ! Stored mode leaves this on the server. Stateless mode has to replay it, so
  ! it is the same wire shape read two different ways.
//]
private def reasonsThenCalls(): ProviderFixture.Response = ProviderFixture.sse:
  """
  data: {
    "type": "response.completed", "sequence_number": 1,
    "response": {
      "id": "resp_stateless", "object": "response", "created_at": 0,
      "status": "completed", "error": null, "incomplete_details": null,
      "instructions": null, "max_output_tokens": 32, "model": "test-model",
      "output": [
        {
          "id": "rs_1", "type": "reasoning",
          "summary": [{"type":"summary_text","text":"Zurich is in Switzerland."}],
          "encrypted_content": "enc-abc"
        },
        {
          "id": "fc_1", "type": "function_call", "status": "completed",
          "arguments": "{\"city\":\"Zurich\"}", "call_id": "call_1", "name": "lookup"
        }
      ],
      "parallel_tool_calls": true, "previous_response_id": null,
      "reasoning": {"effort":"medium","summary":null}, "store": false,
      "temperature": 1.0, "text": {"format":{"type":"text"}},
      "tool_choice": "auto", "tools": [], "top_p": 1.0, "truncation": "disabled",
      "usage": {
        "input_tokens": 6, "input_tokens_details": {"cached_tokens":0},
        "output_tokens": 3, "output_tokens_details": {"reasoning_tokens":2}, "total_tokens": 9
      },
      "metadata": {}
    }
  }

  data: [DONE]
  """

def contractSuite(): Unit receives testing, logger = suite: "contract", () =>
  test: "chains a tool call onto the stored response", () =>
    ProviderFixture.withResponses: [toolResponse(), textResponse()], server =>
      val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])
      val turn = ModelDriver.start(model(server), prompt = "What is the weather in Zurich?")

      val requested = turn.expectReply(tools = [tool])
      check("one tool call", requested.calls.size == 1)
      val call = requested.calls.get(0)
      check("tool id", call.id == "call_1")
      check("tool name", call.name == "lookup")
      check("tool arguments", call.input.string("city") == "Zurich")

      val answered = turn.expectReply(results = [ToolResult(call.id, "sunny", [])], tools = [tool])
      check("follow-up streams the answer", turn.streamed == "done")
      check("follow-up answer", answered.text == "done")
      check("follow-up has no calls", answered.calls.isEmpty)

      check("two requests", server.requestCount == 2)
      val first = server.recorded(0).jsonBody
      val second = server.recorded(1).jsonBody
      check("sends tool schema", first.get("tools").cast[py.List].size == 1)
      check:
        "chains successful response"
        second.get("previous_response_id").asString == "resp_tool"
      val input = second.get("input").cast[py.List]
      check:
        "sends tool result once"
        input.size == 1 && input.get(0).cast[py.Dict].get("call_id").asString == "call_1"

  test: "retry after 503 does not chain the failed response", () =>
    ProviderFixture.withResponses: [unavailable(), helloResponse()], server =>
      val turn = ModelDriver.start(model(server), prompt = "Say hello.")
      check("first attempt transient", turn.expectTransient() != "")

      val retried = turn.expectReply()
      check("retry streams the answer", turn.streamed == "hello")
      check("retry answer", retried.text == "hello")

      check("made two requests", server.requestCount == 2)
      check:
        "did not chain failure"
        !server.recorded(1).jsonBody.contains("previous_response_id")

  test: "keeps the text of a truncated reply and drops its calls", () =>
    ProviderFixture.withResponses: [truncated()], server =>
      val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])
      val message = ModelDriver.start(model(server), prompt = "What is the weather in Zurich?")
        .expectReply(tools = [tool])

      checkEquals:
        "marks the reply truncated"
        message.text
        expected = "Let me loo\n\n[Reply truncated: max_output_tokens reached.]"

      // The call was cut off mid-arguments, so running it would run a tool on
      // half its input. A truncated reply keeps none of them.
      check("drops the calls", message.calls.isEmpty)

  // Two bytes is a legal file and encodes to a base64 short enough to assert on
  // whole. Nothing here decodes it, so it needs no image structure — only the
  // mime type decides whether it is inlined at all.
  test: "inlines an attached image into the user message", () =>
    ProviderFixture.withResponses: [textResponse()], server =>
      val dir = tempfile.mkdtemp()
      val path = os.path.join(dir, "shot.png")
      File.writeBytes(path, py.dynamic("hi").callDynamic("encode", "utf-8"))
      val shot = new Attachment("shot.png", 2, "image/png", path)

      val _ = ModelDriver.start(model(server), prompt = "What is this?", files = [shot])
        .expectReply()

      val content = server.requestJson.get("input").cast[py.List]
        .get(0).cast[py.Dict].get("content").cast[py.List]
      val image = content.get(content.size - 1).cast[py.Dict]
      checkEquals("kind", image.get("type").asString, "input_image")
      checkEquals:
        "inlined bytes"
        image.get("image_url").asString
        expected = "data:image/png;base64,aGk="

  test: "advances the stored continuation with every round", () =>
    ProviderFixture.withResponses: [toolResponse(), callsAgain(), textResponse()], server =>
      val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])
      val turn = ModelDriver.start(model(server), prompt = "What is the weather in Zurich?")

      val _ = turn.expectReply(tools = [tool])
      val _ = turn.expectReply(results = [ToolResult("call_1", "sunny", [])], tools = [tool])
      val _ = turn.expectReply(results = [ToolResult("call_2", "sunny", [])], tools = [tool])

      check("three requests", server.requestCount == 3)
      check("the first opens the chain", !server.recorded(0).jsonBody.contains("previous_response_id"))
      checkEquals:
        "the second chains onto the first reply"
        server.recorded(1).jsonBody.get("previous_response_id").asString
        expected = "resp_tool"

      // The pointer has to MOVE. An adapter that set it once and never again
      // would satisfy every other assertion in this file.
      checkEquals:
        "the third chains onto the second, not the first"
        server.recorded(2).jsonBody.get("previous_response_id").asString
        expected = "resp_second"

      // Stored mode leaves reasoning on the server, so a round sends only what
      // is new — the opposite of what the stateless wires do.
      val input = server.recorded(2).jsonBody.get("input").cast[py.List]
      check("sends only the new result", input.size == 1)
      checkEquals:
        "and it is the newest call's"
        input.get(0).cast[py.Dict].get("call_id").asString
        expected = "call_2"

  // The same adapter, with storage off: no server-side state to point at, so
  // the turn tail travels in full on every request. Its sibling above pins the
  // stored half, and the two must not drift into each other.
  test: "replays raw output when storage is off, and asks for the reasoning to replay", () =>
    ProviderFixture.withResponses: [reasonsThenCalls(), textResponse()], server =>
      val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])
      val turn = ModelDriver.start(stateless(server), prompt = "What is the weather in Zurich?")

      val requested = turn.expectReply(tools = [tool])
      check("one tool call", requested.calls.size == 1)

      val _ = turn.expectReply(results = [ToolResult("call_1", "sunny", [])], tools = [tool])

      val first = server.recorded(0).jsonBody
      check("storage stays off", !first.get("store").asBool)

      // Without this the provider returns no encrypted reasoning, and the next
      // round has nothing to replay — the failure would surface as a rejected
      // request one round later, nowhere near its cause.
      var asksForReasoning = false
      for item in first.get("include").cast[py.List] do
        if item.asString == "reasoning.encrypted_content" then asksForReasoning = true
      check("asks the provider to return its reasoning", asksForReasoning)

      val second = server.recorded(1).jsonBody
      check("never chains a stored response", !second.contains("previous_response_id"))

      var reasoning: py.Dict = py.dict()
      var reasoningAt = -1
      var callAt = -1
      var resultAt = -1
      var i = 0
      for item in second.get("input").cast[py.List] do
        val entry = item.cast[py.Dict]
        val kind = entry.get("type", "").asString
        if kind == "reasoning" then
          reasoning = entry
          reasoningAt = i
        if kind == "function_call" then callAt = i
        if kind == "function_call_output" then resultAt = i
        i = i + 1

      check("replays the reasoning item", reasoningAt >= 0)
      checkEquals("keeping its id", reasoning.get("id").asString, "rs_1")
      checkEquals("and its opaque payload", reasoning.get("encrypted_content").asString, "enc-abc")
      check("in the order the provider produced them", reasoningAt < callAt && callAt < resultAt)
