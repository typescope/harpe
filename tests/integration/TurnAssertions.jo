//[ TurnAssertions.jo
  !
  ! Assertions and interaction recording shared by provider scenarios. Wire
  ! transcripts remain in their individual scenario files.
  !
  ! These say what a correct turn looks like, not which scenario is being run.
  ! The test's own path supplies that, so a failure reads as
  ! `openai/chat/tool round trip: one tool call`.
//]

namespace harpe.test.integration

import harpe.Interact
import harpe.Approvals
import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.turns.TurnEvent
import harpe.logging.logger

section TurnAssertions
  //[ Fail the enclosing test with `label` unless `cond` holds. //]
  def check(label: String, cond: Bool): Unit =
    assert: cond, label

  private class RecordingInteract
    view Interact

    var chunks: List[String] = []

    def cancelled: Bool = false
    def pause(seconds: Float): Bool = false
    def approve(request: Approvals.Request): Approvals.Decision = Approvals.Cancelled

    def emit(event: TurnEvent): Unit =
      if event is TurnEvent.AssistantChunk(text) then chunks = chunks + text
  end

  private def base(): Rendered =
    new Rendered("You are concise.", [UserInput("Say hello.", [])])

  private def runModel(model: Model, interact: RecordingInteract): ReplyResult receives logger =
    model.startTurn(base(), 32).reply([], [], interact)

  def checkTextReply(model: Model, expectedInput: Int, expectedOutput: Int): Unit receives logger =
    val interact = new RecordingInteract
    match runModel(model, interact)
    case Reply(message, usage) =>
      check("chunks", interact.chunks.size == 2 && interact.chunks.join("") == "hello")
      check("answer", message.text == "hello")
      check("no tool calls", message.calls.isEmpty)
      check("input usage", usage.inputTokens == expectedInput)
      check("output usage", usage.outputTokens == expectedOutput)
    case Transient(detail) => abort "unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "unexpectedly fatal: \{detail}"

  def checkRetryAfter(model: Model, seconds: Float): Unit receives logger =
    match runModel(model, new RecordingInteract)
    case RetryAfter(detail, actual) =>
      check("classified rate limited", detail != "")
      check("retry-after", actual == seconds)
    case Transient(detail) => abort "omitted retry-after: \{detail}"
    case Fatal(detail) => abort "unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "unexpectedly succeeded"

  def checkTransient(model: Model): Unit receives logger =
    match runModel(model, new RecordingInteract)
    case Transient(detail) => check("classified transient", detail != "")
    case RetryAfter(detail, _) => abort "unexpectedly supplied retry-after: \{detail}"
    case Fatal(detail) => abort "unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "unexpectedly succeeded"

  def checkFatal(model: Model): Unit receives logger =
    match runModel(model, new RecordingInteract)
    case Fatal(detail) => check("classified fatal", detail != "")
    case Transient(detail) => abort "unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "unexpectedly rate limited: \{detail}"
    case Reply(_, _) => abort "unexpectedly succeeded"

  def checkToolRoundTrip(model: Model): Unit receives logger =
    val session = model.startTurn(base(), 32)
    val tool = Tool("lookup", "Look up weather", [Tool.strParam("city", "City to look up")])

    match session.reply([], [tool], new RecordingInteract)
    case Reply(message, _) =>
      check("one tool call", message.calls.size == 1)
      val call = message.calls.get(0)
      check("tool id", call.id == "call_1")
      check("tool name", call.name == "lookup")
      check("tool arguments", call.input.string("city") == "Zurich")
    case Transient(detail) => abort "tool call unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "tool call unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "tool call unexpectedly fatal: \{detail}"

    val result = ToolResult("call_1", "sunny", [])
    val interact = new RecordingInteract
    match session.reply([result], [tool], interact)
    case Reply(message, _) =>
      check("follow-up chunks", interact.chunks.join("") == "done")
      check("follow-up answer", message.text == "done")
      check("follow-up has no calls", message.calls.isEmpty)
    case Transient(detail) => abort "follow-up unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "follow-up unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "follow-up unexpectedly fatal: \{detail}"

  def checkRetryThenText(model: Model): Unit receives logger =
    val session = model.startTurn(base(), 32)
    match session.reply([], [], new RecordingInteract)
    case Transient(detail) => check("first attempt transient", detail != "")
    case RetryAfter(detail, _) => abort "first attempt unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "first attempt unexpectedly fatal: \{detail}"
    case Reply(_, _) => abort "first attempt unexpectedly succeeded"

    val interact = new RecordingInteract
    match session.reply([], [], interact)
    case Reply(message, _) =>
      check("retry chunks", interact.chunks.join("") == "hello")
      check("retry answer", message.text == "hello")
    case Transient(detail) => abort "retry unexpectedly transient: \{detail}"
    case RetryAfter(detail, _) => abort "retry unexpectedly rate limited: \{detail}"
    case Fatal(detail) => abort "retry unexpectedly fatal: \{detail}"
end
