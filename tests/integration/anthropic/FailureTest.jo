//[ FailureTest.jo — Anthropic HTTP failure classification. //]

namespace harpe.test.integration.anthropic.FailureTest

import harpe.models.anthropic
import harpe.models.Anthropic
import harpe.logging.logger
import harpe.logging.Logger
import harpe.logging.Entry
import harpe.testing.thisSuite
import harpe.testing.suite
import harpe.testing.test
import harpe.testing.check
import harpe.test.integration.ProviderFixture
import harpe.test.integration.ModelDriver

private def failure(status: String, kind: String, message: String): ProviderFixture.Response =
  ProviderFixture.response:
    status
    "application/json"
    """
      {"type":"error","error":{"type":"\{kind}","message":"\{message}"}}
      """

// Keeps the last `harpe.model.failed` record — how one attempt that produced no
// reply is reported, and by whom.
private class ModelRecords
  view Logger

  var category: String = ""
  var provider: String = ""
  var model: String = ""
  var status: Int = 0
  var retryable: Bool = false

  def logEntry(entry: Entry): Unit =
    if entry.category == "harpe.model.failed" then
      val d = Entry.toDict(entry)
      category = entry.category
      provider = d.get("provider", "").asString
      model = d.get("model", "").asString
      status = d.get("status", 0).asInt
      retryable = d.get("retryable", false).asBool

  def close(): Unit = pass
end

private def model(server: ProviderFixture.Server) =
  anthropic("test-key", "test-model", Anthropic.NoCache, timeoutSeconds = 2, baseUrl = server.origin)

def failureSuite(): Unit receives thisSuite, logger = suite: "failure", () =>
  test: "429 reports the Retry-After delay", () =>
    val limited = new ProviderFixture.Response:
      "429 Too Many Requests"
      py.list:
        py.tuple("Content-Type", "application/json")
        py.tuple("Retry-After", "5")
      [
        """
        {"type":"error","error":{"type":"rate_limit_error","message":"slow down"}}
        """
      ]
    ProviderFixture.withResponses: [limited], server =>
      val turn = ModelDriver.start(model(server), prompt = "Say hello.")
      val detail = turn.expectRetryAfter()
      check("classified rate limited", detail != "")
      check("retry-after", turn.retryAfterSeconds == 5.0)

  test: "529 is transient", () =>
    ProviderFixture.withResponses: [failure("529 Overloaded", "overloaded_error", "busy")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")
      check("one request", server.requestCount == 1)

  test: "401 is fatal", () =>
    ProviderFixture.withResponses: [failure("401 Unauthorized", "authentication_error", "bad key")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  // A failed request must name the model that failed, the same way a successful
  // one does — otherwise a wrong key is a 401 with nothing to attribute it to.
  test: "a failed attempt records which model failed, and why", () =>
    ProviderFixture.withResponses: [failure("401 Unauthorized", "authentication_error", "bad key")], server =>
      val records = new ModelRecords
      with logger = records in
        val _ = ModelDriver.start(model(server), prompt = "Say hello.").expectFatal()

      check("category", records.category == "harpe.model.failed")
      check("provider", records.provider == "anthropic")
      check("model", records.model == "test-model")
      check("status", records.status == 401)
      check("not retryable", !records.retryable)

  test: "a malformed stream is fatal", () =>
    ProviderFixture.withResponses: [ProviderFixture.sse("event: message_start\ndata: {not-json}")], server =>
      val detail = ModelDriver.start(model(server), prompt = "Say hello.").expectFatal()
      check("classified fatal", detail != "")

  // Every other failure here arrives as an HTTP status. This one never becomes
  // one: the server holds the request open past the client's own deadline, so
  // the SDK gives up locally and `Classify` has only the exception type to go
  // on. Retrying is right — nothing reached the model.
  test: "a client-side timeout is transient", () =>
    ProviderFixture.withResponses: [ProviderFixture.stalled(3.0)], server =>
      val impatient = anthropic("test-key", "test-model", Anthropic.NoCache, timeoutSeconds = 1, baseUrl = server.origin)
      val detail = ModelDriver.start(impatient, prompt = "Say hello.").expectTransient()
      check("classified transient", detail != "")
