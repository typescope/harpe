//[ Markdown.jo
  !
  ! Renders the Markdown the model writes into the subset of HTML that Telegram
  ! accepts, using a real CommonMark parser (`markdown-it-py` — the same engine
  ! the web agent's page uses) instead of ad-hoc regexes.
  !
  ! Telegram only allows a handful of tags (b/i/s/u, a, code, pre, blockquote),
  ! so the library's own HTML output (p, ul, h1, …) would be rejected with a
  ! 400. We therefore walk the parser's TOKEN stream and render each construct
  ! into that subset: headings become bold lines, lists become indented
  ! bullet/number lines, paragraphs become blank-line separation. Raw HTML in
  ! the input is escaped to literal text, so the output never carries a tag we
  ! didn't emit — and the client still falls back to plain text if Telegram
  ! rejects a message anyway.
//]

namespace harpe.telegram
import harpe.ffi.builtins


section Markdown
  private def parser: py.Dynamic = py.module("markdown_it").MarkdownIt()

  //[ Render Markdown as Telegram-safe HTML. //]
  def toHtml(md: String): String =
    val tokens = parser.parse(py.dynamic(md)).cast[py.List]
    val out = renderBlocks(tokens)

    // Tidy: no blank lines before a closing blockquote, at most one blank line
    // between blocks, no leading/trailing whitespace.
    val re = py.module("re")
    var s = re.sub("\n+</blockquote>", "</blockquote>", py.dynamic(out))
    s = re.sub("\n{3,}", "\n\n", s)
    s.asString.trim

  //[ Escape the characters that are special in Telegram HTML text. //]
  private def esc(s: String): String =
    py.dynamic(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").asString

  //[ Escape an attribute value (additionally quotes). //]
  private def escAttr(s: String): String =
    py.dynamic(esc(s)).replace("\"", "&quot;").asString

  // In the list-nesting stack, a bullet list is this marker. An ordered list
  // holds its next item number instead.
  private def bullet(): Int = 0 - 1

  //[ Render the block-level token stream
    !
    ! `lists` tracks nesting: one entry per open list (bullet marker or the next
    ! ordinal), which yields the item prefixes and the indentation depth.
  //]
  private def renderBlocks(tokens: py.List): String =
    var s = ""
    var lists: List[Int] = []

    var i = 0

    while i < tokens.size do
      val t = tokens.get(i)
      i = i + 1
      val kind = builtins.getattr(t, "type").asString

      // Tight-list paragraphs are marked hidden by the parser: skip them, so
      // list items stay single lines.
      if t.hidden.asBool then continue

      if kind == "inline" then
        s = s + renderInline(t.children.cast[py.List])

      else if kind == "paragraph_close" then
        s = s + "\n\n"

      else if kind == "heading_open" then
        s = s + "<b>"

      else if kind == "heading_close" then
        s = s + "</b>\n\n"

      else if kind == "fence" || kind == "code_block" then
        val code = esc(t.content.asString)
        val lang = t.info.asString.trim

        if kind == "fence" && lang != "" then
          s = s + "<pre><code class=\"language-" + escAttr(lang) + "\">" + code + "</code></pre>\n\n"
        else
          s = s + "<pre>" + code + "</pre>\n\n"

      else if kind == "bullet_list_open" then
        lists = lists + bullet()

      else if kind == "ordered_list_open" then
        lists = lists + 1

      else if kind == "bullet_list_close" || kind == "ordered_list_close" then
        lists = lists.take(lists.size - 1)

        if lists.isEmpty then s = s + "\n"

      else if kind == "list_item_open" then
        // A nested list opens before its parent item's line has ended: make
        // sure every item starts on a fresh line.
        if s != "" && !s.endsWith("\n") then s = s + "\n"

        var indent = ""
        var d = 1

        while d < lists.size do
          indent = indent + "  "
          d = d + 1

        val n = lists.get(lists.size - 1)

        if n == bullet() then
          s = s + indent + "• "
        else
          s = s + indent + "\{n}. "
          lists = lists.take(lists.size - 1) + (n + 1)

      else if kind == "list_item_close" then
        s = s + "\n"

      else if kind == "blockquote_open" then
        s = s + "<blockquote>"

      else if kind == "blockquote_close" then
        s = s + "</blockquote>\n\n"

      else if kind == "hr" then
        s = s + "———\n\n"

      else if t.content.asString != "" then
        // Anything unrecognised (html_block, …) becomes escaped literal text.
        s = s + esc(t.content.asString) + "\n\n"

    s

  //[ Render one inline token stream (the children of an `inline` token). //]
  private def renderInline(children: py.List): String =
    var s = ""
    var i = 0

    while i < children.size do
      val t = children.get(i)
      i = i + 1
      val kind = builtins.getattr(t, "type").asString

      if kind == "text" then
        s = s + esc(t.content.asString)

      else if kind == "code_inline" then
        s = s + "<code>" + esc(t.content.asString) + "</code>"

      else if kind == "strong_open" then s = s + "<b>"
      else if kind == "strong_close" then s = s + "</b>"
      else if kind == "em_open" then s = s + "<i>"
      else if kind == "em_close" then s = s + "</i>"
      else if kind == "s_open" then s = s + "<s>"
      else if kind == "s_close" then s = s + "</s>"

      else if kind == "link_open" then
        val href = t.attrGet("href")
        val url = if href.isNone then "" else href.asString
        s = s + "<a href=\"" + escAttr(url) + "\">"

      else if kind == "link_close" then
        s = s + "</a>"

      else if kind == "softbreak" || kind == "hardbreak" then
        s = s + "\n"

      else if t.content.asString != "" then
        // image alt text, raw html_inline, … — escaped literal text.
        s = s + esc(t.content.asString)

    s
end
