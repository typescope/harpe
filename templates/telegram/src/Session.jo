//[ Session.jo
  !
  ! The Telegram driver's live conversation object (`Session`) and its storage layout
  ! (the `Session` section): one conversation per Telegram chat, keyed by its numeric
  ! `chat.id`, persisted as `logs/sessions/<chatId>.jsonl` under the agent's home. The
  ! chat id is the natural session key — it is stable across messages and survives
  ! restarts, so a chat resumes its history simply by reappearing.
  !
  ! Like the web driver, this layout is a *driver* decision: the section maps a
  ! chat id to its structured log and derives its transcript when loading.
//]

namespace telegram
import harpe.ffi.time
import harpe.ffi.os
import harpe.util.File
import harpe.ffi.builtins

import harpe.Agent
import harpe.Toolset
import harpe.transcript.Journal
import harpe.logging.JsonlLogger
import harpe.logging.Logger
import harpe.logging.TeeLogger
import harpe.logging.logger
import harpe.Model
import harpe.Tool
import harpe.Tool.ToolInput
import harpe.turns.TurnData
import harpe.Context
import harpe.Model.Message
import harpe.Model.UserInput
import harpe.Model.Assistant
import harpe.Model.Attachment
import harpe.turns.TurnResult
import harpe.logging.Value


//[ One file the user attached to a Telegram message
  !
  ! As the poll loop hands it to the chat's worker: Telegram's `file_id`
  ! (resolved to bytes only when the turn runs, off the poll thread), a
  ! suggested basename, and the mime type Telegram reported (`""` if none —
  ! guessed from the name at download time).
//]
class FileSpec(fileId: String, name: String, mime: String)

//[ One queued message for a chat's worker
  !
  ! The text (a plain message, or a media caption) and any files that rode with
  ! it. This is the unit the poll loop enqueues and the worker drains —
  ! replacing the bare text string, so a message can now carry attachments.
//]
class Incoming(id: String, text: String, files: List[FileSpec], senderId: String)


//[ One live conversation
  !
  ! Its chat id, its append log, and the pieces each of its turns is run with:
  ! the `brain`, the `tools` it is offered, the `routes` that run them, and the
  ! `context`, which owns the running transcript window and is therefore the one
  ! piece that must survive between turns. Plus its working memory.
  !
  ! Each session has a FIFO `queue` drained by its own dedicated worker thread,
  ! so turns for different chats run concurrently while turns within one chat
  ! stay ordered and serialized. Only that worker touches the session's state,
  ! so no lock is needed around it.
//]
private class Session(
    id: String, log: Logger, brain: Model, tools: Toolset, context: Context,
    dataDir: String)
  val queue = py.module("queue").Queue()

  //[ This chat's conversation, recorded into its own log.
    !
    ! This driver writes the two halves of the bracket from different threads,
    ! so it uses `request` and `response` directly rather than `turn`.
  //]
  val transcript = new Journal(log)

  //[ Begin a user turn
    !
    ! Download any attached files into the session's data directory (so the
    ! agent can read them with `fs`), run the turn, then deliver its answer —
    ! the text reply plus any files the agent `sendFile`d back.
  //]
  def runTurn(
      incoming: Incoming,
      client: TelegramClient,
      approvalHandler: TelegramApprovalHandler)
  : Unit =
    // The bracket is opened HERE, on the worker thread that runs the turn — not
    // where the message was queued. A journal holds one conversation and pairs
    // its records in order, so two brackets must never overlap, and queuing on
    // the poll thread while a turn is in flight would overlap them. How long the
    // message waited is a `telegram.queued` diagnostic instead.
    val request = Journal.payload:
      "messageId" ~ incoming.id
      "text" ~ incoming.text
      "files" ~ Session.fileNames(incoming.files)

    transcript.request(request)
    transcript.response(run(incoming, client, approvalHandler))

  //[ One turn, from downloading its files to delivering its answer. //]
  private def run(
      incoming: Incoming,
      client: TelegramClient,
      approvalHandler: TelegramApprovalHandler)
  : Value =
    val attachments = materialize(incoming, client)

    // Told, not shown: the downloaded files stay on disk and cost nothing until
    // the agent reaches for one with `fs` or `uploadMedia`. `Model.userContent`
    // builds the same manifest the render layer would, so what the model reads
    // is unchanged — the token policy just lives with the driver now.
    val prompt = Model.userContent(incoming.text, attachments)
    val channel = new TelegramInteract(client, this.id, approvalHandler)

    val result = with logger = log in
      Agent.ask:
        prompt
        brain = brain
        tools = tools
        interact = channel
        context = context

    // Whether anything actually reached the chat. The engine cannot know it —
    // an answered turn with empty text sends nothing — and it is the one thing
    // worth closing the transcript's bracket with here.
    var delivered = false

    match result.result
    case TurnResult.Success =>
      val answer = result.finalText
      if answer.trim != "" then
        client.sendMessage(this.id, answer)
        delivered = true

    case TurnResult.Interrupted => pass

    case TurnResult.Failed(detail) =>
      val message =
        if detail == "" then "Request failed. Please try again."
        else "Request failed: \{detail}"
      client.sendMessage(this.id, message)
      delivered = true

    // The driver's reading of the finished turn, closing the bracket.
    Journal.payload("delivered" ~ delivered, "sent" ~ Session.sent(result))

  //[ Download this turn's attached files into the session's data directory
    !
    ! Returning them as `Attachment` metadata for the `UserInput`. The bytes land
    ! on disk (so the agent reads them with `fs`). Only the metadata rides in
    ! the transcript. A file that fails to resolve or download is skipped rather
    ! than failing the turn — the model still sees the ones that arrived. Runs
    ! on the chat's worker thread, so the network I/O never blocks the poll
    ! loop.
  //]
  private def materialize(incoming: Incoming, client: TelegramClient): List[Attachment] =
    val dir = dataDir

    if dir == "" || incoming.files.isEmpty then []
    else
      var atts: List[Attachment] = []
      for spec in incoming.files do
        match client.getFile(spec.fileId)
        case None => pass

        case Some(remotePath) =>
          match client.downloadFile(remotePath)
          case None => pass

          case Some(data) =>
            val name = uniqueName(dir, sanitizeName(spec.name))
            if name != "" then
              File.writeBytes(os.path.join(dir, name), data)
              val mime = if spec.mime != "" then spec.mime
                         else File.mimeType(name).getOrElse("application/octet-stream")
              val att = Attachment:
                name
                builtins.len(data)
                mime
                path = os.path.join(dir, name)
              atts = atts + att

      atts

end

//[ Reduce a client-supplied name to a safe bare basename
  !
  ! Drop any directory part (both separators) and reject the traversal names, so
  ! a stored or sent file can never escape the session's data directory. "" if
  ! nothing safe remains.
//]
private def sanitizeName(raw: String): String =
  val base = os.path.basename(raw.replace("\\", "/"))
  if base == "" || base == "." || base == ".." then "" else base

//[ A name not already taken in `dir`
  !
  ! `photo.jpg` → `photo-1.jpg` → … so a download never clobbers an existing
  ! file.
//]
private def uniqueName(dir: String, name: String): String =
  if name == "" || !os.path.exists(os.path.join(dir, name)) then name
  else
    val ext = File.extname(name)
    val root = if ext == "" then name else name.substring(0, name.size - ext.size)
    var i = 1
    var candidate = root + "-" + i.toString + ext
    while os.path.exists(os.path.join(dir, candidate)) do
      i = i + 1
      candidate = root + "-" + i.toString + ext
    candidate

section Session
  //[ The file backing this chat's session. //]
  def sessionPath(chatId: String): String receives appHome =
    os.path.join(appHome, "logs/sessions", chatId + ".jsonl")

  //[ The per-chat data directory
    !
    ! The private root the sandbox grants this session as `HARPE_DATA_DIR`, so
    ! `fs` (and the document readers) see only this chat's files. Downloaded
    ! attachments land here, and files the agent writes surface here too.
    ! Created on demand. Scoped by chat id so chats never share a tree.
  //]
  def dataDir(chatId: String): String receives appHome =
    val dir = os.path.join(appHome, "data", chatId)
    if !os.path.isdir(dir) then File.ensureDir(dir)
    dir

  //[ An append log for this chat's session (its file is created lazily). //]
  def forSession(chatId: String, viewLog: Logger): Logger receives appHome =
    new TeeLogger([new JsonlLogger(sessionPath(chatId)), viewLog])

  //[ The files this turn delivered, in the order the agent sent them
    !
    ! `sendFile` is the agent's channel for putting a file in front of the user,
    ! so its deliveries are a high-level OUTPUT of the turn. Recorded as fact
    ! here rather than inferred later by matching tool names against the journal.
  //]
  def sent(turn: TurnData): Value =
    var names: List[Value] = []
    for m in turn.messages do
      if m is Assistant(_, calls) then
        for c in calls if c.name == "sendFile" do names = names + c.input.string("fileName")
    names

  //[ The names of the files that arrived with a message. //]
  def fileNames(files: List[FileSpec]): Value =
    var names: List[Value] = []
    for f in files do names = names + f.name
    names

  //[ Reconstruct this chat's conversation from disk
    !
    ! `[]` if it has no file yet, so a chat seen for the first time starts
    ! empty.
  //]
  def load(chatId: String): List[Message] receives appHome =
    val path = sessionPath(chatId)
    if !File.exists(path) then []
    else Journal.load(path)
end
