namespace pr.review

import jo.IO.stdout
import jo.IO.args
import harpe.*
import harpe.util.File
import harpe.ffi.os
import harpe.ffi.time
import harpe.util.Process
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.logger
import harpe.Model.UserInput
import harpe.turns.TurnResult
import harpe.tools.RunCodeTool
import harpe.tools.SkillTools
import harpe.context.FullContext

//[ Where this application's files live: `sandbox/`, `skills/`, `logs/`, `prompts/SYSTEM.md`
  ! — its own convention, not the framework's.
//]
param appHome: String

//[ agent entry point  //]
def main(): Unit receives args, stdout =
  if args.size < 1 then
    abort "Missing PR source argument"

  val pr = args[0]

  Process.loadDotenv(".env")
  with appHome = os.path.abspath(".") in
    Logging.withLogger:
      new JsonlLogger: os.path.join(appHome, "logs/agent.jsonl")
      () => review(pr)

private def review(pr: String): Unit receives stdout, appHome, logger =
  val basePrompt = File.read(os.path.join(appHome, "prompts/SYSTEM.md"))
  val runCode = RunCodeTool(os.path.join(appHome, "sandbox"), approvalDeadline = 610)
  val skillsDir = os.path.join(appHome, "skills")

  val context = new FullContext(basePrompt, [])
  val channel = new PrintInteract(stdout)

  // This agent's own context reaches its tools as ordinary arguments: the guest
  // environment `runCode` grants the reviewed program is written right here.
  val guestEnv = Map:
    "PR_URL" ~ pr
    "GITHUB_TOKEN" ~ os.getenv("GITHUB_TOKEN", "")

  val tools =
    SkillTools.toolset(skillsDir)
      ++ runCode.toolset(guestEnv)

  val turn =
    Agent.ask:
        "please start review the pr"
        brain = Model.default()
        tools = tools
        context = context
        maxToolRounds = 30
        interact = channel

  match turn.result
  case TurnResult.Success =>
    println ("  · review completed: " + turn.text)

  case _ =>
    println "  · review failed"

end
