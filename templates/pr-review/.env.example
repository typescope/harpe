# Copy to .env and fill in. The agent loads .env on startup.

# --- GitHub (required) ---
# A personal access token carrying the `repo` scope. The model never sees it:
# it is granted to the sandboxed program's environment, and the program reaches
# GitHub through the capability in sandbox/API.jo.
GITHUB_TOKEN=

# Set one provider key. The provider is chosen by which key you set: OpenAI
# first, then OpenRouter, then Anthropic.

# --- Anthropic (default) ---
MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# --- OpenAI (Responses API) ---
# MODEL=gpt-5.6
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # optional: Azure OpenAI or another Responses-API endpoint

# --- OpenRouter ---
# OpenRouter has no default model, so MODEL is required with it.
# MODEL=
# OPENROUTER_API_KEY=
