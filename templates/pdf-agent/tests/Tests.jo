//[ Tests.jo
  !
  ! The entry point for this agent's suite: `jo test`, or `jo run tests`.
  !
  ! Every scenario builds this agent through its own `jo.toml`, starts it as its
  ! own process, and drives it over HTTP against a scripted model on localhost.
  ! Nothing reaches the network and no API key is needed. A scenario that fails
  ! leaves its temporary agent home in place and quotes what the agent had
  ! printed, both named in the failure.
//]

namespace pdf.agent.tests.Main

import jo.IO.stdout
import jo.IO.args
import harpe.logging.Logging
import harpe.logging.logger
import harpe.testing.Testing
import harpe.testing.Runner
import harpe.testing.suite
import harpe.testing.thisSuite
import pdf.agent.tests.WebTest

def main(): Unit receives stdout, args =
  Logging.withLogger(Logging.discard, () => run())

private def run(): Unit receives stdout, logger, args =
  val root = Testing.define("pdf-agent", () => suites())
  val passed = Runner.runWithArgs(root)
  if !passed then py.module("sys").exit(1)

  println ""
  println "all PDF processing agent tests passed"

private def suites(): Unit receives thisSuite, logger =
  suite: "e2e", () =>
    thisSuite.parallel = true
    WebTest.webSuite()
