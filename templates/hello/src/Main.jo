// A deliberately small Harpe application. The complete CLI template adds
// history, cancellation, progress rendering, memory, and structured logs.
namespace hello

import jo.IO.stdout
import harpe.*
import harpe.Model.UserInput
import harpe.context.FullContext
import harpe.util.Process
import harpe.util.File
import harpe.ffi.os
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.TeeLogger
import harpe.logging.logger
import harpe.observability.ViewLogger
import harpe.observability.Viewer
import harpe.tools.RunCodeTool
import harpe.tools.SkillTools
import harpe.turns.TurnResult

def main(): Unit receives stdout =
  Process.loadDotenv(".env")
  File.ensureDir("logs")
  val host = os.getenv("VIEW_HOST", "127.0.0.1")
  val port = Int.parse(os.getenv("VIEW_PORT", "8766")) rescue None => 8766
  val viewLog = new ViewLogger(capacity = 5000)
  Viewer.start(viewLog, "Hello · harpe journal", host, port)
  println "Logs at http://\{host}:\{port}"
  Logging.withLogger(new TeeLogger([new JsonlLogger("logs/agent.jsonl"), viewLog]), () => chat())

// This application keeps its files beside itself — `sandbox/`, `data/`, and
// `prompts/SYSTEM.md` — and is run from its own directory, so paths are relative to it.
// That is this application's arrangement, not the framework's: every tool below
// is handed the directory it works in.
private def chat(): Unit receives stdout, logger =
  val runCode = RunCodeTool(os.path.abspath("sandbox"), approvalDeadline = 610)

  val brain = Model.default()

  // The context is the one piece that must outlive a turn: it carries the
  // conversation from one turn to the next.
  val context = new FullContext:
    baseSystem = File.read("prompts/SYSTEM.md")
    initial = []

  // Skills give the model Jo syntax on demand without carrying the full
  // reference in every prompt.
  val tools = SkillTools.toolset(os.path.abspath("skills")) ++ runCode.toolset()

  val data = os.path.abspath("data")
  File.ensureDir(data)
  val dataDir = data
  val channel = new SimpleInteract

  println "Ask the agent something. Type 'quit' to stop."

  while true do
    val input = py.input("\nYou ▸ ").trim
    if input == "quit" then break
    if input == "" then continue

    val result =
      Agent.ask:
          input
          brain = brain
          tools = tools
          context = context
          maxToolRounds = 10
          maxRetries = 2
          interact = channel

    match result.result
    case TurnResult.Success => println "\nAgent ▸ \{result.text}"
    case _       => println "\nThe turn failed. Try again."
  end
end

private class SimpleInteract
  view Interact

  def cancelled: Bool = false

  def pause(seconds: Float): Bool =
    py.module("time").sleep(py.dynamic(seconds))
    false

  def approve(title: String, detail: String): Approvals.Decision =
    Approvals.Cancelled

  def emit(event: harpe.turns.TurnEvent): Unit = pass
end
