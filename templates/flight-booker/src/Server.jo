//[ WebServer.jo
  !
  ! The flight-booker HTTP server: a minimal WSGI application that routes
  ! browser requests and drives the shared turn engine. One `FlightServer` is
  ! built per process and holds a registry of live sessions.
  !
  ! Routes:
  !   GET  /             the chat page
  !   GET  /api/info     agent name (for the page title)
  !   POST /api/message  start one turn, and answer at once
  !   GET  /api/events   the turn's events after a cursor, which the page polls
  !   POST /api/stop     request cancellation of a session's running turn
  !   POST /api/approval resolve the pending booking approval
  !
  ! A TURN DOES NOT ANSWER ITS OWN REQUEST. `POST /api/message` starts the turn
  ! on a thread of its own and returns the session id immediately; the page then
  ! polls `GET /api/events` for what it has not seen. WSGI pins one worker
  ! thread for a response's whole life, so a turn answering down its own
  ! connection would hold a worker for as long as the turn took — and how long
  ! that is is the one thing nobody can predict.
  !
  ! Sessions are keyed by a time-sortable id minted on first message, stored by
  ! the browser in localStorage so the conversation survives page refreshes (as
  ! long as the server is still running and the session is in memory).
//]

namespace flight.booker

import harpe.ffi.secrets
import harpe.ffi.time
import harpe.ffi.json
import harpe.ffi.os
import harpe.ffi.threading
import harpe.util.Clock
import harpe.util.File

import harpe.context.WindowedContext
import harpe.transcript.Journal
import harpe.logging.logger
import harpe.logging.TeeLogger
import harpe.Model
import harpe.Toolset
import harpe.Tool
import harpe.server.Http
import harpe.server.Request
import harpe.server.request
import harpe.server.Response
import harpe.observability.ViewLogger
import harpe.observability.Viewer


class Server(brain: Model, home: String, sandboxEnv: Map[String, String], viewLog: ViewLogger)
  private val registry = py.dict()
  private val registryLock = threading.Lock()
  private val runTool: harpe.tools.RunCodeTool =
    harpe.tools.RunCodeTool(os.path.join(home, "sandbox"), approvalDeadline = 610)

  //[ The route table's fallback: re-establish `appHome` from the server's field, then match. //]
  def route(): Response receives request =
    with appHome = home in dispatch()

  private def dispatch(): Response receives request, appHome =
    match request
    case Request.Get("/")              => page()
    case Request.Get("/journal")       => Viewer.respond(viewLog, "Sky · harpe journal")
    case Request.Get("/api/info")      => Response.json(py.dict("name" ~ "Sky"))
    case Request.Get("/api/events")    => handleEvents()
    case Request.Post("/api/message")  => handleMessage()
    case Request.Post("/api/stop")     => handleStop()
    case Request.Post("/api/approval") => handleApproval()
    case _                             => Response.notFound()

  //[ Serve the chat page from assets/index.html. //]
  private def page(): Response receives request, appHome =
    Response.html(File.read(os.path.join(appHome, "assets/index.html")))

  //[ Start one agent turn, and answer at once with the session to poll.
    !
    ! A request without a `session` field mints a new one. A request with a
    ! `session` resumes the existing session from the in-memory registry. The
    ! answer always names the session so the browser can store (or confirm) the
    ! id, and carries the cursor to start polling `/api/events` from.
    !
    ! The turn runs on a daemon thread. Nothing waits for it here: a turn takes
    ! as long as it takes, and a request thread is too scarce to spend on that.
  //]
  private def handleMessage(): Response receives request, appHome =
    val body = request.json() rescue None => return Response.badRequest("expected a JSON object")
    val text = body.get("text", "").asString
    val reqId = body.get("session", "").asString
    val requestedId = sanitizeSessionId(reqId)

    if reqId != "" && requestedId != reqId then
      return Response.badRequest("invalid session")
    if text.trim == "" then
      return Response.badRequest("empty message")

    evictIdle()
    val session = if reqId == "" then createSession() else resumeSession(requestedId)

    // The cursor before this turn adds anything, so the page polls from here
    // and sees the whole turn however late its first poll lands.
    val from = session.cursor

    // Counted before the thread starts, so a page that polls at once is told a
    // turn is running rather than racing the thread about to start one.
    session.beginTurn()

    val turnRequest = Journal.payload("text" ~ text)
    val runner = threading.Thread:
      target = () => session.runTurn(turnRequest, text)
      daemon = true
    runner.start()

    Response.json(py.dict("session" ~ session.id, "from" ~ from))

  //[ The events a session has produced since `seen`, which the page polls for.
    !
    ! Costs a list slice, so it is cheap to ask often. `active` tells the page
    ! whether a turn is still running, which is how it knows to keep asking.
  //]
  private def handleEvents(): Response receives request =
    val requested = request.query("session").getOrElse("")
    val id = sanitizeSessionId(requested)
    val seen = Int.parse(request.query("seen").getOrElse("0")) rescue None => 0

    registryLock.acquire()
    val found: Option[Session] =
      if id == requested && registry.contains(id) then Some(registry.get(id).cast[Session])
      else None
    registryLock.release()

    match found
    case Some(session) => Response.json(session.since(seen))
    case None          => Response.json(py.dict("events" ~ py.list(), "next" ~ seen, "active" ~ false))

  //[ Request cancellation of the session's running turn. //]
  private def handleStop(): Response receives request =
    val body = request.json() rescue None => return Response.badRequest("expected a JSON object")
    val requested = body.get("session", "").asString
    val id = sanitizeSessionId(requested)

    registryLock.acquire()
    if id == requested && registry.contains(id) then registry.get(id).cast[Session].requestStop()
    registryLock.release()

    Response.json(py.dict("ok" ~ true))

  //[ Resolve the pending booking approval for a session. //]
  private def handleApproval(): Response receives request =
    val body = request.json() rescue None => return Response.badRequest("expected a JSON object")
    val requested = body.get("session", "").asString
    val sessionId = sanitizeSessionId(requested)
    val approvalId = body.get("id", "").asString
    val decision = body.get("decision", "").asString

    registryLock.acquire()
    val found: Option[Session] =
      if sessionId == requested && registry.contains(sessionId) then Some(registry.get(sessionId).cast[Session])
      else None
    registryLock.release()

    val accepted = match found
      case Some(session) => session.decideApproval(approvalId, decision)
      case None          => false

    Response.json(py.dict("ok" ~ accepted))

  //[ Accept only a bare session name, never a path supplied by the client. //]
  private def sanitizeSessionId(raw: String): String =
    val base = os.path.basename(raw.replace("\\", "/"))
    if base == "" || base == "." || base == ".." then "" else base

  //[ Build the toolset for a session: skills + runCode (with Duffel env) + bonus tools. //]
  private def sessionTools(): Toolset =
    harpe.tools.SkillTools.toolset(os.path.join(home, "skills"))
      ++ runTool.toolset(sandboxEnv)
      ++ getToday()

  //[ Mint a fresh session under a new time-sortable id. //]
  private def createSession(): Session receives appHome =
    val id = time.strftime("%Y%m%dT%H%M%S") + "-" + secrets.token_hex(2)
    buildSession(id)

  //[ Resume the session for `id` if it is in the registry.
    !
    ! Falls back to a fresh session with the SAME `id` so the browser's stored
    ! id remains valid (e.g. after a server restart). Conversation history is
    ! lost in that case — we have no disk replay — but the id stays consistent
    ! so the browser does not get stuck in an endless create-new-session loop.
  //]
  private def resumeSession(id: String): Session receives appHome =
    registryLock.acquire()
    val found: Option[Session] =
      if registry.contains(id) then Some(registry.get(id).cast[Session])
      else None
    registryLock.release()

    match found
    case Some(session) => session
    case None          => buildSession(id)

  //[ Build and register a session under the given id. //]
  private def buildSession(id: String): Session receives appHome =
    // Ensure the log directory exists so JsonlLogger can write the file.
    File.ensureDir(os.path.join(appHome, "logs/sessions"))

    val context = new WindowedContext:
      baseSystem = File.read(os.path.join(appHome, "prompts/SYSTEM.md"))
      initial = []

    val session = new Session:
      id
      brain
      sessionTools()
      context
      viewLog

    registryLock.acquire()
    registry.set(id, session)
    registryLock.release()

    session

  //[ Drop sessions idle for more than 30 minutes from the in-memory registry. //]
  private def evictIdle(): Unit =
    val cutoff = Clock.now() - 1800.0

    registryLock.acquire()
    val stale = py.list()
    for k in py.iter(registry.keys()) do
      if registry.get(k).cast[Session].lastActive < cutoff then stale.append(k)
    for k in py.iter(stale) do
      val _ = registry.pop(k)
    registryLock.release()
end

def getToday(): Toolset =
  val spec = Tool:
    "getToday"
    "Get today's date and day of the week. Call this whenever the user mentions a relative date such as \"this Friday\", \"next Monday\", or \"tomorrow\", then compute the target date from the result."
    []
  Toolset.of: spec, (input, channel) =>
    val dt = py.module("datetime")
    val today = dt.date.today()
    val iso = today.isoformat().asString
    val weekday = today.strftime("%A").asString
    new Tool.ToolOutcome("Today is " + weekday + ", " + iso + ".", "getToday · " + iso)
