# Copy to .env and fill in. The agent loads .env on startup.

# --- Duffel (required) ---
# A test API key from https://app.duffel.com, under Developers → API keys.
# It starts with duffel_test_. Test keys hit sandbox data: no real flights are
# booked and no real money is charged.
DUFFEL_API_KEY=

# Set one provider key. The provider is chosen by which key you set: OpenAI
# first, then OpenRouter, then Anthropic.

# --- Anthropic (default) ---
MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# --- OpenAI (Responses API) ---
# MODEL=gpt-5.6
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # optional: Azure OpenAI or another Responses-API endpoint

# --- OpenRouter ---
# OpenRouter has no default model, so MODEL is required with it.
# MODEL=
# OPENROUTER_API_KEY=

# Where the chat server listens (optional; these are the defaults).
HOST=127.0.0.1
PORT=8765
