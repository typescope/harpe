//[ Web.jo
  !
  ! The web agent loop (the Harpe "conversational" trigger, served in a browser)
  ! and its entry point. `jo run` with `jo.main = web.main` starts a local
  ! HTTP server. The chat page talks to it over HTTP. Each user message is one
  ! turn of the shared engine, driven by `WebInteract` so the browser sees
  ! progress live.
  !
  ! The server is threaded (one request per thread), so the page and `/api/stop`
  ! stay responsive while a turn runs. A session's turns are serialized by its
  ! lock, and a running turn is cancellable via the session's stop event.
//]

namespace web
import harpe.ffi.sys
import harpe.util.Process
import harpe.ffi.signal
import harpe.util.File

import jo.IO.stdout
import harpe.server.Application
import harpe.Model
import harpe.ffi.os

//[ Where this application's files live: `assets/`, `sandbox/`, `skills/`, `data/`, `logs/`, `AGENT.md`
  !
  ! This driver's own convention, not the framework's. Provided once at startup
  ! and re-provided per request thread by `ChatServer.route`, so every handler
  ! resolves its paths without being handed a directory.
//]
param appHome: String

//[ The entry point //]
def main(): Unit receives stdout =
  Process.loadDotenv(".env")
  with appHome = os.path.abspath(".") in serve()

private def serve(): Unit receives stdout, appHome =
  // The chat page is the agent's own file, served from disk (see Server.route),
  // so the agent owns and customizes it. Fail fast with a pointer if it is missing.
  if !File.exists(os.path.join(appHome, "assets/index.html")) then
    println "Error: assets/index.html not found — the web driver serves the chat page from the agent's assets/ directory."
    println "  It ships with the web agent; restore it from the harpe repo (web/assets/index.html)."
    sys.exit(1)

  val brain = Model.default()

  val server = new ChatServer(brain, "Clair", appHome)

  val host = os.getenv("HOST", "127.0.0.1")
  val port = Int.parse(os.getenv("PORT", "8765")) rescue None => 8765

  // Harpe installs no HTTP server: an `Application` is a plain WSGI callable
  // and this picks one. It is also the door — a verb it does not implement, a
  // `Host` it does not answer to, and a cross-site write are all refused before
  // any route runs.
  //
  // Every request is short, because a turn runs on a thread of its own and the
  // page polls for its events. That is what keeps the pool free: a worker is
  // pinned for a response's whole life, so the pool bounds concurrent requests,
  // not concurrent conversations.
  val answersTo: Application.Host.Policy =
    if host == "127.0.0.1" || host == "localhost" then Application.Host.Loopback
    else Application.Host.Named(host)

  val application = new Application:
    host = answersTo
    routes = []
    fallback = () => server.route()
    maxBodyBytes = 26214400

  val httpd = py.module("waitress").create_server:
    application.wsgi()
    host = host
    port = port
    threads = 16
    max_request_body_size = application.ceiling

  println """

              ♪           ♫
        ──────●───────────
        ───────────●──────
           C L A I R

           Harpe · Web

    """

  println "  Live at http://\{host}:\{port}"
  println "  Ctrl-C to stop"

  // Stop cleanly on Ctrl-C instead of dumping a traceback from the server loop.
  Process.shutdownOnSigint("\n  ♪ Clair stopped.")

  httpd.run()
