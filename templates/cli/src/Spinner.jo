//[ Spinner.jo
  !
  ! A reusable terminal spinner for the CLI: an animated status line shown while
  ! a blocking step (model request, tool run) is in flight.
  !
  ! One instance is created per session and driven by the event handler.
//]

namespace harpe.cli
import harpe.ffi.sys
import harpe.util.Clock
import harpe.util.Process
import harpe.ffi.threading
import harpe.ffi.builtins

import harpe.ffi.time

// "\r" + ESC + "[2K" — return to start of line and clear it.
private def clearLine(): String = "\r" + builtins.chr(27) + "[2K"

//[ A reusable spinner resource   //]
class Spinner
  var stopEvent: Option[py.Dynamic] = None
  var thread: Option[py.Dynamic] = None

  def start(message: String): Unit =
    stop()
    val event   = threading.Event()
    val started = Clock.now()
    val animate = () =>
      val frames = py.list("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
      var i = 0
      while !event.is_set().asBool do
        val frame = frames.get(i % 10).asString
        val secs  = builtins.round(Clock.now() - started, 1)
        sys.stdout.write:
          "\r  " + Style.note(frame) + " " + message + " " +
          Style.muted(secs.toString + "s") + " "
        sys.stdout.flush()
        i = i + 1
        event.wait(0.1)
      sys.stdout.write(clearLine())
      sys.stdout.flush()

    val t = Process.daemon(animate)
    stopEvent = Some(event)
    thread = Some(t)
    t.start()

  def stop(): Unit =
    if stopEvent is Some(event) then
      event.set()
      if thread is Some(t) then t.join()
      stopEvent = None
      thread = None
end
