namespace sandbox.runtime

import sandbox.api

//[ The watcher's capability, implemented by trusted host-side code.
  !
  ! Reads are shared with the planner. The one write records an advisory note.
  ! `runId` stamps every note with the run that raised it, so the host can resolve
  ! whatever this run did not raise again.
//]
class WatchImpl(depot: Depot, runId: Int)
  view api.Watch

  def products(): List[api.Product] = depot.products()
  def checks(): List[api.Check] = depot.checks()
  def demandHistory(productId: Int, days: Int): List[api.DemandDay] =
    depot.demandHistory(productId, days)

  //[ Raise or refresh one warning about one product.
    !
    ! A warning that is already open for the same product and check is refreshed
    ! rather than duplicated, so a product that has been short for a week is one
    ! row with a moving `last_seen`, not seven rows.
  //]
  def saveWarning(
    productId: Int,
    checkId: Int,
    severity: String,
    text: String
  ): api.SaveResult =
    if text.trim == "" then return depot.failed("A warning needs text")
    if severity != "critical" && severity != "warning" then
      return depot.failed("Severity must be 'critical' or 'warning'")

    val conn = depot.connect()
    conn.execute("BEGIN IMMEDIATE")

    val product = conn
      .execute:
         "SELECT sku FROM products WHERE id = ? AND enabled = 1"
         py.list(productId)
      .fetchone()
    if product.isNone then
      return depot.rollback(conn, "Unknown or disabled product \{productId}")

    // 0 means "no particular check said so, this is the arithmetic talking".
    if checkId != 0 then
      val check = conn
        .execute:
           "SELECT 1 FROM checks WHERE id = ? AND enabled = 1"
           py.list(checkId)
        .fetchone()
      if check.isNone then return depot.rollback(conn, "Unknown check \{checkId}")

    val open = conn
      .execute:
         """
         SELECT id FROM warnings
         WHERE product_id = ? AND check_id = ? AND resolved_at = ''
         """
         py.list(productId, checkId)
      .fetchone()

    val id = if open.isNone then
      val cursor = conn.execute:
        """
        INSERT INTO warnings
          (product_id, check_id, severity, text, first_seen, last_seen, resolved_at, last_run_id)
        VALUES (?, ?, ?, ?, datetime('now'), datetime('now'), '', ?)
        """
        py.list(productId, checkId, severity, text.trim, runId)
      cursor.lastrowid.asInt
    else
      val existing = open[0].asInt
      conn.execute:
        """
        UPDATE warnings SET severity = ?, text = ?, last_seen = datetime('now'),
          last_run_id = ? WHERE id = ?
        """
        py.list(severity, text.trim, runId, existing)
      existing

    conn.commit()
    conn.close()
    new api.SaveResult(true, id, "Warning \{id} recorded for \{product[0].asString}")
end
