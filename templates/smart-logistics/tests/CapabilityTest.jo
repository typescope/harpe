//[ CapabilityTest.jo
  !
  ! What generated code can and cannot do.
  !
  ! The first suite is the claim the whole demo rests on: a program that reaches
  ! past its capability does not compile, so the refusal happens before anything
  ! runs. The second is the other half — code that stays inside the capability
  ! still cannot write a draft the physical facts do not allow.
//]

namespace smart.logistics.tests.CapabilityTest

import harpe.testing.test
import harpe.testing.thisSuite
import harpe.testing.check
import harpe.logging.logger
import smart.logistics.tests.Sandbox
import smart.logistics.tests.DepotTest
import smart.logistics.db.DB
import smart.logistics.db.conn
import smart.logistics.db.Orders
import smart.logistics.db.Checks

private def guest(body: String): String =
  "namespace sandbox.guest\n\nimport sandbox.api.*\n\n" + body

//[ Every rejection `saveDraftOrder` can produce, asked for in one program. //]
private def probeProgram(): String = guest("""
def runTask(): Unit receives IO.stdout, plan =
  probe("wrong supplier", 4, 2, 12)
  probe("not a whole case", 4, 1, 13)
  probe("zero quantity", 4, 1, 0)
  probe("negative quantity", 4, 1, 0 - 12)
  probe("over capacity", 4, 1, 6000)
  probe("unknown product", 999, 1, 12)
  probe("unknown supplier", 4, 99, 12)

  val duplicate = plan.saveDraftOrder(1, [
    new ProposedLine(1, 24), new ProposedLine(1, 24)], "twice")
  println("duplicate line: " + duplicate.message)

  val empty = plan.saveDraftOrder(1, [], "nothing")
  println("no lines: " + empty.message)

  val silent = plan.saveDraftOrder(1, [new ProposedLine(1, 24)], "   ")
  println("no rationale: " + silent.message)

  val good = plan.saveDraftOrder(1, [new ProposedLine(4, 12)], "cover the wait")
  println("accepted: ok=" + yes(good.ok) + " id=" + yes(good.id != 0))

  val again = plan.saveDraftOrder(4, [new ProposedLine(4, 12)], "again")
  println("second time: " + again.message)

private def yes(value: Bool): String = if value then "true" else "false"

private def probe(label: String, productId: Int, supplierId: Int, quantity: Int): Unit
    receives IO.stdout, plan =
  val result = plan.saveDraftOrder(
    supplierId, [new ProposedLine(productId, quantity)], "probe")
  println(label + ": ok=" + yes(result.ok) + " " + result.message)
""")

def capabilitySuite(): Unit receives thisSuite, logger =
  //[ Each of these names something the runtime holds and the guest does not. //]
  test: "code that reaches past its capability does not compile", () =>
    val root = Sandbox.prepare(py.module("os").path.abspath(".").asString)

    val ordering = Sandbox.build(root, "watch", guest("""
def runTask(): Unit receives IO.stdout, watch =
  val r = watch.saveDraftOrder(1, [new ProposedLine(1, 24)], "not mine to make")
  println r.message
"""))
    check("the watcher cannot order anything", ordering.returnCode != 0)

    val other = Sandbox.build(root, "watch", guest("""
def runTask(): Unit receives IO.stdout, plan =
  println plan.products().size.toString
"""))
    check("the watcher cannot reach the planner's capability", other.returnCode != 0)
    check:
      "and it is the name itself that is missing"
      (other.out + other.err).contains("Undefined term name")

    val warning = Sandbox.build(root, "plan", guest("""
def runTask(): Unit receives IO.stdout, plan =
  val r = plan.saveWarning(1, 0, "critical", "not mine to raise")
  println r.message
"""))
    check("the planner cannot raise warnings", warning.returnCode != 0)

    val ffi = Sandbox.build(root, "plan", guest("""
def runTask(): Unit receives IO.stdout, plan =
  val conn = py.module("sqlite3").connect("/tmp/anything.db")
  println "opened a database"
"""))
    check:
      "no guest reaches Python, and so no guest reaches SQLite"
      ffi.returnCode != 0

    val impl = Sandbox.build(root, "plan", guest("""
import sandbox.runtime.*

def runTask(): Unit receives IO.stdout, plan =
  val mine = new PlanImpl(new Depot("/etc/passwd"))
  println "built my own"
"""))
    check:
      "and cannot build the trusted implementation itself"
      impl.returnCode != 0

  //[ What the guest wrote is a draft, and the orders the administrator had
    ! already placed are exactly as many as before. Nothing generated code can
    ! call moves an order out of `draft` — not onto a supplier, and not into
    ! stock.
  //]
  def nothingWasOrdered(): Unit receives conn, thisSuite, logger =
    var newest = py.dict()
    var placed = 0
    for item in Orders.drafts() do
      val order = item.cast[py.Dict]
      if order.get("status").asString == "ordered" then placed = placed + 1
      if newest.size == 0 then newest = order
    check:
      "what the guest wrote is a draft"
      newest.get("status").asString == "draft"
    check("and it ordered nothing on its way past", placed == 2)

  //[ Inside the capability, the runtime is still the one that decides. //]
  test: "the runtime refuses a draft the facts do not allow", () =>
    val root = Sandbox.prepare(py.module("os").path.abspath(".").asString)
    val path = DepotTest.freshDepot()
    val printed = Sandbox.output(root, "plan", path, probeProgram())

    check:
      "a supplier that does not stock it"
      printed.contains("wrong supplier: ok=false")
        && printed.contains("not sourced from this supplier")
    check:
      "a quantity that is not whole cases"
      printed.contains("not a whole case: ok=false")
        && printed.contains("whole cases")
    check("zero", printed.contains("zero quantity: ok=false"))
    check("negative", printed.contains("negative quantity: ok=false"))
    check:
      "more than the shelf holds"
      printed.contains("over capacity: ok=false")
        && printed.contains("storage capacity")
    check("a product that does not exist", printed.contains("unknown product: ok=false"))
    check("a supplier that does not exist", printed.contains("unknown supplier: ok=false"))
    check:
      "the same product twice in one draft"
      printed.contains("duplicate line: Duplicate product line")
    check("a draft with no lines", printed.contains("no lines: A draft needs"))
    check("a draft with no reason", printed.contains("no rationale: A rationale"))
    check("a proposal the facts do allow", printed.contains("accepted: ok=true id=true"))
    check:
      "but not the same product a second time"
      printed.contains("second time: FOOD-104 is already in an open draft")

    // What the guest wrote is a draft, and the orders the administrator had
    // already placed are exactly as many as before. Nothing generated code can
    // call moves an order out of 'draft' — not onto a supplier, and not into
    // stock.
    DB.withConn(path, () => nothingWasOrdered())

  test: "the watcher can only leave a note, and refreshes it rather than repeat it", () =>
    val root = Sandbox.prepare(py.module("os").path.abspath(".").asString)
    val path = DepotTest.freshDepot()
    val printed = Sandbox.output(root, "watch", path, guest("""
def runTask(): Unit receives IO.stdout, watch =
  val bad = watch.saveWarning(1, 0, "shouting", "wrong severity")
  println("severity: " + bad.message)
  val ghost = watch.saveWarning(999, 0, "critical", "no such product")
  println("product: " + ghost.message)
  val noCheck = watch.saveWarning(1, 4242, "critical", "no such check")
  println("check: " + noCheck.message)
  val first = watch.saveWarning(1, 0, "critical", "down to two days")
  val again = watch.saveWarning(1, 0, "warning", "down to two days, still")
  println("refreshed: " + (if first.id == again.id then "true" else "false"))
"""))
    check("severity is not free text", printed.contains("severity: Severity must be"))
    check("a warning needs a real product", printed.contains("product: Unknown or disabled"))
    check("and a real check, when it names one", printed.contains("check: Unknown check"))
    check:
      "raising the same thing twice refreshes one note"
      printed.contains("refreshed: true")
    check:
      "so the list holds one row, not two"
      DB.withConn(path, () => Checks.warnings()).size == 1
