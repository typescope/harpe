//[ DepotTest.jo
  !
  ! The database, and the one number the whole app is arranged around.
//]

namespace smart.logistics.tests.DepotTest

import harpe.ffi.os
import harpe.util.File
import harpe.testing.test
import harpe.testing.thisSuite
import harpe.testing.check
import harpe.logging.logger
import smart.logistics.db.DB
import smart.logistics.db.conn
import smart.logistics.db.Runs
import smart.logistics.db.Stock
import smart.logistics.db.Orders
import smart.logistics.db.Checks

//[ A freshly seeded depot in a directory of its own, and the path to it. //]
def freshDepot(): String = depotIn(py.module("tempfile").mkdtemp(prefix = "sl-db-").asString)

//[ A test that runs on ONE connection to a freshly seeded depot.
  !
  ! Which is what a request does, and what every test below wants: the stores
  ! take their connection from context, so something has to put one there.
//]
def depotTest(name: String, body: () => Unit receives conn): Unit receives thisSuite, logger =
  test: name, () => DB.withConn(freshDepot(), body)

//[ A depot whose `migrations/` directory is the test's to write into.
  !
  ! Giving the test its own home is what lets it write a migration file and
  ! watch it be applied on the next start.
//]
private def depotIn(home: String): String =
  val path = os.path.join(home, "logistics.db")
  DB.initialize(path, os.path.join(home, "migrations"))
  path

//[ A migration file in `home`, named so it sorts first. //]
private def writeMigration(home: String, name: String, sql: String): Unit =
  File.ensureDir(os.path.join(home, "migrations"))
  File.write(os.path.join(home, "migrations", name + ".sql"), sql)

//[ Whether `table` has a column called `column`. //]
private def hasColumn(path: String, table: String, column: String): Bool =
  val conn = py.module("sqlite3").connect(path)
  var found = false
  for row in py.iter(conn.execute("PRAGMA table_info(\{table})")) do
    if py.dynamic(row)[1].asString == column then found = true
  conn.close()
  found

//[ The versions recorded in `schema_migrations`. //]
private def appliedVersions(path: String): List[String] =
  val conn = py.module("sqlite3").connect(path)
  var out: List[String] = []
  for row in py.iter(conn.execute("SELECT version FROM schema_migrations ORDER BY version")) do
    out = out ++ [py.dynamic(row)[0].asString]
  conn.close()
  out

//[ Orders currently in one of `statuses`. //]
private def orderCount(statuses: List[String]): Int receives conn =
  var count = 0
  for item in Orders.drafts() do
    if statuses.contains(item.cast[py.Dict].get("status").asString) then count = count + 1
  count

private def placedCount(): Int receives conn = orderCount(["ordered"])

//[ Products whose cover runs out before a delivery could arrive — the number
  ! the page derives for itself, computed here the same way.
//]
private def atRiskCount(): Int receives conn =
  var count = 0
  for item in Stock.products() do
    val product = item.cast[py.Dict]
    if product.get("days_of_cover").asInt < product.get("lead_time_days").asInt then
      count = count + 1
  count

//[ Orders in transit whose promised date has already passed. //]
private def overdueCount(): Int receives conn =
  val today = py.module("datetime").date.today().isoformat().asString
  var count = 0
  for item in Orders.drafts() do
    val order = item.cast[py.Dict]
    val expected = order.get("expected_at").asString
    val inTransit = ["ordered", "part_received"].contains(order.get("status").asString)
    // Both are ISO dates, so Python's string order is date order.
    val late = expected != "" && py.dynamic(expected).__lt__(today).asBool
    if inTransit && late then count = count + 1
  count

//[ The one draft the seed leaves open, and the line on it for `sku`. //]
private def orderOf(sku: String): Int receives conn =
  var found = 0
  for item in Orders.drafts() do
    val order = item.cast[py.Dict]
    if order.get("status").asString == "draft" then
      for raw in order.get("lines").cast[py.List] do
        if raw.cast[py.Dict].get("sku").asString == sku then
          found = order.get("id").asInt
  found

private def lineOf(orderId: Int, sku: String): Int receives conn =
  var found = 0
  for item in Orders.drafts() do
    val order = item.cast[py.Dict]
    if order.get("id").asInt == orderId then
      for raw in order.get("lines").cast[py.List] do
        val line = raw.cast[py.Dict]
        if line.get("sku").asString == sku then found = line.get("id").asInt
  found

private def orderField(orderId: Int, field: String): String receives conn =
  var found = ""
  for item in Orders.drafts() do
    val order = item.cast[py.Dict]
    if order.get("id").asInt == orderId then found = order.get(field).asString
  found

private def orderStatus(orderId: Int): String receives conn =
  orderField(orderId, "status")

private def product(sku: String): py.Dict receives conn =
  var found = py.dict()
  for item in Stock.products() do
    if item.cast[py.Dict].get("sku").asString == sku then found = item.cast[py.Dict]
  found

def depotSuite(): Unit receives thisSuite, logger =
  depotTest: "the seed opens on a depot in trouble", () =>
    check("twelve products", Stock.products().size == 12)
    check("four run out before a delivery could arrive", atRiskCount() == 4)
    check("one draft is already open", orderCount(["draft"]) == 1)
    check("nothing has been checked yet", Runs.lastChecked() == "")

  depotTest: "days of cover is stock plus what is on order, at the rate of sale", () =>
    val soap = product("HYGI-301")
    check("14 on hand", soap.get("on_hand").asInt == 14)
    check("5 a day", soap.get("sells_per_day").asFloat == 5.0)
    check("two days of cover", soap.get("days_of_cover").asInt == 2)
    check:
      "a nine day wait for the preferred source"
      soap.get("lead_time_days").asInt == 9

  depotTest: "trouble sorts to the top", () =>
    val first = Stock.products()[0].cast[py.Dict]
    check("the shortest cover comes first", first.get("sku").asString == "HYGI-301")

  //[ The loop the demo closes on screen: approving an order covers the
    ! shortfall that prompted it.
  //]
  depotTest: "accepting a draft counts as on order and lifts cover", () =>
    val before = product("HYGI-303")
    check("three days before", before.get("days_of_cover").asInt == 3)
    check("nothing on order before", before.get("on_order").asInt == 0)

    var draftId = 0
    for item in Orders.drafts() do
      val draft = item.cast[py.Dict]
      if draft.get("status").asString == "draft" then draftId = draft.get("id").asInt
    check("accepted", Orders.setDraftStatus(draftId, "accepted"))

    val after = product("HYGI-303")
    check("40 on order", after.get("on_order").asInt == 40)
    check("nine days after", after.get("days_of_cover").asInt == 9)
    check("one fewer at risk", atRiskCount() == 3)
    check:
      "an accepted order cannot be accepted again"
      !Orders.setDraftStatus(draftId, "rejected")

  //[ What the old model got wrong. An order that has arrived is stock, and
    ! stock is in the ledger; leaving it on order as well counted it twice and
    ! cover climbed away from the truth with every delivery.
  //]
  depotTest: "receiving moves an order into the ledger, not alongside it", () =>
    val id = orderOf("HYGI-303")
    check("placed", Orders.setDraftStatus(id, "accepted"))

    val onOrder = product("HYGI-303")
    check("40 on order", onOrder.get("on_order").asInt == 40)
    check("18 on hand", onOrder.get("on_hand").asInt == 18)

    check:
      "40 booked in"
      Orders.receiveOrder(py.dict(
        "order_id" ~ id, "lines" ~ py.list(py.dict(
          "line_id" ~ lineOf(id, "HYGI-303"), "quantity" ~ 40)))) == 40

    val received = product("HYGI-303")
    check("nothing left on order", received.get("on_order").asInt == 0)
    check("and 58 on hand instead", received.get("on_hand").asInt == 58)
    // The same total either way — which is the point. Before, it would have
    // read 98: forty units in stock and the same forty still on their way.
    check:
      "cover unchanged by the delivery arriving"
      received.get("days_of_cover").asInt == onOrder.get("days_of_cover").asInt
    check("the order is closed", orderStatus(id) == "received")

  depotTest: "a delivery is the ledger's, and traces back to the line it settles", () =>
    val id = orderOf("HYGI-303")
    val _ = Orders.setDraftStatus(id, "accepted")
    val _ = Orders.receiveOrder(py.dict("order_id" ~ id, "lines" ~ py.list(
      py.dict("line_id" ~ lineOf(id, "HYGI-303"), "quantity" ~ 40))))

    var booked = py.dict()
    for item in Stock.movements(0, 100) do
      val movement = item.cast[py.Dict]
      if movement.get("reference").asString == "PO-\{id}" then booked = movement
    check:
      "the delivery is an ordinary receipt in the ledger"
      booked.get("kind").asString == "receipt" && booked.get("quantity").asInt == 40

    var receipts = py.list()
    for item in Orders.drafts() do
      val order = item.cast[py.Dict]
      if order.get("id").asInt == id then receipts = order.get("receipts").cast[py.List]
    check("one receipt recorded", receipts.size == 1)
    check:
      "naming the movement that changed the balance"
      receipts[0].cast[py.Dict].get("movement_id").asInt == booked.get("id").asInt

  depotTest: "a short delivery leaves the rest on order", () =>
    val id = orderOf("HYGI-303")
    val line = lineOf(id, "HYGI-303")
    val _ = Orders.setDraftStatus(id, "accepted")

    check:
      "30 of 40 booked in"
      Orders.receiveOrder(py.dict(
        "order_id" ~ id,
        "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 30)))) == 30
    check("part received", orderStatus(id) == "part_received")
    check("ten still coming", product("HYGI-303").get("on_order").asInt == 10)

    // A supplier can send more than was ordered, but not against this line:
    // what is outstanding would go negative and cover would read low for ever.
    val tooMany = py.try: Orders.receiveOrder(py.dict(
      "order_id" ~ id,
      "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 11))))
    check("and no more than ten will be taken", tooMany.isErr)

    check:
      "the last ten"
      Orders.receiveOrder(py.dict(
        "order_id" ~ id,
        "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 10)))) == 10
    check("received", orderStatus(id) == "received")
    check("nothing on order", product("HYGI-303").get("on_order").asInt == 0)

    val again = py.try: Orders.receiveOrder(py.dict(
      "order_id" ~ id,
      "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 1))))
    check("a closed order takes no more deliveries", again.isErr)

  depotTest: "cancelling stops the rest counting, and keeps what arrived", () =>
    val id = orderOf("HYGI-303")
    val _ = Orders.setDraftStatus(id, "accepted")
    val _ = Orders.receiveOrder(py.dict("order_id" ~ id, "lines" ~ py.list(
      py.dict("line_id" ~ lineOf(id, "HYGI-303"), "quantity" ~ 25))))

    check("cancelled", Orders.setDraftStatus(id, "cancelled"))
    val after = product("HYGI-303")
    check("the fifteen that never came stop counting", after.get("on_order").asInt == 0)
    check("the twenty-five that did are in stock", after.get("on_hand").asInt == 43)
    check:
      "a cancelled order cannot be cancelled again"
      !Orders.setDraftStatus(id, "cancelled")

  depotTest: "a draft is not a delivery, and neither is a rejected order", () =>
    val id = orderOf("HYGI-303")
    val line = lineOf(id, "HYGI-303")

    val early = py.try: Orders.receiveOrder(py.dict(
      "order_id" ~ id, "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 1))))
    check("nothing arrives against a draft", early.isErr)
    check("a draft cannot be cancelled", !Orders.setDraftStatus(id, "cancelled"))

    check("rejected", Orders.setDraftStatus(id, "rejected"))
    val gone = py.try: Orders.receiveOrder(py.dict(
      "order_id" ~ id, "lines" ~ py.list(py.dict("line_id" ~ line, "quantity" ~ 1))))
    check("nor against a rejected one", gone.isErr)
    check:
      "and it was never on order"
      product("HYGI-303").get("on_order").asInt == 0

  depotTest: "placing an order records when it is due", () =>
    val id = orderOf("HYGI-303")
    check("no date on a draft", orderField(id, "expected_at") == "")
    val _ = Orders.setDraftStatus(id, "accepted")
    // Paper towels come from Nordic on a six day lead time. The dates the
    // database writes are its own, so what is checked here is the interval
    // between them rather than today's date read off another clock.
    val datetime = py.module("datetime")
    val placed = datetime.datetime.fromisoformat(
      orderField(id, "ordered_at")).date()
    val due = datetime.date.fromisoformat(orderField(id, "expected_at"))
    check:
      "due on the lead time of the slowest line"
      due.__sub__(placed).days.asInt == 6
    check:
      "three orders are now in transit"
      orderCount(["ordered", "part_received"]) == 3
    check("none of them late yet", overdueCount() == 0)

  depotTest: "the ledger refuses to go negative or past capacity", () =>
    val soap = product("HYGI-301")
    val id = soap.get("id").asInt

    val tooMany = py.try: Stock.recordMovement(
      py.dict("product_id" ~ id, "kind" ~ "issue", "quantity" ~ 9999))
    check("cannot issue more than is there", tooMany.isErr)

    val tooBig = py.try: Stock.recordMovement(
      py.dict("product_id" ~ id, "kind" ~ "receipt", "quantity" ~ 9999))
    check("cannot receive past capacity", tooBig.isErr)

    val fine = Stock.recordMovement(
      py.dict("product_id" ~ id, "kind" ~ "receipt", "quantity" ~ 8))
    check("a movement that fits is recorded", fine > 0)
    check("and the ledger says so", product("HYGI-301").get("on_hand").asInt == 22)

  //[ `products.on_hand` is a stored total, so the thing worth testing is that it
    ! still equals the ledger it caches — after a seed, a movement, and a delivery.
  //]
  depotTest: "the stored balance agrees with the ledger that produced it", () =>
    check("the seed leaves nothing drifted", Stock.reconcile() == 0)

    val soap = product("HYGI-301")
    val id = soap.get("id").asInt
    val _ = Stock.recordMovement(py.dict:
      "product_id" ~ id
      "kind"       ~ "receipt"
      "quantity"   ~ 8)
    check("a movement keeps the two in step", Stock.reconcile() == 0)
    check("and the balance moved by exactly that", product("HYGI-301").get("on_hand").asInt == 22)

    // Corrupt the cache behind the trigger's back, the way a stray UPDATE would.
    val touched = DB.inTransaction: () =>
      DB.execute("UPDATE products SET on_hand = on_hand + 99 WHERE id = ?", py.list(id))
    check("one row was corrupted", touched == 1)
    check("drift is found", Stock.reconcile() == 1)
    check("and corrected from the ledger", product("HYGI-301").get("on_hand").asInt == 22)

  //[ The migration runner, on a database that already exists.
    !
    ! The change is a column this app does not have, in a file written by the
    ! test. What is under test is the mechanism — applied once, recorded, never
    ! run again — rather than any particular change, which is the point of having
    ! a mechanism at all.
  //]
  test: "a migration runs once on an existing database, and is recorded", () =>
    val home = py.module("tempfile").mkdtemp(prefix = "sl-mig-").asString
    val path = depotIn(home)
    check("nothing to apply yet", appliedVersions(path).size == 0)
    check("and no such column", !hasColumn(path, "suppliers", "note"))

    writeMigration(home, "20260101T000000-supplier-note", """
      BEGIN IMMEDIATE;
      ALTER TABLE suppliers ADD COLUMN note TEXT NOT NULL DEFAULT '';
      COMMIT;
    """)

    // Exactly what happens on the next start.
    val _ = depotIn(home)
    check("the column is there", hasColumn(path, "suppliers", "note"))
    val recorded = appliedVersions(path)
    check:
      "and the database records which file put it there"
      recorded.size == 1 && recorded.contains("20260101T000000-supplier-note")

    // Twice is a no-op, and not merely a harmless one: `ALTER TABLE ADD COLUMN`
    // fails on a column that exists, so a second application would abort the
    // start. Getting here at all is the assertion.
    val again = depotIn(home)
    check("the migration does not run a second time", appliedVersions(again).size == 1)
    check:
      "and the seeded depot is untouched"
      DB.withConn(again, () => placedCount()) == 2

  //[ A database created at the current shape is BASELINED rather than migrated:
    ! every file is recorded without being run, because `Schema` is supposed to
    ! have built the shape they lead to.
    !
    ! Which is why a schema change is two edits, not one. The migration below is
    ! never run here, so the column it adds is absent — `Schema.jo` is the only
    ! thing that could have put it there, and this test is what that omission
    ! looks like.
  //]
  test: "a fresh database records migrations without running them", () =>
    val home = py.module("tempfile").mkdtemp(prefix = "sl-base-").asString
    writeMigration(home, "20260101T000000-supplier-note", """
      BEGIN IMMEDIATE;
      ALTER TABLE suppliers ADD COLUMN note TEXT NOT NULL DEFAULT '';
      COMMIT;
    """)
    val path = depotIn(home)
    val recorded = appliedVersions(path)
    check:
      "recorded"
      recorded.size == 1 && recorded.contains("20260101T000000-supplier-note")
    check("but not run", !hasColumn(path, "suppliers", "note"))

  depotTest: "checks are text, and both agents read the same list", () =>
    check("four seeded checks", Checks.checks().size == 4)
    val id = Checks.saveCheck(py.dict(
      "text" ~ "Nordic shuts down over Christmas.", "enabled" ~ true))
    check("added", Checks.checks().size == 5)
    Checks.deleteCheck(id)
    check("removed", Checks.checks().size == 4)
