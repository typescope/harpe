namespace smart.logistics

import harpe.ffi.os
import harpe.ffi.threading
import harpe.util.File
import harpe.Model
import harpe.Http
import harpe.Http.request
import smart.logistics.agents.Watcher
import smart.logistics.agents.Planner
import smart.logistics.db.DB
import smart.logistics.db.conn
import smart.logistics.db.Snapshot
import smart.logistics.db.Stock
import smart.logistics.db.Orders
import smart.logistics.db.Checks
import smart.logistics.db.Runs
import smart.logistics.db.Skills
import smart.logistics.db.projectHome

class Server(brain: Model, home: String, databasePath: String)
  private val watcher = new Watcher(brain, home, databasePath)
  private val planner = new Planner(brain, home, databasePath)

  def route(): py.List receives request = with projectHome = home in dispatch()

  //[ The routes that need no connection, and then everything else.
    !
    ! The page's own files touch nothing. The two agent routes touch nothing
    ! HERE either — an agent run opens its own connection, because it also
    ! happens on the scheduler's thread where there is no request to inherit
    ! from. Only the tier below is worth a connection, and it opens exactly one.
  //]
  private def dispatch(): py.List receives request, projectHome =
    match request
    case Http.Get("/") => asset("index.html", "text/html; charset=utf-8")
    case Http.Get("/app.css") => asset("app.css", "text/css; charset=utf-8")
    case Http.Get("/app.js") => asset("app.js", "text/javascript; charset=utf-8")
    // The watcher, on demand as well as on its schedule.
    case Http.Post("/api/check-now") => Http.respondJson(watcher.run("manual"))
    // The planner, only ever on demand, with this run's note.
    case Http.Post("/api/plan") => plan()
    case _ => DB.withConn(databasePath, () => connected())

  //[ One connection, opened for this request and closed with its response. //]
  private def connected(): py.List receives request, conn, projectHome =
    match request
    case Http.Get("/api/snapshot") => Http.respondJson(Snapshot.snapshot())
    case Http.Get("/api/warnings") =>
      Http.respondJson(py.dict("warnings" ~ Checks.warnings()))
    case Http.Get("/api/checks") =>
      Http.respondJson(py.dict("checks" ~ Checks.checks()))
    case Http.Get("/api/drafts") =>
      Http.respondJson(py.dict("drafts" ~ Orders.drafts()))
    case Http.Get("/api/runs") => Http.respondJson(py.dict("runs" ~ Runs.runs()))
    case Http.Get("/api/demand") =>
      Http.respondJson(py.dict("demand" ~ Stock.demand(28)))
    case Http.Get("/api/movements") => movements()
    case Http.Get("/api/suppliers") =>
      Http.respondJson(py.dict("suppliers" ~ Stock.suppliers()))
    case Http.Get("/api/skills") =>
      Http.respondJson(py.dict("skills" ~ Skills.skillNames()))
    case Http.Get("/api/skills/read") => skillRead()
    case Http.Get("/api/skills/revisions") => skillRevisions()
    case Http.Get("/api/skills/revision") => skillRevision()
    case Http.Get("/api/drafts/export") => draftExport()
    case Http.Post("/api/products") => saveProduct()
    case Http.Post("/api/movements") => recordMovement()
    case Http.Post("/api/checks") => saveCheck()
    case Http.Post("/api/checks/delete") => deleteCheck()
    case Http.Post("/api/skills") => saveSkill()
    case Http.Post("/api/skills/delete") => deleteSkill()
    case Http.Post("/api/drafts/status") => draftStatus()
    case Http.Post("/api/orders/receive") => receiveDelivery()
    case _ => Http.respond("404 Not Found", "application/json", "{\"error\":\"not found\"}")

  //[ Browser responses carry their own headers: nothing is sniffed, and the
    ! page may load only its own script and stylesheet.
  //]
  private def asset(name: String, mime: String): py.List receives request =
    val headers = py.list:
      py.tuple("Content-Type", mime)
      py.tuple("Cache-Control", "no-store")
      py.tuple("X-Content-Type-Options", "nosniff")
      py.tuple:
        "Content-Security-Policy"
        "default-src 'none'; script-src 'self'; style-src 'self'; "
          + "connect-src 'self'; img-src 'self' data:; base-uri 'none'; "
          + "form-action 'none'"
    val body = File.read(os.path.join(home, "assets", name))
    Http.respondBytes("200 OK", headers, py.dynamic(body).encode())

  private def body(): py.Dict = Http.readJson()

  private def query(name: String): String receives request =
    val raw = request.environ.get("QUERY_STRING", "").asString
    val values = py.module("urllib.parse").parse_qs(raw).get(name, py.list()).cast[py.List]
    if values.size == 0 then "" else values[0].asString

  private def ok(extra: py.Dict): py.List =
    extra.set("ok", true)
    Http.respondJson(extra)

  private def plan(): py.List receives request =
    Http.respondJson(planner.run(body().get("note", "").asString))

  private def saveProduct(): py.List receives request, conn =
    ok(py.dict("id" ~ Stock.saveProduct(body())))

  private def movements(): py.List receives request, conn =
    val productId = Int.parse(query("product_id")) rescue None => 0
    Http.respondJson(py.dict("movements" ~ Stock.movements(productId, 100)))

  private def recordMovement(): py.List receives request, conn =
    ok(py.dict("id" ~ Stock.recordMovement(body())))

  private def saveCheck(): py.List receives request, conn =
    ok(py.dict("id" ~ Checks.saveCheck(body())))

  private def deleteCheck(): py.List receives request, conn =
    Checks.deleteCheck(body().get("id").asInt)
    ok(py.dict())

  private def skillRead(): py.List receives request, projectHome =
    val name = query("name")
    Http.respondJson(py.dict("name" ~ name, "content" ~ Skills.readSkill(name)))

  private def skillRevisions(): py.List receives request, conn =
    Http.respondJson(py.dict("revisions" ~ Skills.skillRevisions(query("name"))))

  private def skillRevision(): py.List receives request, conn =
    val revision = Int.parse(query("revision")) rescue None => 0
    val name = query("name")
    Http.respondJson: py.dict:
      "name"     ~ name
      "revision" ~ revision
      "content"  ~ Skills.skillRevision(name, revision)

  private def saveSkill(): py.List receives request, conn, projectHome =
    val data = body()
    val name = Skills.saveSkill:
      data.get("name", "").asString
      data.get("content", "").asString
    ok(py.dict("name" ~ name))

  private def deleteSkill(): py.List receives request, projectHome =
    Http.respondJson: py.dict:
      "ok" ~ Skills.deleteSkill(body().get("name", "").asString)

  private def draftStatus(): py.List receives request, conn =
    val data = body()
    Http.respondJson: py.dict:
      "ok" ~ Orders.setDraftStatus(data.get("id").asInt, data.get("status").asString)

  //[ Booking a delivery against an open order. The only caller is a person at
    ! the receiving door; neither agent has this, or any other, write to stock.
  //]
  private def receiveDelivery(): py.List receives request, conn =
    refusable(() => ok(py.dict("received" ~ Orders.receiveOrder(body()))))

  //[ A refusal a person can act on.
    !
    ! Everything the depot declines to do — more than the line still owes, past
    ! the capacity of a shelf, against an order that is closed — is declined for
    ! a stated reason, and the person at the receiving door is the one who has
    ! to do something about it. Letting that surface as a bare 500 would tell
    ! them only that the computer said no.
  //]
  private def refusable(handler: () => py.List): py.List receives request =
    val outcome = py.try: handler()
    match outcome
    case Ok(response) => response
    case Err(error) =>
      Http.respond:
        "400 Bad Request"
        "application/json"
        py.module("json").dumps(py.dict("error" ~ error.message)).asString

  private def draftExport(): py.List receives request, conn =
    val id = Int.parse(query("id")) rescue None => 0
    val selected = py.list()
    for item in Orders.drafts() do
      if item.cast[py.Dict].get("id").asInt == id then selected.append(item)
    Http.respondJson(py.dict("orders" ~ selected))

  //[ The watcher runs on its own. The planner never does. //]
  def startWatching(rawMinutes: String): Unit =
    val minutes = Int.parse(rawMinutes) rescue None => 0
    if minutes <= 0 then return
    val thread = threading.Thread(target = () => schedule(minutes), daemon = true)
    thread.start()

  private def schedule(minutes: Int): Unit =
    while true do
      py.module("time").sleep(minutes * 60)
      val _ = watcher.run("schedule")
end
