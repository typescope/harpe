//[ DB.jo
  !
  ! The database as a whole: how to open one, how to build one, and how to run a
  ! statement on the one this operation is using.
  !
  ! The connection is a CONTEXT PARAMETER. Every query used to open its own and
  ! close it again, which meant `connect()` … `close()` around some sixty methods
  ! and no way for two of them to share a transaction — `snapshot` alone opened
  ! three connections to answer one request. A caller now provides one with
  ! `DB.withConn(path, () => …)`, and a store asks for it with `receives conn`.
  !
  ! Two things follow. A store needs no state, so each one is a `section` rather
  ! than a class. And composing operations becomes possible: `receiveOrder` books
  ! a delivery, moves the ledger and settles the order in ONE transaction because
  ! all three run on the same connection.
  !
  ! WHO OPENS ONE. An entry point, and only an entry point: `Server.route` per
  ! request, and `Watcher.run`/`Planner.run` per agent run. The two are separate
  ! deliberately — an agent run also happens on the scheduler's thread, where
  ! there is no request to inherit from, and Python's sqlite3 connections cannot
  ! be used from a thread other than the one that made them.
  !
  ! A connection is cheap, and in WAL with each write committed as it happens,
  ! holding one open for the length of a request — including a request that runs
  ! an agent turn for minutes — blocks no other reader or writer.
//]

namespace harpe.examples.smartlogistics.db

import harpe.ffi.os

//[ The connection this operation runs on. //]
param conn: py.Dynamic

section DB

  //[ A connection to the depot database, with the pragmas every caller needs:
    ! rows addressable by column name, foreign keys enforced rather than merely
    ! declared, WAL so a reader is not blocked while a write commits, and a busy
    ! timeout so the watcher and a request do not collide.
  //]
  def open(path: String): py.Dynamic =
    val sqlite = py.module("sqlite3")
    val connection = sqlite.connect(path, timeout = 10.0)
    connection.row_factory = sqlite.Row
    connection.execute("PRAGMA foreign_keys = ON")
    connection.execute("PRAGMA journal_mode = WAL")
    connection.execute("PRAGMA busy_timeout = 10000")
    connection

  //[ Run `work` on a connection of its own, and close it whatever happens.
    !
    ! The failure path is the reason this is not three lines at each call site.
    ! Almost every write in here refuses bad input with `abort`, and a refused
    ! request that leaked its connection would leak one per refusal for as long
    ! as the server runs.
  //]
  def withConn[T](path: String, work: () => T receives conn): T =
    val connection = open(path)
    val outcome = py.try(with conn = connection in work())
    connection.close()
    match outcome
    case Ok(value) => value
    case Err(error) => abort error.message

  //[ Build the database, bring it up to date, and make sure it has a depot in it.
    !
    ! Four steps that must happen in this order. `Schema` creates what is missing
    ! and reports whether the file was new. `Migrations` runs the `.sql` files an
    ! existing database has not had, or records them unrun when the file was new.
    ! Only then is there a shape for `Seed` to write into.
    !
    ! Called once, from `Main`, before anything serves.
  //]
  def initialize(path: String, migrationsDir: String): Unit =
    val fresh = Schema.initialize(path)
    Migrations.reconcile(path, migrationsDir, fresh)
    withConn(path, () => prepare())

  //[ The two things that need a built database: something in it, and no run left
    ! claiming to be in progress by a process that has gone.
  //]
  private def prepare(): Unit receives conn =
    Seed.apply()
    Runs.failStale()

  //[ Every row of `sql`, each one a plain dict. //]
  def rows(sql: String): py.List receives conn = rowsWith(sql, py.list())

  def rowsWith(sql: String, params: py.List): py.List receives conn =
    val result = py.list()
    for row in py.iter(conn.execute(sql, params).fetchall()) do
      result.append(py.module("builtins").dict(row))
    result

  //[ Run one statement and report how many rows it touched. //]
  def execute(sql: String, params: py.List): Int receives conn =
    conn.execute(sql, params).rowcount.asInt

  //[ Run one insert and report the id it produced. //]
  def insert(sql: String, params: py.List): Int receives conn =
    conn.execute(sql, params).lastrowid.asInt

  //[ Run `write` inside one immediate transaction, and never leave the write
    ! lock behind for the next request when it is refused.
    !
    ! On the caller's connection rather than one of its own, which is what lets a
    ! write compose out of several stores' operations.
  //]
  def inTransaction[T](write: () => T): T receives conn =
    conn.execute("BEGIN IMMEDIATE")
    val outcome = py.try(write())
    match outcome
    case Ok(value) =>
      conn.commit()
      value
    case Err(error) =>
      conn.rollback()
      abort error.message
end
