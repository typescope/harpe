//[ Migrations.jo
  !
  ! Bringing an EXISTING database up to the shape this build expects.
  !
  ! `Schema` creates what is missing, which is the whole story for an empty file
  ! and almost none of it for a database with rows in it. `CREATE TABLE IF NOT
  ! EXISTS` will not add a column, reshape a table, or move data between them, so
  ! every such change is a hand-written file in `migrations/` and this applies the
  ! ones a given database has not had.
  !
  ! WHAT IS APPLIED IS RECORDED, in `schema_migrations`. A single version counter
  ! would be cheaper and is not enough: it says how far a database has come but
  ! not which steps it took, so two branches that each add "the next" migration
  ! both claim the same number and one of them is silently skipped after a merge.
  !
  ! ORDER IS THE FILENAME. Files are stamped to the second, applied in lexical
  ! order, and are APPEND-ONLY once written. Editing one that some database has
  ! already run changes nothing for that database and everything for the next,
  ! which is a divergence with no symptom until the two disagree.
  !
  ! `Schema` RUNS FIRST and describes the current shape, so a migration that
  ! creates a table must say `IF NOT EXISTS` and expect to find it already there.
  ! What a migration is for is the work `CREATE TABLE IF NOT EXISTS` cannot do.
  !
  ! ONE FILE IS ONE TRANSACTION, and the row recording it is inside that
  ! transaction. All of it lands or none of it does, so there is no state where a
  ! database has been changed and not marked — which is the state that makes the
  ! next start run the change a second time. SQLite allows this where most
  ! databases would not: `CREATE`, `ALTER` and `DROP` are transactional here.
  !
  ! The files still carry their own `BEGIN IMMEDIATE`/`COMMIT` so that one can be
  ! run by hand against a copy, which is how it gets reviewed before a deploy.
  ! `statements` skips those markers, since this owns the wider transaction.
//]

namespace harpe.examples.smartlogistics.db

import harpe.ffi.os
import harpe.util.File

section Migrations

  //[ Bring this database into step with `directory`.
    !
    ! `fresh` says the file did not exist before `Schema` ran, and it decides
    ! which of two things happens. A fresh database is BASELINED: every file is
    ! recorded without being run, because `Schema` has already created the shape
    ! they exist to arrive at, and running them would fail on the first `ALTER
    ! TABLE` for a column that is already there. An existing database is
    ! MIGRATED: the files it has not recorded are run, in order.
    !
    ! A missing directory is not an error. `Schema` alone is a complete database,
    ! and a checkout that has never needed a migration is one.
  //]
  def reconcile(databasePath: String, directory: String, fresh: Bool): Unit =
    if os.path.isdir(directory) then
      val conn = Schema.open(databasePath)
      for version in pending(directory, recorded(conn)) do
        if fresh then record(conn, version)
        else run(conn, version, os.path.join(directory, version + ".sql"))
      conn.close()

  //[ The versions this database has already had. //]
  private def recorded(conn: py.Dynamic): List[String] =
    var out: List[String] = []
    for row in py.iter(conn.execute("SELECT version FROM schema_migrations")) do
      out = out ++ [row[0].asString]
    out

  //[ The `.sql` files not yet recorded, in filename order. //]
  private def pending(directory: String, applied: List[String]): List[String] =
    val names = py.module("builtins").sorted(os.listdir(directory))
    var out: List[String] = []
    for name in py.iter(names) do
      val file = name.asString
      if file.endsWith(".sql") then
        val version = file.substring(0, file.size - 4)
        if !applied.contains(version) then out = out ++ [version]
    out

  //[ Mark a version as applied without running it — the baseline path, for a
    ! database `Schema` has just created at the shape these files lead to.
  //]
  private def record(conn: py.Dynamic, version: String): Unit =
    conn.execute:
      "INSERT INTO schema_migrations(version, applied_at) VALUES(?, datetime('now'))"
      py.list(version)
    conn.commit()

  //[ One file AND its version row, in one transaction. All of it lands or none
    ! of it does — including the record that it landed, which is the half that
    ! matters. Recorded separately, a crash in the gap leaves a database changed
    ! and not marked, and the next start runs the change again.
  //]
  private def run(conn: py.Dynamic, version: String, path: String): Unit =
    match py.try(attempt(conn, version, path))
    case Ok(_) => pass
    case Err(error) =>
      // The failing statement already aborted the transaction in most cases, and
      // failing to roll back one that is no longer open is not itself news.
      val _ = py.try(conn.execute("ROLLBACK"))
      abort("migration \{version} failed and was rolled back: \{error.message}. "
            + "The database is exactly as it was. Correct \{path} and start again.")

  private def attempt(conn: py.Dynamic, version: String, path: String): Unit =
    conn.execute("BEGIN IMMEDIATE")
    for statement in statements(File.read(path)) do
      conn.execute(statement)
    conn.execute:
      "INSERT INTO schema_migrations(version, applied_at) VALUES(?, datetime('now'))"
      py.list(version)
    conn.execute("COMMIT")

  //[ Cut a file into executable statements, dropping its own transaction
    ! markers. A file keeps its `BEGIN IMMEDIATE`/`COMMIT` so that it can still be
    ! run by hand against a copy, and they are skipped here because this owns a
    ! wider transaction than the file knows about.
    !
    ! `sqlite3.complete_statement` decides where a statement ends rather than a
    ! split on semicolons, because a trigger body contains `BEGIN … END;` and
    ! cutting that in half produces nonsense.
  //]
  private def statements(sql: String): List[String] =
    val sqlite = py.module("sqlite3")
    var out: List[String] = []
    var buffer = ""
    for line in sql.split("\n") do
      buffer = buffer + line + "\n"
      if sqlite.complete_statement(buffer).asBool then
        val statement = buffer.trim
        if statement != "" && !isTransactionControl(statement) then
          out = out ++ [statement]
        buffer = ""
    out

  //[ Whether a statement is `BEGIN …` or `COMMIT`, ignoring any comment lines
    ! gathered in front of it. `END` is deliberately not here: the only `END` a
    ! file like this contains closes a trigger body, and that arrives inside its
    ! `CREATE TRIGGER` statement rather than as one of its own.
  //]
  private def isTransactionControl(statement: String): Bool =
    var code = ""
    for line in statement.split("\n") do
      val text = line.trim
      if text != "" && !text.startsWith("--") && code == "" then code = text
    val upper = py.dynamic(code).upper().asString
    upper.startsWith("BEGIN") || upper.startsWith("COMMIT")
end
