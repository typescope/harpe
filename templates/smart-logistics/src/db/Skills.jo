//[ Skills.jo
  !
  ! The planner's method, edited while the app runs.
  !
  ! A skill is a file the planner reads on demand. Every save records a revision,
  ! so the previous wording stays auditable.
//]

namespace smart.logistics.db

import harpe.ffi.os
import harpe.util.File

//[ The application's own directory. `skills/plan` beneath it holds the files.
  !
  ! A context parameter rather than an argument on five functions, and declared
  ! here rather than imported from the application: a store package that reaches
  ! up into the app it serves cannot be compiled — or tested — without it.
//]
param projectHome: String

section Skills

  //[ Skills are the planner's method, edited while the app runs. Every save
    ! records a revision, so the previous wording stays auditable.
  //]
  private def skillsDir(): String receives projectHome = os.path.join(projectHome, "skills", "plan")

  def skillNames(): py.List receives projectHome =
    val result = py.list()
    for name in py.iter(py.module("os").listdir(skillsDir())) do
      val text = name.asString
      if text.endsWith(".md") then result.append(text.substring(0, text.size - 3))
    py.dynamic(result).sort()
    result

  def readSkill(name: String): String receives projectHome =
    File.read(os.path.join(skillsDir(), skillSlug(name) + ".md"))

  def saveSkill(name: String, content: String): String receives conn, projectHome =
    val slug = skillSlug(name)
    if content.trim == "" then abort "skill content cannot be empty"
    val _ = DB.inTransaction(() => writeRevision(slug, content))
    File.write(os.path.join(skillsDir(), slug + ".md"), content)
    slug

  private def writeRevision(slug: String, content: String): Int receives conn =
    val next = conn
      .execute:
         "SELECT COALESCE(MAX(revision),0)+1 FROM skill_revisions WHERE skill_name=?"
         py.list(slug)
      .fetchone()[0].asInt
    conn.execute:
      """
      INSERT INTO skill_revisions(skill_name,content,revision,created_at)
      VALUES(?,?,?,datetime('now'))
      """
      py.list(slug, content, next)
    next

  def skillRevisions(name: String): py.List receives conn =
    DB.rowsWith:
      """
      SELECT revision, created_at, LENGTH(content) AS size
      FROM skill_revisions WHERE skill_name=? ORDER BY revision DESC
      """
      py.list(skillSlug(name))

  def skillRevision(name: String, revision: Int): String receives conn =
    val found = DB.rowsWith(
      "SELECT content FROM skill_revisions WHERE skill_name=? AND revision=?",
      py.list(skillSlug(name), revision))
    if found.size == 0 then abort "no such revision"
    found[0].cast[py.Dict].get("content").asString

  def deleteSkill(name: String): Bool receives projectHome =
    val slug = skillSlug(name)
    if slug == "planning" then return false
    val target = os.path.join(skillsDir(), slug + ".md")
    if !File.exists(target) then return false
    py.module("os").remove(target)
    true

  //[ A strict slug allowlist rather than trusting a path from the browser. //]
  private def skillSlug(name: String): String =
    val slug = py.dynamic(name.trim).lower().asString
    val valid = py.module("re").fullmatch("[a-z0-9]+(?:-[a-z0-9]+)*", slug)
    if valid.isNone || slug == "api" || slug == "types" then
      abort "invalid or reserved skill name"
    slug
end
