//[ Checks.jo
  !
  ! What the administrator wrote, and what the watcher currently says about it.
  !
  ! Checks are sentences, not thresholds. Nothing here machine-checks them — the
  ! watcher reads them, and its warnings are the output.
//]

namespace smart.logistics.db

section Checks

  def checks(): py.List receives conn = DB.rows("SELECT * FROM checks ORDER BY id")

  def saveCheck(body: py.Dict): Int receives conn =
    val text = body.get("text", "").asString.trim
    if text == "" then abort "a check needs text"
    val enabled = if body.get("enabled", true).asBool then 1 else 0
    DB.inTransaction(() => writeCheck(body.get("id", 0).asInt, text, enabled))

  private def writeCheck(id: Int, text: String, enabled: Int): Int receives conn =
    if id == 0 then
      val cursor = conn.execute:
        """
        INSERT INTO checks(text,enabled,created_at,updated_at)
        VALUES(?,?,datetime('now'),datetime('now'))
        """
        py.list(text, enabled)
      cursor.lastrowid.asInt
    else
      conn.execute:
        """
        UPDATE checks SET text=?,enabled=?,updated_at=datetime('now') WHERE id=?
        """
        py.list(text, enabled, id)
      id

  def deleteCheck(id: Int): Unit receives conn =
    val _ = DB.inTransaction(() => DB.execute(
      "DELETE FROM checks WHERE id=?", py.list(id)))

  //[ What the watcher is currently saying, worst first. //]
  def warnings(): py.List receives conn = DB.rows("""
    SELECT w.*, p.sku, p.name AS product_name, pos.days_of_cover, pos.lead_time_days,
           COALESCE(c.text,'') AS check_text
    FROM warnings w
    JOIN products p ON p.id = w.product_id
    JOIN product_position pos ON pos.product_id = w.product_id
    LEFT JOIN checks c ON c.id = w.check_id
    WHERE w.resolved_at = ''
    ORDER BY CASE w.severity WHEN 'critical' THEN 0 ELSE 1 END, pos.days_of_cover
  """)

  //[ Anything the watcher did not raise again this run no longer holds. //]
  def resolveWarningsNotRaisedBy(runId: Int): Int receives conn =
    DB.inTransaction: () =>
      DB.execute:
        """
        UPDATE warnings SET resolved_at = datetime('now')
        WHERE resolved_at = '' AND last_run_id != ?
        """
        py.list(runId)
end
