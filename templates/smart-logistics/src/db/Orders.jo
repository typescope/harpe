//[ Orders.jo
  !
  ! An order, from the draft a planner proposes to the delivery that closes it.
  !
  ! Only a person moves an order out of `draft`, and only a delivery moves it on
  ! from `ordered`. Receiving writes to the ledger through the same guards as a
  ! movement keyed in by hand, in one transaction with the receipt it records.
//]

namespace harpe.examples.smartlogistics.db

section Orders

  //[ Every order, whatever state it reached, with what is still owed on each
    ! line and every delivery already booked against it.
  //]
  def drafts(): py.List receives conn =
    val result = DB.rows("""
      SELECT d.*, s.name AS supplier_name,
        (d.status IN ('ordered','part_received')) AS outstanding,
        (d.status IN ('ordered','part_received') AND d.expected_at != ''
           AND date(d.expected_at) < date('now')) AS overdue
      FROM draft_orders d
      JOIN suppliers s ON s.id = d.supplier_id ORDER BY d.id DESC
    """)
    for item in result do
      val d = item.cast[py.Dict]
      d.set:
        "lines"
        DB.rowsWith:
          """
          SELECT l.*, p.sku, p.name,
                 l.quantity - l.received_quantity AS outstanding_quantity
          FROM draft_order_lines l
          JOIN products p ON p.id = l.product_id
          WHERE l.draft_order_id = ? ORDER BY p.sku
          """
          py.list(d.get("id"))
      d.set:
        "receipts"
        DB.rowsWith:
          """
          SELECT r.*, p.sku, p.name FROM order_receipts r
          JOIN products p ON p.id = r.product_id
          WHERE r.draft_order_id = ? ORDER BY r.received_at, r.id
          """
          py.list(d.get("id"))
    result

  //[ Move one order along its life, by hand.
    !
    ! Only the transitions a person makes are here. `part_received` and
    ! `received` are not among them: an order arrives because goods arrived, so
    ! those are reached by recording a delivery and by nothing else.
    !
    ! `accepted` is the word the page has always used for placing an order, and
    ! it still works; the state it now writes is `ordered`, because an order
    ! half-delivered is no longer meaningfully "accepted".
  //]
  def setDraftStatus(id: Int, status: String): Bool receives conn =
    val wanted = if status == "accepted" then "ordered" else status
    if wanted == "ordered" then place(id)
    else if wanted == "rejected" then close(id, "rejected", "'draft'")
    // Cancelling leaves what already arrived in the ledger and stops the rest
    // counting towards cover — which the outstanding sum does on its own, as
    // soon as the order is no longer in an outstanding state.
    else if wanted == "cancelled" then close(id, "cancelled", "'ordered','part_received'")
    else false

  //[ Placing an order fixes what we were promised: the longest lead time on it,
    ! read once, from the terms in force now.
  //]
  private def place(id: Int): Bool receives conn =
    DB.inTransaction(() => DB.execute("""
      UPDATE draft_orders SET status='ordered', updated_at=datetime('now'),
        ordered_at=datetime('now'),
        expected_at=COALESCE((
          SELECT date('now','+' || MAX(ps.lead_time_days) || ' days')
          FROM draft_order_lines l
          JOIN product_suppliers ps ON ps.product_id = l.product_id
                                   AND ps.supplier_id = draft_orders.supplier_id
          WHERE l.draft_order_id = draft_orders.id), date('now'))
      WHERE id=? AND status='draft'
    """, py.list(id))) == 1

  //[ `allowed` is the SQL list of states this transition may leave, written
    ! literally at the call site because it is fixed there, never user input.
  //]
  private def close(id: Int, status: String, allowed: String): Bool receives conn =
    DB.inTransaction(() => DB.execute("""
      UPDATE draft_orders SET status=?,updated_at=datetime('now'),
        closed_at=datetime('now')
      WHERE id=? AND status IN (\{allowed})
    """, py.list(status, id))) == 1

  //[ Booking a delivery in. This is the only thing that moves an order out of
    ! the outstanding set, and the only place ordered stock becomes real stock.
    !
    ! Every unit received is written to the ledger as an ordinary receipt, past
    ! the same guards as one keyed in by hand, and linked to the line it
    ! settles. Nothing sets a balance; the balance is still the sum of the
    ! ledger, and now the ledger holds the delivery too.
    !
    ! Returns how many units were booked.
  //]
  def receiveOrder(body: py.Dict): Int receives conn =
    val orderId = body.get("order_id", 0).asInt
    val lines = body.get("lines", py.list()).cast[py.List]
    if lines.size == 0 then abort "a delivery needs at least one line"
    DB.inTransaction(() => writeReceipt(orderId, lines, body))

  private def writeReceipt(
    orderId: Int, lines: py.List, body: py.Dict
  ): Int receives conn =
    val order = conn
      .execute:
         "SELECT status FROM draft_orders WHERE id = ?"
         py.list(orderId)
      .fetchone()
    if order.isNone then abort "unknown order"
    val status = order[0].asString
    if status != "ordered" && status != "part_received" then
      abort "order \{orderId} is \{status}, so nothing can be received against it"

    val occurredAt = body.get("occurred_at", "").asString.trim
    val note = body.get("note", "").asString.trim
    var seen: List[Int] = []
    var total = 0
    for raw in py.iter(lines) do
      val line = raw.cast[py.Dict]
      val lineId = line.get("line_id", 0).asInt
      val quantity = line.get("quantity", 0).asInt
      if quantity <= 0 then abort "a delivered line needs a positive quantity"
      // Two rows for one line would each be checked against the same
      // outstanding figure, and together could overshoot it.
      if seen.contains(lineId) then
        abort "line \{lineId} appears twice in one delivery"
      seen = seen + lineId
      total = total + receiveLine(orderId, lineId, quantity, occurredAt, note)
    settle(orderId)
    total

  private def receiveLine(
    orderId: Int, lineId: Int, quantity: Int,
    occurredAt: String, note: String
  ): Int receives conn =
    val row = conn
      .execute:
         """
         SELECT product_id, quantity - received_quantity
         FROM draft_order_lines WHERE id = ? AND draft_order_id = ?
         """
         py.list(lineId, orderId)
      .fetchone()
    if row.isNone then abort "line \{lineId} is not on order \{orderId}"
    val productId = row[0].asInt
    val outstanding = row[1].asInt
    if outstanding <= 0 then abort "that line has already been delivered in full"
    // A supplier really can send more than was ordered, but this order cannot
    // absorb it: what is outstanding would go negative and cover would read
    // low for ever after. The excess is stock that arrived against no line, so
    // it belongs in the ledger as its own receipt.
    if quantity > outstanding then
      val excess = "only \{outstanding} of that line is still outstanding; "
        + "record anything over that as a separate receipt"
      abort excess

    val movementId = Stock.writeMovement:
      productId
      "receipt"
      quantity
      py.dict:
        "occurred_at" ~ occurredAt
        "reference"   ~ "PO-\{orderId}"
        "note"        ~ note
    conn.execute:
      """
      UPDATE draft_order_lines SET received_quantity = received_quantity + ?
      WHERE id = ?
      """
      py.list(quantity, lineId)
    conn.execute:
      """
      INSERT INTO order_receipts
        (draft_order_id,line_id,product_id,quantity,movement_id,received_at,note)
      VALUES(?,?,?,?,?,COALESCE(NULLIF(?,''),datetime('now')),?)
      """
      py.list(orderId, lineId, productId, quantity, movementId, occurredAt, note)
    quantity

  //[ An order is received once every line is, and part-received until then.
    ! What is still owed keeps counting towards cover, because it is still
    ! coming.
  //]
  private def settle(orderId: Int): Unit receives conn =
    val remaining = conn
      .execute:
         """
         SELECT COALESCE(SUM(quantity - received_quantity),0)
         FROM draft_order_lines WHERE draft_order_id = ?
         """
         py.list(orderId)
      .fetchone()[0].asInt
    if remaining == 0 then
      conn.execute:
        """
        UPDATE draft_orders SET status='received', updated_at=datetime('now'),
          closed_at=datetime('now') WHERE id=?
        """
        py.list(orderId)
    else
      conn.execute:
        """
        UPDATE draft_orders SET status='part_received', updated_at=datetime('now')
        WHERE id=?
        """
        py.list(orderId)
end
