//[ Runs.jo
  !
  ! What each agent did, and when.
  !
  ! A run is opened before an agent turn and closed after it, so a run left
  ! `running` is one whose process is gone.
//]

namespace harpe.examples.smartlogistics.db

section Runs

  def runs(): py.List receives conn = DB.rows("SELECT * FROM runs ORDER BY id DESC LIMIT 20")

  def beginRun(kind: String, trigger: String, note: String): Int receives conn =
    DB.inTransaction: () =>
      DB.insert:
        """
        INSERT INTO runs(kind,trigger,note,status,started_at)
        VALUES(?,?,?,'running',datetime('now'))
        """
        py.list(kind, trigger, note)

  def finishRun(id: Int, status: String, summary: String): Unit receives conn =
    val _ = DB.inTransaction: () =>
      DB.execute:
        """
        UPDATE runs SET status=?,summary=?,finished_at=datetime('now') WHERE id=?
        """
        py.list(status, summary, id)

  //[ A run is executed by this process, so none can outlive it. Anything left
    ! `running` belongs to a process that is gone — without this the row stays
    ! running for ever, and the page waits on a run nobody is performing.
    !
    ! Called once at startup, before anything serves.
  //]
  def failStale(): Unit receives conn =
    val _ = DB.execute("""
      UPDATE runs SET status='failed', finished_at=datetime('now'),
        summary='The server stopped while this run was in progress. Nothing was '
                || 'recorded from it, and no warnings were resolved.'
      WHERE status='running'
    """, py.list())
    conn.commit()
end
