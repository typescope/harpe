//[ Tool.jo
  !
  ! The tool abstraction
  !
  ! A `Tool` is a name + prose + typed parameters: the spec the model is offered.
  ! What runs when the model calls it is a `Handler`. Neither travels alone — a
  ! `Toolset` wires each spec to its handler, and that pair is what a turn is
  ! given.
  !
  ! Tool authors describe inputs in Jo. Each provider renders its own wire spec
  ! from this model, so `Tool` stays provider-neutral and authors never
  ! hand-write JSON.
  !
  ! Handlers read arguments via the typed `ToolInput` and return a `RunOutcome`.
//]

namespace harpe

import harpe.Tool.*
import harpe.Model.Attachment
import harpe.logging.logger

//[ A tool spec
  !
  ! One LLM-facing tool as the model sees it: a Jo description of its name,
  ! prose, and typed params. It carries no behaviour — see `Handler` — so the
  ! same spec can be answered differently by two sessions, each wiring it into
  ! its own `Toolset`.
  !
  ! A spec that is just its three parts comes from the `Tool(...)` factory
  ! below. A tool with logic of its own — helpers, state it owns, a resource it
  ! holds — implements this interface and exposes typed methods its routes call,
  ! so that logic lives in one unit.
//]
interface Tool
  //[ The name the model calls this tool by. //]
  def name: String

  //[ Prose the model reads to decide WHEN to call it. //]
  def description: String

  //[ The typed inputs this tool accepts
    !
    ! Read afresh every time a request is rendered, not once when the tool was
    ! built, so a tool may derive its schema from live state.
  //]
  def params: List[ToolParam]
end

//[ What a driver wires a tool's spec to
  !
  ! The host-side code that actually runs when the model calls a tool. It is NOT
  ! part of `Tool`: the spec is a constant the model reads, while the handler is
  ! written where the driver's own context is in scope — a session's data
  ! directory, its chat id, its API client. That is what lets a handler close
  ! over typed values instead of receiving them through an untyped bag.
  !
  ! `logger` stays ambient. The turn passes its ordinary `Interact` argument to
  ! the selected handler, so a driver can still build its `Toolset` once.
//]
type Handler = (ToolInput, Interact) => RunOutcome receives logger

//[ A tool spec from its three parts
  !
  ! The plain way to declare a tool, and what most tools want:
  !
  ! ```
  ! Tool:
  !   "weather"
  !   "Look up the current weather in a city"
  !   [Tool.strParam("city", "the city to look up")]
  ! ```
  !
  ! What runs when the model calls it is the driver's `Handler`, wired to this
  ! spec in a `Toolset`.
//]
def Tool(name: String, description: String, params: List[ToolParam]): Tool =
  new Tool.SimpleTool(name, description, params)

section Tool
  //[ A tool result
    !
    ! - `result` is the text fed back to the model
    ! - `summary` is the one-line status shown in the console
    ! - `attachments` is any file the tool wants to show the model directly (not
    !   just reference by name) — e.g. `uploadMedia` returning the file so the
    !   render layer sends it as a real image/document content block.
    !   `[]` for the ordinary, text-only case.
    ! - `success` is whether the call did what it was asked to
    !
    ! `success` is for CODE, `result` is for the model. A handler that refuses a
    ! call — a name that resolves to nothing, an argument out of range — explains
    ! itself in `result` and sets `success = false`, and the two must agree. The
    ! model reads the prose and can correct itself. A driver reading its own
    ! output back off the finished turn (see `harpe.web.Session.reply`) reads the
    ! flag, so a refused call is not mistaken for work done.
  //]
  class RunOutcome(result: String, summary: String, attachments: List[Attachment], success: Bool = true)

  //[ Tool parameter type
    !
    ! The JSON-schema type of a tool input parameter, modeled in Jo so tool
    ! authors never hand-write JSON schema.
  //]
  union ParamType = StrParam | IntParam | BoolParam | NumParam
    //[ Map a `ParamType` to its JSON-schema type string.
      !
      ! Shared by all provider impls so each one can render tool specs without
      ! duplicating this mapping.
    //]
    def jsonType: String =
      match this
      case StrParam  => "string"
      case IntParam  => "integer"
      case BoolParam => "boolean"
      case NumParam  => "number"

  //[ Tool parameter
    !
    ! One input parameter of a tool: its name, type, human description, and
    ! whether it is required.
  //]
  class ToolParam(name: String, paramType: ParamType, description: String, required: Bool)

  //[ A tool call the model wants to make
    !
    ! A provider id, the tool name, and the typed arguments.
  //]
  class ToolCall(id: String, name: String, input: ToolInput)

  //[ The result of running a tool call, fed back to the model next turn.
    !
    ! `attachments` mirrors `RunOutcome.attachments` — carried through for the
    ! provider render layer to send as content blocks (see `RunOutcome`).
    !
    ! `success` mirrors it too, and rides into the transcript rather than stopping
    ! at the engine: a turn reloaded from the journal knows which of its calls
    ! were refused, exactly as the live one did. No provider sends it — the model
    ! sees `content`.
  //]
  class ToolResult(id: String, content: String, attachments: List[Attachment], success: Bool = true)

  //[ Input in a tool call
    !
    ! Typed access to the arguments the model supplied for a tool call, so
    ! handlers read `input.string("code")` instead of poking a raw py.Dict.
  //]
  class ToolInput(raw: py.Dict)
    //[ The string argument under `key`, or `""` if the model omitted it
      !
      ! The indexing form of `string`, so a route reads as one line:
      ! `i => runBash(i["command"])`.
    //]
    def get(key: String): String = string(key)

    def string(name: String): String = raw.get(name, "").asString
    def stringOr(name: String, fallback: String): String = raw.get(name, fallback).asString

    def int(name: String): Int = intOr(name, 0)
    def intOr(name: String, fallback: Int): Int = raw.get(name, fallback).asInt

    def bool(name: String): Bool = boolOr(name, false)
    def boolOr(name: String, fallback: Bool): Bool = raw.get(name, fallback).asBool

    def num(name: String): Float = numOr(name, 0.0)
    def numOr(name: String, fallback: Float): Float = raw.get(name, fallback).asFloat
  end


  //[ A tool spec that is nothing but its three parts
    !
    ! What the `Tool(...)` factory builds. A tool with logic of its own is a
    ! class implementing `Tool` and exposing whatever typed methods its routes
    ! call — see `harpe.tools.RunCodeTool`.
    !
    ! The constructor parameters are named apart from the interface members
    ! because a class parameter does not itself implement one, so each is
    ! forwarded.
  //]
  class SimpleTool(toolName: String, toolDescription: String, toolParams: List[ToolParam])
    view Tool

    def name: String = toolName
    def description: String = toolDescription
    def params: List[ToolParam] = toolParams
  end

  //[ Run a handler, containing an unexpected host exception
    !
    ! A well-behaved handler returns a `RunOutcome`. This is the backstop for
    ! one that raises. The failure is fed back to the model as a tool result —
    ! so the model can react — rather than crashing the turn (or the driver).
    ! The engine applies it to every route, so a driver's wiring cannot take the
    ! turn down.
  //]
  def runSafely(name: String, handler: Handler, input: ToolInput, interact: Interact): RunOutcome receives logger =
    match py.try(handler(input, interact))
    case Ok(outcome) => outcome

    case Err(e) =>
      new RunOutcome:
        "The tool '\{name}' failed: \{e.message}"
        "error · \{name}"
        attachments = []
        success = false

  //[ A required string parameter — the common case when defining a tool. //]
  def strParam(name: String, description: String): ToolParam =
    new ToolParam(name, StrParam, description, true)

  //[ A required integer parameter. //]
  def intParam(name: String, description: String): ToolParam =
    new ToolParam(name, IntParam, description, true)

  //[ A required boolean parameter. //]
  def boolParam(name: String, description: String): ToolParam =
    new ToolParam(name, BoolParam, description, true)

  //[ A required number (float) parameter. //]
  def numParam(name: String, description: String): ToolParam =
    new ToolParam(name, NumParam, description, true)

  //[ Bound a tool result's text to at most `maxChars`
    !
    ! Keeping the head and the tail and marking the elided middle (a program's
    ! setup is at the start, its errors and final output at the end — both worth
    ! keeping). Text within the limit is returned unchanged.
    !
    ! This bounds only what the model sees. A tool that elides is expected to
    ! preserve the full artifact elsewhere (e.g. `runCode` logs it to
    ! `logs/agent.jsonl`), so nothing is lost from the record — this is the
    ! "reference, don't inline" rule.
  //]
  def elide(text: String, maxChars: Int): String =
    if text.size <= maxChars then
      text

    else
      val headLen = maxChars / 2
      val tailLen = maxChars - headLen
      val head = text.substring(0, headLen)
      val tail = text.substring(text.size - tailLen, text.size)
      val elided = text.size - headLen - tailLen
      "\{head}\n…[\{elided} characters elided]…\n\{tail}"
