//[ Value.jo
  !
  ! What a log field — or a transcript payload — is allowed to be: a scalar, an
  ! array, or a map of them. The framework's JSON-shaped data type, and the one
  ! place its host representation is mapped in and out.
//]

namespace harpe.logging

import harpe.ffi.builtins

//[ A loggable value: a scalar, an array, or a map
  !
  ! Scalars go in bare — the adapters box `Int`/`Bool` on the way in:
  !
  ! logger.log: "runs", "code" ~ src, "secs" ~ 1.5, "exitCode" ~ n, "ok" ~ true
  !
  ! The nested map lets a whole sub-record ride under one key (see
  ! `ContextLogger`).
//]
type Value =
  (String | Float | Value.IntVal | Value.BoolVal | List[Value] | Map[String, Value])
    :- [Value.IntVal, Value.BoolVal]

section Value
  //[ Boxes for the two primitives
    !
    ! Jo allows at most one numeric/boolean primitive per union.
  //]
  class IntVal(value: Int)
  class BoolVal(value: Bool)

  //[ A value as its underlying host value — the inverse of the `Value` adapters
    !
    ! A nested map becomes a nested JSON object.
  //]
  def toJson(v: Value): Any =
    match v
    case s: String  => s
    case f: Float   => f
    case IntVal(n)  => n
    case BoolVal(b) => b

    case xs: List[Value] =>
      val list = py.list()
      for x in xs do list.append(toJson(x))
      list

    case m: Map[String, Value] =>
      val d = py.dict()
      for k ~ vv in m.toList do d.set(k, toJson(vv))
      d

  //[ A decoded JSON value as a `Value` //]
  def fromJson(obj: py.Dynamic): Value =
    match typeName(obj)
    case "bool"  => BoolVal(obj.asBool)
    case "int"   => IntVal(obj.asInt)
    case "float" => obj.asFloat
    case "list"  =>
      var list: List[Value] = []
      for x in obj.cast[py.List] do list = list + fromJson(x)
      list

    case "dict"  =>
      var m = Map.empty[String, Value]
      val d = obj.cast[py.Dict]
      for k in py.iter(d.keys()) do m = m.add(k.asString, fromJson(d.get(k)))
      m

    case _ => obj.asString

  //[ The name of a decoded value's Python type (`"str"`, `"int"`, `"dict"`, …)
    !
    ! The EXACT type, not an `isInstance` test, and that is the point: Python's
    ! `bool` is a subclass of `int`, so an `isInstance` chain decodes `true` as
    ! `1` unless `bool` is tested first — a correctness bug one reordering away.
    ! JSON has six types and a value is exactly one of them, so the exact name is
    ! both the safer question and the right one. Private because that reasoning
    ! holds for decoding JSON and nowhere else: a caller asking whether a value
    ! can be USED as something wants `py.isInstance` (see `Http.readJson`).
  //]
  private def typeName(obj: py.Dynamic): String =
    builtins.getattr(builtins.typeOf(obj), "__name__").asString
end
