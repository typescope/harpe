//[ NullLogger.jo
  !
  ! A `Logger` that records nothing — for tests and for running with logging
  ! switched off. It is stateless, so a single shared object suffices. Exposed
  ! through `Logging.discard`.
//]

namespace harpe.logging

private object NullLogger
  view Logger

  def logEntry(entry: Entry): Unit = pass

  def close(): Unit = pass
end
