//[ Logger.jo
  !
  ! Where log entries go — the extensible half of the logging design. A `Logger`
  ! owns BOTH the format (JSON, sqlite, logfmt, a metrics API) and the target (a
  ! file, a database, a socket). Third-party code adds a backend by implementing
  ! `logEntry`. Producers, which hold a `Logger` and call `log`, never change.
  !
  ! The framework ships `JsonlLogger` (see JsonlLogger.jo), which appends every
  ! entry as one JSON line to a single file (`event` a field). Routing
  ! entries to different targets by `event` is just another `Logger` impl a
  ! driver can write, so none is provided.
  !
  ! A BACKEND MUST BE THREAD SAFE. A turn's tools run concurrently and log as
  ! they go, and a driver may bind this channel without any scope wrapping it, so
  ! there is nowhere else the guarantee could come from.
//]

namespace harpe.logging
import harpe.ffi.time
import harpe.util.Clock

//[ A log target.
  !
  ! Producers call `log`, the convenient front door — `logger.log("runs", "code" ~
  ! src, "exitCode" ~ n)` — which stamps the time, assembles the record, and hands
  ! it to `logEntry`. A producer whose fields are already a map calls `logFields`
  ! for the same record. Backends implement `logEntry` (and `close`, releasing any
  ! resources at the end of the logging scope — `pass` if there are none).
//]
interface Logger
  def log(event: String, fields: ..(String ~ Value)): Unit =
    var map = Map.empty[String, Value]
    for k ~ v in fields do map = map.add(k, v)
    logFields(event, map)

  //[ Log a record whose fields are already a map — what a codec calls
    !
    ! `log` takes loose pairs because a producer types them at the call site. A
    ! codec has assembled the map already (see `harpe.turns.TurnLog`), and
    ! spreading it back into pairs to get here is the one step where a field
    ! could go missing. The record is the same either way: stamped now, with no
    ! scopes of its own — the ambient `ContextLogger` adds those.
  //]
  def logFields(event: String, fields: Map[String, Value]): Unit =
    logEntry(new Entry(Clock.now(), event, fields, []))

  //[ Log a diagnostic message at a severity — the reserved-key convention on `Entry`
    !
    ! `message` becomes the `info`/`warning`/`error` field. Any extra structured
    ! context goes in `fields`:
    !
    ! logger.warn("harpe.model.retried", "rate limited, retrying", "attempt" ~ 3)
  //]
  def info(event: String, message: String, fields: ..(String ~ Value)): Unit =
    log(event, "info" ~ message, ..fields)

  def warn(event: String, message: String, fields: ..(String ~ Value)): Unit =
    log(event, "warning" ~ message, ..fields)

  def error(event: String, message: String, fields: ..(String ~ Value)): Unit =
    log(event, "error" ~ message, ..fields)

  def logEntry(entry: Entry): Unit

  def close(): Unit
end
