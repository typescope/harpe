//[ ContextLogger.jo
  !
  ! A `Logger` decorator that stamps ambient context — the "which user / which
  ! session" of a turn — onto every entry before passing it to the wrapped
  ! logger. A driver installs one per turn via `Logging.withContext`. Because
  ! the stamping happens in `logEntry` (the choke point every record flows
  ! through), it catches `log`, the severity helpers, and direct `logEntry`
  ! alike.
  !
  ! The `scope` goes in as ONE ENTRY in the context list, never merged into
  ! `fields` — so ambient context can never collide with a producer's own field.
  ! It is a string because a scope is an identity (see `Entry`).
  !
  ! It PREPENDS. Decorators wrap outward, so a record meets the innermost scope
  ! first and the outermost last, and prepending at each hop leaves the list
  ! outermost first — the same order the scopes were entered, and the order a
  ! path is written. Nothing is replaced: two nested scopes both survive, which
  ! stamping into one keyed field could not express.
//]

namespace harpe.logging

private[harpe] class ContextLogger(inner: Logger, scope: String)
  view Logger

  def logEntry(entry: Entry): Unit =
    inner.logEntry(new Entry(entry.time, entry.event, entry.fields, [scope] ++ entry.context))

  // A scoped decorator does not own the wrapped logger's lifecycle.
  def close(): Unit = pass
end
