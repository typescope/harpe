//[ JsonlLogger.jo
  !
  ! The framework's default `Logger` backend: append every entry as one JSON line
  ! to a single file, `event` included as a field. One file for all events
  ! keeps the log easy to consume — `jq 'select(.event=="runs")' log.jsonl`
  ! slices out one kind — and keeps this backend a plain append. This is the
  ! JSON-specific corner of the logging layer, kept apart so no other layer assumes
  ! JSON or a filesystem.
//]

namespace harpe.logging
import harpe.ffi.json

import harpe.ffi.os
import harpe.ffi.threading
import harpe.util.File

//[ Open `path` for appending, creating its parent directory if needed. //]
private def openLog(path: String): py.Dynamic =
  val dir = os.path.dirname(path)
  if dir != "" then File.ensureDir(dir)

  py.open(path, "a")

//[ Append each entry as one JSON line to `path`: `time`, `event`, then its fields
  !
  ! The file is opened once and kept open for the scope.
  !
  ! THREAD SAFE ON ITS OWN, because a backend must be (see `Logger`) and a turn's
  ! tools log concurrently. The lock is cheap and makes the guarantee this
  ! file's, rather than borrowing it from the host: CPython's buffered writer
  ! happens to serialize `write` itself, which is a property of that runtime and
  ! not of the contract.
//]
class JsonlLogger(path: String)
  view Logger

  private val out: py.Dynamic = openLog(path)
  private val lock = threading.Lock()

  def logEntry(entry: Entry): Unit =
    // Encoded before the lock is taken: only the file needs exclusive access,
    // and a record that will not serialize must not hold it up.
    val line = json.dumps(Entry.toDict(entry)) + "\n"

    lock.acquire()
    val written = py.try(append(line))
    lock.release()

    // Released first, then the failure is passed on as it always was — a full
    // disk should reach the producer, not wedge every later write behind a lock
    // its owner never let go of.
    match written
    case Ok(_)      => pass
    case Err(error) => abort error.message

  private def append(line: String): Unit =
    out.write(line)
    out.flush()

  def close(): Unit = out.close()
end
