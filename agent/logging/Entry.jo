//[ Entry.jo
  !
  ! The one thing a log producer and a log backend share: a neutral record of
  ! what happened. The record itself knows nothing of sqlite, files, or targets
  ! — only the data. A producer (the `runCode` tool, or any third-party tool)
  ! builds an `Entry`. A `Logger` decides how and where to store it.
  !
  ! `Entry.toDict` / `fromDict` are the one place the record meets its host
  ! representation, kept here rather than in a backend because both directions
  ! are needed off the JSONL path: the sandbox runtime serializes an entry to
  ! cross the subprocess boundary, and the host (`runCode`) rebuilds it to
  ! replay through its own contextual logger.
  !
  ! `readJsonl` is the missing half of `JsonlLogger`: what that backend writes,
  ! read back. It belongs beside `fromDict` rather than in a JSON helper, because
  ! JSON is the encoding this record happens to use, not the subject.
//]

namespace harpe.logging

import harpe.ffi.time
import harpe.ffi.json
import harpe.util.Clock
import harpe.util.File

//[ A log record: when it happened (`time`), the `event` it is, its named
  ! `fields`, and the `context` it was produced under.
  !
  ! EVENT CONVENTION. A record IS an event, and `event` is its name: a stable,
  ! dotted identifier whose LAST segment says WHAT HAPPENED —
  ! `harpe.turn.answered`, `harpe.model.failed`. Everything before it names the
  ! SUBJECT the event is about, so a consumer reads one subtree with
  ! `jq 'select(.event | startswith("harpe.model"))'` — every record about
  ! talking to a model, whatever the outcome — and the open set stays
  ! collision-free (a third-party tool cannot clash with a framework one).
  !
  ! ONE NAME, ONE FIELD SHAPE. The name is the record's schema tag, so two
  ! records carrying different fields are two events and take two names. A
  ! discriminator field standing in for that — an `outcome`, a `phase` — means
  ! the name stopped one segment short.
  !
  ! Each producer owns its event names and defines each once as a named constant
  ! (see `runCode`'s `runCodeEvent`). The prefix names the subject, NOT the
  ! namespace the code happens to sit in — the turn engine is in the bare root
  ! `harpe` and the journal in `harpe.transcript`, and both write about subjects
  ! of their own. That is what makes the next line possible: a subject outlives a
  ! package layout.
  !
  ! Keep the name STABLE: downstream consumers filter on it, so it is a data
  ! contract — not something to re-tie to the code on every refactor.
  !
  ! SEVERITY CONVENTION (optional). Most records are pure data — the outcome is
  ! in the name (`harpe.tools.runCode.compileFailed`), so they carry NO
  ! severity. A record that instead has a human-facing diagnostic message uses ONE
  ! reserved field key — `"info"`, `"warning"`, or `"error"` — whose value is that
  ! message. The `Logger.info` / `warn` / `error` helpers write it:
  !
  !     logger.warn("harpe.model.retried", "rate limited, retrying", "attempt" ~ 3)
  !
  ! The three keys are reserved for this and mutually exclusive (structured context
  ! goes in other fields — note `runCode` uses `"compileError"`, not `"error"`).
  ! Filter by key existence: `jq 'select(has("error"))'`, or
  ! `select(has("warning") or has("error"))` for warn-and-up.
  !
  ! CONTEXT IS A LIST, NOT A MAP. The ambient scopes a record was produced under
  ! — a session, a turn, the tool call within it — NEST, and a map holds one
  ! value per name, so the inner scope of two sharing a name would replace the
  ! outer one and vanish. A list keeps every scope a record was actually under,
  ! innermost first: the scope that produced the record, then the ones enclosing
  ! it.
  !
  ! A SCOPE IS A STRING, AND IT IS AN IDENTITY. What a reader does with context
  ! is tell one unit of work from another, which needs the scope to be stable for
  ! that unit and distinct between instances — so the type is the identity itself
  ! rather than a record that might carry one. `"<dotted key>=<id>"` by
  ! convention (`"harpe.turn.id=209b1e14"`), dotted for the reason event names
  ! are: an application's scopes cannot collide with the framework's. Detail
  ! about the unit belongs in the `fields` of the records produced under it,
  ! where it is queryable, not in the name of the scope.
  !
  ! Scopes are separate from `fields` at the type level, so ambient context can
  ! never collide with a producer's own key — `"context"` is reserved in the JSON.
//]
class Entry(time: Float, event: String, fields: Map[String, Value], context: List[String])

section Entry
  //[ An entry as a JSON-able dict
    !
    ! A FIXED FOUR-KEY ENVELOPE: `time`, `event`, `fields`, `context` — always
    ! all four, so a consumer never branches on which are present. Each `Value`
    ! is unwrapped to its underlying host value, and a nested map becomes a
    ! nested object.
    !
    ! Producer fields go UNDER `fields` rather than beside `time` and `event`.
    ! Flat, they shared one namespace with the record's own keys, so a producer
    ! field named `event` overwrote the record's name on the way out and was
    ! dropped on the way back. The envelope makes that unrepresentable instead
    ! of forbidden, and no key needs reserving.
    !
    ! `JsonlLogger` serializes with it.
  //]
  def toDict(entry: Entry): py.Dict =
    val fields = py.dict()
    for k ~ v in entry.fields.toList do fields.set(k, Value.toJson(v))

    val scopes = py.list()
    for scope in entry.context do scopes.append(py.dynamic(scope))

    py.dict:
      "time"    ~ Clock.toRfc3339(entry.time)
      "event"   ~ entry.event
      "fields"  ~ fields
      "context" ~ scopes

  //[ The inverse of `toDict`
    !
    ! Rebuild an `Entry` from a decoded JSON dict. Used to replay a sandboxed
    ! program's records on the host.
  //]
  def fromDict(d: py.Dict): Entry =
    val timestamp = Clock.fromRfc3339(d.get("time", "").asString)
    val event = d.get("event", "").asString

    var context: List[String] = []
    for item in d.get("context", py.list()).cast[py.List] do
      context = context + item.asString

    var fields = Map.empty[String, Value]
    val raw = d.get("fields", py.dict()).cast[py.Dict]
    for k in py.iter(raw.keys()) do
      fields = fields.add(k.asString, Value.fromJson(raw.get(k)))

    new Entry(timestamp, event, fields, context)

  //[ Every entry in the JSONL file at `path`, in the order written
    !
    ! Blank lines are skipped. A missing file raises, and so does a malformed
    ! line: what either means is the caller's to decide, not this record's. A
    ! driver for which no file means "this session has not spoken yet" checks
    ! `File.exists` first and reads the absence as `[]` — that is its policy, and
    ! a driver that would rather hear about a vanished journal is equally
    ! entitled. `runCode`'s audit replay tolerates a malformed line for the same
    ! reason, and keeps its own loop to do it.
  //]
  def readJsonl(path: String): List[Entry] =
    var entries: List[Entry] = []
    for line in File.read(path).lines if line.trim != "" do
      entries = entries + fromDict(json.loads(line).cast[py.Dict])
    entries
end
