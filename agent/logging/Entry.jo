//[ Entry.jo
  !
  ! The one thing a log producer and a log backend share: a neutral record of
  ! what happened. The record itself knows nothing of sqlite, files, or targets
  ! — only the data. A producer (the `runCode` tool, or any third-party tool)
  ! builds an `Entry`. A `Logger` decides how and where to store it.
  !
  ! `Entry.toDict` / `fromDict` are the one place the record meets its host
  ! representation, kept here rather than in a backend because both directions
  ! are needed off the JSONL path: the sandbox runtime serializes an entry to
  ! cross the subprocess boundary, and the host (`runCode`) rebuilds it to
  ! replay through its own contextual logger.
//]

namespace harpe.logging

import harpe.ffi.time
import harpe.util.Clock

//[ A log record: when it happened (`time`), its `category`, and named `fields`.
  !
  ! CATEGORY CONVENTION. A category is a stable, dotted, reverse-namespaced
  ! identifier for the KIND of record — like a logger name, e.g.
  ! `"harpe.tools.runCode"` (namespace + producer). Namespacing keeps the OPEN set
  ! collision-free (a third-party tool won't clash with a framework one) and lets
  ! a consumer filter a whole subtree —
  ! `jq 'select(.category | startswith("harpe.tools"))'`. Entries sharing a
  ! category share field shape, so it doubles as the record's schema tag.
  !
  ! Each producer owns its category and defines it once as a named constant (see
  ! `runCode`'s `runCodeCategory`). Derive it from the producer's namespace, but
  ! then keep it STABLE: downstream consumers filter on it, so it is a data
  ! contract — not something to re-tie to the code on every refactor.
  !
  ! SEVERITY CONVENTION (optional). Most records are pure data — the outcome lives
  ! in the fields (`"compiled" ~ false`) or the category, so they carry NO
  ! severity. A record that instead has a human-facing diagnostic message uses ONE
  ! reserved field key — `"info"`, `"warning"`, or `"error"` — whose value is that
  ! message. The `Logger.info` / `warn` / `error` helpers write it:
  !
  !     logger.warn("harpe.model", "rate limited, retrying", "attempt" ~ 3)
  !
  ! The three keys are reserved for this and mutually exclusive (structured context
  ! goes in other fields — note `runCode` uses `"compileError"`, not `"error"`).
  ! Filter by key existence: `jq 'select(has("error"))'`, or
  ! `select(has("warning") or has("error"))` for warn-and-up.
//]
class Entry(time: Float, category: String, fields: Map[String, Value])

section Entry
  //[ An entry as a JSON-able dict
    !
    ! `time`, `category`, then its fields (each `Value` unwrapped to its
    ! underlying host value. A nested map becomes a nested object).
    !
    ! `JsonlLogger` serializes with it.
  //]
  def toDict(entry: Entry): py.Dict =
    val d = py.dict("time" ~ Clock.toRfc3339(entry.time), "category" ~ entry.category)
    for k ~ v in entry.fields.toList do d.set(k, Value.toJson(v))
    d

  //[ The inverse of `toDict`
    !
    ! Rebuild an `Entry` from a decoded JSON dict, its non-reserved keys becoming
    ! typed fields. Used to replay a sandboxed program's records on the host.
  //]
  def fromDict(d: py.Dict): Entry =
    val timestamp = Clock.fromRfc3339(d.get("time", "").asString)
    val category = d.get("category", "").asString

    var fields = Map.empty[String, Value]
    for k in py.iter(d.keys()) do
      val key = k.asString
      if key != "time" && key != "category" then
        fields = fields.add(key, Value.fromJson(d.get(key)))

    new Entry(timestamp, category, fields)
end
