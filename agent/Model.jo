//[ Model.jo
  !
  ! A provider-agnostic abstraction for a chat model (LLM), so the loop can drive
  ! Anthropic, OpenAI, a local model, or a dummy for tests — all behind one
  ! interface. The conversation is modeled in Jo (`Message`); each provider impl
  ! converts to/from its own wire format. The loop owns the history and runs the
  ! tools; the model only turns (system, history, tools) into the next reply.
//]

namespace harpe

import harpe.Model.Message
import harpe.Model.Rendered
import harpe.Model.ReplyResult
import harpe.Model.Session
import harpe.Tool
import harpe.Tool.ToolResult
import harpe.Tool.ToolCall
import harpe.logging.logger

//[ Model
  !
  ! The agent's brain. `startTurn` begins one user turn, seeded ONCE with the
  ! `base` context (system prompt + transcript + transient tail) the `Context`
  ! composed for the user's message. The returned `Session` drives that turn's tool
  ! loop; the engine never re-renders `base` for it.
  !
  ! Why a per-turn object rather than a stateless `reply`: a reasoning model must
  ! carry provider-specific state — thinking-block handles, a server-side response
  ! id — ACROSS the turn's tool round-trips, but that state is opaque, non-portable,
  ! and load-bearing only within the turn. Keeping it in the `Session` means `Message`,
  ! `Context`, and the audit log stay uniform and never learn reasoning exists.
//]
interface Model
  def startTurn(base: Rendered): Session
end

section Model
  //[ Message
    !
    ! One entry in the conversation, as the loop sees it — independent of any
    ! provider's wire format. `Assistant` is also what a `Session.reply` returns.
    !
    ! A `UserText` carries `attachments`: files the user shared this turn, which
    ! live in the agent's data directory. Their bytes are NOT in the transcript —
    ! only this metadata is; the model reads a file's content through `fs`/`runCode`
    ! (a provider render folds a manifest line into the user's text so the model
    ! knows the files are there — see `userContent`). A driver with no file support
    ! passes the empty list: `UserText(text, [])`.
  //]
  union Message =
      UserText(text: String, attachments: List[Attachment])
    | Assistant(text: String, calls: List[ToolCall])
    | ToolResults(results: List[ToolResult])

  //[ Attachment
    !
    ! One file the user shared, referenced by name within the agent's data
    ! directory (the sandbox roots `fs` there). It rides in the transcript as pure
    ! metadata — `name` (the basename in the data dir), `size` in bytes, and `mime`
    ! type — so the UI can show a file card and the model can be told the file
    ! exists. The bytes stay on disk; the model fetches them with `fs`.
    !
    ! `inline` marks that this attachment should ALSO be shown to the model
    ! directly, as a real image/document content block, rather than only by
    ! reference. It is honored only when the carrying message is the newest one in
    ! the rendered window (see `agent/models/Anthropic.jo`, `OpenAI.jo`) — an older
    ! message's `inline` is inert, so a past image is never silently re-sent (and
    ! re-billed) on a later turn. `Tool.ToolResult.media` uses the same type and is
    ! always fresh (a tool result exists only for the turn it was produced in), so
    ! it inlines unconditionally within that turn. Never persisted differently:
    ! `inline` is stored as given, the render layer alone decides whether to act on
    ! it.
  //]
  class Attachment(name: String, size: Int, mime: String, inline: Bool)

  //[ The user text a provider sends for one `UserText`, with a manifest of any
    ! attachments appended so the model knows which files wait in its data
    ! directory (it reads them with `fs`). No attachments: the text is returned
    ! unchanged, so an attachment-free turn is byte-for-byte what it was before.
  //]
  def userContent(text: String, attachments: List[Attachment]): String =
    if attachments.isEmpty then text
    else
      val names = attachments.map(a => a.name).join(", ")
      val manifest = "[The user attached these files, available in your data directory — read them with `fs`: \{names}]"
      if text.trim == "" then manifest else text + "\n\n" + manifest

  //[ Rendered
    !
    ! What the model sees for one request, composed by a `Context`: the stable
    ! `system` prompt, the `messages` transcript window, and a `transient` tail.
    !
    ! `transient` is per-request context (currently the agent's working memory)
    ! placed AFTER the transcript — past any provider cache breakpoint — so
    ! editing it never invalidates the cached transcript prefix. It carries no
    ! operator authority (it renders as user content, not system), and it is `""`
    ! when there is nothing to append.
  //]
  class Rendered(system: String, messages: List[Message], transient: String)

  //[ Usage
    !
    ! Token counts a provider reports for one call. The provider's own count, so
    ! it needs no tokenizer and is exact. Carried on `Reply` so the loop can feed
    ! `inputTokens` back to the `Context` (a token-budget `SummarizingContext`
    ! compacts on it), and logged as the `harpe.model` event.
    !
    ! `inputTokens` is the TOTAL input processed, cached tokens included. The
    ! adapters normalize the providers' differing bases before it gets here.
    ! Deliberately no cache breakdown: caching changes what a prefix COSTS, never
    ! what it contains, so a `Context` deciding what to keep has no use for the
    ! split — it would be a provider detail leaking into a provider-independent
    ! decision. The breakdown belongs in the `harpe.model` event, where billing
    ! reads it (see `harpe.models.logUsage`).
  //]
  class Usage(inputTokens: Int, outputTokens: Int)

  //[ ReplyResult
    !
    ! The outcome of asking the model for a reply: the assistant message (with the
    ! call's token usage), or a typed error. `Transient` errors (rate limits, 5xx,
    ! connection blips) are worth retrying with backoff; `Fatal` ones (auth, bad
    ! request) are not. The provider classifies the failure; the loop owns retries.
  //]
  union ReplyResult =
      Reply(message: Assistant, usage: Usage)
    | Transient(detail: String)
    | Fatal(detail: String)

  //[ Session
    !
    ! The model-side session for one user turn in progress. The engine
    ! first calls `reply` with no tool results, then calls it again with the
    ! results of any tools requested by the previous reply.
    ! The session owns the intra-turn tail (the growing assistant/tool-result
    ! sequence and any provider reasoning state); the engine feeds it results and
    ! reads back the reply, but never re-composes the base.
    !
    ! `reply` `receives logger` — read at call time — so a provider can emit its
    ! token usage to the turn's logging context (see `harpe.models.logUsage`).
    ! `receives callContext` lets the provider resolve inline attachment bytes
    ! from the session's data directory.
    !
    ! Retry contract: `reply` is IDEMPOTENT. `results` are committed to the tail
    ! only on a successful `Reply` (atomically with the assistant message), so a
    ! transport retry passes the SAME `results` again and simply re-sends — a
    ! failed attempt mutates nothing. The caller never tracks what it committed.
  //]
  interface Session
    def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger, callContext

  //[ SimpleSession
    !
    ! A `Session` for providers with no intra-turn state to preserve: it accumulates
    ! the turn's tail as plain `Message`s and re-sends the whole conversation on
    ! every reply. `send` does the provider's wire encoding and the actual call.
    ! Providers that carry intra-turn state (e.g. reasoning handles) implement
    ! `Session` directly instead.
  //]
  class SimpleSession(base: Rendered, send: (Rendered, List[Tool]) => ReplyResult receives logger, callContext)
    view Session

    private var messages: List[Message] = base.messages

    def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger, callContext =
      // Build the request WITHOUT committing, so a failed attempt leaves the tail
      // untouched and a retry (same results) re-sends identically.
      val outgoing =
        if results.isEmpty then messages
        else messages + ToolResults(results)

      val res = send(new Rendered(base.system, outgoing, base.transient), tools)

      // Commit the results and the reply together — only on success.
      if res is Reply(msg, _) then
        messages = outgoing + msg

      res
end
