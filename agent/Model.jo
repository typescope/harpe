//[ Model.jo
  !
  ! A provider-agnostic abstraction for a chat model (LLM), so the loop can
  ! drive Anthropic, OpenAI, a local model, or a dummy for tests — all behind
  ! one interface. The conversation is modeled in Jo (`Message`). Each provider
  ! impl converts to/from its own wire format. The loop owns the history and
  ! runs the tools. The model only turns (system, history, tools) into the next
  ! reply.
//]

namespace harpe

import harpe.Model.Message
import harpe.Model.Rendered
import harpe.Model.ReplyResult
import harpe.Model.Session
import harpe.Tool
import harpe.Tool.ToolResult
import harpe.Tool.ToolCall
import harpe.logging.logger

//[ Model
  !
  ! The agent's brain. `startTurn` begins one user turn, seeded ONCE with the
  ! `base` context (system prompt + transcript) the `Context`
  ! composed for the user's message. The returned `Session` drives that turn's
  ! tool loop. The engine never re-renders `base` for it.
  !
  ! Why a per-turn object rather than a stateless `reply`: a reasoning model
  ! must carry provider-specific state — thinking-block handles, a server-side
  ! response id — ACROSS the turn's tool round-trips, but that state is opaque,
  ! non-portable, and load-bearing only within the turn. Keeping it in the
  ! `Session` means `Message`, `Context`, and the audit log stay uniform and
  ! never learn reasoning exists.
//]
interface Model
  def startTurn(base: Rendered): Session
end

section Model
  //[ Message
    !
    ! One entry in the conversation, as the loop sees it — independent of any
    ! provider's wire format. `Assistant` is also what a `Session.reply`
    ! returns.
    !
    ! A `UserInput` carries `attachments`: files the user shared this turn, which
    ! live in the agent's data directory. Their bytes are NOT in the transcript
    ! — only this metadata is. The model reads a file's content through
    ! `fs`/`runCode` (a provider render folds a manifest line into the user's
    ! text so the model knows the files are there — see `userContent`). A driver
    ! with no file support passes the empty list: `UserInput(text, [])`.
  //]
  union Message =
      UserInput(text: String, attachments: List[Attachment])
    | Assistant(text: String, calls: List[ToolCall])
    | ToolResults(results: List[ToolResult])

  //[ Attachment
    !
    ! One file the user shared. It rides in the transcript as pure metadata —
    ! `name` (what the model and the UI call it, the basename in the agent's
    ! data directory), `size` in bytes, `mime` type, and `path`, where the bytes
    ! actually live on the host — so the UI can show a file card and the model
    ! can be told the file exists. The bytes stay on disk. The model fetches
    ! them with `fs`.
    !
    ! `path` is what makes the data directory a driver concern rather than the
    ! framework's: whoever creates an attachment knows where the file is, so no
    ! layer below has to be told the directory to resolve it against.
    !
    ! ATTACHING IS THE DECISION. An attachment here is one the model should be
    ! SHOWN — rendered as a real image/document content block where the provider
    ! supports the type. A file the model should merely know about is not an
    ! attachment: name it in the message text, and let the model read it with
    ! `fs` or pull it into view with `uploadMedia`. That choice belongs to
    ! whoever builds the message, which is why it is not a flag here.
    !
    ! Only the newest message in a rendered window is shown (see
    ! `agent/models/Anthropic.jo`, `OpenAI.jo`), so a past image is never
    ! silently re-sent — and re-billed — on a later turn. It still rides in that
    ! message's text manifest, so the model keeps knowing the file exists.
    ! `Tool.ToolResult.attachments` uses the same type and is always fresh (a tool
    ! result exists only for the turn it was produced in), so it is shown
    ! unconditionally within that turn.
  //]
  class Attachment(name: String, size: Int, mime: String, path: String)

  //[ The user text a provider sends for one `UserInput`
    !
    ! With a manifest of any attachments appended so the model knows which files
    ! wait in its data directory (it reads them with `fs`). No attachments: the
    ! text is returned unchanged, so an attachment-free turn is byte-for-byte
    ! what it was before.
  //]
  def userContent(text: String, attachments: List[Attachment]): String =
    if attachments.isEmpty then text
    else
      val names = attachments.map(a => a.name).join(", ")
      val manifest = "[The user attached these files, available in your data directory — read them with `fs`: \{names}]"
      if text.trim == "" then manifest else text + "\n\n" + manifest

  //[ Rendered
    !
    ! What the model sees for one request, composed by a `Context`: the stable
    ! `system` prompt and the `messages` transcript window.
    !
    ! There is no separate slot for per-request content. A `Context` that wants
    ! volatile material in front of the model — working notes, retrieved
    ! documents — appends it to `messages` as an ordinary user message, which is
    ! all a dedicated field ever did. Putting it last keeps it past any provider
    ! cache breakpoint, so changing it leaves the cached prefix intact, and it
    ! carries no operator authority because it is user content, not system.
    ! when there is nothing to append.
  //]
  class Rendered(system: String, messages: List[Message])

  //[ Usage
    !
    ! Token counts a provider reports for one call. The provider's own count, so
    ! it needs no tokenizer and is exact. Carried on `Reply` so the loop can feed
    ! `inputTokens` back to the `Context` (a token-budget `SummarizingContext`
    ! compacts on it), and logged as the `harpe.model` event.
    !
    ! `inputTokens` is the TOTAL input processed, cached tokens included. The
    ! adapters normalize the providers' differing bases before it gets here.
    ! Deliberately no cache breakdown: caching changes what a prefix COSTS, never
    ! what it contains, so a `Context` deciding what to keep has no use for the
    ! split — it would be a provider detail leaking into a provider-independent
    ! decision. The breakdown belongs in the `harpe.model` event, where billing
    ! reads it (see `harpe.models.logUsage`).
  //]
  class Usage(inputTokens: Int, outputTokens: Int)

  //[ ReplyResult
    !
    ! The outcome of asking the model for a reply: the assistant message (with
    ! the call's token usage), or a typed error. `Transient` errors (rate
    ! limits, 5xx, connection blips) are worth retrying with backoff. `Fatal`
    ! ones (auth, bad request) are not. The provider classifies the failure. The
    ! loop owns retries.
  //]
  union ReplyResult =
      Reply(message: Assistant, usage: Usage)
    | Transient(detail: String)
    | Fatal(detail: String)

  //[ Session
    !
    ! The model-side session for one user turn in progress. The engine first
    ! calls `reply` with no tool results, then calls it again with the results
    ! of any tools requested by the previous reply. The session owns the
    ! intra-turn tail (the growing assistant/tool-result sequence and any
    ! provider reasoning state). The engine feeds it results and reads back the
    ! reply, but never re-composes the base.
    !
    ! `reply` `receives logger` — read at call time — so a provider can emit its
    ! token usage to the turn's logging context (see `harpe.models.logUsage`).
    ! An attachment carries its own `path`, so nothing here needs to be told a
    ! data directory to resolve it against.
    !
    ! Retry contract: `reply` is IDEMPOTENT. `results` are committed to the tail
    ! only on a successful `Reply` (atomically with the assistant message), so a
    ! transport retry passes the SAME `results` again and simply re-sends — a
    ! failed attempt mutates nothing. The caller never tracks what it committed.
  //]
  interface Session
    def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger

  //[ SimpleSession
    !
    ! A `Session` for providers with no intra-turn state to preserve: it accumulates
    ! the turn's tail as plain `Message`s and re-sends the whole conversation on
    ! every reply. `send` does the provider's wire encoding and the actual call.
    ! Providers that carry intra-turn state (e.g. reasoning handles) implement
    ! `Session` directly instead.
  //]
  class SimpleSession(base: Rendered, send: (Rendered, List[Tool]) => ReplyResult receives logger)
    view Session

    private var messages: List[Message] = base.messages

    def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger =
      // Build the request WITHOUT committing, so a failed attempt leaves the tail
      // untouched and a retry (same results) re-sends identically.
      val outgoing =
        if results.isEmpty then messages
        else messages + ToolResults(results)

      val res = send(new Rendered(base.system, outgoing), tools)

      // Commit the results and the reply together — only on success.
      if res is Reply(msg, _) then
        messages = outgoing + msg

      res
end
