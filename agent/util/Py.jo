//[ Py.jo
  !
  ! Reading foreign values, the Jo-shaped way.
  !
  ! The counterpart to `harpe.ffi.builtins`. What lands here is what Python has
  ! no single call for: naming a value's type as a string, which is two nested
  ! built-ins.
//]

namespace harpe.util

import harpe.ffi.builtins

section Py
  //[ The name of a Python value's type
    !
    ! (`"str"`, `"int"`, `"float"`, `"bool"`, `"dict"`, …) — used to dispatch on
    ! a decoded JSON value.
  //]
  def typeName(x: Any): String =
    builtins.getattr(builtins.typeOf(x), "__name__").asString
end
