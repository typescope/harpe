//[ File.jo
  !
  ! The filesystem, as this process touches it: reading and writing whole files,
  ! and reading facts off a path.
  !
  ! One category, because a caller does not experience "reading a file", "joining
  ! a name", and "guessing a type from that name" as three subjects. What lands
  ! here is what Harpe wants those to mean — the whole text, UTF-8, a handle that
  ! is always closed, one answer or none from a MIME guess — and the arguments it
  ! always passes the same way, each a decision made once with its reason beside
  ! it. Python's own surface is `harpe.ffi.os` and the modules around it.
//]

namespace harpe.util

import harpe.ffi.os
import harpe.ffi.mimetypes

section File
  //[ Does a regular file exist at `path`? //]
  def exists(path: String): Bool = os.path.isfile(path)

  //[ The whole text of `path` (UTF-8). //]
  def read(path: String): String = py.open(path, "r").read().asString

  //[ The whole content of `path` as raw bytes. //]
  def readBytes(path: String): py.Dynamic = py.open(path, "rb").read()

  //[ Write `content` to `path`, replacing it. //]
  def write(path: String, content: String): Unit =
    val f = py.open(path, "w")
    f.write(content)
    f.close()

  //[ Write raw `data` (bytes) to `path`, replacing it. //]
  def writeBytes(path: String, data: py.Dynamic): Unit =
    val f = py.open(path, "wb")
    f.write(data)
    f.close()

  //[ The file extension of `path`, including the dot (e.g. `".pdf"`). "" if none. //]
  def extname(path: String): String = os.path.splitext(path)[1].asString

  //[ Guess a file's MIME type from its name (e.g. `"application/pdf"`).
    !
    ! `None` when the type cannot be determined from the name. Python answers
    ! with a `(type, encoding)` pair whose first half may be absent — callers
    ! here want one answer or none, so the pair is read once, here.
  //]
  def mimeType(path: String): Option[String] =
    val guessed = mimetypes.guess_type(path)[0]
    if py.isNone(guessed) then None else Some(guessed.asString)

  //[ Create `path` and any missing parent, and do not complain if it is already there.
    !
    ! Every caller here is establishing a directory it is about to write into,
    ! for which an existing one is success, not a collision.
  //]
  def ensureDir(path: String): Unit = os.makedirs(path, exist_ok = true)

  //[ Walk the tree at `top`, descending into directory symlinks
    !
    ! A link placed inside a walked tree is deliberate — it is how an agent
    ! shares reference material into `skills/` — so the walk follows it. Cyclic
    ! links would loop: do not create them.
  //]
  def walk(top: String): py.Dynamic = os.walk(top, followlinks = true)

  //[ One entry yielded by `walk`: a `(dirpath, dirnames, filenames)` tuple. //]
  interface WalkEntry
    def dirpath: String = py.dynamic(this)[0].asString

    def filenames: py.List = py.dynamic(this)[2].cast[py.List]
  end
end
