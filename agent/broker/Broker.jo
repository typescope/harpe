//[ Broker.jo
  !
  ! The broker: one live host↔guest channel. The host binds a per-run Unix
  ! socket and serves each connection with a single `Frame => Frame` handler.
  ! The guest connects with a `Broker.Client` and issues `request(frame)` calls
  ! that block for a response. This is the live counterpart of the audit log
  ! (which is guest→host, async). It is deliberately generic — a `Frame` in, a
  ! `Frame` out — with no service registry or per-capability call surface: the
  ! fixed cross-cutting concerns (real-time `send`, `confirm`) ride this one
  ! channel. See host-guest-boundary.md.
  !
  ! Wire format: each frame is `[4-byte jsonLen][json][4-byte blobLen][blob]` —
  ! a UTF-8 JSON header plus an optional **raw** binary trailer. Bytes ride the
  ! trailer, never base64 inside the JSON, so a byte range costs no
  ! encode/decode and no 33% inflation. Large payloads do not travel here at
  ! all: the guest gets a relative path to a file the host materialized in the
  ! shared run dir and reads it directly. The broker carries only bounded reads
  ! (a text line range, a small buffer) and metadata.
  !
  ! The frame contents are the handler's own protocol. The broker imposes only
  ! one convention — a handler that raises is answered with an error frame
  ! (`{"ok": false, "error": …}`), so a failing handler is a clean response
  ! rather than a dropped connection, and `request` aborts on it.
//]

namespace harpe.broker

import harpe.ffi.Socket
import harpe.util.Process
import harpe.util.UnixSocket
import harpe.ffi.threading
import harpe.ffi.json
import harpe.ffi.builtins
import harpe.ffi.os

private def structMod: py.Dynamic = py.module("struct")

//[ The empty bytes object `b""`. //]
private def emptyBytes: py.Dynamic = py.dynamic("").callDynamic("encode", "ascii")

//------------------------------------------------------------------------------
// Framing
//------------------------------------------------------------------------------

//[ One wire frame: a JSON header and a raw (possibly empty) binary trailer. //]
private[harpe] class Frame(json: String, blob: py.Dynamic)

private[harpe] section Frame
  //[ A frame carrying a JSON header and no binary trailer. //]
  def of(json: String): Frame = new Frame(json, emptyBytes)

  //[ An error frame — `{"ok": false, "error": message}`, no trailer.
    !
    ! The broker replies with this when a handler raises. `Broker.Client.request`
    ! recognizes it and aborts.
  //]
  def error(message: String): Frame =
    new Frame(json.dumps(py.dict("ok" ~ false, "error" ~ message)), emptyBytes)
end

//[ Read exactly `n` bytes, looping over short reads.
  !
  ! Abort if the stream ends before `n` bytes arrive (a truncated frame).
//]
private def recvExactly(sock: Socket, n: Int): py.Dynamic =
  val chunks = py.list()
  var got = 0

  while got < n do
    val chunk = sock.recv(n - got)
    val clen = builtins.len(chunk)

    if clen == 0 then
      abort "broker: connection closed mid-frame"

    chunks.append(chunk)
    got = got + clen

  emptyBytes.callDynamic("join", chunks)

//[ Read a 4-byte big-endian length. //]
private def recvLen(sock: Socket): Int =
  structMod.unpack(">I", recvExactly(sock, 4))[0].asInt

//[ Send one frame: JSON header, then the raw blob (its length always prefixed). //]
private def sendFrame(sock: Socket, frame: Frame): Unit =
  val jdata = py.dynamic(frame.json).encode("utf-8")
  val blen = builtins.len(frame.blob)

  sock.sendall(structMod.pack(">I", builtins.len(jdata)))
  sock.sendall(jdata)
  sock.sendall(structMod.pack(">I", blen))

  if blen > 0 then
    sock.sendall(frame.blob)

//[ Read one frame, or `None` if the peer closed cleanly at a frame boundary. //]
private def recvFrame(sock: Socket): Option[Frame] =
  val head = sock.recv(4)
  val n0 = builtins.len(head)

  if n0 == 0 then
    None

  else
    val jhdr =
      if n0 == 4 then head
      else emptyBytes.callDynamic("join", py.list(head, recvExactly(sock, 4 - n0)))

    val jlen = structMod.unpack(">I", jhdr)[0].asInt
    val json = recvExactly(sock, jlen).decode("utf-8").asString
    val blen = recvLen(sock)
    val blob = if blen == 0 then emptyBytes else recvExactly(sock, blen)
    Some(new Frame(json, blob))

//------------------------------------------------------------------------------
// Broker (host)
//------------------------------------------------------------------------------

//[ A running broker
  !
  ! Its listening socket, the path it bound, and the per-connection frame
  ! handler.
  !
  ! `handle` turns each request frame into a response frame. Its contents are
  ! the handler's own protocol. A handler that raises is answered with
  ! `Frame.error`.
//]
private[harpe] class Broker(server: Socket, path: String, handle: Frame => Frame)
  //[ Stop accepting and remove the socket file.
    !
    ! In-flight connections finish on their own threads. New `accept` calls
    ! raise once the socket is closed.
  //]
  def stop(): Unit =
    server.close()
    val _ = py.try(os.unlink(path))
    pass
end

private[harpe] section Broker
  //[ Bind a broker at `path` and start serving
    !
    ! Each connection is served on its own thread, so concurrent guest calls do
    ! not block one another.
  //]
  def start(path: String, handle: Frame => Frame): Broker =
    val server = UnixSocket.open()
    server.bind(path)
    server.listen(8)

    val broker = new Broker(server, path, handle)
    Process.daemon(() => acceptLoop(broker)).start()
    broker

  //[ Accept connections until the server socket is closed (by `stop`). //]
  private def acceptLoop(broker: Broker): Unit =
    val body = () =>
      while true do
        val conn = UnixSocket.accept(broker.server)
        Process.daemon(() => serveConn(conn, broker.handle)).start()

    val _ = py.try(body())
    pass

  //[ Serve one connection: request/response until the peer closes it. //]
  private def serveConn(conn: Socket, handle: Frame => Frame): Unit =
    val body = () =>
      var running = true
      while running do
        match recvFrame(conn)
        case None        => running = false
        case Some(frame) => sendFrame(conn, dispatch(handle, frame))

    val _ = py.try(body())
    val _ = py.try(conn.close())
    pass

  //[ Run the handler on `frame`, turning any exception into an error frame. //]
  private def dispatch(handle: Frame => Frame, frame: Frame): Frame =
    match py.try(handle(frame))
    case Ok(reply) => reply
    case Err(e)    => Frame.error(e.message)

  //------------------------------------------------------------------------------
  // Client (guest)
  //------------------------------------------------------------------------------

  //[ The guest end of the channel: one connection over which requests are issued sequentially. //]
  class Client(sock: Socket)
    //[ Send one request frame and return the response frame.
      !
      ! Aborts if the peer closes without answering, or if the reply is a broker error
      ! frame (`{"ok": false, "error": …}`).
    //]
    def request(frame: Frame): Frame =
      sendFrame(sock, frame)

      match recvFrame(sock)
      case None =>
        abort "broker: no response"

      case Some(resp) =>
        match errorOf(resp)
        case Some(message) => abort "broker: \{message}"
        case None          => resp

    def close(): Unit = sock.close()

    //[ The error message if `frame` is a broker error frame, else `None`. //]
    private def errorOf(frame: Frame): Option[String] =
      match py.try(json.loads(frame.json).cast[py.Dict])
      case Ok(d) =>
        if d.get("ok", py.dynamic(true)).asBool then None else Some(d.get("error").asString)

      case Err(_) =>
        None
  end

  //[ Connect to the broker listening at `path` — the guest end of `start`. //]
  def connect(path: String): Client =
    val sock = UnixSocket.open()
    sock.connect(path)
    new Client(sock)
end

