//[ Interact.jo
  !
  ! The turn protocol — the types through which a turn is driven and observed.
  ! The engine itself is `Agent.runTurn` (see `Agent.jo`).
//]

namespace harpe

import harpe.turns.TurnEvent
import harpe.Model
import harpe.Model.Rendered
import harpe.Model.ReplyResult
import harpe.Tool

//[ UI interaction during a turn
  !
  ! Cooperative interaction for a turn.
//]
interface Interact
  //[ Has cancellation been requested? //]
  def cancelled: Bool

  //[ Pause for up to `seconds`
    !
    ! return true if cancellation fires during the wait, so a long backoff can
    ! be abandoned promptly.
  //]
  def pause(seconds: Float): Bool

  //[ Handle a turn event   //]
  def emit(event: TurnEvent): Unit

  //[ Ask the current session user to approve an action.
    !
    ! This is an out-of-band runtime interaction. It is not a turn event and does
    ! not enter the model transcript. `id` identifies this request within the
    ! active run so a stale response cannot approve a later action.
  //]
  def approve(id: String, request: Approvals.Request): Approvals.Decision
end

//[ The current turn's interaction channel
  !
  ! The driver binds this around a turn — `with interact = ... in
  ! Agent.runTurn(...)` — and the turn engine and every tool handler read it
  ! from there. One binding, one name: the engine does not rebind it around
  ! tool calls, so a handler sees exactly the channel the driver opened the turn
  ! with.
  !
  ! Unbound it is `Interact.unattended`, so a turn runs with nobody watching
  ! rather than refusing to run. A driver with a user to answer to binds its own.
//]
param interact: Interact = Interact.unattended

section Interact
  //[ An interaction channel for work performed outside an active user turn.
    !
    ! Approval is unavailable and therefore cancelled.
  //]
  def unattended: Interact = new UnattendedInteract
end

private class UnattendedInteract
  view Interact

  def cancelled: Bool = false
  def pause(seconds: Float): Bool = false
  def emit(event: TurnEvent): Unit = pass
  def approve(id: String, request: Approvals.Request): Approvals.Decision = Approvals.Cancelled
end
