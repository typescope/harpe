//[ SessionLog.jo
  !
  ! Serializing an agent conversation to disk. Each session is one JSONL file
  ! under `logs/sessions/<yyyy>/<mm>/<dd>/<hh-mm-ss>.jsonl` — the path fixed at
  ! session start — holding one JSON record per `Message`, in the order the loop
  ! committed them.
  !
  ! Records are appended (not rewritten) as turns commit, so each carries its own
  ! wall-clock `time`, stamped once and never disturbed by later turns.
  !
  ! This is the conversational audit trail, distinct from the structured event
  ! log (`logs/agent.jsonl`, e.g. `runCode`'s `harpe.tools.runCode` records). It lives at the
  ! package root (not under a
  ! single agent type) because any agent — not just the CLI — can persist its
  ! conversation. Serializing is the first step: it is the foundation for later
  ! auditing a past run, or letting the user pick a saved session to load.
//]

namespace harpe

import harpe.ffi.jsonMod
import harpe.ffi.fileExists
import harpe.ffi.readFile
import harpe.util.truncate
import harpe.Model.*
import harpe.Tool.*

class SessionLog
  private val logFile: py.Dynamic

  //[ The transcript-archive path this log writes to. //]
  val path: String

  def SessionLog(path: String) =
    this.path = path
    os.makedirs(os.path.dirname(path))
    this.logFile = py.open(path, "a")

  //[ Append `messages` to the session file as JSONL
    !
    ! One record per message, each stamped with `time`.
  //]
  def append(time: Float, messages: List[Message]): Unit =
    for m in messages do
      val line = jsonMod.dumps(SessionLog.messageToDict(time, m)).asString + "\n"
      logFile.write(line)

    logFile.flush()

  def close(): Unit = logFile.close()

  //[ The sibling memory-snapshot path for this session
    ! (`<base>.jsonl` → `<base>.memory.json`).
  //]
  def memoryPath: String =
    if path.endsWith(".jsonl") then
      path.substring(0, path.size - 6) + ".memory.json"
    else
      path + ".memory.json"
end

section SessionLog
  //[ A generous safety cap (characters) on how much of a persisted transcript a
    ! driver reads back into memory when a session resumes — a RAM backstop against a
    ! pathologically long session, not a tuning knob. It is deliberately large enough
    ! that normal sessions are never truncated; the model-context/send budget is a
    ! separate concern owned by `render`. The full transcript always stays on disk.
  //]
  def maxResumeChars: Int = 1000000

  //[ The path for a new session's log, fixed at session start.
    !
    ! `logs/sessions/<yyyy>/<mm>/<dd>/<hh-mm-ss>.jsonl`, resolved against the
    ! workspace root. The single `strftime` call keeps the date directories and
    ! the time filename drawn from one instant.
  //]
  def newLog(): SessionLog receives workspace =
    val path = workspace.relative(time.strftime("logs/sessions/%Y/%m/%d/%H-%M-%S") + ".jsonl")
    new SessionLog(path)

  //[ Reconstruct a conversation from a JSONL session file at `path`, in order.
    !
    ! The inverse of `append` (`messageToDict`), and deliberately layout-agnostic:
    ! the caller supplies the file path, so where sessions live on disk is the
    ! driver's policy, not this serializer's. Returns `[]` if the file is absent.
    !
    ! The result is capped to `maxResumeChars` (dropping whole oldest turns) as a
    ! RAM backstop against a pathologically long session; the file on disk is
    ! untouched. The cap is generous, so normal sessions are returned in full.
  //]
  def loadFile(path: String): List[Message] =
    if !fileExists(path) then []
    else
      var msgs: List[Message] = []
      for line in readFile(path).lines do
        if line.trim != "" then
          msgs = msgs + dictToMessage(jsonMod.loads(line).cast[py.Dict])
      truncate(msgs, maxResumeChars)

  //[ The inverse of `messageToDict`: one stored record back into a `Message`. //]
  private def dictToMessage(d: py.Dict): Message =
    val role = d.get("role", "").asString

    if role == "user" then
      UserText(d.get("text", "").asString)

    else if role == "assistant" then
      var calls: List[ToolCall] = []
      for cDyn in d.get("calls", py.list()).cast[py.List] do
        val c = cDyn.cast[py.Dict]
        calls = calls + ToolCall(c.get("id", "").asString, c.get("name", "").asString,
                                 ToolInput(c.get("input", py.dict()).cast[py.Dict]))
      Assistant(d.get("text", "").asString, calls)

    else
      var results: List[ToolResult] = []
      for rDyn in d.get("results", py.list()).cast[py.List] do
        val r = rDyn.cast[py.Dict]
        results = results + ToolResult(r.get("id", "").asString, r.get("content", "").asString)
      ToolResults(results)

  //[ One conversation message as a JSON-able dict: a wall-clock `time`, a `role`
    ! tag, and that variant's payload (mirroring `Message`).
  //]
  private[harpe] def messageToDict(time: Float, m: Message): py.Dict =
    match m
    case UserText(text) =>
      py.dict("time" ~ time, "role" ~ "user", "text" ~ text)

    case Assistant(text, calls) =>
      val callList = py.list()
      for c in calls do
        callList.append: py.dict("id" ~ c.id, "name" ~ c.name, "input" ~ c.input.raw)
      py.dict("time" ~ time, "role" ~ "assistant", "text" ~ text, "calls" ~ callList)

    case ToolResults(results) =>
      val resultList = py.list()
      for r in results do
        resultList.append: py.dict("id" ~ r.id, "content" ~ r.content)
      py.dict("time" ~ time, "role" ~ "tool_results", "results" ~ resultList)
  end
end
