//[ SerialLogger.jo
  !
  ! A `Logger` decorator that serializes another logger under a lock, so
  ! concurrent producers never interleave a record. `Logging.withLogger` wraps the
  ! chosen backend in one of these, which is why a backend need not be thread-safe.
//]

namespace harpe.logging
import harpe.ffi.threading


private class SerialLogger(inner: Logger)
  view Logger

  private val lock = threading.lock()

  def logEntry(entry: Entry): Unit =
    lock.acquire()
    inner.logEntry(entry)
    lock.release()

  def close(): Unit = inner.close()
end
