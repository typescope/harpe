//[ secrets.jo
  !
  ! Cryptographically-strong random tokens, wrapping Python's `secrets` module —
  ! for unguessable identifiers. Mirrors `os` and `time`.
//]

namespace harpe.ffi.secrets

private def module: py.Dynamic = py.module("secrets")

//[ A URL-safe random token carrying `nbytes` of entropy. //]
def tokenUrlsafe(nbytes: Int): String = module.token_urlsafe(nbytes).asString

//[ A random hex-string token carrying `nbytes` of entropy. //]
def tokenHex(nbytes: Int): String = module.token_hex(nbytes).asString
