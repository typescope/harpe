//[ Workspace.jo
  !
  ! A validated agent working directory — the root that tools and the loop
  ! resolve their paths against. The driver checks the CWD is an agent directory,
  ! builds a Workspace from it, and provides it as a context parameter so any
  ! layer can pick it up without threading it by hand. It lives at the package
  ! root (not under `tools/`) because it is a general agent concept.
//]

namespace harpe

//[ Workspace
  !
  ! An agent's working directory and the conventional layout the built-in tools
  ! assume: `sandbox/guest` (the program runCode writes + builds) and `skills/`
  ! (the read-only reference files).
//]
class Workspace(root: String)
  def guestDir: String  = os.path.join(root, "sandbox/guest")
  def skillsDir: String = os.path.join(root, "skills")
  def agentMd: String   = os.path.join(root, "AGENT.md")
  def relative(path: String): String = os.path.join(root, path)
end

//[ The agent's working directory, provided to tool builders as context. //]
param workspace: Workspace
