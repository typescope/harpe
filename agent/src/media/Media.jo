//[ Media.jo
  !
  ! A guest-safe descriptor of a resolved resource: MIME type, file name, and an open
  ! bag of typed metadata. `MediaProvider.resolve` produces it cheaply (a stat, no
  ! read), so the model can check a granted id before deciding to `load` it.
  !
  ! `meta` is a convention, not a schema — a provider stamps what it knows (`sizeBytes`,
  ! `pages`, `width`, …) and a consumer reads what it needs, so new metadata never
  ! grows the type. It crosses the broker to the guest, so it must carry no host path
  ! or other host-only detail (that stays in the `MediaProvider`).
//]

namespace harpe.media

//[ A metadata value: text or a number. //]
type Meta = String | Int

//[ A media descriptor: MIME type, file name, and typed metadata — not the content. //]
class Media(mimeType: String, fileName: String, meta: Map[String, Meta])
  //[ A string-valued metadata key, or `None` if absent or not a string. //]
  def metaString(key: String): Option[String] =
    match meta.getOpt(key)
    case Some(s: String) => Some(s)
    case _               => None

  //[ An int-valued metadata key, or `None` if absent or not an int. //]
  def metaInt(key: String): Option[Int] =
    match meta.getOpt(key)
    case Some(n: Int) => Some(n)
    case _            => None
end
