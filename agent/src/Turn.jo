//[ Turn.jo
  !
  ! The agent turn engine — provider- and UI-agnostic.
  !
  ! `runTurn` drives one user turn:
  !
  ! it calls the model (retrying transient errors with backoff), runs any
  ! tool calls, and repeats until the model replies with plain text, bounding the
  ! turn to `maxToolRounds` tool-call rounds. `fetchReply` is the single-reply
  ! step with the retry policy.
  !
  ! The engine performs no I/O of its own: every user-visible moment is reported
  ! through an injected `emit: TurnEvent => Unit` handler, and cancellation is a
  ! cooperative `interrupt` event the caller owns. So the same engine drives the
  ! CLI (which renders events as a spinner + console lines) or any other agent
  ! shape (a server, a test harness, a no-op handler) without change.
//]

namespace harpe.turn

import harpe.ffi.*
import harpe.models.*
import harpe.tools.*

//[ TurnEvent
  !
  ! Everything the engine wants to surface during a turn, as data — the handler
  ! decides how (or whether) to present it. `*Started`/`*Ended` pairs bracket a
  ! blocking call, so a handler can drive a spinner/progress indicator around it.
//]
union TurnEvent =
    ModelRequestStarted(attempt: Int, maxAttempts: Int)   // attempt 0 = first try
  | ModelRequestEnded
  | TransientError(detail: String, delaySeconds: Float)   // about to wait, then retry
  | RequestFailed(detail: String)                          // fatal — the turn is lost
  | RetriesExhausted(detail: String, attempts: Int)        // gave up after retrying
  | ToolBudgetReached(budget: Int)                         // no tools offered; forcing a final answer
  | ToolCallStarted(name: String)
  | ToolCallEnded(name: String, summary: String)

//[ The outcome of one user turn: an answer (with the updated history), an
  ! interruption, or a failed request.
//]
union TurnResult =
    Answered(history: List[Message], text: String)
  | Interrupted
  | Failed

//[ The result of fetching one model reply (after any retries): the assistant
  ! message, a give-up (fatal error or retries exhausted), or an interruption.
//]
private union Fetched =
    Got(message: Assistant)
  | GaveUp
  | Stopped

// Exponential backoff between retries: 1s, 2s, 4s, … capped at 30s.
private def backoffSeconds(attempt: Int): Float =
  var d = 1.0
  var i = 1
  while i < attempt do
    d = d * 2.0
    i = i + 1

  if d > 30.0 then 30.0 else d

// Run `work` on a background thread; return Some(result), or None if `interrupt`
// fires first (the abandoned worker finishes in the background). This is what
// lets a long model call be cancelled cooperatively.
private def callInterruptible[T](interrupt: py.Dynamic, work: () => T): Option[T] =
  val box  = py.list(py.none)
  val done = threadingMod.Event()
  val worker = () =>
    box.set(0, work())
    done.set()
  val thread = threadingMod.Thread(target = worker, daemon = true)
  thread.start()

  var out: Option[T] = None
  var waiting = true
  while waiting do
    if done.wait(0.05).asBool then
      out = Some(box.get(0).cast[T])
      waiting = false
    else if interrupt.is_set().asBool then
      waiting = false
  out

//[ Ask the model for one reply, retrying transient errors with exponential
  ! backoff up to `maxRetries`. `interrupt` cancels both the request and any
  ! backoff wait. Progress and errors are reported through `emit`.
//]
private def fetchReply(
    brain: Model, sysPrompt: String, history: List[Message], tools: List[Tool],
    maxRetries: Int, interrupt: py.Dynamic, emit: TurnEvent => Unit)
: Fetched =

  var attempt = 0
  var outcome: Fetched = GaveUp

  while true do
    emit(new ModelRequestStarted(attempt, maxRetries))
    val maybe = callInterruptible(interrupt, () => brain.reply(sysPrompt, history, tools))
    emit(ModelRequestEnded)

    val res = maybe rescue None =>
      outcome = if interrupt.is_set().asBool then Stopped else GaveUp
      break

    match res
      case Reply(message) =>
        outcome = new Got(message)
        break

      case Fatal(detail) =>
        emit(new RequestFailed(detail))
        outcome = GaveUp
        break

      case Transient(detail) =>
        attempt = attempt + 1
        if attempt > maxRetries then
          emit(new RetriesExhausted(detail, maxRetries))
          outcome = GaveUp
          break

        else
          val delay = backoffSeconds(attempt)
          emit(new TransientError(detail, delay))
          // interrupt.wait returns true if cancelled during the backoff.
          if interrupt.wait(delay).asBool then
            outcome = Stopped
            break
  end // while

  outcome

//[ Drive one turn: call the model (with retries), run any tool calls it
  ! requests, and repeat until it replies with plain text. A turn is bounded to
  ! `maxToolRounds` tool-call rounds; once spent the model is asked once more
  ! with no tools, forcing a final answer. `interrupt` cancels and rolls back.
//]
def runTurn(
    brain: Model, sysPrompt: String, start: List[Message], tools: List[Tool],
    maxToolRounds: Int, maxRetries: Int, interrupt: py.Dynamic, emit: TurnEvent => Unit)
: TurnResult =

  var history = start
  var rounds = 0
  var result: TurnResult = Failed

  while true do
    val sofar = history
    // Once the tool budget is spent, offer no tools so the model must reply with
    // a final text answer rather than calling another tool.
    val offer = if rounds >= maxToolRounds then List.empty[Tool] else tools

    if rounds == maxToolRounds then
      emit(new ToolBudgetReached(maxToolRounds))

    match fetchReply(brain, sysPrompt, sofar, offer, maxRetries, interrupt, emit)
      case Stopped =>
        result = Interrupted
        break

      case GaveUp =>
        result = Failed
        break

      case Got(reply) =>
        history = history + reply

        if reply.calls.isEmpty then
          result = new Answered(history, reply.text.trim)
          break

        var toolResults: List[ToolResult] = []
        var cancelled = false

        for call in reply.calls do
          if interrupt.is_set().asBool then
            cancelled = true
            break

          val toolName = call.name
          emit(new ToolCallStarted(toolName))
          val outcome =
            if tools.find(t => t.name == toolName) is Some(t) then t.run(call.input)
            else new RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}")
          emit(new ToolCallEnded(toolName, outcome.summary))

          toolResults = toolResults + new ToolResult(call.id, outcome.result)

        if cancelled || interrupt.is_set().asBool then
          result = Interrupted
          break

        else
          history = history + new ToolResults(toolResults)
          rounds = rounds + 1
  end // while

  result
