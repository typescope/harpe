//[ Turn.jo
  !
  ! The agent turn engine — provider- and UI-agnostic.
  !
  ! `runTurn` drives one user turn:
  !
  ! It calls the model (retrying transient errors with backoff), runs any tool
  ! calls, and repeats until the model replies with plain text, bounding the
  ! turn to `maxToolRounds` tool-call rounds. `fetchReply` is the single-reply
  ! step with the retry policy.
  !
  ! The engine performs no I/O of its own: every user-visible moment is reported
  ! through an injected `interact` handler.
//]

namespace harpe.turn

import harpe.models.*
import harpe.tools.*
import harpe.context.Context

//[ Interact
  !
  ! Cooperative interaction for a turn.
//]
interface Interact
  //[ Ask for LLM reply
    !
    ! A cancellable model call over the already-composed `(system, messages,
    ! tools)`: the model's reply (or a typed error) as `Some(ReplyResult)`, or
    ! `None` if the request was cancelled. The engine composes `system`/`messages`
    ! via `render` before calling this, so the impl is a thin model-call delegate.
    !
    ! The caller owns how the call is issued and cancelled, keeping that
    ! machinery — threads, interrupt polling — out of the engine.
  //]
  def ask(system: String, messages: List[Message], tools: List[Tool]): Option[ReplyResult]

  //[ Has cancellation been requested? //]
  def cancelled: Bool

  //[ Pause for up to `seconds`
    !
    ! return true if cancellation fires during the wait, so a long backoff can
    ! be abandoned promptly.
  //]
  def pause(seconds: Float): Bool

  //[ Handle a turn event   //]
  def emit(event: TurnEvent): Unit
end

//[ TurnEvent
  !
  ! Everything the engine wants to surface during a turn, as data — the handler
  ! decides how (or whether) to present it. `*Started`/`*Ended` pairs bracket a
  ! blocking call, so a handler can drive a spinner/progress indicator around it.
//]
union TurnEvent =
    ModelRequestStarted(attempt: Int, maxAttempts: Int)   // attempt 0 = first try
  | ModelRequestEnded
  | TransientError(detail: String, delaySeconds: Float)   // about to wait, then retry
  | RequestFailed(detail: String)                          // fatal — the turn is lost
  | RetriesExhausted(detail: String, attempts: Int)        // gave up after retrying
  | ToolBudgetReached(budget: Int)                         // no tools offered; forcing a final answer
  | ToolCallStarted(name: String)
  | ToolCallEnded(name: String, summary: String)
  | ContextCompacted(droppedMessages: Int)                 // old turns distilled into the context's summary

//[ The outcome of one user turn
  !
  ! An answer — with the turn's *delta*, the messages the engine produced this
  ! turn (assistant replies and tool-result batches, in order), so the driver
  ! can archive them — or an interruption, or a failed request.
//]
union TurnResult =
    Answered(delta: List[Message], text: String)
  | Interrupted
  | Failed

//[ The result of fetching one model reply (after any retries)
  !
  ! The assistant message, a give-up (fatal error or retries exhausted), or an interruption.
//]
private union Fetched =
    Got(message: Assistant)
  | GaveUp
  | Stopped

//[ Exponential backoff between retries: 1s, 2s, 4s, … capped at 30s.  //]
private def backoffSeconds(attempt: Int): Float =
  var d = 1.0
  var i = 1
  while i < attempt do
    d = d * 2.0
    i = i + 1

  if d > 30.0 then 30.0 else d

//[ Ask the model for one reply
  !
  ! Retry transient errors with exponential backoff up to `maxRetries`.
  !
  ! A `None` from `ask` (a cancelled request), or interrupt firing during a
  ! backoff wait, ends the attempt.
  !
  ! Progress and errors are reported through `interact.emit`.
//]
private def fetchReply(
    system: String, messages: List[Message], tools: List[Tool], maxRetries: Int, interact: Interact)
: Fetched =

  var attempt = 0
  var outcome: Fetched = GaveUp

  while true do
    interact.emit: ModelRequestStarted(attempt, maxRetries)

    val maybe = interact.ask(system, messages, tools)

    interact.emit: ModelRequestEnded

    val res = maybe rescue None =>
      outcome = Stopped
      break

    match res
      case Reply(message) =>
        outcome = Got(message)
        break

      case Fatal(detail) =>
        interact.emit: RequestFailed(detail)
        outcome = GaveUp
        break

      case Transient(detail) =>
        attempt = attempt + 1
        if attempt > maxRetries then
          interact.emit: RetriesExhausted(detail, maxRetries)
          outcome = GaveUp
          break

        else
          val delay = backoffSeconds(attempt)
          interact.emit: TransientError(detail, delay)
          // pause returns true if cancellation fired during the backoff.
          if interact.pause(delay) then
            outcome = Stopped
            break
  end // while

  outcome

//[ Drive one turn
  !
  ! Call the model (with retries), run any tool calls it requests, and repeat
  ! until it replies with plain text.
  !
  ! The `context` owns the transcript: the engine appends each assistant reply
  ! and tool-result batch to it, and asks it to compose `(system, messages)`
  ! before every model request. The caller appends the turn's `UserText` (after
  ! `context.mark()`) before calling; on `Answered` it receives the turn's
  ! delta to archive, on interruption/failure it calls `context.rollback()`.
  !
  ! A turn is bounded to `maxToolRounds` tool-call rounds; once spent the model
  ! is asked once more with no tools, forcing a final answer.
//]
def runTurn(
    context: Context, tools: List[Tool],
    maxToolRounds: Int, maxRetries: Int, interact: Interact)
: TurnResult =

  var delta: List[Message] = []
  var rounds = 0
  var result: TurnResult = Failed

  while true do
    // Once the tool budget is spent, offer no tools so the model must reply with
    // a final text answer rather than calling another tool.
    val offer: List[Tool] = if rounds >= maxToolRounds then [] else tools

    if rounds == maxToolRounds then
      interact.emit: ToolBudgetReached(maxToolRounds)

    // Compose what the model sees for this request — the context's policy,
    // applied once here, not in each concrete Interact.
    val rendered = context.render(interact)

    match fetchReply(rendered.fst, rendered.snd, offer, maxRetries, interact)
      case Stopped =>
        result = Interrupted
        break

      case GaveUp =>
        result = Failed
        break

      case Got(reply) =>
        context.append(reply)
        delta = delta + reply

        if reply.calls.isEmpty then
          result = Answered(delta, reply.text.trim)
          break

        var toolResults: List[ToolResult] = []
        var cancelled = false

        for call in reply.calls do
          if interact.cancelled then
            cancelled = true
            break

          val toolName = call.name
          interact.emit: ToolCallStarted(toolName)

          val outcome =
            if tools.find(t => t.name == toolName) is Some(t) then
              runSafely(t, call.input)
            else
              RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}")

          interact.emit: ToolCallEnded(toolName, outcome.summary)

          toolResults = toolResults + ToolResult(call.id, outcome.result)

        if cancelled || interact.cancelled then
          result = Interrupted
          break

        else
          val results = ToolResults(toolResults)
          context.append(results)
          delta = delta + results
          rounds = rounds + 1
  end // while

  result
