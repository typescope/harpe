//[ Render.jo
  !
  ! `render` — the pluggable context-engineering surface. It composes what the model
  ! sees for one request from the base system prompt (AGENT.md), the agent's working
  ! `memory`, and the running `transcript`, returning `(system, messages)`.
  !
  ! The engine calls `render` once per model request (see `runTurn`), so it is
  ! written here once rather than in each concrete `Interact`. It is a `defer def`:
  ! an agent overrides it via `[main.links] "harpe.turn.render" = "MyAgent.render"`
  ! to compose context however it likes.
  !
  ! The default folds memory into the *end* of the system prompt (so the stable
  ! prefix — AGENT.md, tool specs — stays cache-friendly) and windows the transcript
  ! to a character budget with the shared `truncate`.
//]

namespace harpe.turn

import harpe.models.*
import harpe.util.truncate

//[ Budget (characters) for the recent transcript window in the DEFAULT `render`
  ! (~4 chars/token); older whole turns are dropped to fit, and memory carries
  ! longer-term context. Not a hook — a custom `render` sets its own policy, which
  ! would make this irrelevant.
//]
def maxTranscriptChars(): Int = 24000

//[ Compose `(system, messages)` for one model request. //]
defer def render(baseSystem: String, memory: Map[String, String], transcript: List[Message]): String ~ List[Message] =
  val system =
    if memory.isEmpty then baseSystem
    else baseSystem + "\n\n" + memoryBlock(memory)

  system ~ truncate(transcript, maxTranscriptChars)

//[ The volatile memory block, appended after the stable base prompt. One section
  ! per key; the keys are the agent's own (steered by AGENT.md, no fixed schema).
//]
private def memoryBlock(memory: Map[String, String]): String =
  var s = "# Working memory\n\n(You maintain this with the memory tools; it persists across turns.)\n"
  for k ~ v in memory.toList do
    s = s + "\n## \{k}\n\{v}\n"
  s
