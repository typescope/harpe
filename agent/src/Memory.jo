//[ Memory.jo
  !
  ! The agent's working memory: a small, mutable string→string store the LLM
  ! curates (via the memory tools) and the framework renders into the model's
  ! context each turn. It is the *durable* half of the loop's state; the transcript
  ! is the ephemeral half.
  !
  ! What to keep here, and under which keys, is up to the agent's AGENT.md prompt —
  ! the framework imposes no schema. Persistence is a current-snapshot JSON (not an
  ! event stream), written atomically; where it lives is the driver's decision (see
  ! each driver's `Sessions`).
  !
  ! The store is per session; a session's turns are serialized by its driver, so no
  ! internal locking is needed. Memory is deliberately NOT rolled back when a turn
  ! is interrupted or fails — an `updateMemory` is an intentional act, independent
  ! of turn outcome.
//]

namespace harpe

import harpe.ffi.jsonMod
import harpe.ffi.fileExists
import harpe.ffi.readFile
import harpe.ffi.writeFile

//[ A mutable string→string working-memory store, over an immutable `Map`. //]
class Memory
  private var store: Map[String, String] = Map.empty

  //[ The value for `key`, or "" if unset. //]
  def get(key: String): String = store.getOrElse(key, "")

  //[ Set (or replace) the whole value for `key`. //]
  def set(key: String, value: String): Unit = store = store.update(key, value)

  //[ Is `key` present? //]
  def has(key: String): Bool = store.contains(key)

  //[ The keys currently stored. //]
  def keys(): List[String] = store.keys

  //[ Has nothing been stored yet? //]
  def isEmpty: Bool = store.isEmpty

  //[ An immutable snapshot for `render` to read. The store is already an immutable
    ! `Map`, so this just hands it out.
  //]
  def snapshot(): Map[String, String] = store

  //[ The whole map as a JSON object string — the persisted snapshot. //]
  def toJson(): String =
    val d = py.dict()
    for k ~ v in store.toList do d.set(k, v)
    jsonMod.dumps(d).asString
end

section Memory
  //[ A `Memory` from a JSON snapshot (as written by `toJson`). An empty string or
    ! unparseable text yields an empty store, so a corrupt/absent file never crashes
    ! a resume.
  //]
  def fromJson(text: String): Memory =
    val m = new Memory
    if text.trim != "" then
      match py.try(jsonMod.loads(text))
      case Ok(d) =>
        val dict = d.cast[py.Dict]
        for k in py.iter(dict.keys()) do
          m.set(k.asString, dict.get(k).asString)

      case Err(_) => pass

    m

  //[ Load a memory snapshot from `path`; an empty store if the file is absent. //]
  def load(path: String): Memory =
    if fileExists(path) then fromJson(readFile(path)) else new Memory

  //[ Save `memory` to `path` atomically: write `<path>.tmp`, then rename over the
    ! target (atomic on POSIX), so a crash never leaves a half-written file.
  //]
  def save(path: String, memory: Memory): Unit =
    val dir = os.path.dirname(path)
    if dir != "" then os.makedirs(dir)

    val tmp = path + ".tmp"
    writeFile(tmp, memory.toJson())
    os.rename(tmp, path)
end
