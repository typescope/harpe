//[ RunCode.jo
  !
  ! The `runCode` tool: write the model's program to the guest sandbox, compile
  ! it (the security checkpoint), run the compiled program, and capture the
  ! result — timed and reported to the caller's run-log sink. Reusable across
  ! agent types. This audit trail is the program-execution log, distinct from the
  ! conversational session history; the concrete logging policy is injected, not
  ! hard-coded here.
//]

namespace harpe.tools

import harpe.ffi.*

private def runCode(
    code: String,
    guestDir: String,
    logRun: py.Dict => Unit,
    buildTimeout: Float,
    runTimeout: Float)
: RunOutcome =
  // Build one structured record per run — the time and the program under test,
  // plus the fields specific to how the run ended — and hand it to the injected
  // sink. What becomes of the record (a file, some other store, the network, or
  // nothing at all) is the caller's policy, not this tool's concern.
  def log(fields: ..(Any ~ Any)): Unit =
    val entry = py.dict("time" ~ time.now(), "code" ~ code)
    for k ~ v in fields do entry.set(k, v)
    logRun(entry)

  // The guest package's layout: where to write the program, what to build, and
  // where its compiled output lands.
  val guestSrc  = os.path.join(guestDir, "src/Task.jo")
  val guestSpec = os.path.join(guestDir, "jo.toml")
  val buildGlob = os.path.join(guestDir, ".build/*/jo-*/target/*.py")

  writeFile(guestSrc, code)

  // 1. Compile — the security checkpoint — timed, bounded, and error-captured.
  val t0 = time.now()
  val build = runCapped(py.list("jo", "build", "--spec", guestSpec), buildTimeout)
  val compileSeconds = round2(time.now() - t0)

  if build.timedOut then
    log(
      "compiled"       ~ false,
      "compileSeconds" ~ compileSeconds,
      "timedOut"       ~ true,
      "phase"          ~ "compile"
    )
    return new RunOutcome(
      "The build timed out after \{buildTimeout}s.",
      "build timed out · \{buildTimeout}s")

  if build.returnCode != 0 then
    val compileError = stripAnsi(build.err).trim
    log(
      "compiled"       ~ false,
      "compileSeconds" ~ compileSeconds,
      "compileError"   ~ compileError
    )
    return new RunOutcome(
      "The program did not compile (\{compileSeconds}s):\n\{compileError}",
      "did not compile · \{compileSeconds}s")

  // 2. Run the compiled program directly, timed and bounded.
  val targets: py.List = globMod.glob(buildGlob).cast[py.List]
  if targets.size == 0 then
    return new RunOutcome("The program compiled but no executable was found.", "no executable produced")

  val targetPy = targets.get(0).asString
  val t1 = time.now()
  val run = runCapped(py.list("python3", targetPy), runTimeout)
  val runSeconds = round2(time.now() - t1)

  if run.timedOut then
    log(
      "compiled"       ~ true,
      "compileSeconds" ~ compileSeconds,
      "runSeconds"     ~ runSeconds,
      "timedOut"       ~ true,
      "phase"          ~ "run"
    )
    return new RunOutcome(
      "The program ran too long and was stopped after \{runTimeout}s (possible infinite loop).",
      "timed out · ran \{runSeconds}s")

  val runReturnCode = run.returnCode
  val runOut = run.out.trim
  val runErr = stripAnsi(run.err).trim

  val result =
    if runReturnCode != 0 then "The program crashed:\n\{runErr}"
    else if runOut == "" then "(the program produced no output)"
    else runOut

  val summary =
    if runReturnCode != 0 then "crashed · compiled \{compileSeconds}s, ran \{runSeconds}s"
    else "ran · compiled \{compileSeconds}s, ran \{runSeconds}s"

  log(
    "compiled"       ~ true,
    "compileSeconds" ~ compileSeconds,
    "runSeconds"     ~ runSeconds,
    "exitCode"       ~ runReturnCode,
    "output"         ~ result
  )
  new RunOutcome(result, summary)

//[ The core "act" tool: compile + run a Jo program against the agent sandbox.
  !
  ! `buildTimeout` / `runTimeout` are host-side wall-clock backstops (seconds): a
  ! guest stuck compiling or in an infinite loop is killed (process group and
  ! all) rather than hanging the loop. They are the outer bound; finer in-guest
  ! memory/CPU caps belong in the sandbox runtime (`harpe.sandbox`). An agent that
  ! overrides `defaultTools` can pass its own values.
  !
  ! `logRun` is the injected audit sink: it receives one structured record per
  ! run (time, code, compile/run timings, output or error). The tool does not
  ! decide where that goes — the caller supplies the policy.
//]
def runCodeTool(
    guestDir: String,
    logRun: py.Dict => Unit,
    buildTimeout: Float = 120.0,
    runTimeout: Float = 30.0)
: Tool =
  new Tool(
    "runCode",
    "Write a Jo program (namespace UserTask, def runTask), compile it against the agent sandbox, and run it. Returns the program's stdout, or the compile error if it does not build.",
    [strParam("code", "The Jo source code to compile and run")],
    input => runCode(input.string("code"), guestDir, logRun, buildTimeout, runTimeout)
  )
