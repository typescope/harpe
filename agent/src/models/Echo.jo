//[ Echo.jo
  !
  ! A dummy `Model` that never calls a provider: it replies with the last user
  ! message, prefixed. Useful for testing the cli loop end-to-end without an API
  ! key.
//]

namespace harpe.models

import harpe.*

import harpe.models.Model.*
import harpe.tools.Tool

private class EchoModel
  view Model

  def reply(system: String, history: List[Message], tools: List[Tool]): ReplyResult =
    var last = ""
    for m in history do
      if m is UserText(text) then last = text
    Reply: Assistant("echo: \{last}", [])
end

//[ Build the echo model (no provider, no API key). //]
def echo(): Model = new EchoModel
