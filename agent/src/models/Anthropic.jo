//[ Anthropic.jo
  !
  ! The Anthropic-backed `Model`: renders the Jo tool model into Anthropic tool
  ! specs, converts the provider-agnostic history into Anthropic messages, calls
  ! `messages.create`, and parses the content blocks back into an `Assistant`.
  ! All Anthropic-specific shape lives here; the loop never sees it.
//]

namespace harpe.models

import harpe.ffi.*

import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*


//[ One tool's Anthropic spec, derived from the Jo `Tool` model. //]
private def toolSpec(t: Tool): py.Dict =
  val properties = py.dict()
  val required = py.list()
  for p in t.params do
    properties.set(p.name, py.dict("type" ~ p.paramType.jsonType, "description" ~ p.description))
    if p.required then required.append(p.name)
  end

  py.dict(
    "name" ~ t.name,
    "description" ~ t.description,
    "input_schema" ~ py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
  )

//[ The conversation as Anthropic's `messages` array (content-block format). //]
private def toMessages(history: List[Message]): py.List =
  val msgs = py.list()
  for m in history do
    if m is UserText(text) then
      msgs.append(py.dict("role" ~ "user", "content" ~ text))

    else if m is Assistant(text, calls) then
      val content = py.list()

      if text != "" then content.append(py.dict("type" ~ "text", "text" ~ text))

      for c in calls do
        content.append:
          py.dict("type" ~ "tool_use", "id" ~ c.id, "name" ~ c.name, "input" ~ c.input.raw)

      msgs.append(py.dict("role" ~ "assistant", "content" ~ content))

    else if m is ToolResults(results) then
      val content = py.list()
      for r in results do
        content.append:
          py.dict("type" ~ "tool_result", "tool_use_id" ~ r.id, "content" ~ r.content)
      end
      msgs.append: py.dict("role" ~ "user", "content" ~ content)
  msgs

//[ Parse an Anthropic response's content blocks into an `Assistant` reply.
  !
  ! A `stop_reason` of "max_tokens" means the reply was cut off — possibly mid
  ! tool call, whose input JSON would be incomplete — so a truncated reply keeps
  ! its text plus a visible marker and DROPS any tool calls rather than running
  ! a tool on partial arguments.
//]
private def parseReply(response: py.Dynamic): Assistant =
  val content: py.List = response.content.cast[py.List]
  var text = ""
  var calls: List[ToolCall] = []

  for block in content do
    val btype = attr(block, "type").asString
    if btype == "text" then
      text = text + block.text.asString
    else if btype == "tool_use" then
      calls = calls + ToolCall(block.id.asString, block.name.asString, ToolInput(block.input.cast[py.Dict]))

  val stop = response.stop_reason

  if !stop.isNone && stop.asString == "max_tokens" then
    new Assistant((text + "\n\n[Reply truncated: max_tokens reached.]").trim, List.empty[ToolCall])
  else
    new Assistant(text.trim, calls)

private class AnthropicModel(client: py.Dynamic, model: String)
  view Model

  def reply(system: String, history: List[Message], tools: List[Tool]): ReplyResult =
    val toolSpecs = py.list()
    for t in tools do toolSpecs.append(toolSpec(t))

    val attempt = py.try:
      client.messages.create:
        model = model
        max_tokens = 8096
        system = system
        messages = toMessages(history)
        tools = toolSpecs

    match attempt
    case Ok(response) => Reply: parseReply(response)
    case Err(err)     => classifyError(err)
end

//[ Build an Anthropic-backed model from an API key and model id.
  !
  ! The client gets an explicit request timeout, and its INTERNAL retries are
  ! disabled (`max_retries = 0`): the turn engine owns the retry/backoff policy,
  ! and hidden SDK retries would silently multiply it.
//]
def anthropic(apiKey: String, model: String): Model =
  new AnthropicModel(py.module("anthropic").Anthropic(api_key = apiKey, timeout = 600.0, max_retries = 0), model)
