//[ RunEvent.jo
  !
  ! The structured record of one `runCode` invocation — the observability event
  ! the tool emits and a run logger persists. Modeled in Jo (not a raw `py.Dict`)
  ! so the shape is explicit and checked: every event carries the wall-clock
  ! `time` and the `code` under test, plus a `RunResult` capturing exactly the
  ! fields that outcome has — a compile that timed out has no run timing, a
  ! successful run has an exit code and output, and so on.
  !
  ! `toDict` is the one place that flattens an event to the JSON-able record
  ! written to `logs/runs.jsonl`; a logger serializes that. Keeping the shape
  ! here means the log format is a property of this type, not scattered across
  ! call sites.
//]

namespace harpe.stat

//[ RunResult
  !
  ! How one run ended. Each branch is a distinct outcome carrying only its own
  ! fields, so an impossible combination (say, a run time on a build that never
  ! compiled) cannot be represented.
//]
union RunResult =
    CompileTimedOut(compileSeconds: Float)
  | CompileFailed(compileSeconds: Float, error: String)
  | RunTimedOut(compileSeconds: Float, runSeconds: Float)
  | Ran(compileSeconds: Float, runSeconds: Float, exitCode: Int, output: String)

//[ RunEvent
  !
  ! One `runCode` invocation: when it ran (`time`, seconds since the epoch), the
  ! program under test (`code`), and how it ended (`result`).
//]
class RunEvent(time: Float, code: String, result: RunResult)
  //[ Flatten to a JSON-able dict — one line of `logs/runs.jsonl`.
    !
    ! The common `time`/`code`/`compiled` fields plus the result-specific ones,
    ! matching the historical log shape so existing readers keep working.
  //]
  def toDict: py.Dict =
    val d = py.dict("time" ~ time, "code" ~ code)

    match result
    case CompileTimedOut(compileSeconds) =>
      d.set("compiled", false)
      d.set("compileSeconds", compileSeconds)
      d.set("timedOut", true)
      d.set("phase", "compile")

    case CompileFailed(compileSeconds, error) =>
      d.set("compiled", false)
      d.set("compileSeconds", compileSeconds)
      d.set("compileError", error)

    case RunTimedOut(compileSeconds, runSeconds) =>
      d.set("compiled", true)
      d.set("compileSeconds", compileSeconds)
      d.set("runSeconds", runSeconds)
      d.set("timedOut", true)
      d.set("phase", "run")

    case Ran(compileSeconds, runSeconds, exitCode, output) =>
      d.set("compiled", true)
      d.set("compileSeconds", compileSeconds)
      d.set("runSeconds", runSeconds)
      d.set("exitCode", exitCode)
      d.set("output", output)

    d
end
