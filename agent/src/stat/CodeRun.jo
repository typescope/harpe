//[ CodeRun.jo
  !
  ! The run-log sink and the scope that installs it. `runCode` emits a `RunEvent`
  ! per program it compiles and runs; where that event goes is a policy the
  ! driver chooses, not the tool's concern. `logger` is the context parameter
  ! carrying that policy, and `withRunLogger` is the one scope that provides it:
  ! it opens the log file once, guards writes with a lock (runs are concurrent —
  ! several worker threads share the sink), and tears the file down when the
  ! wrapped work returns.
  !
  ! A driver wraps its main loop:
  !
  !     stat.CodeRun.withRunLogger: "logs/runs.jsonl", () => serve()
  !
  ! and every `runCode` underneath appends through the same open handle. Because
  ! `logger` flows as context, `Defaults.tools` picks it up the same way it picks
  ! up `workspace` — no hand-threading through the agent's construction.
//]

namespace harpe.stat

import harpe.workspace
import harpe.ffi.jsonMod
import harpe.ffi.threadingMod
import os

//[ The run-log sink: where each `runCode` execution record is sent. Provided
  ! by `CodeRun.withRunLogger`; picked up by the toolset via `receives logger`.
//]
param logger: RunEvent => Unit

section CodeRun
  //[ Run `work` with a run logger installed, appending each `RunEvent` as one
    ! JSON line to `file` (relative to the workspace root, e.g.
    ! `"logs/runs.jsonl"`).
    !
    ! The file is opened once for the whole scope and closed when `work` returns;
    ! a lock serializes writes so the concurrent `runCode` workers never
    ! interleave a line. Everything the sink does — the path layout, the JSON
    ! encoding, the locking — lives here, so a driver only names the file.
  //]
  def withRunLogger[T](file: String, work: () => T receives logger): T receives workspace =
    val path = workspace.relative(file)
    os.makedirs(os.path.dirname(path))

    val out = py.open(path, "a")
    val lock = threadingMod.Lock()

    val sink: RunEvent => Unit = event =>
      lock.acquire()
      out.write(jsonMod.dumps(event.toDict).asString + "\n")
      out.flush()
      lock.release()

    val result = with logger = sink in work()
    out.close()
    result
end
