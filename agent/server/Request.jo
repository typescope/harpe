namespace harpe.server

import harpe.ffi.json as JSON
import harpe.ffi.builtins
import harpe.ffi.os
import harpe.util.Clock
import harpe.server.Http
import harpe.server.Http.Verb
import harpe.server.Util

//[ One exchange, the channel that carries it, and the readers that take it
  ! apart. `path` is already decoded as UTF-8.
  !
  ! THE REQUEST IS AMBIENT. A server binds one per request, so a handler that
  ! wants the body asks for `Request.json()` rather than being handed an
  ! `environ` to pass on. That is why a route carries neither `environ` nor a
  ! way to start the response: it never touches either.
  !
  ! WHAT BELONGS HERE. Anything that reads the exchange that came in. The
  ! protocol's own types live in `Http`. A body format with a reader of its own
  ! lives with it, so `multipart` below is the door to `Multipart` and none of
  ! the scanning.
//]
class Request(method: Http.Verb.Method, path: String, environ: py.Dynamic)
  //[ Whether a reader has taken the body, which WSGI hands over as a stream read once. //]
  var bodyTaken: Bool = false
end

//[ The request being served. Bound once per request by the server. //]
param request: Request

//[ Reading what came in: the verb and path a route matches, and the body it asks for. //]
section Request
  //[ Request patterns keep the verb and path test together at dispatch sites
    !
    ! The path is compared exactly, so every route is one string. A parameter
    ! travels as a query parameter or in the body, which is uniform for a client
    ! that builds its own requests. A path that does carry one — an asset under
    ! a prefix — binds the path and guards on it:
    !
    !     case Get(path) if path.startsWith("/assets/") =>
    !       Response.file(root, path.substring(8, path.size - 8), Response.Inline)
  //]
  pattern Get(path: String): Partial[Request] =
    case asked if asked.method is Verb.Get then path = asked.path

  pattern Post(path: String): Partial[Request] =
    case asked if asked.method is Verb.Post then path = asked.path

  pattern Put(path: String): Partial[Request] =
    case asked if asked.method is Verb.Put then path = asked.path

  pattern Delete(path: String): Partial[Request] =
    case asked if asked.method is Verb.Delete then path = asked.path

  //[ `"/sessions/42/"` as `["sessions", "42"]`
    !
    ! Split ONCE, where a route needs the parts of a path, and match the list:
    !
    !     case Get(path) if path.startsWith("/sessions/") =>
    !       match segments(path)
    !       case ["sessions", id] => …
    !
    ! There was a `Segments` pattern that did this inside each case, which meant
    ! splitting the path again for every case it appeared in — measured at 328us
    ! across twenty routes, against 74us for a whole request.
    !
    ! Empty segments are dropped, so `/sessions/`, `/sessions`, and
    ! `//sessions//` all split the same way. `/` is the empty list.
  //]
  def segments(path: String): List[String] =
    path.split("/").exclude(part => part == "")


  private[server] def verb(raw: String): Option[Verb.Method] =
    if raw == "GET" then Some(Verb.Get)
    else if raw == "POST" then Some(Verb.Post)
    else if raw == "PUT" then Some(Verb.Put)
    else if raw == "DELETE" then Some(Verb.Delete)
    else if raw == "OPTIONS" then Some(Verb.Options)
    else None


  //[ `PATH_INFO` as the client wrote it
    !
    ! PEP 3333 hands the path over as bytes decoded as Latin-1, so `/café`
    ! arrives as `/cafÃ©`. Undoing that here is the only way a route can match a
    ! non-ASCII segment. None when the bytes are not UTF-8.
  //]
  private[server] def decodedPath(environ: py.Dynamic): Option[String] =
    val raw = py.dynamic(environ.get("PATH_INFO", "/"))
    match py.try(raw.encode("latin-1").decode("utf-8").asString)
    case Ok(path) => Some(path)
    case Err(_)   => None

  //[ What `CONTENT_LENGTH` claims, or zero. //]
  private[server] def declaredLength(environ: py.Dynamic): Int =
    Int.parse(environ.get("CONTENT_LENGTH", "").asString) rescue None => 0

  //[ Whether a body is on its way that declared no length
    !
    ! A chunked request declares none, so the limit has nothing to read and
    ! `bytes` would take zero and hand a route an empty body — silently, which
    ! is the worst answer available. It answers None instead, since the limit is
    ! enforced from the declaration: `saveTo` copies a body a block at a time but
    ! still reads exactly as far as it was told to.
    !
    ! `Transfer-Encoding` is the only mark read. `wsgi.input_terminated` says
    ! reading to EOF is safe, not that a body is coming — waitress sets it on
    ! every request, so trusting it would refuse a bodyless POST or DELETE. A
    ! request declaring neither has no body, which is what RFC 9112 says and
    ! what waitress was measured to do, so it is read as the empty body it is.
    !
    ! Waitress also de-chunks and declares the length, so what is left here is
    ! the servers that pass the chunks through.
  //]
  private def undeclaredBody(environ: py.Dynamic): Bool =
    match environValue(environ, "CONTENT_LENGTH")
    case Some(declared) if declared.trim != "" => false
    case _ => !py.isNone(environ.get("HTTP_TRANSFER_ENCODING"))

  //[ The value of a WSGI environ key, or None when it is absent. //]
  private[server] def environValue(environ: py.Dynamic, key: String): Option[String] =
    val found = environ.get(key)
    if py.isNone(found) then None else Some(found.asString)

  //[ The environ key WSGI files a request header under. //]
  private[server] def environKey(name: String): String =
    val key = py.dynamic(name).upper().asString.replace("-", "_")
    if key == "CONTENT_TYPE" || key == "CONTENT_LENGTH" then key else "HTTP_" + key

  //[ A `Host` or `Origin` authority reduced to its lower-case hostname, without port or brackets. //]
  private def hostname(authority: String): Option[String] =
    match py.try(py.module("urllib.parse").urlsplit("//" + authority).hostname)
    case Ok(name) => if py.isNone(name) then None else Some(name.asString)
    case Err(_)   => None

  //[ Whether the `Host` header names one of `names`, which is the reading `Application` judges against. //]
  private[server] def nameIn(environ: py.Dynamic, names: List[String]): Bool =
    match environValue(environ, "HTTP_HOST")
    case None => false
    case Some(authority) =>
      match hostname(authority)
      case Some(name) => names.contains(name)
      case None       => false

  //[ Is this a write a browser sent from another site?
    !
    ! Go's `CrossOriginProtection` algorithm. `Sec-Fetch-Site` decides when a
    ! browser sent it. Otherwise an `Origin` must name the same authority as
    ! `Host`. A request carrying neither did not come from a browser page.
  //]
  private[server] def crossSiteWrite(method: Verb.Method, environ: py.Dynamic): Bool =
    val writes = method is Verb.Post || method is Verb.Put || method is Verb.Delete
    if !writes then false
    else
      match environValue(environ, "HTTP_SEC_FETCH_SITE")
      case Some(site) => site != "same-origin" && site != "none"
      case None =>
        match environValue(environ, "HTTP_ORIGIN")
        case None => false
        case Some(origin) =>
          val netloc = py.module("urllib.parse").urlsplit(origin).netloc.asString
          val host = environValue(environ, "HTTP_HOST").getOrElse("")
          py.dynamic(netloc).lower().asString != py.dynamic(host).lower().asString

  //[ A request header, or None when the client did not send it. //]
  def header(name: String): Option[String] receives request =
    environValue(request.environ, environKey(name))

  //[ The first value of a query parameter
    !
    ! None when the parameter is absent. `?q=` is `Some("")`, so a handler can
    ! tell an empty value from a missing one.
  //]
  def query(key: String): Option[String] receives request =
    val qs = request.environ.get("QUERY_STRING", "").asString
    firstValue(py.module("urllib.parse").parse_qs(qs, keep_blank_values = true).cast[py.Dict], key)

  private def firstValue(params: py.Dict, key: String): Option[String] =
    if params.contains(key) then Some(params.get(key).cast[py.List].get(0).asString) else None

  //[ A cookie the client sent, or None
    !
    ! Parsed leniently, as browsers write them, rather than with `http.cookies`,
    ! which drops every cookie once one on the same domain is malformed. The
    ! first of two same-named cookies wins, which is the one with the longest
    ! path.
  //]
  def cookie(name: String): Option[String] receives request =
    val raw = header("Cookie") rescue None => return None

    for chunk in raw.split(";") do
      val pair = py.dynamic(chunk.trim).split("=", 1).cast[py.List]
      if pair.size == 2 && pair.get(0).asString.trim == name then
        val value = pair.get(1).asString.trim
        val quoted = value.size >= 2 && value.startsWith("\"") && value.endsWith("\"")
        return Some(if quoted then value.substring(1, value.size - 2) else value)

    None

  //[ The value of a signed cookie, or None
    !
    ! None when the cookie is missing, was altered, was moved to another name,
    ! or has passed the expiry it was signed with, and a caller cannot tell
    ! those apart. Signing proves the value is the one this application wrote.
    ! It does NOT hide it: whoever holds the cookie can read it, so a user id
    ! belongs here and a secret does not.
    !
    ! The expiry the server enforces is the signed one, not the browser's
    ! `Max-Age`. Nothing here can be revoked before it expires — an application
    ! that must revoke keeps state of its own, such as a deny list.
  //]
  def signedCookie(name: String, secret: String): Option[String] receives request =
    val carried = cookie(name) rescue None => return None
    val parts = carried.split(".")
    if parts.size != 3 then return None

    val value = parts.get(0)
    val expiry = parts.get(1)
    val signature = Util.signCookie(name, value, expiry, secret)
    if !py.module("hmac").compare_digest(signature, parts.get(2)).asBool then return None

    val deadline = Int.parse(expiry) rescue None => return None
    if deadline <= Clock.now().toInt then return None

    val decoded = py.try(py.module("base64").urlsafe_b64decode(value + "===").decode("utf-8").asString) rescue Err(_) => return None
    Some(decoded)

  //[ The media type of the body, lower-cased and without its parameters. //]
  private[server] def mediaType(): String receives request =
    val kind = header("Content-Type").getOrElse("")
    py.dynamic(kind.split(";").get(0).trim).lower().asString

  //[ The request body as bytes, or None when it cannot be trusted whole
    !
    ! None when the body declared no length at all, and when less of it arrived
    ! than was declared. Both would otherwise read as a body the route believes
    ! complete.
    !
    ! Reads exactly what `CONTENT_LENGTH` declares, with no cap of its own:
    ! `Application.wsgi` has already refused a declaration over the route's own
    ! limit. A client that sends less than it promised answers None rather than
    ! a truncated buffer, since a prefix of a message reads as a whole one.
    !
    ! The body is a stream, so a second read in one request aborts rather than
    ! returning nothing.
  //]
  def bytes(): Option[py.Dynamic] receives request =
    if request.bodyTaken then abort "the request body was already read"
    request.bodyTaken = true
    if undeclaredBody(request.environ) then return None
    val declared = declaredLength(request.environ)
    val raw = request.environ.get("wsgi.input").read(declared)
    if builtins.len(raw) == declared then Some(raw) else None

  //[ How much of a body is read at once, and so what one costs in memory. //]
  private def blockBytes: Int = 65536

  //[ The request body written to `path`, and how many bytes that was
    !
    ! For an upload whose destination is a file: the body is copied a block at a
    ! time, so a large one costs a block rather than its size. `bytes` and the
    ! readers built on it hold the whole body, which is why a route that takes
    ! uploads should reach for this instead.
    !
    ! None in the same cases `bytes` answers None — a body that declared no
    ! length, and one that arrived short — and nothing is left at `path` in
    ! either, so None means nothing was stored. Anything already there is
    ! replaced.
    !
    ! `path` is the route's to choose. A filename a client sent is not one: see
    ! `Multipart.Upload`.
  //]
  def saveTo(path: String): Option[Int] receives request =
    if request.bodyTaken then abort "the request body was already read"
    request.bodyTaken = true
    if undeclaredBody(request.environ) then return None

    val declared = declaredLength(request.environ)
    val input = request.environ.get("wsgi.input")
    val out = py.open(path, "wb")
    var written = 0

    while written < declared do
      val asked = declared - written
      val block = input.read(if asked > blockBytes then blockBytes else asked)
      val got = builtins.len(block)
      if got == 0 then break
      out.write(block)
      written = written + got

    out.close()
    if written == declared then return Some(written)

    // A prefix of a message reads as a whole one, so leave nothing behind.
    os.unlink(path)
    None

  //[ The request body as text, or None when it is not UTF-8. //]
  def body(): Option[String] receives request =
    val raw = bytes() rescue None => return None
    match py.try(raw.decode("utf-8").asString)
    case Ok(text) => Some(text)
    case Err(_)   => None

  //[ The request body as a form, with its files written into `fileStoreDir`
    !
    ! `fileStoreDir` is a directory the route owns. Each file is written there as it
    ! arrives, under a generated name, and its `Upload` carries that path
    ! beside the name the client sent. A route keeping a file renames it, which
    ! costs nothing because the file is already on the route's own filesystem:
    !
    !     val form = Request.multipart(Session.dataDir(id)) rescue None =>
    !       return Response.badRequest("expected a form")
    !
    ! None refuses every file part, which is what a route expecting only fields
    ! says. A route wanting only some of the files deletes the rest.
    !
    ! None unless the request says `multipart/form-data` with a boundary and
    ! the body scans cleanly. Every file already written is unlinked first, so
    ! None means nothing was stored.
    !
    ! The body is read a block at a time and never held whole, so what a route
    ! must budget is that directory's disk rather than this process's memory.
    ! `Multipart` has the rest.
  //]
  def multipart(fileStoreDir: String | None): Option[Multipart.Form] receives request =
    if mediaType() != "multipart/form-data" then return None
    if request.bodyTaken then abort "the request body was already read"
    request.bodyTaken = true
    if undeclaredBody(request.environ) then return None

    val mark = Multipart.boundary(header("Content-Type").getOrElse("")) rescue None => return None
    Multipart.read(request.environ.get("wsgi.input"), mark, declaredLength(request.environ), fileStoreDir)

  //[ The request body as a JSON object
    !
    ! None unless the request says `application/json` and the body parses to an
    ! object. A handler answers that with its own 400. Requiring the content type
    ! also makes a browser preflight any cross-site attempt to send it.
  //]
  def json(): Option[py.Dict] receives request =
    if mediaType() != "application/json" then return None
    val text = body() rescue None => return None
    val value = py.try(JSON.loads(text)) rescue Err(_) => return None
    if py.isInstance(value, builtins.dict) then Some(value.cast[py.Dict]) else None
end
