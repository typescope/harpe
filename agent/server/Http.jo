namespace harpe.server

import harpe.ffi.builtins

//[ The protocol as values: the verbs, statuses, media types and headers a
  ! program names in source, with the support that makes them usable — the
  ! status line a code writes, the charset a content type settles, the spelling
  ! WSGI expects of a verb.
//]
section Http
  //[ One header, either side of the exchange
    !
    ! A CR or LF in the name or the value aborts at construction, since one
    ! would split the response it is written into.
  //]
  class Header(name: String, value: String)
    private val whole: Bool =
      val split = name.contains("\r") || name.contains("\n")
      if split || value.contains("\r") || value.contains("\n") then
        abort "header '\{name}' contains a line break"
      true
  end

  //[ The verb a request carries
    !
    ! These five are what a server here understands. Anything else, HEAD
    ! included, is refused with a 501 before any route is looked at. A route
    ! may claim `Options`, which is how an application answers the CORS
    ! preflight harpe sends no header of its own for. One no route claims
    ! answers 405 with `Allow` where another verb claims the path, and the
    ! fallback's 404 otherwise.
  //]
  section Verb
    union Method = Get | Post | Put | Delete | Options
  end

  //[ The status a response carries
    !
    ! Add a case rather than passing a literal. `Other` is for a status decided
    ! at runtime, such as one relayed from upstream. Nothing here answers a
    ! conditional request, so a route answering 304 reads `If-None-Match` and
    ! decides for itself.
  //]
  section Status
    union Code =
        Success
      | Created
      | NoContent
      | SeeOther
      | NotModified
      | BadRequest
      | Unauthorized
      | Forbidden
      | NotFound
      | MethodNotAllowed
      | Conflict
      | LengthRequired
      | TooLarge
      | UnsupportedMediaType
      | TooManyRequests
      | ServerError
      | NotImplemented
      | Unavailable
      | Other(code: Int, reason: String)

    //[ The status line WSGI expects. //]
    private[server] def line(code: Code): String =
      match code
      case Success              => "200 OK"
      case Created              => "201 Created"
      case NoContent            => "204 No Content"
      case SeeOther             => "303 See Other"
      case NotModified          => "304 Not Modified"
      case BadRequest           => "400 Bad Request"
      case Unauthorized         => "401 Unauthorized"
      case Forbidden            => "403 Forbidden"
      case NotFound             => "404 Not Found"
      case MethodNotAllowed     => "405 Method Not Allowed"
      case Conflict             => "409 Conflict"
      case LengthRequired       => "411 Length Required"
      case TooLarge             => "413 Payload Too Large"
      case UnsupportedMediaType => "415 Unsupported Media Type"
      case TooManyRequests      => "429 Too Many Requests"
      case ServerError          => "500 Internal Server Error"
      case NotImplemented       => "501 Not Implemented"
      case Unavailable          => "503 Service Unavailable"
      case Other(code, reason)  => "\{code} \{reason}"
  end

  //[ The content type, with its charset settled
    !
    ! A case names each type a handler writes in source, and `Other` carries
    ! what no case names. `parse` turns a type resolved at runtime — a file's
    ! own, from `File.mimeType` — into one of these.
  //]
  section Mime
    union Type = Html | Json | Ndjson | Text | Css | JavaScript | Other(value: String)

    private[server] def value(kind: Type): String =
      match kind
      case Html        => "text/html; charset=utf-8"
      case Json        => "application/json"
      case Ndjson      => "application/x-ndjson"
      case Text        => "text/plain; charset=utf-8"
      case Css         => "text/css; charset=utf-8"
      case JavaScript  => "application/javascript; charset=utf-8"
      case Other(raw)  => raw

    //[ The case a raw type names, or `Other` carrying it
      !
      ! A `text/*` type no case names gets `; charset=utf-8`.
    //]
    private[server] def parse(raw: String): Type =
      match raw
      case "text/html"              => Html
      case "application/json"       => Json
      case "application/x-ndjson"   => Ndjson
      case "text/plain"             => Text
      case "text/css"               => Css
      case "text/javascript"        => JavaScript
      case "application/javascript" => JavaScript
      case _                        => Other(if raw.startsWith("text/") then raw + "; charset=utf-8" else raw)
  end

  //[ The verb as WSGI spells it. //]
  private[server] def verbName(method: Verb.Method): String =
    match method
    case Verb.Get     => "GET"
    case Verb.Post    => "POST"
    case Verb.Put     => "PUT"
    case Verb.Delete  => "DELETE"
    case Verb.Options => "OPTIONS"
end
