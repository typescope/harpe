namespace harpe.server

import harpe.server.Http
import harpe.server.Http.Verb
import harpe.server.Http.Status
import harpe.server.Http.Mime
import harpe.server.Http.Header
import harpe.server.Request
import harpe.server.request
import harpe.server.Response
import harpe.server.Router
import harpe.server.Wsgi

//[ One application: its routes, the policy enforced before any of them runs,
  ! and the WSGI callable a server is given.
  !
  ! THE DOOR IS HERE. Before a route runs, `wsgi` refuses an unknown verb, a
  ! path that is not UTF-8, a `Host` the application does not answer to, a
  ! cross-site write, and a body over the route's limit. Those are protocol
  ! answers every browser-facing application needs, and none of them is a
  ! route's to remember.
  !
  ! `fallback` answers what no route claims — the page itself, for a
  ! single-page application whose client routes on the path. An application
  ! that dispatches by pattern matching passes no routes and its own match as
  ! the fallback.
  !
  ! `maxBodyBytes` is the limit for every route that names none. Keep it small:
  ! an upload route says so for itself, and `ceiling` is what the server is
  ! given. `host` defaults to loopback, so a prototype on `127.0.0.1` runs as it
  ! is, and a deployment that forgets to name its own host is refused rather
  ! than quietly served — which is what stops a hostile page pointing its own
  ! name at this server and reading it as same-origin.
  !
  ! `wsgi` is the seam a deployment binds its server to, so harpe installs none.
  ! `Serve` is wsgiref, for harpe's own viewer and tests.
//]
class Application(
      routes: List[Router.Route],
      fallback: (() => Response receives request),
      host: Application.Host.Policy = Application.Host.Loopback,
      maxBodyBytes: Int = 1048576,
      crossSite: Application.CrossSite.Policy = Application.CrossSite.Refuse)
  //[ The exact routes, indexed once here, where two claiming one verb and path abort. //]
  private val exact: py.Dict = Router.indexed(routes)

  //[ This application as a WSGI application, which is what a server is given. //]
  def wsgi(): (py.Dynamic, py.Dynamic) => py.List =
    (environ: py.Dynamic, startResponse: py.Dynamic) =>
      Wsgi.write(startResponse, answer(environ))

  //[ The largest body any route allows, which is the limit to give the server. //]
  def ceiling: Int =
    var most = maxBodyBytes
    for route in routes do
      if route.maxBodyBytes > most then most = route.maxBodyBytes
    most

  //[ What this exchange is answered with, refusals included
    !
    ! Refuses, in order and before the route runs: a verb not implemented (501,
    ! not 405, because no path has been looked at), a path that is not UTF-8
    ! (400), a `Host` this application does not answer to (400), a cross-site
    ! write (403), a body that declares no length (411), and a body over the
    ! route's limit (413).
    !
    ! The 413 is written without draining what the client is still sending, so a
    ! client mid-upload may see the connection close first. Give the server its
    ! own limit too, which can discard the body properly.
    !
    ! A route that raises is left to the server, which answers 500 and logs it.
    ! An application wanting its own answer, logged with the session it belongs
    ! to, wraps its own routes: only it knows that context.
  //]
  private def answer(environ: py.Dynamic): Response =
    val raw = environ.get("REQUEST_METHOD", "GET").asString
    val method = Request.verb(raw) rescue None =>
      return if raw == "HEAD" then Answer.unsupportedHead() else Answer.refuse(Status.NotImplemented, "not implemented")
    val path = Request.decodedPath(environ) rescue None =>
      return Answer.refuse(Status.BadRequest, "path is not UTF-8")

    if !Application.hostAllowed(environ, host) then
      val sent = Request.environValue(environ, "HTTP_HOST").getOrElse("none")
      return Answer.refuse(Status.BadRequest, "host '\{sent}' is not one this application answers to")
    if crossSite is Application.CrossSite.Refuse && Request.crossSiteWrite(method, environ) then
      return Answer.refuse(Status.Forbidden, "cross-site request refused")

    val found = routeFor(method, path)
    if Request.undeclaredBody(environ) then
      return Answer.refuse(Status.LengthRequired, "a request body must declare its length")
    if Request.declaredLength(environ) > limitFor(found) then
      return Answer.refuse(Status.TooLarge, "request body too large")

    match found
    case Some(route) => Answer.ran(route.handler, method, path, environ)
    case None =>
      val others = otherVerbs(method, path)
      if others.size == 0 then Answer.ran(fallback, method, path, environ)
      else
        val headers = [Header("Allow", others.join(", "))]
        Response.complete(Status.MethodNotAllowed, Mime.Text, "method not allowed", headers = headers)

  //[ What this exchange may send: the route's own limit, or the application's. //]
  private def limitFor(found: Option[Router.Route]): Int =
    match found
    case Some(route) => if route.maxBodyBytes == 0 then maxBodyBytes else route.maxBodyBytes
    case None        => maxBodyBytes

  //[ The route for this exchange: an exact path first, then the longest prefix that covers it. //]
  private def routeFor(method: Verb.Method, path: String): Option[Router.Route] =
    val key = Http.verbName(method) + " " + path
    if exact.contains(key) then return Some(exact.get(key).cast[Router.Route])

    var best: Option[Router.Route] = None
    var longest = -1
    for route in routes do
      val covers = route.prefix && Http.verbName(route.method) == Http.verbName(method) && path.startsWith(route.path)
      if covers && route.path.size > longest then
        best = Some(route)
        longest = route.path.size
    best

  //[ The verbs another route claims this exact path under, which is what makes a 405 rather than the fallback. //]
  private def otherVerbs(method: Verb.Method, path: String): List[String] =
    var claimed: List[String] = []
    for route in routes do
      if !route.prefix && route.path == path && Http.verbName(route.method) != Http.verbName(method) then
        claimed = claimed + Http.verbName(route.method)
    claimed
end

//[ What this application chooses to accept, which is policy rather than protocol.
  !
  ! These name what an `Application` answers to, not anything an exchange
  ! carried, so they sit with the class that takes them rather than in `Http`.
//]
section Application
  //[ Which `Host` names a request may carry
    !
    ! Checking it is what defeats DNS rebinding, where a hostile page points its
    ! own name at a server on loopback and reads it as same-origin. `Named`
    ! compares one name without its port, case-insensitively. `Unchecked` is for
    ! a server whose proxy already checks. A server reached by several names, or
    ! by a pattern, is a case to add here.
  //]
  section Host
    union Policy = Loopback | Named(name: String) | Unchecked
  end

  //[ Whether a browser on another site may send a write
    !
    ! `Refuse` answers 403 to a POST, PUT or DELETE a browser marks as
    ! cross-site, which is CSRF protection with no token to thread through
    ! forms. Clients that are not browsers send neither header it reads, so an
    ! API client or a webhook still gets through.
  //]
  section CrossSite
    union Policy = Refuse | Allow
  end

  //[ Whether the `Host` this request carries is one `policy` answers to. //]
  private[server] def hostAllowed(environ: py.Dynamic, policy: Host.Policy): Bool =
    match policy
    case Host.Unchecked   => true
    case Host.Loopback    => Request.nameIn(environ, ["localhost", "127.0.0.1", "::1"])
    case Host.Named(name) => Request.nameIn(environ, [py.dynamic(name).lower().asString])
end

//[ Building the answer: the refusals, and what a route's own answer becomes. //]
private section Answer
  //[ Run `handler` with the request bound. //]
  def ran(handler: (() => Response receives request), method: Verb.Method, path: String, environ: py.Dynamic): Response =
    with request = new Request(method, path, environ) in handler()

  //[ A refusal made before a request is bound. //]
  def refuse(status: Status.Code, message: String): Response =
    Response.complete(status, Mime.Text, message)

  //[ The 501 for a HEAD, which must not carry a body
    !
    ! Waitress writes whatever body it is handed, even for a HEAD, and frames an
    ! empty one as chunked, and either leaves bytes a client keeping the
    ! connection open reads as its next response. A declared length of 0 is what
    ! makes both servers send the headers alone.
  //]
  def unsupportedHead(): Response =
    Complete(Status.NotImplemented, [Header("Content-Length", "0")], py.dynamic("").encode())

end
