namespace harpe.server

import harpe.server.Http
import harpe.server.Http.Verb
import harpe.server.request
import harpe.server.Response

//[ The routes an application answers, declared as a table.
  !
  ! A table rather than a chain of patterns, so the policy of a route sits with
  ! the route and `Application` can read it before the handler runs — which is
  ! what makes a body limit per route possible at all.
  !
  ! Paths are compared exactly. `Prefix` is for the one path that carries a parameter in a single-page application, an asset under a directory, and the handler reads `request.path` for the rest.
//]
section Router
  //[ One route. `maxBodyBytes` of 0 takes the application's own limit. //]
  class Route(
        method: Verb.Method,
        path: String,
        prefix: Bool,
        maxBodyBytes: Int,
        handler: () => Response receives request)

  def Get(
      path: String,
      handler: (() => Response receives request),
      maxBodyBytes: Int = 0): Route =
    new Route(Verb.Get, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

  def Post(
      path: String,
      handler: (() => Response receives request),
      maxBodyBytes: Int = 0): Route =
    new Route(Verb.Post, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

  def Put(
      path: String,
      handler: (() => Response receives request),
      maxBodyBytes: Int = 0): Route =
    new Route(Verb.Put, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

  def Delete(
      path: String,
      handler: (() => Response receives request),
      maxBodyBytes: Int = 0): Route =
    new Route(Verb.Delete, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

  //[ Everything under `path`, which must end in `/` — the assets of a page
    !
    ! The handler reads `request.path` for the rest. The longest matching
    ! prefix wins, so `/assets/img/` can sit under `/assets/`.
  //]
  def Prefix(
      path: String,
      handler: (() => Response receives request),
      method: Verb.Method = Verb.Get,
      maxBodyBytes: Int = 0): Route =
    if !path.endsWith("/") then abort "a prefix route's path must end in '/': '\{path}'"
    new Route(method, path, prefix = true, maxBodyBytes = maxBodyBytes, handler = handler)

  //[ The exact routes by "VERB path", for an `Application` to dispatch through
    !
    ! Two routes claiming one verb and path abort here, which is when the
    ! `Application` holding them is built.
  //]
  private[server] def indexed(routes: List[Route]): py.Dict =
    val exact = py.dict()
    for route in routes do
      if !route.prefix then
        val key = Http.verbName(route.method) + " " + route.path
        if exact.contains(key) then abort "two routes claim '\{key}'"
        exact.set(key, route)
    exact
end
