namespace harpe.server

import harpe.server.Http
import harpe.server.Http.Verb
import harpe.server.request
import harpe.server.Response

//[ One route. `maxReqBody` is the largest body it accepts, 0 for none at all. //]
class Route(
  method: Verb.Method,
  path: String,
  prefix: Bool,
  maxReqBody: Int,
  handler: () => Response receives request)

//[ A path segment in a compiled route: a literal string, a named parameter capture, or a wildcard. //]
private union Seg = Lit(s: String) | Param(name: String) | Wild
  def toString(): String =
    match this
    case Lit(s) => s
    case Param(n) => n
    case Wild => "*"
  def compareTo(that: Seg): Int =
    this.toString().compareTo(that.toString)
end

//[ A node in the routing trie.
  !
  ! `insert` and `match` operate on the node directly and recurse into children,
  ! so calling them on the root node traverses the whole trie.
//]
private class RouteNode(segs: Map[Seg, RouteNode], exact: Map[Verb.Method, Route])
  //[ Return a new node with `route` inserted at `pathSegs`; aborts on conflict. //]
  def insert(pathSegs: List[Seg], route: Route): RouteNode =
    match pathSegs
    case [] =>
      match exact.getOpt(route.method)
      case Some(_) => abort "two routes claim '\{Http.verbName(route.method)} \{route.path}'"
      case None    => new RouteNode(segs, exact.add(route.method, route))
    case [head, ..tail] =>
      if head is Param(name) then
        for key in segs.keys() if key is Param(existing) && existing != name do
          abort "two param routes at the same position have different names: '\{existing}' vs '\{name}'"
      val child = segs.getOrElse(head, new RouteNode(Map.empty, Map.empty))
      new RouteNode(segs.add(head, child.insert(tail, route)), exact)

  //[ Match request path segments against this trie, returning per-verb results.
    !
    ! Returns a map of every verb that claims this path to its matched route and
    ! captured params. The caller picks the requested verb's entry for dispatch,
    ! and collects the remaining keys for a 405 Allow header when none is found.
    !
    ! Wild children are explored first (lowest priority), then param children,
    ! then literal children, so more specific matches overwrite less specific ones.
  //]
  def find(path: String): Map[Verb.Method, Route ~ Map[String, String]] =
    val segs = path.split("/").exclude(s => s == "")
    matchWith(segs, Map.empty())

  private def matchWith(
      pathSegs: List[String],
      accParams: Map[String, String]): Map[Verb.Method, Route ~ Map[String, String]] =
    var result = Map.empty[Verb.Method, Route ~ Map[String, String]]
    // wildcard child matches any remaining depth (lowest priority, written first)
    match segs.getOpt(Wild)
    case Some(wildChild) =>
      for verb ~ route in wildChild.exact do
        result = result.add(verb, route ~ accParams)
    case None => pass

    if pathSegs.size == 0 then
      for verb ~ route in exact do
        result = result.add(verb, route ~ accParams)
      return result

    val head = pathSegs.get(0)
    val tail = pathSegs.drop(1)
    // param child (overwrites wildcard)
    for key ~ child in segs do
      match key
      case Param(name) =>
        for verb ~ m in child.matchWith(tail, accParams.add(name, head)) do
          result = result.add(verb, m)
      case _ => pass

    // literal child (overwrites param)
    match segs.getOpt(Lit(head))
    case Some(child) =>
      for verb ~ m in child.matchWith(tail, accParams) do
        result = result.add(verb, m)
    case None => pass
    result
end

//[ The routes an application answers, declared as a table.
  !
  ! Paths are compared exactly. A segment starting with `:` is a named
  ! parameter capture. `Prefix` matches any path starting with its argument,
  ! for a single-page application or an asset directory.
//]
section Route
  //[ The body limit a route takes when it names none. //]
  def defaultMaxReqBody: Int = 1048576

  //[ A route answering GET at `path`, exactly or with named captures
    !
    ! A segment starting with `:` is a named parameter: `"/users/:id"` matches
    ! `/users/42` and makes `request.getParam("id")` return `Some("42")`. A
    ! route with no captures matches exactly.
  //]
  def Get(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if path.contains("*") then abort "route path must not contain '*': '\{path}'"
    new Route(Verb.Get, path, prefix = false, maxReqBody = maxReqBody, handler = handler)

  //[ A route answering POST at `path`, exactly or with named captures. //]
  def Post(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if path.contains("*") then abort "route path must not contain '*': '\{path}'"
    new Route(Verb.Post, path, prefix = false, maxReqBody = maxReqBody, handler = handler)

  //[ A route answering PUT at `path`, exactly or with named captures. //]
  def Put(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if path.contains("*") then abort "route path must not contain '*': '\{path}'"
    new Route(Verb.Put, path, prefix = false, maxReqBody = maxReqBody, handler = handler)

  //[ A route answering DELETE at `path`, exactly or with named captures. //]
  def Delete(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if path.contains("*") then abort "route path must not contain '*': '\{path}'"
    new Route(Verb.Delete, path, prefix = false, maxReqBody = maxReqBody, handler = handler)

  //[ A route answering OPTIONS at `path`
    !
    ! What answers a CORS preflight, which harpe sends no header of its own
    ! for: the `Access-Control-Allow-*` a browser needs are this handler's to
    ! send, since which origins may call is the application's to decide.
  //]
  def Options(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if path.contains("*") then abort "route path must not contain '*': '\{path}'"
    new Route(Verb.Options, path, prefix = false, maxReqBody = maxReqBody, handler = handler)

  //[ A route answering GET at any path starting with `path`
    !
    ! `path` must end in `/`. The handler reads `request.path` for the full
    ! path. Use for a single-page application and for `Route.assets`.
  //]
  def Prefix(
      path: String,
      handler: (() => Response receives request),
      maxReqBody: Int = defaultMaxReqBody): Route =
    if !path.endsWith("/") then abort "a prefix route's path must end in '/': '\{path}'"
    new Route(Verb.Get, path, prefix = true, maxReqBody = maxReqBody, handler = handler)

  //[ The files under `root`, served at `prefix` — the proxy's job, for development
    !
    ! A deployment's assets are nginx's or Apache's to serve. This gives a
    ! prototype, and a single container running without one, the same
    ! behavior: `prefix` must end in `/`, the rest of the path names the file,
    ! and a path ending in `/` asks for the `index.html` beside it.
    !
    ! `Response.static` resolves the name, so one leaving `root` is a 404. GET
    ! only, and no body at all, so a request carrying one is refused 413. It
    ! names no cache rule and sends `no-store`, since what a deployment caches
    ! is the proxy's to decide.
  //]
  def assets(prefix: String, root: String): Route =
    if !prefix.endsWith("/") then abort "an assets route's prefix must end in '/': '\{prefix}'"
    val dir = prefix
    Prefix:
      prefix
      () =>
        val tail = request.path.substring(dir.size, request.path.size - dir.size)
        Response.static(root, named(tail))
      maxReqBody = 0

  //[ The file a URL tail names, which for one ending in `/` is the index beside it. //]
  private def named(tail: String): String =
    if tail == "" || tail.endsWith("/") then tail + "index.html" else tail

  //[ The routing trie compiled from `routes`, built when the `WebApp` is constructed.
    !
    ! Two routes claiming one verb and path abort here. Two param routes whose
    ! patterns cover the same set of paths — detected when their param child
    ! positions collide in the trie — also abort.
  //]
  private[server] def compile(routes: List[Route]): RouteNode =
    var root = new RouteNode(Map.empty, Map.empty)
    for route in routes do
      val pathSegs = if route.prefix then segsOf(route.path) + Wild else segsOf(route.path)
      root = root.insert(pathSegs, route)
    root

  //[ Convert a route path string into a typed segment list.
    !
    ! Segments starting with `:` become `Param` captures; all others are
    ! literal strings. Used only at construction time.
  //]
  private[server] def segsOf(path: String): List[Seg] =
    var result: List[Seg] = List.empty()
    for s in path.split("/").exclude(s => s == "") do
      if s.startsWith(":") then
        result = result + Param(name = s.substring(1, s.size - 1))
      else
        result = result + Lit(s)
    result
