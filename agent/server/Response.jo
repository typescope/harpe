namespace harpe.server

import harpe.ffi.json as JSON
import harpe.ffi.os
import harpe.util.File
import harpe.util.Clock
import harpe.server.Http
import harpe.server.Http.Header
import harpe.server.Util
import harpe.server.Http.Status
import harpe.server.Http.Mime
import harpe.server.request

//[ What a route answers with: a value, so a route can be called and its answer
  ! inspected without a server, and a wrapper can add to what it answers.
  ! `WebApp` adds the `nosniff` and framing headers every response carries.
  !
  ! `Complete` carries every header it sends, and the builders in `Response`
  ! fill in `Content-Type` and `Cache-Control`. `OnDisk` names a file the
  ! server reads a block at a time, so its size is not its cost in memory.
  !
  ! Every response is whole: nothing here holds a connection open while it
  ! produces. A page that follows work in progress polls a cursor instead,
  ! which `harpe.observability.Viewer` shows.
//]
union Response =
    Complete(status: Status.Code, headers: List[Header], body: py.Dynamic)
  | OnDisk(status: Status.Code, headers: List[Header], path: String, length: Int)

//[ The builders a route answers with. Import `harpe.server.Response` and write `Response.html(…)`. //]
section Response
  //[ The empty list a builder's `headers` defaults to. //]
  def NoHeaders: List[Header] = []

  //[ A complete response from a text body, encoded as UTF-8
    !
    ! Sends `Cache-Control: no-store` unless `headers` names one of its own,
    ! and sends `headers` after `Content-Type` and `Cache-Control`.
  //]
  def complete(status: Status.Code, kind: Mime.Type, body: String, headers: List[Header] = NoHeaders): Response =
    binary(status, kind, py.dynamic(body).encode(), headers)

  //[ A complete response from a binary body, with the same headers as `complete`
    !
    ! A 304 sends no `Cache-Control`, leaving the rule the client already
    ! holds for the copy it is being told to keep.
  //]
  def binary(status: Status.Code, kind: Mime.Type, body: py.Dynamic, headers: List[Header] = NoHeaders): Response =
    Complete(status, headersFor(status, kind, headers), body)

  def html(body: String, headers: List[Header] = NoHeaders): Response =
    complete(Status.Success, Mime.Html, body, headers)

  //[ `status` for the 201 a creating route answers, `headers` for a cookie riding along. //]
  def json(dict: py.Dict, status: Status.Code = Status.Success, headers: List[Header] = NoHeaders): Response =
    complete(status, Mime.Json, JSON.dumps(dict), headers)

  //[ A `Set-Cookie` header, to pass in a response's `headers`
    !
    ! Always `Path=/`, `HttpOnly` and `SameSite=Lax`, so no script can read the
    ! cookie and no cross-site POST carries it. `secure` adds `Secure`, which
    ! browsers accept on `http://localhost` too, so `secure = false` is for
    ! plain HTTP on any other host. A `maxAgeSeconds` of 0 deletes the cookie,
    ! which is what logging out sends. A name or value that would need quoting
    ! aborts.
  //]
  def cookie(name: String, value: String, maxAgeSeconds: Int, secure: Bool = true): Header =
    if !Util.cookieSafe(name) || name == "" then abort "cookie name '\{name}' is not a token"
    if !Util.cookieSafe(value) then abort "cookie value for '\{name}' needs encoding"

    val attributes = "; Path=/; Max-Age=\{maxAgeSeconds}; HttpOnly; SameSite=Lax"
    Header("Set-Cookie", name + "=" + value + attributes + (if secure then "; Secure" else ""))

  //[ A `Set-Cookie` whose value a client can neither forge nor alter
    !
    ! `Request.signedCookie` reads it back, and answers None when anything
    ! changed it or its expiry has passed. The value is signed, not encrypted,
    ! and rides on every request, so keep it small and keep secrets out of it.
    ! The attributes are `cookie`'s, and `maxAgeSeconds` sets both the browser's
    ! `Max-Age` and the expiry inside the signature. The secret is the
    ! application's, and must be at least 32 characters.
  //]
  def signedCookie(name: String, value: String, secret: String, maxAgeSeconds: Int, secure: Bool = true): Header =
    val encoded = py.module("base64").urlsafe_b64encode(py.dynamic(value).encode()).decode().asString.replace("=", "")
    val expiry = (Clock.now().toInt + maxAgeSeconds).toString
    val signed = encoded + "." + expiry + "." + Util.signCookie(name, encoded, expiry, secret)
    cookie(name, signed, maxAgeSeconds, secure)

  //[ A 303 to `location`, the redirect a browser follows with a GET after a form post. //]
  def redirect(location: String, headers: List[Header] = NoHeaders): Response =
    complete(Status.SeeOther, Mime.Text, "", [Header("Location", location)] ++ headers)

  //[ A 404 whose body is `{"error": "not_found"}`. //]
  def notFound(): Response =
    complete(Status.NotFound, Mime.Json, JSON.dumps(py.dict("error" ~ "not_found")))

  //[ A 400 naming what was wrong, short enough to sit on the right of a `rescue`:
    !
    !     val body = Http.readJson() rescue None => return Response.badRequest("expected a JSON object")
  //]
  def badRequest(detail: String): Response =
    complete(Status.BadRequest, Mime.Json, JSON.dumps(py.dict("error" ~ "bad_request", "detail" ~ detail)))

  //[ The file under `root` that `name` names, shown in the browser
    !
    ! `name` is a relative path, as a client sent it. A name that is empty,
    ! absolute, has a `..` segment, or resolves outside `root` through a
    ! symlink is a 404, and so is a directory or a missing file, and a client
    ! cannot tell which. The type is guessed from the name.
    !
    ! The browser renders what it can — a page, an image, a PDF — in this
    ! application's origin, so answer with `download` for a file a user
    ! uploaded.
    !
    ! The file is read a block at a time, so its size is not its cost in
    ! memory, and it is opened when the response is written rather than here:
    ! one deleted in between makes the server answer 500.
    !
    ! Sends `Cache-Control: no-store` unless `headers` names one of its own,
    ! and sends `headers` after `Content-Disposition`.
  //]
  def file(root: String, name: String, headers: List[Header] = NoHeaders): Response =
    stored(root, name, Inline, headers)

  //[ The same as `file`, except the browser saves it rather than showing it. //]
  def download(root: String, name: String, headers: List[Header] = NoHeaders): Response =
    stored(root, name, Attachment, headers)

  //[ Whether a browser shows a file or saves it. //]
  private union Disposition = Inline | Attachment

  //[ The response `file` and `download` share, which differ only in `Content-Disposition`. //]
  private def stored(root: String, name: String, disposition: Disposition, headers: List[Header]): Response =
    val target = resolve(root, name) rescue None => return notFound()
    val shown = Header("Content-Disposition", dispositionValue(disposition, os.path.basename(name)))
    OnDisk:
      Status.Success
      headersFor(Status.Success, fileType(target), [shown] ++ headers)
      target
      os.path.getsize(target)

  //[ The headers every builder sends: the type, the caching rule, then the caller's own. //]
  private def headersFor(status: Status.Code, kind: Mime.Type, headers: List[Header]): List[Header] =
    val stated = status is Status.NotModified || headerIn(headers, "Cache-Control") is !None
    val rule = if stated then [] else [Header("Cache-Control", "no-store")]
    [Header("Content-Type", Mime.value(kind))] ++ rule ++ headers

  //[ The type a file's name implies, `application/octet-stream` when it implies none. //]
  private def fileType(path: String): Mime.Type =
    Mime.parse(File.mimeType(path).getOrElse("application/octet-stream"))

  //[ The real path of `name` under `root`, or None when it is not a file inside it. //]
  private def resolve(root: String, name: String): Option[String] =
    val refused = name == "" || name.startsWith("/") || name.contains("\\") || name.contains("\u{0}")
    if refused || name.split("/").contains("..") then return None

    val base = os.path.realpath(root)
    val target = os.path.realpath(os.path.join(base, name))
    if target.startsWith(base + "/") && os.path.isfile(target) then Some(target) else None

  //[ `inline` or `attachment`, naming the file both as ASCII and, per RFC 6266, as UTF-8. //]
  private def dispositionValue(disposition: Disposition, filename: String): String =
    val kind = match disposition
               case Inline     => "inline"
               case Attachment => "attachment"
    val ascii = py.module("re").sub("[^ -~]|[\"\\\\]", "_", filename).asString
    val encoded = py.module("urllib.parse").quote(filename, safe = "").asString
    kind + "; filename=\"" + ascii + "\"; filename*=UTF-8''" + encoded

  //[ The first header by this name, compared case-insensitively. //]
  private[server] def headerIn(headers: List[Header], name: String): Option[String] =
    val wanted = py.dynamic(name).lower().asString
    for h in headers do
      if py.dynamic(h.name).lower().asString == wanted then return Some(h.value)
    None

end
