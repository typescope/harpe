//[ Viewer.jo
  !
  ! A live view of a running agent's journal, in a browser.
  !
  ! MECHANISM, NOT A DRIVER. One route over a `ViewLogger` the driver logs to.
  ! Whether to expose it at all, on which port, behind which path, and to whom,
  ! is the driver's decision: an agent that serves HTTP adds it to the server it
  ! already has, and one that does not can take `start` below.
  !
  !     val viewLog = new ViewLogger(capacity = 5000)
  !     val log     = new TeeLogger([new JsonlLogger(path), viewLog])
  !
  !     case Request.Get("/journal") => Viewer.respond(viewLog, title)
  !
  ! ONE ROUTE, because the protocol is nobody else's business. The page polls
  ! the path it was served from, so the `seen` cursor, the envelope it comes
  ! back in and the content types stay between the page and this file. A driver
  ! chooses where the viewer lives and nothing else.
  !
  ! Reading the LOGGER, not a file, is what makes it live: an entry is visible
  ! the moment it is logged, with no flush, no second process, and no path to
  ! agree on. A journal that outlives the process is a `jq` job over whatever
  ! durable backend the driver teed it with.
  !
  ! HOW MANY CONVERSATIONS A TAIL HOLDS IS NOT THIS FILE'S BUSINESS. GROUPING IS
  ! STRUCTURAL: a record's `context` IS its path from the root, outermost first,
  ! and the page shows lanes that are path PREFIXES. A
  ! driver serving concurrent sessions may tee them all into one and narrow
  ! to whichever it wants; one that would rather serve a session at a time gives
  ! each its own `ViewLogger`. Both are the same one function, and neither needs
  ! this file to know what a session, a turn or a tool call is.
  !
  ! Polling, not streaming: the page asks for everything after the position it
  ! last saw. A poll costs a list slice, and a reader that reconnects, or that
  ! was never there for the first turn, is the same code path as one that has
  ! kept up.
  !
  ! The page is ONE self-contained response — `agent/assets/journal.{html,css,js}`
  ! bundled with the `harpe` module and inlined at serve time. The three stay
  ! separate files to edit, and a driver mounting the viewer under a path of its
  ! choosing has no stylesheet or script URL to route.
//]

namespace harpe.observability

import harpe.ffi.json
import harpe.logging.Entry
import harpe.server.Http
import harpe.server.Application
import harpe.server.Serve
import harpe.server.Request
import harpe.server.request
import harpe.server.Response
import jo.resource.*
import jo.py.resource.*

section Viewer

  //[ The viewer, at whatever path the driver routed here.
    !
    ! The page, or — for the same path carrying the page's `seen` cursor — the
    ! entries after it. One route rather than two: the page polls where it came
    ! from, so a driver never sees the cursor or the envelope.
    !
    ! `title` names what this page is showing — an agent, a deployment, one
    ! session — and is the driver's to choose.
  //]
  def respond(viewLog: ViewLogger, title: String): Response receives request =
    match Request.query("seen")
    case None => Response.html(page(title))
    case Some(asked) =>
      val seen = Int.parse(asked) rescue None => 0
      Response.complete(Http.Status.Success, Http.Mime.Json, events(viewLog, seen))

  private def page(title: String): String =
    val bundle = new py.resource.ResourceBundle("harpe")

    asset(bundle, "journal.html")
      .replace("__NAME__", title)
      .replace("__STYLE__", asset(bundle, "journal.css"))
      .replace("__SCRIPT__", asset(bundle, "journal.js"))

  //[ Everything `viewLog` has logged after `seen`, as the page's JSON envelope. //]
  private def events(viewLog: ViewLogger, seen: Int): String =
    val window = viewLog.since(seen)

    val entries = py.list()
    for entry in window.entries do entries.append(Entry.toDict(entry))

    json.dumps(py.dict("seen" ~ window.logged, "dropped" ~ window.dropped, "entries" ~ entries))

  //[ Serve the viewer alone on `host:port`, on a daemon thread.
    !
    ! For a driver with no HTTP server of its own. It binds before returning, so
    ! a port already taken raises here rather than leaving a banner pointing at
    ! a server that never came up. The thread is a daemon and the caller prints
    ! its own banner, so there is nothing to hand back. NO AUTHENTICATION: a
    ! journal holds every conversation it was given, so `host` belongs on a
    ! loopback address, and `answersTo` names what a browser may call it there.
    !
    ! Quiet, because the page polls: an access log here is a line a second in
    ! whatever terminal the driver was already using.
  //]
  def start(viewLog: ViewLogger, title: String, host: String, port: Int, answersTo: Application.Host.Policy): Unit =
    val application = new Application:
      host = answersTo
      routes = []
      fallback = () => route(viewLog, title)
      maxBodyBytes = 0

    val _ = Serve.inBackground(host, port, application)

  private def route(viewLog: ViewLogger, title: String): Response receives request =
    match request
    case Request.Get("/") => respond(viewLog, title)
    case _             => Response.notFound()

  //[ One bundled asset, or a comment saying which one is missing. //]
  private def asset(bundle: py.resource.ResourceBundle, rel: String): String =
    match bundle.readText("assets/" + rel)
    case Ok(text) => text
    case Err(why) => "/* " + rel + " missing: " + why + " */"
end
