//[ Agent.jo
  !
  ! `Agent` — the bundle that constitutes an agent, and the turn engine that
  ! drives it. An agent is: a **brain** (the model), its **capabilities** (the
  ! tools, including the memory tools), its **context** (system prompt + memory +
  ! transcript policy — see `harpe.context`), and its **turn policy** (the
  ! tool-round budget).
  !
  ! What is deliberately NOT the agent: session storage layout, locks, and
  ! presentation (spinners, streams, chat actions) — those belong to the drivers.
  ! The engine emits lifecycle/transcript entries through the ordinary logger
  ! channel, but knows nothing about their destination.
//]

namespace harpe

import harpe.turns.*
import harpe.logging.logger
import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*

//[ An simple agent: what thinks, what it can do, what it sees, and its turn policy.
  !
  ! If the user wants customization, just create a different agent class. There
  ! is no need to inherit this class. In fact, Jo does not support inheritance.
  !
  ! To reuse the turn logic in a custom agent class, call `Agent.runTurn`
  ! directly.
//]
class Agent(brain: Model, tools: List[Tool], context: Context)
  def runTurn(
      userMsg: Message, handlers: Map[String, Handler],
      maxToolRounds: Int, maxRetries: Int)
  : TurnData receives logger, interact =
    Agent.runTurn:
      userMsg
      brain
      tools
      handlers
      context
      maxToolRounds
      maxRetries
end

section Agent
  //[ Drive one user turn
    !
    ! Call the model (with retries), run any tool calls it requests, and repeat
    ! until it replies with plain text.
    !
    ! The `context` owns the transcript: the engine appends each assistant reply
    ! and tool-result batch to it, and asks it to compose `(system, messages)`
    ! before every model request. The caller appends the turn's `UserText` (after
    ! `context.mark()`) before calling. Structured transcript events use the
    ! ambient logger.
    ! On interruption/failure the provisional assistant/tool tail is rolled back,
    ! while the user's message remains in the context.
    !
    ! A turn is bounded to `maxToolRounds` tool-call rounds. Once spent the model
    ! is asked once more with no tools, forcing a final answer. `maxRetries` is
    ! transport policy — how often a transient model error is retried — so it is
    ! an argument, not part of the agent.
    !
    ! `tools` are the specs the model is offered. `handlers` is what actually
    ! runs, wired by tool name for THIS turn, so a handler closes over the
    ! turn's interaction and the driver's own typed context. Every spec must
    ! have a route: an unrouted name is a wiring bug and aborts before the model
    ! is called, rather than surfacing mid-turn as a tool failure.
  //]
  def runTurn(
      userMsg: Message, brain: Model, tools: List[Tool], handlers: Map[String, Handler],
      context: Context, maxToolRounds: Int, maxRetries: Int)
  : TurnData receives logger, interact =

    for t in tools do
      if !handlers.contains(t.name) then
        abort "no handler is wired for the tool '\{t.name}'"

    var rounds = 0
    var result: TurnResult = Failed("")

    // The turn's own traffic, accumulated as it is appended to the context, so the
    // finished turn is a value the caller can render without re-reading the journal.
    var produced: List[Message] = []

    context.mark()
    context.append(userMsg)
    Transcript.start(userMsg)

    // Compose what the model sees ONCE, at the turn's start. The Session then
    // owns the intra-turn tail. The engine feeds it tool results and never
    // re-renders.
    val rendered = context.render(interact)
    val session = brain.startTurn(rendered)

    // Tool results to hand the model on the next round ([] for the first request).
    var pending: List[ToolResult] = []

    while true do
      if interact.cancelled then
        result = Interrupted
        context.rollback()
        context.append(userMsg)
        Transcript.interrupted()
        break

      // Once the tool budget is spent, offer no tools so the model must reply with
      // a final text answer rather than calling another tool.
      val offer: List[Tool] = if rounds >= maxToolRounds then [] else tools

      if rounds == maxToolRounds then
        interact.emit: ToolBudgetReached(maxToolRounds)

      match fetchReply(session, pending, offer, maxRetries, interact)
        case Stopped =>
          result = Interrupted
          context.rollback()
          context.append(userMsg)
          Transcript.interrupted()
          break

        case GaveUp(detail) =>
          result = Failed(detail)
          context.rollback()
          context.append(userMsg)
          Transcript.failed(detail)
          break

        case Got(reply, usage) =>
          context.observe(usage)
          context.append(reply)
          produced = produced + reply
          Transcript.append(reply)

          if reply.calls.isEmpty then
            result = Success
            Transcript.commit()
            break

          if reply.text.trim != "" then
            interact.emit: AssistantMessage(reply.text.trim)

          var toolResults: List[ToolResult] = []
          var cancelled = false

          for call in reply.calls do
            if interact.cancelled then
              cancelled = true
              break

            val toolName = call.name
            interact.emit: ToolCallStarted(toolName)

            val outcome =
              if handlers.contains(toolName) then
                runSafely(toolName, handlers[toolName], call.input)
              else
                RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}", attachments = [])

            interact.emit: ToolCallEnded(toolName, outcome.summary)

            toolResults = toolResults + ToolResult(call.id, outcome.result, outcome.attachments)
          end

          if cancelled || interact.cancelled then
            context.rollback()
            context.append(userMsg)
            result = Interrupted
            Transcript.interrupted()
            break

          else
            val results = ToolResults(toolResults)
            context.append(results)
            produced = produced + results
            Transcript.append(results)
            pending = toolResults
            rounds = rounds + 1
    end // while

    // A rolled-back turn contributes nothing to history, and `Transcript.turns`
    // replays it with no messages — so drop them here too, and the live value and
    // the reloaded one agree.
    if result is Success then TurnData(userMsg, produced, result)
    else TurnData(userMsg, [], result)
end

//[ The result of fetching one model reply (after any retries)
  !
  ! The assistant message, a give-up (fatal error or retries exhausted), or an interruption.
//]
private union Fetched =
    Got(message: Assistant, usage: Usage)
  | GaveUp(detail: String)
  | Stopped

//[ Exponential backoff between retries: 1s, 2s, 4s, … capped at 30s.  //]
private def backoffSeconds(attempt: Int): Float =
  var d = 1.0
  var i = 1
  while i < attempt do
    d = d * 2.0
    i = i + 1

  if d > 30.0 then 30.0 else d

//[ Ask the model for one reply
  !
  ! Retry transient errors with exponential backoff up to `maxRetries`.
  !
  ! A `None` from `ask` (a cancelled request), or interrupt firing during a
  ! backoff wait, ends the attempt.
  !
  ! Progress is reported through `interact.emit`. A terminal error is returned as
  ! `Failed(detail)`.
//]
private def fetchReply(
    session: Session, results: List[ToolResult], tools: List[Tool],
    maxRetries: Int, interact: Interact)
: Fetched receives logger =

  var attempt = 0
  var outcome: Fetched = GaveUp("")

  while true do
    if interact.cancelled then
      outcome = Stopped
      break

    interact.emit: ModelRequestStarted(attempt, maxRetries)

    // `reply` is idempotent — the Session commits `results` only on success, so
    // every attempt (including retries) passes the same `results`.
    val res = session.reply(results, tools)

    interact.emit: ModelRequestEnded

    if interact.cancelled then
      outcome = Stopped
      break

    match res
      case Reply(message, usage) =>
        outcome = Got(message, usage)
        break

      case Fatal(detail) =>
        logger.error("harpe.model.request", detail)
        outcome = GaveUp(detail)
        break

      case Transient(detail) =>
        attempt = attempt + 1
        if attempt > maxRetries then
          logger.error("harpe.model.request", detail, "retries" ~ maxRetries)
          outcome = GaveUp(detail)
          break

        else
          val delay = backoffSeconds(attempt)
          logger.warn("harpe.model.request", detail, "attempt" ~ attempt, "retryInSeconds" ~ delay)
          interact.emit: TransientError(detail, delay)
          // pause returns true if cancellation fired during the backoff.
          if interact.pause(delay) then
            outcome = Stopped
            break
  end // while

  outcome
