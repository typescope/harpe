//[ Agent.jo
  !
  ! The turn engine. `Agent` is a namespace, not a thing — an agent is not one
  ! component but the way a model, its tools, and its context are coordinated
  ! for a turn, so there is nothing here to instantiate. `ask` takes each of
  ! those as an ordinary parameter with a default, which is what lets the
  ! plainest agent be `Agent.ask("hello")` inside an explicit logging scope,
  ! while a driver writes the same call with its own components supplied.
  ! Drawing a boundary around any subset
  ! of them and calling *that* the agent would be a choice the code cannot
  ! justify.
  !
  ! What is deliberately NOT here: session storage layout, locks, and
  ! presentation (spinners, streams, chat actions) — those belong to the drivers.
  ! The engine emits lifecycle/transcript entries through the ordinary logger
  ! channel, but knows nothing about their destination.
//]

namespace harpe

import harpe.turns.*
import harpe.ffi.os
import harpe.util.File
import harpe.logging.logger
import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*

section Agent
  //[ No files sent with the question — the default for `ask`'s `attachments`. //]
  private def NoAttachments: List[String] = []

  //[ Ask once: drive one user turn and return everything it produced
    !
    ! Call the model (with retries), run any tool calls it requests, and repeat
    ! until it replies with plain text.
    !
    ! Every input is a parameter with a default, so a turn is whatever the
    ! caller says it is and no subset of these is privileged as "the agent":
    !
    !     with logger = Logging.discard in
    !       Agent.ask("hello")
    !
    ! answers with a bare model and nothing else, while a driver passes its own
    ! brain, tools, and context.
    !
    ! `attachments` are paths to files the model should SEE — an image, a PDF —
    ! sent as real content blocks where the provider takes them, and named in the
    ! text manifest either way. Their metadata is read off disk, so a caller
    ! never hand-writes a name, size, or mime type. A file the model should
    ! merely know about does not belong here: name it in `message` and let the
    ! model read it with `fs`, which is what a driver minding its token bill
    ! does with uploads.
    !
    ! `context` and `transcript` both see every message, and are deliberately
    ! separate. The context composes `(system, messages)` for the model and is
    ! rolled back when a turn fails. The transcript records what was said and is
    ! append-only, closing a failed turn with a terminator rather than erasing
    ! it. Keeping them apart is what lets one conversation be replayed under a
    ! different window or summarizer. On interruption/failure the provisional
    ! assistant/tool tail is rolled back, while the user's message remains in the
    ! context. Defaulted, it is a `Context.noHistory` built fresh for this call
    ! — the model still sees this turn, and nothing survives into the next one.
    ! A session that should remember keeps one context alive across turns.
    !
    ! A turn is bounded to `maxToolRounds` tool-call rounds. Once spent the model
    ! is asked once more with no tools, forcing a final answer. `maxRetries` is
    ! transport policy — how often a transient model error is retried.
    !
    ! `maxOutputTokens` bounds each individual reply, and is the one budget here
    ! the engine cannot enforce itself: it is handed to the `Model` at
    ! `startTurn` and honoured by the provider. It sits with the other two
    ! because all three answer "how much may this turn spend", and a caller
    ! should not have to build a second `Model` to change one of them.
    !
    ! `tools` is both halves at once: the specs the model is offered and the
    ! code that answers each call, wired together by name. A handler closes over
    ! whatever typed context the driver built it with — in practice one toolset
    ! per session, not per turn. There is no way to offer a tool nobody answers,
    ! so the engine has nothing to check here. (`Toolset` rejects the one
    ! mistake still possible, the same name wired twice, as it is built.) A name
    ! the model invents anyway comes back to it as an unknown tool.
  //]
  def ask(
      message: String,
      attachments: List[String] = NoAttachments,
      brain: Model = Model.default,
      tools: Toolset = Toolset.empty,
      interact: Interact = Interact.unattended,
      context: Context = Context.noHistory,
      transcript: Transcript = Transcript.NoTranscript,
      maxToolRounds: Int = 50,
      maxRetries: Int = 4,
      maxOutputTokens: Int = 8192)
  : TurnData receives logger =

    val input = UserInput(message, filesAt(attachments))
    var rounds = 0
    var result: TurnResult = TurnResult.Failed("")

    // The turn's own traffic, accumulated as it is appended to the context, so the
    // finished turn is a value the caller can render without re-reading the journal.
    var produced: List[Message] = []

    context.beginTurn(input)
    transcript.start(input)

    // Compact at the turn boundary if the previous request crossed the strategy's
    // threshold, then seed a provider session from one immutable snapshot.
    val prepared = context.compact(interact)
    var session = brain.startTurn(prepared.rendered, maxOutputTokens)

    // Tool results to hand the model on the next round ([] for the first request).
    var pending: List[ToolResult] = []

    while true do
      if interact.cancelled then
        result = TurnResult.Interrupted
        context.abortTurn()
        transcript.interrupted()
        break

      // Once the tool budget is spent, offer no tools so the model must reply with
      // a final text answer rather than calling another tool.
      val offer: List[Tool] = if rounds >= maxToolRounds then [] else tools.specs

      if rounds == maxToolRounds then
        interact.emit: TurnEvent.ToolBudgetReached(maxToolRounds)

      match fetchReply(session, pending, offer, maxRetries, interact)
        case Stopped =>
          result = TurnResult.Interrupted
          context.abortTurn()
          transcript.interrupted()
          break

        case GaveUp(detail) =>
          result = TurnResult.Failed(detail)
          context.abortTurn()
          transcript.failed(detail)
          break

        case Got(reply, usage) =>
          context.observe(usage)
          context.append(reply)
          produced = produced + reply
          transcript.append(reply)

          if reply.calls.isEmpty then
            result = TurnResult.Success
            context.commitTurn()
            transcript.commit()
            break

          if reply.text.trim != "" then
            interact.emit: TurnEvent.AssistantMessage(reply.text.trim)

          var toolResults: List[ToolResult] = []
          var cancelled = false

          for call in reply.calls do
            if interact.cancelled then
              cancelled = true
              break

            val toolName = call.name
            interact.emit: TurnEvent.ToolCallStarted(toolName)

            val outcome =
              if tools.contains(toolName) then
                runSafely(toolName, tools.handler(toolName), call.input, interact)
              else
                RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}", attachments = [])

            interact.emit: TurnEvent.ToolCallEnded(toolName, outcome.summary)

            toolResults = toolResults + ToolResult(call.id, outcome.result, outcome.attachments, outcome.success)
          end

          if cancelled || interact.cancelled then
            context.abortTurn()
            result = TurnResult.Interrupted
            transcript.interrupted()
            break

          else
            val results = ToolResults(toolResults)
            context.append(results)
            produced = produced + results
            transcript.append(results)
            pending = toolResults
            rounds = rounds + 1

            // A compaction preserves the logical turn and its completed tool
            // effects, but replaces the provider-specific continuation state.
            val next = context.compact(interact)
            if next.compacted then
              session = brain.startTurn(next.rendered, maxOutputTokens)
              pending = []
    end // while

    // A rolled-back turn contributes nothing to history, and `Journal.records`
    // replays it with no messages — so drop them here too, and the live value and
    // the reloaded one agree.
    if result is TurnResult.Success then TurnData(input, produced, result)
    else TurnData(input, [], result)

  //[ `Attachment` metadata for each path
    !
    ! Everything an `Attachment` needs is derivable from a path on disk, so a
    ! caller naming a file never hand-writes its name, size, or mime type.
    !
    ! A path that is not a file aborts. Dropping it instead would answer the
    ! question against fewer files than were asked about, and say so nowhere.
  //]
  private def filesAt(paths: List[String]): List[Attachment] =
    var out: List[Attachment] = []

    for p in paths do
      val abs = os.path.abspath(p)
      if !os.path.isfile(abs) then
        abort "no such file: '\{p}'"

      val fileName = os.path.basename(abs)
      val mime = File.mimeType(fileName).getOrElse("application/octet-stream")
      out = out + Attachment(fileName, os.path.getsize(abs), mime, path = abs)

    out

  //[ The result of fetching one model reply (after any retries)
    !
    ! The assistant message, a give-up (fatal error or retries exhausted), or an interruption.
  //]
  private union Fetched =
      Got(message: Assistant, usage: Usage)
    | GaveUp(detail: String)
    | Stopped

  //[ Exponential backoff between retries: 1s, 2s, 4s, … capped at 30s.  //]
  private def backoffSeconds(attempt: Int): Float =
    var d = 1.0
    var i = 1
    while i < attempt do
      d = d * 2.0
      i = i + 1

    if d > 30.0 then 30.0 else d

  //[ Ask the model for one reply
    !
    ! Retry transient errors with exponential backoff up to `maxRetries`.
    !
    ! A `None` from `ask` (a cancelled request), or interrupt firing during a
    ! backoff wait, ends the attempt.
    !
    ! Progress is reported through `interact.emit`. A terminal error is returned as
    ! `Failed(detail)`.
  //]
  private def fetchReply(
      session: Session, results: List[ToolResult], tools: List[Tool],
      maxRetries: Int, interact: Interact)
  : Fetched receives logger =

    var attempt = 0
    var outcome: Fetched = GaveUp("")

    while true do
      if interact.cancelled then
        outcome = Stopped
        break

      interact.emit: TurnEvent.ModelRequestStarted(attempt, maxRetries)

      // `reply` is idempotent — the Session commits `results` only on success, so
      // every attempt (including retries) passes the same `results`.
      val res = session.reply(results, tools)

      interact.emit: TurnEvent.ModelRequestEnded

      if interact.cancelled then
        outcome = Stopped
        break

      match res
        case Reply(message, usage) =>
          outcome = Got(message, usage)
          break

        case Fatal(detail) =>
          logger.error("harpe.model.request", detail)
          outcome = GaveUp(detail)
          break

        case Transient(detail) =>
          attempt = attempt + 1
          if attempt > maxRetries then
            logger.error("harpe.model.request", detail, "retries" ~ maxRetries)
            outcome = GaveUp(detail)
            break

          else
            val delay = backoffSeconds(attempt)
            logger.warn("harpe.model.request", detail, "attempt" ~ attempt, "retryInSeconds" ~ delay)
            interact.emit: TurnEvent.TransientError(detail, delay)
            // pause returns true if cancellation fired during the backoff.
            if interact.pause(delay) then
              outcome = Stopped
              break

        case RetryAfter(detail, retryAfterSeconds) =>
          attempt = attempt + 1
          if attempt > maxRetries then
            logger.error("harpe.model.request", detail, "retries" ~ maxRetries)
            outcome = GaveUp(detail)
            break

          else
            val delay = retryAfterSeconds
            logger.warn("harpe.model.request", detail, "attempt" ~ attempt, "retryInSeconds" ~ delay)
            interact.emit: TurnEvent.TransientError(detail, delay)
            // pause returns true if cancellation fired during the backoff.
            if interact.pause(delay) then
              outcome = Stopped
              break
    end // while

    outcome
  end // fetchReply

end // agent
