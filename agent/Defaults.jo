//[ Defaults.jo
  !
  ! Convenient defaults for wiring an agent, shared by the cli/web/telegram
  ! drivers. These are plain functions, not hooks: an agent customizes itself by
  ! editing its own driver code, which delegates here for the common cases and
  ! diverges by simply writing code.
//]

namespace harpe
import harpe.ffi.sys
import harpe.ffi.file

import harpe.models.*
import harpe.tools.*
import harpe.ffi.os

section Defaults
  //[ The base toolset: `runCode`, the read-only skill tools over the agent's
    ! `skills/`, and `uploadMedia`. The per-session memory tools and any
    ! delivery tool needing driver-specific action (`sendFile`) are added by the
    ! drivers instead — `uploadMedia` belongs here because, unlike `sendFile`, it
    ! has no driver-specific step: it only needs `HARPE_DATA_DIR` (ambient
    ! `callContext`), and the render layer (`agent/models/Anthropic.jo`,
    ! `OpenAI.jo`) does the rest generically, the same way `runCode` and the
    ! skill tools need nothing driver-specific either.
    !
    ! Building tools needs no `logger`: a tool reads the ambient logging channel at
    ! call time, not build time (see `Tool.run`), so the driver installs the
    ! backend once with `Logging.withLogger` and tags each turn with
    ! `Logging.withContext`. `runCode`'s entries land wherever the chosen `Logger`
    ! puts them, e.g. `logs/agent.jsonl`.
    !
    ! OS-level confinement for `runCode` is external and opt-in: an executable
    ! `sandbox/run.sh` wrapper, if present, owns it (see `docs/concepts/sandbox.md`).
  //]
  def tools(approvalDeadline: Float): List[Tool] receives workspace =
    val runTool = runCodeTool(workspace.sandboxDir, approvalDeadline)
    [runTool, uploadMediaTool()] ++ skillTools(workspace.skillsDir)

  //[ The chat model, selected by env vars:
    !
    !   The provider is chosen by which API key is set. OpenAI takes precedence,
    !   followed by OpenRouter and Anthropic.
    !
    !   OPENAI_API_KEY     selects + authenticates OpenAI
    !   OPENROUTER_API_KEY selects + authenticates OpenRouter
    !   ANTHROPIC_API_KEY  selects + authenticates Anthropic
    !   MODEL             model id — defaults to "claude-opus-4-6" for Anthropic,
    !                     "gpt-5.6" for OpenAI, and is required for OpenRouter
    !   REASONING_EFFORT  OpenAI/OpenRouter reasoning effort. OpenAI defaults to
    !                     "medium"; OpenRouter defaults to "none".
    !   OPENAI_BASE_URL   optional; OpenAI uses the Responses API, so set this only
    !                     for another Responses-API endpoint (Azure, a proxy).
    !                     Third-party chat/completions endpoints are not supported.
    !   PROMPT_CACHE      Anthropic prompt caching: "5m" (default), "1h", or
    !                     "off". Ignored by OpenAI (it caches long prefixes on
    !                     its own).
  //]
  def model(): Model receives IO.stdout =
    val openAiKey = os.getenv("OPENAI_API_KEY", "")
    val openRouterKey = os.getenv("OPENROUTER_API_KEY", "")
    val anthropicKey = os.getenv("ANTHROPIC_API_KEY", "")
    if openAiKey != "" then
      openai(openAiKey, os.getenv("MODEL", "gpt-5.6"), os.getenv("OPENAI_BASE_URL", ""))

    else if openRouterKey != "" then
      val modelId = os.getenv("MODEL", "")
      if modelId == "" then
        println "Error: MODEL is required when OPENROUTER_API_KEY is set."
        sys.exit(1)
        abort "Not reachable"
      openrouter(openRouterKey, modelId)

    else if anthropicKey != "" then
      anthropic(anthropicKey, os.getenv("MODEL", "claude-opus-4-6"), cachePolicy())

    else
      println "Error: set OPENAI_API_KEY, OPENROUTER_API_KEY, or ANTHROPIC_API_KEY (in .env or the environment)."
      sys.exit(1)
      abort "Not reachable"

  //[ The Anthropic prompt-cache policy from PROMPT_CACHE (default "5m"). //]
  private def cachePolicy(): AnthropicCache =
    match os.getenv("PROMPT_CACHE", "5m")
    case "off" => NoCache
    case "1h"  => OneHour
    case _     => FiveMinutes

  //[ Preflight: an agent must run from its working directory — the folder holding
    ! its `jo.toml` and a `sandbox/` — so the tools resolve paths against it.
    ! Prints a clear error and returns false on a mislaunch.
  //]
  def checkAgentDir(): Bool receives IO.stdout =
    if file.exists("jo.toml") && os.path.isdir("sandbox") then
      true

    else
      println "Error: run this from an agent's working directory — a folder containing its jo.toml and a sandbox/ directory."
      false
end
