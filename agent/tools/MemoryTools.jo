//[ MemoryTools.jo
  !
  ! The LLM's interface to its working memory (`harpe.Memory`): tools to read,
  ! write, and list memory keys. The store is not held anywhere — a route passes
  ! it in — so the generic `Tool` abstraction stays memory-agnostic (memory is
  ! only for the LLM, not host code).
  !
  ! What keys to maintain, and how, is up to the agent's AGENT.md prompt. These
  ! tools impose no schema.
//]

namespace harpe.tools

import harpe.*
import harpe.Tool.*

//[ The LLM's read/write/list tools over a `Memory`
  !
  ! Nothing here is stateful, so this is a section rather than a class: the three
  ! specs are constants shared by every session, and the store each verb acts on
  ! arrives as an argument from the driver's route.
//]
section MemoryTools
  //[ Every tool in this group, acting on `memory`. //]
  def toolset(memory: Memory): Toolset =
    Toolset.empty
      .add: updateSpec, (i: ToolInput) => update(memory, i["key"], i["value"])
      .add: readSpec, (i: ToolInput) => read(memory, i["key"])
      .add: listSpec, (i: ToolInput) => list(memory)

  def updateSpec: Tool =
    Tool:
      "updateMemory"
      "Set (replace) the whole value stored under a memory key. Maintain your working context here (e.g. goal, plan, todos, facts) — what you store persists across turns and is shown back to you each turn. To edit, read the current value, then write the full revised value."
      [strParam("key", "The memory key to write, e.g. \"plan\" or \"todos\"."),
       strParam("value", "The full new value for the key; replaces any previous value.")]

  //[ Replace the whole value under `key`. //]
  def update(memory: Memory, key: String, value: String): RunOutcome =
    memory.set(key, value)
    new RunOutcome("Updated memory[\{key}].", "memory ← \{key}", attachments = [])

  def readSpec: Tool =
    Tool:
      "readMemory"
      "Read the current value stored under a memory key (empty if unset)."
      [strParam("key", "The memory key to read.")]

  //[ The current value under `key`. //]
  def read(memory: Memory, key: String): RunOutcome =
    val value = memory.get(key)
    val body = if value == "" then "(memory[\{key}] is empty)" else value
    new RunOutcome(body, "memory → \{key}", attachments = [])

  def listSpec: Tool =
    Tool:
      "listMemory"
      "List the keys currently stored in memory."
      []

  //[ The keys currently stored. //]
  def list(memory: Memory): RunOutcome =
    val ks = memory.keys()
    val body = if ks.isEmpty then "(memory is empty)" else ks.join("\n")
    new RunOutcome(body, "memory keys", attachments = [])
end
