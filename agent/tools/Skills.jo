//[ Skills.jo
  !
  ! Direct read-only reference access to the skills directory: list, read, and
  ! search the agent's knowledge files. Files may be any type (.md, .jo, source,
  ! …). Names carry their extension. These back the `skillsList` / `skillsRead`
  ! / `skillsSearch` tools, which let the model READ its reference material
  ! without writing Jo — it still ACTS only through `runCode`.
  !
  ! File reads are confined to the skills directory and best-effort UTF-8, so a
  ! binary or out-of-tree path can never crash a search.
//]

namespace harpe.tools
import harpe.ffi.os
import harpe.ffi.builtins

import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger

//[ The audit-log category for the skills tools
  !
  ! One record per content read (`skillsRead`/`skillsSearch`), tagged by
  ! `action`. Reverse-namespaced per the `harpe.logging.Entry` category
  ! convention. A denied `..` traversal is recorded too (the requested `name` is
  ! logged before confinement is checked).
//]
private def skillsCategory: String = "harpe.tools.skills"

//[ Collect (relativeName ~ fullPath) for every file under skillsDir.
  !
  ! Names carry their extension so .md/.jo/.py files with the same stem never collide.
//]
private def collectSkills(skillsDir: String): List[String ~ String] =
  if !os.path.isdir(skillsDir) then return []

  var files: List[String ~ String] = []
  val walkIter = os.walk(skillsDir)
  var nextEntry: py.Dynamic = builtins.next(walkIter, py.none)

  while !py.isNone(nextEntry) do
    val entry: os.WalkEntry = nextEntry.cast[os.WalkEntry]
    val dirpath = entry.dirpath
    val filenames = entry.filenames
    var i = 0
    while i < filenames.size do
      val filename: String = filenames.get(i).asString
      val fullPath = os.path.join(dirpath, filename)
      val relPath = os.path.relpath(fullPath, skillsDir)
      files = files + (relPath ~ fullPath)
      i = i + 1
    end
    nextEntry = builtins.next(walkIter, py.none)

  files.sortBy(pair => pair.fst)

//[ Best-effort text read
  !
  ! return empty string if the file is not decodable as UTF-8.
//]
private def readTextOrEmpty(path: String): String =
  match py.try(py.open(path, "r").read())
    case Ok(c)  => c.asString
    case Err(_) => ""

//[ The read-only reference tools over one skills directory
  !
  ! One object for the group: it holds the directory the three verbs share, and
  ! exposes each verb as a spec (what the model is offered) plus a typed method
  ! (what a driver's route calls).
//]
class SkillTools(skillsDir: String)
  //[ Every spec in this group, for the agent's tool list. //]
  def specs: List[Tool] = [listSpec, readSpec, searchSpec]

  def listSpec: Tool =
    Tool:
      "skillsList"
      "List the names of all available skill files (read-only reference docs). Each name includes its file extension (e.g. .md, .jo)."
      []

  //[ The names of every skill file. //]
  def list(): RunOutcome =
    val names = collectSkills(skillsDir).map(pair => pair.fst)
    val body = if names.isEmpty then "(no skills found)" else names.join("\n")
    new RunOutcome(body, "listed skills", [])

  def readSpec: Tool =
    Tool:
      "skillsRead"
      "Read a skill file by its full name including extension. Returns the file contents."
      [strParam("name", "The full skill file name including extension, as returned by skillsList (e.g. \"jo-cheat-sheet.md\")")]

  //[ One skill file's contents, confined to the skills directory. //]
  def read(skill: String): RunOutcome receives logger =
    logger.log:
      skillsCategory
      "action" ~ "read"
      "name"   ~ skill

    val absPath = os.path.abspath(os.path.normpath(os.path.join(skillsDir, skill)))

    if !confined(absPath) then
      return new RunOutcome("Access denied: path outside skills directory", "denied · \{skill}", [])

    if os.path.isfile(absPath) then
      match py.try(py.open(absPath, "r").read())
        case Ok(c)  => new RunOutcome(c.asString, "read · \{skill}", [])
        case Err(_) => new RunOutcome("Skill \{skill} could not be read as text.", "unreadable · \{skill}", [])
    else
      new RunOutcome("Skill not found: \{skill}", "not found · \{skill}", [])

  def searchSpec: Tool =
    Tool:
      "skillsSearch"
      "Case-insensitive search across all skill files. Returns matching lines as 'name:lineNumber: text'."
      [strParam("query", "Substring to search for (case-insensitive)")]

  //[ Matching lines across every skill file, capped at `maxHits`. //]
  def search(query: String): RunOutcome receives logger =
    logger.log:
      skillsCategory
      "action" ~ "search"
      "query"  ~ query

    new RunOutcome(matches(query), "searched · \{query}", [])

  //[ At most this many matching lines come back, however many files matched. //]
  private def maxHits: Int = 30

  //[ Is `absPath` inside the skills directory — i.e. did `..` not escape it? //]
  private def confined(absPath: String): Bool =
    val absDir = os.path.abspath(skillsDir)
    if !absPath.startsWith(absDir) then
      false
    else if absPath.size == absDir.size then
      true
    else
      absPath.get(absDir.size) == '/'

  //[ The `name:lineNumber: text` lines matching `query`, capped at `maxHits`. //]
  private def matches(query: String): String =
    val files = collectSkills(skillsDir)
    val lowerQuery = query.toLower
    var out = ""
    var hits = 0

    for name ~ filePath in files do
      if hits >= maxHits then return out

      val lines = readTextOrEmpty(filePath).lines
      var idx = 0
      while idx < lines.size && hits < maxHits do
        val line = lines[idx]
        if line.toLower.contains(lowerQuery) then
          out = out + "\{name}:\{idx + 1}: \{line.trim}\n"
          hits = hits + 1
        idx = idx + 1
      end
    end

    if out == "" then "(no matches for '\{query}')" else out
end
