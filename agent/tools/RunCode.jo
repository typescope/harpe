//[ RunCode.jo
  !
  ! The `runCode` tool: compile the model's program against the agent sandbox
  ! and run it, capturing the result — timed and emitted as a
  ! `harpe.tools.runCode` log entry to the caller's injected channel. This is
  ! the program-execution log, distinct from the conversational session history.
  ! The format and destination are the `Logger` backend's policy (see
  ! `harpe.logging`).
  !
  ! How it compiles — and why it is concurrency-safe. Building the sandbox's
  ! guest module once (`jo build`, the user's one-time prep) records the *exact*
  ! compiler invocation in the target's `.done` sidecar: the backend, every
  ! `--lib` (checking libraries) and `--link-lib` (link libraries) pointing at
  ! the dependencies' already-built, read-only `.sast`, the `--link` map, and
  ! the source/`-o`/`--sast` paths — one argument per line.
  !
  ! `runCode` replays that invocation with only the source, output, and `--sast`
  ! removed for per-run paths, so it compiles the ONE program against immutable
  ! prebuilt libraries.
  !
  ! Because the libraries are read-only and every run writes its own source,
  ! output, and sast dir, concurrent runs never touch shared state — no warming,
  ! no per-run package copy, no dependency re-resolution. A semaphore still
  ! bounds how many compiler/interpreter processes run at once.
//]

namespace harpe.tools
import harpe.ffi.os
import harpe.util.Clock
import harpe.ffi.time
import harpe.ffi.glob
import harpe.ffi.threading
import harpe.util.Process
import harpe.util.Capped
import harpe.ffi.builtins
import harpe.util.File
import harpe.util.Terminal
import harpe.ffi.json

import harpe.*
import harpe.Tool.*
import harpe.broker.*
import harpe.logging.*

private def shutilMod: py.Dynamic = py.module("shutil")
private def tempfileMod: py.Dynamic = py.module("tempfile")

//[ The log category for this tool's records — one program compile+run each
  !
  ! Reverse-namespaced (namespace + tool name) so it is unique in the open set
  ! and filterable by prefix. See the category convention on
  ! `harpe.logging.Entry`.
//]
private def runCodeCategory: String = "harpe.tools.runCode"

//[ The default: the driver grants the guest no configuration of its own. //]
private def noGuestEnv: Map[String, String] = Map.empty[String, String]

//[ Replay the recorded invocation with this run's paths swapped in
  !
  ! The source file (the lone `.jo` positional), the `-o` output, and the
  ! `--sast` output directory. Everything else — the compiler path, backend,
  ! `--lib`/`--link-lib`, `--link` map — is reused verbatim.
//]
private def replayArgs(lines: List[String], runSrc: String, runOut: String): py.List =
  val args = py.list()

  val Output = 0 // -o
  val Sast = 1   // --sast

  var mode = -1   // the previous flag whose value to replace next

  for line in lines if line != "" do
    if mode == Output then
      args.append(py.dynamic(runOut))
      mode = -1

    else if mode == Sast then
      mode = -1

    else if line == "-o" then
      args.append(py.dynamic(line))
      mode = Output

    else if line == "--sast" then
      mode = Sast

    else if line.endsWith(".jo") then
      continue

    else
      args.append(py.dynamic(line))
  end

  args.append(py.dynamic(runSrc))
  args

private def compilerErrorText(outText: String, errText: String): String =
  val out = Terminal.stripAnsi(outText).trim
  val err = Terminal.stripAnsi(errText).trim

  if out == "" then err
  else if err == "" then out
  else out + "\n" + err

//[ Handle one cross-cutting request from a sandboxed program. //]
private def handleBroker(
    frame: Frame,
    interact: Interact,
    approvalActive: py.Dynamic)
: Frame =
  val body = json.loads(frame.json).cast[py.Dict]
  val service = body.get("service", "").asString

  if service != "approval" then
    Frame.error("unknown broker service: '\{service}'")

  else
    val title = body.get("title", "").asString
    val detail = body.get("detail", "").asString

    if title.trim == "" then Frame.error("approval title must not be empty")
    else if title.size > 200 then Frame.error("approval title exceeds 200 characters")
    else if detail.size > 10000 then Frame.error("approval detail exceeds 10000 characters")
    else
      approvalActive.set()
      val attempted = py.try:
        if interact.cancelled then Approvals.Cancelled
        else interact.approve(title, detail)
      approvalActive.clear()
      val decision =
        match attempted
        case Ok(value)   => value
        case Err(error) => abort error.message

      Frame.of:
        json.dumps:
          py.dict:
            "ok"       ~ true
            "decision" ~ Approvals.wire(decision)

//[ Replay the sandbox's audit log through the ambient (contextual) `logger`.
  !
  ! The sandbox runtime logged its records as JSONL to `path` (named via
  ! HARPE_AUDIT_LOG). Each line is one `Entry`. Re-emitting them through this
  ! logger — running inside the turn's context scope — stamps each with the
  ! session, so a sandboxed program's records land in the log alongside the
  ! tool's own. A malformed line is skipped rather than failing the run.
//]
private def replayAudit(path: String): Unit receives logger =
  if File.exists(path) then
    for line in File.read(path).lines if line.trim != "" do
      match py.try(json.loads(line))
      case Ok(d)  => logger.logEntry(Entry.fromDict(d.cast[py.Dict]))
      case Err(_) => pass

//[ The core "act" tool: compile + run a Jo program against the agent sandbox.
  !
  ! Requires the sandbox to have been built once (`jo build`), which records the
  ! compiler invocation this tool replays. Until then, calls return a "sandbox
  ! not built" message rather than building anything themselves.
  !
  ! `buildTimeout` / `runTimeout` are host-side wall-clock backstops (seconds):
  ! a guest stuck compiling or in an infinite loop is killed (process group and
  ! all) rather than hanging the loop. Finer OS-level confinement (memory/CPU
  ! caps, filesystem, uid) lives outside the process in the optional
  ! `sandbox/run.sh` wrapper (see docs/concepts/sandbox.md).
  !
  ! `approvalDeadline` is the application's watchdog for one approval pause. It
  ! should be slightly longer than the deadline enforced by the application's
  ! interaction UI. This prevents a broken interaction handler from leaving the
  ! sandbox process waiting forever.
  !
  ! `maxConcurrent` bounds how many builds+runs proceed at once (each spawns a
  ! compiler + interpreter process). Further calls wait for a slot. Concurrent
  ! calls are isolated by construction — each compiles its own source against
  ! the shared, read-only dependency libraries — so they never corrupt each
  ! other.
  !
  ! Each run emits one `harpe.tools.runCode` `Entry` (code, and the outcome's
  ! compile/run timings, output or error) to the ambient `logger` channel — read
  ! at call time, so the turn's `Logging.withContext` tags reach it. Its format
  ! and destination are the `Logger` backend's policy — see
  ! `harpe.logging.Logging.withLogger`.
  !
  ! `maxResultChars` bounds the result text returned to the model
  ! (middle-elided, head + tail kept) so one large program output cannot flood
  ! the context. The full, un-elided output is still written to `logger`, so
  ! nothing is lost.
  !
  ! Defense in depth is external: if `sandbox/run.sh` (at the sandbox project
  ! root) exists and is executable, each run goes through it — `run.sh <out.py>`
  ! — and the script owns the interpreter, uid drop, and OS confinement (ulimit,
  ! landrun, bwrap, docker, …). Absent, the guest runs under the system Python.
  ! See `docs/concepts/sandbox.md`.
//]
class RunCodeTool(
    sandboxDir: String,
    approvalDeadline: Int,
    buildTimeout: Int = 120,
    runTimeout: Int = 30,
    maxConcurrent: Int = 4,
    maxResultChars: Int = 4000)
  view Tool

  //[ Bounds how many builds+runs proceed at once — further calls wait here. //]
  private val gate: py.Dynamic = threading.Semaphore(maxConcurrent)

  //[ The optional `run.sh` wrapper, at the sandbox project root
    !
    ! Checked once, here, rather than on every call: if it exists but is not
    ! executable, every run would fail obscurely.
  //]
  private val runScript: String = checkedRunScript(sandboxDir)

  def name: String = "runCode"

  def description: String =
    "Write a Jo program (namespace sandbox.guest, def runTask), compile it against the agent sandbox, and run it. Returns the program's stdout, or the compile error if it does not build."

  def params: List[ToolParam] =
    [strParam("code", "The Jo source code to compile and run")]

  //[ This tool, granting the guest `guestEnv`
    !
    ! The parameter name the model fills in lives with the spec that declares
    ! it, so a driver never repeats it.
  //]
  def toolset(guestEnv: Map[String, String] = noGuestEnv): Toolset =
    Toolset.of: this, (i: ToolInput, interact: Interact) => run(i["code"], guestEnv, interact)

  //[ One bounded, isolated run of `code`
    !
    ! Acquire a build slot, compile+run in a fresh temp directory, then delete
    ! it and release the slot — always, even on failure. If the guest has not
    ! been built, return a clear message instead (no build here).
    !
    ! `guestEnv` is the driver's per-run configuration for the guest process,
    ! copied into its environment verbatim — this tool interprets none of it.
    ! The keys are guest env-var names the driver and its own sandbox runtime
    ! agree on, an application protocol rather than the framework's. It arrives
    ! from the driver's route, so the values are whatever that turn should see.
  //]
  def run(code: String, guestEnv: Map[String, String] = noGuestEnv,
          interact: Interact = Interact.unattended)
  : ToolOutcome receives logger =
    match findDoneFile
    case None =>
      new ToolOutcome:
        "The sandbox is not built. Run `jo build` in the sandbox project once before starting the agent."
        "sandbox not built"
        attachments = []

    case Some(donePath) =>
      gate.acquire()
      val runDir = tempfileMod.mkdtemp(prefix = "run-").asString
      val outcome = py.try(buildAndRun(code, donePath, runDir, guestEnv, interact))
      val _ = py.try(shutilMod.rmtree(runDir, ignore_errors = true))
      gate.release()

      // Bound only the text the model sees. `buildAndRun` has already logged the
      // full output/error to the run log, so nothing is lost from the record.
      match outcome
      case Ok(outc) => new ToolOutcome(elide(outc.result, maxResultChars), outc.summary, outc.attachments)
      case Err(e)   => new ToolOutcome("The run failed unexpectedly: \{e.message}", "internal error", attachments = [])

  //[ Locate the compiler-invocation record left by `jo build` for the guest
    !
    ! The `*.py.done` sidecar next to the built target. `None` if the guest has
    ! not been built yet.
  //]
  private def findDoneFile: Option[String] =
    val hits = glob.glob(os.path.join(sandboxDir, ".build/*/jo-*/target/*.py.done"), recursive = false)
    if hits.size == 0 then None else Some(hits.get(0).asString)

  //[ Compile and run `code` in `runDir`
    !
    ! By replaying the recorded invocation from `donePath`, logging the outcome.
  //]
  private def buildAndRun(
      code: String, donePath: String, runDir: String, guestEnv: Map[String, String],
      interact: Interact)
  : ToolOutcome receives logger =
    // Each run emits one `harpe.tools.runCode` log entry — the program under test
    // plus the fields specific to how it ended — to the injected channel. What
    // becomes of the entry (format, destination) is the Logger backend's policy.
    val runSrc   = os.path.join(runDir, "Task.jo")
    val runOut   = os.path.join(runDir, "out.py")
    val runAudit = os.path.join(runDir, "audit.jsonl")

    File.write(runSrc, code)

    val args = replayArgs(File.read(donePath).lines, runSrc, runOut)

    // 1. Compile — the security checkpoint — timed, bounded, and error-captured.
    val t0 = Clock.now()
    val build = Process.runCapped(args, buildTimeout.toFloat)
    val compileSeconds = builtins.round(Clock.now() - t0, 2)

    if build.timedOut then
      logger.log:
        runCodeCategory
        "code"           ~ code
        "compiled"       ~ false
        "compileSeconds" ~ compileSeconds
        "timedOut"       ~ true
        "phase"          ~ "compile"
      return new ToolOutcome:
        "The build timed out after \{buildTimeout}s."
        "build timed out · \{buildTimeout}s"
        attachments = []

    if build.returnCode != 0 then
      val compileError = compilerErrorText(build.out, build.err)
      logger.log:
        runCodeCategory
        "code"           ~ code
        "compiled"       ~ false
        "compileSeconds" ~ compileSeconds
        "compileError"   ~ compileError
      return new ToolOutcome:
        "The program did not compile (\{compileSeconds}s):\n\{compileError}"
        "did not compile · \{compileSeconds}s"
        attachments = []

    // 2. Run the compiled program (its path is the `-o` we just supplied).
    if !os.path.isfile(runOut) then
      return new ToolOutcome("The program compiled but no executable was found.", "no executable produced", attachments = [])

    // A `sandbox/run.sh` wrapper (defense in depth) owns how the program runs — the
    // interpreter, any uid drop, and OS-level confinement (ulimit/landrun/bwrap/…).
    // When present, run the guest through it (`run.sh <out.py>`) and make the run
    // artifacts readable to whatever uid it may drop to (mkdtemp is 0700, ours).
    // Absent: run the system Python directly. See docs/concepts/sandbox.md.
    val useRunSh = os.path.isfile(runScript)

    if useRunSh then
      os.chmod(runDir, 493)   // 0o755 — traverse + read the directory
      os.chmod(runOut, 420)   // 0o644 — read the compiled program
      // Pre-create the audit log world-writable, so a uid-dropping run.sh can still
      // append to it (the dir is not writable to the dropped user).
      File.write(runAudit, "")
      os.chmod(runAudit, 438) // 0o666

    val runCmd = if useRunSh then py.list(runScript, runOut)
                 else py.list("python3", runOut)

    // Start the untrusted guest with PATH only, then add the audit-log path and
    // the driver's selected `guestEnv` values below. It inherits no other
    // host variables. The trusted compiler above keeps the full toolchain env.
    val runEnv = Process.guestEnv()
    runEnv.set("HARPE_AUDIT_LOG", runAudit)

    // One broker belongs to one sandbox run. Approval requests travel over this
    // socket and are forwarded to the current Interact without entering the model
    // transcript.
    val brokerPath = os.path.join(runDir, "broker.sock")
    val approvalActive = threading.Event()
    val broker = Broker.start:
      brokerPath
      frame => handleBroker(frame, interact, approvalActive)
    runEnv.set("HARPE_BROKER_SOCKET", brokerPath)

    // The driver's config, copied in verbatim — `runCode` interprets none of
    // it: the keys are guest env-var names the driver chose (an application
    // protocol between the driver and its own sandbox runtime, not the
    // framework's). This is the host→guest "state" channel. See
    // host-guest-boundary.md.
    for k ~ v in guestEnv.toList do
      runEnv.set(k, v)

    // Run the guest IN its own run dir, so its working directory (`.`) is that
    // isolated scratch — never the host's agent dir — with no env var needed to name it.
    val t1 = Clock.now()
    val attemptedRun = py.try:
      Process.runCappedWithPauses:
        runCmd
        runTimeout.toFloat
        approvalActive
        approvalDeadline.toFloat
        env = runEnv
        cwd = runDir
    broker.stop()
    val run =
      match attemptedRun
      case Ok(value)   => value
      case Err(error) => abort error.message
    val runSeconds = builtins.round(Clock.now() - t1, 2)

    if run.timedOut then
      logger.log:
        runCodeCategory
        "code"           ~ code
        "compiled"       ~ true
        "compileSeconds" ~ compileSeconds
        "runSeconds"     ~ runSeconds
        "timedOut"       ~ true
        "phase"          ~ (if run.pauseTimedOut then "approval" else "run")

      if run.pauseTimedOut then
        return new ToolOutcome:
          "The approval did not finish within \{approvalDeadline}s, so the program was stopped."
          "approval timed out · \{runSeconds}s"
          attachments = []
      else
        return new ToolOutcome:
          "The program ran too long and was stopped after \{runTimeout}s (possible infinite loop)."
          "timed out · ran \{runSeconds}s"
          attachments = []

    val runReturnCode = run.returnCode
    val runOutText = run.out.trim
    val runErr = Terminal.stripAnsi(run.err).trim

    // Replay the records the sandboxed program logged (a JSONL file it wrote to)
    // through this (contextual) logger, so they carry the turn's session context.
    replayAudit(runAudit)

    val result =
      if runReturnCode != 0 then "The program crashed:\n\{runErr}"
      else if runOutText == "" then "(the program produced no output)"
      else runOutText

    val summary =
      if runReturnCode != 0 then "crashed · compiled \{compileSeconds}s, ran \{runSeconds}s"
      else "ran · compiled \{compileSeconds}s, ran \{runSeconds}s"

    logger.log:
      runCodeCategory
      "code"           ~ code
      "compiled"       ~ true
      "compileSeconds" ~ compileSeconds
      "runSeconds"     ~ runSeconds
      "exitCode"       ~ runReturnCode
      "output"         ~ result
    new ToolOutcome(result, summary, attachments = [])
end

//[ The optional `run.sh` wrapper in `sandboxDir`, refused if it cannot run. //]
private def checkedRunScript(sandboxDir: String): String =
  val runScript = os.path.join(sandboxDir, "run.sh")

  if os.path.isfile(runScript) then
    if !os.access(runScript, os.X_OK) then
      abort "sandbox run.sh exists but is not executable — run `chmod +x \{runScript}` (see docs/concepts/sandbox.md)"

  runScript
