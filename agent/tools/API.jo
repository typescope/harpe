//[ API.jo
  !
  ! Read sandbox API
//]

namespace harpe.tools

import harpe.Tool
import harpe.ffi.*

private def readAPI(sandBoxDir: String, name: String): Tool.RunOutcome =
  // Resolve and confine the path to the sandbox directory (no escaping via "..").
  val absPath = os.path.abspath(os.path.normpath(os.path.join(sandBoxDir, name)))
  val absDir  = os.path.abspath(sandBoxDir)
  val isSafe =
    if absPath.startsWith(absDir) then
      if absPath.size == absDir.size then true
      else absPath.get(absDir.size) == '/'
    else false

  if !isSafe then
    return new Tool.RunOutcome("Access denied: path outside sandbox directory", "denied · \{name}")

  if os.path.isfile(absPath) then
    match py.try(py.open(absPath, "r").read())
      case Ok(c)  => new Tool.RunOutcome(c.asString, "read · \{name}")
      case Err(_) => new Tool.RunOutcome("interface \{name} could not be read as text.", "unreadable · \{name}")
  else
    new Tool.RunOutcome("interface not found: \{name}", "not found · \{name}")

//[ The read-only reference tools over the sandbox directory. //]
def apiTool(sandboxDir: String): Tool =
  new Tool(
    "getAPI",
    "get a specific programming interface definition from Jo source file, name param is the file name without `.jo` suffix.",
    [Tool.strParam("name", "API name")],
    input => readAPI(sandboxDir, input.string("name"))
  )
