//[ Journal.jo
  !
  ! The framework's `Transcript`: every record appended through a `Logger`, as
  ! one structured entry per event.
  !
  ! Because the sink is a `Logger`, a conversation lands wherever that backend
  ! points — `JsonlLogger`'s per-session file, a socket, a database adapter.
  !
  ! Whether it shares that backend with the turn's tools is the driver's call.
  ! Handing it the same one puts a tool's diagnostics in causal order beside the
  ! messages that caused them, which is what the bundled drivers do. Handing it a
  ! different one keeps the conversation apart from the diagnostics. Nothing here
  ! assumes either.
  !
  ! The reading half lives in the `Transcript` section (`records`,
  ! `fromEntries`), because it decodes the `Entry` values this class writes.
//]

namespace harpe.transcript
import harpe.ffi.time
import harpe.util.Clock
import harpe.util.truncate
import harpe.Transcript
import harpe.Model.*
import harpe.Tool.*
import harpe.logging.*
import harpe.turns.*

//[ A transcript kept as structured log records.
  !
  ! `log` is the sink. A driver usually hands it the same per-session backend the
  ! turn's tools log through, so one file holds the whole story.
//]
class Journal(log: Logger)
  view Transcript

  def start(input: UserInput): Unit =
    emit("harpe.turn.started", input)

  def append(message: Assistant | ToolResults): Unit =
    emit("harpe.turn.message", message)

  def commit(): Unit = log.log("harpe.turn.answered")
  def interrupted(): Unit = log.log("harpe.turn.interrupted")
  def failed(detail: String): Unit =
    if detail == "" then log.log("harpe.turn.failed")
    else log.error("harpe.turn.failed", detail)

  //[ Open the bracket for a user-facing turn.
    !
    ! Call this at the TOP of the turn handler, before any queue or lock the
    ! work waits behind: the gap between this record and the `harpe.turn.started`
    ! that follows is then exactly how long the request was queued. A paired
    ! `response` closes the bracket. If the turn throws before `response` is
    ! reached, the bracket is left open — an unclosed bracket is a fragment, and
    ! `records` yields nothing for it.
  //]
  def request(data: Value): Unit =
    log.log(Journal.requestCategory, "data" ~ data)

  //[ Close the bracket opened by `request`.
    !
    ! `data` is the driver's summary of how the turn went — whatever it chooses
    ! to record alongside the engine's own messages. The two calls must be on the
    ! same thread (or otherwise serialized) so their records cannot interleave
    ! with another turn's bracket.
  //]
  def response(data: Value): Unit =
    log.log(Journal.responseCategory, "data" ~ data)

  private def emit(category: String, message: Message): Unit =
    log.logEntry(new Entry(Clock.now(), category, messageFields(message)))


  private def messageFields(message: Message): Map[String, Value] =
    val d = messageDict(message)
    var fields = Map.empty[String, Value]
    for k in py.iter(d.keys()) do fields = fields.add(k.asString, Value.fromJson(d.get(k)))
    fields

  private def messageDict(message: Message): py.Dict =
    match message
    case UserInput(text, attachments) =>
      py.dict("role" ~ "user", "text" ~ text, "attachments" ~ attachmentsDict(attachments))
    case Assistant(text, calls) =>
      val list = py.list()
      for call in calls do
        list.append(py.dict("id" ~ call.id, "name" ~ call.name, "input" ~ call.input.raw))
      py.dict("role" ~ "assistant", "text" ~ text, "calls" ~ list)
    case ToolResults(results) =>
      val list = py.list()
      for result in results do
        list.append(py.dict("id" ~ result.id, "content" ~ result.content,
                            "attachments" ~ attachmentsDict(result.attachments),
                            "success" ~ result.success))
      py.dict("role" ~ "tool_results", "results" ~ list)

  private def attachmentsDict(attachments: List[Attachment]): py.List =
    val list = py.list()
    for a in attachments do
      list.append:
        py.dict:
          "name"   ~ a.name
          "size"   ~ a.size
          "mime"   ~ a.mime
          "path"   ~ a.path
    list
end

//[ Reading a journal back
  !
  ! The other half of what this class writes: the record categories, the payload
  ! builder, and the folds that turn decoded `Entry` values into a transcript
  ! (`records`) or into model history (`fromEntries`).
  !
  ! All of it is `Entry`-shaped, which is why it lives here and not under
  ! `Transcript`. A transcript kept in a database reads itself back its own way,
  ! and owes none of this.
//]
section Journal
  //[ One user-facing turn: its bracket, and the journal entries it spans
    !
    ! There is no id. A journal holds one conversation, whose turns are recorded in
    ! order, so an opening record pairs with the next closing one and nothing has to
    ! be minted or matched. A driver that wants a stable handle — for retry, a
    ! permalink, a delete — puts its own in `request`, where it is already carrying
    ! everything else it knows about the turn.
    !
    ! A record is COMPLETE by construction: an opening payload, a closing one, and
    ! the turn between them. `Journal.records` builds none for a bracket missing
    ! any of the three, which is what a process killed mid-turn leaves behind. Such
    ! a turn is not a conversation the user had — it is a fragment — and admitting
    ! it here would put a null check in every consumer to render half a bubble.
    ! The fragment is still in the journal for anyone auditing it.
  //]
  class TurnRecord(request: Value, response: Value, data: TurnData)

  def maxResumeChars: Int = 1000000

  def requestCategory: String  = "harpe.turn.request"
  def responseCategory: String = "harpe.turn.response"

  //[ Load resumable model history from an existing JSONL journal.
    !
    ! Missing-file policy belongs to the application. `Entry.readJsonl` raises
    ! when `path` does not exist.
  //]
  def load(path: String): List[Message] =
    fromEntries(Entry.readJsonl(path))

  //[ Build a bracket payload — the `Value` that `request` and `response` carry
    !
    ! Sugar for the common case, so a driver writes its payload the way it writes
    ! a log record:
    !
    !     transcript.request(id, Journal.payload("kind" ~ "upload", "file" ~ name))
    !
    ! Without it the map needs an explicit type — `Map[String, Value](...)` — since
    ! a bare `Map` of strings infers `Map[String, String]` and no adapter bridges
    ! it. A payload that is not a map (a bare string, a list) can be passed to
    ! `request` and `response` directly.
  //]
  def payload(fields: ..(String ~ Value)): Value =
    var map = Map.empty[String, Value]
    for k ~ v in fields do map = map.add(k, v)
    map


  //[ Locate the user-facing turns in a journal
    !
    ! `turns` folds every turn in the journal. This finds only the ones a driver
    ! bracketed with `request`/`response`. Everything else — a subagent's turn, a
    ! background job's, a script's — is machinery: it stays in the log for
    ! auditing and never reaches the transcript.
    !
    !
    ! Only COMPLETE turns. A bracket whose response never arrived, or that holds
    ! no turn at all, yields nothing — that is what a process killed mid-turn
    ! leaves, and it is a fragment rather than a conversation the user had. The
    ! fragment stays in the journal for auditing.
  //]
  def records(entries: List[Entry]): List[TurnRecord] =
    var records: List[TurnRecord] = []

    var open = false
    var request: Value = ""
    var span: List[Entry] = []

    for entry in entries do
      if entry.category == requestCategory then
        open = true
        request = entry.fields.getOrElse("data", "")
        span = []

      // Outside a bracket every record is machinery.
      else if !open then pass

      else if entry.category == responseCategory then
        // No turn under the bracket means the process died before `ask` was
        // ever reached. Nothing was said, so there is nothing to show.
        match turnOf(span)
        case turn: TurnData =>
          records = records + TurnRecord(request, entry.fields.getOrElse("data", ""), turn)
        case _ => pass

        open = false
        span = []

      else span = span + entry

    records

  //[ Fold one turn's span of entries into the turn it describes
    !
    ! The parsing half of `records`. Nested turns are handled by depth:
    ! a subagent driving `runTurn` inside a bracketed turn writes its own
    ! `started` and terminator within the span, and only the outermost pair
    ! becomes the result. This assumes nested turns are sequential, so that their
    ! records nest rather than interleave.
    !
    ! `None` when the span holds no turn at all — the process died while the
    ! request was still queued, before `runTurn` was ever reached. A turn that
    ! started but has no terminator instead yields an interrupted `TurnData`, so
    ! a crash mid-turn stays distinguishable from a crash before it.
  //]
  private def turnOf(entries: List[Entry]): TurnData | None =
    var data: TurnData | None = None
    var depth = 0
    var user: Option[Message] = None
    var pending: List[Message] = []

    for entry in entries do
      // Once the turn has ended, later engine records are not its own.
      if entry.category == "harpe.turn.started" && data is None then
        depth = depth + 1
        if depth == 1 then
          user = Some(messageFromDict(Entry.toDict(entry)))
          pending = []

      else if entry.category == "harpe.turn.message" && depth == 1 then
        pending = pending + messageFromDict(Entry.toDict(entry))

      else if isTerminator(entry.category) && depth > 0 then
        depth = depth - 1
        if depth == 0 then
          match user
          case Some(message) => data = turnFrom(message, pending, entry)
          case None          => pass
          user = None
          pending = []

    match data
    case t: TurnData => t
    case _ =>
      match user
      case Some(message) => TurnData(message, pending, TurnResult.Interrupted)
      case None          => None

  private def isTerminator(category: String): Bool =
    category == "harpe.turn.answered"
      || category == "harpe.turn.interrupted"
      || category == "harpe.turn.failed"

  private def turnFrom(user: Message, pending: List[Message], terminator: Entry): TurnData =
    if terminator.category == "harpe.turn.answered" then TurnData(user, pending, TurnResult.Success)
    else if terminator.category == "harpe.turn.interrupted" then TurnData(user, [], TurnResult.Interrupted)
    else TurnData(user, [], TurnResult.Failed(Entry.toDict(terminator).get("error", "").asString))

  //[ Derive model history from the transcript
    !
    ! What the model resumes with is what the user sees, because both come from
    ! `records`. A turn outside the transcript — a subagent's, a background
    ! job's, a fragment left by a process killed mid-turn — is in the journal for
    ! auditing and in neither of them. Without that gate a subagent running
    ! against a session's log would splice its own conversation into the parent's
    ! history, which is a much worse failure than a missing scrollback.
    !
    ! User messages survive every outcome, since a driver closes the bracket on
    ! failures too. Only answered turns contribute their assistant and tool
    ! messages. The resume cap drops whole oldest turns.
  //]
  def fromEntries(entries: List[Entry]): List[Message] =
    var messages: List[Message] = []
    for record in records(entries) do
      messages = messages + record.data.user
      if record.data.result is TurnResult.Success then messages = messages ++ record.data.messages
    truncate(messages, maxResumeChars)

  private def attachmentsFrom(list: py.List): List[Attachment] =
    var attachments: List[Attachment] = []
    for item in list do
      val a = item.cast[py.Dict]
      val attachment = Attachment:
        a.get("name", "").asString
        a.get("size", 0).asInt
        a.get("mime", "").asString
        path = a.get("path", "").asString
      attachments = attachments + attachment
    attachments

  private def messageFromDict(d: py.Dict): Message =
    val role = d.get("role", "").asString
    if role == "user" then
      UserInput(d.get("text", "").asString, attachmentsFrom(d.get("attachments", py.list()).cast[py.List]))
    else if role == "assistant" then
      var calls: List[ToolCall] = []
      for item in d.get("calls", py.list()).cast[py.List] do
        val c = item.cast[py.Dict]
        calls = calls + ToolCall(c.get("id", "").asString, c.get("name", "").asString,
                                ToolInput(c.get("input", py.dict()).cast[py.Dict]))
      Assistant(d.get("text", "").asString, calls)
    else
      var results: List[ToolResult] = []
      for item in d.get("results", py.list()).cast[py.List] do
        val r = item.cast[py.Dict]
        val toolResult = ToolResult:
          r.get("id", "").asString
          r.get("content", "").asString
          attachmentsFrom(r.get("attachments", py.list()).cast[py.List])
          r.get("success", default = true).asBool
        results = results + toolResult
      ToolResults(results)
end
