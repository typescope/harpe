//[ Serve.jo
  !
  ! A live view of one session's journal, in a browser.
  !
  ! An agent that depends on harpe gets it by declaring a module that links its
  ! entry point here — no code of its own:
  !
  !     [module.view]
  !     kind = "app"
  !     platform = "python"
  !     enable-ffi = true
  !     src = []                 # no sources: the entry point is linked in
  !     modules = [{ id = "harpe", path = "..." }]
  !     links = [{ from = "jo.main", to = "harpe.transcript.serve" }]
  !
  !     jo run view -- logs/sessions/2026-08-21.jsonl
  !
  ! WHY THIS IS NOT A DRIVER. It writes nothing and runs no turn — it reads a
  ! file. Every driver produces the same `Entry` stream, so one viewer serves all
  ! of them, and an agent debugging a session should not have to build a UI to
  ! see what happened.
  !
  ! Polling, not tailing: the file is re-read on each request and only lines the
  ! page has not seen are returned. That costs a whole-file read per poll, which
  ! for a session journal is nothing, and it is correct across truncation,
  ! rotation, and a writer that has not flushed a complete line.
  !
  ! The page itself is a resource bundled with the `harpe` module
  ! (`agent/assets/journal.html`), so an agent installs nothing to use the viewer
  ! and the markup stays editable as markup.
//]

namespace harpe.transcript

import harpe.ffi.sys
import harpe.ffi.signal
import harpe.ffi.os
import harpe.ffi.file
import harpe.ffi.json

import harpe.Http
import harpe.Http.request
import jo.IO.stdout
import jo.resource.*
import jo.py.resource.*

//[ The `harpe` module's own bundled resources. //]
param resources: Resources = new py.resource.ResourceBundle("harpe")

//[ Serve the journal named on the command line. //]
def serve(): Unit receives stdout =
  val path = journalPath()

  if path == "" then
    println "Usage: jo run view -- <path/to/session.jsonl>"
    sys.exit(2)

  if !file.exists(path) then
    println "No such journal: \{path}"
    sys.exit(1)

  val host = os.getenv("HOST", "127.0.0.1")
  val port = Int.parse(os.getenv("PORT", "8760")) rescue None => 8760

  val name = os.path.basename(path)
  val httpd = Http.server: host, port, () => route(path, name)

  println "  \{name}"
  println "  Live at http://\{host}:\{port}"
  println "  Ctrl-C to stop"

  // Stop cleanly on Ctrl-C instead of dumping a traceback from serve_forever.
  signal.shutdownOnSigint("\n  stopped.")

  httpd.serve_forever()

//[ The first non-flag argument after the program name, or "". //]
private def journalPath(): String =
  var found = ""
  var skip = true
  for argDyn in py.module("sys").argv.cast[py.List] do
    val arg = argDyn.asString
    if skip then skip = false
    else if found == "" && !arg.startsWith("-") then found = arg
  found

private def route(path: String, name: String): py.List receives request, resources =
  match request
  case Http.Get("/")       => Http.respondHtml(page(name))
  case Http.Get("/events") => Http.respond("200 OK", "application/json", events(path, seen()))
  case _                   => Http.notFound()

//[ How many lines the page already has. //]
private def seen(): Int receives request =
  Int.parse(Http.queryParam("seen")) rescue None => 0

//[ Every journal line after the first `seen`, as one JSON envelope
  !
  ! `seen` is a LINE count, not a byte offset, so a half-written final line is
  ! simply not counted yet and arrives whole on the next poll.
//]
private def events(path: String, seen: Int): String =
  val entries = py.list()
  var count = 0

  if file.exists(path) then
    for line in file.read(path).lines do
      if line.trim != "" then
        count = count + 1
        if count > seen then
          match py.try(json.loads(line))
          case Ok(obj) => entries.append(obj)
          case Err(_)  => pass

  json.dumps(py.dict("seen" ~ count, "entries" ~ entries))

//[ The viewer page, with the journal's name substituted in. //]
private def page(name: String): String receives resources =
  match resources.readText("assets/journal.html")
  case Ok(html) => html.replace("__NAME__", name)
  case Err(why) => "<!doctype html><meta charset=\"utf-8\"><pre>journal.html missing: " + why + "</pre>"
