//[ Routes.jo
  !
  ! The routing table for one turn: which handler runs for which tool name.
  !
  ! A `Tool` spec says what the model may call. `Routes` says what happens when
  ! it does, and is assembled per turn by the driver — see `harpe.Handler`.
//]

namespace harpe

import harpe.Tool.ToolInput

//[ What runs for each tool name this turn
  !
  ! The driver assembles one of these per turn by joining what each tool
  ! contributes — `MemoryTools.routes(store) ++ runCode.routes()` — so a tool's
  ! verbs and the argument names they read are wired once, where they are
  ! declared, rather than repeated at every driver.
  !
  ! Wiring the same name twice aborts. Two tools answering to one name is a
  ! wiring bug, and a plain map would silently keep one of them, which surfaces
  ! much later as the wrong tool running.
//]
class Routes(entries: Map[String, Handler])
  //[ These routes plus one more. //]
  def add(name: String, handler: Handler): Routes =
    if entries.contains(name) then
      abort "two tools are wired to the name '\{name}'"
    new Routes(entries ++ Map(name ~ handler))

  //[ These routes plus every route in `other`, clashes rejected as above. //]
  def ++(other: Routes): Routes =
    var out = this
    for name ~ handler in other.entries.toList do out = out.add(name, handler)
    out

  //[ Is anything wired to `name`? //]
  def contains(name: String): Bool = entries.contains(name)

  //[ What runs for `name`. Check `contains` first. //]
  def handler(name: String): Handler = entries[name]

  //[ Every name wired, for reporting a spec that has no route. //]
  def names: List[String] = entries.toList.map(pair => pair.fst)
end

section Routes
  //[ Nothing wired yet. //]
  def empty: Routes = new Routes(Map.empty[String, Handler])

  //[ One route — what a single-tool group contributes. //]
  def of(name: String, handler: Handler): Routes = empty.add(name, handler)
end
