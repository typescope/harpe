namespace SandboxRuntime

import jo.IO.stdout
import SandboxAPI

// Minimal per-turn runtime for the runCode integration tests: just run the
// guest. OS-level confinement (if any) is applied outside the process by the
// fixture's `sandbox/run.sh` wrapper, which the tests use to verify the run.sh
// seam and env scrub end to end.
def main(): Unit receives stdout =
  SandboxAPI.runTask()
