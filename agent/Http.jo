//[ Http.jo
  !
  ! WSGI plumbing: reading a request, and writing a response.
  !
  ! Nothing here knows what an agent is. It exists because harpe serves HTTP in
  ! more than one place — the journal viewer here, a driver's own pages — and
  ! status lines, verb handling and body reading are worth having a single copy
  ! of. A second `405`-vs-`501` rule is the kind of difference nobody notices
  ! until it matters.
  !
  ! THE REQUEST IS AMBIENT. A server binds one per request and every function
  ! here reads it, so a handler that wants the body asks for `Http.readBody()`
  ! rather than being handed an `environ` to pass on. That is why route handlers
  ! carry neither `environ` nor `startResponse`: they never touch either except
  ! through this file.
  !
  ! `app` IS THE SEAM. It turns a route into a plain WSGI application, so a
  ! deployment binds whichever server it likes — waitress, gunicorn, granian —
  ! in its own code. `server` here is wsgiref, for development and tests only.
  ! Nothing in this file depends on a package outside the standard library.
  !
  ! Deliberately thin. Cookies, sessions, TLS detection and base-URL resolution
  ! are application policy, not plumbing, and belong to whoever needs them.
//]

namespace harpe

import harpe.ffi.json
import harpe.ffi.builtins

section Http
  //[ The verb, as a value rather than a string
    !
    ! Closed on purpose: these six are what a server here understands, and
    ! anything else is refused at the door rather than carried inward as a string
    ! nothing will ever match. `Head` and `Options` are named because browsers,
    ! proxies and health checkers really do send them — they match no route, but
    ! they are a deliberate 404 rather than an accident of `method == "GET"`
    ! being false.
    !
    ! `Options` rather than `Option`, which is Jo's own.
  //]
  section Verb
    union Method = Get | Post | Put | Delete | Head | Options
  end

  //[ The status, as a value rather than a string
    !
    ! Same reason as the verb: `"200 0K"` is a string a compiler cannot refuse,
    ! and a status line is written at every response site. These are the ones
    ! this codebase answers with — add a case rather than passing a literal.
  //]
  section Status
    union Code = Success | NotModified | BadRequest | Forbidden | NotFound | Conflict | TooLarge | ServerError | NotImplemented

    //[ The status line WSGI expects. //]
    def line(code: Code): String =
      match code
      case Success        => "200 OK"
      case NotModified    => "304 Not Modified"
      case BadRequest     => "400 Bad Request"
      case Forbidden      => "403 Forbidden"
      case NotFound       => "404 Not Found"
      case Conflict       => "409 Conflict"
      case TooLarge       => "413 Payload Too Large"
      case ServerError    => "500 Internal Server Error"
      case NotImplemented => "501 Not Implemented"
  end

  //[ The content type, with its charset settled here rather than at each site
    !
    ! `Other` carries a type resolved at runtime — a file's own, from
    ! `File.mimeType`. Everything a handler names in source should be a case, so
    ! that the charset decision is made once.
  //]
  section Mime
    union Type = Html | Json | Ndjson | Text | Css | JavaScript | Other(value: String)

    def value(kind: Type): String =
      match kind
      case Html       => "text/html; charset=utf-8"
      case Json       => "application/json"
      case Ndjson     => "application/x-ndjson"
      case Text       => "text/plain; charset=utf-8"
      case Css        => "text/css; charset=utf-8"
      case JavaScript => "application/javascript; charset=utf-8"
      case Other(raw) => raw
  end

  //[ One WSGI exchange: what was asked, and the callable that begins the answer
    !
    ! `startResponse` is not part of the request, strictly — it is the response
    ! side. It rides here because WSGI hands the two over together and they are
    ! never wanted apart, and splitting them would put a second `receives` on
    ! every handler to no end.
  //]
  class Request(method: Verb.Method, path: String, environ: py.Dynamic, startResponse: py.Dynamic)

  //[ Request patterns keep the verb and path test together at dispatch sites.
    ! A plain string matches an exact path; Jo's regex strings retain their
    ! normal capture behaviour when supplied as the `path` pattern.
  //]
  pattern Get(path: String): Partial[Request] =
    case asked if asked.method is Verb.Get then path = asked.path

  pattern Post(path: String): Partial[Request] =
    case asked if asked.method is Verb.Post then path = asked.path

  //[ A path split into its segments, for routing on the parts of one
    !
    ! Composes with the verb patterns, so a route reads as the shape it matches:
    !
    !     case Http.Get(Http.Segments ["sessions", id])        => …
    !     case Http.Get(Http.Segments ["sessions", id, "raw"]) => …
    !
    ! Empty segments are dropped, so `/sessions/`, `/sessions`, and
    ! `//sessions//` all match the same way. `/` is the empty list.
  //]
  pattern Segments(parts: List[String]): Partial[String] =
    case path then parts = segments(path)

  //[ `"/sessions/42/"` as `["sessions", "42"]`. //]
  def segments(path: String): List[String] =
    path.split("/").exclude(part => part == "")

  //[ The request being served. Bound once per request by the server. //]
  param request: Request

  //[ Read one out of what WSGI handed over, or None for a verb not implemented.
    ! The only place a raw `REQUEST_METHOD` string is looked at.
  //]
  def requestFrom(environ: py.Dynamic, startResponse: py.Dynamic): Option[Request] =
    match verb(environ.get("REQUEST_METHOD", "GET").asString)
    case None => None
    case Some(asked) =>
      Some:
        new Request:
          asked
          environ.get("PATH_INFO", "/").asString
          environ
          startResponse

  private def verb(raw: String): Option[Verb.Method] =
    if raw == "GET" then Some(Verb.Get)
    else if raw == "POST" then Some(Verb.Post)
    else if raw == "PUT" then Some(Verb.Put)
    else if raw == "DELETE" then Some(Verb.Delete)
    else if raw == "HEAD" then Some(Verb.Head)
    else if raw == "OPTIONS" then Some(Verb.Options)
    else None

  //[ The largest request body this plumbing will read
    !
    ! A guard against a runaway body, not a tuned limit. A body declaring more
    ! than this is refused by `app` before any route sees it, and `readBody`
    ! reads no further than this even if `CONTENT_LENGTH` lies. A driver wanting
    ! larger uploads sets its server's own limit and streams them.
    !
    ! The refusal is written without draining what the client is still sending,
    ! so a client mid-upload may see the connection close rather than read the
    ! 413. That is the cheap answer, and the right one here: a deployment sets
    ! its server's own limit too — waitress `max_request_body_size` — which
    ! refuses at the transport layer where the body can be discarded properly.
    ! This check is the backstop for a server that has no such limit.
  //]
  def maxBodyBytes: Int = 8388608   // 8 MiB

  //[ A refusal written straight to WSGI, with no ambient request
    !
    ! For the two cases decided before a request can be bound or routed: an
    ! unimplemented verb, and a body too large to read.
  //]
  private def refuse(startResponse: py.Dynamic, status: Status.Code, message: String): py.List =
    py.call:
      startResponse
      Status.line(status)
      py.list(py.tuple("Content-Type", Mime.value(Mime.Text)))
    py.list(py.dynamic(message).encode())

  //[ A verb this server does not implement — TRACE, PATCH, something invented
    !
    ! 501 rather than 405: 405 says the method is wrong for this resource, and
    ! this refusal is made before any path is looked at. It is also one of the
    ! two responses written without an ambient request, since refusing the verb
    ! is precisely what stops one being built.
  //]
  def unsupportedMethod(startResponse: py.Dynamic): py.List =
    refuse(startResponse, Status.NotImplemented, "not implemented")

  //[ What `CONTENT_LENGTH` claims, or zero. //]
  private def declaredLength(environ: py.Dynamic): Int =
    Int.parse(environ.get("CONTENT_LENGTH", "").asString) rescue None => 0

  //[ Read and decode a request body, never past `maxBodyBytes`. //]
  def readBody(): String receives request =
    val declared = declaredLength(request.environ)
    val length = if declared > maxBodyBytes then maxBodyBytes else declared
    request.environ.get("wsgi.input").read(length).decode().asString

  //[ The request body as a JSON object, or an empty one
    !
    ! A missing, empty, or malformed body yields `{}` rather than raising, so a
    ! handler's own validation answers with its own 400 instead of the request
    ! dying in a traceback. A client that sends nothing and a client that sends
    ! `{}` are the same thing to every caller here.
  //]
  def readJson(): py.Dict receives request =
    match py.try(json.loads(readBody()))
    case Ok(value) =>
      if py.isInstance(value, builtins.dict) then value.cast[py.Dict] else py.dict()
    case Err(_) => py.dict()

  def queryParam(key: String): String receives request =
    val qs = request.environ.get("QUERY_STRING", "").asString
    val params = py.module("urllib.parse").parse_qs(qs).cast[py.Dict]
    if params.contains(key) then params.get(key).cast[py.List].get(0).asString else ""

  //[ A complete, non-streamed response from a string body
    !
    ! `no-store`, because everything answered this way is an agent's own reply,
    ! a session list, or an error — none of it is a client's to keep. A file
    ! that IS cacheable goes through `respondStatic`.
  //]
  def respond(status: Status.Code, kind: Mime.Type, body: String): py.List receives request =
    val headers = py.list:
      py.tuple("Content-Type", Mime.value(kind))
      py.tuple("Cache-Control", "no-store")

    py.call(request.startResponse, Status.line(status), headers)
    py.list(py.dynamic(body).encode())

  def respondHtml(body: String): py.List receives request =
    respond(Status.Success, Mime.Html, body)

  def respondJson(dict: py.Dict): py.List receives request =
    respond: Status.Success, Mime.Json, json.dumps(dict)

  //[ An asset that may be cached, answered with an `ETag` and a 304 when it can
    !
    ! For a page, stylesheet or script read from disk per request. The tag is
    ! content-derived, so editing the file changes it and the browser refetches,
    ! while an unchanged file costs a conditional request and no body at all.
    ! `must-revalidate` keeps that check on every load, which is what makes
    ! editing-without-restart safe to cache.
  //]
  def respondStatic(kind: Mime.Type, body: String): py.List receives request =
    val tag = etag(body)
    val cache = "public, max-age=0, must-revalidate"

    if request.environ.get("HTTP_IF_NONE_MATCH", "").asString == tag then
      py.call:
        request.startResponse
        Status.line(Status.NotModified)
        py.list(py.tuple("ETag", tag), py.tuple("Cache-Control", cache))
      py.list()

    else
      py.call:
        request.startResponse
        Status.line(Status.Success)
        py.list:
          py.tuple("Content-Type", Mime.value(kind))
          py.tuple("ETag", tag)
          py.tuple("Cache-Control", cache)
      py.list(py.dynamic(body).encode())

  //[ A content-derived entity tag. Not a digest anyone verifies — just a change detector. //]
  private def etag(body: String): String =
    val digest = py.module("hashlib").blake2b(py.dynamic(body).encode(), digest_size = 8)
    "\"" + digest.hexdigest().asString + "\""

  //[ A streamed response: headers go out now, and `produce` emits as it goes
    !
    ! How a long-running turn reaches the tab that asked for it, a line at a
    ! time, instead of arriving whole at the end. `produce` runs on this
    ! request's thread and is handed an `emit` it calls per chunk.
    !
    ! Built on WSGI's `write` callable rather than a returned iterable, which
    ! would need the producer to be pull-shaped — a turn pushes into a sink, so
    ! the iterable form would mean a queue and a second thread per stream. Both
    ! forms were measured to flush per chunk on waitress and wsgiref. The
    ! callable is confined to this function, so a server that ever needs the
    ! iterable form changes only here.
  //]
  def stream(kind: Mime.Type, produce: (String => Unit) => Unit): py.List receives request =
    val headers = py.list:
      py.tuple("Content-Type", Mime.value(kind))
      py.tuple("Cache-Control", "no-cache")
      py.tuple("X-Accel-Buffering", "no")

    val write = py.call(request.startResponse, Status.line(Status.Success), headers)
    produce((chunk: String) => py.call(write, py.dynamic(chunk).encode()))
    py.list()

  //[ A response whose body is bytes rather than text, with the caller's headers. //]
  def respondBytes(status: Status.Code, headers: py.List, body: py.Dynamic): py.List receives request =
    py.call(request.startResponse, Status.line(status), headers)
    py.list(body)

  def notFound(): py.List receives request =
    respond: Status.NotFound, Mime.Json, json.dumps(py.dict("error" ~ "not_found"))

  //[ A route as a plain WSGI application — the seam a deployment binds a server to
    !
    ! Two refusals happen here rather than in any route: a verb this plumbing
    ! does not implement, and a body larger than `maxBodyBytes`. Both are
    ! protocol-level answers that no handler should have to remember.
    !
    ! Thin on purpose. What it does is adapt a calling convention — `environ`
    ! and `start_response` in, the ambient request bound, an iterable out — and
    ! its worth is that it is separable, not that it is large. An exception
    ! reaching the top of a route is deliberately left to the server, which
    ! already answers 500 before the response begins and closes the connection
    ! after it, and knows which of the two happened.
  //]
  def app(route: () => py.List receives request): (py.Dynamic, py.Dynamic) => py.List =
    (environ: py.Dynamic, startResponse: py.Dynamic) =>
      match requestFrom(environ, startResponse)
      case None => unsupportedMethod(startResponse)
      case Some(asked) =>
        if declaredLength(environ) > maxBodyBytes then
          refuse(startResponse, Status.TooLarge, "request body too large")
        else
          with request = asked in route()

  //[ Stop `httpd` writing an access line per request to stderr
    !
    ! `wsgiref` logs every exchange, which a page that polls turns into a line a
    ! second in whatever terminal the driver is using. Its handler calls
    ! `log_message` for that, so pointing the name at a logger nobody has
    ! configured drops the line. An unhandled exception still surfaces: that goes
    ! to `wsgi.errors` rather than through `log_message`.
    !
    ! Separate from `server` because it is a caller's decision, like the banner
    ! and the signal handler: a server answering a person wants its access log,
    ! and one answering a poller does not.
  //]
  def quiet(httpd: py.Dynamic): Unit =
    val wsgi = py.module("wsgiref.simple_server")
    val discard = py.module("logging").getLogger("harpe.http").debug
    val handler = builtins.newType:
      "QuietWSGIRequestHandler"
      py.tuple(wsgi.WSGIRequestHandler)
      py.dict("log_message" ~ discard)

    py.module("builtins").setattr(httpd, "RequestHandlerClass", handler)

  //[ A threaded wsgiref server — FOR DEVELOPMENT AND TESTS
    !
    ! `wsgiref` is the standard library's reference implementation, built on
    ! `http.server`, which its own documentation says is not for production: no
    ! read timeout, so a client that connects and stays silent holds a thread
    ! indefinitely, an accept backlog of five, and HTTP/1.0 with no keep-alive.
    ! A deployment binds a real server to `app` instead, in its own code:
    !
    !     val httpd = py.module("waitress").create_server:
    !       Http.app(() => server.route())
    !       host = host
    !       port = port
    !       threads = 32
    !
    ! Sizing that pool is the deployment's, and a streaming response holds one
    ! worker for its whole life — so it wants room for every turn and every open
    ! subscription at once, not just the requests in flight.
    !
    ! One request per thread here, so a page stays responsive while another
    ! request is doing something slow. Whatever the route touches must therefore
    ! be safe to touch concurrently. `daemon_threads` lets Ctrl-C exit without
    ! joining in-flight workers.
    !
    ! Returns the server rather than serving: the caller prints its banner,
    ! installs signal handlers, and decides when to `serve_forever`.
  //]
  def server(host: String, port: Int, route: () => py.List receives request): py.Dynamic =
    val wsgi = py.module("wsgiref.simple_server")
    val threaded = builtins.newType:
      "ThreadingWSGIServer"
      py.tuple(py.module("socketserver").ThreadingMixIn, wsgi.WSGIServer)
      py.dict("daemon_threads" ~ true)

    wsgi.make_server(host, port, app(route), server_class = threaded)
end
