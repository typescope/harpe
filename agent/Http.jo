//[ Http.jo
  !
  ! WSGI plumbing: reading a request, and writing a response.
  !
  ! Nothing here knows what an agent is. It exists because harpe serves HTTP in
  ! more than one place — the journal viewer here, a driver's own pages — and
  ! status lines, verb handling and body reading are worth having a single copy
  ! of. A second `405`-vs-`501` rule is the kind of difference nobody notices
  ! until it matters.
  !
  ! THE REQUEST IS AMBIENT. A server binds one per request and every function
  ! here reads it, so a handler that wants the body asks for `Http.readJson()`
  ! rather than being handed an `environ` to pass on. That is why route handlers
  ! carry neither `environ` nor `startResponse`: they never touch either except
  ! through this file.
  !
  ! `app` IS THE SEAM. It turns a route into a plain WSGI application, so a
  ! deployment runs it on whichever WSGI server it chooses. harpe installs none,
  ! and nothing here depends on a package outside the standard library.
  !
  ! `app` ALSO GUARDS THE DOOR. Before any route runs it refuses an unknown verb,
  ! a path that is not UTF-8, a `Host` the `Settings` do not name, a cross-site
  ! write, and a body over the limit. Those are protocol answers every browser
  ! facing app needs, and none of them is a route's to remember.
  !
  ! FOR A SINGLE-PAGE APPLICATION OR AN API, not for server-rendered pages.
  ! What it serves is JSON, streams, and files read from disk — a page is a
  ! file. There is no template engine here, so nothing escapes HTML, and
  ! anything interpolated into a page is the application's to escape.
  !
  ! Deliberately thin. Sessions, authentication and base-URL resolution are
  ! application policy, not plumbing, and belong to whoever needs them.
//]

namespace harpe

import harpe.ffi.json
import harpe.ffi.builtins
import harpe.ffi.threading
import harpe.ffi.os
import harpe.util.File
import harpe.util.Clock

section Http
  //[ The verb, as a value rather than a string
    !
    ! Closed on purpose: these five are what a server here understands, and
    ! anything else, HEAD included, is refused at the door with a 501 rather than
    ! carried inward as a string nothing will ever match. `Options` is named
    ! because browsers really do send it — it matches no route, but it is a
    ! deliberate 404 rather than an accident of `method == "GET"` being false.
    !
    ! `Options` rather than `Option`, which is Jo's own.
  //]
  section Verb
    union Method = Get | Post | Put | Delete | Options
  end

  //[ The status, as a value rather than a string
    !
    ! Same reason as the verb: `"200 0K"` is a string a compiler cannot refuse,
    ! and a status line is written at every response site. Add a case rather
    ! than passing a literal. `Other` is for a status decided at runtime, such
    ! as one relayed from upstream.
  //]
  section Status
    union Code =
        Success
      | Created
      | NoContent
      | SeeOther
      | NotModified
      | BadRequest
      | Unauthorized
      | Forbidden
      | NotFound
      | MethodNotAllowed
      | Conflict
      | TooLarge
      | UnsupportedMediaType
      | TooManyRequests
      | ServerError
      | NotImplemented
      | Unavailable
      | Other(code: Int, reason: String)

    //[ The status line WSGI expects. //]
    def line(code: Code): String =
      match code
      case Success              => "200 OK"
      case Created              => "201 Created"
      case NoContent            => "204 No Content"
      case SeeOther             => "303 See Other"
      case NotModified          => "304 Not Modified"
      case BadRequest           => "400 Bad Request"
      case Unauthorized         => "401 Unauthorized"
      case Forbidden            => "403 Forbidden"
      case NotFound             => "404 Not Found"
      case MethodNotAllowed     => "405 Method Not Allowed"
      case Conflict             => "409 Conflict"
      case TooLarge             => "413 Payload Too Large"
      case UnsupportedMediaType => "415 Unsupported Media Type"
      case TooManyRequests      => "429 Too Many Requests"
      case ServerError          => "500 Internal Server Error"
      case NotImplemented       => "501 Not Implemented"
      case Unavailable          => "503 Service Unavailable"
      case Other(code, reason)  => "\{code} \{reason}"
  end

  //[ The content type, with its charset settled here rather than at each site
    !
    ! `Other` carries a type resolved at runtime — a file's own, from
    ! `File.mimeType`. Everything a handler names in source should be a case, so
    ! that the charset decision is made once.
  //]
  section Mime
    union Type = Html | Json | Ndjson | EventStream | Text | Css | JavaScript | Other(value: String)

    def value(kind: Type): String =
      match kind
      case Html        => "text/html; charset=utf-8"
      case Json        => "application/json"
      case Ndjson      => "application/x-ndjson"
      case EventStream => "text/event-stream; charset=utf-8"
      case Text        => "text/plain; charset=utf-8"
      case Css         => "text/css; charset=utf-8"
      case JavaScript  => "application/javascript; charset=utf-8"
      case Other(raw)  => raw
  end

  //[ Which `Host` names a request may carry
    !
    ! Checking it is what defeats DNS rebinding, where a hostile page points its
    ! own name at a server on loopback and reads it as same-origin. `Named`
    ! compares one name without its port, case-insensitively. `Unchecked` is for
    ! a server whose proxy already checks. A server reached by several names, or
    ! by a pattern, is a case to add here.
  //]
  section Host
    union Policy =
        Loopback
      | Named(name: String)
      | Unchecked
  end

  //[ Whether a browser on another site may send a write
    !
    ! `Refuse` answers 403 to a POST, PUT or DELETE a browser marks as
    ! cross-site, which is CSRF protection with no token to thread through
    ! forms. Clients that are not browsers send neither header it reads, so an
    ! API client or a webhook still gets through.
  //]
  section CrossSite
    union Policy = Refuse | Allow
  end

  //[ The routes an application answers, and what each one allows
    !
    ! A table rather than a chain of patterns, so the policy of a route sits
    ! with the route, and `wsgi` can read it before the handler runs — which is
    ! what makes a body limit per route possible at all.
    !
    ! Paths are compared exactly. `Prefix` is for the one path that carries a
    ! parameter in a single-page application, an asset under a directory, and
    ! the handler reads `request.path` for the rest.
  //]
  section Router
    //[ One route. `maxBodyBytes` of 0 takes the application's own limit. //]
    class Route(
          method: Verb.Method,
          path: String,
          prefix: Bool,
          maxBodyBytes: Int,
          handler: () => Response receives request)

    def Get(
        path: String,
        handler: (() => Response receives request),
        maxBodyBytes: Int = 0): Route =
      new Route(Verb.Get, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

    def Post(
        path: String,
        handler: (() => Response receives request),
        maxBodyBytes: Int = 0): Route =
      new Route(Verb.Post, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

    def Put(
        path: String,
        handler: (() => Response receives request),
        maxBodyBytes: Int = 0): Route =
      new Route(Verb.Put, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

    def Delete(
        path: String,
        handler: (() => Response receives request),
        maxBodyBytes: Int = 0): Route =
      new Route(Verb.Delete, path, prefix = false, maxBodyBytes = maxBodyBytes, handler = handler)

    //[ Every GET under `path`, which must end in `/` — the assets of a page
      !
      ! The handler reads `request.path` for the rest. The longest matching
      ! prefix wins, so `/assets/img/` can sit under `/assets/`.
    //]
    def GetUnder(
        path: String,
        handler: (() => Response receives request),
        maxBodyBytes: Int = 0): Route =
      if !path.endsWith("/") then abort "a prefix route's path must end in '/': '\{path}'"
      new Route(Verb.Get, path, prefix = true, maxBodyBytes = maxBodyBytes, handler = handler)
  end

  //[ One application: its routes, and the policy `wsgi` enforces before any of them
    !
    ! `fallback` answers what no route claims — the page itself, for a
    ! single-page application whose client routes on the path. An application
    ! that dispatches by pattern matching passes no routes and its own match as
    ! the fallback.
    !
    ! `maxBodyBytes` is the limit for every route that names none. Keep it
    ! small: an upload route says so for itself, and `ceiling` is what the
    ! server is given.
    !
    ! `host` defaults to loopback, so a prototype on `127.0.0.1` runs as it is,
    ! and a deployment that forgets to name its own host is refused rather than
    ! quietly served — which is what stops a hostile page pointing its own name
    ! at this server and reading it as same-origin.
  //]
  class Application(
        routes: List[Router.Route],
        fallback: (() => Response receives request),
        host: Host.Policy = Host.Loopback,
        maxBodyBytes: Int = 1048576,
        crossSite: CrossSite.Policy = CrossSite.Refuse)
    //[ This application as a WSGI application, which is what a server is given
      !
      ! The route table is indexed here, once, and two routes claiming one verb
      ! and path abort rather than shadowing each other.
    //]
    def wsgi(): (py.Dynamic, py.Dynamic) => py.List =
      val exact = py.dict()
      for route in routes do
        if !route.prefix then
          val key = verbName(route.method) + " " + route.path
          if exact.contains(key) then abort "two routes claim '\{key}'"
          exact.set(key, route)

      (environ: py.Dynamic, startResponse: py.Dynamic) =>
        write(startResponse, answer(this, exact, environ))

    //[ The largest body any route allows, which is the limit to give the server. //]
    def ceiling: Int =
      var most = maxBodyBytes
      for route in routes do
        if route.maxBodyBytes > most then most = route.maxBodyBytes
      most
  end

  //[ One response header. A CR or LF in either part aborts, since it would split the response. //]
  class Header(name: String, value: String)

  //[ What a route answers with
    !
    ! A value, so a route can be called and its answer inspected without a
    ! server, and a wrapper can add to what it answers. `app` is the only place
    ! one is written to WSGI, and it adds `X-Content-Type-Options: nosniff` to
    ! every one.
    !
    ! `Complete` carries every header it sends, and the builders in `Response`
    ! fill in `Content-Type` and `Cache-Control`. `Stream` answers 200 and hands
    ! `produce` an `emit` once the headers are out.
  //]
  union Response =
      Complete(status: Status.Code, headers: List[Header], body: py.Dynamic)
    | Stream(kind: Mime.Type, produce: (String => Bool) => Unit)

  //[ The builders a route answers with. Import `harpe.Http.Response` and write `Response.html(…)`. //]
  section Response
    //[ A complete response from a text body
      !
      ! `no-store`, because what is answered this way is dynamic and none of it
      ! is a client's to keep. One the browser may keep goes through `revalidated`.
      ! `headers` are sent after `Content-Type` and `Cache-Control`.
    //]
    def complete(status: Status.Code, kind: Mime.Type, headers: List[Header], body: String): Response =
      binary(status, kind, headers, py.dynamic(body).encode())

    //[ A complete response from a binary body, with the same headers as `complete`. //]
    def binary(status: Status.Code, kind: Mime.Type, headers: List[Header], body: py.Dynamic): Response =
      val fixed = [Header("Content-Type", Mime.value(kind)), Header("Cache-Control", "no-store")]
      Complete(status, fixed ++ headers, body)

    def html(body: String): Response =
      complete(Status.Success, Mime.Html, [], body)

    def json(dict: py.Dict): Response =
      complete(Status.Success, Mime.Json, [], jsonText(dict))

    //[ A `Set-Cookie` header to send with a response
      !
      ! Always `Path=/`, `HttpOnly` and `SameSite=Lax`, so a script cannot read
      ! it and a cross-site POST does not carry it. `secure` adds `Secure`,
      ! which browsers accept on `http://localhost` too. A `maxAgeSeconds` of 0
      ! deletes the cookie, which is what logging out sends. A name or value
      ! that would need quoting aborts.
      !
      ! It answers a `Header`, not a `Response`, because a cookie rides with
      ! whatever response the route is already building.
    //]
    def cookie(name: String, value: String, maxAgeSeconds: Int, secure: Bool): Header =
      if !cookieSafe(name) || name == "" then abort "cookie name '\{name}' is not a token"
      if !cookieSafe(value) then abort "cookie value for '\{name}' needs encoding"

      val attributes = "; Path=/; Max-Age=\{maxAgeSeconds}; HttpOnly; SameSite=Lax"
      Header("Set-Cookie", name + "=" + value + attributes + (if secure then "; Secure" else ""))

    //[ The same, carrying a value `Http.signedCookie` will only read back unaltered
      !
      ! `maxAgeSeconds` sets both the browser's `Max-Age` and the expiry inside
      ! the signature, so the two cannot drift. The value is signed, not
      ! encrypted, and rides on every request, so keep it small and keep secrets
      ! out of it. The secret is the application's, and must be at least 32
      ! characters.
    //]
    def signedCookie(name: String, value: String, secret: String, maxAgeSeconds: Int, secure: Bool): Header =
      val encoded = py.module("base64").urlsafe_b64encode(py.dynamic(value).encode()).decode().asString.replace("=", "")
      val expiry = (Clock.now().toInt + maxAgeSeconds).toString
      val signed = encoded + "." + expiry + "." + signCookie(name, encoded, expiry, secret)
      cookie(name, signed, maxAgeSeconds, secure)

    //[ A 303 to `location`, the redirect a browser follows with a GET after a form post. //]
    def redirect(location: String): Response =
      complete(Status.SeeOther, Mime.Text, [Header("Location", location)], "")

    def notFound(): Response =
      complete(Status.NotFound, Mime.Json, [], jsonText(py.dict("error" ~ "not_found")))

    //[ A 400 naming what was wrong, short enough to sit on the right of a `rescue`:
      !
      !     val body = Http.readJson() rescue None => return Response.badRequest("expected a JSON object")
    //]
    def badRequest(detail: String): Response =
      complete(Status.BadRequest, Mime.Json, [], jsonText(py.dict("error" ~ "bad_request", "detail" ~ detail)))

    //[ `response`, which the user's browser may keep but must recheck on every load
      !
      !     Response.revalidated(Response.html(page()))
      !
      ! Adds a content-derived `ETag` and `Cache-Control: private, no-cache`. The
      ! route still runs on every load, and `app` answers 304 only when the body
      ! is byte-for-byte what the browser holds, so a copy is never stale and
      ! never another user's. The one question at the call site: may this body
      ! sit in the user's browser cache? A stream has no body to tag, so
      ! revalidating one aborts.
    //]
    def revalidated(response: Response): Response =
      match response
      case Stream(_, _) => abort "a stream cannot be revalidated"
      case Complete(status, headers, body) =>
        val kept = headers.exclude(h => py.dynamic(h.name).lower().asString == "cache-control")
        Complete(status, kept ++ [Header("Cache-Control", "private, no-cache"), Header("ETag", etag(body))], body)

    //[ A streamed response, whose `produce` emits a chunk at a time
      !
      ! How a long-running turn reaches the tab that asked for it, instead of
      ! arriving whole at the end. `produce` runs on the request's thread once
      ! the headers are out.
      !
      ! `emit` answers whether the client is still there. A failed write means it
      ! is not, whichever server raised which exception for it, so every later
      ! `emit` returns false without writing and the producer can stop its work.
      !
      ! Written through WSGI's `write` callable rather than a returned iterable,
      ! which would need the producer to be pull-shaped — a turn pushes into a
      ! sink, so the iterable form would mean a queue and a second thread per
      ! stream. Both forms were measured to flush per chunk on waitress and
      ! wsgiref.
    //]
    def stream(kind: Mime.Type, produce: (String => Bool) => Unit): Response =
      Stream(kind, produce)

    //[ Whether a browser shows a file or saves it. //]
    union Disposition = Inline | Attachment

    //[ The file under `root` that `name` names, revalidated
      !
      ! `name` is a relative path, as a client sent it. A name that is empty,
      ! absolute, has a `..` segment, or resolves outside `root` through a
      ! symlink is a 404, and so is a directory or a missing file, so a client
      ! cannot tell which. The type is guessed from the name. The whole file is
      ! read into memory, which suits pages, assets and documents, not video.
    //]
    def file(root: String, name: String, disposition: Disposition): Response =
      val target = resolve(root, name) rescue None => return notFound()
      val guessed = File.mimeType(target).getOrElse("application/octet-stream")
      val shown = Header("Content-Disposition", dispositionValue(disposition, os.path.basename(name)))
      revalidated(binary(Status.Success, Mime.Other(charset(guessed)), [shown], File.readBytes(target)))

    //[ A text type with its charset settled, as the `Mime` cases have theirs
      !
      ! `mimetypes` answers a bare `text/html`, and a browser left to guess the
      ! encoding of a UTF-8 page renders it wrong.
    //]
    private def charset(kind: String): String =
      val text = kind.startsWith("text/") || kind == "application/javascript" || kind == "application/json"
      if text then kind + "; charset=utf-8" else kind

    //[ The real path of `name` under `root`, or None when it is not a file inside it. //]
    private def resolve(root: String, name: String): Option[String] =
      val refused = name == "" || name.startsWith("/") || name.contains("\\") || name.contains("\u{0}")
      if refused || name.split("/").contains("..") then return None

      val base = os.path.realpath(root)
      val target = os.path.realpath(os.path.join(base, name))
      if target.startsWith(base + "/") && os.path.isfile(target) then Some(target) else None

    //[ `inline` or `attachment`, naming the file both as ASCII and, per RFC 6266, as UTF-8. //]
    private def dispositionValue(disposition: Disposition, filename: String): String =
      val kind = match disposition
                 case Inline     => "inline"
                 case Attachment => "attachment"
      val ascii = py.module("re").sub("[^ -~]|[\"\\\\]", "_", filename).asString
      val encoded = py.module("urllib.parse").quote(filename, safe = "").asString
      kind + "; filename=\"" + ascii + "\"; filename*=UTF-8''" + encoded

    //[ A content-derived entity tag. Not a digest anyone verifies — just a change detector. //]
    private def etag(body: py.Dynamic): String =
      val digest = py.module("hashlib").blake2b(body, digest_size = 8)
      "\"" + digest.hexdigest().asString + "\""
  end

  //[ `dict` as JSON text. Outside `Response`, whose `json` would shadow the module. //]
  private def jsonText(dict: py.Dict): String = json.dumps(dict)

  //[ What was asked. `path` is already decoded as UTF-8. //]
  class Request(method: Verb.Method, path: String, environ: py.Dynamic)
    //[ Whether a reader has taken the body, which WSGI hands over as a stream read once. //]
    var bodyTaken: Bool = false
  end

  //[ Request patterns keep the verb and path test together at dispatch sites
    !
    ! The path is compared exactly, so every route is one string. A parameter
    ! travels as a query parameter or in the body, which is uniform for a client
    ! that builds its own requests. A path that does carry one — an asset under
    ! a prefix — binds the path and guards on it:
    !
    !     case Http.Get(path) if path.startsWith("/assets/") =>
    !       Response.file(root, path.substring(8, path.size - 8), Response.Inline)
  //]
  pattern Get(path: String): Partial[Request] =
    case asked if asked.method is Verb.Get then path = asked.path

  pattern Post(path: String): Partial[Request] =
    case asked if asked.method is Verb.Post then path = asked.path

  pattern Put(path: String): Partial[Request] =
    case asked if asked.method is Verb.Put then path = asked.path

  pattern Delete(path: String): Partial[Request] =
    case asked if asked.method is Verb.Delete then path = asked.path

  //[ `"/sessions/42/"` as `["sessions", "42"]`
    !
    ! Split ONCE, where a route needs the parts of a path, and match the list:
    !
    !     case Http.Get(path) if path.startsWith("/sessions/") =>
    !       match Http.segments(path)
    !       case ["sessions", id] => …
    !
    ! There was a `Segments` pattern that did this inside each case, which meant
    ! splitting the path again for every case it appeared in — measured at 328us
    ! across twenty routes, against 74us for a whole request.
    !
    ! Empty segments are dropped, so `/sessions/`, `/sessions`, and
    ! `//sessions//` all split the same way. `/` is the empty list.
  //]
  def segments(path: String): List[String] =
    path.split("/").exclude(part => part == "")

  //[ The request being served. Bound once per request by the server. //]
  param request: Request

  private def verb(raw: String): Option[Verb.Method] =
    if raw == "GET" then Some(Verb.Get)
    else if raw == "POST" then Some(Verb.Post)
    else if raw == "PUT" then Some(Verb.Put)
    else if raw == "DELETE" then Some(Verb.Delete)
    else if raw == "OPTIONS" then Some(Verb.Options)
    else None

  //[ `PATH_INFO` as the client wrote it
    !
    ! PEP 3333 hands the path over as bytes decoded as Latin-1, so `/café`
    ! arrives as `/cafÃ©`. Undoing that here is the only way a route can match a
    ! non-ASCII segment. None when the bytes are not UTF-8.
  //]
  private def decodedPath(environ: py.Dynamic): Option[String] =
    val raw = py.dynamic(environ.get("PATH_INFO", "/"))
    match py.try(raw.encode("latin-1").decode("utf-8").asString)
    case Ok(path) => Some(path)
    case Err(_)   => None

  //[ A refusal made before a request is bound. //]
  private def refuse(status: Status.Code, message: String): Response =
    Response.complete(status, Mime.Text, [], message)

  //[ What `CONTENT_LENGTH` claims, or zero. //]
  private def declaredLength(environ: py.Dynamic): Int =
    Int.parse(environ.get("CONTENT_LENGTH", "").asString) rescue None => 0

  //[ The value of a WSGI environ key, or None when it is absent. //]
  private def environValue(environ: py.Dynamic, key: String): Option[String] =
    val found = environ.get(key)
    if py.isNone(found) then None else Some(found.asString)

  //[ The environ key WSGI files a request header under. //]
  private def environKey(name: String): String =
    val key = py.dynamic(name).upper().asString.replace("-", "_")
    if key == "CONTENT_TYPE" || key == "CONTENT_LENGTH" then key else "HTTP_" + key

  //[ A `Host` or `Origin` authority reduced to its lower-case hostname, without port or brackets. //]
  private def hostname(authority: String): Option[String] =
    match py.try(py.module("urllib.parse").urlsplit("//" + authority).hostname)
    case Ok(name) => if py.isNone(name) then None else Some(name.asString)
    case Err(_)   => None

  private def hostAllowed(environ: py.Dynamic, policy: Host.Policy): Bool =
    match policy
    case Host.Unchecked => true
    case Host.Loopback  => nameIn(environ, ["localhost", "127.0.0.1", "::1"])
    case Host.Named(name)  => nameIn(environ, [py.dynamic(name).lower().asString])

  private def nameIn(environ: py.Dynamic, names: List[String]): Bool =
    match environValue(environ, "HTTP_HOST")
    case None => false
    case Some(authority) =>
      match hostname(authority)
      case Some(name) => names.contains(name)
      case None       => false

  //[ Is this a write a browser sent from another site?
    !
    ! Go's `CrossOriginProtection` algorithm. `Sec-Fetch-Site` decides when a
    ! browser sent it. Otherwise an `Origin` must name the same authority as
    ! `Host`. A request carrying neither did not come from a browser page.
  //]
  private def crossSiteWrite(method: Verb.Method, environ: py.Dynamic): Bool =
    val writes = method is Verb.Post || method is Verb.Put || method is Verb.Delete
    if !writes then false
    else
      match environValue(environ, "HTTP_SEC_FETCH_SITE")
      case Some(site) => site != "same-origin" && site != "none"
      case None =>
        match environValue(environ, "HTTP_ORIGIN")
        case None => false
        case Some(origin) =>
          val netloc = py.module("urllib.parse").urlsplit(origin).netloc.asString
          val host = environValue(environ, "HTTP_HOST").getOrElse("")
          py.dynamic(netloc).lower().asString != py.dynamic(host).lower().asString

  //[ A request header, or None when the client did not send it. //]
  def header(name: String): Option[String] receives request =
    environValue(request.environ, environKey(name))

  //[ The first value of a query parameter
    !
    ! None when the parameter is absent. `?q=` is `Some("")`, so a handler can
    ! tell an empty value from a missing one.
  //]
  def queryParam(key: String): Option[String] receives request =
    val qs = request.environ.get("QUERY_STRING", "").asString
    firstValue(py.module("urllib.parse").parse_qs(qs, keep_blank_values = true).cast[py.Dict], key)

  private def firstValue(params: py.Dict, key: String): Option[String] =
    if params.contains(key) then Some(params.get(key).cast[py.List].get(0).asString) else None

  //[ A cookie the client sent, or None
    !
    ! Parsed leniently, as browsers write them, rather than with `http.cookies`,
    ! which drops every cookie once one on the same domain is malformed. The
    ! first of two same-named cookies wins, which is the one with the longest
    ! path.
  //]
  def cookie(name: String): Option[String] receives request =
    val raw = header("Cookie") rescue None => return None

    for chunk in raw.split(";") do
      val pair = py.dynamic(chunk.trim).split("=", 1).cast[py.List]
      if pair.size == 2 && pair.get(0).asString.trim == name then
        val value = pair.get(1).asString.trim
        val quoted = value.size >= 2 && value.startsWith("\"") && value.endsWith("\"")
        return Some(if quoted then value.substring(1, value.size - 2) else value)

    None

  //[ The value of a signed cookie, or None
    !
    ! None when the cookie is missing, was altered, was moved to another name,
    ! or has passed the expiry it was signed with, and a caller cannot tell
    ! those apart. Signing proves the value is the one this application wrote.
    ! It does NOT hide it: whoever holds the cookie can read it, so a user id
    ! belongs here and a secret does not.
    !
    ! The expiry the server enforces is the signed one, not the browser's
    ! `Max-Age`. Nothing here can be revoked before it expires — an application
    ! that must revoke keeps state of its own, such as a deny list.
  //]
  def signedCookie(name: String, secret: String): Option[String] receives request =
    val raw = cookie(name) rescue None => return None
    val parts = raw.split(".")
    if parts.size != 3 then return None

    val value = parts.get(0)
    val expiry = parts.get(1)
    val signature = signCookie(name, value, expiry, secret)
    if !py.module("hmac").compare_digest(signature, parts.get(2)).asBool then return None

    val deadline = Int.parse(expiry) rescue None => return None
    if deadline <= Clock.now().toInt then return None

    val decoded = py.try(py.module("base64").urlsafe_b64decode(value + "===").decode("utf-8").asString) rescue Err(_) => return None
    Some(decoded)

  //[ `HMAC-SHA256` over the cookie's name, value and expiry, base64url without padding
    !
    ! The NAME is signed too, so a cookie cannot be moved to another name — a
    ! value signed as one cookie replayed as another would otherwise pass.
  //]
  private def signCookie(name: String, value: String, expiry: String, secret: String): String =
    if secret.size < 32 then abort "a cookie secret must be at least 32 characters"

    val message = py.dynamic(name + "." + value + "." + expiry).encode()
    val digest = py.module("hmac").digest(py.dynamic(secret).encode(), message, "sha256")
    py.module("base64").urlsafe_b64encode(digest).decode().asString.replace("=", "")

  //[ Printable ASCII with none of the separators a cookie cannot carry unquoted. //]
  private[harpe] def cookieSafe(text: String): Bool =
    !py.isNone(py.module("re").fullmatch("[!#-+\\--:<-\\[\\]-~]*", text))

  //[ The media type of the body, lower-cased and without its parameters. //]
  private def mediaType(): String receives request =
    val kind = header("Content-Type").getOrElse("")
    py.dynamic(kind.split(";").get(0).trim).lower().asString

  //[ The request body as bytes
    !
    ! Reads exactly what `CONTENT_LENGTH` declares, with no cap of its own:
    ! `app` has already refused a declaration over `Settings.maxBodyBytes`. The
    ! body is a stream, so a second read in one request aborts rather than
    ! returning nothing.
  //]
  def readBytes(): py.Dynamic receives request =
    if request.bodyTaken then abort "the request body was already read"
    request.bodyTaken = true
    request.environ.get("wsgi.input").read(declaredLength(request.environ))

  //[ The request body as text, or None when it is not UTF-8. //]
  def readBody(): Option[String] receives request =
    val bytes = readBytes()
    match py.try(bytes.decode("utf-8").asString)
    case Ok(text) => Some(text)
    case Err(_)   => None

  //[ The request body as a JSON object
    !
    ! None unless the request says `application/json` and the body parses to an
    ! object. A handler answers that with its own 400. Requiring the content type
    ! also makes a browser preflight any cross-site attempt to send it.
  //]
  def readJson(): Option[py.Dict] receives request =
    if mediaType() != "application/json" then return None
    val text = readBody() rescue None => return None
    val value = py.try(json.loads(text)) rescue Err(_) => return None
    if py.isInstance(value, builtins.dict) then Some(value.cast[py.Dict]) else None

  //[ Server-sent event framing, for a `Response.stream` of `Mime.EventStream`
    !
    ! The browser's `EventSource` reads these and reconnects on its own. Every
    ! line of `data` becomes its own `data:` field, which the browser rejoins.
  //]
  section Sse
    //[ An event the page listens for by `name`. //]
    def event(name: String, data: String): String =
      if name.contains("\r") || name.contains("\n") then abort "event name contains a line break"
      "event: " + name + "\n" + fields(data)

    //[ An unnamed event, delivered to `onmessage`. //]
    def message(data: String): String = fields(data)

    //[ A comment line, which keeps an idle stream open through a proxy's read timeout. //]
    def keepalive(): String = ":\n\n"

    private def fields(data: String): String =
      val lines = data.replace("\r\n", "\n").replace("\r", "\n").split("\n")
      lines.map(line => "data: " + line + "\n").join("") + "\n"
  end

  //[ A route as a plain WSGI application — the seam a deployment binds a server to
    !
    ! Refuses, in order and before the route runs: a verb not implemented (501,
    ! not 405, because no path has been looked at), a path that is not UTF-8
    ! (400), a `Host` the settings do not allow (400), a cross-site write (403),
    ! and a body declaring more than `maxBodyBytes` (413).
    !
    ! The 413 is written without draining what the client is still sending, so a
    ! client mid-upload may see the connection close first. Give the server its
    ! own limit too, which can discard the body properly.
    !
    ! A route that raises is left to the server, which answers 500 and logs it.
    ! An application wanting its own answer, logged with the session it belongs
    ! to, wraps its own routes: only it knows that context.
  //]
  private def answer(application: Application, exact: py.Dict, environ: py.Dynamic): Response =
    val raw = environ.get("REQUEST_METHOD", "GET").asString
    val method = verb(raw) rescue None =>
      return if raw == "HEAD" then unsupportedHead() else refuse(Status.NotImplemented, "not implemented")
    val path = decodedPath(environ) rescue None =>
      return refuse(Status.BadRequest, "path is not UTF-8")

    if !hostAllowed(environ, application.host) then
      val sent = environValue(environ, "HTTP_HOST").getOrElse("none")
      return refuse(Status.BadRequest, "host '\{sent}' is not one this application answers to")
    if application.crossSite is CrossSite.Refuse && crossSiteWrite(method, environ) then
      return refuse(Status.Forbidden, "cross-site request refused")

    val found = routeFor(application, exact, method, path)
    if declaredLength(environ) > limitFor(application, found) then
      return refuse(Status.TooLarge, "request body too large")

    match found
    case Some(route) => ran(route.handler, method, path, environ)
    case None =>
      val others = otherVerbs(application, method, path)
      if others.size == 0 then ran(application.fallback, method, path, environ)
      else
        val headers = [Header("Allow", others.join(", "))]
        Response.complete(Status.MethodNotAllowed, Mime.Text, headers, "method not allowed")

  //[ Run `handler` with the request bound, and answer 304 in place of a body the client holds. //]
  private def ran(handler: (() => Response receives request), method: Verb.Method, path: String, environ: py.Dynamic): Response =
    val answered = with request = new Request(method, path, environ) in handler()
    if unchanged(method, environ, answered) then notModified(answered) else answered

  //[ What this exchange may send: the route's own limit, or the application's. //]
  private def limitFor(application: Application, found: Option[Router.Route]): Int =
    match found
    case Some(route) => if route.maxBodyBytes == 0 then application.maxBodyBytes else route.maxBodyBytes
    case None        => application.maxBodyBytes

  //[ The route for this exchange: an exact path first, then the longest prefix that covers it. //]
  private def routeFor(application: Application, exact: py.Dict, method: Verb.Method, path: String): Option[Router.Route] =
    val key = verbName(method) + " " + path
    if exact.contains(key) then return Some(exact.get(key).cast[Router.Route])

    var best: Option[Router.Route] = None
    var longest = -1
    for route in application.routes do
      val covers = route.prefix && verbName(route.method) == verbName(method) && path.startsWith(route.path)
      if covers && route.path.size > longest then
        best = Some(route)
        longest = route.path.size
    best

  //[ The verbs another route claims this exact path under, which is what makes a 405 rather than the fallback. //]
  private def otherVerbs(application: Application, method: Verb.Method, path: String): List[String] =
    var claimed: List[String] = []
    for route in application.routes do
      if !route.prefix && route.path == path && verbName(route.method) != verbName(method) then
        claimed = claimed + verbName(route.method)
    claimed

  private def verbName(method: Verb.Method): String =
    match method
    case Verb.Get     => "GET"
    case Verb.Post    => "POST"
    case Verb.Put     => "PUT"
    case Verb.Delete  => "DELETE"
    case Verb.Options => "OPTIONS"

  //[ The 501 for a HEAD, which must not carry a body
    !
    ! Waitress writes whatever body it is handed, even for a HEAD, and frames an
    ! empty one as chunked, and either leaves bytes a client keeping the
    ! connection open reads as its next response. A declared length of 0 is what
    ! makes both servers send the headers alone.
  //]
  private def unsupportedHead(): Response =
    Complete(Status.NotImplemented, [Header("Content-Length", "0")], py.dynamic("").encode())

  //[ Whether a successful GET carries an `ETag` the client already holds
    !
    ! `If-None-Match` may list several tags, weak ones included, or be `*`.
  //]
  private def unchanged(method: Verb.Method, environ: py.Dynamic, response: Response): Bool =
    match response
    case Complete(status, headers, _) if method is Verb.Get && status is Status.Success =>
      val tag = headerIn(headers, "ETag") rescue None => return false
      val held = environValue(environ, "HTTP_IF_NONE_MATCH") rescue None => return false
      val tags = held.split(",").map(t => t.trim).map(t => if t.startsWith("W/") then t.substring(2, t.size - 2) else t)
      tags.contains("*") || tags.contains(tag)
    case _ => false

  //[ The 304 for `response`: its validators and caching headers, and no body. //]
  private def notModified(response: Response): Response =
    match response
    case Stream(_, _) => response
    case Complete(_, headers, _) =>
      val kept = headers.select(h => py.dynamic(h.name).lower().asString == "etag" || py.dynamic(h.name).lower().asString == "cache-control")
      Complete(Status.NotModified, kept, py.dynamic("").encode())

  private def headerIn(headers: List[Header], name: String): Option[String] =
    val wanted = py.dynamic(name).lower().asString
    for h in headers do
      if py.dynamic(h.name).lower().asString == wanted then return Some(h.value)
    None

  //[ Write `response` to WSGI. //]
  private def write(startResponse: py.Dynamic, response: Response): py.List =
    match response
    case Complete(status, headers, body) =>
      val _ = start(startResponse, status, headers)
      py.list(body)

    case Stream(kind, produce) =>
      val headers = [Header("Content-Type", Mime.value(kind)), Header("Cache-Control", "no-cache"), Header("X-Accel-Buffering", "no")]
      val outlet = new Outlet(start(startResponse, Status.Success, headers))
      produce(chunk => outlet.emit(chunk))
      py.list()

  //[ Begin the response, with `nosniff` so a browser never guesses a type. Returns WSGI's `write`. //]
  private def start(startResponse: py.Dynamic, status: Status.Code, headers: List[Header]): py.Dynamic =
    val pairs = py.list()
    for h in headers do
      if h.name.contains("\r") || h.name.contains("\n") || h.value.contains("\r") || h.value.contains("\n") then
        abort "header '\{h.name}' contains a line break"
      pairs.append(py.tuple(h.name, h.value))
    pairs.append(py.tuple("X-Content-Type-Options", "nosniff"))
    if framable(headers) then pairs.append(py.tuple("Content-Security-Policy", "frame-ancestors 'self'"))

    py.call(startResponse, Status.line(status), pairs)

  //[ Whether this response is a page another site could frame
    !
    ! HTML gets `frame-ancestors 'self'`, so a hostile page cannot put the
    ! application in an invisible frame and collect a click meant for it. A
    ! route that must be framed sends a policy of its own, which is kept.
  //]
  private def framable(headers: List[Header]): Bool =
    val kind = headerIn(headers, "Content-Type").getOrElse("")
    match headerIn(headers, "Content-Security-Policy")
    case Some(_) => false
    case None    => py.dynamic(kind).lower().asString.startsWith("text/html")

  //[ The write side of one stream, which stays closed once a write has failed. //]
  private class Outlet(write: py.Dynamic)
    var open: Bool = true

    def emit(chunk: String): Bool =
      if open then
        match py.try(py.call(write, py.dynamic(chunk).encode()))
        case Ok(_)  => pass
        case Err(_) => open = false
      open
  end

  //[ A server running on a background thread: the port it bound, and how to stop it. //]
  private[harpe] class Background(port: Int, stop: () => Unit)

  //[ Serve `route` with wsgiref on a daemon thread — for harpe's own viewer and tests
    !
    ! wsgiref is the standard library's reference server, with no read timeout,
    ! an accept backlog of five and no keep-alive, so not for production. It is
    ! here because the `harpe` package installs no server. A deployment runs
    ! `app` on the WSGI server it chooses.
    !
    ! Binds before returning, so a port already taken raises here. Port 0 binds
    ! a free one, which `port` reports. Writes no access log.
  //]
  private[harpe] def serveInBackground(host: String, port: Int, application: Application): Background =
    val simple = py.module("wsgiref.simple_server")
    val threaded = builtins.newType:
      "ThreadingWSGIServer"
      py.tuple(py.module("socketserver").ThreadingMixIn, simple.WSGIServer)
      py.dict("daemon_threads" ~ true)
    val quiet = builtins.newType:
      "QuietWSGIRequestHandler"
      py.tuple(simple.WSGIRequestHandler)
      py.dict("log_message" ~ py.module("logging").getLogger("harpe.http").debug)

    val httpd = simple.make_server(host, port, application.wsgi(), server_class = threaded, handler_class = quiet)
    threading.Thread(target = () => httpd.serve_forever(poll_interval = 0.05), daemon = true).start()

    new Background(httpd.server_port.asInt, () => shutdown(httpd))

  private def shutdown(httpd: py.Dynamic): Unit =
    httpd.shutdown()
    httpd.server_close()
end
