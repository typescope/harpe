//[ FileSystemImpl.jo
  !
  ! The trusted implementation of the `FileSystem` capability (declared in the pure
  ! `caps` module): every relative string path is validated before it resolves
  ! against the real root. Reads and writes do **local** I/O.
//]

namespace harpe.media

import harpe.caps.*

import harpe.ffi.os
import harpe.ffi.builtins

//[ Validate and resolve a relative path against the real `root`.
  !
  ! This is the single trusted I/O gate used by every local media implementation.
//]
def resolvePath(root: String, path: String): String =
  match FileSystem.validate(path)
  case None        => if path == "" then root else os.path.join(root, path)
  case Some(error) => abort "invalid path '\{path}': \{error}"

//[ Map a caught Python error to its message.
  !
  ! The impl-side step from `py.try` to the guest-facing `Result[T, String]`
  ! convention.
//]
private def orMessage[T](result: Result[T, py.Error]): Result[T, String] =
  match result
  case Ok(value) => Ok(value)
  case Err(e)    => Err(e.message)

//[ A `FileSystem` (local reads) that also carries the `MediaProvider` view.
  !
  ! Granted-media `resolve`/`load` are inert (`None`/`false`): media loading is now
  ! host-side staging into the shared run dir, read back through `FileSystem`.
//]
class FileSystemImpl
  val realRoot: String

  //[ Normalize the root and require it to be an existing directory.
    !
    ! Resolves symlinks and `.`/`..`, so every later resolve joins onto a canonical
    ! root.
  //]
  def FileSystemImpl(root: String) =
    val resolved = os.path.realpath(root)
    if !os.path.isdir(resolved) then
      abort "FileSystem root is not a directory: '\{root}'"

    this.realRoot = resolved

  view FileSystem

  def exists(path: String): Bool = os.path.exists(resolvePath(realRoot, path))

  def isFile(path: String): Bool = os.path.isfile(resolvePath(realRoot, path))

  def stat(path: String): Option[FileInfo] =
    val real = resolvePath(realRoot, path)

    if !os.path.exists(real) then None
    else
      val info = new FileInfo(os.path.isfile(real), os.path.getsize(real), os.path.getmtime(real).toInt)
      Some(info)

  def list(dir: String): Result[List[DirEntry], String] =
    val real = resolvePath(realRoot, dir)

    if !os.path.isdir(real) then Err("not a directory: '\{dir}'")
    else
      val names: py.List = os.listdir(real)
      py.dynamic(names).sort()

      var result = List.empty[DirEntry]
      var i = builtins.len(names) - 1

      while i >= 0 do
        val name = names.get(i).asString
        val child = if dir == "" then name else dir + "/" + name
        result = result.prepend(new DirEntry(child, os.path.isdir(resolvePath(realRoot, child))))
        i = i - 1

      Ok(result)

  def openTextFile(path: String, encoding: String = "utf-8"): Result[TextFile, String] =
    if !validEncoding(encoding) then Err("unknown encoding: '\{encoding}'")
    else openHandle(path).map: handle => new TextFileImpl(handle, encoding)

  def openBinaryFile(path: String): Result[BinaryFile, String] =
    openHandle(path).map: handle => new BinaryFileImpl(handle)

  def writeText(path: String, content: String): Result[Unit, String] =
    orMessage: py.try(writeTextUnchecked(path, content))

  private def writeTextUnchecked(path: String, content: String): Unit =
    val real = resolvePath(realRoot, path)
    ensureParent(real)
    val handle = py.open(real, "w")
    handle.write(content)
    handle.close()

  def createBinaryFile(path: String): BinaryFile =
    val real = resolvePath(realRoot, path)
    ensureParent(real)
    new BinaryFileImpl(py.open(real, "w+b"))

  //[ Open for reading and writing, in binary mode.
    !
    ! The not-a-file check gives the common miss a clean symbolic message; `py.try`
    ! catches the rest (permissions, races).
  //]
  private def openHandle(path: String): Result[py.Dynamic, String] =
    val real = resolvePath(realRoot, path)

    if !os.path.isfile(real) then Err("no such file: '\{path}'")
    else orMessage: py.try(py.open(real, "r+b"))

  //[ Create `real`'s parent directory if it is missing, so a write into a fresh
    ! subdirectory (`"out/chart.png"`) just works.
  //]
  private def ensureParent(real: String): Unit =
    val parent = os.path.dirname(real)
    if parent != "" && !os.path.isdir(parent) then os.makedirs(parent)

  //[ Whether `name` is in the interface's fixed, runtime-portable encoding set. //]
  private def validEncoding(name: String): Bool =
    name == "utf-8" || name == "windows-1252"
end

section FileSystemImpl
  //[ A filesystem over `root` (the local case). //]
  def local(root: String): FileSystemImpl = new FileSystemImpl(root)
end

//[ An open text file over a binary handle.
  !
  ! Decodes as `encoding` with replacement at undecodable bytes; `lines` rewinds
  ! and starts a fresh lazy traversal.
//]
private class TextFileImpl(handle: py.Dynamic, encoding: String)
  view TextFile

  def text: String =
    handle.seek(0)
    handle.read().decode(encoding, "replace").asString

  def lines: Iterator[String] =
    handle.seek(0)
    new LineIterator(handle, encoding)

  //[ Read blocks backward from the end, stopping once `count` newlines are in hand.
    !
    ! A huge file's tail costs only the tail. Blocks are joined as bytes before
    ! decoding, so a block boundary cannot split a character.
  //]
  def tail(count: Int): List[String] =
    val newline = py.dynamic("\n").encode()
    val chunks = py.list()
    var pos = size
    var newlines = 0

    while pos > 0 && newlines <= count do
      val block = if pos < 65536 then pos else 65536
      pos = pos - block
      handle.seek(pos)

      val chunk = handle.read(block)
      chunks.append(chunk)
      newlines = newlines + chunk.count(newline).asInt

    py.dynamic(chunks).reverse()
    val text = py.dynamic("").encode().join(chunks).decode(encoding, "replace").asString
    lastLines(text, count)

  def size: Int = os.fstat(handle.fileno().asInt).st_size.asInt

  def close(): Unit = handle.close()

  //[ The last `count` lines of `text`. //]
  private def lastLines(text: String, count: Int): List[String] =
    // `String.lines` yields one trailing empty segment when `text` ends in '\n'.
    val all = text.lines
    val total =
      if text.size > 0 && text.get(text.size - 1) == '\n' then all.size - 1 else all.size

    var i = if total > count then total - count else 0
    var result = List.empty[String]

    while i < total do
      result = result + all.get(i)
      i = i + 1

    result
end

//[ An open binary file: whole and window reads as `Bytes`. //]
private class BinaryFileImpl(handle: py.Dynamic)
  view BinaryFile

  def bytes: Bytes =
    handle.seek(0)
    handle.read().cast[Bytes]

  def read(offset: Int, length: Int): Bytes =
    handle.seek(offset)
    handle.read(length).cast[Bytes]

  def write(offset: Int, data: Bytes): Unit =
    handle.seek(offset)
    handle.write(py.dynamic(data))

  def size: Int = os.fstat(handle.fileno().asInt).st_size.asInt

  def close(): Unit = handle.close()
end

//[ A lazy line iterator over an open binary file handle.
  !
  ! One raw line per `next`, decoded as `encoding` with replacement, trailing
  ! newline stripped. Exhausting it does not close the handle — that is the owning
  ! file's job.
//]
private class LineIterator
  val handle: py.Dynamic
  val encoding: String
  var pending: py.Dynamic

  def LineIterator(handle: py.Dynamic, encoding: String) =
    this.handle = handle
    this.encoding = encoding
    this.pending = builtins.next(handle, py.none)

  view Iterator[String]

  def hasNext: Bool = !py.isNone(pending)

  def next: String =
    val line = pending.decode(encoding, "replace").callDynamic("rstrip", "\r\n").asString
    this.pending = builtins.next(this.handle, py.none)
    line
end
