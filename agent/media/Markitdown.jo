//[ Markitdown.jo
  !
  ! A concrete `Word` reader backed by Microsoft's markitdown, which renders many
  ! document formats to text. (PDFs use the page-aware `PdfiumReader` instead.)
  !
  ! Swapping the backend is a local edit here; the `Word` interface and everything
  ! above it are unchanged. Needs the `markitdown` Python package.
//]

namespace harpe.media

import harpe.ffi.os

private def markitdownMod: py.Dynamic = py.module("markitdown")

//[ A markitdown-backed reader, resolving a `Path` against `root` and rendering the
  ! file to text. //]
class MarkitdownReader(root: String)
  view Word

  def text(src: Path): Result[String, String] = markitdownConvert(resolvePath(root, src))
end

//[ Render the file at real path `path` to text via markitdown.
  !
  ! `Err(message)` for an unreadable file — an expected outcome the model should
  ! branch on.
//]
def markitdownConvert(path: String): Result[String, String] =
  orMessage: py.try(markitdownMod.MarkItDown().convert(path).text_content.asString)
