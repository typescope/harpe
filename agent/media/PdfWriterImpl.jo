//[ PdfWriterImpl.jo
  !
  ! The fpdf2 `PdfWriter` backend: a thin 1:1 mapping of the `PdfBuilder` drawing
  ! primitives onto fpdf2. Targets resolve against `root`. Needs the `fpdf2`
  ! Python package.
//]

namespace harpe.media

import harpe.caps.*
import harpe.ffi.os

private def fpdfMod: py.Dynamic = py.module("fpdf")

//[ The fpdf2 writing backend, resolving `Path`s against `root`. //]
class FpdfWriter(root: String)
  view PdfWriter

  def create(): PdfBuilder =
    val pdf = fpdfMod.FPDF()
    pdf.set_auto_page_break(true)
    pdf.add_page()
    new PdfBuilderImpl(pdf, root)
end

private class PdfBuilderImpl(pdf: py.Dynamic, root: String)
  view PdfBuilder

  def metadata(title: String, author: String): Unit =
    pdf.set_title(title)
    pdf.set_author(author)

  def addPage(): Unit =
    val _ = pdf.add_page()

  def setFont(family: String, style: String, size: Float): Unit =
    pdf.set_font(family, style, size)

  def setTextColor(r: Int, g: Int, b: Int): Unit = pdf.set_text_color(r, g, b)

  def setFillColor(r: Int, g: Int, b: Int): Unit = pdf.set_fill_color(r, g, b)

  def setDrawColor(r: Int, g: Int, b: Int): Unit = pdf.set_draw_color(r, g, b)

  def cell(width: Float, height: Float, text: String, border: Bool, fill: Bool): Unit =
    val _ = pdf.cell(width, height, text, if border then 1 else 0, fill = fill)

  def multiCell(width: Float, height: Float, text: String): Unit =
    val _ = pdf.multi_cell(width, height, text)

  def lineBreak(height: Float): Unit =
    val _ = pdf.ln(height)

  def x: Float = pdf.get_x().asFloat

  def y: Float = pdf.get_y().asFloat

  def setXY(x: Float, y: Float): Unit = pdf.set_xy(x, y)

  def pageWidth: Float = pdf.epw.asFloat

  def line(x1: Float, y1: Float, x2: Float, y2: Float): Unit =
    pdf.line(x1, y1, x2, y2)

  def image(src: Path, width: Float): Result[Unit, String] =
    orMessage: py.try(placeImage(src, width))

  def save(target: Path): Result[Unit, String] =
    orMessage: py.try(saveTo(target))

  private def placeImage(src: Path, width: Float): Unit =
    pdf.image(resolvePath(root, src), w = width)
    val _ = pdf.ln(2)

  private def saveTo(target: Path): Unit =
    val real = resolvePath(root, target)
    os.makedirs(os.path.dirname(real))
    val _ = pdf.output(real)
end
