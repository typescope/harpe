//[ ExcelWriterImpl.jo
  !
  ! The openpyxl `ExcelWriter` backend. `create` starts an empty workbook (the
  ! library's default sheet is removed); `edit` loads an existing file writable,
  ! formulas preserved. Targets resolve against `root`.
//]

namespace harpe.media

import harpe.caps.*
import harpe.ffi.os

private def xlMod: py.Dynamic = py.module("openpyxl")

//[ The openpyxl writing backend, resolving `Path`s against `root`. //]
class OpenpyxlWriter(root: String)
  view ExcelWriter

  def create(): WorkbookBuilder =
    val wb = xlMod.Workbook()
    wb.remove(wb.active)
    new WorkbookBuilderImpl(wb, root)

  def edit(src: Path): Result[WorkbookBuilder, String] =
    orMessage(py.try(xlMod.load_workbook(resolvePath(root, src)))).map: wb =>
      new WorkbookBuilderImpl(wb, root)
end

private class WorkbookBuilderImpl(wb: py.Dynamic, root: String)
  view WorkbookBuilder

  def addSheet(name: String): Unit =
    val _ = wb.create_sheet(name)

  def appendRow(sheet: String, cells: List[String]): Bool =
    match py.try(wb[sheet])
    case Err(_) => false

    case Ok(ws) =>
      val row = py.list()
      for cell in cells do
        row.append(py.dynamic(cell))

      ws.append(row)
      true

  def save(target: Path): Result[Unit, String] =
    orMessage: py.try(saveTo(target))

  private def saveTo(target: Path): Unit =
    val real = resolvePath(root, target)
    os.makedirs(os.path.dirname(real))
    wb.save(real)
end
