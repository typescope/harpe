//[ Pillow.jo
  !
  ! A concrete `Image` capability backed by Pillow: pixel dimensions, metadata, and
  ! derived images (resize / crop / convert), each written to a `target` the caller
  ! names. It resolves a relative path against its root and reads the file directly. Needs
  ! the `pillow` Python package. Reading text out of an image is the separate `OCR`
  ! capability (see Tesseract.jo, RapidOcr.jo).
  !
  ! Each capability method wraps a total body in `py.try`: a missing file or an
  ! unreadable image comes back as `Err(message)`, never a crash.
//]

namespace harpe.media

import harpe.caps.*

import harpe.ffi.os
import harpe.util.File
import harpe.ffi.builtins

private def pilMod: py.Dynamic = py.module("PIL.Image")

//[ A Pillow-backed image reader and transformer, resolving a relative path against `root`. //]
class PillowImage(root: String)
  view Image

  def dimensions(src: String): Result[Image.Size, String] =
    val real = resolvePath(root, src) rescue err: Err[String] => return err
    orMessage:
      py.try:
        dimensionsOf(real)

  def metadata(src: String): Result[Map[String, String], String] =
    val real = resolvePath(root, src) rescue err: Err[String] => return err
    orMessage:
      py.try:
        metadataOf(real)

  def resize(src: String, width: Int, height: Int, target: String): Result[Image.Size, String] =
    val realSrc = resolvePath(root, src) rescue err: Err[String] => return err
    val realTarget = resolvePath(root, target) rescue err: Err[String] => return err
    orMessage:
      py.try:
        resizeTo(realSrc, width, height, realTarget)

  def crop(src: String, x: Int, y: Int, width: Int, height: Int, target: String): Result[Image.Size, String] =
    val realSrc = resolvePath(root, src) rescue err: Err[String] => return err
    val realTarget = resolvePath(root, target) rescue err: Err[String] => return err
    orMessage:
      py.try:
        cropTo(realSrc, x, y, width, height, realTarget)

  def convert(src: String, target: String): Result[Image.Size, String] =
    val realSrc = resolvePath(root, src) rescue err: Err[String] => return err
    val realTarget = resolvePath(root, target) rescue err: Err[String] => return err
    orMessage:
      py.try:
        convertTo(realSrc, realTarget)

  private def dimensionsOf(realSrc: String): Image.Size =
    val img = pilMod.open(realSrc)
    new Image.Size(img.width.asInt, img.height.asInt)

  private def metadataOf(realSrc: String): Map[String, String] =
    val img = pilMod.open(realSrc)

    var result = Map.empty[String, String]
    result = result.add("format", img.format.toString)
    result = result.add("mode", img.mode.toString)

    // Named EXIF entries. Tags without a standard name are skipped.
    val tagNames = py.module("PIL.ExifTags").TAGS
    val exif = img.getexif()
    val keys = builtins.list(exif.keys())
    var i = 0
    val n = builtins.len(keys)

    while i < n do
      val tag = keys.get(i)
      val name = tagNames.get(tag)

      if !py.isNone(name) then
        result = result.add(name.asString, exif[tag].toString)

      i = i + 1

    result

  private def resizeTo(realSrc: String, width: Int, height: Int, realTarget: String): Image.Size =
    val img = pilMod.open(realSrc)
    img.thumbnail(py.tuple(width, height))
    save(img, realTarget)

  private def cropTo(realSrc: String, x: Int, y: Int, width: Int, height: Int, realTarget: String): Image.Size =
    val img = pilMod.open(realSrc)
    save:
      img.crop: py.tuple(x, y, x + width, y + height)
      realTarget

  private def convertTo(realSrc: String, realTarget: String): Image.Size =
    val img = pilMod.open(realSrc)
    save(img, realTarget)

  //[ Save `img` at `target` (format from the extension), returning its size.
    !
    ! A mode the format cannot hold (RGBA → JPEG, say) is retried as RGB.
  //]
  private def save(img: py.Dynamic, realTarget: String): Image.Size =
    File.ensureDir(os.path.dirname(realTarget))

    match py.try(img.save(realTarget))
    case Ok(_)  => pass
    case Err(_) => img.convert("RGB").save(realTarget)

    new Image.Size(img.width.asInt, img.height.asInt)
end
