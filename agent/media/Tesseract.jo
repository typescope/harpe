//[ Tesseract.jo
  !
  ! A concrete `OCR` capability backed by the Tesseract system binary. It resolves
  ! a relative path against its root and asks `tesseract` to write recognized text to
  ! stdout.
  !
  ! Needs the `tesseract` **system** binary (e.g. `apt install tesseract-ocr`).
  ! The backend defaults to English, Tesseract's automatic page segmentation, the
  ! default engine mode, and a 30s timeout. When the binary is absent, `text`
  ! answers `Err` rather than crashing. For a pip-only engine, see `RapidOcr`.
//]

namespace harpe.media

import harpe.caps.*
import harpe.ffi.subprocess

//[ A Tesseract-backed OCR reader, resolving a relative path against `root`. //]
class TesseractOcr
  val root: String
  val language: String
  val pageSegMode: Int
  val engineMode: Int
  val timeoutSecs: Float

  def TesseractOcr(root: String, language: String, pageSegMode: Int, engineMode: Int, timeoutSecs: Float) =
    this.root = root
    this.language = language
    this.pageSegMode = pageSegMode
    this.engineMode = engineMode
    this.timeoutSecs = timeoutSecs

  view OCR

  def text(src: String): Result[String, String] =
    match py.try(recognize(src))
    case Ok(result) => result
    case Err(e)     => Err(e.message)

  private def recognize(src: String): Result[String, String] =
    val real = resolvePath(root, src) rescue err: Err[String] => return err
    recognizeResolved(real)

  private def recognizeResolved(real: String): Result[String, String] =
    val out = subprocess.runCapped:
      py.list:
        "tesseract"
        real
        "stdout"
        "-l"
        language
        "--psm"
        "\{pageSegMode}"
        "--oem"
        "\{engineMode}"
      timeoutSecs = timeoutSecs

    if out.timedOut then
      Err("tesseract timed out after \{timeoutSecs}s")
    else if out.returnCode != 0 then
      val detail = out.err.trim
      Err(if detail == "" then "tesseract failed with exit code \{out.returnCode}" else detail)
    else
      Ok(out.out.trim)
end

//[ Default Tesseract OCR backend: English, automatic page segmentation, default
  ! engine selection, and a 30s timeout.
//]
def TesseractOcr(
    root: String,
    language: String = "eng",
    pageSegMode: Int = 3,
    engineMode: Int = 3,
    timeoutSecs: Float = 30.0)
: TesseractOcr =
  new TesseractOcr(root, language, pageSegMode, engineMode, timeoutSecs)
