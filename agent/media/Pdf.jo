//[ Pdf.jo
  !
  ! The `PdfReader` backend behind `FileSystem.openPDF`, backed by pypdfium2 —
  ! PDFium, Chrome's PDF engine, a self-contained wheel with no system
  ! dependency. Opening parses once. `PdfImpl` is the handle over the parsed
  ! document.
  !
  ! Error shape follows the file APIs: `open` is the speculative step and
  ! answers `Err` for a missing or corrupt document. Handle methods are total
  ! except `pageText`/`pageImage`, whose per-page extraction can genuinely fail.
//]

namespace harpe.media

import harpe.caps.*

import harpe.ffi.os
import harpe.util.File
import harpe.ffi.builtins

private def pdfiumMod: py.Dynamic = py.module("pypdfium2")

//[ The pypdfium2 `PdfReader` backend, resolving a relative path against `root`
  !
  ! Parses once. `Err` for a missing or corrupt document.
//]
class PdfiumReader(root: String)
  view PdfReader

  def open(src: String): Result[PDF, String] =
    val real = resolvePath(root, src) rescue err: Err[String] => return err
    val opened = orMessage:
      py.try:
        pdfiumMod.PdfDocument(real)
    opened.map: doc => new PdfImpl(doc, root)
end

//[ The open document
  !
  ! A parsed pypdfium2 `PdfDocument` plus the root for resolving render targets.
//]
private class PdfImpl(doc: py.Dynamic, root: String)
  view PDF

  def pageCount: Int = builtins.len(doc)

  def outline: List[PDF.Heading] =
    val items = builtins.list(doc.get_toc())
    val headings = List.builder[PDF.Heading]

    for item in items do headings.add(heading(item))

    headings.result

  def metadata: Map[String, String] =
    val dict = doc.callDynamic("get_metadata_dict", true).cast[py.Dict]
    val keys = builtins.list(dict.keys())

    var result = Map.empty[String, String]
    var i = 0
    val n = builtins.len(keys)

    while i < n do
      val key = keys.get(i).asString
      result = result.add(key, dict.get(key).asString)
      i = i + 1

    result

  def pageText(page: Int): Result[String, String] =
    checkPage(page)
    orMessage: py.try(doc.get_page(page - 1).get_textpage().get_text_range().asString)

  def pageContent(page: Int): PDF.PageContent =
    checkPage(page)
    val objs = builtins.list(doc.get_page(page - 1).callDynamic("get_objects"))
    val n = builtins.len(objs)

    // Object types per PDFium: 1 = text, 2 = path, 3 = image.
    var texts = 0
    var images = 0
    var paths = 0
    var i = 0

    while i < n do
      val kind = builtins.getattr(objs.get(i), "type").asInt

      if kind == 1 then texts = texts + 1
      else if kind == 2 then paths = paths + 1
      else if kind == 3 then images = images + 1

      i = i + 1

    new PDF.PageContent(texts, images, paths)

  def pageImage(page: Int, target: String, scale: Int = 2): Result[Image.Size, String] =
    checkPage(page)
    val real = resolvePath(root, target) rescue err: Err[String] => return err
    orMessage:
      py.try:
        render(page, real, scale)

  def close(): Unit =
    match py.try(doc.close())
    case Ok(_)  => pass
    case Err(_) => pass

  private def render(page: Int, realTarget: String, scale: Int): Image.Size =
    val image = doc.get_page(page - 1).render(scale).to_pil()
    File.ensureDir(os.path.dirname(realTarget))
    image.save(realTarget)
    new Image.Size(image.width.asInt, image.height.asInt)

  //[ Naming a page outside the document is a program bug
    !
    ! Not an environment surprise — abort with a clear message.
  //]
  private def checkPage(page: Int): Unit =
    if page < 1 || page > pageCount then
      abort "page \{page} is out of range: the document has \{pageCount} page(s)"

  //[ A `Heading` from a pypdfium2 bookmark.
    !
    ! 0-based dest page → 1-based `page`, or 0 when the bookmark has no page
    ! destination.
  //]
  private def heading(bookmark: py.Dynamic): PDF.Heading =
    val dest = bookmark.get_dest()
    val page =
      if py.isNone(dest) then 0
      else
        val index = dest.get_index()
        if py.isNone(index) then 0 else index.asInt + 1

    new PDF.Heading(bookmark.get_title().asString, page, bookmark.level.asInt)
end
