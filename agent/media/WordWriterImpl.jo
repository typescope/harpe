//[ WordWriterImpl.jo
  !
  ! The python-docx `WordWriter` backend. `create` starts an empty document;
  ! `edit` loads an existing one. Targets resolve against `root`.
//]

namespace harpe.media

import harpe.caps.*
import harpe.ffi.os

private def docxWriterMod: py.Dynamic = py.module("docx")

//[ The python-docx writing backend, resolving `Path`s against `root`. //]
class DocxWriter(root: String)
  view WordWriter

  def create(): WordBuilder =
    new WordBuilderImpl(docxWriterMod.Document(), root)

  def edit(src: Path): Result[WordBuilder, String] =
    orMessage(py.try(docxWriterMod.Document(resolvePath(root, src)))).map: doc =>
      new WordBuilderImpl(doc, root)
end

private class WordBuilderImpl(doc: py.Dynamic, root: String)
  view WordBuilder

  def addHeading(text: String, level: Int): Unit =
    val _ = doc.add_heading(text, level = level)

  def addParagraph(text: String): Unit =
    val _ = doc.add_paragraph(text)

  def addListItem(text: String, ordered: Bool): Unit =
    val style = if ordered then "List Number" else "List Bullet"
    val _ = doc.add_paragraph(text, style = style)

  def addTable(rows: List[List[String]]): Unit =
    if rows.size == 0 then return pass

    val table = doc.add_table(rows = rows.size, cols = rows.get(0).size)
    var i = 0

    while i < rows.size do
      var j = 0
      val row = rows.get(i)

      while j < row.size do
        py.module("builtins").callDynamic("setattr", table.cell(i, j), "text", row.get(j))
        j = j + 1

      i = i + 1

  def save(target: Path): Result[Unit, String] =
    orMessage: py.try(saveTo(target))

  private def saveTo(target: Path): Unit =
    val real = resolvePath(root, target)
    os.makedirs(os.path.dirname(real))
    doc.save(real)
end
