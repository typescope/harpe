//[ Approvals.jo
  !
  ! Instant human approval during one active agent run. Approval is an out-of-band
  ! interaction. It is never appended to the model transcript.
//]

namespace harpe

import harpe.Approvals.Decision

//[ Instant approval available to trusted sandbox capability implementations.
  !
  ! `title` is short plain text. `detail` is Markdown rendered by the driver.
//]
interface Approvals
  def request(title: String, detail: String): Decision
end

//[ The sandbox runtime binds one implementation for the lifetime of the program. //]
param approvals: Approvals

section Approvals
  //[ The result returned to the waiting sandboxed program. //]
  union Decision = Approved | Rejected | TimedOut | Cancelled

  //[ Stable wire name used by the broker protocol. //]
  def wire(decision: Decision): String =
    match decision
    case Approved  => "approved"
    case Rejected  => "rejected"
    case TimedOut  => "timed_out"
    case Cancelled => "cancelled"

  //[ Decode a broker response. Unknown values are treated as cancellation. //]
  def fromWire(value: String): Decision =
    match value
    case "approved"  => Approved
    case "rejected"  => Rejected
    case "timed_out" => TimedOut
    case _           => Cancelled
end
