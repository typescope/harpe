//[ util.jo
  !
  ! Shared low-level helpers, below both persistence and the engine.
  !
  ! `truncate` — transcript windowing used with two different budgets: the
  ! persistence layer bounds how much of a resumed session is read into memory
  ! (`SessionLog.maxResumeChars`, a RAM backstop), and `render` bounds what is sent
  ! to the model (a context/network budget). Both drop whole oldest *turns* to fit,
  ! so this logic lives once, here.
//]

namespace harpe.util
import harpe.ffi.json

import harpe.Model.*

//[ Bound the transcript to `maxChars` by dropping whole oldest *turns* (a turn
  ! begins at a `UserText`). This never splits an `Assistant`+`ToolResults` pair,
  ! always leaves the window starting at a user turn, and keeps at least the most
  ! recent turn (kept even if it alone exceeds the budget).
//]
def truncate(transcript: List[Message], maxChars: Int): List[Message] =
  var groups = splitTurns(transcript)

  while groups.size > 1 && groupsChars(groups) > maxChars do
    groups = groups.drop(1)

  flatten(groups)

//[ Group messages into turns; each group begins at a `UserText`. //]
private def splitTurns(ms: List[Message]): List[List[Message]] =
  var groups: List[List[Message]] = []
  var current: List[Message] = []

  for m in ms do
    if m is UserText(_) && !current.isEmpty then
      groups = groups + current
      current = [m]

    else
      current = current + m

  if !current.isEmpty then groups = groups + current

  groups

private def flatten(groups: List[List[Message]]): List[Message] =
  var out: List[Message] = []
  for g in groups do
    for m in g do out = out + m
  out

private def groupsChars(groups: List[List[Message]]): Int =
  var n = 0
  for g in groups do
    for m in g do n = n + messageChars(m)
  n

//[ A rough character size of a message: its text plus tool inputs (serialized) and
  ! tool-result contents. Approximate on purpose — a conservative budget absorbs it.
//]
private def messageChars(m: Message): Int =
  match m
  case UserText(t) => t.size

  case Assistant(text, calls) =>
    var n = text.size
    for c in calls do n = n + json.dumps(c.input.raw).size
    n

  case ToolResults(results) =>
    var n = 0
    for r in results do n = n + r.content.size
    n
