//[ TurnTest.jo
  !
  ! Unit tests for the turn engine (`Agent.runTurn`). The engine is pure — its
  ! model call is an injected `Responder`, its output an injected `emit`, and its
  ! cancellation a plain event — so each scenario scripts a `Responder`, records
  ! the emitted `TurnEvent`s, and asserts the resulting `TurnResult` + event
  ! sequence. No network, no tty.
  !
  ! Each scenario is summarized as "<result> | <event,tags>" so the expectation
  ! is a single deterministic string (no timings).
//]

namespace TurnTest

import jo.IO.stdout
import harpe.*
import harpe.turns.*
import harpe.context.WindowedContext
import harpe.models.echo
import harpe.Model.*
import harpe.Tool.*


// A reply carrying only text (no tool calls).
private def textReply(s: String): Option[ReplyResult] =
  Some(new Reply(new Assistant(s, List.empty[ToolCall])))

// A reply asking to call the named tool once.
private def toolReply(name: String): Option[ReplyResult] =
  val call = ToolCall: "id", name, ToolInput(py.dict())
  Some:
    Reply: Assistant("", [call])

private def eventTag(e: TurnEvent): String =
  match e
  case ModelRequestStarted(_, _) => "start"
  case ModelRequestEnded         => "end"
  case TransientError(_, _)      => "transient"
  case RequestFailed(_)          => "failed"
  case RetriesExhausted(_, _)    => "exhausted"
  case ToolBudgetReached(_)      => "budget"
  case ToolCallStarted(n)        => "tool+\{n}"
  case ToolCallEnded(n, _)       => "tool-\{n}"
  case ContextCompacted(_)       => "compact"

private def resultTag(r: TurnResult): String =
  match r
  case Answered(_, text) => "Answered(\{text})"
  case Interrupted       => "Interrupted"
  case Failed            => "Failed"

private def joinPy(xs: py.List): String =
  var s = ""
  var i = 0
  while i < xs.size do
    if i > 0 then s = s + ","
    s = s + xs.get(i).asString
    i = i + 1
  s

// A trivial tool that always succeeds, for exercising the tool-call path.
private def echoTool(): Tool =
  Tool("echo", "echo tool", [], input => new RunOutcome("echoed", "echo · ran"))

// A tool that raises instead of returning — the engine must contain it via
// `runSafely` and keep the turn going.
private def boomTool(): Tool =
  Tool("boom", "always throws", [], input => abort "kaboom")

type Responder = (List[Message], List[Tool]) => Option[ReplyResult]

// Interrupt fakes — no threads, no real sleeping, so the engine's cancellation
// paths are testable deterministically.
private class TestInteract(responder: Responder, state: State)
  view Interact

  val log = py.list()

  def ask(model: Model, system: String, messages: List[Message], tools: List[Tool]): Option[ReplyResult] =
    responder(messages, tools)

  def emit(event: TurnEvent): Unit = log.append: eventTag(event)

  def cancelled: Bool = state.cancelled

  def pause(seconds: Float): Bool = state.pause
end

private class State(cancelled: Bool, pause: Bool)

// Drive one turn and summarize it as "<result> | <events>". The agent's brain is
// the no-network echo model — the scripted TestInteract.ask never touches it.
private def scenario(tools: List[Tool], maxToolRounds: Int, maxRetries: Int, responder: Responder, state: State): String =
  val interact = new TestInteract(responder, state)
  val context = new WindowedContext("", new Memory, List.empty[Message])
  val agent = new Agent(echo(), tools, context)
  val res = agent.runTurn(interact, maxToolRounds, maxRetries)
  "\{resultTag(res)} | \{joinPy(interact.log)}"

private def msgTag(m: Message): String =
  match m
  case UserText(_) => "user"
  case Assistant(_, calls) => if calls.isEmpty then "text" else "calls"
  case ToolResults(_) => "results"

private def check(label: String, actual: String, expected: String): Unit receives stdout =
  assert: actual == expected, "\{label}: expected [\{expected}] but got [\{actual}]"
  println "  ok \{label}"

def run(): Unit receives stdout =
  val tools = [echoTool()]

  val live: State = State(cancelled = false, pause = false)

  // A plain text reply ends the turn immediately.
  check:
    "A text-answer"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 4
      responder = (h, t) => textReply("hi")
      state = live
    expected = "Answered(hi) | start,end"

  // One tool call is run, then the next reply (text) ends the turn.
  val stepB = py.list(0)
  val askB: Responder = (h, t) =>
    val n = stepB.get(0).asInt
    stepB.set(0, n + 1)
    if n == 0 then toolReply("echo") else textReply("done")

  check:
    "B tool-then-text"
    scenario: tools, 50, 4, askB, live
    expected = "Answered(done) | start,end,tool+echo,tool-echo,start,end"

  // Tool budget: once spent (maxToolRounds=1) the model is re-asked with no
  // tools and must answer with text. The scripted model returns text only when
  // offered no tools.
  val askC: Responder = (h, t) =>
    if t.isEmpty then textReply("final") else toolReply("echo")

  check:
    "C tool-budget"
    scenario: tools, 1, 4, askC, live
    expected = "Answered(final) | start,end,tool+echo,tool-echo,budget,start,end"

  // A fatal error loses the turn.
  check:
    "D fatal"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 4
      responder = (h, t) => Some: Fatal("bad key")
      state = live
    expected = "Failed | start,end,failed"

  // A cancelled request (None from the responder) interrupts the turn.
  check:
    "E cancelled"
    scenario: tools, 50, 4, (h, t) => None, live
    expected = "Interrupted | start,end"

  // Transient with no retry budget (maxRetries=0) gives up immediately — no
  // backoff wait.
  check:
    "F retries-exhausted"
    scenario:
      tools
      maxToolRounds = 50
      maxRetries = 0
      responder = (h, t) => Some: Transient("rate limited")
      state = live
    expected = "Failed | start,end,exhausted"

  // Transient once, then success: exercises the backoff + retry path. With a
  // fake Interrupt, `pause` returns instantly — no real 1s wait.
  val stepG = py.list(0)
  val askG: Responder = (h, t) =>
    val n = stepG.get(0).asInt
    stepG.set(0, n + 1)
    if n == 0 then Some(new Transient("blip")) else textReply("recovered")

  check:
    "G transient-then-success"
    scenario: tools, 50, 2, askG, live
    "Answered(recovered) | start,end,transient,start,end"

  // Cancellation already requested → the turn bails before running the tool.
  check:
    "H cancelled-before-tool"
    scenario: tools, 50, 4, (h, t) => toolReply("echo"), State(cancelled = true, pause = true)
    "Interrupted | start,end"

  // Cancellation fires during the backoff pause → the retry is abandoned.
  check:
    "I cancelled-during-backoff"
    scenario: tools, 50, 4, (h, t) => Some(new Transient("blip")), State(cancelled = false, pause = true)
    "Interrupted | start,end,transient"

  // A tool that raises does NOT crash the turn: `runSafely` turns the exception
  // into an error result the model sees, and the next (text) reply ends the turn.
  val stepJ = py.list(0)
  val askJ: Responder = (h, t) =>
    val n = stepJ.get(0).asInt
    stepJ.set(0, n + 1)
    if n == 0 then toolReply("boom") else textReply("recovered")

  check:
    "J tool-error-continues"
    scenario: [boomTool()], 50, 4, askJ, live
    expected = "Answered(recovered) | start,end,tool+boom,tool-boom,start,end"

  // The turn's delta carries exactly the engine-produced messages, in order:
  // assistant tool-call, tool results, final assistant text.
  val stepK = py.list(0)
  val askK: Responder = (h, t) =>
    val n = stepK.get(0).asInt
    stepK.set(0, n + 1)
    if n == 0 then toolReply("echo") else textReply("done")

  val ctxK = new WindowedContext("", new Memory, List.empty[Message])
  val agentK = new Agent(echo(), tools, ctxK)
  val resK = agentK.runTurn(new TestInteract(askK, live), 50, 4)

  var deltaShape = ""

  if resK is Answered(delta, _) then
    for m in delta do
      if deltaShape != "" then deltaShape = deltaShape + ","
      deltaShape = deltaShape + msgTag(m)

  check:
    "K delta-shape"
    deltaShape
    expected = "calls,results,text"
