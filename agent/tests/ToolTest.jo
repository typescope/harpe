//[ ToolTest.jo
  !
  ! Unit tests for the tool layer (`harpe.tools`): the typed `ToolInput`
  ! accessors and their fallbacks, the parameter constructors, and `runSafely` —
  ! the backstop that turns a throwing tool into an error `RunOutcome` instead of
  ! letting it crash a turn.
//]

namespace ToolTest

import jo.IO.stdout
import harpe.tools.*

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

def run(): Unit receives stdout =
  // --- typed ToolInput accessors read values of each schema type ---
  val full = ToolInput(py.dict("s" ~ "hi", "n" ~ 42, "b" ~ true, "f" ~ 3.5))
  check("string reads a string", full.string("s") == "hi")
  check("int reads an integer", full.int("n") == 42)
  check("bool reads a boolean", full.bool("b") == true)
  check("num reads a number", full.num("f") == 3.5)

  // --- missing keys fall back: explicit fallback, then bare defaults ---
  val empty = ToolInput(py.dict())
  check("stringOr fallback", empty.stringOr("x", "d") == "d")
  check("intOr fallback", empty.intOr("x", 7) == 7)
  check("boolOr fallback", empty.boolOr("x", true) == true)
  check("numOr fallback", empty.numOr("x", 1.5) == 1.5)
  check("string default is empty", empty.string("x") == "")
  check("int default is zero", empty.int("x") == 0)
  check("bool default is false", empty.bool("x") == false)
  check("num default is zero", empty.num("x") == 0.0)

  // --- parameter constructors carry the right type, all required ---
  val sp = strParam("a", "d")
  val ip = intParam("a", "d")
  val bp = boolParam("a", "d")
  val np = numParam("a", "d")
  check("strParam type", sp.paramType is StrParam)
  check("intParam type", ip.paramType is IntParam)
  check("boolParam type", bp.paramType is BoolParam)
  check("numParam type", np.paramType is NumParam)
  check("constructed params are required", sp.required && ip.required && bp.required && np.required)

  // --- runSafely: a normal tool's outcome passes through unchanged ---
  val okTool = Tool("ok", "ok tool", [], input => new RunOutcome("done", "ran"))
  val okOut = runSafely(okTool, empty)
  check("runSafely passes success through", okOut.result == "done" && okOut.summary == "ran")

  // --- runSafely: a throwing tool becomes an error RunOutcome, not a crash ---
  val badTool = Tool("boom", "always throws", [], input => abort "kaboom")
  val badOut = runSafely(badTool, empty)
  check("runSafely summary names the tool", badOut.summary == "error · boom")
  check("runSafely result carries the message", badOut.result.contains("kaboom"))
