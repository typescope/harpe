//[ Tests.jo
  !
  ! The `jo test` entry point for the `harpe` package. The [test] module is a
  ! single app, so all suites are aggregated here: fast unit tests first
  ! (`TurnTest`), then the slower integration tests that shell out
  ! (`RunCodeTest`).
//]

import jo.IO.stdout

def main(): Unit receives stdout =
  println "turn engine (unit):"
  TurnTest.run()

  println "tool layer (unit):"
  ToolTest.run()

  println "memory store (unit):"
  MemoryTest.run()

  println "context / truncate (unit):"
  ContextTest.run()

  println "skill tools (unit, security):"
  SkillsTest.run()

  println "session log (unit):"
  SessionLogTest.run()

  println "logging (unit):"
  LoggingTest.run()

  println "runCode tool (integration):"
  RunCodeTest.run()

  println "all harpe tests passed"
