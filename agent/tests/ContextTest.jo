//[ ContextTest.jo
  !
  ! Unit tests for the context surface (`harpe.context.Context`): `WindowedContext`'s
  ! default composition (memory rendered as the transient tail, transcript windowed),
  ! its `mark`/`rollback` turn bracketing, and `truncate`'s turn-boundary
  ! windowing (pairing-safe, keeps the most recent turns).
//]

namespace harpe.test.ContextTest

import jo.IO.stdout
import harpe.*
import harpe.turns.TurnEvent
import harpe.turns.ContextCompacted
import harpe.util.truncate
import harpe.context.WindowedContext
import harpe.context.SummarizingContext
import harpe.models.echo
import harpe.Model.*
import harpe.logging.logger
import harpe.Tool.*


private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

// A do-nothing Interact: the default WindowedContext.render is pure and never
// touches it.
private class NoInteract
  view Interact

  def emit(event: TurnEvent): Unit = pass

  def cancelled: Bool = false

  def pause(seconds: Float): Bool = false
end

private class CompactInteract
  view Interact

  var compactions = 0

  def emit(event: TurnEvent): Unit =
    if event is ContextCompacted(_) then compactions = compactions + 1

  def cancelled: Bool = false

  def pause(seconds: Float): Bool = false
end

private class Distiller(result: ReplyResult)
  view Model

  val prompts = py.list()

  def reply(rendered: Rendered, tools: List[Tool]): ReplyResult =
    if rendered.messages.get(0) is UserText(t) then prompts.append(t)
    result
end

private def user(t: String): Message = UserText(t)
private def asst(t: String): Message = Assistant(t, [])

// A short exchange turn: 8 chars under the `truncate` char measure.
private def turn8(u: String, a: String): List[Message] = [user(u), asst(a)]

// A turn that calls a tool: user, assistant tool_use, tool result, assistant text.
private def toolTurn(u: String, code: String, out: String): List[Message] =
  val call = ToolCall("id", "runCode", ToolInput(py.dict("code" ~ code)))
  [UserText(u), Assistant("", [call]), ToolResults([ToolResult("id", out)]), Assistant("done", [])]

def run(): Unit receives stdout, logger =
  val nix = new NoInteract

  // --- WindowedContext: memory rendered as the transient tail ---
  val mem = new Memory
  val ctx = new WindowedContext("BASE", mem, [])
  ctx.append(user("hi"))
  ctx.append(asst("hello"))

  val plain = ctx.render(nix)
  check("render without memory leaves system as base", plain.system == "BASE")
  check("render without memory leaves the transient empty", plain.transient == "")
  check("render passes the transcript through", plain.messages.size == 2)

  mem.set("goal", "win")
  mem.set("todos", "- a\n- b")

  val withMem = ctx.render(nix)
  check("memory does not leak into the system prompt", withMem.system == "BASE")
  check("a memory update is visible to the next render", withMem.transient.contains("goal") && withMem.transient.contains("todos"))
  check("render puts memory values in the transient tail", withMem.transient.contains("win") && withMem.transient.contains("- a\n- b"))

  // --- mark/rollback: the window restores; memory stays ---
  ctx.mark()
  ctx.append(user("oops"))
  ctx.append(asst("half-done"))
  check("appended messages are in the window", ctx.render(nix).messages.size == 4)

  ctx.rollback()
  check("rollback restores the pre-turn window", ctx.render(nix).messages.size == 2)
  check("rollback leaves memory alone", ctx.render(nix).transient.contains("win"))

  // --- truncate: small transcript is unchanged ---
  val a = [user("AAAA"), asst("aaaa")]   // 8 chars
  val b = [user("BBBB"), asst("bbbb")]   // 8
  val c = [user("CCCC"), asst("cccc")]   // 8
  val all = a ++ b ++ c                  // 24 chars, 6 messages

  check("truncate keeps all when it fits", truncate(all, 100).size == 6)

  // --- truncate: drops whole oldest turns to fit ---
  val two = truncate(all, 16)
  check("truncate drops the oldest turn", two.size == 4)
  check("truncate window starts at a user turn", two.get(0) is UserText("BBBB"))

  val one = truncate(all, 7)
  check("truncate drops down to the last turn", one.size == 2)
  check("truncate keeps the most recent turn", one.get(0) is UserText("CCCC"))

  // --- truncate: always keeps at least the last turn, even if oversized ---
  val big = truncate(all, 1)
  check("truncate never drops the final turn", big.size == 2 && big.get(0) is UserText("CCCC"))

  // --- truncate: never splits a tool_use / tool_result pair ---
  val paired = toolTurn("keep me", "print 1", "1") ++ toolTurn("and me", "print 2", "2")
  val kept = truncate(paired, 30)     // room for ~one turn
  check("truncate keeps whole turns (starts at user)", kept.get(0) is UserText(_))
  check("truncate never orphans a tool result", !(kept.get(0) is ToolResults(_)))

  // --- SummarizingContext: trigger at 30 reported tokens (fed via observe),
  // keep to a 16-char low-water window (8-char turns → 2 turns) ---
  val distiller =
    val reply = Reply(Assistant("DISTILLED", []), new Usage(0, 0))
    new Distiller(reply)

  val interact = new CompactInteract

  val smem = new Memory
  val sctx = new SummarizingContext("BASE", smem, [], distiller, 30, 16)

  for m in turn8("AAAA", "aaaa") ++ turn8("BBBB", "bbbb") ++ turn8("CCCC", "cccc") do
    sctx.append(m)

  // Reported usage under the high-water mark: no distillation.
  sctx.observe(new Usage(20, 0))
  val under = sctx.render(interact)
  check("summarizing: under high water passes the transcript through", under.messages.size == 6)
  check("summarizing: no summary before any compaction", !under.system.contains("Conversation summary"))
  check("summarizing: no distillation call under high water", distiller.prompts.size == 0)

  for m in turn8("DDDD", "dddd") ++ turn8("EEEE", "eeee") do
    sctx.append(m)

  // Reported usage over the high-water mark: compact down to the low-water window.
  smem.set("goal", "win")
  sctx.observe(new Usage(40, 0))
  val over = sctx.render(interact)
  check("summarizing: compaction keeps the low-water window", over.messages.size == 4)
  check("summarizing: window starts at the first kept turn", over.messages.get(0) is UserText("DDDD"))
  check("summarizing: one distillation call", distiller.prompts.size == 1)
  check("summarizing: summary rendered into the system", over.system.contains("Conversation summary") && over.system.contains("DISTILLED"))
  check("summarizing: base stays at the front", over.system.startsWith("BASE"))
  check("summarizing: memory renders in the transient tail", over.transient.contains("win"))
  check("summarizing: memory does not leak into the system prompt", !over.system.contains("win"))
  check("summarizing: compaction event emitted", interact.compactions == 1)

  val excerpt = distiller.prompts.get(0).asString
  check("summarizing: dropped turns are in the excerpt", excerpt.contains("AAAA") && excerpt.contains("CCCC"))
  check("summarizing: kept turns are not in the excerpt", !excerpt.contains("DDDD"))

  // Hysteresis: the compacted window reports fewer tokens — no new call.
  sctx.observe(new Usage(15, 0))
  val settled = sctx.render(interact)
  check("summarizing: no re-distillation while under high water", distiller.prompts.size == 1)
  check("summarizing: summary persists across requests", settled.system.contains("DISTILLED"))

  // Rolling summary: the next compaction folds the prior summary in.
  for m in turn8("FFFF", "ffff") ++ turn8("GGGG", "gggg") do
    sctx.append(m)

  sctx.observe(new Usage(40, 0))
  val again = sctx.render(interact)
  check("summarizing: second compaction", interact.compactions == 2)
  val second = distiller.prompts.get(1).asString
  check("summarizing: prior summary folded into the next request", second.contains("Current summary") && second.contains("DISTILLED"))
  check("summarizing: newly dropped turns in the second excerpt", second.contains("DDDD"))

  // A failed distillation call skips compaction: the oversized window is sent as-is.
  val failing = new CompactInteract
  val fctx =
    val model = new Distiller(Fatal("boom"))
    new SummarizingContext("BASE", new Memory, [], model, 30, 16)

  for m in turn8("AAAA", "aaaa") ++ turn8("BBBB", "bbbb") ++ turn8("CCCC", "cccc") ++ turn8("DDDD", "dddd") ++ turn8("EEEE", "eeee") do
    fctx.append(m)

  fctx.observe(new Usage(40, 0))
  val unshrunk = fctx.render(failing)
  check("summarizing: failed distillation leaves the window intact", unshrunk.messages.size == 10)
  check("summarizing: failed distillation produces no summary", !unshrunk.system.contains("Conversation summary"))
  check("summarizing: failed distillation emits no compaction", failing.compactions == 0)

  // mark/rollback restores both the window and the summary.
  val interact2 = new CompactInteract
  val rctx =
    val model = new Distiller(Reply(Assistant("DISTILLED", []), new Usage(0, 0)))
    new SummarizingContext("BASE", new Memory, [], model, 30, 16)

  for m in turn8("AAAA", "aaaa") ++ turn8("BBBB", "bbbb") ++ turn8("CCCC", "cccc") do
    rctx.append(m)

  rctx.mark()

  for m in turn8("DDDD", "dddd") ++ turn8("EEEE", "eeee") do
    rctx.append(m)

  rctx.observe(new Usage(40, 0))
  check("summarizing: compaction happened before rollback", rctx.render(interact2).messages.size == 4)

  rctx.rollback()
  val restored = rctx.render(interact2)
  check("summarizing: rollback restores the pre-turn window", restored.messages.size == 6)
  check("summarizing: rollback restores the pre-turn summary", !restored.system.contains("Conversation summary"))
