//[ MediaTest.jo
  !
  ! Unit tests for the media layer (`harpe.media`): the shipped `FileSystemProvider`
  ! — path-keyed resolution (`byPath`), on-demand `load`, MIME/metadata, path
  ! confinement to its root, and the `keyToPath` access-control seam (a handle
  ! mapping that admits only granted keys).
//]

namespace harpe.test.MediaTest
import harpe.ffi.tempfile
import harpe.ffi.file

import jo.IO.stdout
import harpe.media.*
import harpe.ffi.os

private def check(label: String, cond: Bool): Unit receives stdout =
  assert: cond, "\{label} failed"
  println "  ok \{label}"

private def denied(o: Option[Media]): Bool =
  match o
  case None => true
  case _    => false

def run(): Unit receives stdout =
  // A rooted provider at <root>/ws, with a secret planted OUTSIDE it (at <root>)
  // to probe confinement.
  val root  = tempfile.mkdtemp()
  val wsdir = os.path.join(root, "ws")
  os.makedirs(wsdir)
  file.write(os.path.join(wsdir, "data.csv"), "a,b\n1,2\n")
  file.write(os.path.join(root, "secret.txt"), "TOPSECRET")

  val provider = FileSystemProvider.byPath(wsdir)

  // --- resolution: bytes, MIME, provenance metadata ---
  match provider.resolve("data.csv")
  case Some(m) =>
    check("resolve gives a text MIME", m.mimeType.startsWith("text/"))
    check("file name is the basename", m.fileName == "data.csv")

    match m.metaString("source")
    case Some(src) => check("source metadata is the id", src == "data.csv")
    case None      => check("source metadata present", false)

  case None =>
    check("resolve data.csv", false)

  // --- load reads the bytes on demand ---
  check("load returns the file bytes", provider.load("data.csv").decode().asString == "a,b\n1,2\n")

  // --- confinement (the point of a shipped provider) ---
  check("deny parent escape",   denied(provider.resolve("../secret.txt")))
  check("deny absolute outside", denied(provider.resolve(os.path.join(root, "secret.txt"))))
  check("missing file is None",  denied(provider.resolve("absent.csv")))

  // --- keyToPath access control (the SaaS case): only granted handles resolve;
  //     the underlying path is NOT a valid key.
  val grants: Map[String, String] = Map:
    "h1" ~ "data.csv"

  val secured = new FileSystemProvider(wsdir, k => grants.getOrElse(k, ""))
  check("granted handle resolves",   !denied(secured.resolve("h1")))
  check("granted handle loads",      secured.load("h1").decode().asString == "a,b\n1,2\n")
  check("raw path is not a key",     denied(secured.resolve("data.csv")))
  check("unknown handle is denied",  denied(secured.resolve("h2")))
