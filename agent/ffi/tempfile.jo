//[ tempfile.jo
  !
  ! Python's `tempfile` module, bound as a typed value.
//]

namespace harpe.ffi

//[ Python's `tempfile` module. //]
@py.interop
interface TempfileApi
  //[ Create a new temporary directory and return its path. //]
  def mkdtemp(): String
end

def tempfile: TempfileApi = py.module("tempfile").cast[TempfileApi]
