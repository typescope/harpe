//[ os.jo
  !
  ! Python's `os` module and its `os.path` submodule, bound as typed values.
  !
  ! Declarations only, and faithful ones: every member here has Python's own name
  ! and Python's own signature, so a reader can check this file against Python's
  ! documentation and nothing else. What Harpe wants `os` to do *for it* —
  ! extensions Python has no name for, arguments it always passes the same way —
  ! is a separate concern and lives in `Paths`.
//]

namespace harpe.ffi

//[ Python's `os.path` submodule. //]
@py.interop
interface PathApi
  def exists(path: String): Bool

  def isfile(path: String): Bool

  def isdir(path: String): Bool

  def join(base: String, paths: ..Any): String

  def dirname(path: String): String

  def basename(path: String): String

  def abspath(path: String): String

  def realpath(path: String): String

  def normpath(path: String): String

  def relpath(path: String, start: String): String

  def getsize(path: String): Int

  def getmtime(path: String): Float

  //[ `(root, ext)` — the extension keeps its dot. //]
  def splitext(path: String): py.List
end

//[ Python's `os` module. //]
@py.interop
interface OsApi
  @py.property
  def path: PathApi

  //[ The process environment as a mutable string map. //]
  @py.property
  def environ: py.Dict

  //[ An environment variable's value, or `fallback` if unset. //]
  def getenv(name: String, fallback: String): String

  //[ Read up to `count` bytes from file descriptor `fd`. //]
  def read(fd: Int, count: Int): py.Dynamic

  def fstat(fd: Int): py.Dynamic

  //[ The process-group id of process `pid`. //]
  def getpgid(pid: Int): Int

  //[ Send signal `sig` to every process in group `pgid`. //]
  def killpg(pgid: Int, sig: Int): Unit

  def listdir(path: String): py.List

  def unlink(path: String): Unit

  def rename(src: String, dst: String): Unit

  def symlink(target: String, link: String): Unit

  def chmod(path: String, mode: Int): Unit

  //[ Is `path` accessible in `mode` (see `X_OK`) to the calling process? //]
  def access(path: String, mode: Int): Bool

  //[ The `access` mode bit asking whether a file may be executed. //]
  @py.property
  def X_OK: Int

  def makedirs(path: String, exist_ok: Bool @py.keyword): Unit

  def walk(top: String, followlinks: Bool @py.keyword): py.Dynamic
end

def os: OsApi = py.module("os").cast[OsApi]
