//[ hashlib.jo
  !
  ! Python's `hashlib` module and its hash objects, bound as typed values.
  !
  ! Only what Harpe uses. The encode-then-hex composition callers actually want
  ! is `Digest`, not this: here a hash is built and read exactly as Python builds
  ! and reads one.
//]

namespace harpe.ffi

//[ A hash object, mid-computation. //]
@py.interop
interface Hash
  //[ The digest so far, as a lowercase hex string. //]
  def hexdigest(): String
end

//[ Python's `hashlib` module. //]
@py.interop
interface HashlibApi
  //[ A SHA-256 hash over `data` (bytes). //]
  def sha256(data: py.Dynamic): Hash
end

def hashlib: HashlibApi = py.module("hashlib").cast[HashlibApi]
