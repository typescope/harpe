//[ terminal.jo
  !
  ! Raw-terminal control for the interactive console: cbreak mode and readiness
  ! polling, over Python's `termios`, `tty`, and `select` — grouped by usage in one
  ! namespace like `os` and `time`.
//]

namespace harpe.ffi.terminal

private def termiosMod: py.Dynamic = py.module("termios")
private def ttyMod: py.Dynamic     = py.module("tty")
private def selectMod: py.Dynamic  = py.module("select")

//[ The terminal attributes of `fd`, to restore later with `setAttrs`. //]
def getAttrs(fd: Int): py.Dynamic = termiosMod.tcgetattr(fd)

//[ Restore attributes saved by `getAttrs`, draining any pending output first. //]
def setAttrs(fd: Int, saved: py.Dynamic): Unit =
  termiosMod.tcsetattr(fd, termiosMod.TCSADRAIN, saved)

//[ Put `fd` in cbreak mode, so a single keypress is readable without Enter. //]
def setCbreak(fd: Int): Unit = ttyMod.setcbreak(fd)

//[ True if `fd` has a byte ready to read within `timeout` seconds. //]
def readable(fd: Int, timeout: Float): Bool =
  val res = selectMod.select(py.list(fd), py.list(), py.list(), timeout)
  res[0].cast[py.List].size > 0
