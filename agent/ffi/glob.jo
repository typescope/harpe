//[ glob.jo
  !
  ! Filename globbing, wrapping Python's `glob` module — mirroring `os` and `time`.
  ! Referenced as `glob.glob(...)`.
//]

namespace harpe.ffi.glob

private def module: py.Dynamic = py.module("glob")

//[ The paths matching a shell-style `spec`. //]
def glob(spec: String, recursive: Bool = false): py.List = module.glob(spec, recursive).cast[py.List]
