//[ text.jo
  !
  ! Small text helpers backed by Python's `re` — mirroring `os` and `time`.
//]

namespace harpe.ffi.text

private def reMod: py.Dynamic = py.module("re")

//[ Strip ANSI SGR colour escapes (`ESC [ … m`) from `s`. //]
def stripAnsi(s: String): String =
  reMod.sub("\\[[0-9;]*m", "", s).asString
