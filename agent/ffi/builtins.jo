//[ builtins.jo
  !
  ! Python's `builtins` module, bound as a typed value — the built-ins Jo has no
  ! direct equivalent for (attribute access, `chr`/`ord`, `len`/`next` over
  ! Python objects, numeric rounding).
  !
  ! Python's own names throughout, except where Jo cannot spell them.
  ! `@py.targetName` maps those back: `getattr` and `type` are each two arities
  ! of one function, which a single interop declaration cannot express, and
  ! `type` is a Jo keyword besides. What Harpe builds *out of* these — reading a
  ! value's type name, minting a class — is `Py`, not this file.
//]

namespace harpe.ffi

//[ Python's `builtins` module. //]
@py.interop
interface BuiltinsApi
  //[ The attribute `name` of `obj`, raising if absent. //]
  def getattr(obj: Any, name: String): py.Dynamic

  //[ The attribute `name` of `obj`, or `fallback` if absent. //]
  @py.targetName("getattr")
  def getattrOr(obj: Any, name: String, fallback: Any): py.Dynamic

  //[ The one-character string for a code point. //]
  def chr(code: Int): String

  //[ The code point of a one-character string/bytes. //]
  def ord(ch: Any): Int

  //[ The length of a Python object (string, list, bytes, …). //]
  def len(x: Any): Int

  //[ Materialize a Python iterable (generator, dict keys, …) as a list. //]
  def list(x: Any): py.List

  //[ The next item from a Python iterator, or `fallback` when exhausted. //]
  def next(it: Any, fallback: Any): py.Dynamic

  //[ Round `x` to `ndigits` decimal places. //]
  def round(x: Float, ndigits: Int): Float

  //[ Python's `int(x)`
    !
    ! Used to read an integer out of a foreign value such as a cffi pointer cast
    ! to `intptr_t`.
  //]
  def int(x: Any): Int

  //[ The `dict` type itself, for an `isInstance` check. //]
  @py.property
  def dict: py.Dynamic

  //[ A shallow copy of a mapping: Python's one-argument `dict(x)`.
    !
    ! The same name as the property above, at a different arity — see the header
    ! note on why that needs a second declaration.
  //]
  @py.targetName("dict")
  def dictOf(x: Any): py.Dict

  //[ The type of a value. //]
  @py.targetName("type")
  def typeOf(x: Any): py.Dynamic

  //[ Build a class dynamically: Python's three-argument `type`. //]
  @py.targetName("type")
  def newType(name: String, bases: Any, attrs: Any): py.Dynamic
end

def builtins: BuiltinsApi = py.module("builtins").cast[BuiltinsApi]
