//[ mimetypes.jo
  !
  ! Python's `mimetypes` module, bound as a typed value.
  !
  ! `guess_type` returns Python's `(type, encoding)` pair verbatim. Reading a
  ! `Option[String]` out of it is `Mime`'s job, not this file's.
//]

namespace harpe.ffi

//[ Python's `mimetypes` module. //]
@py.interop
interface MimetypesApi
  //[ `(type, encoding)` guessed from a file name. Both may be `None`. //]
  def guess_type(path: String): py.List
end

def mimetypes: MimetypesApi = py.module("mimetypes").cast[MimetypesApi]
