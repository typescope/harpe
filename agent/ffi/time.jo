//[ time.jo
  !
  ! Python's `time` module, bound as a typed value — the one place that touches
  ! the host wall clock.
  !
  ! `time()` and `strftime` keep Python's names and meaning. `Clock` is where the
  ! epoch-seconds-to-RFC-3339 conversions live, since Python spells those with
  ! `datetime`, not here.
//]

namespace harpe.ffi

//[ Python's `time` module. //]
@py.interop
interface TimeApi
  //[ Seconds since the epoch, as a float. //]
  def time(): Float

  //[ Seconds from an unspecified origin, never going backwards.
    !
    ! For measuring elapsed time, where the wall clock could jump.
  //]
  def monotonic(): Float

  //[ Format the current local time with a `strftime` pattern.
    !
    ! One call captures a single instant, so a pattern that spans both directory
    ! and file parts (e.g. `"logs/sessions/%Y/%m/%H-%M-%S"`) stays internally
    ! consistent — no risk of the date and time straddling a tick.
  //]
  def strftime(fmt: String): String
end

def time: TimeApi = py.module("time").cast[TimeApi]
