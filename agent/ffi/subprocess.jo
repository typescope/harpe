//[ subprocess.jo
  !
  ! Python's `subprocess` module, bound as a typed value.
  !
  ! The process handle stays `py.Dynamic`: `communicate` is called both with and
  ! without a timeout, which one interop declaration cannot express. What Harpe
  ! runs processes *for* — a wall-clock cap, a process-group kill, the minimal
  ! guest environment — is `Process`, not this file.
//]

namespace harpe.ffi

//[ Python's `subprocess` module. //]
@py.interop
interface SubprocessApi
  //[ The `stdout`/`stderr` value asking for a pipe the parent can read. //]
  @py.property
  def PIPE: py.Dynamic

  //[ Start a child process. The handle answers `communicate`, `pid`, `returncode`. //]
  def Popen(
    args: py.List,
    stdout: py.Dynamic @py.keyword,
    stderr: py.Dynamic @py.keyword,
    text: Bool @py.keyword,
    start_new_session: Bool @py.keyword,
    env: Any @py.keyword,
    cwd: Any @py.keyword)
  : py.Dynamic
end

def subprocess: SubprocessApi = py.module("subprocess").cast[SubprocessApi]
