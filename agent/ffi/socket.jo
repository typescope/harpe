//[ socket.jo
  !
  ! Unix-domain stream sockets, wrapping Python's `socket` module — mirroring `os`
  ! and `threading`. The broker (the host↔guest channel) is built on these: the host
  ! binds and listens on a per-run socket path, the guest connects to it.
  !
  ! A socket is a typed `Socket` handle (see `os.PathApi` for the same `@py.interop`
  ! pattern). Payloads are raw `py.Dynamic` bytes — framing is the broker's concern,
  ! not this layer's.
//]

namespace harpe.ffi.socket

private def module: py.Dynamic = py.module("socket")

//[ A Unix-domain stream socket. Methods map to Python's `socket` object. //]
@py.interop
interface Socket
  //[ Bind to a filesystem `path` (which must not already exist). //]
  def bind(path: String): Unit

  //[ Mark as listening, queuing up to `backlog` pending connections. //]
  def listen(backlog: Int): Unit

  //[ Connect to a socket bound at `path`. //]
  def connect(path: String): Unit

  //[ Send all of `data` (raw bytes), retrying short writes. //]
  def sendall(data: py.Dynamic): Unit

  //[ Receive up to `bufsize` bytes. Fewer if that is all that arrived, empty at EOF. //]
  def recv(bufsize: Int): py.Dynamic

  //[ Close the socket. //]
  def close(): Unit
end

//[ A new AF_UNIX stream socket, unbound and unconnected. //]
def unixStream(): Socket =
  module.socket(module.AF_UNIX, module.SOCK_STREAM).cast[Socket]

//[ Block until a client connects. Return the connection socket.
  !
  ! Python's `accept` yields a `(conn, addr)` pair — this returns the `conn`.
//]
def accept(sock: Socket): Socket =
  py.dynamic(sock).accept()[0].cast[Socket]
