//[ socket.jo
  !
  ! Python's `socket` module and its socket object, bound as typed values. The
  ! broker (the host↔guest channel) is built on these: the host binds and listens
  ! on a per-run socket path, the guest connects to it.
  !
  ! Both the module and the handle are `@py.interop` interfaces, so this file
  ! declares and never forwards. Payloads are raw `py.Dynamic` bytes — framing is
  ! the broker's concern, not this layer's. The Jo-shaped way to open one of
  ! these is `UnixSocket`, which is where the AF_UNIX/SOCK_STREAM pair and
  ! `accept`'s tuple live.
//]

namespace harpe.ffi

//[ A socket object. Methods map to Python's `socket` object. //]
@py.interop
interface Socket
  //[ Bind to a filesystem `path` (which must not already exist). //]
  def bind(path: String): Unit

  //[ Mark as listening, queuing up to `backlog` pending connections. //]
  def listen(backlog: Int): Unit

  //[ Connect to a socket bound at `path`. //]
  def connect(path: String): Unit

  //[ Send all of `data` (raw bytes), retrying short writes. //]
  def sendall(data: py.Dynamic): Unit

  //[ Receive up to `bufsize` bytes. Fewer if that is all that arrived, empty at EOF. //]
  def recv(bufsize: Int): py.Dynamic

  //[ Accept a pending connection, as a `(conn, addr)` pair. //]
  def accept(): py.List

  //[ Close the socket. //]
  def close(): Unit
end

//[ Python's `socket` module. //]
@py.interop
interface SocketApi
  //[ The Unix-domain address family. //]
  @py.property
  def AF_UNIX: Int

  //[ The stream (as opposed to datagram) socket type. //]
  @py.property
  def SOCK_STREAM: Int

  //[ A new socket of `family` and `kind`, unbound and unconnected. //]
  def socket(family: Int, kind: Int): Socket
end

def socket: SocketApi = py.module("socket").cast[SocketApi]
