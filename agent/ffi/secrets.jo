//[ secrets.jo
  !
  ! Python's `secrets` module, bound as a typed value — cryptographically-strong
  ! random tokens, for unguessable identifiers.
  !
  ! Python's own name, so a reader checks this against Python's documentation and
  ! nothing else. `token_hex` reads as the foreign call it is.
//]

namespace harpe.ffi

//[ Python's `secrets` module. //]
@py.interop
interface SecretsApi
  //[ A random hex-string token carrying `nbytes` of entropy. //]
  def token_hex(nbytes: Int): String
end

def secrets: SecretsApi = py.module("secrets").cast[SecretsApi]
