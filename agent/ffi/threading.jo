//[ threading.jo
  !
  ! Python's `threading` module, bound as a typed value.
  !
  ! The primitives it returns stay `py.Dynamic` handles (call `.acquire()` /
  ! `.release()`, `.set()` / `.is_set()` / `.wait()`, `.start()`): `Event.wait`
  ! is used both with and without a timeout, which one interop declaration
  ! cannot express, and typing the rest for its sake would buy little.
//]

namespace harpe.ffi

//[ Python's `threading` module. //]
@py.interop
interface ThreadingApi
  //[ A counting semaphore permitting `count` concurrent holders. //]
  def Semaphore(count: Int): py.Dynamic

  //[ A mutual-exclusion lock. //]
  def Lock(): py.Dynamic

  //[ An event flag (`set`/`clear`/`is_set`/`wait`). //]
  def Event(): py.Dynamic

  //[ A thread running `target`. Call `.start()`. //]
  def Thread(target: Any @py.keyword, daemon: Bool @py.keyword): py.Dynamic
end

def threading: ThreadingApi = py.module("threading").cast[ThreadingApi]
