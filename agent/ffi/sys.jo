//[ sys.jo
  !
  ! Python's `sys` module and its standard streams, bound as typed values.
//]

namespace harpe.ffi

//[ One of the interpreter's standard streams. //]
@py.interop
interface TextIO
  //[ Write `s` verbatim (no added newline). //]
  def write(s: String): Unit

  def flush(): Unit

  //[ Is this stream attached to a terminal? //]
  def isatty(): Bool
end

//[ Python's `sys` module. //]
@py.interop
interface SysApi
  //[ Terminate the process with `code` (0 = success).
    !
    ! Raises `SystemExit`, which unwinds without a traceback and — unlike
    ! `KeyboardInterrupt` — is not an `Exception`, so `py.try` blocks around
    ! network calls do not swallow it.
  //]
  def exit(code: Int): Unit

  //[ The platform identifier: "linux", "darwin" (macOS), "win32", … //]
  @py.property
  def platform: String

  @py.property
  def stdout: TextIO

  @py.property
  def stdin: TextIO
end

def sys: SysApi = py.module("sys").cast[SysApi]
