//[ json.jo
  !
  ! Python's `json` module, bound as a typed value.
  !
  ! Faithful and complete for what Harpe uses: both members carry Python's own
  ! name and signature, and there is nothing Jo-shaped to separate out.
//]

namespace harpe.ffi

//[ Python's `json` module. //]
@py.interop
interface JsonApi
  //[ Serialize a value to a JSON string. //]
  def dumps(value: Any): String

  //[ Parse a JSON string into a Python value (dict/list/scalar). //]
  def loads(text: String): py.Dynamic
end

def json: JsonApi = py.module("json").cast[JsonApi]
