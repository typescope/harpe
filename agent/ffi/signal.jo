//[ signal.jo
  !
  ! Python's `signal` module, bound as a typed value. Holds the signal numbers
  ! and the handler installer.
  !
  ! What Harpe does with them — the Ctrl-C policy every driver shares — is
  ! `Signals`, not this file.
//]

namespace harpe.ffi

//[ Python's `signal` module. //]
@py.interop
interface SignalApi
  //[ The SIGKILL signal number, used to reap a timed-out process group. //]
  @py.property
  def SIGKILL: Int

  //[ The SIGINT (Ctrl-C) signal number. //]
  @py.property
  def SIGINT: Int

  //[ Install `handler` for `signalnum`, replacing the default.
    !
    ! Must be called from the main thread. `handler` receives the signal number
    ! and the interrupted stack frame (a Python frame object, or `py.none`), and
    ! runs on the main thread at the next bytecode boundary.
  //]
  def signal(signalnum: Int, handler: (Int, py.Dynamic) => Unit): Unit
end

def signal: SignalApi = py.module("signal").cast[SignalApi]
