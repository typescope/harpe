//[ Anthropic.jo
  !
  ! The Anthropic-backed `Model`: renders the Jo tool model into Anthropic tool
  ! specs, converts the provider-agnostic history into Anthropic messages, calls
  ! `messages.create`, and parses the content blocks back into an `Assistant`.
  ! All Anthropic-specific shape lives here. The loop never sees it.
//]

namespace harpe.models
import harpe.ffi.builtins


import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger


//[ Cache
  !
  ! Prompt-cache policy for the Anthropic provider. `NoCache` sends no cache
  ! breakpoints (every request is priced in full).
  !
  ! The two ephemeral-cache lifetimes Anthropic supports: 5 minutes (default)
  ! and 1 hour (2x write cost, held across longer idle gaps).
  !
  ! Anthropic's prompt caching — breakpoints are placed on the tool list + system
  ! prompt and on the last transcript message, so the (append-only) transcript
  ! prefix is read back cheaply across a turn's tool loop. The transient tail
  ! stays uncached.
//]
union AnthropicCache = NoCache | FiveMinutes | OneHour
  def toDict: py.Dict =
    match this
    case OneHour => py.dict("type" ~ "ephemeral", "ttl" ~ "1h")
    case FiveMinutes => py.dict("type" ~ "ephemeral")
    case NoCache => abort "NoCache"
end

//[ One tool's Anthropic spec, derived from the Jo `Tool` model. //]
private def toolSpec(t: Tool): py.Dict =
  val properties = py.dict()
  val required = py.list()
  for p in t.params do
    properties.set(p.name, py.dict("type" ~ p.paramType.jsonType, "description" ~ p.description))
    if p.required then required.append(p.name)
  end

  py.dict(
    "name" ~ t.name,
    "description" ~ t.description,
    "input_schema" ~ py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
  )

//[ Inline content blocks (`image`/`document`) for a message's attachments
  !
  ! Reading each one's bytes from `dataDir`. An attachment whose mime type is
  ! neither an inline image nor a PDF, or whose bytes cannot be read, is
  ! silently skipped — it still rides in the text manifest
  ! (`Model.userContent`), just not as a direct content block.
//]
private def anthropicMediaBlocks(attachments: List[Attachment]): py.List =
  val blocks = py.list()

  for a in attachments do
    if isInlineImage(a.mime) then
      match readInlineBase64(a.path)
      case Some(data) =>
        blocks.append:
          py.dict:
            "type" ~ "image"
            "source" ~ py.dict("type" ~ "base64", "media_type" ~ a.mime, "data" ~ data)
      case None => pass

    else if isInlinePdf(a.mime) then
      match readInlineBase64(a.path)
      case Some(data) =>
        blocks.append:
          py.dict:
            "type" ~ "document"
            "source" ~ py.dict("type" ~ "base64", "media_type" ~ a.mime, "data" ~ data)
      case None => pass

  blocks

//[ The conversation as Anthropic's `messages` array (content-block format).
  !
  ! When `cache` is not `NoCache`, a cache breakpoint is placed on the last
  ! content block of the final history message: the provider caches the whole
  ! transcript prefix, and later requests in the same turn (which only append)
  ! read it back.
  !
  ! A `UserInput` is promoted to a one-element text-block list so it can carry
  ! the marker (Anthropic accepts either form).
  !
  ! An attachment only becomes a real image/document block when its `UserInput`
  ! is the NEWEST message in `history` (`i == lastIdx`) — an older message's
  ! attachments are inert here, so a past image is never resent (and re-billed)
  ! once a later turn rebuilds this same history from scratch. `dataDir` is the
  ! session's data directory (`""` if none), resolved once by the caller.
//]
private def toMessages(history: List[Message], cache: AnthropicCache): py.List =
  val msgs = py.list()
  val lastIdx = history.size - 1
  var i = 0

  for m in history do
    val shouldCache = i == lastIdx && cache is !NoCache

    match m
    case UserInput(text, attachments) =>
      val content = Model.userContent(text, attachments)
      val media = if i == lastIdx then anthropicMediaBlocks(attachments) else py.list()

      if media.size == 0 && !shouldCache then
        msgs.append(py.dict("role" ~ "user", "content" ~ content))
      else
        val blocks = py.list()
        blocks.append(py.dict("type" ~ "text", "text" ~ content))
        for b in media do blocks.append(b)
        if shouldCache then blocks[blocks.size - 1]["cache_control"] = cache.toDict
        msgs.append(py.dict("role" ~ "user", "content" ~ blocks))

    case Assistant(text, calls) =>
      val content = py.list()

      if text != "" then content.append(py.dict("type" ~ "text", "text" ~ text))

      for c in calls do
        content.append:
          py.dict("type" ~ "tool_use", "id" ~ c.id, "name" ~ c.name, "input" ~ c.input.raw)

      if shouldCache then
        content[content.size - 1]["cache_control"] = cache.toDict

      msgs.append(py.dict("role" ~ "assistant", "content" ~ content))

    case ToolResults(results) =>
      val content = py.list()
      for r in results do
        content.append:
          py.dict("type" ~ "tool_result", "tool_use_id" ~ r.id, "content" ~ r.content)

      if shouldCache then
        content[content.size - 1]["cache_control"] = cache.toDict

      msgs.append: py.dict("role" ~ "user", "content" ~ content)
    end // match

    i = i + 1
  end // for

  msgs

//[ Parse an Anthropic response's content blocks into an `Assistant` reply.
  !
  ! A `stop_reason` of "max_tokens" means the reply was cut off — possibly mid
  ! tool call, whose input JSON would be incomplete — so a truncated reply keeps
  ! its text plus a visible marker and DROPS any tool calls rather than running
  ! a tool on partial arguments.
//]
private def parseReply(response: py.Dynamic): Assistant =
  val content: py.List = response.content.cast[py.List]
  var text = ""
  var calls: List[ToolCall] = []

  for block in content do
    val btype = builtins.attr(block, "type").asString
    if btype == "text" then
      text = text + block.text.asString
    else if btype == "tool_use" then
      calls = calls + ToolCall(block.id.asString, block.name.asString, ToolInput(block.input.cast[py.Dict]))

  val stop = response.stop_reason

  if !stop.isNone && stop.asString == "max_tokens" then
    new Assistant((text + "\n\n[Reply truncated: max_tokens reached.]").trim, [])
  else
    new Assistant(text.trim, calls)

private class AnthropicModel(
    client: py.Dynamic, model: String, cache: AnthropicCache, extraBody: py.Dict)
  view Model

  def startTurn(base: Rendered): Session =
    new AnthropicSession(client, model, cache, extraBody, base)
end

//[ A reasoning-preserving turn on the Messages API.
  !
  ! Anthropic is stateless, so the turn accumulates the RAW assistant content
  ! (thinking blocks with their signatures, plus tool_use blocks) and re-sends it
  ! verbatim on every request. That is mandatory once `thinking` is enabled: a
  ! tool_result whose preceding assistant turn is missing its thinking block is
  ! rejected. `parseReply` still extracts only text + tool calls for the engine —
  ! the reasoning rides in the wire history, never in the semantic `Message`.
//]
private class AnthropicSession(
    client: py.Dynamic, model: String, cache: AnthropicCache,
    extraBody: py.Dict, base: Rendered)
  view Session

  // The wire messages, accumulated across the turn. They are seeded on the
  // first reply, then grown with raw tool_result and assistant turns.
  private var messages: py.List = py.list()
  private var initialized: Bool = false

  def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger =
    if !initialized then
      messages = toMessages(base.messages, cache)
      initialized = true

    val toolSpecs = py.list()
    for t in tools do toolSpecs.append(toolSpec(t))

    // The committed history this round would become on success: prior messages
    // plus the new tool results (as a user turn). Built without mutating `messages`.
    val committed = py.list()
    for m in messages do committed.append(m)

    if !results.isEmpty then
      committed.append(toolResultMessage(results))

    // The request adds the transient tail (working memory) after the transcript —
    // request-only, never committed, so editing memory reprocesses only the tail.
    val outgoing = py.list()
    for m in committed do outgoing.append(m)

    if base.transient != "" then
      outgoing.append(py.dict("role" ~ "user", "content" ~ base.transient))

    val attempt = anthropicCreate:
      client
      model
      cache
      base.system
      outgoing
      toolSpecs
      extraBody

    match attempt
    case Ok(response) =>
      // Commit the raw assistant content (incl. thinking blocks) + the tool
      // results — only on success.
      committed.append(py.dict("role" ~ "assistant", "content" ~ response.content))
      messages = committed
      val u = response.usage
      // Anthropic's `input_tokens` counts ONLY the tokens after the last cache
      // breakpoint, so the cached halves must be added back to recover the total
      // the request actually processed. Reporting the bare field would undercount
      // a cache hit by the whole prefix — the usual case here, since the default
      // policy caches — starving both billing and the token-budget `Context`.
      val cacheRead = usageInt(u, "cache_read_input_tokens")
      val cacheWrite = usageInt(u, "cache_creation_input_tokens")
      val inTok = usageInt(u, "input_tokens") + cacheRead + cacheWrite
      val outTok = u.output_tokens.asInt
      logUsage("anthropic", model, inTok, outTok, cacheRead, cacheWrite)
      Reply(parseReply(response), new Usage(inTok, outTok))

    case Err(err) => classifyError(err)
end

//[ A user turn carrying tool_result blocks for `results`.
  !
  ! `r.attachments` inlines unconditionally here — unlike a `UserInput`'s attachments,
  ! a tool result exists only for the round it was produced in: `toMessages`
  ! (rendering a PAST, already-committed turn) never re-derives a `tool_result`
  ! block from a `ToolResults` message's `attachments`, so a past tool-delivered image
  ! is never resent once this turn ends — no positional guard needed here.
//]
private def toolResultMessage(results: List[ToolResult]): py.Dict =
  val content = py.list()

  for r in results do
    val media = anthropicMediaBlocks(r.attachments)

    if media.size == 0 then
      content.append:
        py.dict("type" ~ "tool_result", "tool_use_id" ~ r.id, "content" ~ r.content)
    else
      val blocks = py.list()
      if r.content != "" then blocks.append(py.dict("type" ~ "text", "text" ~ r.content))
      for b in media do blocks.append(b)
      content.append:
        py.dict("type" ~ "tool_result", "tool_use_id" ~ r.id, "content" ~ blocks)

  py.dict("role" ~ "user", "content" ~ content)

//[ One Anthropic `messages.create` with adaptive thinking enabled.
  !
  ! `thinking: {type: "adaptive"}` lets the model reason (and interleave
  ! reasoning between tool calls) on models that support it. A cache breakpoint
  ! on the system block covers the tool list + system prompt (the stable
  ! prefix). When caching is off, system is a plain string, byte-identical to an
  ! uncached request.
//]
private def anthropicCreate(
    client: py.Dynamic, model: String, cache: AnthropicCache,
    system: String, messages: py.List, toolSpecs: py.List, extraBody: py.Dict)
: Result[py.Dynamic, py.Error] =
  if cache is NoCache then
    py.try:
      client.messages.create:
        model = model
        max_tokens = 8096
        thinking = py.dict("type" ~ "adaptive")
        system = system
        messages = messages
        tools = toolSpecs
        extra_body = extraBody
  else
    py.try:
      client.messages.create:
        model = model
        max_tokens = 8096
        thinking = py.dict("type" ~ "adaptive")
        system = py.list(py.dict("type" ~ "text", "text" ~ system, "cache_control" ~ cache.toDict))
        messages = messages
        tools = toolSpecs
        extra_body = extraBody


//[ Build an Anthropic-backed model from an API key, model id, and cache policy.
  !
  ! The client gets an explicit request timeout, and its INTERNAL retries are
  ! disabled (`max_retries = 0`): the turn engine owns the retry/backoff policy,
  ! and hidden SDK retries would silently multiply it.
//]
def anthropic(
    apiKey: String,
    model: String,
    cache: AnthropicCache,
    timeoutSeconds: Int = 120,
    extraBody: py.Dict = py.none)
: Model =
  val body = if py.isNone(extraBody) then py.dict() else extraBody
  val client = py.module("anthropic").Anthropic:
    api_key = apiKey
    timeout = timeoutSeconds
    max_retries = 0
  new AnthropicModel(client, model, cache, body)
