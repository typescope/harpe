//[ OpenAICompatible.jo
  !
  ! A model adapter for servers that implement the OpenAI Chat Completions API.
  ! This is the common interface exposed by local serving stacks such as vLLM,
  ! SGLang, llama.cpp, and Ollama. Provider-specific assistant fields remain
  ! opaque and are replayed unchanged across tool rounds.
//]

namespace harpe.models
import harpe.Interact
import harpe.turns.TurnEvent
import harpe.ffi.json
import harpe.ffi.builtins

import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger

private section CompatibleChat
  def toolSpec(t: Tool): py.Dict =
    val properties = py.dict()
    val required = py.list()
    for p in t.params do
      properties.set(p.name, py.dict("type" ~ p.paramType.jsonType, "description" ~ p.description))
      if p.required then required.append(p.name)

    val parameters = py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
    py.dict:
      "type" ~ "function"
      "function" ~ py.dict(
        "name" ~ t.name,
        "description" ~ t.description,
        "parameters" ~ parameters)

  def imageBlocks(attachments: List[Attachment]): py.List =
    val blocks = py.list()
    for a in attachments if InlineMedia.isImage(a.mime) do
      match InlineMedia.readBase64(a.path)
      case Some(data) =>
        blocks.append:
          py.dict:
            "type" ~ "image_url"
            "image_url" ~ py.dict("url" ~ "data:\{a.mime};base64,\{data}")
      case None => pass
    blocks

  def toMessages(rendered: Rendered): py.List =
    val messages = py.list()
    if rendered.system != "" then messages.append(py.dict("role" ~ "system", "content" ~ rendered.system))

    val lastIdx = rendered.messages.size - 1
    var i = 0
    for m in rendered.messages do
      match m
      case UserInput(text, attachments) =>
        val media = if i == lastIdx then imageBlocks(attachments) else py.list()
        val content = Model.userContent(text, attachments)
        if media.size == 0 then
          messages.append(py.dict("role" ~ "user", "content" ~ content))
        else
          val blocks = py.list()
          blocks.append(py.dict("type" ~ "text", "text" ~ content))
          for block in media do blocks.append(block)
          messages.append(py.dict("role" ~ "user", "content" ~ blocks))

      case Assistant(text, calls) =>
        val toolCalls = py.list()
        for c in calls do
          toolCalls.append:
            py.dict:
              "id" ~ c.id
              "type" ~ "function"
              "function" ~ py.dict("name" ~ c.name, "arguments" ~ json.dumps(c.input.raw))

        val message = py.dict("role" ~ "assistant", "content" ~ text)
        if toolCalls.size > 0 then message.set("tool_calls", toolCalls)
        messages.append(message)

      case ToolResults(results) =>
        val media = py.list()
        for r in results do
          messages.append:
            py.dict("role" ~ "tool", "tool_call_id" ~ r.id, "content" ~ r.content)

          val resultMedia = imageBlocks(r.attachments)
          for block in resultMedia do media.append(block)

        if media.size > 0 then messages.append(py.dict("role" ~ "user", "content" ~ media))
      end
      i = i + 1

    messages

  def parseResponse(response: py.Dynamic): Assistant =
    val choice = response.choices[0]
    val message = choice.message
    val content = message.content
    val text = if content.isNone then "" else content.asString
    var calls: List[ToolCall] = []

    val rawCalls = message.tool_calls
    if !rawCalls.isNone then
      for call in rawCalls.cast[py.List] do
        val fn = builtins.getattr(call, "function")
        val args = json.loads(fn.arguments.asString).cast[py.Dict]
        calls = calls + ToolCall(call.id.asString, fn.name.asString, ToolInput(args))

    val reason = choice.finish_reason
    if !reason.isNone && reason.asString == "length" then
      new Assistant((text + "\n\n[Reply truncated: token limit reached.]").trim, [])
    else
      new Assistant(text.trim, calls)

  def appendResults(messages: py.List, results: List[ToolResult]): Unit =
    val media = py.list()
    for r in results do
      messages.append:
        py.dict("role" ~ "tool", "tool_call_id" ~ r.id, "content" ~ r.content)

      val resultMedia = imageBlocks(r.attachments)
      for block in resultMedia do media.append(block)

    if media.size > 0 then messages.append(py.dict("role" ~ "user", "content" ~ media))
end

private class CompatibleModel(client: py.Dynamic, model: String, extraBody: py.Dict)
  view Model

  def startTurn(base: Rendered, maxOutputTokens: Int): Session =
    new CompatibleSession(client, model, maxOutputTokens, extraBody, base)
end

private class CompatibleSession(
    client: py.Dynamic, model: String, maxOutputTokens: Int,
    extraBody: py.Dict, base: Rendered)
  view Session

  //[ Complete Chat Completions messages accepted so far
    !
    ! Raw assistant messages are retained so provider extensions such as
    ! `reasoning`, `reasoning_content`, and `reasoning_details` survive tool
    ! rounds without entering Harpe's provider-independent transcript.
  //]
  private var committed: Option[py.List] = None

  def reply(results: List[ToolResult], tools: List[Tool], interact: Interact): ReplyResult receives logger =
    val messages = py.list()

    match committed
    case Some(items) => for item in items do messages.append(item)
    case None =>
      val initial = CompatibleChat.toMessages(base)
      for item in initial do messages.append(item)

    CompatibleChat.appendResults(messages, results)

    val specs = py.list()
    for t in tools do specs.append(CompatibleChat.toolSpec(t))

    match compatibleCreate(client, model, messages, specs, maxOutputTokens, extraBody, interact)
    case Ok(response) =>
      val usage = response.usage
      val inTok = if usage.isNone then 0 else usage.prompt_tokens.asInt
      val outTok = if usage.isNone then 0 else usage.completion_tokens.asInt
      // Chat Completions spells the breakdown `prompt_tokens_details`. Local
      // servers doing automatic prefix caching often omit it entirely, so a real
      // cache hit can still report 0 here.
      val details =
        if usage.isNone then py.none
        else builtins.getattrOr(usage, "prompt_tokens_details", py.none)

      val cacheRead = if details.isNone then 0 else usageInt(details, "cached_tokens")
      logUsage("openai-compatible", model, inTok, outTok, cacheRead)

      // Preserve the provider's complete assistant message, including unknown
      // extension fields. Failed requests never mutate `committed`.
      val choice = response.choices[0]
      val raw = choice.message.model_dump(exclude_none = true).cast[py.Dict]
      messages.append(raw)
      committed = Some(messages)

      Model.Reply(CompatibleChat.parseResponse(response), new Usage(inTok, outTok))
    case Err(err) => classifyError(err)
end

private def compatibleCreate(
    client: py.Dynamic, model: String, messages: py.List,
    tools: py.List, maxOutputTokens: Int, extraBody: py.Dict,
    interact: Interact)
: Result[py.Dynamic, py.Error] =
  val managerResult =
    if tools.size == 0 then py.try:
      client.chat.completions.stream:
        model = model
        messages = messages
        max_tokens = maxOutputTokens
        extra_body = extraBody
    else py.try:
      client.chat.completions.stream:
        model = model
        messages = messages
        tools = tools
        max_tokens = maxOutputTokens
        extra_body = extraBody

  Util.withPyContext: managerResult, stream =>
    consumeCompatibleStream(stream, interact)

private def consumeCompatibleStream(stream: py.Dynamic, interact: Interact): py.Dynamic =
  val events = builtins.iter(stream)
  while true do
    val event = builtins.next(events, py.none)
    if event.isNone then break
    if interact.cancelled then abort "model request cancelled"
    if builtins.getattrOr(event, "type", "").asString == "content.delta" then
      interact.emit: TurnEvent.AssistantChunk(event.delta.asString)
  stream.get_final_completion()

//[ Build a model using the portable OpenAI Chat Completions API. //]
private[harpe] def openaiCompatible(
    apiKey: String, model: String, baseUrl: String,
    timeoutSeconds: Int, extraBody: py.Dict)
: Model =
  val key = if apiKey == "" then "not-needed" else apiKey
  val client = py.module("openai").OpenAI:
    api_key = key
    base_url = baseUrl
    timeout = timeoutSeconds
    max_retries = 0
  new CompatibleModel(client, model, extraBody)
