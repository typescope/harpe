//[ Classify.jo
  !
  ! Shared classification of provider SDK failures into `ReplyResult`s. Both the
  ! Anthropic and OpenAI Python SDKs raise `APIStatusError` subclasses carrying
  ! an HTTP `status_code`, plus statusless connection/timeout errors. The status
  ! is the robust signal — exception class NAMES shift across SDK versions — so
  ! it is consulted first, and the class name is only a fallback for statusless
  ! errors.
//]

namespace harpe.models
import harpe.ffi.builtins
import harpe.ffi.time
import harpe.logging.logger


import harpe.Model.*
import harpe.Tool.*


//[ Classify a failed provider call: retryable (`Transient`) or not (`Fatal`).
  !
  ! Records it too, as one `harpe.model` failure (see `ModelLog.logFailed`). This is the
  ! only point that holds every fact about the failure at once — which model was
  ! asked, what the provider said, and whether that is worth retrying — so it is
  ! where the record is written. The `ReplyResult` it returns stays pure control
  ! flow: what the loop should DO, carrying nothing the log needs.
  !
  ! By HTTP status when present (`err.status_code`, carried by `APIStatusError`
  ! subclasses) — 408 (request timeout), 429 (rate limit), and 5xx (server
  ! errors, including Anthropic's 529 "overloaded") are transient. Any other 4xx
  ! (auth, bad request, …) is fatal. Statusless errors — connection/timeout
  ! failures that never reached the server — fall back to the class name:
  ! connection/timeout blips are transient, the rest fatal.
//]
private def classifyError(err: py.Error, provider: String, model: String): ReplyResult receives logger =
  val status = statusOf(err)
  val name = err.typeName

  val transient =
    if status > 0 then
      status == 408 || status == 429 || status >= 500
    else
      name.contains("Connection") || name.contains("Timeout")

  val detail = "\{name}: \{err.message}"
  ModelLog.logFailed(provider, model, detail, status, transient)

  if transient then
    match retryAfterOf(err)
    case Some(seconds) => RetryAfter(detail, seconds)
    case None          => Transient(detail)
  else Fatal(detail)

//[ The server-requested delay, when `Retry-After` is present and valid.
  !
  ! HTTP permits either a non-negative number of seconds or an HTTP date. SDK
  ! status errors expose the originating response (and its headers) on
  ! `err.response`. A past date means the retry may happen immediately.
//]
private def retryAfterOf(err: py.Error): Option[Float] =
  val response = builtins.getattrOr(err, "response", py.none)
  if response.isNone then return None

  val headers = builtins.getattrOr(response, "headers", py.none)
  if headers.isNone then return None

  val raw = headers.get("Retry-After", py.none)
  if raw.isNone then return None

  val value = raw.asString
  match Int.parse(value)
  case Some(seconds) =>
    if seconds >= 0 then Some(seconds.toFloat) else None

  case None =>
    val parsed = py.try:
      py.module("email.utils").parsedate_to_datetime(value).timestamp().asFloat
    match parsed
    case Ok(epoch) =>
      val remaining = epoch - time.time()
      Some(if remaining > 0.0 then remaining else 0.0)
    case Err(_) => None

//[ The exception's HTTP status, or 0 when it carries none. //]
private def statusOf(err: py.Error): Int =
  val raw = builtins.getattrOr(err, "status_code", py.none)

  if raw.isNone then
    0

  else
    match py.try(raw.asInt)
    case Ok(code) => code
    case Err(_)   => 0
