//[ OpenRouter.jo
  !
  ! OpenRouter's stateless Responses API. Unlike OpenAI, OpenRouter does not
  ! retain a response chain. This Session therefore keeps the provider's raw output
  ! items and sends the complete intra-turn history with each tool result.
//]

namespace harpe.models
import harpe.Interact
import harpe.turns.TurnEvent
import harpe.ffi.json
import harpe.ffi.builtins

import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger

private section OpenRouterResponses
  def toolSpec(t: Tool): py.Dict =
    val properties = py.dict()
    val required = py.list()
    for p in t.params do
      properties.set(p.name, p.schema)
      required.append(p.name)
    end

    val parameters = py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
    py.dict:
      "type" ~ "function"
      "name" ~ t.name
      "description" ~ t.description
      "parameters" ~ parameters
      "strict" ~ false

  def mediaBlocks(attachments: List[Attachment]): py.List =
    val blocks = py.list()
    for a in attachments do
      if InlineMedia.isImage(a.mime) then
        match InlineMedia.readBase64(a.path)
        case Some(data) =>
          blocks.append:
            py.dict:
              "type" ~ "input_image"
              "image_url" ~ "data:\{a.mime};base64,\{data}"
        case None => pass
      else if InlineMedia.isPdf(a.mime) then
        match InlineMedia.readBase64(a.path)
        case Some(data) =>
          blocks.append:
            py.dict:
              "type" ~ "input_file"
              "filename" ~ a.name
              "file_data" ~ "data:\{a.mime};base64,\{data}"
        case None => pass
    end
    blocks

  def toInput(history: List[Message]): py.List =
    val items = py.list()
    val lastIdx = history.size - 1
    var i = 0

    for m in history do
      match m
      case UserInput(text, attachments) =>
        val media = if i == lastIdx then mediaBlocks(attachments) else py.list()
        if media.size == 0 then
          items.append(py.dict("role" ~ "user", "content" ~ Model.userContent(text, attachments)))
        else
          val blocks = py.list()
          blocks.append:
            py.dict("type" ~ "input_text", "text" ~ Model.userContent(text, attachments))
          for b in media do blocks.append(b)
          items.append(py.dict("role" ~ "user", "content" ~ blocks))

      case Assistant(text, calls) =>
        if text != "" then items.append(py.dict("role" ~ "assistant", "content" ~ text))
        for c in calls do
          items.append:
            py.dict:
              "type" ~ "function_call"
              "call_id" ~ c.id
              "name" ~ c.name
              "arguments" ~ json.dumps(c.input.raw)

      case ToolResults(results) =>
        for r in results do
          items.append:
            py.dict:
              "type" ~ "function_call_output"
              "call_id" ~ r.id
              "output" ~ r.content
      end
      i = i + 1
    end
    items

  def parseResponse(response: py.Dynamic): Assistant =
    val ot = response.output_text
    val text = if !ot.isNone then ot.asString else ""

    // Before parsing anything: a cut-off reply's last `function_call` carries
    // arguments that stop mid-JSON, so parsing the calls in order to drop them
    // would fail on the very reply this branch exists for.
    val status = response.status
    if !status.isNone && status.asString == "incomplete" then
      return new Assistant((text + "\n\n[Reply truncated: max_output_tokens reached.]").trim, [])

    var calls: List[ToolCall] = []
    for it in response.output.cast[py.List] do
      if builtins.getattr(it, "type").asString == "function_call" then
        val args = json.loads(it.arguments.asString).cast[py.Dict]
        calls = calls + ToolCall(it.call_id.asString, it.name.asString, ToolInput(args))

    new Assistant(text.trim, calls)
end

private class OpenRouterModel(
    client: py.Dynamic, model: String, effort: String, extraBody: py.Dict)
  view Model

  def startTurn(base: Rendered, maxOutputTokens: Int): Session =
    new OpenRouterSession(client, model, effort, maxOutputTokens, extraBody, base)
end

private class OpenRouterSession(
    client: py.Dynamic, model: String, effort: String,
    maxOutputTokens: Int, extraBody: py.Dict, base: Rendered)
  view Session

  //[ The complete Responses `input` accepted so far.
    !
    ! `None` means that no request has succeeded. The base is encoded lazily on
    ! the first `reply`. After a successful request, `Some` contains that
    ! input followed by every raw output item returned by OpenRouter. The next
    ! request copies it and appends new tool results.
    !
    ! This is also how reasoning survives tool rounds. Reasoning items remain
    ! opaque inside the `Session` and are returned to OpenRouter unchanged. They do
    ! not enter Harpe's provider-independent transcript. Only visible assistant
    ! text and function calls surface through `Assistant`.
    !
    ! Failed requests never update this field. Retrying therefore sends the same
    ! committed history and the same uncommitted tool results.
  //]
  private var committedInput: Option[py.List] = None

  def reply(results: List[ToolResult], tools: List[Tool], interact: Interact): ReplyResult receives logger =
    val input = py.list()

    match committedInput
    case Some(items) => for item in items do input.append(item)
    case None =>
      val initial = OpenRouterResponses.toInput(base.messages)
      for item in initial do input.append(item)

    for r in results do
      input.append:
        py.dict:
          "type" ~ "function_call_output"
          "call_id" ~ r.id
          "output" ~ r.content
      val media = OpenRouterResponses.mediaBlocks(r.attachments)
      if media.size > 0 then input.append(py.dict("role" ~ "user", "content" ~ media))

    val specs = py.list()
    for t in tools do specs.append(OpenRouterResponses.toolSpec(t))

    match openRouterCreate(
      client, model, effort, base.system, input, specs, maxOutputTokens, extraBody, interact)
    case Ok(response) =>
      // Preserve every raw output item, including reasoning, messages, and
      // function calls. OpenRouter requires these items unchanged and in order
      // when a later request returns tool results.
      val output = response.output.cast[py.List]
      for item in output do input.append(item)
      committedInput = Some(input)
      val usage = response.usage
      val inTok = if usage.isNone then 0 else usage.input_tokens.asInt
      val outTok = if usage.isNone then 0 else usage.output_tokens.asInt
      // OpenRouter fronts many providers, so cache detail appears only when the
      // one behind this model reports it — and it follows OpenAI's convention of
      // a breakdown of `input_tokens`, not an addition to it.
      val details =
        if usage.isNone then py.none
        else builtins.getattrOr(usage, "input_tokens_details", py.none)

      val cacheRead = if details.isNone then 0 else usageInt(details, "cached_tokens")
      logReplied("openrouter", model, inTok, outTok, cacheRead, cacheWriteTokens = 0)
      Model.Reply(OpenRouterResponses.parseResponse(response), new Usage(inTok, outTok))
    case Err(err) => classifyError(err, "openrouter", model)
end

//[ One `responses.create` call against OpenRouter.
  !
  ! `reasoning` must be ABSENT rather than null for a model that does not
  ! support it, so it rides in `extra_body`, which carries a field only when it
  ! applies. The caller's dict is copied rather than mutated — a model holds one
  ! for its whole life.
  !
  ! `store = false`: OpenRouter keeps no server-side response, so the session
  ! replays every raw output item instead of chaining a response id.
//]
private def openRouterCreate(
    client: py.Dynamic, model: String, effort: String,
    system: String, input: py.List, tools: py.List,
    maxOutputTokens: Int, extraBody: py.Dict, interact: Interact)
: Result[py.Dynamic, py.Error] =
  val body = builtins.dictOf(extraBody)

  if effort != "none" then
    body.set("reasoning", py.dict("effort" ~ effort))

  val streamResult = py.try:
    client.responses.create:
      model = model
      instructions = system
      input = input
      tools = tools
      max_output_tokens = maxOutputTokens
      store = false
      extra_body = body
      stream = true

  Util.withPyStream: streamResult, stream =>
    consumeOpenRouterStream(stream, interact)

private def consumeOpenRouterStream(stream: py.Dynamic, interact: Interact): py.Dynamic =
  var response: py.Dynamic = py.none
  val events = builtins.iter(stream)
  while true do
    val event = builtins.next(events, py.none)
    if event.isNone then break
    if interact.cancelled then abort "model request cancelled"

    val kind = builtins.getattrOr(event, "type", "").asString
    if kind == "response.output_text.delta" then
      interact.emit: TurnEvent.AssistantChunk(event.delta.asString)
    else if kind == "response.completed" then
      response = event.response

  if response.isNone then abort "provider stream ended without a completed response"
  response

//[ Build an OpenRouter model
  !
  ! The model id is an OpenRouter catalog id.
//]
def openrouter(
    apiKey: String,
    model: String,
    baseUrl: String = "https://openrouter.ai/api/v1",
    reasoningEffort: String = "none",
    timeoutSeconds: Int = 120,
    extraBody: py.Dict = py.none)
: Model =
  val body = if py.isNone(extraBody) then py.dict() else extraBody
  val client = py.module("openai").OpenAI:
    api_key = apiKey
    base_url = baseUrl
    timeout = timeoutSeconds
    max_retries = 0
  new OpenRouterModel(client, model, reasoningEffort, body)
