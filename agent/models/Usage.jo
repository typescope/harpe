//[ Usage.jo
  !
  ! One `harpe.model` record per attempt at asking the model, whatever came back.
  !
  ! ONE ATTEMPT, ONE RECORD, EMITTED WHERE THE FACTS ARE. `provider` and `model`
  ! identify every record, so a request that failed is as attributable as one
  ! that succeeded — `outcome` selects the rest. The provider emits both, being
  ! the only party that knows which model it was talking to. What the ENGINE
  ! knows — that it will retry, that it has given up — is its own decision and
  ! its own record (`harpe.model.retry`, `harpe.model.gaveUp`).
  !
  ! Because a model reads the `logger` at reply time (not when it was built),
  ! every record is stamped with the turn's session context automatically.
//]

namespace harpe.models

import harpe.logging.logger
import harpe.ffi.builtins

//[ The category every model attempt is recorded under. //]
private[harpe] def modelCategory: String = "harpe.model"

//[ Record an attempt that came back with a reply.
  !
  ! `inputTokens` is the TOTAL input the provider processed, cached tokens
  ! included, so it means the same thing on every provider and sums across them.
  ! Providers do not agree on this: OpenAI's `input_tokens` is already the total,
  ! while Anthropic's counts only the tokens after the last cache breakpoint. An
  ! adapter whose provider reports the split must add it back before calling here.
  !
  ! `cacheReadTokens` and `cacheWriteTokens` break that total down — read from a
  ! cache (cheap) versus written to one (a premium over ordinary input). Both are
  ! 0 on a provider that reports no cache detail. That is not the same as a
  ! provider that cached nothing, but the two look alike in this event. Since the
  ! three are all parts of `inputTokens`, a price table applies the discounted
  ! rate to the cache fields and the base rate to the remainder.
//]
private[harpe] def logReplied(
    provider: String, model: String, inputTokens: Int, outputTokens: Int,
    cacheReadTokens: Int, cacheWriteTokens: Int)
: Unit receives logger =
  logger.log:
    modelCategory
    "provider"         ~ provider
    "model"            ~ model
    "outcome"          ~ "replied"
    "inputTokens"      ~ inputTokens
    "outputTokens"     ~ outputTokens
    "cacheReadTokens"  ~ cacheReadTokens
    "cacheWriteTokens" ~ cacheWriteTokens

//[ Record an attempt that failed, with what the provider said about it
  !
  ! `status` is the HTTP status, or 0 for a failure that never reached the
  ! server. `retryable` is the classification the engine acts on, recorded so a
  ! log reader can see WHY a request was retried or abandoned without inferring
  ! it from the status.
//]
private[harpe] def logFailed(
    provider: String, model: String, error: String, status: Int, retryable: Bool)
: Unit receives logger =
  logger.error:
    modelCategory
    error
    "provider"  ~ provider
    "model"     ~ model
    "outcome"   ~ "failed"
    "status"    ~ status
    "retryable" ~ retryable

//[ An optional integer counter off a provider's `usage` object
  !
  ! 0 when the provider omits the field or reports it as null, so a missing
  ! counter reads as "nothing to report" rather than raising.
//]
private[harpe] def usageInt(usage: py.Dynamic, name: String): Int =
  val raw = builtins.getattrOr(usage, name, py.none)
  if raw.isNone then 0 else raw.asInt
