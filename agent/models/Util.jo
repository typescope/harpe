//[ Util.jo
  !
  ! Shared implementation details for model adapters.
//]

namespace harpe.models

import harpe.Interact
import harpe.turns.TurnEvent
import harpe.ffi.builtins

private section Util
  //[ An optional integer counter off a provider's `usage` object
    !
    ! 0 when the provider omits the field or reports it as null, so a missing
    ! counter reads as "nothing to report" rather than raising.
  //]
  def usageInt(usage: py.Dynamic, name: String): Int =
    val raw = builtins.getattrOr(usage, name, py.none)
    if raw.isNone then 0 else raw.asInt

  //[ Run `body` with the value entered from an SDK context manager.
    !
    ! Opening, entering, and running the body return Python failures as `Err`.
    ! Once entered, `__exit__` is always attempted. Cleanup failures are ignored
    ! so they do not replace the body's result; `__exit__` receives three `None`
    ! values because `py.try` has already captured any body exception. This is
    ! deliberately narrower than a complete emulation of Python's `with`.
  //]
  def withPyContext[T](managerResult: Result[py.Dynamic, py.Error], body: py.Dynamic => T): Result[T, py.Error] =
    match managerResult
    case Err(err) => Err(err)
    case Ok(manager) =>
      match py.try(manager.__enter__())
      case Err(err) => Err(err)
      case Ok(value) =>
        val result = py.try: body(value)
        val _ = py.try: manager.__exit__(py.none, py.none, py.none)
        result

  //[ Run `body` with an SDK stream and always attempt to close it afterward.
    !
    ! Opening and running the body return Python failures as `Err`. A cleanup
    ! failure is ignored so it does not replace the body's result.
  //]
  def withPyStream[T](streamResult: Result[py.Dynamic, py.Error], body: py.Dynamic => T): Result[T, py.Error] =
    match streamResult
    case Err(err) => Err(err)
    case Ok(stream) =>
      val result = py.try: body(stream)
      val _ = py.try: stream.close()
      result

  //[ The final response of a Responses API event stream
    !
    ! Text deltas reach `interact` as they arrive. A `completed` response is
    ! returned, and so is an `incomplete` one, which the adapter's parser marks
    ! as truncated. A `failed` response or an `error` event raises with the
    ! provider's code and message. A stream that ends with no final event raises
    ! too, naming the last event it saw.
  //]
  def responsesStreamResult(stream: py.Dynamic, interact: Interact): py.Dynamic =
    var last = "none"
    val events = builtins.iter(stream)
    while true do
      val event = builtins.next(events, py.none)
      if event.isNone then break
      if interact.cancelled then abort "model request cancelled"

      val kind = builtins.getattrOr(event, "type", "").asString
      last = kind
      if kind == "response.output_text.delta" then
        interact.emit: TurnEvent.AssistantChunk(event.delta.asString)
      else if kind == "response.completed" || kind == "response.incomplete" then
        return event.response
      else if kind == "response.failed" then
        abort "provider response failed: \{errorText(builtins.getattrOr(event.response, "error", py.none))}"
      else if kind == "error" then
        abort "provider stream error: \{errorText(event)}"

    abort "provider stream ended without a completed response (last event: \{last})"

  //[ A provider error's code and message, as far as it gives them. //]
  private def errorText(error: py.Dynamic): String =
    if error.isNone then return "no detail given"
    val code = builtins.getattrOr(error, "code", py.none)
    val message = builtins.getattrOr(error, "message", py.none)
    val codeText = if code.isNone then "" else py.module("builtins").str(code).asString
    val messageText = if message.isNone then "" else message.asString
    if codeText == "" && messageText == "" then "no detail given"
    else if codeText == "" then messageText
    else if messageText == "" then codeText
    else "\{codeText}: \{messageText}"
end
