//[ OpenAI.jo
  !
  ! The OpenAI `Model`, on the **Responses API** (`responses.create`) — the only
  ! path that runs a reasoning model (gpt-5.x, o-series) *with* function tools, a
  ! combination chat/completions rejects. Reasoning effort is configurable, and
  ! disabling it (`REASONING_EFFORT=none`) lets a non-reasoning model (gpt-4o)
  ! use this endpoint too.
  !
  ! This targets OpenAI proper; it is not a generic OpenAI-compatible shim — the
  ! Responses API is OpenAI's own, not spoken by third-party endpoints. All
  ! OpenAI-specific shape lives here; the loop never sees it.
//]

namespace harpe.models
import harpe.ffi.json
import harpe.ffi.os
import harpe.ffi.builtins


import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger

//[ Responses-API encodings. //]
private section OpenAIResponses
  //[ One tool's Responses-API function spec — flat, unlike the nested
    ! chat/completions shape. `strict = false` because tools have optional
    ! parameters, which strict schema validation forbids.
  //]
  def toolSpec(t: Tool): py.Dict =
    val properties = py.dict()
    val required = py.list()
    for p in t.params do
      properties.set(p.name, py.dict("type" ~ p.paramType.jsonType, "description" ~ p.description))
      if p.required then required.append(p.name)
    end

    val parameters = py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
    py.dict("type" ~ "function", "name" ~ t.name, "description" ~ t.description,
            "parameters" ~ parameters, "strict" ~ false)

  //[ The conversation as the Responses API `input` array.
    !
    ! The system prompt is NOT included here — it rides the request's
    ! `instructions` field. An assistant's tool calls become standalone
    ! `function_call` items, and each tool result a `function_call_output` item
    ! keyed by the same `call_id`.
  //]
  def toInput(history: List[Message]): py.List =
    val items = py.list()

    for m in history do
      match m
      case UserText(text) =>
        items.append(py.dict("role" ~ "user", "content" ~ text))

      case Assistant(text, calls) =>
        if text != "" then
          items.append(py.dict("role" ~ "assistant", "content" ~ text))

        for c in calls do
          items.append(py.dict(
            "type" ~ "function_call",
            "call_id" ~ c.id,
            "name" ~ c.name,
            "arguments" ~ json.dumps(c.input.raw)))
        end

      case ToolResults(results) =>
        for r in results do
          items.append(py.dict("type" ~ "function_call_output", "call_id" ~ r.id, "output" ~ r.content))
      end // match
    end // for

    items

  //[ Parse a Responses API result into an `Assistant` reply.
    !
    ! Text comes from the aggregate `output_text`; `function_call` items in
    ! `output` become tool calls, keyed by the `call_id` the follow-up echoes
    ! back. An `incomplete` status means the output hit `max_output_tokens`, so
    ! keep the text with a marker and drop any partial calls.
  //]
  def parseResponse(response: py.Dynamic): Assistant =
    val ot = response.output_text
    val text = if !ot.isNone then ot.asString else ""

    // `type` is a Jo keyword, so read the item's tag with getattr.
    var calls: List[ToolCall] = []
    for it in response.output.cast[py.List] do
      if builtins.attr(it, "type").asString == "function_call" then
        val argsDict = json.loads(it.arguments.asString).cast[py.Dict]
        calls = calls + ToolCall(it.call_id.asString, it.name.asString, ToolInput(argsDict))

    val status = response.status

    if !status.isNone && status.asString == "incomplete" then
      new Assistant((text + "\n\n[Reply truncated: max_output_tokens reached.]").trim, [])
    else
      new Assistant(text.trim, calls)
end

private class OpenAIResponsesModel(client: py.Dynamic, model: String, effort: String)
  view Model

  def startTurn(base: Rendered): Turn =
    new OpenAIResponsesTurn(client, model, effort, base)
end

//[ A reasoning-preserving turn on the Responses API.
  !
  ! The first request sends the whole composed base; every later request sends
  ! ONLY the new tool results plus `previous_response_id`, so the server retains
  ! the reasoning items and the model resumes its chain of thought across tool
  ! calls (rather than re-reasoning from scratch each round). This relies on the
  ! default server-side `store`; it is the native Responses path for reasoning +
  ! tools.
//]
private class OpenAIResponsesTurn(client: py.Dynamic, model: String, effort: String, base: Rendered)
  view Turn

  // "" until the first successful reply, then the id to chain the next request
  // from. Committed only on success, so a retry re-sends the same round.
  private var prevId: String = ""

  def reply(results: List[ToolResult], tools: List[Tool]): ReplyResult receives logger =
    val toolSpecs = py.list()
    for t in tools do toolSpecs.append(OpenAIResponses.toolSpec(t))

    // First request: the full base conversation (+ the transient tail). Later
    // requests: an empty list the tool results are appended to — the prior turn
    // rides along via `previous_response_id`.
    val input =
      if prevId == "" then
        val items = OpenAIResponses.toInput(base.messages)

        if base.transient != "" then
          items.append(py.dict("role" ~ "user", "content" ~ base.transient))

        items

      else
        py.list()

    for r in results do
      input.append(py.dict("type" ~ "function_call_output", "call_id" ~ r.id, "output" ~ r.content))

    val attempt = openaiCreate(client, model, effort, base.system, input, toolSpecs, prevId)

    match attempt
    case Ok(response) =>
      // Chain the next request from this response — only on success.
      prevId = response.id.asString
      val u = response.usage
      val inTok = u.input_tokens.asInt
      val outTok = u.output_tokens.asInt
      logUsage("openai", model, inTok, outTok)
      Model.Reply(OpenAIResponses.parseResponse(response), new Usage(inTok, outTok))

    case Err(err) => classifyError(err)
end

//[ One `responses.create` call.
  !
  ! `reasoning` is sent unless the effort is "none" — omitting it keeps a
  ! non-reasoning model (e.g. gpt-4o) working on this endpoint, since those reject
  ! a `reasoning` parameter. `previous_response_id` is sent only for a continuation
  ! (`prevId != ""`).
//]
private def openaiCreate(
    client: py.Dynamic, model: String, effort: String,
    system: String, input: py.List, toolSpecs: py.List, prevId: String)
: Result[py.Dynamic, py.Error] =
  if effort == "none" then
    if prevId == "" then
      py.try:
        client.responses.create:
          model = model
          instructions = system
          input = input
          tools = toolSpecs
          max_output_tokens = 8096

    else
      py.try:
        client.responses.create:
          model = model
          instructions = system
          input = input
          tools = toolSpecs
          max_output_tokens = 8096
          previous_response_id = prevId

  else
    if prevId == "" then
      py.try:
        client.responses.create:
          model = model
          instructions = system
          input = input
          tools = toolSpecs
          reasoning = py.dict("effort" ~ effort)
          max_output_tokens = 8096

    else
      py.try:
        client.responses.create:
          model = model
          instructions = system
          input = input
          tools = toolSpecs
          reasoning = py.dict("effort" ~ effort)
          max_output_tokens = 8096
          previous_response_id = prevId

//[ Build the OpenAI model (Responses API) from an API key, model id, and base URL.
  !
  ! `REASONING_EFFORT` sets the reasoning effort (default "medium", "none" to
  ! disable). `baseUrl` is normally "" for the default endpoint; pass one only for
  ! an OpenAI Responses-API-speaking gateway (e.g. Azure OpenAI, a proxy) — not for
  ! third-party chat/completions endpoints, which this no longer targets.
//]
def openai(apiKey: String, model: String, baseUrl: String): Model =
  // Explicit request timeout; internal SDK retries disabled — the turn engine
  // owns the retry/backoff policy, and hidden SDK retries would multiply it.
  val client =
    if baseUrl == "" then
      py.module("openai").OpenAI(api_key = apiKey, timeout = 600.0, max_retries = 0)
    else
      py.module("openai").OpenAI(api_key = apiKey, base_url = baseUrl, timeout = 600.0, max_retries = 0)

  new OpenAIResponsesModel(client, model, os.getenv("REASONING_EFFORT", "medium"))
