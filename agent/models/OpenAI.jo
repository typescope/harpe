//[ OpenAI.jo
  !
  ! The OpenAI `Model`, on the **Responses API** (`responses.create`) — the only
  ! path that runs a reasoning model (gpt-5.x, o-series) *with* function tools,
  ! a combination chat/completions rejects. Reasoning effort is configurable,
  ! and setting it to `none` lets a non-reasoning model use this endpoint too.
  !
  ! This targets OpenAI proper. It is not a generic OpenAI-compatible shim — the
  ! Responses API is OpenAI's own, not spoken by third-party endpoints. All
  ! OpenAI-specific shape lives here. The loop never sees it.
//]

namespace harpe.models
import harpe.Interact
import harpe.turns.TurnEvent
import harpe.ffi.json
import harpe.ffi.builtins
import harpe.util.Digest


import harpe.Model
import harpe.Model.*
import harpe.Tool
import harpe.Tool.*
import harpe.logging.logger

//[ Responses-API encodings. //]
private section OpenAIResponses
  //[ One tool's Responses-API function spec — flat, unlike the nested chat/completions shape
    !
    ! `strict = false` because strict validation wants
    ! `additionalProperties: false` on the schema object, which this render does
    ! not emit. That is the one thing left between here and strict.
  //]
  def toolSpec(t: Tool): py.Dict =
    val properties = py.dict()
    val required = py.list()
    for p in t.params do
      properties.set(p.name, p.schema)
      required.append(p.name)
    end

    val parameters = py.dict("type" ~ "object", "properties" ~ properties, "required" ~ required)
    py.dict("type" ~ "function", "name" ~ t.name, "description" ~ t.description,
            "parameters" ~ parameters, "strict" ~ false)

  //[ Inline content items (`input_image`/`input_file`) for a message's attachments
    !
    ! Reading each one's bytes from `dataDir`. Mirrors
    ! `Anthropic.anthropicMediaBlocks` — see its doc for the skip conditions.
  //]
  def openaiMediaBlocks(attachments: List[Attachment]): py.List =
    val blocks = py.list()

    for a in attachments do
      if InlineMedia.isImage(a.mime) then
        match InlineMedia.readBase64(a.path)
        case Some(data) =>
          blocks.append: py.dict("type" ~ "input_image", "image_url" ~ "data:\{a.mime};base64,\{data}")
        case None => pass

      else if InlineMedia.isPdf(a.mime) then
        match InlineMedia.readBase64(a.path)
        case Some(data) =>
          blocks.append: py.dict("type" ~ "input_file", "filename" ~ a.name, "file_data" ~ "data:\{a.mime};base64,\{data}")
        case None => pass

    blocks

  //[ The conversation as the Responses API `input` array.
    !
    ! The system prompt is NOT included here — it rides the request's
    ! `instructions` field. An assistant's tool calls become standalone
    ! `function_call` items, and each tool result a `function_call_output` item
    ! keyed by the same `call_id`.
    !
    ! An attachment only becomes a real `input_image`/`input_file` item when its
    ! `UserInput` is the NEWEST message in `history` (`i == lastIdx`) — same
    ! reasoning as `Anthropic.toMessages`: an older message's attachments are
    ! inert, so a past image is never resent (and re-billed) once a later turn
    ! rebuilds this same history from scratch. `dataDir` is the session's data directory
    ! (`""` if none), resolved once by the caller.
  //]
  def toInput(history: List[Message]): py.List =
    val items = py.list()
    val lastIdx = history.size - 1
    var i = 0

    for m in history do
      match m
      case UserInput(text, attachments) =>
        val media = if i == lastIdx then openaiMediaBlocks(attachments) else py.list()

        if media.size == 0 then
          items.append:
            py.dict("role" ~ "user", "content" ~ Model.userContent(text, attachments))
        else
          val blocks = py.list()
          blocks.append:
            py.dict("type" ~ "input_text", "text" ~ Model.userContent(text, attachments))
          for b in media do blocks.append(b)
          items.append(py.dict("role" ~ "user", "content" ~ blocks))

      case Assistant(text, calls) =>
        if text != "" then
          items.append(py.dict("role" ~ "assistant", "content" ~ text))

        for c in calls do
          items.append(py.dict(
            "type" ~ "function_call",
            "call_id" ~ c.id,
            "name" ~ c.name,
            "arguments" ~ json.dumps(c.input.raw)))
        end

      case ToolResults(results) =>
        for r in results do
          items.append(py.dict("type" ~ "function_call_output", "call_id" ~ r.id, "output" ~ r.content))
      end // match

      i = i + 1
    end // for

    items

  //[ Parse a Responses API result into an `Assistant` reply.
    !
    ! Text comes from the aggregate `output_text`. `function_call` items in
    ! `output` become tool calls, keyed by the `call_id` the follow-up echoes
    ! back. An `incomplete` status means the output hit `max_output_tokens`, so
    ! keep the text with a marker and drop any partial calls.
  //]
  def parseResponse(response: py.Dynamic): Assistant =
    val ot = response.output_text
    val text = if !ot.isNone then ot.asString else ""

    // Before parsing anything: a cut-off reply's last `function_call` carries
    // arguments that stop mid-JSON, so parsing the calls in order to drop them
    // would fail on the very reply this branch exists for.
    val status = response.status
    if !status.isNone && status.asString == "incomplete" then
      return new Assistant((text + "\n\n[Reply truncated: max_output_tokens reached.]").trim, [])

    // `type` is a Jo keyword, so read the item's tag with getattr.
    var calls: List[ToolCall] = []
    for it in response.output.cast[py.List] do
      if builtins.getattr(it, "type").asString == "function_call" then
        val argsDict = json.loads(it.arguments.asString).cast[py.Dict]
        calls = calls + ToolCall(it.call_id.asString, it.name.asString, ToolInput(argsDict))

    new Assistant(text.trim, calls)
end

private class OpenAIResponsesModel(
    client: py.Dynamic, model: String, effort: String, store: Bool, extraBody: py.Dict)
  view Model

  def startTurn(base: Rendered, maxOutputTokens: Int): Session =
    new OpenAIResponsesSession(client, model, effort, store, maxOutputTokens, extraBody, base)
end

//[ A reasoning-preserving turn on the Responses API.
  !
  ! Stored mode sends only new tool results plus `previous_response_id` after
  ! the first request. Stateless mode instead retains and replays every raw
  ! output item. Both preserve the reasoning state required by later tool calls;
  ! neither leaks provider-specific items into Harpe's semantic transcript.
  !
  ! Prompt caching needs no opt-in — OpenAI caches eligible prefixes on its own,
  ! and the default `implicit` mode places a breakpoint on the latest message.
  ! What it does need on gpt-5.6 and later is a `prompt_cache_key`: without one,
  ! those models fall back off the reliable-matching path. The key is the digest
  ! of the system prompt, so requests sharing a long common prefix share a key —
  ! OpenAI's own rule for choosing one — while unrelated agents stay apart.
//]
private class OpenAIResponsesSession(
    client: py.Dynamic, model: String, effort: String, store: Bool,
    maxOutputTokens: Int, extraBody: py.Dict, base: Rendered)
  view Session

  // "" until the first successful reply, then the id to chain the next request
  // from. Committed only on success, so a retry re-sends the same round.
  private var prevId: String = ""

  // Stateless mode owns the complete wire-fidelity turn tail. Committed only
  // after success, so retries send the same history and pending results.
  private var committedInput: Option[py.List] = None

  // Stable for the turn, and across every turn built on the same system prompt.
  private val cacheKey: String = "harpe:" + Digest.sha256Hex(base.system).substring(0, 16)

  def reply(results: List[ToolResult], tools: List[Tool], interact: Interact): ReplyResult receives logger =
    val toolSpecs = py.list()
    for t in tools do toolSpecs.append(OpenAIResponses.toolSpec(t))

    val input = py.list()
    if store then
      // In stored mode only the first request carries the base; later requests
      // continue the server-side response and add the new tool results.
      if prevId == "" then
        for item in OpenAIResponses.toInput(base.messages) do input.append(item)
    else
      // In stateless mode replay the base plus every raw output item committed
      // by successful earlier rounds.
      match committedInput
      case Some(items) => for item in items do input.append(item)
      case None => for item in OpenAIResponses.toInput(base.messages) do input.append(item)

    // A fresh tool result's media inlines unconditionally (unlike a `UserInput`'s
    // attachments) — a tool result exists only for the round it was produced in,
    // and `OpenAIResponses.toInput` never re-derives an item from a PAST
    // `ToolResults` message's `attachments`, so no positional guard is needed here.
    // `function_call_output.output` is text-only, so any media rides as a
    // follow-up user-role message right after it, in the same request.
    for r in results do
      input.append(py.dict("type" ~ "function_call_output", "call_id" ~ r.id, "output" ~ r.content))
      val media = OpenAIResponses.openaiMediaBlocks(r.attachments)
      if media.size > 0 then
        input.append(py.dict("role" ~ "user", "content" ~ media))

    val attempt = openaiCreate:
      client
      model
      effort
      base.system
      input
      toolSpecs
      if store then prevId else ""
      store
      cacheKey
      maxOutputTokens
      extraBody
      interact

    match attempt
    case Ok(response) =>
      if store then
        // Chain the next request from this response — only on success.
        prevId = response.id.asString
      else
        // Preserve reasoning, messages, and function calls exactly as OpenAI
        // returned them so the next stateless request can resume the tool loop.
        for item in response.output.cast[py.List] do input.append(item)
        committedInput = Some(input)
      val u = response.usage
      // Unlike Anthropic, OpenAI's `input_tokens` is already the total — the
      // cache counters below are a breakdown OF it, not additions to it, so
      // nothing is added back here. `cache_write_tokens` appears on gpt-5.6 and
      // later. `usageInt` reads 0 where a model or endpoint omits either field.
      val details = builtins.getattrOr(u, "input_tokens_details", py.none)
      val cacheRead = if details.isNone then 0 else usageInt(details, "cached_tokens")
      val cacheWrite = if details.isNone then 0 else usageInt(details, "cache_write_tokens")
      val inTok = u.input_tokens.asInt
      val outTok = u.output_tokens.asInt
      logReplied("openai", model, inTok, outTok, cacheRead, cacheWrite)
      Model.Reply(OpenAIResponses.parseResponse(response), new Usage(inTok, outTok))

    case Err(err) => classifyError(err, "openai", model)
end

//[ One `responses.create` call.
  !
  ! There is a single call here, not one per combination of optional fields.
  ! `reasoning` and `previous_response_id` must be ABSENT rather than null when
  ! they do not apply: a non-reasoning model (e.g. gpt-4o) rejects `reasoning`,
  ! and a first request has no response to continue from. `extra_body` is how
  ! the SDK carries a field that is only sometimes present, and it produces the
  ! same request JSON the typed keyword would.
  !
  ! `prompt_cache_key` rides on every request — see the session's note on why
  ! caching itself needs no other field.
  !
  ! The caller's `extraBody` is COPIED, never mutated. A model holds one dict for
  ! its whole life, so mutating it would leave the last round's
  ! `previous_response_id` on every later request, including a first one.
//]
private def openaiCreate(
    client: py.Dynamic, model: String, effort: String,
    system: String, input: py.List, toolSpecs: py.List, prevId: String,
    store: Bool, cacheKey: String, maxOutputTokens: Int, extraBody: py.Dict,
    interact: Interact)
: Result[py.Dynamic, py.Error] =
  val body = builtins.dictOf(extraBody)

  // Storage changes continuation semantics, so the typed model option owns it;
  // an identically named extra-body field cannot silently select the wrong path.
  body.set("store", store)

  if !store && effort != "none" then
    // Stateless reasoning continuation needs the encrypted reasoning item in
    // the returned output. Preserve any other caller-requested include fields.
    val include = py.list()
    val configuredValue = body.get("include", py.list())
    val configured = if configuredValue.isNone then py.list() else configuredValue.cast[py.List]
    var hasReasoning = false
    for item in configured do
      include.append(item)
      if item.asString == "reasoning.encrypted_content" then hasReasoning = true
    if !hasReasoning then include.append("reasoning.encrypted_content")
    body.set("include", include)

  if effort != "none" then
    body.set("reasoning", py.dict("effort" ~ effort))

  if body.contains("previous_response_id") then body.pop("previous_response_id")
  if prevId != "" then
    body.set("previous_response_id", prevId)

  val streamResult = py.try:
    client.responses.create:
      model = model
      instructions = system
      input = input
      tools = toolSpecs
      max_output_tokens = maxOutputTokens
      prompt_cache_key = cacheKey
      extra_body = body
      stream = true

  Util.withPyStream: streamResult, stream =>
    consumeOpenAIStream(stream, interact)

private def consumeOpenAIStream(stream: py.Dynamic, interact: Interact): py.Dynamic =
  var response: py.Dynamic = py.none
  val events = builtins.iter(stream)
  while true do
    val event = builtins.next(events, py.none)
    if event.isNone then break
    if interact.cancelled then abort "model request cancelled"

    val kind = builtins.getattrOr(event, "type", "").asString
    if kind == "response.output_text.delta" then
      interact.emit: TurnEvent.AssistantChunk(event.delta.asString)
    else if kind == "response.completed" then
      response = event.response

  if response.isNone then abort "provider stream ended without a completed response"
  response

//[ Build an OpenAI Responses model
  !
  ! The options that select request behavior are:
  !
  ! - `reasoningEffort`: configure Responses API reasoning.
  ! - `store`: continue Responses through server-side `previous_response_id`
  !   state when `true`; retain and replay raw output items when `false`.
  ! - `extraBody`: pass other provider-specific request fields.
  !
  ! For a portable Chat Completions server, use `openai.compatible` instead.
//]
def openai(
    apiKey: String,
    model: String,
    baseUrl: String = "https://api.openai.com/v1",
    reasoningEffort: String = "medium",
    timeoutSeconds: Int = 120,
    extraBody: py.Dict = py.none,
    store: Bool = true)
: Model =
  val body = if py.isNone(extraBody) then py.dict() else extraBody
  // Explicit request timeout. Internal SDK retries disabled — the turn engine
  // owns the retry/backoff policy, and hidden SDK retries would multiply it.
  val client = py.module("openai").OpenAI:
    api_key = apiKey
    base_url = baseUrl
    timeout = timeoutSeconds
    max_retries = 0
  new OpenAIResponsesModel(client, model, reasoningEffort, store, body)

section openai
  //[ Build a model for a portable OpenAI-compatible Chat Completions server. //]
  def compatible(
      apiKey: String,
      model: String,
      baseUrl: String,
      timeoutSeconds: Int = 120,
      extraBody: py.Dict = py.none)
  : Model =
    val body = if py.isNone(extraBody) then py.dict() else extraBody
    openaiCompatible(apiKey, model, baseUrl, timeoutSeconds, body)
end
