//[ InlineMedia.jo
  !
  ! Shared by the Anthropic and OpenAI renders: which attachment mime types the
  ! vision APIs accept inline, and reading one's bytes as base64 off disk. The
  ! provider-specific block SHAPE (Anthropic's `image`/`document` content blocks
  ! vs. OpenAI's `input_image`/`input_file`) stays in each provider's own file —
  ! only the "is this inlinable, and what are its bytes" step is common.
//]

namespace harpe.models
import harpe.ffi.os
import harpe.ffi.file

//[ An image format the vision APIs accept inline (Anthropic and OpenAI agree on
  ! this set: JPEG, PNG, GIF, WebP).
//]
def isInlineImage(mime: String): Bool =
  mime == "image/jpeg" || mime == "image/png" || mime == "image/gif" || mime == "image/webp"

//[ A document format accepted inline — PDF only, on both providers. //]
def isInlinePdf(mime: String): Bool = mime == "application/pdf"

//[ The base64 bytes of attachment `name` under the session's `dataDir`, or `None`
  ! if there is no data directory, the file is gone, or it cannot be read. A
  ! silent `None` (not a crash) is deliberate: an inline attachment is always ALSO
  ! referenced in the text manifest, so a render still succeeds — just without the
  ! direct content block — if the file disappeared between attachment and render.
//]
def readInlineBase64(dataDir: String, name: String): Option[String] =
  if dataDir == "" then None
  else
    val path = os.path.join(dataDir, name)
    if !os.path.isfile(path) then None
    else
      match py.try(file.readBytes(path))
      case Ok(data) => Some(data.cast[Bytes].toBase64)
      case Err(_)   => None
