//[ WindowedContext.jo
  !
  ! The default `Context` strategy: a sliding window over the transcript. Turns
  ! that fall out of the window are dropped from the sent context (the
  ! structured session log still keeps them). Anything that must outlive the
  ! window is the agent's own to keep — notes in a file it maintains with the
  ! tools it already has.
//]

namespace harpe.context

import harpe.*
import harpe.util.truncate
import harpe.Model.*

//[ Budget (characters) for the recent transcript window (~4 chars/token)
  !
  ! Older whole turns are dropped to fit. Anything that must outlive the window
  ! is the agent's own to keep.
//]
private def maxTranscriptChars(): Int = 24000

//[ The default context
  !
  ! The `baseSystem` prompt it is given as `system`, and a char-budget window of
  ! recent turns as the messages. `initial` seeds the window (a resumed
  ! session's replayed transcript. `[]` for a fresh one).
//]
class WindowedContext(baseSystem: String, initial: List[Message])
  view Context

  private var transcript: List[Message] = initial
  private var marked: List[Message] = initial

  def append(message: Message): Unit =
    transcript = transcript + message

  //[ Pure — `interact` is unused. //]
  def render(interact: Interact): Rendered =
    new Rendered(baseSystem, truncate(transcript, maxTranscriptChars()))

  // Sizes on a fixed char window, so reported usage is not needed.
  def observe(usage: Usage): Unit = pass

  def mark(): Unit =
    marked = transcript

  def rollback(): Unit =
    transcript = marked
end

