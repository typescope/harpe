//[ FullContext.jo
  !
  ! A no-op `Context` strategy: the entire transcript is kept as-is and sent
  ! verbatim on every request — no windowing, no compaction, no summarization.
  ! Suitable for short sessions or when the caller handles context limits itself.
//]

namespace harpe.context

import harpe.*
import harpe.Model.*

//[ A context that never drops or compresses any turn.
  !
  ! Every message appended since the session started is included in every
  ! prepared snapshot. No budget is enforced. The caller is responsible for staying
  ! within the model's context window. `observe` is a no-op: there is nothing to
  ! size or trigger.
//]
class FullContext(baseSystem: String, initial: List[Message])
  view Context

  private var transcript: List[Message] = initial
  private var marked: List[Message] = initial

  def append(message: Message): Unit =
    transcript = transcript + message

  def compact(interact: Interact): Context.Result =
    new Context.Result(new Rendered(baseSystem, transcript), false)

  def observe(usage: Usage): Unit = pass

  def mark(): Unit =
    marked = transcript

  def rollback(): Unit =
    transcript = marked
end
