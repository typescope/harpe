//[ TurnContext.jo
  !
  ! A context whose working history lasts for exactly one logical turn. Past
  ! conversation remains the turn log's concern and can be exposed to the
  ! model selectively through application tools.
//]

namespace harpe.context

import harpe.*
import harpe.Model.*
import harpe.metering.Usage

//[ A context that keeps only the active turn.
  !
  ! `baseSystem` is included in every model request. The user's input and all
  ! assistant and tool messages appended during the turn remain available at
  ! subsequent model-call boundaries in that turn. `commitTurn` and
  ! `abortTurn` both clear those messages, so no conversation history is carried
  ! into the next turn.
  !
  ! Use this strategy when turns are independent or when an application exposes
  ! prior conversation explicitly through a transcript-retrieval tool.
//]
class TurnContext(baseSystem: String)
  view Context

  private var messages: List[Message] = []

  def beginTurn(input: UserInput): Unit =
    messages = [input]

  def append(message: Message): Unit =
    messages = messages + message

  def compact(interact: Interact): Context.Result =
    new Context.Result(new Rendered(baseSystem, messages), false)

  def observe(usage: Usage): Unit = pass

  def commitTurn(): Unit =
    messages = []

  def abortTurn(): Unit =
    messages = []
end
