//[ SummarizingContext.jo
  !
  ! A compacting `Context` strategy: turns that fall out of the window are
  ! distilled into a rolling summary (using the model itself) instead of
  ! dropped, so long sessions keep their thread without unbounded context.
//]

namespace harpe.context

import harpe.*
import harpe.util.truncate
import harpe.Model.*
import harpe.logging.logger

//[ Like `WindowedContext`, but with model-assisted distillation of old turns.
  !
  ! Compaction is hysteresis-triggered on the provider's own reported token count:
  ! when the last request's `inputTokens` exceeds `highWaterTokens`, the oldest
  ! whole turns are folded into the summary until the window fits `lowWaterChars`
  ! — rare, large compactions (low-water well below high-water), so the provider's
  ! cached prefix survives most requests. Using the reported count (fed in via
  ! `observe`) is exact and model-agnostic — no tokenizer, no stale context-window
  ! table. It is REACTIVE: the count is known only after a reply, so an oversized
  ! request may go out once before the next render compacts. The low-water target
  ! is still measured in characters (`truncate` has no per-turn token counts) — a
  ! rough "how much to keep" against the exact "when to act".
  !
  ! The distillation is one call to `distill` — a `Rendered => Option[String]`
  ! summarizer supplied at construction, not the whole `Model` interface. It is
  ! typically a thin wrapper over the agent's brain, or a cheaper model reserved
  ! for summarization (`rendered => model.startTurn(rendered).reply([], [])`,
  ! taking the reply text). `None` — a failed or cancelled call — skips compaction
  ! and retries on the next request. Decoupling from `Model` keeps the strategy
  ! agnostic to how a summary is produced (an LLM, a heuristic, a stub).
//]
class SummarizingContext(
    baseSystem: String, memory: Memory, initial: List[Message],
    highWaterTokens: Int, lowWaterChars: Int,
    distill: Rendered => Option[String] receives logger)
  view Context

  private var summary: String = ""
  private var transcript: List[Message] = initial
  private var markedTranscript: List[Message] = initial
  private var markedSummary: String = ""
  private var markedInputTokens: Int = 0

  // The provider's reported input-token count for the last request (0 until the
  // first reply). Drives the compaction trigger. Updated by `observe`.
  private var lastInputTokens: Int = 0

  def append(message: Message): Unit =
    transcript = transcript + message

  // Size the next compaction decision on the provider's exact token count.
  def observe(usage: Usage): Unit = lastInputTokens = usage.inputTokens

  //[ Compact if over the high-water mark, then compose
    !
    ! The base prompt and the distilled summary as `system`, the retained recent
    ! turns as the messages, and the volatile memory block as the transient tail
    ! (after the transcript, so a memory edit leaves the cached prefix intact).
    ! The summary stays in `system`: a compaction rewrites the message window at
    ! the same moment, so keeping the summary cached with the base prompt costs
    ! nothing.
  //]
  def render(interact: Interact): Rendered receives logger =
    if lastInputTokens > highWaterTokens then compact(interact)

    val mem = memory.snapshot()
    var system = baseSystem

    if summary != "" then system = system + "\n\n" + summaryBlock(summary)

    val transient = if mem.isEmpty then "" else memoryBlock(mem)

    new Rendered(system, transcript, transient)

  def mark(): Unit =
    markedTranscript = transcript
    markedSummary = summary
    markedInputTokens = lastInputTokens

  //[ Restores the summary and the token count too
    !
    ! A compaction rewrites the window, so rolling back only the window would
    ! resurrect turns already folded into the summary — or leave a stale high
    ! token count that re-triggers it.
  //]
  def rollback(): Unit =
    transcript = markedTranscript
    summary = markedSummary
    lastInputTokens = markedInputTokens

  //[ Fold the oldest whole turns into the rolling summary
    !
    ! Keeping the window `truncate` would keep under the low-water budget.
    ! Skipped (leaving the transcript untouched) when the distillation call
    ! fails or is cancelled, or when nothing can be dropped (the window is a
    ! single oversized turn).
  //]
  private def compact(interact: Interact): Unit receives logger =
    val kept = truncate(transcript, lowWaterChars)
    val dropCount = transcript.size - kept.size

    if dropCount > 0 then
      val dropped = transcript.take(dropCount)
      val request: Message = distillRequest(summary, dropped)

      if distill(new Rendered(distillSystem(), [request], "")) is Some(text) then
        summary = text
        transcript = kept
        interact.emit: turns.ContextCompacted(dropCount)
end

//[ The distilled-history block
  !
  ! Between the stable base prompt and the memory block (it changes only at
  ! compactions, memory on any agent edit).
//]
private def summaryBlock(summary: String): String =
  "# Conversation summary\n\n(Older turns, distilled; the messages below are the most recent turns.)\n\n" + summary

//[ The distiller's system prompt. //]
private def distillSystem(): String =
  "You maintain a running summary of a conversation between a user and an agent. Reply with ONLY the updated summary text — no preamble, no headings. Preserve: the user's goals and constraints, decisions made, facts discovered, tool actions taken and their outcomes, and unresolved questions. Be concise; drop pleasantries and dead ends."

//[ The distillation request
  !
  ! The summary so far (if any) plus the turns being folded in, rendered as
  ! plain text.
//]
private def distillRequest(summary: String, dropped: List[Message]): Message =
  val lead =
    if summary == "" then "Conversation excerpt to summarize:\n\n"
    else "Current summary:\n\n" + summary + "\n\nNew conversation excerpt to fold into it:\n\n"

  UserText(lead + excerptText(dropped) + "\nReply with the updated summary.", [])

//[ A plain-text rendering of transcript messages for the distiller. //]
private def excerptText(ms: List[Message]): String =
  var s = ""

  for m in ms do
    match m
    case UserText(t, _) =>
      s = s + "User: " + t + "\n"

    case Assistant(text, calls) =>
      if text != "" then s = s + "Agent: " + text + "\n"

      for c in calls do s = s + "Agent: [called tool \{c.name}]\n"

    case ToolResults(results) =>
      for r in results do s = s + "[tool result] " + r.content + "\n"

  s
