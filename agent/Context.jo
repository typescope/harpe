//[ Context.jo
  !
  ! `Context` — the pluggable context-engineering surface. A per-session value
  ! that owns the transcript and composes what the model sees for each request:
  ! the engine (`Agent.ask`) appends transcript events to it and calls `compact`
  ! at model-call boundaries.
  !
  ! Four strategies are provided, named by their retention policy:
  !
  ! - `FullContext` keeps every completed turn.
  ! - `WindowedContext` keeps a bounded window of recent turns.
  ! - `SummarizingContext` distills older turns into a rolling model-generated
  !   summary.
  ! - `TurnContext` keeps only the active turn.
  !
  ! Each renders its base system prompt as `system` and its working semantic
  ! history as `messages`.
  !
  ! VOLATILE CONTENT IS NOT A FRAMEWORK CONCERN. There is no slot for working
  ! notes or retrieved documents, because there never needed to be one: a
  ! strategy that wants them in front of the model appends them to `messages` as
  ! a trailing user message, which is exactly what a dedicated field did. An
  ! agent that keeps notes in a file reads them with the tools it already has.
//]

namespace harpe

import harpe.Interact
import harpe.Model.Message
import harpe.Model.Rendered
import harpe.metering.Usage
import harpe.Model.UserInput
import harpe.logging.logger
import harpe.context.FullContext

//[ A context-management strategy: owns the transcript, composes each request. //]
interface Context
  //[ Start a logical turn and add its user input to the working context. //]
  def beginTurn(input: UserInput): Unit

  //[ Record a transcript event: user text, an assistant reply, or tool results. //]
  def append(message: Message): Unit

  //[ Compact if needed and return the current model-input snapshot
    !
    ! May be effectful: an implementation can summarize through `interact` and
    ! mutate its transcript. The result always carries the exact snapshot after
    ! maintenance. `compacted` tells the engine whether it must replace the
    ! provider session.
  //]
  def compact(interact: Interact): Context.Result receives logger

  //[ Observe the token usage the provider reported for the last request
    !
    ! The engine calls this after each successful reply, so a strategy can size
    ! itself on the provider's exact counts (a token-budget `SummarizingContext`
    ! compacts on `usage.inputTokens`). A strategy that doesn't care ignores it.
  //]
  def observe(usage: Usage): Unit

  //[ Finish a successful turn, retaining whatever this strategy keeps. //]
  def commitTurn(): Unit

  //[ Finish an unsuccessful turn and discard its provisional assistant/tool tail. //]
  def abortTurn(): Unit
end

section Context
  //[ The context snapshot prepared for a model-call boundary. //]
  class Result(rendered: Rendered, compacted: Bool)

  //[ A context that carries nothing across turns
    !
    ! The default for `runTurn`'s `context`. It holds the active turn — the model
    ! still sees the user's input and each tool result — and clears it when the
    ! turn ends, so nothing survives into the next call.
    ! Because a default expression is evaluated per call, every defaulted turn
    ! gets its own, and two such turns never see each other's transcript.
    !
    ! A session that should remember its past turns supplies a real strategy —
    ! `WindowedContext` or `SummarizingContext` — and keeps it alive across turns.
  //]
  def noHistory: Context = new FullContext("", [])
end
