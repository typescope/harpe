//[ TurnEvent.jo
  !
  ! Events in a turn of agent.
//]

namespace harpe.turns

//[ TurnEvent
  !
  ! Non-terminal progress emitted while a turn is still running. Completion,
  ! interruption, and failure are represented only by `TurnResult`.
  !
  ! The handler decides how or whether to present each event. `*Started` and
  ! `*Ended` pairs bracket a blocking call so a handler can drive a progress
  ! indicator around it.
//]
union TurnEvent =
    ModelRequestStarted(attempt: Int, maxAttempts: Int)   // attempt 0 = first try
  | ModelRequestEnded
  | TransientError(detail: String, delaySeconds: Float)   // about to wait, then retry
  | ToolBudgetReached(budget: Int)                         // no tools offered; forcing a final answer
  | ToolCallStarted(name: String)
  | ToolCallEnded(name: String, summary: String)
  | ContextCompacted(droppedMessages: Int)                 // old turns distilled into the context's summary
