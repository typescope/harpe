//[ WebInteract.jo
  !
  ! The flight-booker web driver's `Interact` implementation. Every `TurnEvent`
  ! from the shared engine becomes a small JSON object written to the browser via
  ! the NDJSON response stream. The browser reads those lines as they arrive, so
  ! the page shows live progress (thinking indicator, tool call names, the
  ! assistant's reply as it is produced).
  !
  ! Cancellation is the session's `stop` threading event, set by
  ! `POST /api/stop`. Approval routes through the per-session waiting mechanism
  ! so the booking confirmation card can block the engine until the user decides.
//]

namespace harpe.examples.flightbooker

import harpe.Interact
import harpe.Approvals
import harpe.turns.TurnEvent

//[ One turn's NDJSON sink: a call writes one JSON object to the response stream. //]
type Sink = py.Dict => Unit

//[ Approval callback: called by the engine with the correlation ID, the title,
  ! and the Markdown detail. It blocks until the user decides.
//]
type ApprovalHandler = (String, String, String) => Approvals.Decision

private class WebInteract(sink: Sink, stop: py.Dynamic, approvalHandler: ApprovalHandler)
  view Interact

  def cancelled: Bool = stop.is_set().asBool

  def pause(seconds: Float): Bool = stop.wait(seconds).asBool

  def approve(title: String, detail: String): Approvals.Decision =
    val id = py.module("uuid").uuid4().toString
    approvalHandler(id, title, detail)

  def emit(event: TurnEvent): Unit =
    match event
    case TurnEvent.ModelRequestStarted(attempt, maxAttempts) =>
      val label = if attempt == 0 then "thinking" else "retrying \{attempt}/\{maxAttempts}"
      sink(py.dict("type" ~ "status", "label" ~ label))

    case TurnEvent.ModelRequestEnded =>
      pass

    case TurnEvent.TransientError(detail, delaySeconds) =>
      sink(py.dict("type" ~ "status", "label" ~ "transient error; retrying in \{delaySeconds}s"))

    case TurnEvent.AssistantChunk(text) =>
      sink(py.dict("type" ~ "assistant-chunk", "text" ~ text))

    case TurnEvent.AssistantStreamReset =>
      sink(py.dict("type" ~ "assistant-stream-reset"))

    case TurnEvent.AssistantMessage(text) =>
      sink(py.dict("type" ~ "assistant-message", "text" ~ text))

    case TurnEvent.ToolBudgetReached(budget) =>
      sink(py.dict("type" ~ "status", "label" ~ "tool budget reached (\{budget})"))

    case TurnEvent.ToolCallStarted(name) =>
      sink(py.dict("type" ~ "status", "label" ~ name))

    case TurnEvent.ToolCallEnded(name, summary) =>
      sink(py.dict("type" ~ "tool", "name" ~ name, "summary" ~ summary))

    case TurnEvent.ContextCompacted(droppedMessages) =>
      sink(py.dict("type" ~ "status", "label" ~ "context compacted (\{droppedMessages} messages summarized)"))
  end
end
