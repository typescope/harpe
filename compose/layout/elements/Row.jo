//[ Row.jo
  !
  ! Children laid left to right.
  !
  ! `Cross.baseline` is the default and the interesting case: every child reports
  ! a baseline, so a row of mixed font sizes lines up with no vertical arithmetic
  ! at the call site.
  !
  ! Both methods work from one `Track`, so the size this row reports and the
  ! places it puts its children are the same computation read twice.
//]

namespace compose.layout.elements

import compose.layout.*
import compose.drawing.*

//[ Children laid left to right. //]
class Row(children: List[Element], gap: Float, cross: Cross)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics =
    val track = resolve(children, gap, c.maxW, c.maxH, true)
    new Measured(
      c.clampW(track.total(gap)),
      c.clampH(track.above + track.below),
      track.above)

  def layout(bounds: Rect): Laid receives graphics =
    val track = resolve(children, gap, bounds.width, bounds.height, true)
    val baseline = track.above
    var kids = List.empty[Laid]
    var x = bounds.x
    var i = 0

    while i < children.size do
      val w = track.sizes.get(i)
      val m = track.metrics.get(i)

      val h =
        match cross
        case _: Cross.stretch => bounds.height
        case _                => m.height

      val y =
        match cross
        case _: Cross.center   => bounds.y + (bounds.height - h) / 2.0
        case _: Cross.finish   => bounds.y + bounds.height - h
        case _: Cross.baseline => bounds.y + baseline - m.baseline
        case _                 => bounds.y

      kids = kids ++ [children.get(i).layout(new Rect(x, y, w, h))]
      x = x + w + gap
      i = i + 1

    new Laid(this, bounds, baseline, kids)

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    Element.paintChildren(cv, node)
end
