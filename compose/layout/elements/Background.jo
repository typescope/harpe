//[ Background.jo
  !
  ! A filled rounded rectangle behind a child.
  !
  ! It does one thing. A bordered card is `border(background(child, …), …)` —
  ! composing two elements rather than one element carrying two optional halves,
  ! which is what it was before. Neither needs engine support: because `draw`
  ! recurses into children itself, decoration is just painting before the
  ! recursion.
//]

namespace compose.layout.elements

import compose.layout.*
import compose.drawing.*

//[ A filled rounded rectangle behind a child. //]
class Background(child: Element, paint: Paint, radius: Float)
  view Element

  def flexWeight: Float = 0.0

  def measure(c: Constraints): Measured receives graphics = child.measure(c)

  def layout(bounds: Rect): Laid receives graphics =
    val kid = child.layout(bounds)
    new Laid(this, bounds, kid.baseline, [kid])

  def draw(cv: Canvas, node: Laid): Unit receives
      graphics, Style.alpha, Style.transform, Style.clip
  =
    val b = node.bounds

    // A rounded rect never self-intersects, so the fill rule cannot change what
    // is covered — `nonZero` is bound here only because `fill` requires one.
    with Style.fillPaint = paint, Style.fillRule = FillRule.nonZero in
      cv.fill(Region.roundRect(b.x, b.y, b.width, b.height, radius))

    Element.paintChildren(cv, node)
end
