//[ Prose.jo
  !
  ! Styled text blocks — the vocabulary an author writes in.
  !
  !   Prose.column:
  !     Prose.title("Quarterly report")
  !     Prose.body(summary)
  !     Prose.bullets(findings)
  !
  ! Every constructor is one line: pick a slot from the ambient `styles` and hand
  ! it to `styled`. That is the whole layer — it constructs `Element`s and adds
  ! no mechanism, which is what keeps it droppable. Anything it can build you can
  ! build by hand with `Element.text` under a `with`, and anything it cannot
  ! express you write at that level without leaving the engine.
//]

namespace compose.prose

import compose.drawing.*
import compose.layout.*
import compose.layout.elements.*

section Prose
  //[ Text in an explicit style — the one primitive here
    !
    ! The named constructors below are this with a slot chosen for you.
    !
    ! It *binds* the style rather than reading ambient state, which is what
    ! makes the stylesheet win over a `with Style.font = …` around the call
    ! site.
  //]
  def styled(style: TextStyle, content: String): Element receives graphics =
    with
      Style.font = style.font,
      Style.textPaint = style.paint,
      Typesetting.leading = style.leading,
      Typesetting.align = style.align
    in
      Element.text(content)

  def title(content: String): Element receives graphics, styles =
    styled(styles.title, content)

  def heading(content: String): Element receives graphics, styles =
    styled(styles.heading, content)

  def subheading(content: String): Element receives graphics, styles =
    styled(styles.subheading, content)

  def body(content: String): Element receives graphics, styles =
    styled(styles.body, content)

  def caption(content: String): Element receives graphics, styles =
    styled(styles.caption, content)

  //[ A small, quiet run — a masthead, a field name, a colophon entry. //]
  def label(content: String): Element receives graphics, styles =
    styled(styles.label, content)

  //[ Stack blocks with the sheet's `blockGap` between them
    !
    ! Spacing lives here rather than on each style, so adjacent blocks cannot
    ! double-space.
  //]
  def column(blocks: ..Element): Element receives styles =
    new Column(blocks, styles.blockGap, Cross.stretch)

  //[ A bulleted list
    !
    ! Each mark shares a baseline with the first line of its item, which `row`
    ! does for free — the mark and the text are just two children with
    ! baselines.
  //]
  def bullets(items: List[String]): Element receives graphics, styles =
    var rows = List.empty[Element]

    for item in items do
      rows = rows ++ [
        Element.row(
          styled(styles.body, styles.bulletMark),
          Element.space(styles.bulletIndent, 0.0),
          Element.flex(1.0, styled(styles.body, item)))]

    new Column(rows, styles.blockGap / 2.0, Cross.stretch)
end
