//[ Typesetting.jo
  !
  ! Text-layout state, read by the text layer: horizontal `align` and line
  ! `leading`. Like `Style`, these are context parameters changed by
  ! rebinding over a block:
  !
  !   with Typesetting.align = Align.center in
  !     Text.paragraph(cv, title, band)
  !
  ! Kept separate from `Style` because the backend never sees these.
  ! They are consumed in pure Jo, above the imaging model.
//]

namespace compose.drawing

//[ Horizontal text alignment. `justify` is accepted but currently renders as
  ! `left` — justification belongs to the text engine, not the thin wrapper.
  ! See `Text`.
//]
type Align = Align.left | Align.right | Align.center | Align.justify

section Align
  object left
  object right
  object center
  object justify
end

section Typesetting
  param align: Align = Align.left
  param leading: Float = 1.3     // line spacing, as a multiple of the font size
end
