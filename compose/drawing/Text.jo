//[ Text.jo
  !
  ! Shaped text: the glyph vocabulary, and wrapping into lines.
  !
  ! A `GlyphRun` is the output of shaping — positioned glyph ids, not
  ! characters. Everything below the shaper works in glyphs, which is what makes
  ! kerning and ligatures come out right: `graphics.shape` runs the text through
  ! HarfBuzz, and `canvas.glyphs` draws exactly what it produced.
  !
  ! A wrapped paragraph is a list of `Line`s, each a list of shaped word runs.
  ! Keeping the words distinct (rather than one run per line) is what lets
  ! `Align.justify` widen the gaps between them — a line is placed word by word,
  ! with a gap that is the normal space width, or, when justifying, the space
  ! that makes the line fill its box.
  !
  ! Still deliberately thin, and still not the whole text engine:
  !
  ! - one script per string, no itemization and no font fallback, so a code
  ! point the ambient font lacks renders as a missing-glyph box - greedy
  ! breaking at whitespace only — no UAX #14, no kinsoku, and a word wider than
  ! the box overruns it rather than breaking - all whitespace (including
  ! newlines) is a soft break. There is no hard break
  !
  ! Those three all belong to the break stage, which arrives with the vendored
  ! UCD tables. See `drawing-engine.md`.
//]

namespace compose.drawing

//[ One positioned glyph
  !
  ! `id` is an index into the font, not a code point. `cluster` is the offset in
  ! the source text it came from.
//]
class Glyph(id: Int, xAdvance: Float, xOffset: Float, yOffset: Float, cluster: Int)

//[ A run of shaped glyphs in one font. //]
class GlyphRun(font: Font, glyphs: List[Glyph])
  //[ The run's total advance width. //]
  def width: Float =
    var w = 0.0

    for g in glyphs do
      w = w + g.xAdvance

    w
end

//[ One wrapped line: the shaped words on it, in order. //]
class Line(words: List[GlyphRun])
  //[ The words' combined width, without the spaces between them. //]
  def wordsWidth: Float =
    var w = 0.0

    for run in words do
      w = w + run.width

    w

  //[ The number of inter-word gaps — what justification distributes across. //]
  def gaps: Int = if words.size > 1 then words.size - 1 else 0

  //[ The line's natural width, with `spaceW`-wide gaps. //]
  def naturalWidth(spaceW: Float): Float = wordsWidth + spaceW * gaps.toFloat
end

section Text
  //[ Greedily wrap `text` to `width`, one `Line` per visual line
    !
    ! Whitespace separates words. A word wider than `width` overruns onto its
    ! own line.
  //]
  def wrap(text: String, width: Float): List[Line] receives graphics, Style.font =
    val ws = words(text)
    val spaceW = graphics.shape(" ").width
    var lines = List.empty[Line]
    var cur = List.empty[GlyphRun]
    var curW = 0.0
    var i = 0

    while i < ws.size do
      val run = graphics.shape(ws.get(i))
      val gap = if cur.isEmpty then 0.0 else spaceW

      if !cur.isEmpty && curW + gap + run.width > width then
        lines = lines ++ [new Line(cur)]
        cur = [run]
        curW = run.width
      else
        cur = cur ++ [run]
        curW = curW + gap + run.width

      i = i + 1

    if !cur.isEmpty then
      lines = lines ++ [new Line(cur)]

    lines

  //[ Draw `lines` into `box`, one per `leading`-scaled line height, at the ambient alignment
    !
    ! Returns the y offset just past the last baseline, so a caller can stack
    ! blocks. Lines past the bottom of `box` are still drawn — clipping and
    ! overflow are the layout engine's job, not this layer's.
    !
    ! `justify` stretches the inter-word gaps to fill the box, but never on the
    ! last line (which would leave a sparse final row) nor on a line with no
    ! gaps to stretch.
  //]
  def draw(cv: Canvas, lines: List[Line], box: Rect): Float receives
      graphics,
      Style.font,
      Style.textPaint,
      Style.alpha,
      Style.transform,
      Style.clip,
      Typesetting.align,
      Typesetting.leading
  =
    val lineHeight = Typesetting.leading * Style.font.size
    val spaceW = graphics.shape(" ").width
    var y = graphics.fontAscent
    var idx = 0

    for line in lines do
      val isLast = idx == lines.size - 1
      drawLine(cv, line, box, box.y + y, spaceW, isLast)
      y = y + lineHeight
      idx = idx + 1

    y

  //[ Place one line's words
    !
    ! Left to right, at the alignment's starting x with its gap width.
  //]
  private def drawLine(cv: Canvas, line: Line, box: Rect, baseline: Float,
                       spaceW: Float, isLast: Bool): Unit receives
      Style.textPaint, Style.alpha, Style.transform, Style.clip, Typesetting.align
  =
    val justify = isJustify(Typesetting.align) && !isLast && line.gaps > 0
    val natural = line.naturalWidth(spaceW)

    val gap =
      if justify then (box.width - line.wordsWidth) / line.gaps.toFloat
      else spaceW

    val startX =
      match Typesetting.align
      case _: Align.center => box.x + (box.width - natural) / 2.0
      case _: Align.right  => box.x + box.width - natural
      case _               => box.x

    var x = startX

    for run in line.words do
      cv.glyphs(run, x, baseline)
      x = x + run.width + gap

  private def isJustify(align: Align): Bool =
    match align
    case _: Align.justify => true
    case _                => false

  //[ Wrap `text` to `box`'s width and draw it — the common case. //]
  def paragraph(cv: Canvas, text: String, box: Rect): Float receives
      graphics,
      Style.font,
      Style.textPaint,
      Style.alpha,
      Style.transform,
      Style.clip,
      Typesetting.align,
      Typesetting.leading
  =
    draw(cv, wrap(text, box.width), box)

  //[ Split `text` on whitespace, dropping empty runs. //]
  private def words(text: String): List[String] =
    var out = List.empty[String]
    var cur = ""

    for ch in text do
      if isSpace(ch.toInt) then
        if cur != "" then
          out = out ++ [cur]
          cur = ""

      else
        cur = cur + ch.toString

    if cur != "" then
      out = out ++ [cur]

    out

  private def isSpace(codePoint: Int): Bool =
    codePoint == 32 || codePoint == 9 || codePoint == 10 || codePoint == 13
end
