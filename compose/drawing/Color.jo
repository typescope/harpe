//[ Color.jo
  !
  ! An RGBA color, part of the shared imaging vocabulary (`compose.drawing`).
  !
  ! Channels are floats in [0, 1], sRGB, with straight (not premultiplied) alpha
  ! — the backend premultiplies when it composites. Float channels are what let
  ! a color carry its own transparency, so translucency is a property of the
  ! paint rather than ambient state.
//]

namespace compose.drawing

//[ An RGBA color: channels in [0, 1], sRGB, straight alpha. //]
class Color(r: Float, g: Float, b: Float, a: Float)
  //[ This color at opacity `alpha` (0 transparent, 1 opaque). //]
  def fade(alpha: Float): Color = new Color(r, g, b, alpha)
end

section Color
  //[ An opaque color from channels in [0, 1]. //]
  def rgb(r: Float, g: Float, b: Float): Color = new Color(r, g, b, 1.0)

  //[ An opaque color from 8-bit channels — the form a designer or an LLM
    ! quotes, e.g. `Color.rgb255(25, 35, 80)`.
  //]
  def rgb255(r: Int, g: Int, b: Int): Color =
    new Color(r.toFloat / 255.0, g.toFloat / 255.0, b.toFloat / 255.0, 1.0)

  def black: Color = new Color(0.0, 0.0, 0.0, 1.0)
  def white: Color = new Color(1.0, 1.0, 1.0, 1.0)
  def transparent: Color = new Color(0.0, 0.0, 0.0, 0.0)
end
