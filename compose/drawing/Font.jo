//[ Font.jo
  !
  ! A font descriptor for the imaging model. Metrics live on the writer
  ! (`stringWidth`, `fontAscent`, `fontDescent`); this is just the selection.
//]

namespace compose.drawing

//[ A font: a `family` ("sans", "serif", "mono", or a registered name), a
  ! `style` ("", "B", "I", "BI"), and a `size` in the surface's units.
//]
class Font(family: String, style: String, size: Float)

section Font
  def sans(size: Float): Font = new Font("sans", "", size)
  def serif(size: Float): Font = new Font("serif", "", size)
  def mono(size: Float): Font = new Font("mono", "", size)
  def bold(size: Float): Font = new Font("sans", "B", size)
end
