//[ Style.jo
  !
  ! Drawing state: the ambient parameters every surface op reads. This is what
  ! PDF and cairo call the *graphics state* — paints, stroke geometry, fill
  ! rule, alpha, font, transform and clip.
  !
  ! State is not set through methods — each field is a context parameter with a
  ! default, changed by rebinding over a block:
  !
  !   with Style.fillPaint = Paint.of(Color.white) in
  !     canvas.fill(box)
  !
  ! A surface method declares exactly which of these it consumes (via
  ! `receives`), so a signature says precisely what state an op depends on.
  !
  ! Two kinds of state, synced differently by the backend. Scalar state (paints,
  ! stroke, alpha, font) is re-emitted per op by diffing against what was last
  ! emitted. Accumulative state (`transform`, `clip`) composes and cannot be
  ! un-set, so the backend brackets it with save/restore.
  !
  ! Group opacity is deliberately NOT here — see `Canvas.group`.
  !
  ! Note for the layers above: this name is spent. The vocabulary layer's
  ! per-element styling is `TextStyle` / `BlockStyle` inside a `StyleSheet`, not
  ! a bare `Style`.
//]

namespace compose.drawing

//[ Which points a path encloses when it self-intersects or has subpaths
  !
  ! `nonZero` is the usual default. `evenOdd` is what punches a hole through an
  ! inner subpath.
//]
type FillRule = FillRule.nonZero | FillRule.evenOdd

section FillRule
  object nonZero
  object evenOdd
end

section Style
  param fillPaint: Paint
  param strokePaint: Paint
  param textPaint: Paint
  param stroke: Stroke
  param fillRule: FillRule
  param alpha: Float
  param font: Font
  param transform: Matrix

  //[ Clip regions, outermost first
    !
    ! The visible area is their **intersection**, so nesting narrows rather than
    ! replaces — a clipped panel inside a clipped card behaves the way it reads.
    ! Append to nest. `[]` clips nothing.
  //]
  param clip: List[Region]

  //[ Run `work` with the conventional drawing state bound
    !
    ! No parameter here carries a default, so a piece states the state it draws
    ! under rather than inheriting one silently. This is that statement for the
    ! ordinary case — black ink, a hairline stroke, 16pt sans, no transform and
    ! no clip — and what an entry point binds before it draws anything. Any
    ! block rebinds whichever of them it means to change.
  //]
  def withDefaults[T](work: () => T receives
      fillPaint, strokePaint, textPaint, stroke, fillRule,
      alpha, font, transform, clip): T =
    with fillPaint = new Solid(Color.black),
        strokePaint = new Solid(Color.black),
        textPaint = new Solid(Color.black),
        stroke = Stroke.of(1.0),
        fillRule = FillRule.nonZero,
        alpha = 1.0,
        font = new Font("sans", "", 16.0),
        transform = Matrix.identity,
        clip = []
    in
      work()
end
