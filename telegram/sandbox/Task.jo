//[ Task.jo — the sandbox's default guest task.
  !
  ! The entry point the agent's `runCode` tool overwrites each turn. This default
  ! just proves the sandbox runs and that `fs` is wired to the data directory.
//]

namespace sandbox.guest

import sandbox.api.*
import harpe.caps.*

def runTask(): Unit receives IO.stdout, fs =
  val count = match fs.list(fs.root)
              case Ok(entries) => entries.size
              case Err(_)      => 0

  println "sandbox ready — \{count} file(s) in the data directory"
