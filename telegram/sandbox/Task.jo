namespace sandbox.guest

import sandbox.api.*

def runTask(): Unit receives IO.stdout =
  var sum = 0
  var n = 2
  while n < 1000 do
    var isPrime = true
    var i = 2
    while i * i <= n do
      if n % i == 0 then
        isPrime = false
      end
      i = i + 1
    end
    if isPrime then
      sum = sum + n
    end
    n = n + 1
  end
  println sum
