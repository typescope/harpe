# Copy to .env and fill in. The loop loads .env on startup.

# --- Telegram (required) ---
# A bot token from @BotFather (talk to it in Telegram, /newbot).
TELEGRAM_BOT_TOKEN=

# Comma-separated SENDER (user) ids allowed to use the agent. Authorization is by
# who sends the message, not which chat — an allowed user is served in a DM or in
# any group, and no one else is. A bot is publicly reachable and this agent RUNS
# CODE, so access is closed by default: leave this empty and every message is
# rejected. DM the bot once — it replies with your user id — then add it here
# (e.g. 12345678,98765432).
TELEGRAM_ALLOWED_SENDERS=

# Set one provider key. The provider is chosen by which key you set; OpenAI wins
# if both are present.

# --- Anthropic ---
MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# --- OpenAI (Responses API) ---
# MODEL=gpt-5.6
# OPENAI_API_KEY=
# REASONING_EFFORT=medium   # reasoning effort: low | medium | high | none
# OPENAI_BASE_URL=          # optional: Azure OpenAI or another Responses-API endpoint
