//[ Session.jo
  !
  ! The Telegram driver's live conversation object (`Session`) and its storage layout
  ! (the `Session` section): one conversation per Telegram chat, keyed by its numeric
  ! `chat.id`, persisted as `logs/sessions/<chatId>.jsonl` under the workspace. The
  ! chat id is the natural session key — it is stable across messages and survives
  ! restarts, so a chat resumes its history simply by reappearing.
  !
  ! Like the web driver, this layout is a *driver* decision: the section maps a
  ! chat id to its structured log and derives its transcript when loading.
//]

namespace harpe.telegram
import harpe.ffi.time
import harpe.ffi.os
import harpe.ffi.file
import harpe.ffi.json
import harpe.ffi.mimetypes
import harpe.ffi.builtins

import harpe.Agent
import harpe.Routes
import harpe.interact
import harpe.Memory
import harpe.Transcript
import harpe.workspace
import harpe.logging.JsonlLogger
import harpe.logging.Logger
import harpe.logging.logger
import harpe.logging.Entry
import harpe.logging.entryFromDict
import harpe.Model
import harpe.Model.Message
import harpe.Model.UserText
import harpe.Model.Assistant
import harpe.Model.Attachment
import harpe.turns.Success
import harpe.turns.Interrupted
import harpe.turns.Failed


//[ One file the user attached to a Telegram message
  !
  ! As the poll loop hands it to the chat's worker: Telegram's `file_id`
  ! (resolved to bytes only when the turn runs, off the poll thread), a
  ! suggested basename, and the mime type Telegram reported (`""` if none —
  ! guessed from the name at download time).
//]
class FileSpec(fileId: String, name: String, mime: String)

//[ One queued message for a chat's worker
  !
  ! The text (a plain message, or a media caption) and any files that rode with
  ! it. This is the unit the poll loop enqueues and the worker drains —
  ! replacing the bare text string, so a message can now carry attachments.
//]
class Incoming(text: String, files: List[FileSpec], senderId: String)


//[ One live conversation
  !
  ! Its chat id, its append log, its agent (which owns the context and therefore
  ! the running transcript window), and its working memory.
  !
  ! Each session has a FIFO `queue` drained by its own dedicated worker thread,
  ! so turns for different chats run concurrently while turns within one chat
  ! stay ordered and serialized. Only that worker touches the session's state,
  ! so no lock is needed around it.
//]
private class Session(
    id: String, log: Logger, agent: Agent, memory: Memory, memoryPath: String,
    dataDir: String, routes: Routes)
  val queue = py.module("queue").Queue()

  //[ Begin a user turn
    !
    ! Download any attached files into the session's data directory (so the
    ! agent can read them with `fs`), run the turn, then deliver its answer —
    ! the text reply plus any files the agent `sendFile`d back.
  //]
  def runTurn(
      incoming: Incoming,
      client: TelegramClient,
      approvalHandler: TelegramApprovalHandler,
      maxToolRounds: Int,
      maxRetries: Int)
  : Unit =
    val attachments = materialize(incoming, client)
    val userMsg = UserText(incoming.text, attachments)
    val channel = new TelegramInteract(client, this.id, approvalHandler)

    val result = with logger = log, interact = channel in
      agent.runTurn(userMsg, routes, maxToolRounds, maxRetries)

    match result.result
    case Success =>
      commit()
      val answer = result.finalText
      if answer.trim != "" then client.sendMessage(this.id, answer)

    case Interrupted =>
      rollback()

    case Failed(detail) =>
      rollback()
      val message =
        if detail == "" then "Request failed. Please try again."
        else "Request failed: \{detail}"
      client.sendMessage(this.id, message)

  //[ Download this turn's attached files into the session's data directory
    !
    ! Returning them as `Attachment` metadata for the `UserText`. The bytes land
    ! on disk (so the agent reads them with `fs`). Only the metadata rides in
    ! the transcript. A file that fails to resolve or download is skipped rather
    ! than failing the turn — the model still sees the ones that arrived. Runs
    ! on the chat's worker thread, so the network I/O never blocks the poll
    ! loop.
  //]
  private def materialize(incoming: Incoming, client: TelegramClient): List[Attachment] =
    val dir = dataDir

    if dir == "" || incoming.files.isEmpty then []
    else
      var atts: List[Attachment] = []
      for spec in incoming.files do
        match client.getFile(spec.fileId)
        case None => pass

        case Some(remotePath) =>
          match client.downloadFile(remotePath)
          case None => pass

          case Some(data) =>
            val name = uniqueName(dir, sanitizeName(spec.name))
            if name != "" then
              file.writeBytes(os.path.join(dir, name), data)
              val mime = if spec.mime != "" then spec.mime
                         else mimetypes.guessType(name).getOrElse("application/octet-stream")
              val att = Attachment:
                name
                builtins.len(data)
                mime
                inline = false
                path = os.path.join(dir, name)
              atts = atts + att

      atts

  //[ Commit a completed turn's working memory
    !
    ! Transcript entries have already flowed through the structured logger
    ! channel.
  //]
  private def commit(): Unit =
    saveMemory()

  //[ Finish a cancelled or failed turn
    !
    ! Memory is still persisted — it is deliberate and not rolled back with the
    ! provisional assistant transcript. The engine retains the user message.
  //]
  private def rollback(): Unit =
    saveMemory()

  //[ Persist the working memory beside the transcript archive
    !
    ! Runs on the chat's worker thread. The resolved path is captured when the
    ! session is created.
  //]
  private def saveMemory(): Unit =
    if !memory.isEmpty then Memory.save(memoryPath, memory)
end

//[ Reduce a client-supplied name to a safe bare basename
  !
  ! Drop any directory part (both separators) and reject the traversal names, so
  ! a stored or sent file can never escape the session's data directory. "" if
  ! nothing safe remains.
//]
private def sanitizeName(raw: String): String =
  val base = os.path.basename(raw.replace("\\", "/"))
  if base == "" || base == "." || base == ".." then "" else base

//[ A name not already taken in `dir`
  !
  ! `photo.jpg` → `photo-1.jpg` → … so a download never clobbers an existing
  ! file.
//]
private def uniqueName(dir: String, name: String): String =
  if name == "" || !os.path.exists(os.path.join(dir, name)) then name
  else
    val ext = os.extname(name)
    val root = if ext == "" then name else name.substring(0, name.size - ext.size)
    var i = 1
    var candidate = root + "-" + i.toString + ext
    while os.path.exists(os.path.join(dir, candidate)) do
      i = i + 1
      candidate = root + "-" + i.toString + ext
    candidate

section Session
  //[ The file backing this chat's session. //]
  def sessionPath(chatId: String): String receives workspace =
    workspace.relative("logs/sessions/" + chatId + ".jsonl")

  //[ The per-chat data directory
    !
    ! The private root the sandbox grants this session as `HARPE_DATA_DIR`, so
    ! `fs` (and the document readers) see only this chat's files. Downloaded
    ! attachments land here, and files the agent writes surface here too.
    ! Created on demand. Scoped by chat id so chats never share a tree.
  //]
  def dataDir(chatId: String): String receives workspace =
    val dir = workspace.relative("data/" + chatId)
    if !os.path.isdir(dir) then os.makedirs(dir)
    dir

  //[ An append log for this chat's session (its file is created lazily). //]
  def forSession(chatId: String): Logger receives workspace =
    new JsonlLogger(sessionPath(chatId))

  def memoryPath(chatId: String): String receives workspace =
    val path = sessionPath(chatId)
    path.substring(0, path.size - 6) + ".memory.json"

  //[ Reconstruct this chat's conversation from disk
    !
    ! `[]` if it has no file yet, so a chat seen for the first time starts
    ! empty.
  //]
  def load(chatId: String): List[Message] receives workspace =
    val path = sessionPath(chatId)
    if !file.exists(path) then []
    else
      var entries: List[Entry] = []
      for line in file.read(path).lines if line.trim != "" do
        entries = entries + entryFromDict(json.loads(line).cast[py.Dict])
      Transcript.fromEntries(entries)
end
