//[ Session.jo
  !
  ! The Telegram driver's live conversation object (`Session`) and its storage layout
  ! (the `Session` section): one conversation per Telegram chat, keyed by its numeric
  ! `chat.id`, persisted as `logs/sessions/<chatId>.jsonl` under the workspace. The
  ! chat id is the natural session key — it is stable across messages and survives
  ! restarts, so a chat resumes its history simply by reappearing.
  !
  ! Like the web driver, this layout is a *driver* decision kept out of the shared
  ! `harpe.SessionLog` (which owns only the per-message record schema): the section
  ! maps a chat id to its file (`forSession` to append, `load` to read back).
//]

namespace harpe.telegram

import harpe.models.*
import harpe.Memory
import harpe.SessionLog
import harpe.workspace

//[ One live conversation: its chat id, its append log, the running history, and how
  ! much of that history is already persisted.
  !
  ! Each session has a FIFO `queue` drained by its own dedicated worker thread, so
  ! turns for different chats run concurrently while turns within one chat stay
  ! ordered and serialized. Only that worker mutates `history`/`saved`, so no lock is
  ! needed around them.
//]
private class Session(id: String, log: SessionLog, initial: List[Message], memory: Memory)
  val queue = py.module("queue").Queue()
  var history: List[Message] = initial
  var saved: Int = initial.size
  private var priorHistory: List[Message] = initial

  //[ Begin a user turn: append the user's message and return the history to run.
    ! The pre-turn point is remembered so a cancelled/failed turn can roll back.
  //]
  def beginTurn(text: String): List[Message] =
    priorHistory = history
    history = history + UserText(text)
    history

  //[ Commit a completed turn: adopt its history, append the newly-added messages to
    ! the transcript archive, and persist memory.
  //]
  def commit(updated: List[Message]): Unit =
    history = updated
    log.append(time.now(), history.drop(saved))
    saved = history.size
    saveMemory()

  //[ Abandon a cancelled/failed turn: restore the pre-turn history. Memory is still
    ! persisted — it is deliberate and not rolled back with the transcript.
  //]
  def rollback(): Unit =
    history = priorHistory
    saveMemory()

  //[ Persist the working memory beside the transcript archive. Runs on the chat's
    ! worker thread; `memoryPath` is a pure derivation, so no `workspace` capability
    ! is needed.
  //]
  def saveMemory(): Unit =
    if !memory.isEmpty then Memory.save(log.memoryPath, memory)
end

section Session
  //[ The file backing this chat's session. //]
  def sessionPath(chatId: String): String receives workspace =
    workspace.relative("logs/sessions/" + chatId + ".jsonl")

  //[ An append log for this chat's session (its file is created lazily). //]
  def forSession(chatId: String): SessionLog receives workspace =
    new SessionLog(sessionPath(chatId))

  //[ Reconstruct this chat's conversation from disk; `[]` if it has no file yet,
    ! so a chat seen for the first time starts empty.
  //]
  def load(chatId: String): List[Message] receives workspace =
    SessionLog.loadFile(sessionPath(chatId))
end
