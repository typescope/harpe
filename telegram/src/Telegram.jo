//[ Telegram.jo
  !
  ! The Telegram agent loop (the Harpe "conversational" trigger, over a Telegram
  ! bot) and its entry point. `jo run` with `jo.main = harpe.telegram.main`
  ! starts an outbound long-poll against the Bot API: each incoming message —
  ! text, or a file with an optional caption — is one turn of the shared engine,
  ! driven by `TelegramInteract`. Files the user sends are downloaded into the
  ! chat's data directory (read with `fs`). Files the agent produces are sent
  ! back with the `sendFile` tool.
  !
  ! Unlike the web driver there is no HTTP server — Telegram lets the bot pull
  ! updates, so nothing needs to be publicly reachable. The poll thread only
  ! filters and dispatches: each chat has its own FIFO queue drained by a
  ! dedicated worker thread, so turns for different chats run concurrently while
  ! a single chat's turns stay ordered. The poll loop never blocks on a turn.
//]

namespace harpe.telegram
import harpe.ffi.os
import harpe.ffi.sys
import harpe.ffi.threading
import harpe.ffi.signal
import harpe.ffi.dotenv
import harpe.ffi.time

import jo.IO.stdout
import harpe.Agent
import harpe.Approvals
import harpe.workspace
import harpe.Workspace
import harpe.Defaults
import harpe.Model
import harpe.Tool
import harpe.tools.*
import harpe.Toolset
import harpe.Tool.ToolInput
import harpe.context.WindowedContext
import harpe.Transcript
import harpe.transcript.Journal
import harpe.logging.Value
import harpe.logging.logger

//[ The entry point //]
def main(): Unit receives stdout =
  dotenv.load(".env")
  val wspace = new Workspace(os.path.abspath("."))
  with workspace = wspace in serve()

private def serve(): Unit receives stdout, workspace =
  val token = os.getenv("TELEGRAM_BOT_TOKEN", "")
  if token == "" then
    println "Error: TELEGRAM_BOT_TOKEN is not set (get one from @BotFather, put it in .env)."
    sys.exit(1)

  val brain = Defaults.model()
  val rawAllowed = os.getenv("TELEGRAM_ALLOWED_SENDERS", "")
  var allowed: List[String] = []

  if rawAllowed.trim != "" then
    for partDyn in py.dynamic(rawAllowed).split(",").cast[py.List] do
      val part = partDyn.asString.trim
      if part != "" then allowed = allowed + part

  val client = new TelegramClient(token)

  // Startup identity check: confirm the token works and show which bot is live,
  // so a bad/duplicate token fails here with a clear message rather than a
  // silent, unresponsive poll loop.
  val me = client.getMe()
  if !me.get("ok", false).asBool then
    println "Error: Telegram getMe failed — check TELEGRAM_BOT_TOKEN."
    println "  \{client.detail(me)}"
    sys.exit(1)

  val result = me.get("result").cast[py.Dict]
  val username = result.get("username").asString
  val botId = result.get("id").asInt
  val bot = new TelegramBot(brain, client, allowed, username, botId)

  println """

              ♪           ♫
        ──────●───────────
        ───────────●──────
          C A R M E N

        Harpe · Telegram

    """

  println "  Live as @\{username}"
  println "  Ctrl-C to stop"

  if allowed.isEmpty then
    println "  ⚠ TELEGRAM_ALLOWED_SENDERS is empty — all messages are rejected until you add sender ids."

  // Stop cleanly on Ctrl-C instead of dumping a traceback out of the poll loop.
  signal.shutdownOnSigint("\n  ♪ Carmen stopped.")

  bot.run()

//[ The `sendFile` tool — the agent's channel for delivering a file to the user.
  !
  ! A file the agent produced already lives in the chat's data directory (it wrote
  ! it with `fs`). The tool validates the name and sends the document immediately.
  ! A clean error comes back if the name does not resolve,
  ! so the model can correct it rather than silently failing.
//]
//[ The `sendFile` tool
  !
  ! A class, not a section, because it holds the bot's network client — the one
  ! thing here with a lifetime. The chat and the directory are contextual, so
  ! they arrive as arguments from the route.
//]
private class SendFileTool(client: TelegramClient)
  //[ This tool, sending files from `dir` to `chatId`. //]
  def toolset(chatId: String, dir: String): Toolset =
    Toolset.of: spec, (i: Tool.ToolInput) => send(chatId, i["fileName"], dir)

  //[ The spec the model is offered. //]
  private def spec: Tool =
    Tool:
      "sendFile"
      "Deliver a file to the user — it is sent to the chat as a document. Write the file to the data directory first (e.g. with `fs`)."
      [Tool.strParam("fileName", "The name of the file in your data directory to send to the user")]

  //[ Send `fileName` from the chat's data directory `dir` as a document. //]
  def send(chatId: String, fileName: String, dir: String): Tool.RunOutcome =
    val baseName = os.path.basename(fileName.replace("\\", "/"))

    if dir == "" then
      new Tool.RunOutcome("No data directory is available to send from.", "sendFile · no data dir", attachments = [])

    else if baseName == "" || baseName == "." || baseName == ".." || !os.path.isfile(os.path.join(dir, baseName)) then
      new Tool.RunOutcome:
        "No such file: '\{fileName}'. Write it to your data directory first, then send it."
        "sendFile · no such file"
        attachments = []

    else
      client.sendDocument(chatId, os.path.join(dir, baseName), "")
      new Tool.RunOutcome("Sent '\{baseName}' to the user.", "sendFile · \{baseName}", attachments = [])
end

//[ The bot
  !
  ! Holds the model, prompt, toolset, the network client, and the sender
  ! allowlist, plus a registry of resident sessions keyed by chat id. It polls
  ! for updates and drives one turn per incoming message. `allowed` is the set
  ! of permitted sender (user) ids — authorization is by who sends, not where.
//]
private class PendingTelegramApproval(
    id: String,
    chatId: String,
    senderId: String)
  val ready = threading.event()
  var decision = ""
  var messageId = -1
end

private class TelegramBot(
    brain: Model, client: TelegramClient, allowed: List[String],
    botUsername: String, botId: Int)

  // Resident sessions, chatId -> Session. A chat not yet touched this run is
  // loaded from disk on first message. Guarded by `registryLock` for the one
  // genuinely concurrent interaction: the poll thread enqueuing to a session
  // versus a worker reaping its idle session (see `dispatch`/`workerLoop`).
  private val registry = py.dict()
  private val registryLock = threading.lock()

  // The tools every chat shares. `runTool` holds the build semaphore, so one
  // instance bounds concurrent sandbox runs across every chat.
  private val runTool: RunCodeTool = runCodeTool(harpe.workspace.sandboxDir, 610.0)
  private val sendFile: SendFileTool = new SendFileTool(client)

  private val approvalLock = threading.lock()
  private val pendingApprovals = py.dict()

  //[ The long-poll loop: fetch updates, advance the offset past each one, and dispatch text messages
    !
    ! `getUpdates` blocks until messages arrive or the poll times out, so this
    ! loop idles cheaply.
  //]
  def run(): Unit receives stdout, workspace =
    var offset = 0

    while true do
      match client.getUpdates(offset, pollSeconds = 50)
      case Polled(updates) =>
        for updateDyn in updates do
          val update = updateDyn.cast[py.Dict]
          offset = update.get("update_id").asInt + 1
          handleUpdate(update)

      case PollFailed(reason) =>
        // Surface the reason (a 409 usually means a second poller or a webhook)
        // and back off, so a persistent failure is a slow, visible retry rather
        // than a silent hot loop.
        println "  · getUpdates failed: \{reason} (retrying in 3s)"
        py.module("time").sleep(3.0)
    end

  //[ Handle one update
    !
    ! Act on a message with an identifiable sender that carries text or files
    ! (documents, photos, audio, video, voice) — a media message's caption is
    ! its text — and ignore everything else (edits, joins, callbacks, stickers,
    ! anonymous-admin and channel posts with no `from`, …). Enforce the sender
    ! allowlist. Then run a turn.
    !
    ! Authorization is by sender id. An unlisted sender is told their id only in
    ! a private chat — in a group the bot may see many strangers' messages, so
    ! it ignores them silently (logging to the console) rather than spamming a
    ! rejection into the group.
  //]
  private def handleUpdate(update: py.Dict): Unit receives stdout, workspace =
    if update.contains("callback_query") then
      handleApprovalCallback(update.get("callback_query").cast[py.Dict])
      return

    if !update.contains("message") then return

    val message = update.get("message").cast[py.Dict]
    if !message.contains("from") then return

    // A message is actionable if it has text, or files (with an optional caption
    // standing in as its text), or both. A message with neither — a sticker, a
    // service message — is ignored.
    val files = extractFiles(message)
    val text = if message.contains("text") then message.get("text").asString
               else message.get("caption", "").asString

    if !message.contains("text") && files.isEmpty then return

    val chat = message.get("chat").cast[py.Dict]
    val chatId = "\{chat.get("id").asInt}"
    val chatType = chat.get("type", "private").asString
    val senderId = "\{message.get("from").cast[py.Dict].get("id").asInt}"

    // In a group, only take a turn when the bot is addressed — an @mention, a
    // /command, or a reply to the bot — with that prefix stripped.
    // Non-addressed chatter is ignored. (With privacy mode on, the bot only
    // receives addressed messages anyway. This gate makes the behavior the same
    // either way, and strips the mention/command so the model sees a clean
    // prompt.) In a private chat every message is for the bot.
    var effectiveText = text
    if chatType == "group" || chatType == "supergroup" then
      match addressedText(message, text)
      case Some(t) => effectiveText = t
      case None    => return

    // A turn needs text or at least one file — an attachment-only message ("here,
    // look at this") is valid.
    if effectiveText.trim == "" && files.isEmpty then return

    if !isAllowed(senderId) then
      if chatType == "private" then
        client.sendMessage(chatId,
          "You are not authorized to use Carmen.\nYour user id is \{senderId} — ask the operator to add it to TELEGRAM_ALLOWED_SENDERS.")

      println "  · rejected message from unlisted sender \{senderId} in \{chatType} \{chatId}"
      return

    // Hand the message to the chat's own worker queue and return immediately, so
    // the poll loop keeps fetching updates while the turn runs.
    dispatch(chatId, new Incoming("\{message.get("message_id").asInt}", effectiveText, files, senderId))

  //[ Resolve an inline approval button without enqueuing a new agent turn. //]
  private def handleApprovalCallback(callback: py.Dict): Unit =
    val callbackId = callback.get("id", "").asString
    val data = callback.get("data", "").asString
    if !callback.contains("from") || !callback.contains("message") then
      client.answerCallback(callbackId, "This approval is no longer available.")
      return

    val senderId = "\{callback.get("from").cast[py.Dict].get("id").asInt}"
    val message = callback.get("message").cast[py.Dict]
    val chatId = "\{message.get("chat").cast[py.Dict].get("id").asInt}"
    val decision =
      if data.startsWith("approve:") then "approved"
      else if data.startsWith("reject:") then "rejected"
      else ""
    val id =
      if data.startsWith("approve:") then data.substring(8, data.size)
      else if data.startsWith("reject:") then data.substring(7, data.size)
      else ""

    approvalLock.acquire()
    val accepted =
      if pendingApprovals.contains(id) then
        val pending = pendingApprovals.get(id).cast[PendingTelegramApproval]
        if pending.chatId == chatId && pending.senderId == senderId && pending.decision == "" then
          pending.decision = decision
          pending.ready.set()
          true
        else false
      else false
    approvalLock.release()

    client.answerCallback(
      callbackId,
      if accepted then (if decision == "approved" then "Approved" else "Rejected")
      else "This approval is no longer available."
    )

  //[ Send an approval card and wait for the same Telegram user to decide. //]
  private def requestApproval(
      chatId: String,
      senderId: String,
      id: String,
      request: Approvals.Request)
  : Approvals.Decision =
    val pending = new PendingTelegramApproval(id, chatId, senderId)
    approvalLock.acquire()
    pendingApprovals.set(id, pending)
    approvalLock.release()

    match client.sendApproval(chatId, id, request.title, request.detail)
    case Some(messageId) => pending.messageId = messageId
    case None =>
      approvalLock.acquire()
      pendingApprovals.pop(id)
      approvalLock.release()
      return Approvals.Cancelled

    val deadline = time.now() + 600.0
    var decision: Approvals.Decision = Approvals.TimedOut
    var waiting = true
    while waiting do
      if time.now() >= deadline then
        decision = Approvals.TimedOut
        waiting = false
      else if pending.ready.wait(0.1).asBool then
        decision = Approvals.fromWire(pending.decision)
        waiting = false

    approvalLock.acquire()
    pendingApprovals.pop(id)
    approvalLock.release()
    if pending.messageId >= 0 then client.clearApprovalButtons(chatId, pending.messageId)
    decision

  //[ The files attached to a message, as `FileSpec`s (resolved to bytes later, on the worker thread)
    !
    ! Covers the media kinds the Bot API delivers: a `document`, a `photo`
    ! (largest size), `voice`, `audio`, and `video`. A kind with no filename of
    ! its own gets a sensible default. The mime type is Telegram's if it gave
    ! one, else guessed from the name at download time.
  //]
  private def extractFiles(message: py.Dict): List[FileSpec] =
    var specs: List[FileSpec] = []

    if message.contains("document") then
      val d = message.get("document").cast[py.Dict]
      specs = specs + new FileSpec(d.get("file_id").asString, d.get("file_name", "file").asString, d.get("mime_type", "").asString)

    if message.contains("photo") then
      val photos = message.get("photo").cast[py.List]
      if photos.size > 0 then
        val largest = photos.get(photos.size - 1).cast[py.Dict]
        specs = specs + new FileSpec(largest.get("file_id").asString, "photo.jpg", "image/jpeg")

    if message.contains("voice") then
      val v = message.get("voice").cast[py.Dict]
      specs = specs + new FileSpec(v.get("file_id").asString, "voice.ogg", v.get("mime_type", "audio/ogg").asString)

    if message.contains("audio") then
      val a = message.get("audio").cast[py.Dict]
      specs = specs + new FileSpec(a.get("file_id").asString, a.get("file_name", "audio").asString, a.get("mime_type", "").asString)

    if message.contains("video") then
      val vd = message.get("video").cast[py.Dict]
      specs = specs + new FileSpec(vd.get("file_id").asString, vd.get("file_name", "video.mp4").asString, vd.get("mime_type", "").asString)

    specs

  //[ For a group message, the text to act on if the bot is addressed
    !
    ! A reply to the bot, an @mention, or a /command (not aimed at another bot)
    ! — with that mention/command prefix stripped. `None` when the message is
    ! not for the bot.
  //]
  private def addressedText(message: py.Dict, text: String): Option[String] =
    val t = text.trim

    if isReplyToBot(message) then
      Some(t)

    else if lower(t).contains("@" + lower(botUsername)) then
      Some(stripMention(t).trim)

    else if t.startsWith("/") then
      commandText(t)

    else
      None

  //[ Is this message a reply to one of the bot's own messages? //]
  private def isReplyToBot(message: py.Dict): Bool =
    if !message.contains("reply_to_message") then
      false
    else
      val replied = message.get("reply_to_message").cast[py.Dict]
      replied.contains("from") && replied.get("from").cast[py.Dict].get("id", 0).asInt == botId

  //[ The text after a leading `/command`
    !
    ! Or `None` if the command is explicitly targeted at a different bot
    ! (`/command@otherbot`).
  //]
  private def commandText(t: String): Option[String] =
    val parts = py.dynamic(t).split(py.none, 1).cast[py.List]
    val cmd = parts.get(0).asString
    val rest = if parts.size > 1 then parts.get(1).asString else ""
    val at = py.dynamic(cmd).find("@").asInt

    if at < 0 then
      Some(rest.trim)

    else
      val target = cmd.substring(at + 1, cmd.size)
      if lower(target) == lower(botUsername) then Some(rest.trim) else None

  //[ Remove every `@botUsername` mention (case-insensitively) from the text. //]
  private def stripMention(t: String): String =
    val re = py.module("re")
    re.sub("@" + re.escape(botUsername).asString, "", t, flags = re.IGNORECASE).asString

  private def lower(s: String): String = py.dynamic(s).lower().asString

  //[ Enqueue a message for its chat, creating the session (and its worker) on first contact
    !
    ! Under `registryLock` so the enqueue is atomic with a worker's reap
    ! decision: either the message lands in a live session's queue, or the
    ! session was reaped and we build a fresh one — never a message dropped into
    ! a dead queue. Session load (disk) happens outside the lock. Only the poll
    ! thread creates, so the check-then-create needs no extra guard.
  //]
  private def dispatch(chatId: String, incoming: Incoming): Unit receives workspace =
    registryLock.acquire()
    val live = registry.contains(chatId)
    if live then
      enqueue(registry.get(chatId).cast[Session], incoming)
    registryLock.release()

    if !live then
      val log = Session.forSession(chatId)
      // `Session.load` caps the replayed transcript (a RAM backstop). The full
      // transcript stays on disk.
      val context = new WindowedContext:
        baseSystem = workspace.read("AGENT.md").getOrElse("")
        initial = Session.load(chatId)

      // Each chat is its own session, rooted at its own data directory:
      // downloaded files land there, and files the agent writes and sends back
      // surface there too. This toolset is where that directory reaches the
      // tools.
      val dataDir = os.path.abspath(Session.dataDir(chatId))
      val tools =
        SkillTools.toolset(harpe.workspace.skillsDir)
          ++ UploadMediaTool.toolset(dataDir)
          ++ sendFile.toolset(chatId, dataDir)
          ++ runTool.toolset()

      val session = new Session(chatId, log, brain, tools, context, dataDir)
      registryLock.acquire()
      registry.set(chatId, session)
      enqueue(session, incoming)
      registryLock.release()
      startWorker(chatId, session)

  //[ Queue a message for its chat's worker
    !
    ! The transcript's bracket is NOT opened here: a journal pairs its records in
    ! order, and queuing while a turn is in flight would overlap two brackets.
    ! The worker opens it when it starts the turn. How long the message waited is
    ! recorded as an ordinary diagnostic, which is what that measurement is.
  //]
  private def enqueue(session: Session, incoming: Incoming): Unit =
    session.log.log("telegram.queued", "messageId" ~ incoming.id, "text" ~ incoming.text)
    session.queue.put(incoming)

  //[ The chat's worker: drain its queue, running one turn per message in arrival order
    !
    ! Runs on a dedicated daemon thread, so a long turn blocks only this chat,
    ! not the poll loop or other chats. A crashing turn is contained — the chat
    ! is told, and the worker keeps serving — rather than killing the thread.
    !
    ! When no message arrives for 15 minutes, the worker reaps itself: under
    ! `registryLock` it re-checks the queue is still empty (guarding against a
    ! message enqueued in the race window), removes the session, and exits. The
    ! next message from this chat recreates the session from disk.
  //]
  private def workerLoop(chatId: String, session: Session): Unit =
    var running = true
    while running do
      match py.try(session.queue.get(timeout = 900.0))
      case Ok(item) =>
        val incoming = item.cast[Incoming]
        val turnRes = py.try:
          session.runTurn:
            incoming
            client
            (id, request) => requestApproval(chatId, incoming.senderId, id, request)

        match turnRes
        case Ok(_)  => pass
        case Err(_) =>
          val _ = py.try(client.sendMessage(session.id, "Sorry — an internal error occurred."))

      case Err(_) =>
        // get() timed out (queue empty for idleSeconds): try to reap.
        registryLock.acquire()
        val reap = session.queue.empty().asBool
        if reap then registry.pop(chatId)
        registryLock.release()

        if reap then running = false

  //[ Start a chat's dedicated worker on a daemon thread (dies with the process). //]
  private def startWorker(chatId: String, session: Session): Unit =
    val loop = () => workerLoop(chatId, session)
    val thread = threading.thread(loop)
    thread.start()

  //[ Is this sender permitted? An empty allowlist admits no one. //]
  private def isAllowed(senderId: String): Bool =
    allowed.find(x => x == senderId) is Some(_)
end
