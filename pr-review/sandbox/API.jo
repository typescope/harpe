//[ GithubAPI.jo — GitHub PR Review API
  !
  ! The LLM writes Jo programs using these types to:
  ! 1. Read PR metadata, file diffs, and repository source files
  ! 2. Submit a pending draft review for manual verification
//]

namespace sandbox.api

import jo.IO.stdout

//[ Pull request metadata //]
class PRInfo(
  number: Int,
  title: String,
  body: String,
  baseBranch: String,
  headBranch: String,
  headSha: String,
  state: String,
  diffs: List[FileDiff]
)

//[ A changed file in the PR with its unified diff patch
  !
  ! status is one of: "added", "modified", "removed", "renamed"
  ! patch is the unified diff text (empty for binary files)
//]
class FileDiff(
  path: String,
  status: String,
  additions: Int,
  deletions: Int,
  patch: String
)

//[ A review comment targeting a specific line in a file //]
class LineComment(
  path: String,
  line: Int,
  body: String
)

//[ A definition found by text search across the repository //]
class DefinitionMatch(
  path: String,
  line: Int,    // 1-based line number
  text: String  // the matching line (trimmed)
)

//[ GitHub PR interface — read PR data and submit a draft review
  !
  ! All access is scoped to the PR loaded by the agent at startup. The only
  ! write saves a pending review; publishing and merging are not available to
  ! model-written programs.
//]
interface GitHub
  //[ Get PR metadata and changed-file patches. //]
  def getPR(): PRInfo

  //[ Read a source file from the PR's head branch snapshot
    !
    ! path should be relative to the repository root (e.g., "src/foo.py")
    ! start: first line to include (0-based, default 0)
    ! ends:   one-past-last line to include (-1 means end of file, default -1)
  //]
  def readFile(path: String, start: Int = 0, ends: Int = -1): String

  //[ Find likely definitions of an identifier in the PR head snapshot. //]
  def findDefinition(identifier: String): List[DefinitionMatch]

  //[ Save a pending PR review for manual verification
    !
    ! The capability deliberately supplies no verdict argument: the trusted
    ! runtime always omits GitHub's event field, which creates a draft.
    !
    ! Example:
    ! val note = LineComment("src/main.py", 42, "Handle the empty case.")
    ! github.saveDraftReview("Review summary", [note])
  //]
  def saveDraftReview(body: String, comments: List[LineComment]): Unit receives stdout
end

//[ GitHub capability provided by the runtime — do not construct directly //]
param github: GitHub

//[ LLM-generated entry point: review the PR and save a draft //]
defer def runTask(): Unit receives stdout, github
