namespace harpe.examples.prreview

import jo.IO.stdout
import harpe.Interact
import harpe.Approvals
import harpe.turns.*

private class PrintInteract(out: String => Unit)
  view Interact

  def emit(event: TurnEvent): Unit = with IO.stdout = out in
    match event
    case TurnEvent.ModelRequestStarted(attempt, maxAttempts) =>
      val label =
        if attempt == 0 then "thinking..."
        else "retrying \{attempt}/\{maxAttempts}..."
      println label

    case TurnEvent.ModelRequestEnded => pass

    case TurnEvent.TransientError(detail, delaySeconds) =>
      println "  · transient error (\{detail}); retrying in \{delaySeconds}s"

    case TurnEvent.AssistantChunk(text) => print(text)
    case TurnEvent.AssistantStreamReset => pass

    case TurnEvent.ToolBudgetReached(budget) =>
      println "  · tool budget reached (\{budget}); requesting final answer"

    case TurnEvent.ToolCallStarted(name) =>
      println "\{name}..."

    case TurnEvent.ToolCallEnded(name, summary) =>
      println "  · \{summary}"

    case TurnEvent.ContextCompacted(droppedMessages) =>
      println "  · context compacted (\{droppedMessages} messages summarized)"

  def cancelled: Bool = false

  def pause(seconds: Float): Bool =
    py.module("time").sleep(seconds)
    false

  def approve(title: String, detail: String): Approvals.Decision =
    Approvals.Cancelled
end
