//[ Sandbox.jo
  !
  ! The `Sandbox` abstraction: host-side facilities the sandbox runtime and
  ! capability implementations use — never the LLM/guest code. An agent's
  ! `SandboxRuntime.main` builds one and threads it into its capability impls;
  ! it is deliberately kept out of `runTask`'s `receives`, so the compile-time
  ! capability check prevents the model from ever naming it.
  !
  ! Facilities: structured logging, the runtime environment (string key/values),
  ! in-process resource caps (memory / CPU) the runtime sets before running guest
  ! code, and (future) agent <-> sandbox communication.
//]

namespace harpe.sandbox

// `harpe.sandbox` is a foundational package — it owns its small interop rather
// than depending on `harpe`, so the agent's sandbox runtime can pull it alone.
private def sysMod: py.Dynamic = py.module("sys")
private def osMod: py.Dynamic = py.module("os")
private def resourceMod: py.Dynamic = py.module("resource")

//[ Sandbox
  !
  ! Host-side facilities for the sandbox runtime and capability implementations.
  ! Not an LLM capability: pass it to impl constructors, never to `runTask`.
//]
interface Sandbox
  //[ Append a tagged line to the host audit stream (stderr, not the tool result). //]
  def log(level: String, message: String): Unit

  //[ A runtime environment value (process env / loaded .env), if present. //]
  def env(key: String): Option[String]

  //[ A runtime environment value, or `fallback` when unset. //]
  def envOr(key: String, fallback: String): String

  //[ Cap the address space (virtual memory) of this process to `mb` megabytes.
    !
    ! POSIX rlimit: once lowered it cannot be raised, so guest code running
    ! afterwards cannot escape it. `mb` must be positive. //]
  def limitMemoryMb(mb: Int): Unit

  //[ Cap the CPU time (seconds) this process may consume; the kernel kills it on
    !
    ! overrun (SIGXCPU). Irreversible once set, like `limitMemoryMb`. Pair it with
    ! the host's wall-clock timeout: this catches CPU-bound loops, the host
    ! catches hangs. `seconds` must be positive. //]
  def limitCpuSeconds(seconds: Int): Unit

  //[ Confine this process's filesystem via Landlock (Linux only).
    !
    ! Only `readable` paths are readable (read+execute, so shared libraries still
    ! load) and only `writable` paths are writable; everything else — the agent's
    ! `.env`, `~/.ssh`, other sessions' logs — becomes inaccessible. Irreversible
    ! and inherited across `execve`, so guest code and anything it spawns are
    ! confined.
    !
    ! `readable` MUST include Python's own installation and package directories
    ! (`sys.prefix`, `sys.base_prefix`, any site-packages) or the interpreter can
    ! no longer import the stdlib or C extensions once restricted — derive them
    ! at runtime rather than hardcoding `/usr`, so venv/pyenv installs work.
    !
    ! Opt-in defense in depth beneath the compile-time gate: call it in
    ! `SandboxRuntime.main` before `runTask`. Fail-closed: a non-Linux OS, or a
    ! kernel without Landlock, ABORTS the run rather than proceeding unprotected
    ! — if you ask for restriction and it cannot be enforced, the guest does not
    ! run.
  //]
  def restrictFilesystem(readable: List[String], writable: List[String]): Unit

  //[ Deny all TCP networking for this process via Landlock (Linux only).
    !
    ! No exfiltration, no C2 — for a guest that has no business on the network.
    ! Landlock gates TCP only (not UDP, and not by IP): this is the all-or-nothing
    ! switch. IP-restricted egress is a separate mechanism (a dedicated run user +
    ! nftables — see `docs/sandbox.md`), which is why it is its own method rather
    ! than folded into `restrictFilesystem`. Fail-closed: a non-Linux OS, or a
    ! kernel below Landlock ABI v4 (6.7), ABORTS the run rather than proceeding
    ! with the network still open.
  //]
  def denyNetwork(): Unit
end

//[ Build the default Sandbox: logs to stderr, reads env from the process
  ! environment. Agents wanting different logging/transport supply their own
  ! `view Sandbox` instead of calling this.
//]
section Sandbox
  def create(): Sandbox = new SandboxImpl
end

private class SandboxImpl
  view Sandbox

  def log(level: String, message: String): Unit =
    sysMod.stderr.write("[\{level}] \{message}\n")
    sysMod.stderr.flush()

  def env(key: String): Option[String] =
    val v = osMod.environ.cast[py.Dict].get(key, py.none)
    if py.isNone(v) then None else Some(v.asString)

  def envOr(key: String, fallback: String): String =
    osMod.environ.cast[py.Dict].get(key, fallback).asString

  def limitMemoryMb(mb: Int): Unit =
    assert: mb > 0, "limitMemoryMb: mb must be positive"
    val bytes = mb * 1024 * 1024
    resourceMod.setrlimit(resourceMod.RLIMIT_AS, py.list(bytes, bytes))

  def limitCpuSeconds(seconds: Int): Unit =
    assert: seconds > 0, "limitCpuSeconds: seconds must be positive"
    resourceMod.setrlimit(resourceMod.RLIMIT_CPU, py.list(seconds, seconds))

  // Fail-closed: if a requested restriction cannot be enforced (non-Linux OS, or
  // a kernel without the needed Landlock support), abort rather than run the
  // guest unprotected. The agent author opted in; silently continuing would be
  // the dangerous outcome.
  def restrictFilesystem(readable: List[String], writable: List[String]): Unit =
    if Landlock.restrictFilesystem(readable, writable) then
      log("info", "filesystem restricted (Landlock)")
    else
      abort "restrictFilesystem: Landlock unavailable (non-Linux OS or kernel < 5.13) — refusing to run the guest unprotected"

  def denyNetwork(): Unit =
    if Landlock.denyNetwork() then
      log("info", "network denied (Landlock)")
    else
      abort "denyNetwork: Landlock TCP gating unavailable (non-Linux OS or kernel < 6.7) — refusing to run the guest unprotected"
end
