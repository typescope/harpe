//[ layout.jo — composing an image out of elements instead of coordinates.
  !
  ! `harpe.caps.layout` sits on top of the imaging model. You build a tree of
  ! `Element`s, hand it to `Element.render`, and it decides the geometry. Use it
  ! whenever a picture has structure — a card, a poster, a chart frame, a table.
  ! Drop to `graphics`/`Canvas` directly (see `drawing.jo`) only for artwork.
  !
  ! Three phases, and the middle one is data you can inspect:
  !
  !   build   Element tree     what you write
  !   layout  Laid tree        every node's absolute Rect and baseline
  !   paint   Canvas ops
  !
  ! `Element.place(root, frame)` runs layout WITHOUT drawing, so you can check
  ! where something landed before rendering anything.
  !
  ! The pieces:
  !
  !   leaves      text, graphic, space, gap, rule
  !   containers  row, column, stack
  !   wrappers    pad, align, centred, sized, flex, spring, clip,
  !               background, border
  !
  ! Four rules worth knowing:
  !
  ! - **`row` aligns children on their shared baseline.** Mixed font sizes sit on
  !   one line for free; you never compute a y offset for text.
  ! - **`column` stretches children to full width.** That is what makes centred
  !   or right-aligned text work inside it.
  ! - **`spring` eats the slack.** Put one between two elements to push them
  !   apart — this is how a footer stays on the bottom margin however the content
  !   above it grows. `flex(weight, child)` is the same idea with proportions.
  ! - **Styling is captured when an element is built**, not when it is drawn.
  !   Build under `with Style.font = … in …`; the element then renders the same
  !   wherever it is placed.
  !
  ! Containers take a colon block, one child per line — that is the shape a tree
  ! wants. Computed children splice in with a prefix `..`, and mix freely with
  ! written ones:
  !
  !   Element.column:
  !     heading
  !     ..bars(data)
  !     footer
  !
  ! Run it: it writes `card.png` into data/.
//]

namespace UserTask

import SandboxAPI.*
import harpe.caps.*
import harpe.caps.drawing.*
import harpe.caps.layout.*

private def ink: Color = Color.rgb255(24, 28, 48)
private def accent: Color = Color.rgb255(90, 120, 245)
private def muted: Color = Color.rgb255(120, 130, 165)

def runTask(): Unit receives IO.stdout, fs, graphics =
  val w = 480.0
  val h = 260.0

  // logical units, not pixels: scale 3 gives a 1440 x 780 file
  val cv = graphics.create(w, h, 3.0, Some(Color.rgb255(246, 247, 251)))

  val card =
    Element.background:
      Element.pad: content(), Insets.all(24.0)
      Paint.of(Color.white)
      14.0

  // place() first if you want to check the geometry without drawing
  val laid = Element.place(card, new Rect(20.0, 20.0, w - 40.0, h - 40.0))
  println "card is \{laid.bounds.width} x \{laid.bounds.height} logical units"

  val _ = Element.render(cv, card, new Rect(20.0, 20.0, w - 40.0, h - 40.0))

  match cv.save(fs.root / "card.png")
  case Ok(_)  => println "wrote card.png"
  case Err(e) => println "save failed: \{e}"

private def content(): Element receives graphics =
  Element.column:
    header()
    Element.gap(10.0)
    Element.rule: 1.0, Paint.of(muted.fade(0.4))
    Element.gap(12.0)
    body()
    Element.spring            // <- pushes the footer to the bottom edge
    footer()

//[ A title and a badge on one line, pushed apart by a spring. Because `row`
  ! aligns on the baseline, the 20pt title and the 11pt badge sit on one line
  ! without any vertical arithmetic.
//]
private def header(): Element receives graphics =
  val title =
    with Style.font = Font.bold(20.0), Style.textPaint = Paint.of(ink) in
      Element.text("Quarterly report")

  val badge =
    with Style.font = Font.bold(11.0), Style.textPaint = Paint.of(accent) in
      Element.text("DRAFT")

  Element.row: title, Element.spring, badge

private def body(): Element receives graphics =
  with
    Style.font = Font.sans(12.0),
    Style.textPaint = Paint.of(muted),
    Typesetting.leading = 1.55
  in
    Element.text(
      """
      Nothing in this card computes a coordinate. The row aligns its children on
      a shared baseline, the column stretches them to the full width, and the
      spring above the footer eats whatever space is left over.
      """)

//[ A swatch and two labels. `flex` splits the remaining width 2:1. //]
private def footer(): Element receives graphics =
  val dot = Element.graphic(12.0, 12.0, c => paintDot(c))

  val left =
    with Style.font = Font.sans(10.5), Style.textPaint = Paint.of(muted) in
      Element.text("composed with elements")

  val right =
    with Style.font = Font.sans(10.5), Style.textPaint = Paint.of(muted) in
      Element.text("harpe.caps.layout")

  Element.rowAt:
    Cross.finish
    dot
    Element.space(8.0, 0.0)
    Element.flex(2.0, left)
    Element.flex(1.0, right)

//[ A painter must declare the ambient state that reaches it. Jo captures
  ! context params lexically, so without `receives` this would see an identity
  ! transform and no clip, and would ignore the layout around it.
//]
private def paintDot(cv: Canvas): Unit receives
    graphics, Style.transform, Style.clip, Style.alpha
=
  with Style.fillPaint = Paint.of(accent) in
    cv.fill(Region.circle(6.0, 6.0, 6.0))
