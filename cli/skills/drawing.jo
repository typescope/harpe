//[ drawing.jo — how to make a poster with the `graphics` capability.
  !
  ! `graphics` mints a `Canvas` and answers font and image facts. You paint with
  ! the imaging primitives — `fill`/`stroke` over `Region`/`Trace` shapes,
  ! `textAt` for one shaped line — and flow paragraphs into rectangles with
  ! `Text.paragraph`.
  !
  ! Drawing state (paints, stroke geometry, alpha, transform, clip) is the
  ! ambient `Style`, changed by rebinding with `with`. Nothing is set
  ! through methods, and nothing has to be restored — when the block ends the
  ! previous state is back.
  !
  ! **Coordinates are logical units, not pixels.** A surface has a `scale` (device
  ! pixels per unit), so the same drawing renders crisp at any resolution: pass
  ! `2.0` or `3.0` for a print-quality image without touching any geometry.
  !
  ! Run it: it writes `poster.png` into data/.
//]

namespace UserTask

import SandboxAPI.*
import harpe.caps.*
import harpe.caps.drawing.*

def runTask(): Unit receives IO.stdout, fs, graphics =
  val w = 600.0
  val h = 520.0

  // scale 2 => a 1200x1040 pixel file from 600x520 of geometry
  val cv = graphics.create(w, h, 2.0, Some(Color.rgb255(247, 248, 252)))

  titleBand(cv, w)
  badge(cv, w)
  columns(cv, w, h)

  match cv.save(fs.root / "poster.png")
  case Ok(_)  => println "wrote poster.png"
  case Err(e) => println "save failed: \{e}"

//[ A gradient band across the top, with the title shaped and centred on it. //]
private def titleBand(cv: Canvas, w: Float): Unit receives graphics =
  with
    Style.fillPaint =
      Paint.linear(0.0, 0.0, w, 120.0,
        Color.rgb255(28, 38, 86), Color.rgb255(72, 96, 190))
  in
    cv.fill(Region.rect(0.0, 0.0, w, 120.0))

  with
    Style.font = Font.bold(34.0),
    Style.textPaint = Paint.of(Color.white),
    Typesetting.align = Align.center
  in
    val band = new Rect(40.0, 30.0, w - 80.0, 60.0)
    val _ = Text.paragraph(cv, "The Imaging Model", band)

  // a subtitle placed directly, centred using the shaper's own measurement
  with
    Style.font = Font.sans(14.0),
    Style.textPaint = Paint.of(Color.rgb255(198, 210, 240))
  in
    val sub = "shapes, paints, groups, shaped text"
    cv.textAt((w - graphics.stringWidth(sub)) / 2.0, 104.0, sub)

//[ A rotated rounded badge, and three translucent discs drawn as one group. //]
private def badge(cv: Canvas, w: Float): Unit =
  // rotate about the badge's own centre by composing translate/rotate/translate
  with
    Style.transform = Matrix.rotateAbout(0.0 - 0.12, 90.0, 168.0),
    Style.fillPaint = Paint.of(Color.rgb255(240, 196, 60)),
    Style.strokePaint = Paint.of(Color.rgb255(150, 110, 20)),
    Style.stroke = Stroke.smooth(2.0)
  in
    cv.fillStroke(Region.roundRect(30.0, 146.0, 120.0, 44.0, 10.0))

  with
    Style.font = Font.bold(15.0),
    Style.textPaint = Paint.of(Color.rgb255(70, 50, 10)),
    Style.transform = Matrix.rotateAbout(0.0 - 0.12, 90.0, 168.0)
  in
    cv.textAt(48.0, 174.0, "rotated")

  // Inside a group the discs are drawn opaque and the *result* is faded once,
  // so their overlaps stay clean. Using Style.alpha instead would
  // fade each disc separately and darken every overlap.
  cv.group: 0.55, Blend.normal, () =>
    disc(cv, 250.0, Color.rgb255(220, 70, 60))
    disc(cv, 300.0, Color.rgb255(60, 175, 95))
    disc(cv, 350.0, Color.rgb255(60, 95, 215))

  // a dashed rule under the whole header
  with
    Style.strokePaint = Paint.of(Color.rgb255(170, 178, 200)),
    Style.stroke = Stroke.of(1.5).dashed([6.0, 5.0])
  in
    cv.stroke(Trace.from(40.0, 212.0).lineTo(w - 40.0, 212.0))

private def disc(cv: Canvas, cx: Float, color: Color): Unit =
  with Style.fillPaint = Paint.of(color) in
    cv.fill(Region.circle(cx, 168.0, 32.0))

//[ Two columns of wrapped body text. //]
private def columns(cv: Canvas, w: Float, h: Float): Unit receives graphics =
  val margin = 44.0
  val gutter = 24.0
  val colW = (w - 2.0 * margin - gutter) / 2.0
  val top = 240.0
  val colH = h - top - margin

  with
    Style.font = Font.sans(12.0),
    Style.textPaint = Paint.of(Color.rgb255(40, 45, 55)),
    Typesetting.leading = 1.45
  in
    val left = new Rect(margin, top, colW, colH)
    val right = new Rect(margin + colW + gutter, top, colW, colH)

    val used = Text.paragraph(cv, intro(), left)
    val _ = Text.paragraph(cv, detail(), new Rect(margin, top + used + 8.0, colW, colH))
    val _2 = Text.paragraph(cv, more(), right)

// Paragraph text is a multiline string; any whitespace (including these
// newlines) is a word break, so the source can wrap freely.
private def intro(): String =
  """
  Text is shaped before it is drawn: HarfBuzz turns a string into positioned
  glyphs, so kerning and ligatures are already applied by the time anything
  reaches the canvas.
  """

private def detail(): String =
  """
  Measuring and drawing use the same path, which is why a centred line lands
  where the measurement said it would.
  """

private def more(): String =
  """
  Every fill takes a paint, so a gradient is no harder than a flat colour, and
  a stroke carries its own geometry: width, caps, joins and dashes. Groups
  composite a whole subtree at once, which is what keeps overlapping shapes
  clean when they are faded together. Wrapping here is deliberately simple —
  greedy, whitespace only — because real line breaking belongs to the layout
  engine, not to the imaging model.
  """
