//[ Task.jo — draw a poster with the `graphics` capability.
  !
  ! The whole sheet is one `Element` tree: nothing here computes a coordinate.
  ! Rows, columns, springs and padding decide where things land, and
  ! `Element.render` lays the tree into the page and paints it.
  !
  ! Three things worth copying:
  !
  ! - **Geometry is in logical units, not pixels.** The sheet is 600 × 820 at
  !   `scale = 3`, so the file is 1800 × 2460 without a single coordinate
  !   changing. Raise `scale` for print, lower it for a thumbnail.
  ! - **A `spring` is how you push things apart.** It is a weightless flexible
  !   blank: put one between two elements and it eats the slack, so the foot of
  !   the sheet sits on the bottom margin no matter how tall the caption grows.
  ! - **Drop to drawing with `Element.graphic`.** Its painter draws in local
  !   coordinates — (0, 0) is the element's own corner — so artwork does not
  !   care where layout puts it.
  !
  ! Run it: it writes `poster.png` into data/.
//]

namespace UserTask

import SandboxAPI.*
import harpe.caps.*
import harpe.caps.drawing.*
import harpe.caps.layout.*

// --- the sheet -----------------------------------------------------------

private def sheetW: Float = 600.0
private def sheetH: Float = 820.0
private def margin: Float = 56.0
private def contentW: Float = sheetW - 2.0 * margin

// --- palette: every colour in the poster, in one place -------------------

private def inkTop: Color = Color.rgb255(8, 10, 30)
private def inkBottom: Color = Color.rgb255(30, 27, 78)
private def glow: Color = Color.rgb255(96, 76, 210)
private def magenta: Color = Color.rgb255(240, 60, 130)
private def cyan: Color = Color.rgb255(40, 215, 215)
private def amber: Color = Color.rgb255(250, 185, 70)
private def paper: Color = Color.rgb255(245, 246, 255)
private def muted: Color = Color.rgb255(150, 158, 205)
private def hairline: Color = Color.rgb255(86, 94, 150)

def runTask(): Unit receives IO.stdout, fs, graphics =
  // 600 x 820 of geometry, rendered at 1800 x 2460 pixels
  val cv = graphics.create(sheetW, sheetH, 3.0, None)

  val page =
    Element.stack:
      Element.graphic: sheetW, sheetH, c => paintBackground(c)
      Element.pad: sheet(), Insets.all(margin)

  val _ = Element.render(cv, page, new Rect(0.0, 0.0, sheetW, sheetH))

  match cv.save(fs.root / "poster.png")
  case Ok(_)  => println "wrote poster.png"
  case Err(e) => println "save failed: \{e}"

//[ The sheet's contents, top to bottom. The two springs are what hold the
  ! colophon on the bottom margin.
//]
private def sheet(): Element receives graphics =
  Element.column:
    masthead()
    Element.rule: 1.0, Paint.of(hairline.fade(0.5))
    Element.gap(18.0)
    lightStudy()
    Element.gap(30.0)
    title()
    Element.gap(22.0)
    Element.rule: 1.0, Paint.of(hairline)
    Element.gap(20.0)
    caption()
    Element.spring
    Element.rule: 1.0, Paint.of(hairline.fade(0.5))
    Element.gap(14.0)
    colophon()

//[ A label on the left, an index on the right, pushed apart by a spring. //]
private def masthead(): Element receives graphics =
  with
    Style.font = Font.bold(12.0),
    Style.textPaint = Paint.of(muted)
  in
    Element.pad:
      Element.row:
        Element.text("HARPE / CANVAS")
        Element.spring
        Element.text("NO. 01")
      new Insets(0.0, 0.0, 12.0, 0.0)

//[ The framed artwork: a soft glow with three discs screened over it, clipped
  ! to a rounded panel and outlined.
//]
private def lightStudy(): Element receives graphics =
  Element.framed:
    Element.clip:
      Element.sized:
        Element.graphic: contentW, 330.0, c => paintStudy(c)
        contentW
        330.0
      18.0
    Paint.of(hairline.fade(0.55))
    Stroke.of(1.0)
    18.0

//[ Display type. Line breaks in a title are a design decision, so each line is
  ! its own element rather than something the wrapper chose.
//]
private def title(): Element receives graphics =
  with
    Style.font = Font.bold(46.0),
    Style.textPaint = Paint.of(paper),
    Typesetting.leading = 1.08
  in
    Element.column:
      Element.text("Shapes, paints,")
      Element.text("and light.")

//[ Body copy on the left, a key to the three inks on the right. //]
private def caption(): Element receives graphics =
  Element.row:
    Element.flex: 1.0, body()
    Element.space: 28.0, 0.0
    Element.sized: inkKey(), 150.0, 108.0

private def body(): Element receives graphics =
  with
    Style.font = Font.sans(13.0),
    Style.textPaint = Paint.of(muted),
    Typesetting.leading = 1.6
  in
    Element.text(copy())

private def copy(): String =
  """
  Every fill takes a paint, so a gradient costs no more than a flat colour.
  Every stroke carries its own geometry. Groups composite a whole subtree at
  once, which is what lets these three discs overlap without going muddy.
  """

//[ A heading and three swatch rows. //]
private def inkKey(): Element receives graphics =
  val heading =
    with
      Style.font = Font.bold(9.5),
      Style.textPaint = Paint.of(muted.fade(0.75))
    in
      Element.text("INKS / SCREEN")

  Element.column:
    heading
    Element.gap(12.0)
    swatch: magenta, "magenta"
    Element.gap(9.0)
    swatch: cyan, "cyan"
    Element.gap(9.0)
    swatch: amber, "amber"

//[ A disc and a label, sharing one baseline — which is exactly what `row` does
  ! for free once every element carries one.
//]
private def swatch(color: Color, label: String): Element receives graphics =
  val dot = Element.graphic(10.0, 10.0, c => paintDot(c, color))

  val text =
    with
      Style.font = Font.sans(11.0),
      Style.textPaint = Paint.of(muted)
    in
      Element.text(label)

  Element.rowAt:
    Cross.finish
    dot
    Element.space(8.0, 0.0)
    text

//[ Three metadata columns along the foot, spread by springs. //]
private def colophon(): Element receives graphics =
  with
    Style.font = Font.sans(10.5),
    Style.textPaint = Paint.of(muted.fade(0.85))
  in
    Element.row:
      Element.text("cairo + harfbuzz")
      Element.spring
      Element.text("600 x 820 at 3x")
      Element.spring
      Element.text("drawn in jo")

// --- painters ------------------------------------------------------------
//
// A `Painter` must declare what ambient state reaches it. Jo captures context
// params lexically, so without the `receives` clause these would silently see
// an identity transform and no clip, and would ignore the layout entirely.

private def paintBackground(cv: Canvas): Unit receives
    graphics, Style.transform, Style.clip, Style.alpha
=
  with Style.fillPaint = Paint.linear(0.0, 0.0, 0.0, sheetH, inkTop, inkBottom) in
    cv.fill(Region.rect(0.0, 0.0, sheetW, sheetH))

private def paintStudy(cv: Canvas): Unit receives
    graphics, Style.transform, Style.clip, Style.alpha
=
  with
    Style.fillPaint =
      Paint.radial(contentW / 2.0, 146.0, 250.0, glow.fade(0.75), glow.fade(0.0))
  in
    cv.fill(Region.rect(0.0, 0.0, contentW, 330.0))

  disc(cv, 182.0, 128.0, magenta)
  disc(cv, 294.0, 140.0, cyan)
  disc(cv, 238.0, 226.0, amber)

//[ One disc, screened onto what is already there. Blending is a property of how
  ! a group lands, so each disc needs its own group — inside a single group they
  ! would just paint over each other.
//]
private def disc(cv: Canvas, cx: Float, cy: Float, color: Color): Unit receives
    Style.transform, Style.clip, Style.alpha
=
  cv.group: 0.92, Blend.screen, () =>
    with Style.fillPaint = Paint.of(color) in
      cv.fill(Region.circle(cx, cy, 104.0))

private def paintDot(cv: Canvas, color: Color): Unit receives
    graphics, Style.transform, Style.clip, Style.alpha
=
  with Style.fillPaint = Paint.of(color) in
    cv.fill(Region.circle(5.0, 5.0, 5.0))
