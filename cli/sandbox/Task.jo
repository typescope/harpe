//[ Task.jo — draw a poster with the `graphics` capability.
  !
  ! A portrait poster: a framed light study at the top, a display title, and a
  ! caption block. It is meant to be edited — change the palette, the copy, or
  ! the composition and re-run.
  !
  ! Two things worth copying from it:
  !
  ! - **Geometry is in logical units, not pixels.** The surface is 600 × 820 at
  !   `scale = 3`, so the file is 1800 × 2460 without a single coordinate
  !   changing. Raise `scale` for print, lower it for a thumbnail.
  ! - **Colour comes from one palette section**, so restyling the whole poster
  !   is a handful of edits in one place rather than a hunt through the drawing
  !   code.
  !
  ! Run it: it writes `poster.png` into data/.
//]

namespace UserTask

import SandboxAPI.*
import harpe.caps.*
import harpe.caps.drawing.*

// --- the sheet -----------------------------------------------------------

private def sheetW: Float = 600.0
private def sheetH: Float = 820.0
private def margin: Float = 56.0

// --- palette: every colour in the poster, in one place -------------------

private def inkTop: Color = Color.rgb255(8, 10, 30)
private def inkBottom: Color = Color.rgb255(30, 27, 78)
private def glow: Color = Color.rgb255(96, 76, 210)
private def magenta: Color = Color.rgb255(240, 60, 130)
private def cyan: Color = Color.rgb255(40, 215, 215)
private def amber: Color = Color.rgb255(250, 185, 70)
private def paper: Color = Color.rgb255(245, 246, 255)
private def muted: Color = Color.rgb255(150, 158, 205)
private def hairline: Color = Color.rgb255(86, 94, 150)

def runTask(): Unit receives IO.stdout, fs, graphics =
  // 600 x 820 of geometry, rendered at 1800 x 2460 pixels
  val cv = graphics.create(sheetW, sheetH, 3.0, None)

  background(cv)
  lightStudy(cv)
  masthead(cv)
  title(cv)
  caption(cv)
  colophon(cv)

  match cv.save(fs.root / "poster.png")
  case Ok(_)  => println "wrote poster.png"
  case Err(e) => println "save failed: \{e}"

//[ A vertical ink gradient across the whole sheet. //]
private def background(cv: Canvas): Unit =
  with
    Style.fillPaint =
      Paint.linear(0.0, 0.0, 0.0, sheetH, inkTop, inkBottom)
  in
    cv.fill(Region.rect(0.0, 0.0, sheetW, sheetH))

//[ The framed panel: a soft radial glow, then three discs screened over each
  ! other so their overlaps brighten instead of muddying.
  !
  ! Each disc gets its own `group` with `Blend.screen`, because blending is a
  ! property of how a group lands on what is already there. Inside one group
  ! the discs would simply paint over each other.
//]
private def lightStudy(cv: Canvas): Unit =
  val panel = Region.roundRect(margin, 104.0, sheetW - 2.0 * margin, 330.0, 18.0)

  // everything in this block is confined to the panel
  with Style.clip = Some(panel) in
    with
      Style.fillPaint =
        Paint.radial(300.0, 250.0, 250.0, glow.fade(0.75), glow.fade(0.0))
    in
      cv.fill(Region.rect(margin, 104.0, sheetW - 2.0 * margin, 330.0))

    disc(cv, 238.0, 232.0, 104.0, magenta)
    disc(cv, 350.0, 244.0, 104.0, cyan)
    disc(cv, 294.0, 330.0, 104.0, amber)

  // a hairline frame on top of the artwork
  with
    Style.strokePaint = Paint.of(hairline.fade(0.55)),
    Style.stroke = Stroke.of(1.0)
  in
    cv.stroke(panel)

private def disc(cv: Canvas, cx: Float, cy: Float, r: Float, color: Color): Unit =
  cv.group: 0.92, Blend.screen, () =>
    with Style.fillPaint = Paint.of(color) in
      cv.fill(Region.circle(cx, cy, r))

//[ A small label and a rule across the head of the sheet. //]
private def masthead(cv: Canvas): Unit receives graphics =
  with
    Style.font = Font.bold(12.0),
    Style.textPaint = Paint.of(muted)
  in
    cv.textAt(margin, 74.0, "HARPE / CANVAS")

    val note = "NO. 01"
    val w = graphics.stringWidth(note)
    cv.textAt(sheetW - margin - w, 74.0, note)

  rule(cv, 86.0, hairline.fade(0.5))

//[ The display title. Lines are placed by hand rather than wrapped, because a
  ! title's line breaks are a design decision, not a measurement.
//]
private def title(cv: Canvas): Unit receives graphics =
  with
    Style.font = Font.bold(46.0),
    Style.textPaint = Paint.of(paper)
  in
    cv.textAt(margin, 512.0, "Shapes, paints,")
    cv.textAt(margin, 562.0, "and light.")

//[ A caption block on the left, and a key to the three inks on the right, so
  ! the foot of the sheet carries weight on both sides.
//]
private def caption(cv: Canvas): Unit receives graphics =
  rule(cv, 596.0, hairline)

  with
    Style.font = Font.sans(13.0),
    Style.textPaint = Paint.of(muted),
    Typesetting.leading = 1.6
  in
    val column = new Rect(margin, 618.0, 316.0, 130.0)
    val _ = Text.paragraph(cv, body(), column)

  inkKey(cv)

private def body(): String =
  """
  Every fill takes a paint, so a gradient costs no more than a flat colour.
  Every stroke carries its own geometry. Groups composite a whole subtree at
  once, which is what lets these three discs overlap without going muddy.
  """

//[ A swatch and a label per ink, right of the caption. //]
private def inkKey(cv: Canvas): Unit receives graphics =
  val x = 412.0

  with
    Style.font = Font.bold(9.5),
    Style.textPaint = Paint.of(muted.fade(0.75))
  in
    cv.textAt(x, 618.0, "INKS / SCREEN")

  swatch(cv, x, 646.0, magenta, "magenta")
  swatch(cv, x, 672.0, cyan, "cyan")
  swatch(cv, x, 698.0, amber, "amber")

private def swatch(cv: Canvas, x: Float, y: Float, color: Color, label: String): Unit =
  with Style.fillPaint = Paint.of(color) in
    cv.fill(Region.circle(x + 5.0, y - 4.0, 5.0))

  with
    Style.font = Font.sans(11.0),
    Style.textPaint = Paint.of(muted)
  in
    cv.textAt(x + 18.0, y, label)

//[ Three metadata columns along the foot: the outer two hold the margins, the
  ! middle one is centred on the sheet.
//]
private def colophon(cv: Canvas): Unit receives graphics =
  rule(cv, 762.0, hairline.fade(0.5))

  with
    Style.font = Font.sans(10.5),
    Style.textPaint = Paint.of(muted.fade(0.85))
  in
    val middle = "600 x 820 at 3x"
    val right = "drawn in jo"

    cv.textAt(margin, 786.0, "cairo + harfbuzz")
    cv.textAt((sheetW - graphics.stringWidth(middle)) / 2.0, 786.0, middle)
    cv.textAt(sheetW - margin - graphics.stringWidth(right), 786.0, right)

//[ A hairline across the text column, at baseline `y`. //]
private def rule(cv: Canvas, y: Float, color: Color): Unit =
  with
    Style.strokePaint = Paint.of(color),
    Style.stroke = Stroke.of(1.0)
  in
    cv.stroke(Trace.from(margin, y).lineTo(sheetW - margin, y))
