//[ Task.jo — the sandbox's default guest task.
  !
  ! The entry point the agent's `runCode` tool overwrites each turn. This default
  ! just proves the sandbox runs.
//]

namespace sandbox.guest

import sandbox.api.*
import harpe.caps.*

def runTask(): Unit receives IO.stdout, fs, ocr =
  match ocr.text("poster.png")
  case Ok(text) => println text
  case Err(err) =>  println: "failed: " + err
