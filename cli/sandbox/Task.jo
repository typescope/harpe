namespace UserTask
import SandboxAPI.*
import harpe.caps.*

// Placeholder guest program — the model's generated code replaces this each turn.
// It demonstrates the granted capabilities: list the data/ tree, then describe
// each PDF in it.
def runTask(): Unit receives IO.stdout, fs, pdfReader =
  for entry in fs.list(fs.root).success do
    val name = entry.path.toString

    if name.endsWith(".pdf") then
      match fs.openPDF(entry.path)
      case Ok(doc) =>
        println "\{name}: PDF, \{doc.pageCount} page(s)"
        doc.close()

      case Err(e) => println "\{name}: unreadable (\{e})"

    else println: name
