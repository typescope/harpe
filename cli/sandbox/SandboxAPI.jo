namespace SandboxAPI

import jo.IO.stdout
import harpe.media.*

// The agent's contract: the entry point the LLM implements each turn, and the
// capabilities it receives. Grant more by declaring capability params and widening
// `receives`; the implementations are built in the runtime, the LLM only gets the
// capability.

// The agent's data directory (`data/`), as a confined, read-only tree.
param fs: FileSystem

// Format processors over that same tree — each a separately granted capability.
param pdf: PDF
param word: Word
param image: Image
param ocr: OCR

defer def runTask(): Unit receives stdout, fs, pdf, word, image, ocr
