//[ ProviderFixture.jo
  !
  ! A configurable localhost HTTP server for provider contract tests. Tests
  ! supply an ordered response script; the fixture records every request and
  ! returns the corresponding response. Nothing reaches the external network.
//]

namespace harpe.cli.tests

import harpe.Http
import harpe.Http.request
import harpe.ffi.json
import harpe.util.Process
import harpe.ffi.builtins

section ProviderFixture
  //[ One scripted response
    !
    ! `delaySeconds` holds the request open before answering. A client whose own
    ! timeout is shorter gives up first, which is the only way to reach the
    ! statusless half of `Classify` — a failure that never became an HTTP
    ! status, and is classified by exception type instead.
  //]
  class Response(status: String, headers: py.List, chunks: List[String], delaySeconds: Float = 0.0)

  def response(status: String, contentType: String, body: String): Response =
    new Response(status, py.list(py.tuple("Content-Type", contentType)), [body])

  //[ A response the server sits on for `seconds` before sending anything. //]
  def stalled(seconds: Float): Response =
    new Response:
      "200 OK"
      py.list(py.tuple("Content-Type", "text/event-stream"))
      ["data: [DONE]\n\n"]
      delaySeconds = seconds

  //[ A scripted SSE stream, optionally held back before its first byte
    !
    ! `delaySeconds` keeps the connection open and silent for that long. A
    ! scenario that has to act while a turn is mid-request — cancelling it, say —
    ! uses it to hold the turn where it wants it, rather than racing the reply.
  //]
  def sse(body: String, delaySeconds: Float = 0.0): Response =
    new Response:
      "200 OK"
      py.list:
        py.tuple("Content-Type", "text/event-stream")
        py.tuple("Cache-Control", "no-cache")
      body.trim.split("\n\n").map(frame => sseFrame(frame) + "\n\n")
      delaySeconds = delaySeconds

  //[ Permit readable multi-line JSON after `data:` in fixture literals. SSE
    ! requires every physical payload line to carry its own `data:` prefix, so
    ! the fixture adds it to indented continuation lines before serving.
  //]
  private def sseFrame(frame: String): String =
    var lines: List[String] = []
    var dataStarted = false
    for line in frame.split("\n") do
      if line.startsWith("data:") then
        lines = lines + line
        dataStarted = true
      else if dataStarted then
        // Parenthesized: `lines` is a list, so an unbracketed `+` chain would
        // append the prefix and the line as two separate elements.
        lines = lines + ("data: " + line)
      else lines = lines + line
    lines.join("\n")

  class RecordedRequest(method: String, path: String, query: String, body: String, environ: py.Dynamic)
    def header(name: String): String =
      val key = "HTTP_" + py.dynamic(name).upper().asString.replace("-", "_")
      environ.get(key, "").asString

    def jsonBody: py.Dict = json.loads(body).cast[py.Dict]
  end

  class Server(origin: String, port: Int, requests: py.List)
    def baseUrl: String = origin + "/v1"
    def requestCount: Int = requests.size
    def recorded(index: Int): RecordedRequest = requests.get(index).cast[RecordedRequest]

    // Convenient aliases retained for the common one-request provider scenario.
    def path: String = recorded(0).path
    def requestJson: py.Dict = recorded(0).jsonBody
  end

  private def encode(chunks: List[String]): py.List =
    val encoded = py.list()
    for chunk in chunks do
      encoded.append(py.dynamic(chunk).encode("utf-8"))
    encoded

  private def serve(responses: List[Response], requests: py.List): py.List receives request =
    val recorded = new RecordedRequest:
      request.environ.get("REQUEST_METHOD", "GET").asString
      request.path
      request.environ.get("QUERY_STRING", "").asString
      Http.readBody()
      request.environ
    requests.append(recorded)

    val index = requests.size - 1
    if index >= responses.size then
      Http.respond(Http.Status.ServerError, Http.Mime.Text, "unexpected request")
    else
      val answer = responses.get(index)
      if answer.delaySeconds > 0.0 then py.module("time").sleep(answer.delaySeconds)
      py.call(request.startResponse, answer.status, answer.headers)
      encode(answer.chunks)

  //[ Stop the server writing an access line per request to stderr
    !
    ! `wsgiref` logs every exchange, which would interleave with the test report.
    ! Its handler calls `log_message` for that, so pointing the name at a logger
    ! nobody has configured drops the line while leaving real errors alone.
  //]
  private def quieten(httpd: py.Dynamic): Unit =
    val wsgi = py.module("wsgiref.simple_server")
    val discard = py.module("logging").getLogger("harpe.test.fixture").debug
    val quiet = builtins.newType:
      "QuietWSGIRequestHandler"
      py.tuple(wsgi.WSGIRequestHandler)
      py.dict("log_message" ~ discard)
    py.module("builtins").setattr(httpd, "RequestHandlerClass", quiet)

  //[ Run `test` against a local server with an ordered response script.
    !
    ! Port zero avoids collisions. `serve_forever` permits retries and other
    ! multi-request flows; shutdown and join make the fixture lifetime explicit.
  //]
  def withResponses(responses: List[Response], test: Server => Unit): Unit =
    val requests = py.list()
    val httpd = Http.server("127.0.0.1", 0, () => serve(responses, requests))
    quieten(httpd)
    val port = httpd.server_port.asInt
    val server = new Server("http://127.0.0.1:\{port}", port, requests)
    val thread = Process.daemon: () => httpd.serve_forever(poll_interval = 0.01)
    thread.start()

    val result = py.try: test(server)
    val _ = py.try: httpd.shutdown()
    val _ = py.try: httpd.server_close()
    val _ = py.try: thread.join(2.0)

    match result
    case Ok(_) => pass
    case Err(err) => abort err.message

  def withSSE(body: String, test: Server => Unit): Unit =
    withResponses([sse(body)], test)
end
