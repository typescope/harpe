//[ Harpe.jo
  !
  ! The CLI agent loop (the Harpe "conversational" trigger).
  !
  ! `jo.main = Harpe.cli` runs this. Each turn it:
  !   1. reads a line from the user
  !   2. asks the LLM, offering one tool: runCode(code)
  !   3. on a runCode call: writes the program to sandbox/guest, builds & runs
  !      it with `jo run`, and feeds stdout (or the compile error) back
  !   4. repeats until the LLM replies with text, then prints the reply
  !
  ! The LLM only ever acts by writing a Jo program compiled against the
  ! agent's sandbox — never by touching Python directly.
//]

namespace Harpe

import jo.IO.stdout

private def builtins: py.Dynamic = py.module("builtins")
private def osMod: py.Dynamic = py.module("os")
private def sysMod: py.Dynamic = py.module("sys")
private def subprocessMod: py.Dynamic = py.module("subprocess")
private def reMod: py.Dynamic = py.module("re")
private def timeMod: py.Dynamic = py.module("time")
private def jsonMod: py.Dynamic = py.module("json")
private def globMod: py.Dynamic = py.module("glob")
private def threadingMod: py.Dynamic = py.module("threading")

// ============================================
// Small FFI helpers
// ============================================

private def attr(obj: py.Dynamic, name: String): py.Dynamic = builtins.getattr(obj, name)

private def getenv(name: String, fallback: String): String =
  attr(osMod, "environ").cast[py.Dict].get(name, fallback).asString

private def fileExists(path: String): Bool = os.path.isfile(path)

private def readFile(path: String): String = py.open(path, "r").read().asString

// Concatenate the agent's API contract (sandbox/api/src/*.jo) for the prompt.
private def readApiContract(): String =
  var out = ""
  val dir = "sandbox/api/src"
  if os.path.isdir(dir) then
    val names: py.List = os.listdir(dir)
    var i = 0
    while i < names.size do
      val name = names.get(i).asString
      if name.endsWith(".jo") then
        out = out + readFile(os.path.join(dir, name)) + "\n"
      i = i + 1
  out

private def writeFile(path: String, content: String): Unit =
  val f = py.open(path, "w")
  f.write(content)
  f.close()

private def stripAnsi(s: String): String =
  reMod.sub("\\[[0-9;]*m", "", s).asString

private def indexOfChar(s: String, c: Char): Int =
  var i = 0
  while i < s.size do
    if s.get(i) == c then return i
    i = i + 1
  -1

// Load KEY=VALUE lines from a .env file into the process environment.
private def loadDotenv(path: String): Unit =
  if fileExists(path) then
    val env = attr(osMod, "environ").cast[py.Dict]
    for line in readFile(path).lines do
      val t = line.trim
      val eq = indexOfChar(t, '=')
      if t.size > 0 && !t.startsWith("#") && eq > 0 then
        val key = t.substring(0, eq).trim
        val value = t.substring(eq + 1, t.size).trim
        env.set(key, value)

// ============================================
// LLM prompt and tools
// ============================================

private def systemPrompt(): String =
  val persona  = if fileExists("AGENT.md") then readFile("AGENT.md") + "\n\n" else ""
  val contract = readApiContract()
  """
    \{persona}You are a Harpe agent. You act ONLY by writing Jo programs and running
    them with your single tool, runCode(code). Every reply, computation, or
    capability call must be a Jo program you submit — you cannot touch the host.

    Your program is `namespace UserTask` and implements the deferred `runTask`
    declared in the agent's API contract below. Match its `receives` list exactly,
    importing the API namespace it defines. The text your program prints with
    `println` comes back to you as the tool result.

    --- agent API contract (sandbox/api) ---
    \{contract}
    --- end contract ---

    Before writing Jo, read the `jo-cheat-sheet` skill for syntax:
        skills.read("jo-cheat-sheet")

    Workflow: write Jo -> runCode -> if it fails to compile, read the error and
    fix it -> once it runs, use the output to answer. Keep answers concise.
    """

private def buildTools(): py.List =
  val schema = py.dict(
    "type" ~ "object",
    "properties" ~ py.dict(
      "code" ~ py.dict(
        "type" ~ "string",
        "description" ~ "The Jo source code to compile and run"
      )
    ),
    "required" ~ py.list("code")
  )
  val tool = py.dict(
    "name" ~ "runCode",
    "description" ~ "Write a Jo program (namespace UserTask, def runTask), compile it against the agent sandbox, and run it. Returns the program's stdout, or the compile error if it does not build.",
    "input_schema" ~ schema
  )
  py.list(tool)

// ============================================
// The runCode tool: write -> build -> run -> capture (timed + logged)
// ============================================

private def now(): Float = timeMod.time().asFloat

private def round2(x: Float): Float = builtins.round(x, 2).asFloat

// Append one JSON record per turn to the audit log under logs/.
private def logTurn(entry: py.Dict): Unit =
  os.makedirs("logs")
  val f = py.open("logs/turns.jsonl", "a")
  f.write(jsonMod.dumps(entry).asString + "\n")
  f.close()

// "sandbox/guest/jo.toml" -> "sandbox/guest/.build/*/jo-*/target/*.py"
private def guestBuildGlob(guestSpec: String): String =
  val dir = guestSpec.substring(0, guestSpec.size - "/jo.toml".size)
  dir + "/.build/*/jo-*/target/*.py"

// What runCode returns: `result` goes back to the LLM; `summary` is the
// one-line status (with timing) shown in the console.
class RunOutcome(result: String, summary: String)

private def runCode(code: String, guestSrc: String, guestSpec: String, skillsDir: String): RunOutcome =
  writeFile(guestSrc, code)

  // 1. Compile — the security checkpoint — timed and error-captured.
  val t0 = now()
  val build = subprocessMod.run(py.list("jo", "build", "--spec", guestSpec), capture_output = true, text = true)
  val compileSeconds = round2(now() - t0)

  if attr(build, "returncode").asInt != 0 then
    val compileError = stripAnsi(attr(build, "stderr").asString).trim
    logTurn(py.dict(
      "time"           ~ now(),
      "code"           ~ code,
      "compiled"       ~ false,
      "compileSeconds" ~ compileSeconds,
      "compileError"   ~ compileError
    ))
    return new RunOutcome(
      "The program did not compile (\{compileSeconds}s):\n\{compileError}",
      "did not compile · \{compileSeconds}s")

  // 2. Run the compiled program directly, timed.
  val targets: py.List = globMod.glob(guestBuildGlob(guestSpec)).cast[py.List]
  if targets.size == 0 then
    return new RunOutcome("The program compiled but no executable was found.", "no executable produced")

  val targetPy = targets.get(0).asString
  val t1 = now()
  val run = subprocessMod.run(py.list("python3", targetPy, skillsDir), capture_output = true, text = true)
  val runSeconds = round2(now() - t1)
  val runRc  = attr(run, "returncode").asInt
  val runOut = attr(run, "stdout").asString.trim
  val runErr = stripAnsi(attr(run, "stderr").asString).trim

  val result =
    if runRc != 0 then "The program crashed:\n\{runErr}"
    else if runOut == "" then "(the program produced no output)"
    else runOut

  val summary =
    if runRc != 0 then "crashed · compiled \{compileSeconds}s, ran \{runSeconds}s"
    else "ran · compiled \{compileSeconds}s, ran \{runSeconds}s"

  logTurn(py.dict(
    "time"           ~ now(),
    "code"           ~ code,
    "compiled"       ~ true,
    "compileSeconds" ~ compileSeconds,
    "runSeconds"     ~ runSeconds,
    "exitCode"       ~ runRc,
    "output"         ~ result
  ))
  new RunOutcome(result, summary)

// ============================================
// Terminal UX: spinner + line-editing history
// ============================================

private def round1(x: Float): Float = builtins.round(x, 1).asFloat

// "\r" + ESC + "[2K" — return to start of line and clear it.
private def clearLine(): String = "\r" + builtins.chr(27).asString + "[2K"

//[ A spinner running in a background thread, showing a message + elapsed
  ! seconds while a blocking call (LLM request, compile, run) is in flight.
//]
class Spinner(stopEvent: py.Dynamic, thread: py.Dynamic)
  def stop(): Unit =
    stopEvent.set()
    thread.join()
end

private def startSpinner(message: String): Spinner =
  val stopEvent = threadingMod.Event()
  val started   = now()
  val animate = () =>
    val frames = py.list("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
    var i = 0
    while !stopEvent.is_set().asBool do
      val frame = frames.get(i % 10).asString
      val secs  = round1(now() - started)
      sysMod.stdout.write("\r  " + frame + " " + message + " " + secs.toString + "s ")
      sysMod.stdout.flush()
      i = i + 1
      stopEvent.wait(0.1)
    sysMod.stdout.write(clearLine())
    sysMod.stdout.flush()

  val thread = threadingMod.Thread(target = animate, daemon = true)
  thread.start()
  new Spinner(stopEvent, thread)

private def historyFile: String = "data/chat_history"

// Enable arrow-key line editing and load persistent history (up/down recalls
// previous messages). Importing `readline` is what wires it into `input()`.
private def initReadline(): Unit =
  os.makedirs("data")
  val rl = py.module("readline")
  if fileExists(historyFile) then rl.read_history_file(historyFile)

// Persist history to disk. Called after every message so it survives any exit
// (Ctrl-C, a crash, …) — not just a graceful one. Best-effort: ensure the
// directory exists and never let a save failure crash the chat.
private def saveHistory(): Unit =
  os.makedirs("data")
  val _ = py.try(py.module("readline").write_history_file(historyFile))

// ============================================
// The chat loop
// ============================================

def cli(): Unit receives stdout =
  loadDotenv(".env")
  val apiKey = getenv("ANTHROPIC_API_KEY", "")
  if apiKey == "" then
    println "Error: ANTHROPIC_API_KEY is not set (put it in .env or the environment)."
  else
    runChat(apiKey)
end

private def runChat(apiKey: String): Unit receives stdout =
  val model     = getenv("MODEL", "claude-opus-4-6")
  val skillsDir = "skills"
  val guestSpec = "sandbox/guest/jo.toml"
  val guestSrc  = "sandbox/guest/src/Task.jo"

  val client = py.module("anthropic").Anthropic(api_key = apiKey)
  val sys    = systemPrompt()
  val tools  = buildTools()

  initReadline()
  println "Harpe agent — type a message to start. Ctrl-D or 'quit' to exit."

  var messages: py.List = py.list()
  var running = true

  while running do
    var userInput = ""
    println ""
    // Keep the prompt a single line with no embedded newline, so readline can
    // redraw it correctly when navigating history with the up/down arrows.
    match py.try(py.input("You ▸ "))
      case Ok(s)  =>
        userInput = s.trim
        saveHistory()
      case Err(_) =>
        running = false

    if running && userInput != "" then
      if userInput == "quit" || userInput == "exit" then
        running = false
      else
        messages.append(py.dict("role" ~ "user", "content" ~ userInput))

        var turnDone = false
        while !turnDone do
          val llmSpin = startSpinner("thinking")
          val response = client.messages.create(
            model = model,
            max_tokens = 8096,
            system = sys,
            messages = messages,
            tools = tools
          )
          llmSpin.stop()

          val content: py.List = attr(response, "content").cast[py.List]

          // Re-serialize the assistant message and collect tool calls.
          var assistantContent: py.List = py.list()
          var toolUses: py.List = py.list()
          var i = 0
          while i < content.size do
            val block = content.get(i)
            val btype = attr(block, "type").asString
            if btype == "text" then
              assistantContent.append(py.dict("type" ~ "text", "text" ~ attr(block, "text")))
            else if btype == "tool_use" then
              assistantContent.append(py.dict(
                "type" ~ "tool_use",
                "id" ~ attr(block, "id"),
                "name" ~ attr(block, "name"),
                "input" ~ attr(block, "input")
              ))
              toolUses.append(block)
            i = i + 1

          messages.append(py.dict("role" ~ "assistant", "content" ~ assistantContent))

          if toolUses.size > 0 then
            var toolResults: py.List = py.list()
            var j = 0
            while j < toolUses.size do
              val tu = toolUses.get(j)
              val code = attr(tu, "input").cast[py.Dict].get("code", "").asString
              val runSpin = startSpinner("running")
              val outcome = runCode(code, guestSrc, guestSpec, skillsDir)
              runSpin.stop()
              println "  · \{outcome.summary}"
              toolResults.append(py.dict(
                "type" ~ "tool_result",
                "tool_use_id" ~ attr(tu, "id"),
                "content" ~ outcome.result
              ))
              j = j + 1

            messages.append(py.dict("role" ~ "user", "content" ~ toolResults))
          else
            var text = ""
            var k = 0
            while k < content.size do
              val block = content.get(k)
              if attr(block, "type").asString == "text" then
                text = text + attr(block, "text").asString
              k = k + 1

            println ""
            println "Agent ▸ \{text.trim}"
            turnDone = true

  println "Goodbye."
end
