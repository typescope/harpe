//[ Harpe.jo
  !
  ! The CLI agent loop (the Harpe "conversational" trigger) and its entry
  ! points. Each turn it:
  !   1. reads a line from the user
  !   2. asks the LLM, offering the configured tools (default: runCode plus the
  !      read-only skill tools)
  !   3. dispatches each tool call to its handler and feeds the result back
  !   4. repeats until the LLM replies with text, then prints the reply
  !
  ! `jo.main = harpe.cli.main` wires an agent to the loop. The toolset offered
  ! to the model is `defaultTools() ++ extraTools()` — both are `defer def`
  ! hooks an agent overrides through its jo.toml `[main.links]`, the same way
  ! the sandbox links `runTask`:
  !   - link `harpe.cli.extraTools`   to ADD tools alongside the built-ins
  !   - link `harpe.cli.defaultTools` to REPLACE the base toolset entirely
  !
  ! The reusable pieces live in the `harpe` package: `harpe.tools` (the Tool
  ! abstraction + runCode/skill tools) and `harpe.ffi` (shared Python interop).
//]

namespace harpe.cli

import jo.IO.stdout
import harpe.ffi.*
import harpe.tools.*
import harpe.models.*
import harpe.Workspace
import harpe.workspace
import os

// ============================================
// Prompt
// ============================================

//[ The system prompt is the agent's AGENT.md, used verbatim — fully visible and
  ! editable by the agent author, who maintains all of it (framing, workflow, and
  ! any capability/contract notes). The framework injects nothing; the model
  ! learns the available tools from the `tools=` API, not from the prompt.
//]
private def systemPrompt(): String receives workspace =
  if fileExists(workspace.agentMd) then readFile(workspace.agentMd) else ""

// ============================================
// Terminal UX: spinner + line-editing history
// ============================================

// "\r" + ESC + "[2K" — return to start of line and clear it.
private def clearLine(): String = "\r" + builtins.chr(27).asString + "[2K"

//[ A spinner running in a background thread, showing a message + elapsed
  ! seconds while a blocking call (LLM request, compile, run) is in flight.
//]
class Spinner(stopEvent: py.Dynamic, thread: py.Dynamic)
  def stop(): Unit =
    stopEvent.set()
    thread.join()
end

private def startSpinner(message: String): Spinner =
  val stopEvent = threadingMod.Event()
  val started   = now()
  val animate = () =>
    val frames = py.list("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
    var i = 0
    while !stopEvent.is_set().asBool do
      val frame = frames.get(i % 10).asString
      val secs  = round1(now() - started)
      sysMod.stdout.write("\r  " + frame + " " + message + " " + secs.toString + "s ")
      sysMod.stdout.flush()
      i = i + 1
      stopEvent.wait(0.1)
    sysMod.stdout.write(clearLine())
    sysMod.stdout.flush()

  val thread = threadingMod.Thread(target = animate, daemon = true)
  thread.start()
  new Spinner(stopEvent, thread)

// ============================================
// ESC-to-interrupt: watch stdin for the ESC key while the agent works
// ============================================

// True if stdin has a byte ready within `timeout` seconds.
private def stdinReady(timeout: Float): Bool =
  val res = selectMod.select(py.list(0), py.list(), py.list(), timeout)
  res.cast[py.Tuple].get(0).cast[py.List].size > 0

// Put the terminal in cbreak mode so a single keypress (ESC) is readable
// without Enter. Returns the saved settings to restore later.
private def enterCbreak(): py.Dynamic =
  val saved = termiosMod.tcgetattr(0)
  ttyMod.setcbreak(0)
  saved

private def restoreTerminal(saved: py.Dynamic): Unit =
  termiosMod.tcsetattr(0, termiosMod.TCSADRAIN, saved)

// Background thread: set `interrupt` when the user presses ESC (a lone ESC,
// not an escape sequence like an arrow key). Stops when `stop` is set.
private def startEscWatcher(interrupt: py.Dynamic, stop: py.Dynamic): Unit =
  val watcher = () =>
    while !stop.is_set().asBool && !interrupt.is_set().asBool do
      if stdinReady(0.1) then
        val ch = os.read(0, 1)
        if builtins.len(ch).asInt == 1 && builtins.ord(ch).asInt == 27 then
          // a lone ESC (no byte follows) — not part of an arrow-key sequence
          if !stdinReady(0.02) then interrupt.set()
  val thread = threadingMod.Thread(target = watcher, daemon = true)
  thread.start()

// Run `work` on a background thread; return Some(result), or None if
// `interrupt` fires first (the abandoned worker finishes in the background).
private def callInterruptible[T](interrupt: py.Dynamic, work: () => T): Option[T] =
  val box  = py.list(py.none)
  val done = threadingMod.Event()
  val worker = () =>
    box.set(0, work())
    done.set()
  val thread = threadingMod.Thread(target = worker, daemon = true)
  thread.start()

  var out: Option[T] = None
  var waiting = true
  while waiting do
    if done.wait(0.05).asBool then
      out = Some(box.get(0).cast[T])
      waiting = false
    else if interrupt.is_set().asBool then
      waiting = false
  out

private def historyFile: String = "data/chat_history"

// Enable arrow-key line editing and load persistent history (up/down recalls
// previous messages). Importing `readline` is what wires it into `input()`.
private def initReadline(): Unit =
  os.makedirs("data")
  val rl = py.module("readline")
  if fileExists(historyFile) then rl.read_history_file(historyFile)

// Persist history to disk. Called after every message so it survives any exit
// (Ctrl-C, a crash, …) — not just a graceful one. Best-effort: ensure the
// directory exists and never let a save failure crash the chat.
private def saveHistory(): Unit =
  os.makedirs("data")
  val _ = py.try(py.module("readline").write_history_file(historyFile))

// A small harp, shown once when the chat starts.
private def banner(): Unit receives stdout =
  println """

        .--.
       /|  /|
      / | / |
     /  |/  |
    /  /|   |
   /  / |   |
  |__/__|___|
     H A R P E
  """
  println ""

// ============================================
// The chat loop
// ============================================

//[ extra tools
  !
  ! Deferred hook for ADDING tools. The default is none; an agent overrides it
  ! in its jo.toml — `[main.links] "harpe.cli.extraTools" = "MyAgent.myTools"` —
  ! to offer its own tools alongside the built-ins. Its impl `receives workspace`,
  ! so it can resolve paths against the agent's working directory.
//]
defer def extraTools(): List[Tool] receives workspace = []

//[ defaultTools
  !
  ! Deferred hook for the BASE toolset (runCode + the read-only skill tools). An
  ! agent that wants full control — including whether and how `runCode` exists —
  ! overrides it: `[main.links] "harpe.cli.defaultTools" = "MyAgent.myTools"`.
//]
defer def defaultTools(): List[Tool] receives workspace =
  [runCodeTool(workspace.guestDir)] ++ skillTools(workspace.skillsDir)

//[ The agent's working directory is the CWD, and the runCode/skill tools resolve
  ! their paths against it. It must hold the agent's own `jo.toml` and a
  ! `sandbox/` — the driver checks this up front so a mislaunch fails with a clear
  ! message instead of confusing path errors mid-run.
//]
private def inAgentDir(): Bool =
  fileExists("jo.toml") && os.path.isdir("sandbox")

//[ The entry point (`jo.main = harpe.cli.main`). After validating the working
  ! directory, it provides the `workspace` context parameter and the toolset
  ! `defaultTools() ++ extraTools()` — both overridable by linking, so an agent
  ! customizes the toolset purely through its jo.toml.
//]
def main(): Unit receives stdout =
  if !inAgentDir() then
    println "Error: run this from an agent's working directory — a folder containing its jo.toml and a sandbox/ directory."
  else
    loadDotenv(".env")
    val wspace = new Workspace(os.path.abspath("."))
    val tools = with workspace = wspace in defaultTools() ++ extraTools()

    with workspace = wspace, toolDefs = tools in runChat()

param toolDefs: List[Tool]

//[ model
  !
  ! Deferred hook selecting the chat model. The default is Anthropic from the
  ! environment; override it in jo.toml — `[main.links] "harpe.cli.model" =
  ! "MyAgent.model"` — to use OpenAI, a local model, or `harpe.models.echo` for
  ! tests.
//]
defer def model(): Model receives stdout =
  val key = getenv("ANTHROPIC_API_KEY", "")
  if key == "" then
    println "Error: ANTHROPIC_API_KEY is not set (put it in .env or the environment)."
    sysMod.exit(1)
  anthropic(key, getenv("MODEL", "claude-opus-4-6"))

//[ maxToolRounds
  !
  ! Cap on tool-call rounds in a single turn. Once spent, the model is asked once
  ! more with NO tools, so it must answer with text — bounding runaway turns (and
  ! API spend) from a model that keeps calling tools forever. Override in jo.toml:
  ! `[main.links] "harpe.cli.maxToolRounds" = "MyAgent.maxToolRounds"`.
//]
defer def maxToolRounds(): Int = 50

//[ maxRetries
  !
  ! How many times to retry a transient model error (rate limit, 5xx, connection
  ! blip) before giving up the turn, with exponential backoff between attempts.
  ! Override in jo.toml like `maxToolRounds`.
//]
defer def maxRetries(): Int = 4

//[ The outcome of one user turn: an answer (with the updated history), an ESC
  ! interruption, or a failed request.
//]
union TurnResult =
    Answered(history: List[Message], text: String)
  | Interrupted
  | Failed

private def runChat(): Unit receives stdout, toolDefs, workspace =
  val brain = model()
  val sysPrompt = systemPrompt()

  initReadline()
  banner()
  println "Type a message to start. Ctrl-D or 'quit' to exit."

  var history: List[Message] = []

  while true do
    println ""
    // Keep the prompt a single line with no embedded newline, so readline can
    // redraw it correctly when navigating history with the up/down arrows.
    val line = py.input("You ▸ ")
    val userInput = line.trim
    saveHistory()

    if userInput == "quit" || userInput == "exit" then break

    if userInput != "" then
      val turnStart = history.size
      history = history + new UserText(userInput)

      // Work loop — ESC cancels the turn and returns to the prompt.
      val savedTerm = enterCbreak()
      val res = runTurn(brain, sysPrompt, history)
      restoreTerminal(savedTerm)

      if res is Answered(updated, text) then
        history = updated
        println ""
        println "Agent ▸ \{text}"

      else
        // Discard the cancelled/failed turn so the conversation stays valid.
        history = history.take(turnStart)
        if res is Interrupted then println "  ⎋ interrupted"
        else println "  · request failed"
    end
  end

  println "Goodbye."
end

// Exponential backoff between retries: 1s, 2s, 4s, … capped at 30s.
private def backoffSeconds(attempt: Int): Float =
  var d = 1.0
  var i = 1
  while i < attempt do
    d = d * 2.0
    i = i + 1

  if d > 30.0 then 30.0 else d

//[ The result of fetching one model reply (after any retries): the assistant
  ! message, a give-up (fatal error or retries exhausted), or an ESC stop.
//]
union Fetched =
    Got(message: Assistant)
  | GaveUp
  | Stopped

//[ Ask the model for one reply, retrying transient errors (rate limits, 5xx,
  ! connection blips) with exponential backoff up to `maxRetries`. ESC interrupts
  ! both the request and any backoff wait. The spinner reflects whether this is
  ! the first attempt or a retry.
//]
private def fetchReply(brain: Model, sysPrompt: String, history: List[Message], tools: List[Tool], interrupt: py.Dynamic): Fetched receives stdout =
  var attempt = 0
  var outcome: Fetched = GaveUp

  while true do
    val label = if attempt == 0 then "thinking · ESC to interrupt" else "retrying \{attempt}/\{maxRetries()} · ESC to interrupt"
    val spin = startSpinner(label)
    val maybe = callInterruptible(interrupt, () => brain.reply(sysPrompt, history, tools))
    spin.stop()

    val res = maybe rescue None =>
      outcome = if interrupt.is_set().asBool then Stopped else GaveUp
      break

    match res
      case Reply(message) =>
        outcome = new Got(message)
        break

      case Fatal(detail) =>
        println "  · request failed: \{detail}"
        outcome = GaveUp
        break

      case Transient(detail) =>
        attempt = attempt + 1
        if attempt > maxRetries() then
          println "  · giving up after \{maxRetries()} retries: \{detail}"
          outcome = GaveUp
          break

        else
          val delay = backoffSeconds(attempt)
          println "  · transient error (\{detail}); retrying in \{delay}s"
          // interrupt.wait returns true if ESC fires during the backoff.
          if interrupt.wait(delay).asBool then
            outcome = Stopped
            break
  end // while

  outcome

//[ Drive one turn: call the model (with retries), run any tool calls it
  ! requests, and repeat until it replies with plain text. A turn is bounded to
  ! `maxToolRounds` tool-call rounds; once spent the model is asked once more with
  ! no tools, forcing a final answer. ESC cancels and rolls the turn back.
//]
private def runTurn(brain: Model, sysPrompt: String, start: List[Message]): TurnResult receives stdout, toolDefs =
  var history = start

  val interrupt = threadingMod.Event()
  val stopWatch = threadingMod.Event()
  startEscWatcher(interrupt, stopWatch)

  val budget = maxToolRounds()
  var rounds = 0
  var result: TurnResult = Failed

  while true do
    val sofar = history
    // Once the tool budget is spent, offer no tools so the model must reply
    // with a final text answer rather than calling another tool.
    val offer = if rounds >= budget then List.empty[Tool] else toolDefs

    if rounds == budget then
      println "  · tool budget reached (\{budget}); requesting final answer"

    match fetchReply(brain, sysPrompt, sofar, offer, interrupt)
      case Stopped =>
        result = Interrupted
        break

      case GaveUp =>
        result = Failed
        break

      case Got(reply) =>
        history = history + reply

        if reply.calls.isEmpty then
          result = new Answered(history, reply.text.trim)
          break

        var toolResults: List[ToolResult] = []
        var cancelled = false

        for call in reply.calls do
          if interrupt.is_set().asBool then
            cancelled = true
            break

          val toolName = call.name
          val outcome =
            if toolDefs.find(t => t.name == toolName) is Some(t) then
              val spin = startSpinner("\{toolName} · ESC to interrupt")
              val o = t.run(call.input)
              spin.stop()
              o

            else
              new RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}")

          println "  · \{outcome.summary}"
          toolResults = toolResults + new ToolResult(call.id, outcome.result)

        if cancelled || interrupt.is_set().asBool then
          result = Interrupted
          break

        else
          history = history + new ToolResults(toolResults)
          rounds = rounds + 1
  end // while

  stopWatch.set()
  result
