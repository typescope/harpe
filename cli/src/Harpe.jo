//[ Harpe.jo
  !
  ! The CLI agent loop (the Harpe "conversational" trigger) and its entry
  ! points. Each turn it:
  !   1. reads a line from the user
  !   2. asks the LLM, offering the configured tools (default: runCode plus the
  !      read-only skill tools)
  !   3. dispatches each tool call to its handler and feeds the result back
  !   4. repeats until the LLM replies with text, then prints the reply
  !
  ! `jo.main = harpe.cli.main` wires an agent to the loop. The toolset offered
  ! to the model is `defaultTools() ++ extraTools()` — both are `defer def`
  ! hooks an agent overrides through its jo.toml `[main.links]`, the same way
  ! the sandbox links `runTask`:
  !   - link `harpe.cli.extraTools`   to ADD tools alongside the built-ins
  !   - link `harpe.cli.defaultTools` to REPLACE the base toolset entirely
  !
  ! The reusable pieces live in the `harpe` package: `harpe.tools` (the Tool
  ! abstraction + runCode/skill tools) and `harpe.ffi` (shared Python interop).
//]

namespace harpe.cli

import jo.IO.stdout
import harpe.ffi.*
import harpe.tools.*
import harpe.Workspace
import harpe.workspace
import os

// Concatenate the agent's API contract (sandbox/api/src/*.jo) for the prompt.
private def readApiContract(): String =
  var out = ""
  val dir = "sandbox/api/src"
  if os.path.isdir(dir) then
    val names: py.List = os.listdir(dir)
    var i = 0
    while i < names.size do
      val name = names.get(i).asString
      if name.endsWith(".jo") then
        out = out + readFile(os.path.join(dir, name)) + "\n"
      i = i + 1
  out

// ============================================
// Prompt
// ============================================

private def systemPrompt(): String =
  val persona  = if fileExists("AGENT.md") then readFile("AGENT.md") + "\n\n" else ""
  val contract = readApiContract()
  """
    \{persona}You are a Harpe agent. You act ONLY by writing Jo programs and running
    them with your single tool, runCode(code). Every reply, computation, or
    capability call must be a Jo program you submit — you cannot touch the host.

    Your program is `namespace UserTask` and implements the deferred `runTask`
    declared in the agent's API contract below. Match its `receives` list exactly,
    importing the API namespace it defines. The text your program prints with
    `println` comes back to you as the tool result.

    --- agent API contract (sandbox/api) ---
    \{contract}
    --- end contract ---

    You also have three read-only reference tools over your skills (knowledge
    files), so you never need to write Jo just to consult them:
        skillsList()        — list available skill files (names include extensions)
        skillsRead(name)    — read one by its full name, e.g. "jo-cheat-sheet.md"
        skillsSearch(query) — case-insensitive search across all skill files
    These only let you READ your reference material; you still ACT on the world
    ONLY through runCode.

    Before writing Jo, read the cheat sheet for syntax:
        skillsRead("jo-cheat-sheet.md")

    Workflow: write Jo -> runCode -> if it fails to compile, read the error and
    fix it -> once it runs, use the output to answer. Keep answers concise.
    """

// ============================================
// Terminal UX: spinner + line-editing history
// ============================================

// "\r" + ESC + "[2K" — return to start of line and clear it.
private def clearLine(): String = "\r" + builtins.chr(27).asString + "[2K"

//[ A spinner running in a background thread, showing a message + elapsed
  ! seconds while a blocking call (LLM request, compile, run) is in flight.
//]
class Spinner(stopEvent: py.Dynamic, thread: py.Dynamic)
  def stop(): Unit =
    stopEvent.set()
    thread.join()
end

private def startSpinner(message: String): Spinner =
  val stopEvent = threadingMod.Event()
  val started   = now()
  val animate = () =>
    val frames = py.list("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
    var i = 0
    while !stopEvent.is_set().asBool do
      val frame = frames.get(i % 10).asString
      val secs  = round1(now() - started)
      sysMod.stdout.write("\r  " + frame + " " + message + " " + secs.toString + "s ")
      sysMod.stdout.flush()
      i = i + 1
      stopEvent.wait(0.1)
    sysMod.stdout.write(clearLine())
    sysMod.stdout.flush()

  val thread = threadingMod.Thread(target = animate, daemon = true)
  thread.start()
  new Spinner(stopEvent, thread)

// ============================================
// ESC-to-interrupt: watch stdin for the ESC key while the agent works
// ============================================

// True if stdin has a byte ready within `timeout` seconds.
private def stdinReady(timeout: Float): Bool =
  val res = selectMod.select(py.list(0), py.list(), py.list(), timeout)
  res.cast[py.Tuple].get(0).cast[py.List].size > 0

// Put the terminal in cbreak mode so a single keypress (ESC) is readable
// without Enter. Returns the saved settings to restore later.
private def enterCbreak(): py.Dynamic =
  val saved = termiosMod.tcgetattr(0)
  ttyMod.setcbreak(0)
  saved

private def restoreTerminal(saved: py.Dynamic): Unit =
  termiosMod.tcsetattr(0, termiosMod.TCSADRAIN, saved)

// Background thread: set `interrupt` when the user presses ESC (a lone ESC,
// not an escape sequence like an arrow key). Stops when `stop` is set.
private def startEscWatcher(interrupt: py.Dynamic, stop: py.Dynamic): Unit =
  val watcher = () =>
    while !stop.is_set().asBool && !interrupt.is_set().asBool do
      if stdinReady(0.1) then
        val ch = osMod.read(0, 1)
        if builtins.len(ch).asInt == 1 && builtins.ord(ch).asInt == 27 then
          // a lone ESC (no byte follows) — not part of an arrow-key sequence
          if !stdinReady(0.02) then interrupt.set()
  val thread = threadingMod.Thread(target = watcher, daemon = true)
  thread.start()

// Run `work` on a background thread; return Some(result), or None if
// `interrupt` fires first (the abandoned worker finishes in the background).
private def callInterruptible(interrupt: py.Dynamic, work: () => py.Dynamic): Option[py.Dynamic] =
  val box  = py.list(py.none)
  val done = threadingMod.Event()
  val worker = () =>
    box.set(0, work())
    done.set()
  val thread = threadingMod.Thread(target = worker, daemon = true)
  thread.start()

  var out: Option[py.Dynamic] = None
  var waiting = true
  while waiting do
    if done.wait(0.05).asBool then
      out = Some(box.get(0))
      waiting = false
    else if interrupt.is_set().asBool then
      waiting = false
  out

private def historyFile: String = "data/chat_history"

// Enable arrow-key line editing and load persistent history (up/down recalls
// previous messages). Importing `readline` is what wires it into `input()`.
private def initReadline(): Unit =
  os.makedirs("data")
  val rl = py.module("readline")
  if fileExists(historyFile) then rl.read_history_file(historyFile)

// Persist history to disk. Called after every message so it survives any exit
// (Ctrl-C, a crash, …) — not just a graceful one. Best-effort: ensure the
// directory exists and never let a save failure crash the chat.
private def saveHistory(): Unit =
  os.makedirs("data")
  val _ = py.try(py.module("readline").write_history_file(historyFile))

// A small harp, shown once when the chat starts.
private def banner(): Unit receives stdout =
  println """

        .--.
       /|  /|
      / | / |
     /  |/  |
    /  /|   |
   /  / |   |
  |__/__|___|
     H A R P E
  """
  println ""

// ============================================
// The chat loop
// ============================================

//[ extraTools
  !
  ! Deferred hook for ADDING tools. The default is none; an agent overrides it
  ! in its jo.toml — `[main.links] "harpe.cli.extraTools" = "MyAgent.myTools"` —
  ! to offer its own tools alongside the built-ins. Its impl `receives workspace`,
  ! so it can resolve paths against the agent's working directory.
//]
defer def extraTools(): List[Tool] receives workspace = []

//[ defaultTools
  !
  ! Deferred hook for the BASE toolset (runCode + the read-only skill tools). An
  ! agent that wants full control — including whether and how `runCode` exists —
  ! overrides it: `[main.links] "harpe.cli.defaultTools" = "MyAgent.myTools"`.
//]
defer def defaultTools(): List[Tool] receives workspace =
  [runCodeTool(workspace.guestDir)] ++ skillTools(workspace.skillsDir)

//[ The agent's working directory is the CWD, and the runCode/skill tools resolve
  ! their paths against it. It must hold the agent's own `jo.toml` and a
  ! `sandbox/` — the driver checks this up front so a mislaunch fails with a clear
  ! message instead of confusing path errors mid-run.
//]
private def inAgentDir(): Bool =
  fileExists("jo.toml") && os.path.isdir("sandbox")

//[ The entry point (`jo.main = harpe.cli.main`). After validating the working
  ! directory, it provides the `workspace` context parameter and the toolset
  ! `defaultTools() ++ extraTools()` — both overridable by linking, so an agent
  ! customizes the toolset purely through its jo.toml.
//]
def main(): Unit receives stdout =
  if !inAgentDir() then
    println "Error: run this from an agent's working directory — a folder containing its jo.toml and a sandbox/ directory."
  else
    loadDotenv(".env")
    val apiKey = getenv("ANTHROPIC_API_KEY", "")

    if apiKey == "" then
      println "Error: ANTHROPIC_API_KEY is not set (put it in .env or the environment)."
    else
      with workspace = new Workspace(os.path.abspath(".")) in
        with toolDefs = defaultTools() ++ extraTools() in runChat(apiKey)

param toolDefs: List[Tool]

private def runChat(apiKey: String): Unit receives stdout, toolDefs =
  val client = py.module("anthropic").Anthropic(api_key = apiKey)
  val sysPrompt = systemPrompt()

  val tools: py.List = py.list()
  for t in toolDefs do tools.append(t.spec)

  initReadline()
  banner()
  println "Type a message to start. Ctrl-D or 'quit' to exit."

  val messages: py.List = py.list()
  var running = true

  while running do
    var userInput = ""
    println ""
    // Keep the prompt a single line with no embedded newline, so readline can
    // redraw it correctly when navigating history with the up/down arrows.
    match py.try(py.input("You ▸ "))
    case Ok(s)  =>
      userInput = s.trim
      saveHistory()

    case Err(_) =>
      running = false

    if running && userInput != "" then
      if userInput == "quit" || userInput == "exit" then
        running = false
      else
        work(userInput, client, messages, tools, sysPrompt)
    end
  end

  println "Goodbye."
end

private def work(userInput: String, client: py.Dynamic, messages: py.List, tools: py.List, sysPrompt: String): Unit =
  val turnStart = messages.size
  messages.append(py.dict("role" ~ "user", "content" ~ userInput))

  val model  = getenv("MODEL", "claude-opus-4-6")

  // Work loop — ESC cancels the turn and returns to the prompt.
  val savedTerm = enterCbreak()
  val interrupt = threadingMod.Event()
  val stopWatch = threadingMod.Event()
  startEscWatcher(interrupt, stopWatch)

  var turnDone = false
  var ok       = true
  while !turnDone do
    val llmSpin = startSpinner("thinking · ESC to interrupt")
    val maybe = callInterruptible(interrupt, () => client.messages.create(
      model = model,
      max_tokens = 8096,
      system = sysPrompt,
      messages = messages,
      tools = tools
    ))

    llmSpin.stop()

    val response =  maybe rescue None =>
      ok = false
      turnDone = true
      break

    val content: py.List = response.content.cast[py.List]

    // Re-serialize the assistant message and collect tool calls.
    var assistantContent: py.List = py.list()
    var toolUses: py.List = py.list()
    var i = 0
    while i < content.size do
      val block = content.get(i)
      val btype = attr(block, "type").asString
      if btype == "text" then
        assistantContent.append:
          py.dict:
            "type" ~ "text"
            "text" ~ attr(block, "text")

      else if btype == "tool_use" then
        assistantContent.append:
          py.dict:
            "type" ~ "tool_use"
            "id" ~ attr(block, "id")
            "name" ~ attr(block, "name")
            "input" ~ attr(block, "input")

        toolUses.append(block)
      i = i + 1

    messages.append:
      py.dict: "role" ~ "assistant", "content" ~ assistantContent

    if toolUses.size > 0 then
      var toolResults: py.List = py.list()
      var j = 0
      while j < toolUses.size && !interrupt.is_set().asBool do
        val tu = toolUses.get(j)
        val toolName = attr(tu, "name").asString
        val input = attr(tu, "input").cast[py.Dict]
        val outcome =
          match toolDefs.find(t => t.name == toolName)
            case Some(t) =>
              val spin = startSpinner("\{toolName} · ESC to interrupt")
              val o = t.run(new ToolInput(input))
              spin.stop()
              o

            case None =>
              new RunOutcome("Unknown tool: \{toolName}", "unknown tool · \{toolName}")

        println "  · \{outcome.summary}"
        toolResults.append:
          py.dict:
            "type" ~ "tool_result"
            "tool_use_id" ~ attr(tu, "id")
            "content" ~ outcome.result

        j = j + 1

      if interrupt.is_set().asBool then
        ok = false
        turnDone = true
      else
        messages.append: py.dict("role" ~ "user", "content" ~ toolResults)
    else
      var text = ""
      var k = 0
      while k < content.size do
        val block = content.get(k)
        if attr(block, "type").asString == "text" then
          text = text + attr(block, "text").asString
        k = k + 1

      println ""
      println "Agent ▸ \{text.trim}"
      turnDone = true
    end
  end // while

  stopWatch.set()
  restoreTerminal(savedTerm)

  if !ok then
    // Discard the cancelled/failed turn so the conversation stays valid.
    while messages.size > turnStart do
      val _ = messages.pop()
    if interrupt.is_set().asBool then println "  ⎋ interrupted"
    else println "  · request failed"
