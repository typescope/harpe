//[ Console.jo
  !
  ! Handle console input/output and turn lifecycle for the CLI.
//]

namespace harpe.cli
import harpe.ffi.os
import harpe.util.Process
import harpe.util.Clock
import harpe.util.File
import harpe.ffi.sys
import harpe.ffi.threading
import harpe.ffi.signal
import harpe.util.Terminal
import harpe.ffi.builtins
import harpe.ffi.time

import jo.IO.stdout
import harpe.*
import harpe.turns.*
import harpe.Model.Message

private union WorkerOutcome =
    WorkerCompleted(result: TurnData)
  | WorkerCancelled
  | WorkerCrashed(message: String)

//[ The CLI's console UI //]
private class Console(out: String => Unit, historyFile: String)
  // One spinner resource for the whole session.
  private val spinner = new Spinner
  private val workerLock = threading.Lock()
  private var streamedReply: Bool = false

  def replyWasStreamed: Bool = streamedReply

  //[ Init console interaction
    !
    ! Enable `readline`.
  //]
  def init(): Unit =
    File.ensureDir("data")
    val rl = py.module("readline")
    if File.exists(historyFile) then rl.read_history_file(historyFile)

    // Ctrl-C quits cleanly from anywhere. Capture the terminal's cooked-mode
    // settings now so the handler can restore them: a turn puts the terminal in
    // cbreak mode (for the ESC watcher), and exiting from there would otherwise
    // leave the user's shell in a broken state. Installed on the main thread, as
    // Python requires.
    val cooked = Terminal.getAttrs(0)
    Process.onSigint: (signum: Int, frame: py.Dynamic) =>
      Terminal.setAttrs(0, cooked)
      sys.stdout.write("\n  " + Style.success("♪ Elise stopped.") + "\n")
      sys.stdout.flush()
      val _ = sys.exit(0)

    println ""
    println("              " + Style.note("♪") + "           " + Style.accent("♫"))
    println(Style.muted("        ──────") + Style.note("●") + Style.muted("───────────"))
    println(Style.muted("        ───────────") + Style.accent("●") + Style.muted("──────"))
    println("           " + Style.accent("E L I S E"))
    println ""
    println("           " + Style.muted("Harpe · CLI"))
    println ""
    println("  " + Style.success("Ready.") + " Type a message to start.")
    println("  " + Style.muted("Ctrl-C, Ctrl-D, or 'quit' to exit."))

  //[ Read one line from the user
    !
    ! `None` signals end-of-input (Ctrl-D / EOF), on which the caller should
    ! exit.
  //]
  def userInput(): Option[String] =
    println ""
    // Keep the prompt a single line with no embedded newline, so readline can
    // redraw it correctly when navigating history with the up/down arrows.
    // Ctrl-C is handled by the SIGINT handler (quit). Ctrl-D surfaces here as
    // EOFError, which py.try catches so we exit cleanly instead of crashing.
    match py.try(py.input("You ▸ "))
    case Ok(line) =>
      saveInputHistory()
      Some(line.trim)

    case Err(_) =>
      println ""
      None

  def agentResponse(text: String): Unit =
    println ""
    println(Style.accent("Elise ▸") + " " + Markdown.toTerminal(text))

  def stopProgress(): Unit = spinner.stop()

  //[ Persist history to disk
    !
    ! Called after every message so it survives any exit (Ctrl-C, a crash, …)
  //]
  private def saveInputHistory(): Unit =
    File.ensureDir("data")
    val _ = py.try(py.module("readline").write_history_file(historyFile))

  def turn(userMsg: Message, f: Interact => TurnData): TurnData =
    // Serialize the real worker lifetime, not just the visible CLI turn. After
    // ESC the worker may still be waiting on a model/tool call and must finish
    // rolling back before another turn can touch the shared agent context.
    workerLock.acquire()

    // Cancellation is per-turn. The worker thread may outlive the CLI's visible
    // turn after ESC. It must keep seeing its own cancelled state, even after
    // the next prompt starts a fresh turn with a fresh watcher.
    val interrupt = threading.Event()
    val stopWatch = threading.Event()
    val active = threading.Event()
    val approvalActive = threading.Event()
    active.set()
    val turnInteract = Console.turnInteract(this, interrupt, active, approvalActive)
    val savedTerm = Console.enterCbreak()
    Console.startEscWatcher(interrupt, stopWatch, approvalActive)

    val outcome = Console.callInterruptible(turnInteract, () => f(turnInteract), () => workerLock.release())

    active.clear()
    interrupt.set()
    spinner.stop()
    Console.restoreTerminal(savedTerm)
    stopWatch.set()

    // A cancelled or crashed worker produced no turn value, so synthesize one that
    // says so. It carries no messages, matching how the transcript replays a turn
    // that never committed.
    match outcome
    case WorkerCompleted(res)   => res
    case WorkerCancelled        => TurnData(userMsg, [], TurnResult.Interrupted)
    case WorkerCrashed(message) => TurnData(userMsg, [], TurnResult.Failed(message))

  def display(event: TurnEvent): Unit = with IO.stdout = out in
    match event
    case TurnEvent.ModelRequestStarted(attempt, maxAttempts) =>
      streamedReply = false
      val label =
        if attempt == 0 then "thinking · ESC to interrupt"
        else "retrying \{attempt}/\{maxAttempts} · ESC to interrupt"
      spinner.start(label)

    case TurnEvent.ModelRequestEnded =>
      spinner.stop()

    case TurnEvent.TransientError(detail, delaySeconds) =>
      println("  " + Style.warning("· transient error") + " (\{detail}); retrying in \{delaySeconds}s")

    case TurnEvent.AssistantChunk(text) =>
      spinner.stop()
      streamedReply = true
      out(text)

    case TurnEvent.AssistantStreamReset =>
      if streamedReply then out("\n")
      streamedReply = false

    case TurnEvent.AssistantMessage(text) =>
      if streamedReply then out("\n") else agentResponse(text)

    case TurnEvent.ToolBudgetReached(budget) =>
      println("  " + Style.warning("· tool budget reached") + " (\{budget}); requesting final answer")

    case TurnEvent.ToolCallStarted(name) =>
      spinner.start("\{name} · ESC to interrupt")

    case TurnEvent.ToolCallEnded(name, summary) =>
      spinner.stop()
      println("  " + Style.note("·") + " \{summary}")

    case TurnEvent.ContextCompacted(droppedMessages) =>
      println("  " + Style.muted("· context compacted (\{droppedMessages} messages summarized)"))
end

private section Console
  def turnInteract(
      console: Console,
      interrupt: py.Dynamic,
      active: py.Dynamic,
      approvalActive: py.Dynamic)
  : Interact =
    new ConsoleTurnInteract(console, interrupt, active, approvalActive)

  private class ConsoleTurnInteract(
      console: Console,
      interrupt: py.Dynamic,
      active: py.Dynamic,
      approvalActive: py.Dynamic)
    view Interact

    def cancelled: Bool =
      interrupt.is_set().asBool || !active.is_set().asBool

    def pause(seconds: Float): Bool =
      if !active.is_set().asBool then true else interrupt.wait(seconds).asBool

    def emit(event: TurnEvent): Unit =
      if !cancelled then console.display(event)

    def approve(title: String, detail: String): Approvals.Decision =
      with IO.stdout = console.out in
        Console.askApproval(console, interrupt, active, approvalActive, title, detail)
  end

  private def askApproval(
      console: Console,
      interrupt: py.Dynamic,
      active: py.Dynamic,
      approvalActive: py.Dynamic,
      title: String,
      detail: String)
  : Approvals.Decision receives stdout =
    console.stopProgress()
    approvalActive.set()

    println ""
    println("  " + Style.warning("Approval required"))
    println("  " + Style.strong(title))
    if detail.trim != "" then
      println ""
      println(Markdown.toTerminal(detail))
    println ""
    sys.stdout.write("  " + Style.muted("Approve? [y/N] "))
    sys.stdout.flush()

    val deadline = Clock.now() + 600.0
    var decision: Approvals.Decision = Approvals.TimedOut
    var waiting = true
    var needsNewline = true

    while waiting do
      if interrupt.is_set().asBool || !active.is_set().asBool then
        decision = Approvals.Cancelled
        waiting = false

      else if Clock.now() >= deadline then
        decision = Approvals.TimedOut
        waiting = false

      else if Console.stdinReady(0.1) then
        val ch = os.read(0, 1)
        if builtins.len(ch) == 1 then
          val code = builtins.ord(ch)
          if code == 121 || code == 89 then
            decision = Approvals.Approved
            waiting = false
          else if code == 110 || code == 78 || code == 10 || code == 13 then
            decision = Approvals.Rejected
            if code == 10 || code == 13 then needsNewline = false
            waiting = false
          else if code == 27 then
            decision = Approvals.Cancelled
            interrupt.set()
            waiting = false

    approvalActive.clear()
    if needsNewline then println ""
    match decision
    case Approvals.Approved  => println("  " + Style.success("Approved."))
    case Approvals.Rejected  => println("  " + Style.warning("Rejected."))
    case Approvals.TimedOut  => println("  " + Style.warning("Approval timed out."))
    case Approvals.Cancelled => println("  " + Style.muted("Approval cancelled."))
    decision

  // Put the terminal in cbreak mode so a single keypress (ESC) is readable
  // without Enter. Returns the saved settings to restore later.
  private[cli] def enterCbreak(): py.Dynamic =
    val saved = Terminal.getAttrs(0)
    Terminal.setCbreak(0)
    saved

  private[cli] def restoreTerminal(saved: py.Dynamic): Unit =
    Terminal.setAttrs(0, saved)

  // ============================================
  // ESC-to-interrupt: watch stdin for the ESC key while the agent works
  // ============================================

  // True if stdin has a byte ready within `timeout` seconds.
  def stdinReady(timeout: Float): Bool = Terminal.readable(0, timeout)

  // Background thread: set `interrupt` when the user presses ESC (a lone ESC,
  // not an escape sequence like an arrow key). Stops when `stop` is set.
  def startEscWatcher(interrupt: py.Dynamic, stop: py.Dynamic, approvalActive: py.Dynamic): Unit =
    val watcher = () =>
      while !stop.is_set().asBool && !interrupt.is_set().asBool do
        if approvalActive.is_set().asBool then
          stop.wait(0.05)
        else if stdinReady(0.1) then
          // Both conditions are re-tested after the wait, because the wait is
          // where this thread spends its life and the turn can end inside it. A
          // byte that arrives once the turn is over belongs to the line the user
          // is typing at the prompt: reading it here would swallow the first
          // character of their next message, and this watcher is the only reader
          // by then, so nobody would ever hand it back.
          val ended = stop.is_set().asBool || interrupt.is_set().asBool
          if !ended && !approvalActive.is_set().asBool then
            val ch = os.read(0, 1)
            if builtins.len(ch) == 1 && builtins.ord(ch) == 27 then
              // a lone ESC (no byte follows) — not part of an arrow-key sequence
              if !stdinReady(0.02) then interrupt.set()
    val thread = Process.daemon(watcher)
    thread.start()

  // Run `work` on a background thread. Return `WorkerCancelled` if `interrupt`
  // fires first (the abandoned worker finishes in the background). This lets a
  // long model call be cancelled by ESC while still letting the worker roll
  // back.
  def callInterruptible(interact: Interact, work: () => TurnData, cleanup: () => Unit): WorkerOutcome =
    val box  = py.list(py.none)
    val err  = py.list("")
    val done = threading.Event()
    val worker = () =>
      match py.try(work())
      case Ok(value) => box.set(0, value)
      case Err(e)    => err.set(0, e.message)
      cleanup()
      done.set()
    val thread = Process.daemon(worker)
    thread.start()

    var out: WorkerOutcome = WorkerCancelled
    var waiting = true
    while waiting do
      if done.wait(0.05).asBool then
        val message = err.get(0).asString
        if message != "" then out = WorkerCrashed(message)
        else out = WorkerCompleted(box.get(0).cast[TurnData])
        waiting = false
      else if interact.cancelled then
        waiting = false
    out

end
