//[ RunCode.jo
  !
  ! The `runCode` tool: write the model's program to the guest sandbox, compile
  ! it (the security checkpoint), run the compiled program, and capture the
  ! result — timed and appended to the audit log.
  !
  ! Shared FFI helpers (`writeFile`, `stripAnsi`, `now`, `round2`, `attr`, the
  ! py module handles) live in Harpe.jo, same namespace.
//]

namespace Harpe

//[ Append one JSON record per turn to the audit log under logs/. //]
private def logTurn(entry: py.Dict): Unit =
  os.makedirs("logs")
  val f = py.open("logs/turns.jsonl", "a")
  f.write(jsonMod.dumps(entry).asString + "\n")
  f.close()

//[ "sandbox/guest/jo.toml" -> "sandbox/guest/.build/*/jo-*/target/*.py" //]
private def guestBuildGlob(guestSpec: String): String =
  val dir = guestSpec.substring(0, guestSpec.size - "/jo.toml".size)
  dir + "/.build/*/jo-*/target/*.py"

private def runCode(code: String, guestSrc: String, guestSpec: String): RunOutcome =
  writeFile(guestSrc, code)

  // 1. Compile — the security checkpoint — timed and error-captured.
  val t0 = now()
  val build = subprocessMod.run(py.list("jo", "build", "--spec", guestSpec), capture_output = true, text = true)
  val compileSeconds = round2(now() - t0)

  if attr(build, "returncode").asInt != 0 then
    val compileError = stripAnsi(attr(build, "stderr").asString).trim
    logTurn(py.dict(
      "time"           ~ now(),
      "code"           ~ code,
      "compiled"       ~ false,
      "compileSeconds" ~ compileSeconds,
      "compileError"   ~ compileError
    ))
    return new RunOutcome(
      "The program did not compile (\{compileSeconds}s):\n\{compileError}",
      "did not compile · \{compileSeconds}s")

  // 2. Run the compiled program directly, timed.
  val targets: py.List = globMod.glob(guestBuildGlob(guestSpec)).cast[py.List]
  if targets.size == 0 then
    return new RunOutcome("The program compiled but no executable was found.", "no executable produced")

  val targetPy = targets.get(0).asString
  val t1 = now()
  val run = subprocessMod.run(py.list("python3", targetPy), capture_output = true, text = true)
  val runSeconds = round2(now() - t1)
  val runRc  = attr(run, "returncode").asInt
  val runOut = attr(run, "stdout").asString.trim
  val runErr = stripAnsi(attr(run, "stderr").asString).trim

  val result =
    if runRc != 0 then "The program crashed:\n\{runErr}"
    else if runOut == "" then "(the program produced no output)"
    else runOut

  val summary =
    if runRc != 0 then "crashed · compiled \{compileSeconds}s, ran \{runSeconds}s"
    else "ran · compiled \{compileSeconds}s, ran \{runSeconds}s"

  logTurn(py.dict(
    "time"           ~ now(),
    "code"           ~ code,
    "compiled"       ~ true,
    "compileSeconds" ~ compileSeconds,
    "runSeconds"     ~ runSeconds,
    "exitCode"       ~ runRc,
    "output"         ~ result
  ))
  new RunOutcome(result, summary)

//[ The core "act" tool: compile + run a Jo program against the agent sandbox. //]
def runCodeTool(guestSrc: String, guestSpec: String): Tool =
  new Tool(
    "runCode",
    "Write a Jo program (namespace UserTask, def runTask), compile it against the agent sandbox, and run it. Returns the program's stdout, or the compile error if it does not build.",
    [strParam("code", "The Jo source code to compile and run")],
    input => runCode(input.string("code"), guestSrc, guestSpec)
  )
