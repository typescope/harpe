//[ Cli.jo
  !
  ! The CLI agent loop (the Harpe "conversational" trigger) and its entry
  ! points. Each turn it:
  !
  !   1. reads a line from the user
  !   2. asks the LLM, offering the configured tools (default: runCode plus the
  !      read-only skill tools)
  !   3. dispatches each tool call to its handler and feeds the result back
  !   4. repeats until the LLM replies with text, then prints the reply
  !
  ! `jo.main = harpe.cli.main` wires an agent to the loop.
  !
//]

namespace harpe.cli
import harpe.ffi.os
import harpe.ffi.time

import harpe.ffi.dotenv

import jo.IO.stdout
import harpe.*
import harpe.logging.Logging
import harpe.logging.JsonlLogger
import harpe.logging.logger
import harpe.Model.UserText
import harpe.tools.memoryTools
import harpe.context.WindowedContext
import harpe.turns.Answered
import harpe.turns.Interrupted

//[ The entry point   //]
def main(): Unit receives stdout =
  if Defaults.checkAgentDir() then
    dotenv.load(".env")
    val wspace = new Workspace(os.path.abspath("."))
    with workspace = wspace in
      Logging.withLogger(new JsonlLogger(wspace.relative("logs/agent.jsonl")), () => runChat())

private def runChat(): Unit receives stdout, workspace, logger =
  val inputHistory = workspace.relative("logs/inputs.txt")
  val interact = new Console(stdout, inputHistory)
  interact.init()

  val sessionLog = chooseSession(resumeRequested())
  val memory = Memory.load(sessionLog.memoryPath)
  val agent = new Agent:
    brain = Defaults.model()
    tools = Defaults.tools(610.0) ++ memoryTools(memory)
    context = new WindowedContext:
      baseSystem = workspace.read("AGENT.md").getOrElse("")
      memory = memory
      initial = SessionLog.loadFile(sessionLog.path)

  // The per-turn tool context; constant for a CLI run (one local working dir).
  val data = workspace.relative("data")
  if !os.path.isdir(data) then os.makedirs(data)
  val callCtx = Map("HARPE_DATA_DIR" ~ os.path.abspath(data))

  while true do
    // `None` is end-of-input (Ctrl-D); a blank line or a Ctrl-C'd prompt is
    // `Some("")`, which just re-prompts.
    val userInput = interact.userInput() rescue None => break

    if userInput == "quit" || userInput == "exit" then break

    if userInput == "" then continue

    val userMsg = UserText(userInput, [])

    val res = interact.turn: (turnInteract: Interact) =>
      with callContext = callCtx in
        agent.runTurn(userMsg, turnInteract, maxToolRounds = 50, maxRetries = 4)

    if res is Answered(delta, text) then
      sessionLog.append(time.now(), delta)
      interact.agentResponse(text)

    else
      if res is Interrupted then println("  " + Style.warning("⎋ interrupted"))
      else println("  " + Style.error("· request failed"))

    // Persist memory regardless of outcome (it is not rolled back with a turn).
    if !memory.isEmpty then Memory.save(sessionLog.memoryPath, memory)
  end

  sessionLog.close()

  println("  " + Style.success("♪ Elise stopped."))
end

//[ Whether the user explicitly requested the session picker. The template's
  ! `jo resume` command passes this internal application flag.
//]
private def resumeRequested(): Bool =
  for argDyn in py.module("sys").argv.cast[py.List] do
    if argDyn.asString == "--resume" then return true
  false

//[ Let an interactive user continue one of the five newest sessions. The normal
  ! startup path creates a fresh session without another prompt.
//]
private def chooseSession(resume: Bool): SessionLog receives stdout, workspace =
  val recent = SessionLog.recentFiles(workspace.relative("logs/sessions"), 5)
  val interactive = py.module("sys").stdin.isatty().asBool

  if !resume || recent.isEmpty || !interactive then SessionLog.newLog()
  else
    println Style.accent("Recent sessions")
    var i = 0
    for path in recent do
      val relative = os.path.relpath(path, os.path.abspath("."))
      println("  " + Style.note("\{i + 1}.") + " " + Style.muted(relative))
      i = i + 1

    println ""
    val answer =
      match py.try(py.input("Resume a session number, or press Enter for a new session ▸ "))
      case Ok(value) => value.trim
      case Err(_)    => ""

    val selected = Int.parse(answer) rescue None => 0
    if selected >= 1 && selected <= recent.size then
      val path = recent.get(selected - 1)
      val relative = os.path.relpath(path, os.path.abspath("."))
      println(Style.success("Resuming") + " " + relative)
      new SessionLog(path)
    else
      SessionLog.newLog()
