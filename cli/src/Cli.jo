//[ Cli.jo
  !
  ! The CLI agent loop (the Harpe "conversational" trigger) and its entry
  ! points. Each turn it:
  !
  !   1. reads a line from the user
  !   2. asks the LLM, offering the configured tools (default: runCode plus the
  !      read-only skill tools)
  !   3. dispatches each tool call to its handler and feeds the result back
  !   4. repeats until the LLM replies with text, then prints the reply
  !
  ! `jo.main = harpe.cli.main` wires an agent to the loop.
  !
//]

namespace harpe.cli

import jo.IO.stdout
import harpe.ffi.fileExists
import harpe.ffi.loadDotenv
import harpe.turn.*
import harpe.models.*
import harpe.tools.Tool
import harpe.tools.memoryTools
import harpe.Memory
import harpe.WindowedContext
import harpe.Workspace
import harpe.workspace
import harpe.SessionLog
import os
import time

//[ The agent's working directory is the CWD, and the runCode/skill tools resolve
  ! their paths against it. It must hold the agent's own `jo.toml` and a
  ! `sandbox/` — the driver checks this up front so a mislaunch fails with a clear
  ! message instead of confusing path errors mid-run.
//]
private def inAgentDir(): Bool =
  fileExists("jo.toml") && os.path.isdir("sandbox")

//[ The entry point   //]
def main(): Unit receives stdout =
  if !inAgentDir() then
    println "Error: run this from an agent's working directory — a folder containing its jo.toml and a sandbox/ directory."
  else
    loadDotenv(".env")
    val wspace = new Workspace(os.path.abspath("."))
    with workspace = wspace in runChat()

private def runChat(): Unit receives stdout, workspace =
  val brain = Config.model()
  val sysPrompt = Config.systemPrompt()

  // The agent's working memory for this run, and the tools it curates it with. The
  // CLI is single-session and in-process — memory is not persisted across runs.
  val memory = new Memory
  val tools = Config.tools ++ memoryTools(memory)

  // The context strategy for this run: memory + a sliding window over the
  // transcript, starting empty.
  val context = new WindowedContext(sysPrompt, memory, List.empty[Message])

  val inputHistory = workspace.relative("logs/inputs.txt")
  val interact = new ConsoleInteract(brain, stdout, inputHistory)

  interact.init()

  // Where this session's conversation is serialized; fixed at session start. Memory
  // is saved beside it (`sessionLog.memoryPath`) for inspection — the CLI does not
  // resume, so it is written but never loaded.
  val sessionLog = SessionLog.newLog()

  while true do
    // `None` is end-of-input (Ctrl-D); a blank line or a Ctrl-C'd prompt is
    // `Some("")`, which just re-prompts.
    val userInput = interact.userInput() rescue None => break

    if userInput == "quit" || userInput == "exit" then break

    if userInput == "" then continue

    val userMsg: Message = UserText(userInput)
    context.mark()
    context.append(userMsg)

    val res = interact.turn: () =>
      runTurn(context, tools, Config.maxToolRounds, Config.maxRetries, interact)

    if res is Answered(delta, text) then
      sessionLog.append(time.now(), [userMsg] ++ delta)
      interact.agentResponse(text)

    else
      // Discard the cancelled/failed turn so the conversation stays valid.
      context.rollback()
      if res is Interrupted then println "  ⎋ interrupted"
      else println "  · request failed"

    // Persist memory regardless of outcome (it is not rolled back with a turn).
    if !memory.isEmpty then Memory.save(sessionLog.memoryPath, memory)
  end

  sessionLog.close()

  println "Goodbye."
end
