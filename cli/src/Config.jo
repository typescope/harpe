//[ Config.jo
  !
  ! This agent's configuration — plain functions, meant to be edited. The common
  ! cases delegate to the shared `harpe.Defaults`; customize by changing the code
  ! here (e.g. append your own tools with `Defaults.tools() ++ [myTool]`, or
  ! replace `Defaults.model()` with any `Model`).
//]

namespace harpe.cli

import harpe.*

section Config
  //[ The base of the system prompt: AGENT.md, used verbatim (the context
    ! strategy may append volatile blocks — memory, summary — after it).
  //]
  def basePrompt(): String receives workspace = workspace.read("AGENT.md") rescue None => ""

  //[ The tools offered to the model: runCode + the read-only skill tools.
    ! Add your own: `Defaults.tools() ++ [myTool]`.
  //]
  def tools: List[Tool] receives workspace = Defaults.tools()

  //[ The chat model, selected by env (PROVIDER / MODEL / API keys — see
    ! `Defaults.model`). Replace with any `Model`, e.g. `harpe.models.echo()`
    ! for a keyless dummy.
  //]
  def model(): Model receives IO.stdout = Defaults.model()

  //[ Cap on tool-call rounds in a single turn. Once spent, the model is asked
    ! once more with NO tools, so it must answer with text — bounding runaway
    ! turns (and API spend).
  //]
  def maxToolRounds(): Int = 50

  //[ How many times to retry a transient model error (rate limit, 5xx,
    ! connection blip) before giving up the turn, with exponential backoff.
  //]
  def maxRetries(): Int = 4
end
