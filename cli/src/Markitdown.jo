//[ Markitdown.jo
  !
  ! This agent's file-reading capability, built on Microsoft's `markitdown`
  ! (https://github.com/microsoft/markitdown) — a converter that renders PDFs,
  ! images, Office documents, HTML, CSV, and more to Markdown. It is the converter
  ! behind the `readFile` tool: the framework resolves a file to `Media`, this turns
  ! the bytes into text the model can read.
  !
  ! Swapping the backend is a local edit — point `markitdownConvert` at an OCR
  ! engine or a local vision model instead — because the source (a `MediaProvider`)
  ! and the converter are separate seams.
  !
  ! Requires the `markitdown[all]` Python package (see requirements.txt).
//]

namespace harpe.cli
import harpe.ffi.os
import harpe.ffi.tempfile

import harpe.*
import harpe.media.*

private def markitdown: py.Dynamic = py.module("markitdown")

//[ The file-reading tool, backed by `provider`.
  !
  ! Resolves a path through `provider` and renders it to Markdown. Wire it into
  ! `Config.agent`'s toolset.
//]
def fileTool(provider: MediaProvider): Tool =
  Tool:
    "readFile"
    "Read a file from the agent's working directory and return its text content as Markdown. Handles PDFs, images (with OCR), Word/PowerPoint/Excel documents, HTML, CSV, JSON, and more. Give the file's path relative to the agent directory."
    [Tool.strParam("path", "The file to read, as a path relative to the agent's working directory.")]
    input => readFile(provider, input.string("path"))

//[ Resolve a path and render it to Markdown, bounding the result.
  !
  ! Bounding keeps one large document from flooding the context. A path that
  ! resolves to nothing is reported back to the model.
//]
private def readFile(provider: MediaProvider, id: String): Tool.RunOutcome =
  match provider.resolve(id)
  case None =>
    new Tool.RunOutcome("No file found at '\{id}'.", "not found · \{id}")

  case Some(media) =>
    val markdown = markitdownConvert(media, provider.load(id))
    new Tool.RunOutcome(Tool.elide(markdown, 4000), "read · \{id}")

//[ Convert media `content` to Markdown with markitdown.
  !
  ! markitdown reads from a path, so the bytes are staged in a temp file (with the
  ! original suffix — from `media` — which it uses to pick a converter) and removed
  ! afterward. A conversion failure is returned as a message for the model rather
  ! than raised — an unreadable file is an expected outcome, not a bug.
//]
def markitdownConvert(media: Media, content: py.Dynamic): String =
  val suffix = os.extname(media.fileName)
  val path = tempfile.writeBytes(content, suffix)

  val result = py.try:
    markitdown.MarkItDown()
      .convert(path)
      .text_content.asString

  val _ = py.try(os.unlink(path))

  match result
  case Ok(text) => text
  case Err(e)   => "Could not read the file (\{media.mimeType}): \{e.message}"
