//[ A CLI-only shell tool
  !
  ! The trusted CLI asks the current user to approve the exact command before
  ! starting Bash.
//]
namespace harpe.cli

import harpe.*
import harpe.ffi.subprocess
import harpe.ffi.text

//[ The `runBash` tool: its spec, and the command runner a route calls. //]
class RunBashTool
  view Tool

  def name: String = "runBash"

  def description: String =
    "Run a Bash command in the agent workspace after asking the user for approval."

  def params: List[Tool.ToolParam] =
    [Tool.strParam("command", "The exact Bash command to run")]

  def run(command: String): Tool.RunOutcome receives workspace, interact =
    runBash(command)
end

private def runBash(command: String): Tool.RunOutcome receives workspace, interact =
  if command.trim == "" then
    return new Tool.RunOutcome("The command is empty.", "empty command", attachments = [])

  val id = py.module("uuid").uuid4().toString
  val request = ApprovalRequest(
    "Run a Bash command?",
    "```bash\n\{command}\n```"
  )

  match interact.approve(id, request)
  case Rejected =>
    new Tool.RunOutcome("The user rejected the command.", "command rejected", attachments = [])

  case ApprovalTimedOut =>
    new Tool.RunOutcome("Approval timed out. The command was not run.", "approval timed out", attachments = [])

  case ApprovalCancelled =>
    new Tool.RunOutcome("Approval was cancelled. The command was not run.", "approval cancelled", attachments = [])

  case Approved =>
    val result = subprocess.runCapped(
      py.list("bash", "-lc", command),
      30.0,
      cwd = workspace.relative("")
    )

    if result.timedOut then
      new Tool.RunOutcome:
        "The command ran longer than 30 seconds and was stopped."
        "command timed out"
        attachments = []

    else
      val out = result.out.trim
      val err = text.stripAnsi(result.err).trim
      val combined =
        if out == "" then err
        else if err == "" then out
        else out + "\n" + err
      val content = if combined == "" then "(the command produced no output)" else combined

      if result.returnCode == 0 then
        new Tool.RunOutcome(Tool.elide(content, 4000), "command completed", attachments = [])
      else
        new Tool.RunOutcome:
          Tool.elide("The command exited with status \{result.returnCode}:\n\{content}", 4000)
          "command failed · exit \{result.returnCode}"
          attachments = []
